import std::collections::{List}

/// A declaration with a field and methods.
struct Counter {
    value: int32
}

interface Readable {
    func read() -> int32
}

conform Counter to Readable {
    static func make() -> Counter {
        Counter { value: 3 }
    }

    func read() -> int32 {
        self.value
    }
}

func main() {
    var values: std::collections::List[int32] = List[int32]::new()
    counter := Counter { value: 3 }
    print("count ${counter.read()}")
}

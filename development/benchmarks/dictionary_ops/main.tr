// Keep operation boundaries and checksums aligned with main.go and main.rs.
struct Value {
    kind: int64
    payload: int64
}

@noinline
func makeDictionary() -> Dictionary[string, Value] {
    Dictionary[string, Value]::new()
}

@noinline
func observe(_ values: Dictionary[string, Value]) -> int64 { values.len() as int64 }

@noinline
func put(_ values: Dictionary[string, Value], _ key: string, _ payload: int64) {
    values.set(key: key, value: Value { kind: 1, payload })
}

@noinline
func get(_ values: Dictionary[string, Value], _ key: string) -> int64 {
    match values.get(&key) {
        case .some(value) => value.kind + value.payload
        case .none => -1
    }
}

func nanos(_ start: std::time::Instant) -> uint64 {
    d := start.elapsed()
    d.seconds() * 1000000000_u64 + (d.subsecNanos() as uint64)
}

func main() {
    args := std::env::args()
    if args.len() != 4 { panic("usage: dictionary_ops <case> <iterations> <entries: 1|16>") }
    name := args.at(1)
    count := int64::parse(args.at(2)).unwrap()
    entries := int64::parse(args.at(3)).unwrap()
    if count < 1 || (entries != 1 && entries != 16) { panic("invalid benchmark size") }
    keys := ["x", "fibonacci", "alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "golf", "hotel", "india", "juliet", "kilo", "lima", "mike", "november"]
    var checksum: int64 = 0
    var elapsed: uint64 = 0
    if name == "first_insert" || name == "insert_new" {
        // Prepare bounded batches outside the interval. First insert includes
        // any storage that the implementation defers until the first write.
        var done: int64 = 0
        target := if name == "first_insert" { keys[0] } else { "new_binding" }
        while done < count {
            batch := if count - done < 1024 { count - done } else { 1024 }
            var maps = List[Dictionary[string, Value]]::new()
            var j: int64 = 0
            while j < batch {
                values := makeDictionary()
                if name == "insert_new" {
                    var k: int64 = 0
                    while k < entries { put(values, keys[k as usize], k); k += 1 }
                }
                maps.append(values)
                j += 1
            }
            start := std::time::Instant::now()
            j = 0
            while j < batch { put(maps[j as usize], target, done + j); j += 1 }
            elapsed += nanos(start)
            j = 0
            while j < batch { checksum += get(maps[j as usize], target); j += 1 }
            done += batch
        }
    } else if name == "construct" || name == "construct_insert" {
        populate := name == "construct_insert"
        start := std::time::Instant::now()
        var i: int64 = 0
        while i < count {
            values := makeDictionary()
            if populate { put(values, keys[0], i) }
            checksum += observe(values)
            i += 1
        }
        elapsed = nanos(start)
    } else {
        values := makeDictionary()
        var j: int64 = 0
        while j < entries { put(values, keys[j as usize], j); j += 1 }
        start := std::time::Instant::now()
        var i: int64 = 0
        // Dispatch once, so case-name comparisons do not enter ns/op timings.
        if name == "overwrite" {
            while i < count { put(values, keys[(i % entries) as usize], i); i += 1 }
        } else if name == "hit" {
            while i < count { checksum += get(values, keys[(i % entries) as usize]); i += 1 }
        } else if name == "miss" {
            while i < count { checksum += get(values, "absent"); i += 1 }
        } else { panic("unknown benchmark case") }
        elapsed = nanos(start)
        if name == "overwrite" {
            j = 0
            while j < entries { checksum += get(values, keys[j as usize]); j += 1 }
        }
    }
    std::printf("benchmark case=%s iterations=%d entries=%d elapsed_ns=%d checksum=%d\n", name, count, entries, elapsed, checksum)
}

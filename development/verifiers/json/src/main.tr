import std::io::Reader

const PROTOCOL_VERSION: usize = 1
const RFC_MAX_DEPTH: usize = 1024
const RFC_MAX_BYTES: usize = 64 * 1024 * 1024

struct ChunkReader {
    source: string
    index: usize
    chunkSize: usize
}

extend ChunkReader {
    static func new(_ source: string, _ chunkSize: usize) -> Self {
        ChunkReader { source, index: 0, chunkSize }
    }
}

conform &ChunkReader to Reader {
    public func read(
        _ destination: std::mem::Span[uint8],
    ) -> std::result::Result[usize, std::io::Error] {
        if self.index >= self.source.byteLen() || destination.len() == 0 {
            return .ok(0)
        }

        var count = self.chunkSize
        if count > destination.len() {
            count = destination.len()
        }
        remaining := self.source.byteLen() - self.index
        if count > remaining {
            count = remaining
        }

        var written: usize = 0
        while written < count {
            *destination.at(written) = self.source.byteAt(self.index + written)
            written += 1
        }
        self.index += written
        return .ok(written)
    }
}

@test
func chunkReaderReferencesAdvanceOneCursor() {
    var reader = ChunkReader::new("abc", 2)
    alias := &reader
    var bytes: [uint8; 2] = [0; 2]
    assert(alias.read(bytes.asSpan()).unwrap() == 2, "first chunk")
    assert(bytes[0] == ('a' as uint8) && bytes[1] == ('b' as uint8), "first bytes")
    assert(reader.read(bytes.asSpan()).unwrap() == 1, "same cursor through receiver auto-reference")
    assert(bytes[0] == ('c' as uint8), "remaining byte")
    assert(alias.read(bytes.asSpan()).unwrap() == 0, "EOF stays exhausted")
}

@test
func streamingDecoderRetainsTheReaderReference() {
    var reader = ChunkReader::new("[1,{\"x\":true}]", 1)
    var decoder = std::json::Decoder::new(&reader)
    value := decoder.decodeValue().unwrap()
    assert(std::json::stringify(&value).unwrap() == "[1,{\"x\":true}]", "streamed value")
    assert(decoder.nextValue().unwrap().isNone(), "stream exhausted")
    assert(reader.index == reader.source.byteLen(), "source cursor was advanced")
}

struct Outcome {
    accepted: bool
    canonical: bool
    errorKind: string
    errorOffset: usize
    errorLine: usize
    errorColumn: usize
    errorPath: string
    errorInvariants: bool
}

func acceptedOutcome(_ value: std::json::Value, _ options: std::json::Options) -> Outcome {
    first := match std::json::stringifyWithOptions(&value, options) {
        case .ok(encoded) => encoded
        case .err(_) => {
            return Outcome {
                accepted: true,
                canonical: false,
                errorKind: "encodeFailure",
                errorOffset: 0,
                errorLine: 0,
                errorColumn: 0,
                errorPath: "$",
                errorInvariants: false,
            }
        }
    }
    reparsed := match std::json::parseWithOptions(first, options) {
        case .ok(parsed) => parsed
        case .err(_) => {
            return Outcome {
                accepted: true,
                canonical: false,
                errorKind: "reparseFailure",
                errorOffset: 0,
                errorLine: 0,
                errorColumn: 0,
                errorPath: "$",
                errorInvariants: false,
            }
        }
    }
    second := match std::json::stringifyWithOptions(&reparsed, options) {
        case .ok(encoded) => encoded
        case .err(_) => {
            return Outcome {
                accepted: true,
                canonical: false,
                errorKind: "reencodeFailure",
                errorOffset: 0,
                errorLine: 0,
                errorColumn: 0,
                errorPath: "$",
                errorInvariants: false,
            }
        }
    }
    return Outcome {
        accepted: true,
        canonical: first == second,
        errorKind: "",
        errorOffset: 0,
        errorLine: 0,
        errorColumn: 0,
        errorPath: "",
        errorInvariants: true,
    }
}

func errorKindName(_ kind: std::json::ErrorKind) -> string {
    match kind {
        case .unexpectedEof => "unexpectedEof"
        case .unexpectedToken => "unexpectedToken"
        case .trailingData => "trailingData"
        case .invalidNumber => "invalidNumber"
        case .invalidEscape => "invalidEscape"
        case .invalidUnicodeEscape => "invalidUnicodeEscape"
        case .invalidUtf8 => "invalidUtf8"
        case .unescapedControlCharacter => "unescapedControlCharacter"
        case .duplicateKey => "duplicateKey"
        case .depthLimit => "depthLimit"
        case .inputLimit => "inputLimit"
        case .io => "io"
    }
}

func rejectedOutcome(_ error: &std::json::Error, _ inputLength: usize) -> Outcome {
    path := error.path()
    invariants := error.byteOffset() <= inputLength
        && error.line() > 0
        && error.column() > 0
        && path.startsWith("$")
    return Outcome {
        accepted: false,
        canonical: false,
        errorKind: errorKindName(error.kind()),
        errorOffset: error.byteOffset(),
        errorLine: error.line(),
        errorColumn: error.column(),
        errorPath: path,
        errorInvariants: invariants,
    }
}

func trailingOutcome(_ inputLength: usize) -> Outcome {
    Outcome {
        accepted: false,
        canonical: false,
        errorKind: "trailingData",
        errorOffset: inputLength,
        errorLine: 1,
        errorColumn: 1,
        errorPath: "$",
        errorInvariants: true,
    }
}

func jsonNumber(_ value: usize) -> std::json::Value {
    text := std::sprintf("%d", value)
    match std::json::Number::parse(text) {
        case .ok(number) => return .number(number)
        case .err(_) => {
            std::panic::panic("usize formatting must produce a valid JSON number")
        }
    }
}

func insertString(_ object: &std::json::Object, _ key: string, _ value: string) {
    var _ = object.insert(key, .string(value))
}

func insertBool(_ object: &std::json::Object, _ key: string, _ value: bool) {
    var _ = object.insert(key, .boolean(value))
}

func insertNumber(_ object: &std::json::Object, _ key: string, _ value: usize) {
    var _ = object.insert(key, jsonNumber(value))
}

func emitResult(
    _ file: string,
    _ classification: string,
    _ profile: string,
    _ mode: string,
    _ chunkSize: usize,
    _ inputLength: usize,
    _ outcome: Outcome,
) {
    var object = std::json::Object::new()
    insertNumber(&object, "version", PROTOCOL_VERSION)
    insertString(&object, "file", file)
    insertString(&object, "class", classification)
    insertString(&object, "profile", profile)
    insertString(&object, "mode", mode)
    insertNumber(&object, "chunk_size", chunkSize)
    insertNumber(&object, "input_bytes", inputLength)
    insertBool(&object, "accepted", outcome.accepted)
    insertBool(&object, "canonical", outcome.canonical)
    insertString(&object, "error_kind", outcome.errorKind)
    insertNumber(&object, "error_offset", outcome.errorOffset)
    insertNumber(&object, "error_line", outcome.errorLine)
    insertNumber(&object, "error_column", outcome.errorColumn)
    insertString(&object, "error_path", outcome.errorPath)
    insertBool(&object, "error_invariants", outcome.errorInvariants)

    value := std::json::Value::object(object)
    match std::json::stringify(&value) {
        case .ok(line) => std::println(line)
        case .err(error) => {
            std::eprintln(std::sprintf("cannot encode certification result: %v", error))
            std::process::exit(2)
        }
    }
}

func optionsFor(_ profile: string) -> std::json::Options {
    if profile == "rfc" {
        return std::json::Options::new()
            .withMaxDepth(RFC_MAX_DEPTH)
            .withMaxInputBytes(RFC_MAX_BYTES)
            .withDuplicateKeys(.useLast)
    }
    return std::json::Options::new()
}

func runOneShot(_ input: string, _ options: std::json::Options) -> Outcome {
    match std::json::parseWithOptions(input, options) {
        case .ok(value) => return acceptedOutcome(value, options)
        case .err(error) => return rejectedOutcome(&error, input.byteLen())
    }
}

func runStreaming(
    _ input: string,
    _ options: std::json::Options,
    _ chunkSize: usize,
) -> Outcome {
    var reader = ChunkReader::new(input, chunkSize)
    var decoder = std::json::Decoder::withOptions(&reader, options)
    match decoder.decodeValue() {
        case .err(error) => return rejectedOutcome(&error, input.byteLen())
        case .ok(value) => {
            match decoder.nextValue() {
                case .err(error) => return rejectedOutcome(&error, input.byteLen())
                case .ok(.some(_)) => return trailingOutcome(input.byteLen())
                case .ok(.none) => return acceptedOutcome(value, options)
            }
        }
    }
}

func classificationFor(_ filename: string) -> string? {
    if filename.startsWith("y_") { return .some("yes") }
    if filename.startsWith("n_") { return .some("no") }
    if filename.startsWith("i_") { return .some("implementation") }
    return .none
}

func runCorpus(_ directoryPath: string, _ matrix: string) {
    var directory = match std::fs::readDir(directoryPath) {
        case .ok(value) => value
        case .err(error) => {
            std::eprintln(std::sprintf("cannot read corpus directory %s: %v", directoryPath, error))
            std::process::exit(2)
        }
    }
    loop {
        match directory.next() {
            case .none => break
            case .some(.err(error)) => {
                std::eprintln(std::sprintf("cannot traverse corpus directory %s: %v", directoryPath, error))
                std::process::exit(2)
            }
            case .some(.ok(entry)) => {
                if !entry.isDirectory() {
                    match classificationFor(entry.name()) {
                        case .some(classification) => runFile(directoryPath, entry.name(), classification, matrix)
                        case .none => {}
                    }
                }
            }
        }
    }
}

func loadInput(_ path: string) -> string {
    match std::fs::read(path) {
        case .ok(bytes) => return std::bytes::Buffer::new(bytes.asSpan()).toString()
        case .err(error) => {
            std::eprintln(std::sprintf("cannot read corpus input %s: %v", path, error))
            std::process::exit(2)
        }
    }
}

func emitStreamingResult(
    _ filename: string,
    _ classification: string,
    _ profile: string,
    _ input: string,
    _ options: std::json::Options,
    _ chunkSize: usize,
) {
    emitResult(
        filename,
        classification,
        profile,
        "stream",
        chunkSize,
        input.byteLen(),
        runStreaming(input, options, chunkSize),
    )
}

func runFile(_ directoryPath: string, _ filename: string, _ classification: string, _ matrix: string) {
    input := loadInput(std::path::join(directoryPath, filename))
    var profiles: [string; 2] = ["rfc", "safe"]

    var profileIndex: usize = 0
    while profileIndex < 2 {
        profile := *profiles.at(profileIndex)
        options := optionsFor(profile)
        emitResult(
            filename,
            classification,
            profile,
            "oneshot",
            0,
            input.byteLen(),
            runOneShot(input, options),
        )

        if matrix == "full" {
            // Small conformance and fuzz corpora exercise every awkward byte
            // boundary; this catches refill bugs independently of document shape.
            var chunkSizes: [usize; 5] = [1, 2, 3, 7, 4096]
            var chunkIndex: usize = 0
            while chunkIndex < 5 {
                emitStreamingResult(
                    filename,
                    classification,
                    profile,
                    input,
                    options,
                    *chunkSizes.at(chunkIndex),
                )
                chunkIndex += 1
            }
        } else {
            // Large valid-document suites keep one deliberately awkward boundary
            // and one production-sized refill without multiplying every byte.
            var chunkSizes: [usize; 2] = [7, 4096]
            var chunkIndex: usize = 0
            while chunkIndex < 2 {
                emitStreamingResult(
                    filename,
                    classification,
                    profile,
                    input,
                    options,
                    *chunkSizes.at(chunkIndex),
                )
                chunkIndex += 1
            }
        }
        profileIndex += 1
    }
}

func main() {
    arguments := std::env::args()
    if arguments.len() != 3 {
        std::eprintln("usage: json-certifier <normalized-corpus> <full|documents>")
        std::process::exit(2)
    }

    directoryPath := arguments.at(1)
    matrix := arguments.at(2)
    if matrix != "full" && matrix != "documents" {
        std::eprintln("json-certifier matrix must be full or documents")
        std::process::exit(2)
    }
    // Results are keyed by filename in the runner; reports use manifest order.
    runCorpus(directoryPath, matrix)
}

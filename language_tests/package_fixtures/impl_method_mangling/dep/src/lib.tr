public interface AsyncValue {
    func read() async -> int32
}

public struct RemoteCounter {
    value: int32
}

extend RemoteCounter {
    public func read() async -> int32 {
        self.value + 1_i32
    }
}

conform RemoteCounter to AsyncValue {
    public func read() async -> int32 {
        value := self.value
        return value + 2_i32
    }
}

public func makeCounter(_ value: int32) -> RemoteCounter {
    RemoteCounter { value }
}

public func readThroughInterface[T: AsyncValue](_ value: &T) async -> int32 {
    await value.read()
}

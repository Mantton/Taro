public interface RemoteReadable {
    func read() -> int32
}

public interface RemoteWritable {
    func written() -> int32
}

public type RemoteReadWrite = RemoteReadable & RemoteWritable

public interface RemoteSource[Value] {
    func source() -> Value
}

public interface RemoteSink[Value] {
    func sink() -> Value
}

public type RemoteGenericPair[Value] = RemoteSource[Value] & RemoteSink[Value]

public struct RemoteValue {
    value: int32
}

conform RemoteValue to RemoteReadable {
    public func read() -> int32 {
        self.value
    }
}

conform RemoteValue to RemoteWritable {
    public func written() -> int32 {
        self.value + 1
    }
}

conform RemoteValue to RemoteSource[int32] {
    public func source() -> int32 {
        self.value
    }
}

conform RemoteValue to RemoteSink[int32] {
    public func sink() -> int32 {
        self.value + 2
    }
}

public func makeRemoteValue(_ value: int32) -> RemoteValue {
    RemoteValue { value }
}

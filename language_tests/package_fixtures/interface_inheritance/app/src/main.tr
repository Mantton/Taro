import dep.{Count, Forward, Value}

// Standard, arbitrary, transitive, and repeated generic parents all use the
// same hierarchy, regardless of which package declares them.
interface CloneChild: Clone {}
interface EquatableChild: Equatable {}
interface Combined: Forward[int32], Value[string], Count[2] {}
interface LocalChild: Combined {}

struct Item {}
impl Clone for Item {
    func clone(&self) -> Item { Item {} }
}
impl CloneChild for Item {}
impl Value[int32] for Item {
    func value(&self) -> int32 { 42 }
}
impl Value[string] for Item {
    func value(&self) -> string { "forty-two" }
}
impl Count[2] for Item {}
impl Forward[int32] for Item {}
impl Combined for Item {}
impl LocalChild for Item {}

func readForward[T: Forward[int32]](_ item: &T) -> int32 {
    item.value()
}

func duplicate[T: CloneChild](_ item: &T) -> T {
    item.clone()
}

func main() {
    let item = Item {}
    assert(readForward(&duplicate(&item)) == 42, "imported Clone superinterface bound")
    let combined: any LocalChild = Item {}
    let number: any Value[int32] = combined
    assert(number.value() == 42, "transitive imported existential upcast")
    let textSource: any LocalChild = Item {}
    let text: any Value[string] = textSource
    assert(text.value() == "forty-two", "repeated generic parent preserves arguments")
    let countSource: any LocalChild = Item {}
    let count: any Count[2] = countSource
    assert(count.count() == 2, "imported const generic default method")
    std.print("PASS: cross-package interface inheritance\n")
}

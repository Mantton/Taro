import dep.{Adapted, Source, makeRemote}

struct LocalSource: Copy {
    value: int32
}

impl Source for LocalSource {
    func source(&self) -> int32 {
        self.value
    }
}

func adaptGeneric[Value: Source](_ value: Value) -> int32 {
    value.adapted()
}

func main() {
    let remote = makeRemote(40)
    assert(remote.adapted() == 41, "dependency type should use dependency blanket impl")

    let local = LocalSource { value: 10 }
    assert(local.adapted() == 11, "local type should use dependency blanket impl")
    assert(adaptGeneric(local) == 11, "generic caller should use dependency blanket impl")
    std.print("ok\n")
}

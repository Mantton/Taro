public interface Source {
    func source() -> int32
}

public interface Adapted {
    type Output
    func adapted() -> Self::Output
}

conform[Value] Value to Adapted where Value: Source {
    type Output = int32

    public func adapted() -> Self::Output {
        self.source() + 1
    }
}

public struct RemoteSource {
    value: int32
}

conform RemoteSource to Source {
    func source() -> int32 {
        self.value
    }
}

public func makeRemote(_ value: int32) -> RemoteSource {
    RemoteSource { value }
}

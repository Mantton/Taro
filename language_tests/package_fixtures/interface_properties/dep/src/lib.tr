public interface Named {
    var name: string {
        get
    };
}

public interface DefaultNamed {
    var name: string {
        get {
            "default"
        }
    };
}

public struct Remote {
    public name: string
}

conform Remote to Named {}

public struct DefaultRemote {}

conform DefaultRemote to DefaultNamed {}

public func makeRemote() -> Remote {
    Remote { name: "remote" }
}

public func makeDefaultRemote() -> DefaultRemote {
    DefaultRemote {}
}

public interface Value[T] {
    var value: T { get };
}
public struct Wrapper[T] { value: T }
conform[T] Wrapper[T] to Value[T] {}
public func wrap[T](_ value: T) -> Wrapper[T] { Wrapper[T] { value } }

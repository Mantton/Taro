public interface Named {
    var name: string {
        get(&self)
    };
}

public interface DefaultNamed {
    var name: string {
        get(&self) {
            "default"
        }
    };
}

public struct Remote {
    public name: string
}

impl Named for Remote {}

public struct DefaultRemote {}

impl DefaultNamed for DefaultRemote {}

public func makeRemote() -> Remote {
    Remote { name: "remote" }
}

public func makeDefaultRemote() -> DefaultRemote {
    DefaultRemote {}
}

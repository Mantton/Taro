import dep.{DefaultNamed, Named, makeDefaultRemote, makeRemote}

struct Local {
    name: string
}

impl Named for Local {}

struct LocalDefault {}

impl DefaultNamed for LocalDefault {}

func readName[T: Named](_ value: &T) -> string {
    value.name
}

func readDefaultName[T: DefaultNamed](_ value: &T) -> string {
    value.name
}

func main() {
    let remote = makeRemote()
    assert(readName(&remote) == "remote", "dependency field witness")
    let erasedRemote: any Named = remote
    assert(erasedRemote.name == "remote", "dependency existential witness")

    let local = Local { name: "local" }
    assert(readName(&local) == "local", "foreign interface local type witness")

    let defaultRemote = makeDefaultRemote()
    assert(
        readDefaultName(&defaultRemote) == "default",
        "dependency default property witness",
    )
    let erasedDefaultRemote: any DefaultNamed = defaultRemote
    assert(
        erasedDefaultRemote.name == "default",
        "dependency existential default property witness",
    )

    let localDefault = LocalDefault {}
    assert(
        readDefaultName(&localDefault) == "default",
        "foreign interface default for local type",
    )
    std.print("PASS: cross-package interface properties\n")
}

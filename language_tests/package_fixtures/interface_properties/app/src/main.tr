import dep::{DefaultNamed, Named, makeDefaultRemote, makeRemote, Value, wrap}

struct Local {
    name: string
}

conform Local to Named {}

struct LocalDefault {}

conform LocalDefault to DefaultNamed {}

func readName[T: Named](_ value: &T) -> string {
    value.name
}

func readDefaultName[T: DefaultNamed](_ value: &T) -> string {
    value.name
}

func readValue[T, V: Value[T]](_ value: &V) -> T { value.value }

func main() {
    number := wrap(23_i32)
    var numberValue: int32 = readValue(&number)
    assert(numberValue == 23, "imported generic Copy getter witness")
    remote := makeRemote()
    assert(readName(&remote) == "remote", "dependency field witness")
    var erasedRemote: any Named = remote
    assert(erasedRemote.name == "remote", "dependency existential witness")

    local := Local { name: "local" }
    assert(readName(&local) == "local", "foreign interface local type witness")

    defaultRemote := makeDefaultRemote()
    assert(
        readDefaultName(&defaultRemote) == "default",
        "dependency default property witness",
    )
    var erasedDefaultRemote: any DefaultNamed = defaultRemote
    assert(
        erasedDefaultRemote.name == "default",
        "dependency existential default property witness",
    )

    localDefault := LocalDefault {}
    assert(
        readDefaultName(&localDefault) == "default",
        "foreign interface default for local type",
    )
    std::print("PASS: cross-package interface properties\n")
}

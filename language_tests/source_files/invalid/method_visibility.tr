// CHECK_ONLY

struct Secret {
    value: int32
}

extend Secret {
    private func hidden() -> int32 {
        self.value
    }

    public func visible() -> int32 {
        self.hidden()
    }
}

func main() {
    s := Secret { value: 42 }

    // This should work
    var _ = s.visible()

    // This should fail - calling private method from outside
    var _ = s.hidden()
}

interface Same {
    func same(_ other: &Self) -> bool
}
interface Child: Same {}
struct Counter { value: int32 }
conform Counter to Child {}
conform Counter to Same {
    func same( _ other: &Self) -> bool { self.value == other.value }
}
struct Other { text: string }
conform Other to Child {}
conform Other to Same {
    func same( _ other: &Self) -> bool { self.text == other.text }
}
func compare[T: Child](_ left: &T, _ right: &T) -> bool {
    left.same(right)
}
func main() {
    var first: any Child = Counter { value: 7_i32 }
    var second: any Child = Other { text: "different payload" }
    var equal: bool = compare(&first, &second)
    var _ = equal
}

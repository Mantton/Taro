// Test: UFCS invalid receiver usage.

type int = isize

interface SpeakerByRef {
    func greet()
}

interface SpeakerByMutRef {
    func increment()
}

struct Human {
    name: string
}

struct Counter {
    value: int
}

conform &Human to SpeakerByRef {
    func greet() {
        print(self.name)
    }
}

conform &Counter to SpeakerByMutRef {
    func increment() {
        self.value = self.value + 1
    }
}

func main() {
    h := Human { name: "Alice" }
    var c = Counter { value: 0 }

    // ERROR: An explicit reference is required by the &Human target.
    SpeakerByRef::greet(h)

    // ERROR: An explicit reference is required by the &Counter target.
    SpeakerByMutRef::increment(c)

}

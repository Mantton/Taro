func badAwait() async {
    f := () async => { 1 as int32 }

    var _ = f()
}

func badAwaitTask() async {
    task := std::task::spawn(() async => { 1 as int32 })

    var _ = await task
}

func badSpawnLocalFirst() async {
    thunk := () => { return 1 as int32 }
    var _ = std::task::spawn(thunk)
}

func badSpawnArg() async {
    var _ = std::task::spawn((x: int32) async => { x })
}

func badSyncTaskValue() {
    task := std::task::spawn(() async => { 1 as int32 })

    var _ = task.result()
}

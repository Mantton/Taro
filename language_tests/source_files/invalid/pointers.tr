func invalidConstCopyToDestination() {
    s := "abc"
    var src: *const uint8 = std::string::stringData(s)
    var dst: *const uint8 = std::string::stringData(s)

    // ERROR: destination pointer must be mutable for copyTo.
    unsafe { src.copyTo(dst, 1) }
}

func invalidConstWrite() {
    s := "abc"
    var p: *const uint8 = std::string::stringData(s)

    // ERROR: write is forbidden through const pointer.
    p.write(65)
}

func main() {
    invalidConstCopyToDestination()
    invalidConstWrite()
}

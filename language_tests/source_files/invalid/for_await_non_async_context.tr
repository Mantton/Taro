struct OneShotAsyncIter {
    emitted: bool
}

conform OneShotAsyncIter to AsyncIterator {
    type Element = int32

    func next() async -> Optional[int32] {
        if self.emitted {
            return .none
        }
        self.emitted = true
        return .some(1 as int32)
    }
}

struct OneShotAsyncSequence {}

conform OneShotAsyncSequence to AsyncIterable {
    type Iterator = OneShotAsyncIter
    type Element = int32

    func iter() -> Self::Iterator {
        return OneShotAsyncIter { emitted: false }
    }
}

func main() {
    source := OneShotAsyncSequence {}
    for await value in source {
        var _ = value
    }
}

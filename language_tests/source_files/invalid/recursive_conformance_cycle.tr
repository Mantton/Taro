interface CycleA {}
interface CycleB {}

struct CycleLeaf[T] {
    value: T
}

conform[T] CycleLeaf[T] to CycleA where CycleLeaf[T]: CycleB {}
conform[T] CycleLeaf[T] to CycleB where CycleLeaf[T]: CycleA {}

func requireCycleA[T: CycleA](_ value: T) {}

func main() {
    value := CycleLeaf[int32] { value: 1 }
    requireCycleA(value)
}

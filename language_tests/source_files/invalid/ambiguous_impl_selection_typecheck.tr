interface AmbA {}
interface AmbB {}
interface AmbMarker {}

struct AmbBox[T] {
    value: T
}

conform int32 to AmbA {}
conform int32 to AmbB {}

conform[T: AmbA] AmbBox[T] to AmbMarker {}
conform[T: AmbB] AmbBox[T] to AmbMarker {}

func requireAmbMarker[T: AmbMarker](_ value: T) {}

func main() {
    value := AmbBox[int32] { value: 1 }
    requireAmbMarker(value)
}

interface CarrierEq {
    type Item
    func get() -> Self::Item
}

struct NumberBoxEq {
    value: int32
}

conform NumberBoxEq to CarrierEq {
    type Item = int32

    func get() -> int32 {
        self.value
    }
}

func requireStringItemEq[T](_ value: T) where T: CarrierEq, T::Item == string {
    var _ = value
}

func main() {
    value := NumberBoxEq { value: 1 }
    requireStringItemEq(value)
}

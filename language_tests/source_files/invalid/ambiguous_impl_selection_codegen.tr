interface CgA {}
interface CgB {}
interface CgMarker {}
interface CgBase {
    func id() -> int32
}

struct CgBox[T] {
    value: T
}

conform[T] CgBox[T] to CgBase {
    func id() -> int32 {
        1
    }
}

conform int32 to CgA {}
conform int32 to CgB {}

conform[T: CgA] CgBox[T] to CgMarker {}
conform[T: CgB] CgBox[T] to CgMarker {}

func main() {
    value := CgBox[int32] { value: 7 }
    var erased: any CgBase = value
    var _ = erased.id()
}

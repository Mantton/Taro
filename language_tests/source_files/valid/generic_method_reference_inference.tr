// Generic methods infer parameters through referenced arguments.
interface GenericMethodValue {}

struct GenericMethodItem {}

conform GenericMethodItem to GenericMethodValue {}

struct GenericMethodContainer[State] {
    state: State
}

extend[State] GenericMethodContainer[State] {
    func accepts[Value: GenericMethodValue]( _ value: &Value) -> bool {
        true
    }
}

func main() {
    var container = GenericMethodContainer[int32] { state: 1 }
    item := GenericMethodItem {}
    assert(container.accepts(&item), "generic method should infer its referenced argument")
    print("PASS: generic method reference inference\n")
}

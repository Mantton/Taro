// Test: operator semantics matrix.

func mustNotCall() -> bool {
    panic("short-circuit failed: RHS was evaluated")
}

func identity(_ v: bool) -> bool { v }

struct AssignNumber {
    value: int32
}

impl std.ops.AddAssign[int32] for AssignNumber {
    func addAssign(&mut self, rhs: int32) { self.value += rhs }
}

impl std.ops.SubAssign[int32] for AssignNumber {
    func subAssign(&mut self, rhs: int32) { self.value -= rhs }
}

impl std.ops.MulAssign[int32] for AssignNumber {
    func mulAssign(&mut self, rhs: int32) { self.value *= rhs }
}

impl std.ops.DivAssign[int32] for AssignNumber {
    func divAssign(&mut self, rhs: int32) { self.value /= rhs }
}

impl std.ops.RemAssign[int32] for AssignNumber {
    func remAssign(&mut self, rhs: int32) { self.value %= rhs }
}

impl std.ops.BitAndAssign[int32] for AssignNumber {
    func bitandAssign(&mut self, rhs: int32) { self.value &= rhs }
}

impl std.ops.BitOrAssign[int32] for AssignNumber {
    func bitorAssign(&mut self, rhs: int32) { self.value |= rhs }
}

impl std.ops.BitXorAssign[int32] for AssignNumber {
    func bitxorAssign(&mut self, rhs: int32) { self.value ^= rhs }
}

impl std.ops.ShlAssign[int32] for AssignNumber {
    func shlAssign(&mut self, rhs: int32) { self.value <<= rhs }
}

impl std.ops.ShrAssign[int32] for AssignNumber {
    func shrAssign(&mut self, rhs: int32) { self.value >>= rhs }
}

func testBitwiseIntegerMatrix() {
    let x: uint8 = 10

    assert((x | 4) == 14, "bitwise or")
    assert((x ^ 15) == 5, "bitwise xor")
    assert((x & 3) == 2, "bitwise and")
    assert((x << 1) == 20, "left shift")
    assert((x >> 1) == 5, "right shift")
    assert((~x) == 245, "bitwise not on uint8")
}

func testCompoundAssignmentMatrix() {
    var x: int32 = 16
    x -= 1
    assert(x == 15, "-=")

    x /= 3
    assert(x == 5, "/=")

    x %= 3
    assert(x == 2, "%=")

    x |= 4
    assert(x == 6, "|=")

    x ^= 3
    assert(x == 5, "^=")

    x &= 3
    assert(x == 1, "&=")

    x <<= 2
    assert(x == 4, "<<=")

    x >>= 1
    assert(x == 2, ">>=")
}

func testOverloadedCompoundAssignmentMatrix() {
    var x = AssignNumber { value: 10 }
    x += 2
    x -= 3
    x *= 2
    x /= 3
    x %= 4
    x |= 8
    x &= 11
    x ^= 3
    x <<= 1
    x >>= 2
    assert(x.value == 4, "overloaded compound assignment interface matrix")
}

func testShortCircuitSideEffects() {
    let a = false && mustNotCall()
    assert(a == false, "&& with false lhs should be false")

    let b = true || mustNotCall()
    assert(b == true, "|| with true lhs should be true")

    let c = true && identity(false)
    assert(c == false, "&& true,false should be false")

    let d = true && identity(true)
    assert(d == true, "&& true,true should be true")

    let e = false || identity(true)
    assert(e == true, "|| false,true should be true")

    let f = false || identity(false)
    assert(f == false, "|| false,false should be false")
}

func testTernaryPrecedenceBasic() {
    let a = true ? 1 : 2
    let b = false ? 10 : 20
    assert(a == 1, "true branch should be selected")
    assert(b == 20, "false branch should be selected")

    let c = false ? 1 : 2 + 3
    assert(c == 5, "ternary else expression should evaluate fully")
}

func main() {
    testBitwiseIntegerMatrix()
    testCompoundAssignmentMatrix()
    testOverloadedCompoundAssignmentMatrix()
    testShortCircuitSideEffects()
    testTernaryPrecedenceBasic()

    std.print("PASS: operators\n")
}

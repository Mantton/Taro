// Test: operator semantics matrix.

func mustNotCall() -> bool {
    panic("short-circuit failed: RHS was evaluated")
}

func identity(_ v: bool) -> bool { v }

struct AssignNumber {
    value: int32
}

conform &AssignNumber to std::ops::AddAssign[int32] {
    func addAssign( _ rhs: int32) { self.value += rhs }
}

conform &AssignNumber to std::ops::SubAssign[int32] {
    func subAssign( _ rhs: int32) { self.value -= rhs }
}

conform &AssignNumber to std::ops::MulAssign[int32] {
    func mulAssign( _ rhs: int32) { self.value *= rhs }
}

conform &AssignNumber to std::ops::DivAssign[int32] {
    func divAssign( _ rhs: int32) { self.value /= rhs }
}

conform &AssignNumber to std::ops::RemAssign[int32] {
    func remAssign( _ rhs: int32) { self.value %= rhs }
}

conform &AssignNumber to std::ops::BitAndAssign[int32] {
    func bitandAssign( _ rhs: int32) { self.value &= rhs }
}

conform &AssignNumber to std::ops::BitOrAssign[int32] {
    func bitorAssign( _ rhs: int32) { self.value |= rhs }
}

conform &AssignNumber to std::ops::BitXorAssign[int32] {
    func bitxorAssign( _ rhs: int32) { self.value ^= rhs }
}

conform &AssignNumber to std::ops::ShlAssign[int32] {
    func shlAssign( _ rhs: int32) { self.value <<= rhs }
}

conform &AssignNumber to std::ops::ShrAssign[int32] {
    func shrAssign( _ rhs: int32) { self.value >>= rhs }
}

func testBitwiseIntegerMatrix() {
    var x: uint8 = 10

    assert((x | 4) == 14, "bitwise or")
    assert((x ^ 15) == 5, "bitwise xor")
    assert((x & 3) == 2, "bitwise and")
    assert((x << 1) == 20, "left shift")
    assert((x >> 1) == 5, "right shift")
    assert((~x) == 245, "bitwise not on uint8")
}

func testCompoundAssignmentMatrix() {
    var x: int32 = 16
    x -= 1
    assert(x == 15, "-=")

    x /= 3
    assert(x == 5, "/=")

    x %= 3
    assert(x == 2, "%=")

    x |= 4
    assert(x == 6, "|=")

    x ^= 3
    assert(x == 5, "^=")

    x &= 3
    assert(x == 1, "&=")

    x <<= 2
    assert(x == 4, "<<=")

    x >>= 1
    assert(x == 2, ">>=")
}

func testOverloadedCompoundAssignmentMatrix() {
    var x = AssignNumber { value: 10 }
    x += 2
    x -= 3
    x *= 2
    x /= 3
    x %= 4
    x |= 8
    x &= 11
    x ^= 3
    x <<= 1
    x >>= 2
    assert(x.value == 4, "overloaded compound assignment interface matrix")
}

func testShortCircuitSideEffects() {
    a := false && mustNotCall()
    assert(a == false, "&& with false lhs should be false")

    b := true || mustNotCall()
    assert(b == true, "|| with true lhs should be true")

    c := true && identity(false)
    assert(c == false, "&& true,false should be false")

    d := true && identity(true)
    assert(d == true, "&& true,true should be true")

    e := false || identity(true)
    assert(e == true, "|| false,true should be true")

    f := false || identity(false)
    assert(f == false, "|| false,false should be false")
}

func testTernaryPrecedenceBasic() {
    a := true ? 1 : 2
    b := false ? 10 : 20
    assert(a == 1, "true branch should be selected")
    assert(b == 20, "false branch should be selected")

    c := false ? 1 : 2 + 3
    assert(c == 5, "ternary else expression should evaluate fully")
}

func main() {
    testBitwiseIntegerMatrix()
    testCompoundAssignmentMatrix()
    testOverloadedCompoundAssignmentMatrix()
    testShortCircuitSideEffects()
    testTernaryPrecedenceBasic()

    std::print("PASS: operators\n")
}

// ENV: TARO_GC_STRESS=1
struct Packet[T] { tag: int32; payload: T; reference: &string }
@noinline
func replacement() -> int32 { std::runtime::collect(); 2 }
@noinline
func make() -> Packet[any std::fmt::Display] {
    var text = "kept " + "reference"
    var payload: any std::fmt::Display = "kept " + "payload"
    Packet { tag: 1, payload, reference: &text }
}
@noinline
func update[T](_ source: Packet[T]) -> Packet[T] { Packet { tag: replacement(), ..source } }
func main() {
    var original = make()
    var changed = update(original)
    original = make()
    std::runtime::collect()
    assert(changed.tag == 2 && *changed.reference == "kept reference", "references survive collecting explicit fields")
    assert(f"{changed.payload}" == "kept payload", "erased fields survive update copying and collection")
    *changed.reference = "shared"
    assert(*changed.reference == "shared", "copied reference remains writable")
}

const TEN: int32 = 10
const TWO: int32 = 2

struct MyStructure {}

static var GLOBAL: int32 = TEN * TWO + 1
static var COUNTER: int32 = TEN + TWO
static var OWNED_VALUE: Optional[MyStructure] = .none

namespace Metrics {
    static var STEP: int32 = 2
    static var SUM: int32 = 12
}

func bumpGlobalCounter() {
    COUNTER += 1
}

func bumpMetrics() {
    Metrics::SUM += Metrics::STEP
}

func main() {
    assert(GLOBAL == 21, "static value mismatch")
    assert(COUNTER == 12, "static var initial mismatch")
    assert(OWNED_VALUE.isNone(), "static optional none mismatch")
    assert(Metrics::STEP == 2, "namespace static mismatch")
    assert(Metrics::SUM == 12, "namespace static var initial mismatch")

    local := MyStructure {}
    OWNED_VALUE = .some(local)
    assert(OWNED_VALUE.isSome(), "static optional some mismatch")

    bumpGlobalCounter()
    bumpGlobalCounter()
    bumpMetrics()
    bumpMetrics()

    assert(COUNTER == 14, "static var mutation mismatch")
    assert(Metrics::SUM == 16, "namespace static var mutation mismatch")

    std::print("PASS: static variables\n")
}

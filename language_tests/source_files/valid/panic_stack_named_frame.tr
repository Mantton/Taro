// EXPECT_EXIT: 101
// EXPECT_STDERR_CONTAINS: panic: named-frame
// EXPECT_STDERR_CONTAINS: taro stack:
// EXPECT_STDERR_CONTAINS: namedPanicFrame
// EXPECT_STDERR_CONTAINS: inlinePanicFrame
@noinline
func namedPanicFrame(_ value: int64) -> int64 {
    if value > 0 {
        panic("named-frame")
    }
    return value
}

@inline
func inlinePanicFrame(_ value: int64) -> int64 {
    return namedPanicFrame(value) + 1
}

func main() {
    std.printf("%v\n", inlinePanicFrame(1))
}

// CHECK_ONLY
// Unified cfg test: attribute predicates + #cfg expressions.

@cfg(os("macos"))
func macosOnly() -> int32 {
    42
}

@cfg(os("linux"))
func linuxOnly() -> int32 {
    7
}

@cfg(os("windows"))
func windowsOnly() -> int32 {
    9
}

@cfg(!os("windows"))
func notWindows() -> int32 {
    1
}

@cfg(os("linux") || os("macos"))
func unixLike() -> int32 {
    2
}

@cfg(os("linux") && arch("x86_64"))
func linuxX64Only() -> int32 {
    3
}

@cfg(os("windows") && arch("x86_64"))
func windowsX64Only() -> int32 {
    4
}

func assertCond(_ cond: bool) {
    if !cond {
        var _ = 0
    }
}

func main() {
    hostMac := #cfg(os("macos"))
    hostLinux := #cfg(os("linux"))
    hostWindows := #cfg(os("windows"))
    hostNotWindows := #cfg(!os("windows"))
    hostUnixLike := #cfg(!os("windows") && (os("macos") || os("linux")))
    hostAppleSilicon := #cfg(os("macos") && arch("aarch64"))

    // Keep these used so CHECK_ONLY validates expression typing and predicate parsing.
    var _ = hostMac
    var _ = hostLinux
    var _ = hostWindows
    var _ = hostNotWindows
    var _ = hostUnixLike
    var _ = hostAppleSilicon
    assertCond(true)
}

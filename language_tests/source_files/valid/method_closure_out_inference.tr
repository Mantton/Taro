// CHECK_ONLY

import std::io::Error
import std::result::Result

struct Boxed[T] {
    value: T
}

extend[T] Boxed[T] {
    func withOut[R, F: std::ops::Fn(&T) -> R]( _ f: F) -> Result[R, Error] {
        ptr := unsafe { (&self.value as *const T) as *mut T }
        out := f(unsafe { ptr as &T })
        return .ok(out)
    }

    func withOutAsync[R, F: std::ops::Fn(&T) -> R]( _ f: F) async -> Result[R, Error] {
        ptr := unsafe { (&self.value as *const T) as *mut T }
        out := f(unsafe { ptr as &T })
        return .ok(out)
    }
}

func main() async {
    boxed := Boxed[int32] { value: 10 }

    var syncRes: Result[int32, Error] = boxed.withOut((value: &int32) => {
        *value = *value + 1
        return *value
    })

    var asyncRes: Result[int32, Error] = await boxed.withOutAsync((value: &int32) => {
        *value = *value + 1
        return *value
    })

    var _ = syncRes
    var _ = asyncRes
}

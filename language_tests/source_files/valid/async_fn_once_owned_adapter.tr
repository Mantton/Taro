func spawnBorrowedList() -> std::task::Task[int32] {
    var values = std::collections::List[int32]::new()
    values.append(10_i32)
    values.append(20_i32)

    // Escapable context moves values into the closure. The AsyncFnOnce adapter
    // owns the environment after this function returns and through suspension.
    return std::task::spawn(() async => {
        await std::testing::yieldNow()
        return values.len() as int32
    })
}

func invokePairOnce[F: std::ops::AsyncFn(int32, int32) -> int32](_ operation: F) async -> int32 {
    return await operation(19_i32, 23_i32)
}

func spawnGeneric[T](_ value: T) -> std::task::Task[T] {
    return std::task::spawn(() async => {
        await std::testing::yieldNow()
        return value
    })
}

func main() async {
    borrowedTask := spawnBorrowedList()
    borrowedCount := (await borrowedTask.result()).unwrap()
    assert(borrowedCount == 2_i32, "spawned closure should outlive its creator")

    pairResult := await invokePairOnce((left: int32, right: int32) async => {
        await std::testing::yieldNow()
        return left + right
    })
    assert(pairResult == 42_i32, "AsyncFnOnce should pack multiple arguments")

    var values = std::collections::List[int32]::new()
    values.append(7_i32)
    genericTask := spawnGeneric(values)
    returnedValues := (await genericTask.result()).unwrap()
    assert(returnedValues.len() == 1 as usize, "generic closure adapter should preserve captured types")

    std::print("PASS: owned AsyncFnOnce adapters\n")
}

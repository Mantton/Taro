struct EqBoxed {
    value: string
}

conform EqBoxed to std::ops::PartialEq {
    public func eq( _ other: EqBoxed) -> bool {
        self.value == other.value
    }
}

func compareThenReuse[T: std::ops::PartialEq](_ a: T, _ b: T) -> bool {
    same := a == b
    _keep := &a
    same
}

interface Retrieve[T] {
    func retrieve() -> T
}

struct GenericBoxed[T] {
    value: T
}

conform[T] GenericBoxed[T] to Retrieve[T] {
    func retrieve() -> T {
        self.value
    }
}

func main() {
    a := EqBoxed { value: "a" }
    b := EqBoxed { value: "a" }
    assert(compareThenReuse(a, b), "generic comparison should not move operands")

    x := 1
    rx := &x
    rrx := &rx
    assert(rx == x, "&T should compare with T")
    assert(rrx == *rx, "receiver autoderef preserves the explicit value RHS")
    assert(rrx == x, "&&T should compare with T")

    intBox := GenericBoxed[int32] { value: 42 }
    boolBox := GenericBoxed[bool] { value: true }
    assert(intBox.retrieve() == 42, "generic blanket impl should work for int32")
    assert(boolBox.retrieve(), "generic blanket impl should work for bool")

    std::print("ok\n")
}

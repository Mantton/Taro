// Tests for From/Into conversion traits.

struct Meters {
    value: int32
}

conform Meters to From[int32] {
    public static func from(_ value: int32) -> Meters {
        Meters { value: value }
    }
}

conform int32 to From[Meters] {
    public static func from(_ value: Meters) -> int32 {
        value.value
    }
}

struct Celsius {
    degrees: int32
}

struct Fahrenheit {
    degrees: int32
}

conform Fahrenheit to From[Celsius] {
    public static func from(_ c: Celsius) -> Fahrenheit {
        Fahrenheit { degrees: c.degrees * 9 / 5 + 32 }
    }
}

// Generic function using From bound - the primary way to call from()
func convertFrom[T, U: From[T]](_ value: T) -> U {
    U::from(value)
}

// Generic function using Into bound
func convertInto[T: Into[int32]](_ value: T) -> int32 {
    value.into()
}

// From with string conversion
struct Name {
    value: string
}

conform Name to From[string] {
    public static func from(_ s: string) -> Name {
        Name { value: s }
    }
}

// From between integer wrapper types
struct UserId {
    raw: int64
}

conform UserId to From[int64] {
    public static func from(_ id: int64) -> UserId {
        UserId { raw: id }
    }
}

conform int64 to From[UserId] {
    public static func from(_ value: UserId) -> int64 {
        value.raw
    }
}

// Multiple From impls on same type
struct Wrapper {
    value: int32
}

conform Wrapper to From[int32] {
    public static func from(_ v: int32) -> Wrapper {
        Wrapper { value: v }
    }
}

conform Wrapper to From[bool] {
    public static func from(_ b: bool) -> Wrapper {
        if b {
            Wrapper { value: 1 }
        } else {
            Wrapper { value: 0 }
        }
    }
}

func main() {
    // From via generic helper
    var m: Meters = convertFrom(3)
    assert(m.value == 3, "From[int32] for Meters failed")

    // Into method call (works directly since into takes self)
    var v: int32 = m.into()
    assert(v == 3, "Into[int32] for Meters failed")

    // Cross-type From via generic helper
    c := Celsius { degrees: 100 }
    var fahr: Fahrenheit = convertFrom(c)
    assert(fahr.degrees == 212, "From[Celsius] for Fahrenheit failed")

    // Cross-type Into
    c2 := Celsius { degrees: 0 }
    var fahr2: Fahrenheit = c2.into()
    assert(fahr2.degrees == 32, "Into[Fahrenheit] for Celsius failed")

    // Generic function with Into bound
    m2 := Meters { value: 42 }
    val := convertInto(m2)
    assert(val == 42, "convertInto with Into bound failed")

    // From with string via generic helper
    var name: Name = convertFrom("Alice")
    assert(name.value == "Alice", "From[string] for Name failed")

    // From/Into with integer wrapper
    var uid: UserId = convertFrom(123 as int64)
    assert(uid.raw == 123 as int64, "From[int64] for UserId failed")
    var raw: int64 = uid.into()
    assert(raw == 123 as int64, "Into[int64] for UserId failed")

    // Multiple From impls
    var w1: Wrapper = convertFrom(42)
    assert(w1.value == 42, "From[int32] for Wrapper failed")
    var w2: Wrapper = convertFrom(true)
    assert(w2.value == 1, "From[bool] for Wrapper (true) failed")
    var w3: Wrapper = convertFrom(false)
    assert(w3.value == 0, "From[bool] for Wrapper (false) failed")

    std::print("PASS: from_into\n")
}

// References are read explicitly; destructuring binds independent writable values.
func inspect(_ source: &int32) {
    var value = *source
    value += 1
    assert(value == 43 && *source == 42, "explicit read creates a writable copy")
}
func identity[T](_ value: T) -> T { value }
func main() {
    value := 42
    var copy = *&value
    var twice = **&&value
    var (nested,) = (*&value,)
    var (first, second) = *&(19, 23)
    var (typed,): (int32,) = (*&value,)
    var fromCall = *identity(&value)
    var source = 41
    var snapshot = *&source
    source = 0
    copy += 1
    assert(copy == 43 && value == 42, "local edits preserve the source")
    assert(twice == 42 && nested == 42 && typed == 42 && fromCall == 42, "explicit reference reads")
    assert(first + second == 42 && snapshot == 41, "destructuring reads values")
    inspect(&value)
    print("PASS: reference local values\n")
}

struct Counter {
    base: int32
}

impl Counter {
    func add(&self, value: int32 = 10) -> int32 {
        self.base + value
    }

    func run(&self, action: () -> int32 = || provider_call()) -> int32 {
        self.base + action()
    }
}

func add(a: int32, b: int32 = 10) -> int32 {
    a + b
}

func complex_default(a: int32, b: int32 = 5 + 5) -> int32 {
    a + b
}

func provider_call() -> int32 {
    100
}

func call_provider(a: int32, b: int32 = provider_call()) -> int32 {
    a + b
}

func call_closure(action: () -> int32 = || 42) -> int32 {
    action()
}

func call_global_closure(action: () -> int32 = || provider_call()) -> int32 {
    action()
}

func call_generic_closure[T](_ value: T, action: (T) -> T = |item: T| item) -> T {
    action(value)
}

func main() {
    let counter = Counter { base: 7 }

    assert(counter.add() == 17, "counter.add() default")
    assert(counter.add(value: 5) == 12, "counter.add(value: 5)")
    assert(counter.run() == 107, "counter.run() closure default")

    assert(add(a: 5) == 15, "add(a: 5)")
    assert(add(a: 5, b: 20) == 25, "add(a: 5, b: 20)")
    assert(complex_default(a: 5) == 15, "complex_default(a: 5)")
    assert(call_provider(a: 5) == 105, "call_provider(a: 5)")
    assert(call_closure() == 42, "no-capture closure default")
    assert(call_global_closure() == 100, "global-referencing closure default")
    assert(call_generic_closure(23) == 23, "generic closure default")

    std.print("PASS: Default parameters\n")
}

type int = isize

interface ValueContainer {
    type Item
    func get() -> Self::Item
}

struct IntBox {
    value: int
}

conform IntBox to ValueContainer {
    type Item = int
    func get() -> int {
        self.value
    }
}

func takeItem[T: ValueContainer](_ c: T) -> T::Item {
    var v: T::Item = c.get()
    v
}

func requireIntItem[T: ValueContainer[Item = int]](_ c: T) -> int {
    c.get()
}

interface Entity {
    func identifier() -> usize
}

interface Aircraft: Entity, Usable[bool] {}
interface Usable[T] {}

interface CollectionLike {
    type Item
    func len() -> usize
}

interface AssocA {
    type Element
    func first() -> Self::Element
}

interface AssocB {
    type Element
    func second() -> Self::Element
}

struct MyData {
    id: usize
    name: string
    isRegistered: bool
    flag: rune
}

conform MyData to Entity {
    func identifier() -> usize {
        self.id
    }
}

struct AssocContainer {
    data: *mut uint8
    len: usize
    cap: usize
}

conform AssocContainer to CollectionLike {
    type Item = Folder::Section::Side
    func len() -> usize {
        self.len
    }
}

struct AmbiguousSelf {}

conform AmbiguousSelf to AssocA {
    type Element = int32

    func first() -> Self::Element {
        1
    }
}

conform AmbiguousSelf to AssocB {
    type Element = bool

    func second() -> Self::Element {
        true
    }
}

type OptionalString = std::prelude::Optional[string]

struct Folder {}
extend Folder {
    type Section = Page

    func use( _ page: Self::Section) {}
}

struct Page {}
extend Page {
    type Side = rune
}

func main() {
    box := IntBox { value: 42 }
    assert(takeItem(box) == 42, "associated type retrieval failed")

    box2 := IntBox { value: 123 }
    assert(requireIntItem(box2) == 123, "associated type constraint binding failed")

    d := MyData {
        id: 123,
        name: "Test",
        isRegistered: true,
        flag: 'F',
    }
    assert(d.identifier() == 123, "interface method implementation check")

    c := AssocContainer {
        data: unsafe { 0 as *mut uint8 },
        len: 10,
        cap: 20,
    }
    assert(c.len() == 10, "collection implementation check")

    var maybeName: OptionalString = .some("ok")
    assert(maybeName.isSome(), "type alias over associated-type file should typecheck")

    ambiguousA := AmbiguousSelf {}
    assert(ambiguousA.first() == 1, "impl-local Self.Element should resolve to AssocA.Element")
    ambiguousB := AmbiguousSelf {}
    assert(ambiguousB.second(), "impl-local Self.Element should resolve to AssocB.Element")

    std::print("PASS: Associated types\n")
}

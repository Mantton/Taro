class Base { value: int32 }
extend Base { init(_ value: int32) { self.value = value }; }
class Middle: Base { other: &int32 }
extend Middle { init(_ value: int32, other: &int32) { super.init(value); self.other = other }; }
class Child: Middle {}
extend Child { init() { super.init(1) }; }
func main() { value := Child() }

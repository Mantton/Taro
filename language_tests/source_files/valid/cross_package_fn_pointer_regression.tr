// Taking a pointer to a non-generic function defined in another package
// (std) as a value. Such functions are not specialization roots of this
// package and are never pre-declared in this module, so lowering the
// function constant must declare the external symbol on demand instead of
// silently dropping the value.

func apply(_ f: (double) -> double, _ x: double) -> double {
    return f(x)
}

func main() {
    // Stored as a value, then called indirectly.
    let f: (double) -> double = std.math.sqrt
    assert(f(81.0) == 9.0, "sqrt through a stored fn pointer should compute 9")

    // Passed directly as a fn pointer argument.
    assert(apply(std.math.abs, -4.0) == 4.0, "abs through a fn pointer argument should compute 4")

    print("PASS: cross package fn pointer regression\n")
}

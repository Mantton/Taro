struct AliasConstructorPair[Left, Right] {
    left: Left
    right: Right
}

impl[Left, Right] AliasConstructorPair[Left, Right] {
    func new(_ left: Left, _ right: Right) -> Self {
        Self { left, right }
    }
}

type ReorderedAlias[Value] = AliasConstructorPair[string, Value]
type ChainedAlias[Value] = ReorderedAlias[Value]

func main() {
    // Shorthand construction remaps the alias's generic arguments.
    let pair = ChainedAlias[int32]("answer", 42)
    assert(pair.left == "answer", "alias constructor should preserve fixed generic arguments")
    assert(pair.right == 42, "alias constructor should preserve forwarded generic arguments")
    print("PASS: type alias constructor\n")
}

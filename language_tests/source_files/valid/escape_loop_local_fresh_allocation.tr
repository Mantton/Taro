// Owned ARC links preserve allocation identity across loops and closures.
final class EscapeLoopNode {
    value: int64
    next: Optional[EscapeLoopNode]
}

extend EscapeLoopNode {
    init(_ value: int64, _ next: Self?) { self.value = value; self.next = next }
}

func dumpEscapeLoopChain(_ initial: Optional[EscapeLoopNode], _ limit: int64) {
    var cursor = initial
    var steps = 0 as int64
    while steps < limit {
        match cursor {
            case .some(node) => {
                std::printf(" %v", node.value)
                cursor = node.next
            }
            case .none => break
        }
        steps += 1
    }

    match cursor {
        case .none => std::printf(" end\n")
        case .some(_) => std::printf(" cycle\n")
    }
}

func buildEscapeLoopChain() -> Optional[EscapeLoopNode] {
    var head: Optional[EscapeLoopNode] = .none
    var i = 0 as int64
    while i < 4 {
        var node: EscapeLoopNode = EscapeLoopNode(i, head)
        head = .some(node)
        i += 1
    }
    return head
}

func buildNestedEscapeLoopChain() -> Optional[EscapeLoopNode] {
    var head: Optional[EscapeLoopNode] = .none
    var outer = 0 as int64
    while outer < 2 {
        var inner = 0 as int64
        while inner < 2 {
            var node: EscapeLoopNode = EscapeLoopNode(outer * 10 + inner, head)
            head = .some(node)
            inner += 1
        }
        outer += 1
    }
    return head
}

func mutateBeforeBorrow(_ value: &int64) -> &int64 {
    *value = 2
    return &*value
}

func main() {
    std::printf("loop:")
    dumpEscapeLoopChain(buildEscapeLoopChain(), 10)

    std::printf("nested:")
    dumpEscapeLoopChain(buildNestedEscapeLoopChain(), 10)

    buildInClosure := () -> Optional[EscapeLoopNode] => {
        var head: Optional[EscapeLoopNode] = .none
        var i = 0 as int64
        while i < 3 {
            var node: EscapeLoopNode = EscapeLoopNode(i, head)
            head = .some(node)
            i += 1
        }
        return head
    }
    std::printf("closure:")
    dumpEscapeLoopChain(buildInClosure(), 10)

    var value: int64 = 1
    std::printf("mutation: %v\n", *mutateBeforeBorrow(&value))
}

struct EscapeLoopNode {
    value: int64
    next: Optional[&EscapeLoopNode]
}

func dumpEscapeLoopChain(_ initial: Optional[&EscapeLoopNode], _ limit: int64) {
    var cursor = initial
    var steps = 0 as int64
    while steps < limit {
        match cursor {
            case .some(node) => {
                std.printf(" %v", node.value)
                cursor = node.next
            }
            case .none => break
        }
        steps += 1
    }

    match cursor {
        case .none => std.printf(" end\n")
        case .some(_) => std.printf(" cycle\n")
    }
}

func buildEscapeLoopChain() -> Optional[&EscapeLoopNode] {
    var head: Optional[&EscapeLoopNode] = .none
    var i = 0 as int64
    while i < 4 {
        let node = EscapeLoopNode { value: i, next: head }
        head = .some(&node)
        i += 1
    }
    return head
}

func buildNestedEscapeLoopChain() -> Optional[&EscapeLoopNode] {
    var head: Optional[&EscapeLoopNode] = .none
    var outer = 0 as int64
    while outer < 2 {
        var inner = 0 as int64
        while inner < 2 {
            let node = EscapeLoopNode {
                value: outer * 10 + inner,
                next: head,
            }
            head = .some(&node)
            inner += 1
        }
        outer += 1
    }
    return head
}

func mutateEscapingLocalAfterBorrow() -> &int64 {
    var value = 1 as int64
    let borrowed = &value
    value = 2
    return borrowed
}

func main() {
    std.printf("loop:")
    dumpEscapeLoopChain(buildEscapeLoopChain(), 10)

    std.printf("nested:")
    dumpEscapeLoopChain(buildNestedEscapeLoopChain(), 10)

    let buildInClosure = || -> Optional[&EscapeLoopNode] {
        var head: Optional[&EscapeLoopNode] = .none
        var i = 0 as int64
        while i < 3 {
            let node = EscapeLoopNode { value: i, next: head }
            head = .some(&node)
            i += 1
        }
        return head
    }
    std.printf("closure:")
    dumpEscapeLoopChain(buildInClosure(), 10)

    std.printf("mutation: %v\n", *mutateEscapingLocalAfterBorrow())
}

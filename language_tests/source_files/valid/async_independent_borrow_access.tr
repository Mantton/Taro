func tick() async {}
func read(_ value: &int32) async -> int32 {
    await tick()
    *value
}
func increment(_ value: &int32) async {
    await tick()
    *value += 1
}
func main() async {
    var value: int32 = 7 // int32
    var observed: int32 = await read(&value)
    assert(observed == 7, "private shared input survives direct await")
    value = 11 // The independent ready result does not prolong the input borrow.
    await increment(&value)
    assert(value == 12, "private exclusive input survives direct await")
    var saved: &int32 = &value
    await tick()
    assert(*saved == 12, "local borrow remains live across independent suspension")
    value = 13 // Last dependent use has finished.
    assert(value == 13, "mutation after last use")
}

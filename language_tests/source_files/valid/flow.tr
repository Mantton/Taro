// CHECK_ONLY
// EXPECT_STDERR_CONTAINS: flow.tr:73
// EXPECT_STDERR_CONTAINS: flow.tr:79
// EXPECT_STDERR_CONTAINS: flow.tr:86
// EXPECT_STDERR_CONTAINS: flow.tr:92
// NO_INCREMENTAL
func diverge() -> ! {
    loop {}
}

func implicitReturn(_ flag: bool) -> int32 {
    if flag {
        1
    } else {
        2
    }
}

func exhaustiveWithNever(_ flag: bool) -> int32 {
    match flag {
        case true => 10
        case false => diverge()
    }
}

func loopBreakInitializes() -> int32 {
    var value: int32
    loop {
        value = 42
        break
    }
    value
}

func coerceInt(_ flag: bool) -> int32 {
    if flag {
        return diverge()
    }
    7
}

func coerceString(_ flag: bool) -> string {
    if flag {
        return diverge()
    }
    "ok"
}

unsafe func helperWrite(_ dst: *mut string, _ value: string) {
    unsafe { dst.write(value) }
}

func maybeUninitInt() -> int32 {
    var slot = std::mem::MaybeUninit[int32]::uninit()
    var _ = slot.write(12)
    unsafe { slot.assumeInit() }
}

func maybeUninitString() -> string {
    var slot = std::mem::MaybeUninit[string]::zeroed()
    var _ = slot.write("hello")
    unsafe { slot.assumeInit() }
}

func maybeUninitThroughPtr() -> string {
    var slot = std::mem::MaybeUninit[string]::uninit()
    unsafe { helperWrite(slot.asMutPtr(), "world") }
    unsafe { slot.assumeInit() }
}

func afterReturn() {
    return
    unreachable := 1
}

func afterBreak() {
    loop {
        break
        unreachable := 1
    }
}

func afterContinue() {
    loop {
        continue
        unreachable := 1
    }
}

func afterNeverCall() {
    diverge()
    unreachable := 1
}

func returnOrContinueInWhile(_ values: &List[string]) -> Result[usize, string] {
    var index: usize = 0
    while index < values.len() {
        if *values.at(index) == "skip" {
            index += 1
            continue
        }
        return .err("unexpected value")
    }
    return .ok(index)
}

func main() {
    var _ = implicitReturn(true)
    var _ = exhaustiveWithNever(true)
    var _ = loopBreakInitializes()
    var _ = coerceInt(false)
    var _ = coerceString(false)
    var _ = maybeUninitInt()
    var _ = maybeUninitString()
    var _ = maybeUninitThroughPtr()
    afterReturn()
    afterBreak()
    afterContinue()
    var values = List[string]::new()
    values.append("skip")
    var _ = returnOrContinueInWhile(&values)
}

func deferReadsLaterInit() -> string {
    var value: string
    {
        defer { var _ = value }
        value = "later"
    }
    value
}

func nestedDeferLifo() -> string {
    var value: string
    {
        defer { var _ = value }
        defer { value = "from cleanup" }
    }
    value
}

func deferInitializesOnBreak() -> int32 {
    var value: int32
    loop {
        {
            defer { value = 3 }
            break
        }
    }
    value
}

func deferOnReturnSeesLaterInit() -> string {
    var value: string
    defer { var _ = value }
    value = "ready"
    return value
}

func deferredNeverCoversMissingReturn() -> int32 {
    defer { diverge() }
}

func deferredNeverSatisfiesBang() -> ! {
    defer { diverge() }
}

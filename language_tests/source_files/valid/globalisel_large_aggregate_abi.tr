// Preserve large Result/Error argument coverage while the public TryLock API
// follows Go and reports contention as false.
func acquire(_ mutex: &std::sync::Mutex[int32]) -> Result[(), std::io::Error] {
    match mutex.tryLock() {
        case .ok(true) => return .ok(())
        case .ok(false) => return .err(std::io::Error::new(.wouldBlock))
        case .err(error) => return .err(error)
    }
}
func main() async {
    var mutex = std::sync::Mutex[int32]::new(7_i32).unwrap()
    acquire(&mutex).unwrap()
    match acquire(&mutex) {
        case .ok(_) => std::panic::panic("nested mutex lock should block")
        case .err(error) => assert(error.isKind(.wouldBlock), "large aggregate arguments preserve error kind")
    }
    mutex.unlock().unwrap()
    std::print("PASS: large aggregate arguments preserve the AArch64 ABI\n")
}

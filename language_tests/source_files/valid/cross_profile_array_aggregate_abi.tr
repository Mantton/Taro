import std.io.{SeekFrom, Seeker}

// Attached standard-library artifacts are release-built while this test's
// executable is debug-built. Passing SeekFrom across that boundary exercises
// SelectionDAG and GlobalISel with the same array-backed enum representation.
func main() {
    let path = "taro_cross_profile_array_aggregate_abi.txt"
    let _ = std.fs.removeFile(path)
    assert(std.fs.writeString(path, "abi").isOk(), "fixture file should be created")

    var file = std.fs.File.open(path).unwrap()
    let start: SeekFrom = .start(0 as isize)
    match file.seek(start) {
        case .ok(offset) => assert(offset == 0, "seek payload should cross the package ABI intact")
        case .err(_) => std.panic.panic("seek should accept a cross-profile enum payload")
    }
    let _ = file.close()
    let _ = std.fs.removeFile(path)
    print("PASS: array-backed aggregates preserve the cross-profile ABI\n")
}

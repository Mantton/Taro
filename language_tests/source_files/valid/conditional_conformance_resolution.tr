interface ConditionalSource {
    func value() -> int32
}

interface ConditionalAdapter {
    func adapted() -> int32
}

struct ConditionalWrapper[Source: ConditionalSource] {
    source: Source
}

conform[Source: ConditionalSource] ConditionalWrapper[Source] to ConditionalAdapter {
    func adapted() -> int32 {
        self.source.value()
    }
}

func requireAdapter[Adapter: ConditionalAdapter](_ adapter: &Adapter) -> int32 {
    adapter.adapted()
}

struct ConditionalConcreteSource {
    stored: int32
}

conform ConditionalConcreteSource to ConditionalSource {
    func value() -> int32 {
        self.stored
    }
}

// Conditional conformance selection uses bounds from the generic caller.
func adaptGeneric[Source: ConditionalSource](_ source: Source) -> int32 {
    wrapper := ConditionalWrapper[Source] { source }
    requireAdapter(&wrapper)
}

func main() {
    result := adaptGeneric(ConditionalConcreteSource { stored: 42 })
    assert(result == 42, "conditional conformance should use caller parameter environment")
    print("PASS: conditional conformance resolution\n")
}

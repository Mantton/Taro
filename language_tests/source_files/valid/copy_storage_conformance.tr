struct Owner {
    values: [int32]
}

struct References[T] {
    read: &T
    other: &T
}

struct MutableReference[T] { write: &T }

struct Inline[T] {
    value: T
}

type Payload[T] = (T, [T; 2])
struct Aggregate[T] {
    payload: Payload[T]
    optional: T?
    nested: Payload[T]?
}

enum Choice[T] {
    case empty
    case pair(T, T)
}

interface CopySource {
    type Value
}
struct IntegerSource {}
conform IntegerSource to CopySource {
    type Value = int32
}
struct Associated[T: CopySource] {
    value: T::Value
    nested: (T::Value, [T::Value; 2])?
}

struct Specialized[A, B] {
    first: A
    second: B
}

struct Phantom[T] {
    tag: int32
}

interface CopyRefinement {
    func read() -> int32
}
struct ErasedValue {
    number: int32
}
conform ErasedValue to CopyRefinement {
    func read() -> int32 { return self.number }
}
struct Refined[T: CopyRefinement] {
    value: T
    nested: (T, [T; 2])?
}

func duplicate[T](_ value: T) -> (T, T) {
    return (value, value)
}

func main() {
    copies := duplicate(Inline[int32] { value: 7 })
    assert(copies.0.value == copies.1.value, "inline generic Copy")

    aggregate := Aggregate[int32] { payload: (3, [4, 5]), optional: .some(6), nested: .none }
    aggregates := duplicate(aggregate)
    assert(aggregates.0.payload.0 == aggregates.1.payload.0, "tuple, array, alias and conditional Copy")
    assert(aggregates.0.optional.unwrap() == 6, "nested conditional conformance")

    choices := duplicate(Choice[int32]::pair(8, 9))
    match choices.1 {
        case .pair(first, second) => assert(first + second == 17, "enum payload Copy")
        case .empty => assert(false, "expected payload")
    }

    associated := duplicate(Associated[IntegerSource] { value: 10, nested: .some((11, [12, 13])) })
    assert(associated.1.value == 10, "associated type bound")
    assert(associated.1.nested.unwrap().0 == 11, "nested associated type bound")

    specialized := duplicate(Specialized[int32, int32] { first: 11, second: 12 })
    assert(specialized.1.second == 12, "specialized impl substitutes field parameters")

    phantom := duplicate(Phantom[Owner] { tag: 13 })
    assert(phantom.1.tag == 13, "unused type parameter need not implement Copy")

    refined := duplicate(Refined[ErasedValue] { value: ErasedValue { number: 14 }, nested: .none })
    assert(refined.1.value.read() == 14, "inherited Copy bound")
    var erased: any CopyRefinement = ErasedValue { number: 15 }
    assert(erased.read() == 15, "virtual calls use the payload's conformance")

    var owner = Owner { values: [1, 2] }
    refs := duplicate(References[Owner] { read: &owner, other: &owner })
    assert(refs.0.read.values.len() == 2 && refs.1.other.values.len() == 2, "shared references copy without requiring pointee Copy")
    unique := MutableReference[Owner] { write: &owner }
    unique.write.values.set(0, 99)
    assert(*owner.values.at(0) == 99, "a noncopyable mutable reference updates its pointee")
}

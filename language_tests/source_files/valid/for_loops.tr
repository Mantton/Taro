// Simple range iterator for testing
final class RangeIterator {
    current: int32
    end: int32
}

extend RangeIterator {
    init(current: int32, end: int32) {
        self.current = current
        self.end = end
    }
}

conform RangeIterator to Iterator {
    type Element = int32

    func next() -> Optional[int32] {
        if self.current < self.end {
            value := self.current
            self.current = self.current + 1
            return Optional::some(value)
        }
        return Optional::none
    }
}

struct SimpleRange {
    start: int32
    end: int32
}

conform SimpleRange to Iterable {
    type Iterator = RangeIterator
    type Element = int32

    func iter() -> RangeIterator {
        return RangeIterator ( current: self.start, end: self.end )
    }
}

func main() {
    // Test 1: Basic for loop
    var sum = 0
    range := SimpleRange { start: 0, end: 5 }
    for i in range {
        sum = sum + i
    }
    assert(sum == 10, "Basic for loop sum failed") // 0 + 1 + 2 + 3 + 4 = 10


    // Test 2: For loop with where clause
    var even_sum = 0
    range2 := SimpleRange { start: 0, end: 10 }
    for i in range2 where i % 2 == 0 {
        even_sum = even_sum + i
    }
    assert(even_sum == 20, "Even sum failed") // 0 + 2 + 4 + 6 + 8 = 20

    // Test 3: Nested for loops
    var product_sum = 0
    // We need to re-instantiate or cloned if it consumed,
    // but here we just create new ones.
    x := SimpleRange { start: 1, end: 4 }
    for i in x {
        y := SimpleRange { start: 1, end: 4 }
        for j in y {
            product_sum = product_sum + i * j
        }
    }
    assert(product_sum == 36, "Nested product sum failed") // (1+2+3) * (1+2+3) = 6 * 6 = 36


    // Test 4: Break in for loop
    var last = 0
    range3 := SimpleRange { start: 0, end: 100 }
    for i in range3 {
        if i >= 5 {
            break
        }
        last = i
    }
    assert(last == 4, "Break failed")

    // Test 5: Continue in for loop
    var skip_sum = 0
    range4 := SimpleRange { start: 0, end: 5 }
    for i in range4 {
        if i == 2 {
            continue
        }
        skip_sum = skip_sum + i
    }
    assert(skip_sum == 8, "Continue failed") // 0 + 1 + 3 + 4 = 8
    print("All for loop tests passed!\n")
}

// CHECK_ONLY

final class CountingAsyncIterator {
    current: int32
    end: int32
}

extend CountingAsyncIterator {
    init(current: int32, end: int32) {
        self.current = current
        self.end = end
    }
}

conform CountingAsyncIterator to AsyncIterator {
    type Element = int32

    func next() async -> Optional[int32] {
        if self.current >= self.end {
            return .none
        }

        value := self.current
        self.current += 1
        await std::testing::yieldNow()
        return .some(value)
    }
}

struct CountingAsyncRange {
    start: int32
    end: int32
}

conform CountingAsyncRange to AsyncIterable {
    type Iterator = CountingAsyncIterator
    type Element = int32

    func iter() -> Self::Iterator {
        return CountingAsyncIterator (
            current: self.start,
            end: self.end,
        )
    }
}

func main() async {
    source := CountingAsyncRange { start: 0, end: 6 }
    var evenSum = 0 as int32

    for await value in source where value % 2 == 0 {
        evenSum += value
    }

    assert(evenSum == 6, "for await + where should iterate async iterables")

    var grouped: int32 = await std::task::withTaskGroup((group: &std::task::TaskGroup[int32]) async => {
        group.spawn(() async => {
            await std::testing::yieldNow()
            return 11 as int32
        })
        group.spawn(() async => {
            return 31 as int32
        })

        var sum = 0 as int32
        for await value in group {
            sum += value
        }

        return sum
    })

    assert(grouped == 42, "for await should work for task groups via AsyncIterable")
}

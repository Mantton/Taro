// Precise stack maps must follow temporal MIR liveness and the active enum
// variant. These cases intentionally collect while the creating frame remains
// active, which catches conservative whole-frame root maps.

struct PreciseOwner {
    value: int32
}

struct PartiallyMovedRoot {
    discarded: std.collections.List[int32]
    retained: &mut PreciseOwner
}

enum PreciseSlot {
    case empty
    case occupied(&mut PreciseOwner)
}

func deadLocalDoesNotRetain() {
    let owner = make(PreciseOwner { value: 11 })
    let weak = std.weak.Weak(owner)

    // `owner` has no continuation use and must not appear in this call's map.
    std.runtime.collect()
    assert(weak.value().isNone(), "a dead local retained its weak target")
}

func keepAliveExtendsLifetime() {
    let owner = make(PreciseOwner { value: 22 })
    let weak = std.weak.Weak(owner)

    std.runtime.collect()
    // This compiler-only use is after the collection, so `owner` must be live
    // across it even though keepAlive emits no runtime call or poll.
    std.runtime.keepAlive(owner)
    assert(weak.value().isSome(), "keepAlive did not extend the target lifetime")
}

func inactiveVariantDoesNotRetain() {
    let owner = make(PreciseOwner { value: 33 })
    let weak = std.weak.Weak(owner)
    var slot: PreciseSlot = .occupied(owner)
    slot = .empty

    std.runtime.collect()
    // Keep the enum storage itself live while its inactive payload still holds
    // whatever bytes the occupied representation left behind.
    std.runtime.keepAlive(&slot)
    assert(weak.value().isNone(), "an inactive enum payload retained its target")
}

func activeVariantRetains() {
    let owner = make(PreciseOwner { value: 44 })
    let weak = std.weak.Weak(owner)
    let slot: PreciseSlot = .occupied(owner)

    std.runtime.collect()
    std.runtime.keepAlive(&slot)
    assert(weak.value().isSome(), "an active enum payload lost its target")
}

func projectedMovePreservesRemainingRoot() {
    let owner = make(PreciseOwner { value: 55 })
    let weak = std.weak.Weak(owner)
    var discarded = std.collections.List[int32]()
    discarded.append(1)
    let aggregate = PartiallyMovedRoot {
        discarded: discarded,
        retained: owner,
    }
    let moved = aggregate.discarded

    std.runtime.collect()
    // Whole-local analysis deliberately remains conservative after a field
    // move: the other fields are still initialized and must remain scannable.
    std.runtime.keepAlive(&aggregate.retained)
    std.runtime.keepAlive(&moved)
    assert(weak.value().isSome(), "a projected move hid a remaining live root")
}

func main() {
    deadLocalDoesNotRetain()
    keepAliveExtendsLifetime()
    inactiveVariantDoesNotRetain()
    activeVariantRetains()
    projectedMovePreservesRemainingRoot()
    print("PASS: precise GC liveness\n")
}

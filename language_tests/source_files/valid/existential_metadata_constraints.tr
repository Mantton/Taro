interface MetaBase {
    func id() -> int32
}

interface MetaGate {}
interface MetaConditional {}

struct MetaWrap[T] {
    value: T
}

conform[T] MetaWrap[T] to MetaBase {
    func id() -> int32 {
        1
    }
}

struct MetaAllowed {}

conform MetaAllowed to MetaGate {}
conform[T: MetaGate] MetaWrap[T] to MetaConditional {}

func main() {
    plain := MetaWrap[int32] { value: 1 }
    var plainBase: any MetaBase = plain
    assert(
        !(plainBase is any MetaConditional),
        "metadata should exclude conditional interfaces when bounds fail",
    )

    allowed := MetaWrap[MetaAllowed] { value: MetaAllowed {} }
    var allowedBase: any MetaBase = allowed
    assert(
        allowedBase is any MetaConditional,
        "metadata should include conditional interfaces when bounds hold",
    )

    maybePlain := plainBase as? any MetaConditional
    match maybePlain {
        case .some(_) => assert(false, "downcast should fail when conditional interface is absent")
        case .none => {}
    }

    maybeAllowed := allowedBase as? any MetaConditional
    match maybeAllowed {
        case .some(_) => {}
        case .none => assert(false, "downcast should succeed when conditional interface is present")
    }

    std::print("PASS: existential metadata constraints\n")
}

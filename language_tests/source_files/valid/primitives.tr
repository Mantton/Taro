// Tests: language primitives, numeric literal bases, and cast edge cases.

func use() -> rune { 'A' }
func raise(value: rune) -> rune { value }
func raise(number: rune) -> int32 { 0 }

func take() -> uint8 { 0 }
func take(value: uint8) -> uint8 { value }

func isGreaterThanZero(value: int32) -> bool {
    value > 0
}

func usePlain() {
    a := 10
    assert(a == 10, "int literal")

    var b: int32 = 10
    assert(b == 10, "explicit int32")

    c := true
    assert(c, "bool literal")

    d := 'A'
    assert(d == 'A', "rune literal")

    var _ = 1.0
    var _e: double = 1.0
}

func useLocalIdentifier() {
    a := true
    b := a
    assert(b == true, "local identifier assignment")
}

func useNonOverloadCall() {
    a := use()
    assert(a == 'A', "simple call")

    var b: int32 = raise(number: a)
    assert(b == 0, "call with param -> int32")

    var c: rune = raise(value: a)
    assert(c == 'A', "call with param -> rune")
}

func useOverloadCall() {
    var x: uint8 = 10
    a := take(value: x)
    assert(a == 10, "overload by param")

    b := take()
    assert(b == 0, "overload no-arg")
}

func useUnaryOperator() {
    a := true
    b := !a
    assert(b == false, "unary !")

    n := 10
    neg := -10
    pos := -neg
    assert(pos == n, "unary -")
}

func useBinaryOperator() {
    var a: usize = 1 + 1
    assert(a == 2, "binary +")
}

func useIfElse() {
    a := 10
    b := isGreaterThanZero(value: a)
    assert(b == true, "params check")

    c := if b {
        'A'
    } else if a == 0 {
        'B'
    } else {
        'C'
    }
    assert(c == 'A', "if-else taken branch")

    d := if false { 'A' } else { 'B' }
    assert(d == 'B', "if-else else branch")
}

func testNonDecimalIntegerLiterals() {
    var hex: uint64 = 0xDEADBEEF
    assert(hex == 3735928559, "hex literal")

    var hex_sep: uint64 = 0xFF_FF
    assert(hex_sep == 65535, "hex literal separators")

    var max_u64_hex: uint64 = 0xffff_ffff_ffff_ffff
    assert(max_u64_hex == 18446744073709551615, "max uint64 hex")

    var bin: uint32 = 0b10101010
    assert(bin == 170, "binary literal")

    var bin_sep: uint32 = 0b1010_0101
    assert(bin_sep == 165, "binary literal separators")

    var oct: uint32 = 0o755
    assert(oct == 493, "octal literal")

    var oct_sep: uint32 = 0o7_5_5
    assert(oct_sep == 493, "octal literal separators")
}

func testFloatCastToFloat() {
    var a: float = (-0.0) as float
    var b: float = (1.25) as float
    var c: float = ((1.0 as double) / (2.0 as double)) as float

    assert(a == (0.0 as float), "-0.0 cast to float")
    assert(b == (1.25 as float), "double literal cast to float")
    assert(c == (0.5 as float), "double expression cast to float")
}

func testLargeIntegerLiteralCasts() {
    var a: uint64 = 3931806377309739662 as uint64
    assert(a == 3931806377309739662, "large uint64 cast")

    var b: uint64 = 18446744073709551615 as uint64
    assert(b == 18446744073709551615, "max uint64 cast")
}

func testMixedSignednessCasts() {
    // Widening extends based on the source signedness: unsigned sources
    // zero-extend, even into signed targets.
    var a: uint8 = 200
    assert((a as int16) == 200, "uint8 zero-extends to int16")
    assert((a as int64) == 200, "uint8 zero-extends to int64")
    assert((a as uint64) == 200, "uint8 zero-extends to uint64")

    // Signed sources sign-extend, even into unsigned targets.
    var b: int8 = -1
    assert((b as int64) == -1, "int8 sign-extends to int64")
    assert((b as uint64) == 18446744073709551615, "int8 sign-extends to uint64")

    var c: int8 = -56
    assert((c as int64) == 0 - 56, "negative int8 sign-extends to int64")
    assert((c as uint16) == 65480, "negative int8 sign-extends to uint16")

    // Same-width casts reinterpret the bits.
    assert((a as int8) == c, "uint8 to int8 reinterprets bits")
    assert((c as uint8) == a, "int8 to uint8 reinterprets bits")

    // Truncation drops high bits regardless of signedness.
    var d: uint16 = 511
    assert((d as uint8) == 255, "uint16 truncates to uint8")

    var e: int64 = -1
    assert((e as uint8) == 255, "int64 truncates to uint8")

    r := 'A'
    assert((r as uint32) == 65, "rune widens to uint32")
    assert((r as int64) == 65, "rune widens to int64")
    assert((r as uint64) == 65, "rune widens to uint64")

    var byte: uint8 = 255
    codepoint := byte as rune
    assert(codepoint == '\u{00FF}', "uint8 converts to the same rune value")
}

func testNegativeLiteralInference() {
    // Unary minus on a literal infers from the annotation instead of
    // defaulting to int32.
    var a: int8 = -56
    assert((a as uint8) == 200, "int8 annotation on negated literal")

    var b: int16 = -32767
    assert((b as uint16) == 32769, "int16 annotation on negated literal")

    var c: int64 = -1
    assert((c as uint64) == 18446744073709551615, "int64 annotation on negated literal")

    var f: float = -1.5
    var zero: float = 0.0
    assert(zero - f == (1.5 as float), "float annotation on negated literal")

    // A literal-only arithmetic expression unifies against a concrete side
    // of a comparison instead of being rejected as unresolved.
    assert(c == 0 - 1, "literal expression compares against int64")

    n := -5
    assert(n + 5 == 0, "default-typed negated literal arithmetic")
}

func main() {
    usePlain()
    useLocalIdentifier()
    useNonOverloadCall()
    useOverloadCall()
    useUnaryOperator()
    useBinaryOperator()
    useIfElse()

    testNonDecimalIntegerLiterals()
    testFloatCastToFloat()
    testLargeIntegerLiteralCasts()
    testMixedSignednessCasts()
    testNegativeLiteralInference()

    print("PASS: Primitives\n")
}

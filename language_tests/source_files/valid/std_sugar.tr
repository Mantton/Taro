// CHECK_ONLY

import std::collections::List

struct Inner {
    value: int32
}

struct Outer {
    inner: Inner
}

func stdSugarCompileCoverage() {
    // Optional type + chaining + default
    outer := Outer { inner: Inner { value: 7 } }
    var maybe_outer: Outer? = .some(outer)
    maybe_value := maybe_outer?.inner.value
    value := maybe_value ?? 0

    // Ternary
    selected := value > 0 ? value : 1
    var _ = selected

    // Optional pattern binding (`if var`)
    var maybe_number: int32? = .some(3)
    if var n = maybe_number {
        var _ = n
    }

    // List type sugar + for-loop + range/closed-range sugar
    var numbers: [int32] = List::new()
    for i in 1_i32..=3_i32 {
        numbers.append(i)
    }

    var sum: int32 = 0
    for n in numbers {
        sum += n
    }
    var _ = sum

    // Dictionary type sugar + literal sugar
    var seeded: [int32: string] = [1: "one", 2: "two"]
    var empty: [int32: string] = [:]
    var _ = empty.insert(key: 3, value: "three")
    var _ = seeded.contains(&1)

    // Half-open range sugar
    var count: int32 = 0
    for _ in 0_i32..3_i32 {
        count += 1
    }
    var _ = count
}

func main() {
    stdSugarCompileCoverage()
}

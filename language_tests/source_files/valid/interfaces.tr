// Consolidated interface language tests.

interface MarkerN[const N: usize] {
    func id() -> usize
}

struct ConstUser {
    id: usize
    name: string
}

conform ConstUser to MarkerN[1] {
    func id() -> usize { self.id }
}

func takesOne(_ v: any MarkerN[1]) {
    val := v.id()
    assert(val == 42, "Marker[1] dispatch failed")
}

func testInterfaceConstGenerics() {
    user := ConstUser { id: 42, name: "Alice" }
    takesOne(user)
}

interface SameAs[T = Self] {
    func same( _ other: &T) -> bool
}

struct BoxedSameAs {
    value: int32
}

conform BoxedSameAs to SameAs {
    func same( _ other: &BoxedSameAs) -> bool {
        self.value == other.value
    }
}

func testDefaultGenericSelfSubstitution() {
    a := BoxedSameAs { value: 7 }
    b := BoxedSameAs { value: 7 }
    assert(a.same(&b), "default generic argument Self should substitute to concrete impl self type")
}

func testDefaultGenericSelfSubstitutionVirtual() {
    a := BoxedSameAs { value: 11 }
    b := BoxedSameAs { value: 11 }
    var erased: any SameAs[BoxedSameAs] = a
    assert(erased.same(&b), "a statically fixed argument type dispatches through existential")
}

interface HashableDM {
    func hash[H]( _ hasher: &H)
}

interface HasherDM {
    func combine[V: HashableDM]( _ value: V) {
        value.hash(&self)
    }
}

struct TokenDM {}

conform TokenDM to HashableDM {
    public func hash[H]( _ hasher: &H) {}
}

struct DummyHasherDM {}

conform DummyHasherDM to HasherDM {}

func feedDM[H: HasherDM](_ hasher: &H) {
    hasher.combine(TokenDM {})
}

func testDefaultMethodConcreteAndForwarding() {
    var hasher = DummyHasherDM {}
    hasher.combine(TokenDM {})
    feedDM(&hasher)
}

interface ContainerGI[T] {
    func retrieve() -> T
}

struct GenericUser {
    id: usize
    name: string
}

conform GenericUser to ContainerGI[string] {
    func retrieve() -> string {
        self.name
    }
}

conform GenericUser to ContainerGI[usize] {
    func retrieve() -> usize {
        self.id
    }
}

func printStringContainerGI(_ value: any ContainerGI[string]) {
    str := value.retrieve()
    assert(str == "Alice", "String container retrieve failed")
}

func printIntContainerGI(_ value: any ContainerGI[usize]) {
    id := value.retrieve()
    match id {
        case 42 => assert(true, "Found correct ID")
        case _ => assert(false, "Found wrong ID")
    }
}

func testInterfaceGenericImpl() {
    user := GenericUser { id: 42, name: "Alice" }
    printStringContainerGI(user)
    printIntContainerGI(user)
}

interface IdentifiableIH {
    func identifier() -> usize
}

interface EntityIH: IdentifiableIH {
    func name() -> string
}

struct InheritUser {
    id: usize
    name: string
}

conform InheritUser to IdentifiableIH {
    func identifier() -> usize {
        self.id
    }
}

conform InheritUser to EntityIH {
    func name() -> string {
        self.name
    }
}

func printEntityIH(_ value: any EntityIH) {
    str := value.name()
    assert(str == "Alice", "Name check failed")

    id := value.identifier()
    match id {
        case 42 => assert(true, "ID matched")
        case _ => assert(false, "ID mismatch")
    }
}

func testInterfaceInheritance() {
    user := InheritUser { id: 42, name: "Alice" }
    printEntityIH(user)
}

interface IdentityMGI {
    func touch[T]( _ value: T)
}

struct BoxMGI {}

conform BoxMGI to IdentityMGI {
    public func touch[T]( _ value: T) {}
}

func callTouch[I: IdentityMGI](_ value: &I) {
    value.touch(1 as int32)
}

func testInterfaceMethodGenericInfer() {
    var box = BoxMGI {}
    callTouch(&box)
}

interface IdentifiableStress {
    func identifier() -> usize
}

interface NamedStress {
    func name() -> string
}

interface EntityStress: IdentifiableStress, NamedStress {
    func describe() -> string
}

interface ContainerStress[T] {
    func retrieve() -> T
}

type Str = string
type UserName = string

struct StressUser {
    id: usize
    name: string
}

conform StressUser to IdentifiableStress {
    func identifier() -> usize { self.id }
}

conform StressUser to NamedStress {
    func name() -> string { self.name }
}

conform StressUser to EntityStress {
    func describe() -> string { self.name }
}

conform StressUser to ContainerStress[string] {
    func retrieve() -> string { self.name }
}

conform StressUser to ContainerStress[usize] {
    func retrieve() -> usize { self.id }
}

func printEntityStress(_ value: any EntityStress) {
    str := value.describe()
    assert(str == "Alice", "Describe check")

    id := value.identifier()
    match id {
        case 42 => assert(true, "ID ok")
        case _ => assert(false, "ID mismatch")
    }
}

func printIdentStress(_ value: any IdentifiableStress) {
    id := value.identifier()
    match id {
        case 42 => assert(true, "Identifiable ok")
        case _ => assert(false, "Identifiable fail")
    }
}

func printStringContainerStress(_ value: any ContainerStress[string]) {
    str := value.retrieve()
    assert(str == "Alice", "String container ok")
}

func printIntContainerStress(_ value: any ContainerStress[usize]) {
    id := value.retrieve()
    match id {
        case 42 => assert(true, "Int container ok")
        case _ => assert(false, "Int container fail")
    }
}

func printAliasContainerStress(_ value: any ContainerStress[UserName]) {
    str := value.retrieve()
    assert(str == "Alice", "Inferred alias container lookup ok")
}

func showNameStress[T: NamedStress](_ value: T) {
    str := value.name()
    assert(str == "Alice", "Named constraint ok")
}

func assertStringStress[T](_ value: T) where T == Str {
    assert(value == "ok", "Equality constraint ok")
}

func sameTypeStress[T, U](_ a: T, _ b: U) where T == U {
}

func testInterfaceStress() {
    user := StressUser { id: 42, name: "Alice" }

    printEntityStress(user)

    var e: any EntityStress = user
    printIdentStress(e)

    printStringContainerStress(user)
    printIntContainerStress(user)
    printAliasContainerStress(user)

    showNameStress(user)

    assertStringStress("ok")
    sameTypeStress("a", "b")
    sameTypeStress(1, 2)
}

interface CounterDefault {
    func next( _ seed: int32) -> int32 { seed + 1 }
}

struct TickDefault {}

conform TickDefault to CounterDefault {}

func advanceDefault[T: CounterDefault](_ counter: T, _ seed: int32) -> int32 {
    CounterDefault::next(counter, seed)
}

func testDefaultMethodsGenericBound() {
    tick := TickDefault {}
    n := advanceDefault(tick, 41)
    assert(n == 42, "generic bound default call should return 42")
}

interface GreeterDefault {
    func value() -> int32 { 42 }
}

struct UnitDefault {}

conform UnitDefault to GreeterDefault {}

func testDefaultMethodsUfcs() {
    u := UnitDefault {}
    v := GreeterDefault::value(u)
    assert(v == 42, "default method should return 42")
}

interface HasMagicDefault {
    const MAGIC: int32 = 11
}

interface HasMagicRequired {
    const MAGIC: int32
}

struct MagicBox {}

conform MagicBox to HasMagicDefault {}

conform MagicBox to HasMagicRequired {
    const MAGIC: int32 = 7
}

func acceptMagicDefault[T: HasMagicDefault](_ value: &T) {
    var _ = value
}

func acceptMagicRequired[T: HasMagicRequired](_ value: &T) {
    var _ = value
}

func testAssociatedConstantsInConformance() {
    box := MagicBox {}
    acceptMagicDefault(&box)
    acceptMagicRequired(&box)
}

func main() {
    testInterfaceConstGenerics()
    testDefaultGenericSelfSubstitution()
    testDefaultGenericSelfSubstitutionVirtual()
    testDefaultMethodConcreteAndForwarding()
    testInterfaceGenericImpl()
    testInterfaceInheritance()
    testInterfaceMethodGenericInfer()
    testInterfaceStress()
    testDefaultMethodsGenericBound()
    testDefaultMethodsUfcs()
    testAssociatedConstantsInConformance()

    std::print("PASS: interfaces\n")
}

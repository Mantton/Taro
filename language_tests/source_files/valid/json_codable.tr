import std.encoding.{Codable, Decodable, Decoder, Encodable, Encoder}

struct JsonBox {
    value: int32
}

impl std.encoding.Encodable for JsonBox {
    func encode[E: std.encoding.Encoder](&self, into encoder: &mut E) -> std.result.Result[(), E.Error] {
        let length: usize? = .some(1)
        encoder.beginObject(length)!
        encoder.beginField("value")!
        self.value.encode(into: encoder)!
        return encoder.endObject()
    }
}

impl std.encoding.Decodable for JsonBox {
    func decode[D: std.encoding.Decoder](from decoder: &mut D) -> std.result.Result[Self, D.Error] {
        let _ = decoder.beginObject()!
        var decoded: int32? = .none
        loop {
            match decoder.nextField()! {
                case .none => break
                case .some(name) => {
                    if name == "value" {
                        decoded = .some(std.encoding.decode[int32, D](from: decoder)!)
                    } else {
                        decoder.skipValue()!
                    }
                }
            }
        }
        match decoded {
            case .some(value) => {
                decoder.endObject()!
                return .ok(JsonBox { value })
            }
            case .none => return .err(decoder.missingField("value", "value is required"))
        }
    }
}

func roundTrip[Value: std.encoding.Codable](_ value: &Value) -> Value {
    let encoded = std.json.encode(value).unwrap()
    std.json.decode[Value](encoded).unwrap()
}

func main() {
    let decoded = roundTrip(&JsonBox { value: 42 })
    assert(decoded.value == 42, "Codable should combine both JSON codec directions")
    std.print("ok\n")
}

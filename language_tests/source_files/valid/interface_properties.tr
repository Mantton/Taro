interface NamedProperty { var name: string { get }; }
interface CountedProperty { var count: int32 { get }; }
interface ValuedProperty { var value: int32 { get }; }
interface FirstScopedValue { var scoped: int32 { get }; }
interface SecondScopedValue { var scoped: int32 { get }; }
interface OwnedItemsProperty { var items: std::collections::List[int32] { get }; }
interface DefaultValueProperty { var value: int32 { get { 41 } }; }
struct PropertyUser { name: string }
conform PropertyUser to NamedProperty {}
struct PropertyCounter { count: int32 }
conform PropertyCounter to CountedProperty {}
struct ComputedPropertyValue { storage: int32 }
extend ComputedPropertyValue { var value: int32 { get { self.storage * 2 } }; }
conform ComputedPropertyValue to ValuedProperty {}
struct ScopedPropertyValue { first: int32; second: int32 }
conform ScopedPropertyValue to FirstScopedValue { var scoped: int32 { get { self.first } }; }
conform ScopedPropertyValue to SecondScopedValue { var scoped: int32 { get { self.second } }; }
struct PropertyItemBag { storage: std::collections::List[int32] }
conform PropertyItemBag to OwnedItemsProperty {
    var items: std::collections::List[int32] { get { self.storage.clone() } };
}
struct DefaultPropertyValue {}
conform DefaultPropertyValue to DefaultValueProperty {}
struct ExplicitDefaultPropertyOverride {}
conform ExplicitDefaultPropertyOverride to DefaultValueProperty { var value: int32 { get { 73 } }; }
struct InherentDefaultPropertyOverride {}
extend InherentDefaultPropertyOverride { var value: int32 { get { 89 } }; }
conform InherentDefaultPropertyOverride to DefaultValueProperty {}
struct FieldDefaultPropertyOverride { value: int32 }
conform FieldDefaultPropertyOverride to DefaultValueProperty {}
struct ForwardedFieldValue { value: int32 }
conform ForwardedFieldValue to ValuedProperty { var value: int32 { get { self.value } }; }
struct ExplicitPropertyValue { storage: int32 }
conform ExplicitPropertyValue to ValuedProperty { var value: int32 { get { self.storage + 1 } }; }
func genericName[T: NamedProperty](_ value: &T) -> string { value.name }
func genericCount[T: CountedProperty](_ value: &T) -> int32 { value.count }
func genericItems[T: OwnedItemsProperty](_ value: &T) -> std::collections::List[int32] { value.items }
func genericDefaultValue[T: DefaultValueProperty](_ value: &T) -> int32 { value.value }
func main() {
    var user: PropertyUser = PropertyUser { name: "Taro" }
    assert(genericName(&user) == "Taro", "generic stored-field getter")
    assert(NamedProperty::name(user) == "Taro", "UFCS property getter")
    var erasedUser: any NamedProperty = user
    assert(erasedUser.name == "Taro", "erased stored-field getter")
    var counter: PropertyCounter = PropertyCounter { count: 4 }
    assert(genericCount(&counter) == 4, "generic scalar getter")
    var erasedCounter: any CountedProperty = counter
    assert(erasedCounter.count == 4, "erased scalar getter")
    var computed: ComputedPropertyValue = ComputedPropertyValue { storage: 6 }
    var erasedComputed: any ValuedProperty = computed
    assert(erasedComputed.value == 12, "inherent computed-property witness")
    var explicit: ExplicitPropertyValue = ExplicitPropertyValue { storage: 10 }
    var erasedExplicit: any ValuedProperty = explicit
    assert(erasedExplicit.value == 11, "explicit property witness")
    var forwarded: ForwardedFieldValue = ForwardedFieldValue { value: 17 }
    var erasedForwarded: any ValuedProperty = forwarded
    assert(erasedForwarded.value == 17, "explicit field-forwarding property")
    var scoped: ScopedPropertyValue = ScopedPropertyValue { first: 21, second: 34 }
    assert(FirstScopedValue::scoped(scoped) == 21, "first interface's property")
    assert(SecondScopedValue::scoped(scoped) == 34, "second interface's property")
    var items: std::collections::List[int32] = std::collections::List::new()
    items.append(55)
    var bag: PropertyItemBag = PropertyItemBag { storage: items }
    var first = genericItems(&bag)
    first.append(89)
    second := genericItems(&bag)
    assert(first.len() == 2 && second.len() == 1 && bag.storage.len() == 1, "owned NoCopy results explicitly cloned")
    var defaultValue: DefaultPropertyValue = DefaultPropertyValue {}
    assert(genericDefaultValue(&defaultValue) == 41, "default getter")
    var erasedDefault: any DefaultValueProperty = defaultValue
    assert(erasedDefault.value == 41, "erased default getter")
    var explicitOverride: ExplicitDefaultPropertyOverride = ExplicitDefaultPropertyOverride {}
    assert(genericDefaultValue(&explicitOverride) == 73, "explicit overrides default")
    var inherentOverride: InherentDefaultPropertyOverride = InherentDefaultPropertyOverride {}
    assert(genericDefaultValue(&inherentOverride) == 89, "inherent overrides default")
    var fieldOverride: FieldDefaultPropertyOverride = FieldDefaultPropertyOverride { value: 5 }
    assert(genericDefaultValue(&fieldOverride) == 5, "stored Copy field overrides default")
    std::print("PASS: interface properties\n")
}

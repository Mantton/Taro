struct Point { x: int32; y: int32 }
func classify(_ n: int32) -> int32 {
    match n {
        case pick @ (1 | 3) => pick + 10
        case pick @ 5 | pick @ 7 => pick + 20
        case _ => 0
    }
}
func change(_ point: &Point) -> int32 {
    match point {
        case alias @ Point { x: original, .. } if original > 0 => {
            alias.x += 10
            original + alias.y
        }
        case _ => 0
    }
}
func main() {
    assert(classify(1) == 11 && classify(3) == 13 && classify(5) == 25 && classify(7) == 27 && classify(4) == 0, "precedence")
    var p = Point { x: 2, y: 9 }
    assert(change(&p) == 11 && p.x == 12, "the whole reference and a copied field")
    println("groups")
}

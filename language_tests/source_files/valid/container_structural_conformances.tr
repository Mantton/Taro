import std::collections::{Deque, Dictionary, List, PriorityQueue, Set}

struct Opaque {
    id: int32
}

func makeDefault[T: Default]() -> T {
    T::default()
}

func main() {
    // 1. Critical regression: Opaque? == nil works even though Opaque is NOT PartialEq
    var noneOpaque: Opaque? = nil
    var someOpaque: Opaque? = .some(Opaque { id: 42 })
    assert(noneOpaque == nil)
    assert(nil == noneOpaque)
    assert(!(noneOpaque != nil))
    assert(someOpaque != nil)
    assert(nil != someOpaque)
    assert(!(someOpaque == nil))

    // 2. Optional[T] PartialEq, Hashable, PartialOrd, Ord
    var oNone: int32? = nil
    var o1: int32? = .some(1)
    var o2: int32? = .some(2)
    assert(oNone == .none)
    assert(o1 == .some(1))
    assert(o1 == 1)
    assert(o1 != o2)
    assert(oNone < o1 && o1 < o2)
    assert(oNone.cmp(o1).isLess() && o2.cmp(o1).isGreater())

    var optSet = Set[int32?]::new()
    optSet.insert(nil)
    optSet.insert(1)
    optSet.insert(2)
    optSet.insert(nil)
    assert(optSet.len() == 3)
    assert(oNone in optSet && o1 in optSet && o2 in optSet)

    var optList: [int32?] = [2, nil, 1, nil]
    optList.sort()
    assert(optList[0] == nil && optList[1] == nil && optList[2] == 1 && optList[3] == 2)

    // Optional PartialOrd with NaN
    var oNan: double? = .some(0.0 / 0.0)
    var oFloat: double? = .some(1.0)
    var oFNone: double? = nil
    assert(oFNone < oNan)
    assert(oNan.partialCmp(oFloat).isNone())

    // 3. Result[T, E] PartialEq, Hashable, PartialOrd, Ord
    var rOk1: Result[int32, string] = .ok(1)
    var rOk2: Result[int32, string] = .ok(2)
    var rErrA: Result[int32, string] = .err("a")
    var rErrB: Result[int32, string] = .err("b")
    assert(rOk1 == .ok(1))
    assert(rOk1 != rOk2)
    assert(rOk1 != rErrA)
    assert(rOk1 < rOk2 && rOk2 < rErrA && rErrA < rErrB)
    var resSet = Set[Result[int32, string]]::new()
    resSet.insert(rOk1)
    resSet.insert(rErrA)
    resSet.insert(.ok(1))
    assert(resSet.len() == 2)

    // 4. [T; N] Hashable, PartialOrd, Ord, Default (e.g., 26-letter anagram key!)
    var groups = Dictionary[[int32; 26], List[string]]::new()
    var keyEat: [int32; 26] = makeDefault()
    keyEat[0] = 1
    keyEat[4] = 1
    keyEat[19] = 1
    var keyTea: [int32; 26] = makeDefault()
    keyTea[0] = 1
    keyTea[4] = 1
    keyTea[19] = 1
    var words: [string] = ["eat"]
    groups[keyEat] = words
    assert(keyTea in groups)
    assert(groups[keyTea].len() == 1 && groups[keyTea][0] == "eat")

    // Default on [List[int32]; 3] creates independent lists per slot
    var buckets: [List[int32]; 3] = makeDefault()
    buckets[0].append(7)
    assert(buckets[0].len() == 1 && buckets[1].len() == 0 && buckets[2].len() == 0)

    var a1: [int32; 2] = [1, 2]
    var a2: [int32; 2] = [1, 3]
    var a3: [int32; 2] = [2, 0]
    assert(a1 < a2 && a2 < a3)
    var pq = PriorityQueue[[int32; 2]]::new()
    pq.push(a3)
    pq.push(a1)
    pq.push(a2)
    assert(pq.pop() == .some([1, 2]))
    assert(pq.pop() == .some([1, 3]))
    assert(pq.pop() == .some([2, 0]))
    assert(pq.pop() == nil)

    // 5. List[T] and Deque[T] PartialOrd and Ord
    var rows: [List[int32]] = [[1, 3], [1, 2], [0, 9], [1, 2, 0]]
    rows.sort()
    assert(rows[0] == [0, 9])
    assert(rows[1] == [1, 2])
    assert(rows[2] == [1, 2, 0])
    assert(rows[3] == [1, 3])

    var d1 = Deque[int32]::new()
    d1.pushBack(1)
    d1.pushBack(2)
    var d2 = Deque[int32]::new()
    d2.pushBack(1)
    d2.pushBack(3)
    assert(d1 < d2 && d2 > d1)

    // 6. Set[T] and Dictionary[K, V] PartialEq (including Optional values!)
    var s1 = Set[int32]::new()
    s1.insert(1)
    s1.insert(2)
    var s2 = Set[int32]::new()
    s2.insert(2)
    s2.insert(1)
    assert(s1 == s2)
    s2.insert(3)
    assert(s1 != s2)

    var m1 = Dictionary[string, int32?]::new()
    m1["a"] = .some(1)
    m1["b"] = nil
    var m2 = Dictionary[string, int32?]::new()
    m2["b"] = nil
    m2["a"] = .some(1)
    var m3 = Dictionary[string, int32?]::new()
    m3["a"] = .some(1)
    assert(m1 == m2)
    assert(m1 != m3)

    print("container structural conformances ok\n")
}

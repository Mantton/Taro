// GC protects partial class/value storage; a panic publishes neither result.
final class Leaf { value: int32 }
extend Leaf { init(_ value: int32) { self.value = value }; }
class Pair { first: Leaf; second: Leaf }
extend Pair {
    init(_ failAt: int32) {
        defer { std::runtime::collect() }
        self.first = Leaf(11)
        std::runtime::collect()
        if failAt == 1 { std::panic::panic("partial class construction") }
        self.second = Leaf(22)
        std::runtime::collect()
        if failAt == 2 { std::panic::panic("completed fields but failed body") }
    }
}
struct Record { first: Leaf; second: Leaf }
extend Record {
    init(_ failAt: int32) {
        defer { std::runtime::collect() }
        self.first = Leaf(11)
        std::runtime::collect()
        if failAt == 1 { std::panic::panic("partial value construction") }
        self.second = Leaf(22)
        std::runtime::collect()
        if failAt == 2 { std::panic::panic("completed fields but failed body") }
    }
}
func main() async {
    record := Record(0)
    pair := Pair(0)
    assert(pair.first.value == 11 && pair.second.value == 22, "partial fields survive collection before publication")
    for stage in 1_i32..3_i32 {
        task := std::task::spawn(() async => { Pair(stage) })
        match await task.result() {
            case .ok(_) => std::panic::panic("failed construction exposed a class value")
            case .err(.panicked(_)) => {}
            case .err(.cancelled) => std::panic::panic("construction was cancelled")
        }
    }
    for stage in 1_i32..3_i32 {
        task := std::task::spawn(() async => { Record(stage) })
        match await task.result() {
            case .ok(_) => std::panic::panic("failed construction exposed a value")
            case .err(.panicked(_)) => {}
            case .err(.cancelled) => std::panic::panic("construction was cancelled")
        }
    }
    std::runtime::collect()
    assert(record.first.value == 11 && record.second.value == 22, "value constructor fields survive GC before successful return")
    assert(pair.first.value == 11 && pair.second.value == 22, "failed construction leaves existing objects valid")
}

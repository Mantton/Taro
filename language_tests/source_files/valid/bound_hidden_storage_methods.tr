struct Counter { private value: int32; private edit: int32; private finish: int32 }
extend Counter {
    static func create() -> Self { Self { value: 1, edit: 2, finish: 3 } }
    func value() -> int32 { self.value }

    func finish() -> int32 { self.finish }
}
func main() {
    var values: [int32] = [1_i32, 2_i32]
    count := values.len
    assert(count() == 2, "private List storage does not hide its shared method")
    values.append(3_i32)
    assert(values.len() == 3, "borrow ends after the bound callback's last use")

    var dictionary: std::collections::Dictionary[int32, int32] = std::collections::Dictionary[int32, int32]::new()
    dictionaryCount := dictionary.len
    assert(dictionaryCount() == 0, "package-owned Dictionary storage does not hide its public method")
    dictionary.insert(key: 1_i32, value: 7_i32)
    assert(dictionary.len() == 1, "dictionary receiver is usable after callback borrow ends")

    var counter: Counter = Counter::create()
    read := counter.value
    assert(read() == 1, "shared method bound through a hidden field name")
    var edit = counter.edit
    edit()
    assert(counter.value() == 2, "mutable bound method updates the actual receiver")
    finish := counter.finish
    assert(finish() == 3, "owned bound method consumes its stored receiver once")
}


extend &Counter {
    func edit() { self.value = self.edit }
}

enum RecursiveMatchValue {
    case leaf(int32)
    case children(List[RecursiveMatchValue])
}
func readLeaf(_ value: &RecursiveMatchValue) -> int32 {
    match *value {
        case .leaf(number) => number
        case .children(_) => -1
    }
}
func readOptionalLeaf(_ value: RecursiveMatchValue?) -> int32 {
    match value {
        case .some(.leaf(number)) => number
        case _ => -1
    }
}
func main() {
    value := RecursiveMatchValue::leaf(42)
    assert(readLeaf(&value) == 42, "explicitly dereference recursive enum storage")
    assert(readOptionalLeaf(.some(.leaf(7))) == 7, "nested value patterns")
}

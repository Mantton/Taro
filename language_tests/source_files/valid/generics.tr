struct MarkerDVP {}

extend MarkerDVP {
    static func wrap[T = int32](_ x: T) -> T { x }
}

func idDVP[T = int32](_ x: T) -> T { x }
func pairFirstDVP[T, U = T](_ x: T, _ y: U) -> U { y }

func testGenericDefaultValuePaths() {
    a := idDVP(true)
    var _a_ok: bool = a

    b := MarkerDVP::wrap(true)
    var _b_ok: bool = b

    c := pairFirstDVP[int32](1, 2)
    var _c_ok: int32 = c
}

enum CustomGEM[T] {
    case empty
    case value(T)
}

func testGenericEnumMatch() {
    a := CustomGEM::value("Hello, World.\n")

    match a {
        case CustomGEM::empty => {
            assert(false, "Should not match empty")
        }
        case CustomGEM::value(_) => {
            assert(true, "Matched value variant")
        }
    }

    var b: CustomGEM[int32] = CustomGEM::empty
    match b {
        case CustomGEM::empty => {
            assert(true, "Generic enum empty variant")
        }
        case CustomGEM::value(_) => {
            assert(false, "Should match empty")
        }
    }
}

func fingerprintGFMD(_ hash: uint64) -> uint8 {
    ((hash >> 57) as uint8) & (0x7f as uint8)
}

func hashKey[Key: Hashable](_ key: &Key) -> uint64 {
    var hasher = DefaultHasher::new()
    key.hash(into: &hasher)
    hasher.finish()
}

struct ProbeMapGFMD[Key: Hashable, Value] {
    capacity: usize
    controls: List[uint8]
    hashes: List[uint64]
    keys: List[Key?]
    values: List[(&Value)?]
}

extend[Key: Hashable, Value] ProbeMapGFMD[Key, Value] {
    static func new() -> Self {
        var controls: List[uint8] = List::new()
        var hashes: List[uint64] = List::new()
        var keys: List[Key?] = List::new()
        var values: List[(&Value)?] = List::new()

        var idx: usize = 0
        while idx < (16 as usize) {
            controls.append(CTRL_EMPTY_G)
            hashes.append(0 as uint64)
            keys.append(.none)
            values.append(.none)
            idx += 1
        }

        ProbeMapGFMD[Key, Value] {
            capacity: 16 as usize,
            controls,
            hashes,
            keys,
            values,
        }
    }

    func get( _ key: Key) -> Optional[&Value] {
        if self.capacity == 0 {
            return .none
        }

        hash := hashKey(&key)
        fp := fingerprintGFMD(hash)
        mask := self.capacity - (1 as usize)
        base := (hash as usize) & mask

        var groupOffset: usize = 0
        while groupOffset < self.capacity {
            groupStart := (base + groupOffset) & mask

            var slotOffset: usize = 0
            while slotOffset < GROUP_WIDTH_G {
                slot := (groupStart + slotOffset) & mask
                ctrl := *self.controls.at(slot)

                if ctrl == CTRL_EMPTY_G {
                    return .none
                }

                if ctrl < CTRL_EMPTY_G && ctrl == fp {
                    slotHash := *self.hashes.at(slot)
                    if slotHash == hash {
                        keySlot := self.keys.at(slot)
                        match *keySlot {
                            case .some(existingKey) => {
                                if key.eq(existingKey) {
                                    var valueSlot: &(&Value)? = self.values.at(slot)
                                    match *valueSlot {
                                        case .some(existingValue) => {
                                            return .some(existingValue)
                                        }
                                        case .none => {
                                            return .none
                                        }
                                    }
                                }
                            }
                            case .none => {}
                        }
                    }
                }

                slotOffset += 1
            }

            groupOffset += GROUP_WIDTH_G
        }

        return .none
    }
}

func testGenericEqFalseMoveDictionaryShapeCheck() {
    var map = ProbeMapGFMD[int32, int32]::new()
    var _ = map.get(10)
}

struct EqReproGEMC[Key: Hashable, Value] {
    keys: List[Key?]
    values: List[(&Value)?]
}

extend[Key: Hashable, Value] EqReproGEMC[Key, Value] {
    static func new(_ key: Key, _ value: Value) -> Self {
        var keys: List[Key?] = List::new()
        var values: List[(&Value)?] = List::new()
        var entry: Key? = .some(key)
        var valueEntry: (&Value)? = .some(&value)
        keys.append(entry)
        values.append(valueEntry)
        EqReproGEMC[Key, Value] { keys, values }
    }

    func get( _ key: Key) -> Optional[&Value] {
        hash := hashKey(&key)
        var idx: usize = 0
        while idx < (1 as usize) {
            var keySlot: &Key? = self.keys.at(idx)
            match *keySlot {
                case .some(existingKey) => {
                    var _ = hash
                    if key.eq(existingKey) {
                        var valueSlot: &(&Value)? = self.values.at(idx)
                        match *valueSlot {
                            case .some(existingValue) => {
                                return .some(existingValue)
                            }
                            case .none => {
                                return .none
                            }
                        }
                    }
                }
                case .none => {}
            }
            idx += 1
        }
        return .none
    }
}

func testGenericEqMutContextNoMoveCheck() {
    var repro = EqReproGEMC[int32, int32]::new(10, 11)
    var hit: &int32 = repro.get(10).unwrap()
    *hit += 1
    var found: &int32 = repro.get(10).unwrap()
    assert(*found == 12, "mutable lookup should return the stored value")
    var missing: Optional[&int32] = repro.get(20)
    assert(missing.isNone(), "mutable lookup should reject a different key")
}

func useGI[V](value: V) -> V { value }
public func exposeGI[T](_ value: T) -> T { value }

func fibonacciGI(_ n: uint32) -> uint32 {
    if n <= 1 {
        return n
    }
    return fibonacciGI(n - 1) + fibonacciGI(n - 2)
}

func testGenericInference() {
    var a: uint32 = 10
    b := useGI(value: a)
    c := exposeGI(b)

    assert(c == 10, "Inference chain 1 failed")

    x := "Hello, World.\n"
    y := useGI(value: x)
    z := exposeGI(y)
    assert(z == "Hello, World.\n", "String inference chain failed")

    a1 := fibonacciGI(4)
    assert(a1 == 3, "Fibonacci call failed")
}

struct KeyGM {
    id: int32
}

func testGenericMangleOptionalCustomRuntime() {
    var xs: List[KeyGM?] = List::new()
    xs.append(.none)
    xs.append(.some(KeyGM { id: 1 }))

    // Explicit shared results permit both lookups to remain live together.
    var first: &KeyGM? = xs.at(0)
    var second: &KeyGM? = xs.at(1)

    std::assert(first.isNone(), "first optional entry should be none")
    std::assert(second.isSome(), "second optional entry should be some")
    match *second {
        case .some(value) => {
            std::assert(value.id == 1, "second optional payload mismatch")
        }
        case .none => {
            std::assert(false, "second optional payload unexpectedly missing")
        }
    }
}

func geqGOB[T: Ord](_ a: T, _ b: T) -> bool {
    a >= b
}

func lessGOB[T: Ord](_ a: T, _ b: T) -> bool {
    a < b
}

func equalsGOB[T: PartialEq](_ a: T, _ b: T) -> bool {
    a == b
}

func testGenericOperatorBoundsBasic() {
    assert(geqGOB(10, 5), "10 >= 5")
    assert(!geqGOB(2, 7), "2 >= 7 should be false")

    assert(lessGOB(1, 4), "1 < 4")
    assert(!lessGOB(9, 3), "9 < 3 should be false")

    assert(equalsGOB(true, true), "true == true")
    assert(!equalsGOB(false, true), "false == true should be false")
}

struct ScoreGOC {
    value: int32
}

conform ScoreGOC to PartialEq {
    func eq( _ other: ScoreGOC) -> bool {
        self.value == other.value
    }
}

conform ScoreGOC to PartialOrd {
    func partialCmp( _ other: ScoreGOC) -> Optional[Ordering] {
        .some(self.cmp(other))
    }
}

conform ScoreGOC to Ord {
    func cmp( _ other: ScoreGOC) -> Ordering {
        if self.value < other.value {
            .less
        } else if self.value == other.value {
            .equal
        } else {
            .greater
        }
    }
}

func testGenericOperatorBoundsCustomCheck() {
    a := ScoreGOC { value: 10 }
    b := ScoreGOC { value: 7 }

    assert(geqGOB(a, b), "custom Ord bound should dispatch comparison")

    a2 := ScoreGOC { value: 10 }
    b2 := ScoreGOC { value: 7 }
    assert(!equalsGOB(a2, b2), "custom PartialEq bound should dispatch equality")
}

func pickGO[V](value: V) -> V { value }
func pickGO(value: uint32) -> uint32 { value }

func testGenericOverload() {
    var a: uint32 = 10
    b := pickGO(value: a)
    assert(b == 10, "Value mismatch")
}

func sameGREO[T: std::ops::PartialEq](_ a: &T, _ b: &T) -> bool {
    *a == *b
}

func testGenericRefEqualityOperator() {
    assert(sameGREO(&1, &1), "generic ref equality")
}

struct PairGSM[T] {
    fst: T
    snd: T
}

extend[T] PairGSM[T] {
    static func new(fst: T, snd: T) -> PairGSM[T] {
        PairGSM { fst, snd }
    }

    func use() -> &T {
        &self.snd
    }
}

struct DictionaryGSM[T, V] {
    key: T
    value: V
}

func testGenericStructsMethods() {
    a := 10
    x := PairGSM[int32]::new(fst: a, snd: a)
    y := PairGSM[int32] { fst: 10, snd: 10 }

    z := *y.use()
    assert(z == 10, "Method call on generic struct failed")
    assert(x.fst == 10, "Field access on generic struct failed")

    res := x.fst + z
    assert(res == 20, "Result calculation failed")

    d := DictionaryGSM { key: 'A', value: 10 }
    assert(d.value == 10, "Dictionary value check")
}

interface ContainerGCC {
    type Item
    func get() -> Self::Item
}

struct BoxUGCC { value: usize }
conform BoxUGCC to ContainerGCC {
    type Item = usize
    func get() -> usize { self.value }
}

struct BoxSGCC { value: string }
conform BoxSGCC to ContainerGCC {
    type Item = string
    func get() -> string { self.value }
}

func takeItemGCC[T: ContainerGCC](_ c: T) -> T::Item {
    var v: T::Item = c.get()
    v
}

func printStringContainerGCC[T](_ c: T) where T: ContainerGCC, T::Item == string {
    var s: string = c.get()
    assert(s == "Hello", "String container value")
}

interface Container2GCC[T] {
    func get() -> T
}

struct BoxU2GCC { value: usize }
conform BoxU2GCC to Container2GCC[usize] {
    func get() -> usize { self.value }
}

func takeU2GCC[T: Container2GCC[usize]](_ c: T) -> usize {
    c.get()
}

interface NamedGCC {
    func name() -> string
}

interface EntityGCC: NamedGCC {
    func id() -> usize
}

struct UserGCC {
    id: usize
    name: string
}

conform UserGCC to NamedGCC {
    func name() -> string { self.name }
}

conform UserGCC to EntityGCC {
    func id() -> usize { self.id }
}

func showEntityGCC(_ value: any EntityGCC) {
    assert(value.name() == "Alice", "Entity name check")
}

func testGenericsConstraintsComplex() {
    user := UserGCC { id: 42, name: "Alice" }
    boxU := BoxUGCC { value: 99 }
    boxS := BoxSGCC { value: "Hello" }

    var _u: usize = takeItemGCC(boxU)
    var _s: string = takeItemGCC(boxS)

    printStringContainerGCC(boxS)

    var _u2: usize = takeU2GCC(BoxU2GCC { value: 123 })

    showEntityGCC(user)
}

interface CarrierPN {
    type Item
}

struct WrapPN[Element] {}

conform[Element] &WrapPN[Element] to CarrierPN {
    type Item = Element
}

func takesCarrierItemPN[C: CarrierPN](_ carrier: C, _ item: C::Item) -> C::Item {
    item
}

func testProjectionNormalizeImplGenericCheck() {
    wrap := WrapPN[int32] {}
    result := takesCarrierItemPN(&wrap, 7 as int32)
    var typed: int32 = result
    var _ = typed
}

func main() {
    testGenericDefaultConstFallback()
    testGenericDefaultFallback()
    testGenericDefaultMethodFallback()
    testGenericDefaultValuePaths()
    testGenericEnumMatch()
    testGenericEqFalseMoveDictionaryShapeCheck()
    testGenericEqMutContextNoMoveCheck()
    testGenericInference()
    testGenericMangleOptionalCustomRuntime()
    testGenericOperatorBoundsBasic()
    testGenericOperatorBoundsCustomCheck()
    testGenericOverload()
    testGenericRefEqualityOperator()
    testGenericStructsMethods()
    testGenericsConstraintsComplex()
    testProjectionNormalizeImplGenericCheck()

    std::print("PASS: generics\n")
}

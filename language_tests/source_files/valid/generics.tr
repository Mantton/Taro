func testGenericDefaultFallback() {
    a := BoxDF { val: true }
    var _a_ok: BoxDF[bool] = a

    var _b: BoxDF[bool] = BoxDF { val: true }

    w := WrapperDF {}
    var _w_ok: WrapperDF[int32] = w

    var _w2: WrapperDF[bool] = WrapperDF {}
}


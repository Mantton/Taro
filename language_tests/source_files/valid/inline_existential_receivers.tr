// Inlining must retain the conversion from an existential container to its data.
interface Counter {
    func value() -> int64
    func increment()
}

struct Count { value: int64 }
conform Count to Counter {
    @inline
    func value() -> int64 { self.value }
    @inline
    func increment() { self.value += 1 }
}

interface Total {
    func total() -> int64
}
struct WideTotal {
    a: int64
    b: int64
    c: int64
    d: int64
    e: int64
}
conform WideTotal to Total {
    @inline
    func total() -> int64 { self.a + self.b + self.c + self.d + self.e }
}

interface BorrowValue {
    func valueRef() -> &int64
}
conform Count to BorrowValue {
    @inline
    func valueRef() -> &int64 { &self.value }
}

@noinline
func borrowBox(_ boxed: &any BorrowValue) -> &int64 {
    return boxed.valueRef()
}

func main() {
    var counter: any Counter = Count { value: 41 }
    assert(counter.value() == 41, "shared receiver must address concrete data")
    counter.increment()
    assert(counter.value() == 41, "value receiver edits its copy")
    counter.asRef[Count]().unwrap().value += 1
    assert(counter.value() == 42, "explicit payload view updates concrete storage")
    var total: any Total = WideTotal { a: 1, b: 2, c: 3, d: 4, e: 5 }
    assert(total.total() == 15, "owned wide receiver must load concrete data")
    var boxed: any BorrowValue = Count { value: 73 }
    var borrowed: &int64 = borrowBox(&boxed)
    assert(*borrowed == 73, "borrowed result must protect caller-owned boxed data")
    print("PASS: inline existential receivers\n")
}

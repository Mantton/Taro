func callReusable[F: AsyncFn() -> int32](_ f: F) async -> int32 {
    first := await f()
    second := await f()
    return first + second
}

func callMutable[F: AsyncFn() -> int32](_ f: F) async -> int32 {
    var f = f
    first := await f()
    second := await f()
    return first + second
}

struct CopyProbe {
    value: int32
}

extend CopyProbe {
    func read() async -> int32 {
        await std::testing::yieldNow()
        self.value
    }
}

func main() async {
    var values: std::collections::List[int32] = std::collections::List::new()
    values.append(9)
    borrowed := () async => {
        await std::testing::yieldNow()
        return values.len() as int32
    }
    borrowedResult := await callReusable(borrowed)
    assert(borrowedResult == 2, "borrowed AsyncFn should be reusable")

    var count = 0 as int32
    mutable := () async => {
        count += 1
        await std::testing::yieldNow()
        return count
    }
    mutableResult := await callMutable(mutable)
    assert(mutableResult == 3, "borrowed AsyncFnMut should be sequentially reusable")

    var directCount = 0 as int32
    var direct = () async => {
        directCount += 1
        return directCount
    }
    directFirst := await direct()
    directSecond := await direct()
    assert(directFirst == 1, "first direct AsyncFnMut call")
    assert(directSecond == 2, "second direct AsyncFnMut call")
    assert(directCount == 2, "direct AsyncFnMut should update its capture")

    probe := CopyProbe { value: 17 }
    spawned := std::task::spawn(() async => {
        await std::testing::yieldNow()
        return await probe.read()
    })
    spawnedValue := (await spawned.result()).unwrap()
    assert(spawnedValue == 17, "spawned async closure should own implicit Copy borrow")

    std::print("PASS: borrowed async closure reuse\n")
}

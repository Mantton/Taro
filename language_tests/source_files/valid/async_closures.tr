// CHECK_ONLY

func applyAsync[F: AsyncFn(int32) -> int32](_ f: F, _ x: int32) async -> int32 {
    return await f(x)
}

func applyZeroAsync[F: AsyncFn() -> int32](_ f: F) async -> int32 {
    return await f()
}

func applyReusableAsync[F: AsyncFn(int32) -> int32](_ f: F, _ x: int32) async -> int32 {
    return await f(x)
}

func reuseGenericCopy[T](_ value: T) async -> T {
    closure := () async => {
        await std::testing::yieldNow()
        return value
    }
    var _ = await closure()
    return await closure()
}

func main() async {
    captured := 7 as int32

    zero := () async => {
        await std::testing::yieldNow()
        return captured * 2
    }

    unary := (x: int32) async => {
        await std::testing::yieldNow()
        return x + captured
    }

    sync := () => {
        return captured - 1
    }

    reusable := (x: int32) async => {
        await std::testing::yieldNow()
        return x + 1
    }

    reusableCaptured := (x: int32) async => {
        await std::testing::yieldNow()
        return x + captured
    }

    movedCopy := () async => {
        await std::testing::yieldNow()
        return captured
    }

    var _ = await applyZeroAsync(zero)
    var _ = await applyAsync(unary, 5)
    var _ = await applyReusableAsync(reusable, 5)
    var _ = await reusableCaptured(1)
    var _ = await reusableCaptured(2)
    var _ = await applyReusableAsync(reusableCaptured, 3)
    var _ = await movedCopy()
    var _ = await movedCopy()
    var _ = await reuseGenericCopy(11 as int32)
    var _ = sync()

    spawned := std::task::spawn(() async => {
        await std::testing::yieldNow()
        return captured + 1
    })
    var _ = (await spawned.result()).unwrap()

    inferredSpawnAwait := std::task::spawn(() => {
        await std::testing::yieldNow()
        return captured + 2
    })
    var _ = (await inferredSpawnAwait.result()).unwrap()

    inferredSpawnSyncBody := std::task::spawn(() => {
        return captured + 3
    })
    var _ = (await inferredSpawnSyncBody.result()).unwrap()

    var _ = await applyZeroAsync(() => {
        return captured + 4
    })

    for i in 0..=2 {
        task := std::task::spawn(() async => { return i })
        var _ = (await task.result()).unwrap()
    }
}

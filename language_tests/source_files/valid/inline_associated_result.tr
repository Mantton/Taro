type Number = isize

interface Provider {
    type Value
    func value() -> Self::Value
}

struct IntProvider { number: Number }
conform IntProvider to Provider {
    type Value = Number
    func value() -> Number { self.number }
}

@inline
func read[P: Provider](_ provider: P) -> P::Value {
    var result: P::Value = provider.value()
    result
}

@inline
func readPair[P: Provider](_ provider: P) -> (P::Value, P::Value) {
    var result: (P::Value, P::Value) = (provider.value(), provider.value())
    result
}

func main() {
    provider := IntProvider { number: 42 }
    assert(read(provider) == 42, "inlined associated result")
    pair := readPair(IntProvider { number: 42 })
    assert(pair.0 + pair.1 == 84, "nested associated result")
    print("PASS: inline associated result\n")
}

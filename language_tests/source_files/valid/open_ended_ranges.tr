func nextCall(_ count: &int32) -> int32 {
    *count += 1
    99
}

func checkList(_ actual: [int32], _ expected: [int32]) {
    assert(actual == expected)
}

func main() {
    // Slicing List with all 6 range forms (including open integer literals)
    var list: [int32] = [10, 20, 30, 40, 50]
    checkList(list[1..4], [20, 30, 40])
    checkList(list[1..=3], [20, 30, 40])
    checkList(list[2..], [30, 40, 50])
    checkList(list[..3], [10, 20, 30])
    checkList(list[..=2], [10, 20, 30])
    checkList(list[..], [10, 20, 30, 40, 50])
    assert(list[5..].isEmpty())
    assert(list[..0].isEmpty())

    // Slicing Span with all 6 range forms (shared view)
    var backing: [int32; 5] = [1, 2, 3, 4, 5]
    span := backing.asSpan()
    sFrom := span[2..]
    assert(sFrom.len() == 3 && sFrom[0] == 3 && sFrom[2] == 5)
    sTo := span[..2]
    assert(sTo.len() == 2 && sTo[0] == 1 && sTo[1] == 2)
    sToInc := span[..=2]
    assert(sToInc.len() == 3 && sToInc[2] == 3)
    sFull := span[..]
    assert(sFull.len() == 5 && sFull[4] == 5)
    assert(span[5..].len() == 0)
    assert(span[..0].len() == 0)

    // Slicing fixed-size Array with open-ended ranges
    checkList(backing[3..], [4, 5])
    checkList(backing[..2], [1, 2])
    checkList(backing[..=1], [1, 2])
    checkList(backing[..], [1, 2, 3, 4, 5])

    // Slicing string with all 6 range forms (byte-indexed)
    word := "abcdef"
    assert(word[1..4] == "bcd")
    assert(word[1..=4] == "bcde")
    assert(word[2..] == "cdef")
    assert(word[..3] == "abc")
    assert(word[..=2] == "abc")
    assert(word[..] == "abcdef")
    assert(word[6..] == "")
    assert(word[..0] == "")

    // Iteration over RangeFrom including uint8::MAX and int8::MAX without premature overflow
    var acc: int32 = 0
    for i in 5.. {
        acc += i
        if i == 8 { break }
    }
    assert(acc == 26)

    var edgeU8 = List[uint8]::new()
    for b in (254_u8..).iter().take(2) {
        edgeU8.append(b)
    }
    assert(edgeU8.len() == 2 && edgeU8[0] == 254_u8 && edgeU8[1] == 255_u8)

    var edgeI8 = List[int8]::new()
    for b in (126_i8..).iter().take(2) {
        edgeI8.append(b)
    }
    assert(edgeI8.len() == 2 && edgeI8[0] == 126_i8 && edgeI8[1] == 127_i8)

    // Membership tests with `in` and `!in`
    var big: int64 = 5000000000
    assert(big in 10..)
    assert(10 in 10..)
    assert(9 !in 10..)
    assert(5 in ..10)
    assert(10 !in ..10)
    assert(10 in ..=10)
    assert(11 !in ..=10)
    assert("anything" in ..)
    assert(42 in 10.. && 3 in ..10)

    // Equality and Debug on range values
    assert((2..) == (2..))
    assert((..5) == (..5))
    assert((..=5) == (..=5))
    assert((..) == (..))
    assert(std::fmt::debugString(2..) == "2..")
    assert(std::fmt::debugString(..5) == "..5")
    assert(std::fmt::debugString(..=5) == "..=5")
    assert(std::fmt::debugString(..) == "..")

    // ASI: postfix `start..` ends statement at newline and does not swallow next line
    var calls: int32 = 0
    r := 3..
    nextCall(&calls)
    assert(calls == 1)
    assert(3 in r && 2 !in r)

    // ASI: prefix `..end` on next line does not fuse onto preceding statement
    x := 7
    ..10
    assert(x == 7)

    // Negative upper bound on same line
    neg := -5..-1
    assert(-5 in neg && -2 in neg && -1 !in neg)

    print("open ended ranges ok\n")
}

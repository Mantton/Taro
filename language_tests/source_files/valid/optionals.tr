// Test: Optional syntax, coercions, matching, chaining, and defaults.

import std::prelude::Optional

struct Address {
    city: string
}

extend Address {
    func cityLen() -> int32 {
        5
    }
}

struct Profile {
    address: Address?
}

struct User {
    profile: Profile?
}

func testOptionalChaining() {
    addr := Address { city: "Paris" }
    profile := Profile { address: Optional::some(addr) }
    user := User { profile: Optional::some(profile) }
    var opt_user: User? = Optional::some(user)

    city := opt_user?.profile?.address?.city ?? "none"
    assert(city == "Paris", "Deep chain value failed")

    var none_user: User? = Optional::none
    city2 := none_user?.profile?.address?.city ?? "none"
    assert(city2 == "none", "Deep chain none failed")

    length := opt_user?.profile?.address?.cityLen() ?? 0
    assert(length == 5, "Optional call failed")

    var missing_profile: User? = Optional::some(User { profile: Optional::none })
    city3 := missing_profile?.profile?.address?.city ?? "none"
    assert(city3 == "none", "Missing profile failed")

    city_opt := opt_user?.profile?.address?.city
    match city_opt {
        case Optional::some(value) => {
            assert(value == "Paris", "Optional chain result failed")
        }
        case Optional::none => {
            assert(false, "Optional chain result missing")
        }
    }

    city_none := none_user?.profile?.address?.city
    match city_none {
        case Optional::none => {
            assert(true, "Optional chain none mismatch")
        }
        case Optional::some(_) => {
            assert(false, "Optional chain should be none")
        }
    }

    length_opt := opt_user?.profile?.address?.cityLen()
    match length_opt {
        case Optional::some(value) => {
            assert(value == 5, "Optional chain call result failed")
        }
        case Optional::none => {
            assert(false, "Optional chain call missing")
        }
    }

    length_none := none_user?.profile?.address?.cityLen()
    match length_none {
        case Optional::none => {
            assert(true, "Optional chain call none mismatch")
        }
        case Optional::some(_) => {
            assert(false, "Optional chain call should be none")
        }
    }
}

struct BoxValue { val: int32 }

func takesOpt(_ o: int32?) {}
func takesOptBox(_ o: BoxValue?) {}

func testOptionalCoercion() {
    var x: int32 = 42
    takesOpt(x)

    b := BoxValue { val: 42 }
    takesOptBox(b)
}

func testOptionalDefaults() {
    var a: int32? = Optional::some(10)
    result1 := a ?? 0
    assert(result1 == 10, "Basic ?? on .some failed")

    var b: int32? = Optional::none
    result2 := b ?? 42
    assert(result2 == 42, "Basic ?? on .none failed")

    var c: int32? = Optional::some(5)
    result3 := c ?? 999
    assert(result3 == 5, "Short circuit failed")

    var d: int32? = Optional::none
    var e: int32? = Optional::none
    result4 := d ?? e ?? 77
    assert(result4 == 77, "Chained ?? all none failed")

    var f: int32? = Optional::none
    var g: int32? = Optional::some(100)
    result5 := f ?? g ?? 999
    assert(result5 == 100, "Chained ?? with middle some failed")

    var h: int32? = Optional::some(1)
    var i: int32? = Optional::some(2)
    result6 := h ?? i ?? 3
    assert(result6 == 1, "Chained ?? first some failed")

    var j: int32? = Optional::none
    var k: int32? = Optional::none
    var l: int32? = Optional::none
    result7 := j ?? k ?? l ?? 42
    assert(result7 == 42, "Three-level chain all none failed")

    var n1: int32? = Optional::none
    var n2: int32? = Optional::none
    var n3: int32? = Optional::none
    var n4: int32? = Optional::none
    var n5: int32? = Optional::none
    var n6: int32? = Optional::none
    result8 := n1 ?? n2 ?? n3 ?? n4 ?? n5 ?? n6 ?? 123
    assert(result8 == 123, "Deep chaining (6 levels) all none failed")

    var v6: int32? = Optional::some(88)
    result9 := n1 ?? n2 ?? n3 ?? n4 ?? n5 ?? v6 ?? 999
    assert(result9 == 88, "Deep chaining (6 levels) with value at end failed")

    var s: string? = Optional::none
    result10 := s ?? "default"
    assert(result10 == "default", "String ?? failed")

    var t: string? = Optional::some("hello")
    result11 := t ?? "default"
    assert(result11 == "hello", "String ?? with value failed")
}

func testOptionalMatchInferred() {
    var a: Optional[string] = Optional::some("Hello, World")

    match a {
        case .none => {
            assert(false, "Should be some")
        }
        case .some(_) => {
            assert(true, "Matched inferred .some")
        }
    }
}

struct MyData {
    id: usize
    name: string
    isRegistered: bool
    flag: rune
}

func testOptionalMatchVerbose() {
    a := Optional::some("Hello, World.\n")

    match a {
        case Optional::none => {
            assert(false, "Should not be none")
        }
        case Optional::some(_) => {
            assert(true, "Matched some")
        }
    }

    data := MyData {
        id: 10,
        name: "Jackson",
        isRegistered: true,
        flag: 'A',
    }

    optional_data := Optional::some(data)

    match optional_data {
        case Optional::some(x) => {
            assert(x.name == "Jackson", "Struct field access in match")
            assert(x.isRegistered, "Boolean field check")
        }
        case Optional::none => {
            assert(false, "Should have data")
        }
    }
}

func testOptionalTypeAnnotation() {
    var a: Optional[bool] = Optional::none
    match a {
        case .none => assert(true, "a is none")
        case .some(_) => assert(false, "a should be none")
    }

    b := Optional[bool]::none
    match b {
        case .none => assert(true, "b is none")
        case .some(_) => assert(false, "b should be none")
    }
}

struct Container {
    value: int32?
}

func acceptOptional(_ x: int32?) {
}

interface Printable {
    func print()
}

struct MyValue {
    value: int32
}

conform MyValue to Printable {
    func print() {}
}

func acceptOptionalPrintable(_ x: (any Printable)?) {}

func testCoercionsOptional() {
    var a: bool? = true
    match a {
        case .some(v) => { assert(v, "Bool coercion true") }
        case .none => { assert(false, "Bool coercion failed") }
    }

    var b: bool? = nil
    match b {
        case .none => assert(true, "Nil coercion ok")
        case .some(_) => assert(false, "Nil coercion fail")
    }

    var c: bool? = Optional::none
    var d: bool? = Optional::some(false)
    var _ = c
    var _ = d

    var e: int32? = 42
    var f: int32? = nil
    var _ = e
    var _ = f

    acceptOptional(100)
    acceptOptional(nil)
    acceptOptional(Optional::some(200))

    var container1 = Container { value: 42 }
    var container2 = Container { value: nil }
    var container3 = Container { value: Optional::some(99) }
    var _ = container1
    var _ = container2
    var _ = container3

    var myVal = MyValue { value: 10 }
    acceptOptionalPrintable(myVal)
    acceptOptionalPrintable(nil)

    var optPrint: (any Printable)? = myVal
    var optPrint2: (any Printable)? = nil
    var _ = optPrint
    var _ = optPrint2
}

enum Token {
    case eof, linebreak, comma
}

func tokenEof() -> Token? {
    return .eof
}

func tokenSome() -> Token? {
    return .linebreak
}

func tokenNone() -> Token? {
    return .none
}

enum Result[T] {
    case ready, pending
}

func readyInferred() -> Result[int32]? {
    return .ready
}

func testOptionalInferredMemberWrap() {
    match tokenEof() {
        case .some(t) => {
            match t {
                case .eof => assert(true, "return .eof wrapped into some(.eof)")
                case _ => assert(false, "unexpected variant from return .eof")
            }
        }
        case .none => assert(false, "return .eof should not produce .none")
    }

    match tokenSome() {
        case .some(t) => {
            match t {
                case .linebreak => assert(true, "return .linebreak wrapped into some")
                case _ => assert(false, "unexpected variant from return .linebreak")
            }
        }
        case .none => assert(false, "return .linebreak should not produce .none")
    }

    match tokenNone() {
        case .none => assert(true, "return .none stays .none")
        case .some(_) => assert(false, "return .none should not wrap")
    }

    match readyInferred() {
        case .some(r) => {
            match r {
                case .ready => assert(true, "generic enum unit variant wraps via fallback")
                case .pending => assert(false, "unexpected variant")
            }
        }
        case .none => assert(false, "expected some(.ready)")
    }

    var direct: Token? = .comma
    match direct {
        case .some(t) => {
            match t {
                case .comma => assert(true, "let binding coerces .comma into some")
                case _ => assert(false, "unexpected variant in let-binding")
            }
        }
        case .none => assert(false, "let binding should be some")
    }
}

func main() {
    testOptionalChaining()
    testOptionalCoercion()
    testOptionalDefaults()
    testOptionalMatchInferred()
    testOptionalMatchVerbose()
    testOptionalTypeAnnotation()
    testCoercionsOptional()
    testOptionalInferredMemberWrap()

    std::print("PASS: optionals\n")
}

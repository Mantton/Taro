func use() -> int32 { 1 }
func use() async -> int32 { 2 }

struct Counter {
    value: int32
}

extend Counter {
    func use() -> int32 {
        self.value
    }

    func use() async -> int32 {
        self.value + 1
    }
}

func main() async {
    sync_free := use()
    async_free := await use()
    assert(sync_free == 1, "sync free overload")
    assert(async_free == 2, "async free overload")

    counter := Counter { value: 10 }
    sync_method := counter.use()
    async_method := await counter.use()
    assert(sync_method == 10, "sync method overload")
    assert(async_method == 11, "async method overload")

    std::print("PASS: async overloading\n")
}

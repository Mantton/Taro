// TAG: gc
// ENV: TARO_WORKERS=4
// Element operations and overlapping shifts must preserve whole pointer words.
final class CollectionNode { value: int32 }
extend CollectionNode {
    init(_ value: int32) { self.value = value }
}
final class Collections {
    list: List[CollectionNode]
    dictionary: std::collections::Dictionary[int32, CollectionNode]
}
extend Collections {
    init(_ first: CollectionNode) {
        self.list = List[CollectionNode]::new()
        self.list.reserve(8)
        self.list.append(first)
        self.list.append(first)
        self.list.append(first)
        self.dictionary = std::collections::Dictionary[int32, CollectionNode]::new()
        self.dictionary.set(key: 0, value: first)
    }
}
func collectionNodeValid(_ node: CollectionNode) -> bool { node.value == 13 || node.value == 29 }
func main() async {
    left := CollectionNode(13)
    right := CollectionNode(29)
    shared := Collections(left)
    writer := std::task::spawn(() async => {
        var i = 0
        while i < 128 {
            node := if i % 2 == 0 { left } else { right }
            shared.list.set(0, node)
            var _ = shared.list.insert(at: 1, node)
            var _ = shared.list.removeAt(1)
            shared.dictionary.set(key: 0, value: node)
            await std::testing::yieldNow()
            i += 1
        }
        return 0_i32
    })
    reader := std::task::spawn(() async => {
        var bad = 0_i32
        var i = 0
        while i < 128 {
            if !collectionNodeValid(shared.list[0]) { bad += 1 }
            key := 0_i32
            if !collectionNodeValid(shared.dictionary.get(&key).unwrap()) { bad += 1 }
            await std::testing::yieldNow()
            i += 1
        }
        return bad
    })
    var _ = (await writer.result()).unwrap()
    std::printf("torn collection reads: %d\n", (await reader.result()).unwrap())
}

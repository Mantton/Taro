// `literal_receiver_interface_call` with the conformances declared in the
// other order: the literal still defaults to int32, and the result does not
// depend on which record was declared first.
struct Boxed[T] {
    value: T
}

interface Size {
    func size() -> usize
}

conform Boxed[int64] to Size {
    func size() -> usize {
        8
    }
}

conform Boxed[int32] to Size {
    func size() -> usize {
        4
    }
}

func main() {
    n := Boxed { value: 0 }.size() + 1
    same := Boxed { value: 0 }.size() == 4
    wide := if true {
        var boxed = Boxed { value: 0 }
        total := boxed.size() + 1
        var _: Boxed[int64] = boxed
        total
    } else {
        0
    }
    printf("%d %v %d\n", n, same, wide)
}

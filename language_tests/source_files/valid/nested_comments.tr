/* Outer comment
   /* Nested comment */
   func invalid( { this is still a comment
   /* Another /* deeper */ comment */
*/
func main() {
    let value = 40 /* outer /* inner */ tail */ + 2
    /* " /* Delimiters count even inside apparent quotes. */ " */
    assert(value == 42, "nested comments between tokens")
    let formatted = f"{value /* outer /* inner */ tail */}"
    assert(formatted == "42", "nested comments inside interpolation")
    print("PASS: nested comments\n")
}

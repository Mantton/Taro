// G25 litmus: racing tasks overwrite a class field and a large pointer array
// while others read them without synchronization. A racy read may observe
// either written node but always a whole pointer: codegen accesses shared
// pointer words with one unordered atomic access and copies large
// pointer-bearing values word by word, so readers never follow a torn pointer.
// ENV: TARO_WORKERS=4
final class Node {
    label: string
}
extend Node {
    init(_ label: string) { self.label = label }
}

final class Shared {
    current: Node
    many: [Node; 160]
}
extend Shared {
    init(_ node: Node) {
        self.current = node
        self.many = [node; 160]
    }
}

func valid(_ node: Node) -> bool {
    return node.label == "left" || node.label == "right"
}

func main() async {
    left := Node("left")
    right := Node("right")
    shared := Shared(left)
    var tasks = std::collections::List[std::task::Task[int32]]::new()
    var w = 0
    while w < 2 {
        mine := if w == 0 { left } else { right }
        tasks.append(std::task::spawn(() async => {
            var i = 0
            while i < 3000 {
                shared.current = mine
                shared.many = [mine; 160]
                if i % 64 == 0 { await std::testing::yieldNow() }
                i += 1
            }
            return 0_i32
        }))
        w += 1
    }
    var r = 0
    while r < 2 {
        tasks.append(std::task::spawn(() async => {
            var bad: int32 = 0
            var i = 0
            while i < 3000 {
                if !valid(shared.current) { bad += 1 }
                snapshot := shared.many
                if !valid(snapshot[0]) || !valid(snapshot[159]) { bad += 1 }
                if i % 64 == 0 { await std::testing::yieldNow() }
                i += 1
            }
            return bad
        }))
        r += 1
    }
    var bad: int32 = 0
    for task in tasks { bad += (await task.result()).unwrap() }
    std::printf("torn reads: %d\n", bad)
}

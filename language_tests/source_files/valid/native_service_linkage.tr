// TEST
// Native service symbols link across application and standard-library modules.

struct LinkProbe {
    name: string
}

@test
func testNativeServiceLinkageAcrossModules() {
    root := "taro_native_service_linkage_root"
    file := "taro_native_service_linkage_root/a.txt"

    var _ = std::fs::removeFile(file)
    var _ = std::fs::removeDir(root)

    std::assert(std::fs::createDir(root).isOk(), "failed to create linkage root")
    std::assert(std::fs::writeString(file, "payload").isOk(), "failed to create linkage file")

    // Exercise std-side descriptors through file-backed byte allocation.
    bytesRes := std::fs::read(file)
    bytes := match bytesRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("read failed for linkage test")
    }
    std::assert(bytes.len() == 7, "read should return the seeded file contents")

    // Exercise script-side descriptors using a pointer-bearing struct.
    var probes = std::collections::List[LinkProbe]::new()
    probes.append(LinkProbe { name: "x" })
    std::assert(probes.len() == 1, "script-side list append failed")

    std::assert(std::fs::removeFile(file).isOk(), "failed to cleanup linkage file")
    std::assert(std::fs::removeDir(root).isOk(), "failed to cleanup linkage root")
}

func main() {}

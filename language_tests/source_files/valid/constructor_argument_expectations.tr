// Explicit factory calls supply contextual argument types.
// Overloaded factories still select candidates through ordinary overload resolution.

enum Left {
    case value(int32)
    case none
}

enum Right {
    case text(string)
    case none
}

struct Single {
    kind: Left;
}

extend Single {
    static func new(kind: Left) -> Self {
        return Single { kind }
    }
}

struct Multi {
    tag: int32;
}

extend Multi {
    static func new(left: Left) -> Self {
        return Multi { tag: 1 }
    }

    static func new(right: Right) -> Self {
        return Multi { tag: 2 }
    }
}

struct Boxed[T] {
    value: T;
}

extend[T] Boxed[T] {
    static func new(value: T) -> Self {
        return Boxed[T] { value }
    }
}

func leftName(_ left: &Left) -> string {
    match *left {
        case .value(_) => "value"
        case .none => "none"
    }
}

func main() {
    // Single candidate: inferred members resolve through the factory.
    unit := Single::new(kind: .none)
    assert(leftName(&unit.kind) == "none", "single candidate, unit variant")

    payload := Single::new(kind: .value(7))
    assert(leftName(&payload.kind) == "value", "single candidate, payload variant")

    // Repeated explicit calls retain the same contextual argument behavior.
    explicit := Single::new(kind: .value(7))
    assert(leftName(&explicit.kind) == "value", "explicit factory resolves")

    // Overloaded factories resolve from
    // fully qualified arguments.
    viaLeft := Multi::new(left: Left::value(1))
    assert(viaLeft.tag == 1, "overload picks the Left constructor")

    viaRight := Multi::new(right: Right::text("x"))
    assert(viaRight.tag == 2, "overload picks the Right constructor")

    // Generic factories infer their type arguments from arguments and context.
    boxed := Boxed[int32]::new(value: 5)
    assert(boxed.value == 5, "explicit generic constructor")

    inferred := Boxed::new(value: 9)
    assert(inferred.value == 9, "inferred generic constructor")

    std::print("PASS: constructor argument expectations\n")
}

// A default method body is not the target when runtime dispatch finds an override.
interface Value {
    @inline
    func value() -> int32 { 1 }
}
struct DefaultValue {}
conform DefaultValue to Value {}
struct OverrideValue {}
conform OverrideValue to Value {
    func value() -> int32 { 42 }
}

@noinline
func dynamicValue(_ value: any Value) -> int32 { value.value() }

func staticValue[T: Value](_ value: T) -> int32 { value.value() }

class InlineBase {}
extend InlineBase {
    init() {}
    @inline
    func value() -> int32 { 1 }
}
class InlineChild: InlineBase {}
extend InlineChild {
    override func value() -> int32 { 42 }
}

@noinline
func classValue(_ value: InlineBase) -> int32 { value.value() }

func main() {
    assert(dynamicValue(DefaultValue {}) == 1, "default dispatch")
    assert(dynamicValue(OverrideValue {}) == 42, "dynamic override dispatch")
    assert(staticValue(OverrideValue {}) == 42, "generic override dispatch")
    var base: InlineBase = InlineChild()
    assert(classValue(base) == 42, "inline base body must preserve virtual override dispatch")
    print("PASS: inline interface default override\n")
}

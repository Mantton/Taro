struct Counter { value: int32 }
struct OwnedValue { value: int32 }

struct CopyValue { value: int32 }
extend CopyValue {
    var snapshot: int32 { get { self.value } };
}
struct ItemBag { values: std::collections::List[int32] }
extend ItemBag {
    var snapshot: std::collections::List[int32] { get { self.values.clone() } };
}
func main() {
    var counter: Counter = Counter { value: 10 }
    var before: int32 = counter.doubled
    assert(before == 20, "shared getter")
    counter.setDoubled(50)
    assert(counter.doubled == 50, "explicit mutation method")
    var first: OwnedValue = counter.owned
    var second: OwnedValue = counter.owned
    assert(first.value + second.value == 50, "getter constructs owned noncopyable results")
    read := () => counter.owned
    var third: OwnedValue = read()
    var fourth: OwnedValue = read()
    assert(third.value + fourth.value == 50, "getter invocation borrows captured receiver")
    var value: CopyValue = CopyValue { value: 7 }
    assert(value.snapshot == 7, "shared getter on Copy receiver")
    var items: std::collections::List[int32] = std::collections::List::new()
    items.append(10)
    items.append(20)
    var bag: ItemBag = ItemBag { values: items }
    var copied: std::collections::List[int32] = bag.snapshot
    copied.append(30)
    assert(copied.len() == 3 && bag.values.len() == 2, "explicitly cloned owned property result")
    std::print("PASS: computed properties\n")
}


extend &Counter {
    func setDoubled( _ value: int32) { self.value = value / 2 }
}


extend Counter {
    var doubled: int32 { get { self.value * 2 } };
    var owned: OwnedValue { get { OwnedValue { value: self.value } } };
}

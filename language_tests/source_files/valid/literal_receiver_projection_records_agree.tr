// Two specialised records both say `Size = usize`, so `Self::Size` is
// `usize` for `Boxed { value: 0 }` whichever record applies once the literal
// has a type, and the `1` beside the call is a `usize` too.
struct Boxed[T] {
    value: T
}

interface Measured {
    type Size
    func size() -> Self::Size
}

conform Boxed[int32] to Measured {
    type Size = usize

    func size() -> usize {
        4
    }
}

conform Boxed[int64] to Measured {
    type Size = usize

    func size() -> usize {
        8
    }
}

func main() {
    size := Boxed { value: 0 }.size() + 1
    typedSize := Boxed[int32] { value: 0 }.size() + 1
    wideSize := Boxed[int64] { value: 0 }.size() + 1
    println("${size} ${typedSize} ${wideSize}")
}

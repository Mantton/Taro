interface SameValue[Other = Self] {
    func sameValue( _ other: &Other) -> bool
}

struct NumberBox {
    value: int32
}

conform NumberBox to SameValue {
    func sameValue( _ other: &NumberBox) -> bool {
        self.value == other.value
    }
}

func main() {
    first := NumberBox { value: 7 }
    second := NumberBox { value: 7 }
    var erased: any SameValue[NumberBox] = first
    assert(erased.sameValue(&second), "an explicit argument type remains known after existential boxing")
    std::print("ok\n")
}

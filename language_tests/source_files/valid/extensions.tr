// Test: Partial extensions on generic types.

struct Foo[T, V] {
    a: T
    b: V
}

extend[T] Foo[T, string] {
    func getB() -> string {
        self.b
    }
}

func main() {
    a := Foo { a: 'A', b: "B" }
    b := a.getB()
    assert(b == "B", "partial extension method call")
    std::print("PASS: Partial extension working\n")
}

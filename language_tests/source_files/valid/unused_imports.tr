import std::math::{E, PI}
import std::math::sqrt as root
import std::math::{max, min}
import std::time
import std::fs
import std::time::{Duration, Instant}
import std::hash::{Hashable, Hasher, SipHasher13}
import std::default::Default
import std::cmp::Ord
import std::encoding::*

struct Origin {
    x: int32
}

conform Origin to Default {
    static func default() -> Self { Origin { x: 0 } }
}

func largest[T: Ord](_ a: T, _ b: T) -> T {
    max(a, b)
}

@cfg(os("plan9"))
func elsewhere() -> int32 {
    min(1, 2)
}

func wait() -> Duration {
    time::Duration::fromMillis(1500)
}

func main() {
    import std::math::abs
    import std::math::TAU
    var hasher = SipHasher13::new(1, 2)
    var value: int32 = 7
    value.hash(into: &hasher)
    println("${hasher.finish() != 0} ${E > 2.0} ${abs(E) > 1.0}")
    println("${largest(3, 4)} ${Origin::default().x} ${wait().seconds()}")
}

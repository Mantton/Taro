// `x = f(x)` keeps the argument live until the call writes its destination.

struct SmallPair: Copy {
    a: int64
    b: int64
}

func swappedSmall(_ input: SmallPair) -> SmallPair {
    return SmallPair { a: input.b, b: input.a }
}

func double(_ n: int64) -> int64 {
    return n * 2
}

func main() {
    var value = SmallPair { a: 1, b: 1000 }
    value = swappedSmall(value)
    assert(value.a == 1000, "field a should hold the old field b")
    assert(value.b == 1, "field b should hold the old field a")

    value = swappedSmall(value)
    assert(value.a == 1, "double swap should restore field a")
    assert(value.b == 1000, "double swap should restore field b")

    var n: int64 = 21
    n = double(n)
    assert(n == 42, "scalar x = f(x) should read the initialized value")

    print("PASS: call destination liveness\n")
}

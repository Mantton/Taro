type int = isize

interface CallTransformer {
    type Input
    type Output
    func transform( i: Self::Input) -> Self::Output
}

struct IntToString {}

conform IntToString to CallTransformer {
    type Input = int
    type Output = string
    func transform( i: int) -> string { "transformed" }
}

func helper(_ x: int) -> string {
    "helper called"
}

func processCall[T: CallTransformer[Input = int, Output = string]](_ t: T, _ val: T::Input) -> string {
    var _ = t.transform(i: val)
    helper(val)
}

interface OutputProducer {
    type Output
    func produce() -> Self::Output
}

struct IntOutputProducer {}

conform IntOutputProducer to OutputProducer {
    type Output = int
    func produce() -> int { 42 }
}

struct StringOutputProducer {}

conform StringOutputProducer to OutputProducer {
    type Output = string
    func produce() -> string { "hello" }
}

func consumeIntProducer(_ p: any OutputProducer[Output = int]) -> int {
    p.produce()
}

func consumeStringProducer(_ p: any OutputProducer[Output = string]) -> string {
    p.produce()
}

func makeIntProducer() -> any OutputProducer[Output = int] {
    IntOutputProducer {}
}

func testIntProducer[T: OutputProducer[Output = int]](_ p: T) {
    var produced: int = p.produce()
    assert(produced == 42, "Output producer constraint")
}

interface Factory {
    type Product
    func create() -> Self::Product
}

struct StringFactory {}

conform StringFactory to Factory {
    type Product = string
    func create() -> string { "hello" }
}

func makeString[T: Factory[Product = string]](_ f: T) -> string {
    f.create()
}

interface ItemProducer {
    type Item
    func produce() -> Self::Item
}

struct IntItemProducer {}

conform IntItemProducer to ItemProducer {
    type Item = int
    func produce() -> int { 42 }
}

func consumeItemProducer[T: ItemProducer[Item = int]](_ p: T) {
    var x: int = p.produce()
    assert(x == 42, "Item producer inference")
}

func main() {
    t := IntToString {}
    res := processCall(t, 100)
    assert(res == "helper called", "Parametric call argument")

    var intP: any OutputProducer[Output = int] = IntOutputProducer {}
    assert(intP.produce() == 42, "existential binding int")

    var strP: any OutputProducer[Output = string] = StringOutputProducer {}
    assert(strP.produce() == "hello", "existential binding string")

    intP2 := IntOutputProducer {}
    testIntProducer(intP2)

    consumedInt := consumeIntProducer(IntOutputProducer {})
    assert(consumedInt == 42, "consumeIntProducer")

    consumedStr := consumeStringProducer(StringOutputProducer {})
    assert(consumedStr == "hello", "consumeStringProducer")

    var intP3: any OutputProducer[Output = int] = makeIntProducer()
    assert(intP3.produce() == 42, "return existential with binding")

    f := StringFactory {}
    s := makeString(f)
    assert(s == "hello", "parametric return concrete type")

    p := IntItemProducer {}
    consumeItemProducer(p)

    std::print("PASS: Parametric tests\n")
}

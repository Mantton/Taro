func main() {
    var byte: uint8 = 97_u8
    var copied: string = std::string::stringFromBytes(unsafe { std::mem::Span[uint8]::from(&byte as *const uint8, 1) })
    byte = 98_u8
    assert(copied == "a", "safe construction copies while the source is readable")

    var bytes: [uint8] = [97_u8, 0_u8, 98_u8]
    var text: string = std::string::stringFromBytes(bytes.asSpan())
    *bytes.at(0) = 122_u8
    bytes.append(99_u8)
    assert(text.byteLen() == 3, "string owns exactly the initialized byte view")
    assert(text.byteAt(0) == 97_u8, "later source mutation cannot affect a string")
    assert(text.byteAt(1) == 0_u8, "embedded zero is an ordinary byte")
    assert(text.byteAt(2) == 98_u8, "growth cannot affect the string's byte extent")
}

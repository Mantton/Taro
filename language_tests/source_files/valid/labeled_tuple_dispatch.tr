func pick(_ value: (low: int32, high: int32)) -> int32 { value.low + value.high }
func pick(_ value: (first: int64, second: int64)) -> int64 { value.first - value.second }
func main() {
    var a: (int32, int32) = (3, 2)
    var b: (int64, int64) = (3, 2)
    assert(pick(a) == 5 && pick(b) == 1, "element types select the overload")
    var nested: (range: (low: int32, high: int32), tag: int64) = (a, 42_i64)
    assert(nested.range.high == 2 && nested.0.1 == 2 && nested.tag == 42, "nested positions")
    println("dispatch")
}

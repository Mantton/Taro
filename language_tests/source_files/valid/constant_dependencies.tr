struct FixedBuffer[const Size: usize = DEFAULT_SIZE] {
    bytes: [uint8; Size]
}

struct Header {
    bytes: [uint8; HEADER_SIZE]
}

const ANSWER: int32 = BASE + 2
const BASE: int32 = 40
const DEFAULT_SIZE: usize = 4
const HEADER_SIZE: usize = FINAL_HEADER_SIZE
const FINAL_HEADER_SIZE: usize = 2

namespace Values {
    const EARLY: int32 = LATE + 1
    const LATE: int32 = 9
}

static let STATIC_ANSWER: int32 = LATE_STATIC_ANSWER
const LATE_STATIC_ANSWER: int32 = ANSWER

func main() {
    let fixed: FixedBuffer = FixedBuffer { bytes: [1, 2, 3, 4] }
    let header = Header { bytes: [5, 6] }

    assert(ANSWER == 42, "forward constant initializer")
    assert(Values.EARLY == 10, "forward namespace constant initializer")
    assert(STATIC_ANSWER == 42, "static initializer uses later constant")
    assert(fixed.bytes.len() == 4, "generic default uses later constant")
    assert(header.bytes.len() == 2, "array length uses later constant chain")

    std.print("PASS: constant dependencies\n")
}

// Stack maps follow temporal MIR liveness and the active enum variant.

struct PreciseOwner {
    value: int32
}

struct PartiallyMovedRoot {
    discarded: std.collections.List[int32]
    retained: &mut PreciseOwner
}

enum PreciseSlot {
    case empty
    case occupied(&mut PreciseOwner)
    // A third variant prevents null-pointer optimization so `.empty` leaves
    // the occupied payload bytes behind an inactive explicit tag.
    case scalar(int32)
}

func deadLocalDoesNotRetain() {
    let owner = make(PreciseOwner { value: 11 })
    let probe = unsafe {
        std.testing.__rt__test_gc_probe_create(owner as *const uint8)
    }

    // `owner` has no continuation use and must not appear in this call's map.
    let alive = unsafe { std.testing.__rt__test_gc_collect_probe_is_live(probe) }
    assert(!alive, "a dead local retained its weak target")
}

func keepAliveExtendsLifetime() {
    let owner = make(PreciseOwner { value: 22 })
    let probe = unsafe {
        std.testing.__rt__test_gc_probe_create(owner as *const uint8)
    }

    // This compiler-only use is after the collection, so `owner` must be live
    // across it even though keepAlive emits no runtime call or poll.
    let alive = unsafe { std.testing.__rt__test_gc_collect_probe_is_live(probe) }
    std.runtime.keepAlive(owner)
    assert(alive, "keepAlive did not extend the target lifetime")
}

func inactiveVariantDoesNotRetain() {
    let owner = make(PreciseOwner { value: 33 })
    let probe = unsafe {
        std.testing.__rt__test_gc_probe_create(owner as *const uint8)
    }
    let payloadOffset = std.mem.alignOf[*mut PreciseOwner]()
    var slot: PreciseSlot = .occupied(owner)
    slot = .empty

    // Enum lowering is allowed to clear inactive storage, so deliberately
    // seed the now-inactive payload with a valid managed pointer. This is an
    // invariant-preserving use of unspecified payload bytes: the tag remains
    // `.empty`, and a correct tagged descriptor must not visit the pointer.
    unsafe {
        let storage = &mut slot as *mut PreciseSlot as *mut uint8
        let payload = storage.add(payloadOffset) as *mut *mut PreciseOwner
        payload.write(owner as *mut PreciseOwner)
    }

    // Keep the enum storage itself live while its inactive payload still holds
    // whatever bytes the occupied representation left behind. The probe
    // observes this exact collection before any later safepoint can erase
    // evidence that an inactive payload retained the target.
    let alive = unsafe { std.testing.__rt__test_gc_collect_probe_is_live(probe) }
    std.runtime.keepAlive(&slot)
    assert(!alive, "an inactive enum payload retained its target")
}

func activeVariantRetains() {
    let owner = make(PreciseOwner { value: 44 })
    let probe = unsafe {
        std.testing.__rt__test_gc_probe_create(owner as *const uint8)
    }
    let slot: PreciseSlot = .occupied(owner)

    let alive = unsafe { std.testing.__rt__test_gc_collect_probe_is_live(probe) }
    std.runtime.keepAlive(&slot)
    assert(alive, "an active enum payload lost its target")
}

func projectedMovePreservesRemainingRoot() {
    let owner = make(PreciseOwner { value: 55 })
    let probe = unsafe {
        std.testing.__rt__test_gc_probe_create(owner as *const uint8)
    }
    var discarded = std.collections.List[int32]()
    discarded.append(1)
    let aggregate = PartiallyMovedRoot {
        discarded: discarded,
        retained: owner,
    }
    let moved = aggregate.discarded

    // Whole-local analysis deliberately remains conservative after a field
    // move: the other fields are still initialized and must remain scannable.
    let alive = unsafe { std.testing.__rt__test_gc_collect_probe_is_live(probe) }
    std.runtime.keepAlive(&aggregate.retained)
    std.runtime.keepAlive(&moved)
    assert(alive, "a projected move hid a remaining live root")
}

func main() {
    deadLocalDoesNotRetain()
    keepAliveExtendsLifetime()
    inactiveVariantDoesNotRetain()
    activeVariantRetains()
    projectedMovePreservesRemainingRoot()
    print("PASS: GC precise liveness\n")
}

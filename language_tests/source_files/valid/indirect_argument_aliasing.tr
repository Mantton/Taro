// Indirect aggregate arguments never alias caller-visible storage or sret.

const LEN: usize = 512

struct Big: Copy {
    data: [int64; LEN]
}

func makeBig(_ seed: int64) -> Big {
    var out = Big { data: [0; LEN] }
    var i: usize = 0
    while i < LEN {
        out.data.set(i, seed + i as int64)
        i += 1
    }
    return out
}

// Builds the result while reading the parameter in reverse order. If the
// return destination aliases the argument, early writes clobber elements
// that are still to be read.
func reversed(_ input: Big) -> Big {
    var out = Big { data: [0; LEN] }
    var i: usize = 0
    while i < LEN {
        out.data.set(i, *input.data.at(LEN - 1 - i))
        i += 1
    }
    return out
}

// Shifts every element one slot to the right (wrapping). At i >= 1 this
// reads an element the previous iteration already overwrote if the
// destination aliases the argument.
func rotatedRight(_ input: Big) -> Big {
    var out = Big { data: [0; LEN] }
    var i: usize = 0
    while i < LEN {
        out.data.set(i, *input.data.at((i + LEN - 1) % LEN))
        i += 1
    }
    return out
}

const HALF: usize = 256

struct Pair: Copy {
    a: [int64; HALF]
    b: [int64; HALF]
}

func filledHalf(_ seed: int64) -> [int64; HALF] {
    var out: [int64; HALF] = [0 as int64; HALF]
    var i: usize = 0
    while i < HALF {
        *out.at(i) = seed + i as int64
        i += 1
    }
    return out
}

// Lowers to field-by-field writes into the return place. If the return
// destination aliases the argument, the write of one field clobbers the
// other field before it is read.
func swapped(_ input: Pair) -> Pair {
    return Pair { a: input.b, b: input.a }
}

func checksum(_ input: Big) -> int64 {
    var total: int64 = 0
    var i: usize = 0
    while i < LEN {
        total += *input.data.at(i)
        i += 1
    }
    return total
}

func main() {
    var value = makeBig(1)
    let expected = checksum(value)

    value = reversed(value)
    assert(checksum(value) == expected, "reversal should preserve the checksum")
    assert(*value.data.at(0) == LEN as int64, "first element should hold the old last element")
    assert(*value.data.at(LEN - 1) == 1, "last element should hold the old first element")

    value = reversed(value)
    var i: usize = 0
    while i < LEN {
        assert(*value.data.at(i) == 1 + i as int64, "double reversal should restore the input")
        i += 1
    }

    value = rotatedRight(value)
    assert(checksum(value) == expected, "rotation should preserve the checksum")
    assert(*value.data.at(0) == LEN as int64, "rotation should wrap the old last element to slot 0")
    i = 1
    while i < LEN {
        assert(*value.data.at(i) == i as int64, "rotation should shift elements right by one")
        i += 1
    }

    var pair = Pair { a: filledHalf(1), b: filledHalf(1000) }
    pair = swapped(pair)
    i = 0
    while i < HALF {
        assert(*pair.a.at(i) == 1000 + i as int64, "field a should hold the old field b")
        assert(*pair.b.at(i) == 1 + i as int64, "field b should hold the old field a")
        i += 1
    }

    print("PASS: indirect argument aliasing\n")
}

// Generic direct calls pass concrete pointer values without loading through them.

func identityGeneric[T](_ value: T) -> T {
    value
}

func passPointerThroughGenericCaller[Marker](_ marker: Marker, _ ptr: *mut int32) -> *mut int32 {
    var _ = marker
    return identityGeneric(ptr)
}

func main() {
    var value: int32 = 7
    ptr := unsafe { &value as *mut int32 }

    returned := passPointerThroughGenericCaller(123_i64, ptr)
    unsafe { returned.write(99) }

    assert(value == 99, "generic caller should pass pointer value without loading through it")

    print("PASS: generic pointer direct call\n")
}

// Test: UFCS with all receiver kinds.

type int = isize

interface SpeakerByValue {
    func speak()
}

interface SpeakerByRef {
    func greet()
}

interface SpeakerByMutRef {
    func increment()
}

struct Human {
    name: string
}

conform Human to SpeakerByValue {
    func speak() {
        print("Speaking: ")
        print(self.name)
        print("\n")
    }
}

conform &Human to SpeakerByRef {
    func greet() {
        print("Greeting: ")
        print(self.name)
        print("\n")
    }
}

struct Counter {
    value: int
}

conform &Counter to SpeakerByMutRef {
    func increment() {
        self.value = self.value + 1
    }
}

func main() {
    h1 := Human { name: "Alice" }
    SpeakerByValue::speak(h1)

    h2 := Human { name: "Bob" }
    SpeakerByRef::greet(&h2)

    var c = Counter { value: 0 }
    SpeakerByMutRef::increment(&c)
    SpeakerByMutRef::increment(&c)
    assert(c.value == 2, "Counter should be 2")

    print("PASS: UFCS with all receiver kinds\n")
}

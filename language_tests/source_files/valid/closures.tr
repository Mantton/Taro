// Consolidated closure language tests.

// --- Fn helpers ---

func applyFn[F: Fn(int32) -> int32](_ f: F, _ x: int32) -> int32 {
    f(x)
}

func mapValue[T, F: Fn(T) -> T](_ value: T, _ f: F) -> T {
    f(value)
}

func applyFnPtr(_ f: (int32) -> int32, _ x: int32) -> int32 {
    f(x)
}

func applyOnceHierarchy[F: Fn(int32) -> int32](_ f: F, _ x: int32) -> int32 {
    f(x)
}

func apply2[F: Fn(int32, int32) -> int32](_ f: F, _ a: int32, _ b: int32) -> int32 {
    f(a, b)
}

func applyZeroHigher[F: Fn() -> int32](_ f: F) -> int32 {
    f()
}

func applyZeroOnce[F: Fn() -> int32](_ f: F) -> int32 {
    f()
}

func apply2MutHierarchy[F: Fn(int32, int32) -> int32](_ f: F, _ a: int32, _ b: int32) -> int32 {
    var f = f
    first := f(a, b)
    second := f(b, a)
    first * 100 + second
}

func apply2OnceHierarchy[F: Fn(int32, int32) -> int32](_ f: F, _ a: int32, _ b: int32) -> int32 {
    f(a, b)
}

func mapValHigher[F: Fn(int32) -> int32](_ value: int32, _ transform: F) -> int32 {
    transform(value)
}

func applyOutFn[T, Out, F: Fn(T) -> Out](_ x: T, _ f: F) -> Out {
    f(x)
}

func applyOutMut[T, Out, F: Fn(T) -> Out](_ x: T, _ f: F) -> Out {
    var f = f
    f(x)
}

func applyOutOnce[T, Out, F: Fn(T) -> Out](_ x: T, _ f: F) -> Out {
    f(x)
}

// --- Fn helpers ---

func applyMut[F: Fn(int32) -> int32](_ f: F, _ a: int32, _ b: int32) -> int32 {
    var f = f
    first := f(a)
    second := f(b)
    return first + second
}

func applyZeroMut[F: Fn() -> int32](_ f: F) -> int32 {
    var f = f
    a := f()
    b := f()
    c := f()
    return a + b + c
}

// --- Fn helpers ---

func callTwice[F: Fn() -> int32](_ f: F) -> int32 {
    f() + f()
}

// --- Struct helpers ---

struct ClosureBox {
    value: int32
}

extend ClosureBox {
    func map[F: Fn(int32) -> int32]( _ f: F) -> int32 {
        f(self.value)
    }

    func map_once[F: Fn(int32) -> int32]( _ f: F) -> int32 {
        f(self.value)
    }

    func transform[F: Fn(int32) -> int32, G: Fn(int32) -> int32]( _ f: F, _ g: G) -> int32 {
        g(f(self.value))
    }
}

struct PairMethod {
    a: int32
    b: int32
}

extend PairMethod {
    func combine[F: Fn(int32, int32) -> int32]( _ f: F) -> int32 {
        f(self.a, self.b)
    }
}

struct ContainerMethodGeneric[T] {
    value: T
}

extend[T] ContainerMethodGeneric[T] {
    func map[F: Fn(T) -> T]( _ f: F) -> T {
        f(self.value)
    }

    func map_once[F: Fn(T) -> T]( _ f: F) -> T {
        f(self.value)
    }
}

struct PairMethodGeneric[T] {
    first: T
    second: T
}

extend[T] PairMethodGeneric[T] {
    func combine[F: Fn(T, T) -> T]( _ f: F) -> T {
        f(self.first, self.second)
    }

    func map_both[F: Fn(T) -> T]( _ f: F) -> PairMethodGeneric[T] {
        PairMethodGeneric[T] { first: f(self.first), second: f(self.second) }
    }
}

struct CallableField[F: Fn(int32) -> int32] {
    f: F
}

extend[F: Fn(int32) -> int32] CallableField[F] {
    func apply( _ x: int32) -> int32 {
        self.f(x)
    }
}

func applyGenericMethod[T, F: Fn(T) -> T](_ f: F, _ x: T) -> T {
    f(x)
}

func composeGenericMethod[T, F: Fn(T) -> T, G: Fn(T) -> T](_ f: F, _ g: G, _ x: T) -> T {
    intermediate := f(x)
    g(intermediate)
}

func consumeListMove(_ list: List[int32]) {
}

// --- Generic capture helpers ---

func wrapAndConsume[T](_ value: T, _ check: (T) -> int32) -> int32 {
    closure := () => { check(value) }
    return applyZeroOnce(closure)
}

func wrapCopyable[T](_ value: T, _ check: (T) -> int32) -> int32 {
    closure := () => { check(value) }
    return callTwice(closure)
}

// === Tests ===

func testClosureBasic() {
    add := (a: int32, b: int32) -> int32 => { a + b }
    result := add(2, 3)
    std::assert(result == 5, "add(2, 3) should be 5")

    square := (x: int32) -> int32 => { x * x }
    std::assert(square(4) == 16, "square(4) should be 16")

    get_five := () -> int32 => { 5 }
    std::assert(get_five() == 5, "get_five() should be 5")

    var x: int32 = 10
    add_x := (y: int32) -> int32 => { x + y }
    std::assert(add_x(5) == 15, "add_x(5) should be 15")

    var a: int32 = 3
    var b: int32 = 4
    sum_ab := () -> int32 => { a + b }
    std::assert(sum_ab() == 7, "sum_ab() should be 7")
}

func testClosureByRef() {
    var list = List[int32]::new()
    list.append(1)
    list.append(2)

    get_len := () -> int32 => { list.len() as int32 }
    std::assert(get_len() == 2, "list length should be 2")
}

func testClosureDeep() {
    var a: int32 = 1
    deep := () -> int32 => {
        var b: int32 = 2
        mid := () -> int32 => {
            var c: int32 = 3
            inner := () -> int32 => { a + b + c }
            inner()
        }
        mid()
    }
    std::assert(deep() == 6, "deeply nested should compute 1+2+3 = 6")
}

func testClosureExplicitParams() {
    result1 := applyFn((x: int32) -> int32 => { x * 2 }, 5)
    std::assert(result1 == 10, "apply_int should work")

    result2 := mapValue(10, (x: int32) -> int32 => { x + 5 })
    std::assert(result2 == 15, "map_value should work")

    box := ClosureBox { value: 20 }
    result3 := box.map((x: int32) -> int32 => { x / 2 })
    std::assert(result3 == 10, "IntBox.map should work")

    outer := (a: int32) -> int32 => {
        inner := (b: int32) -> int32 => { b * 2 }
        inner(a) + 1
    }
    result4 := outer(5)
    std::assert(result4 == 11, "nested closure should work")

    var base: int32 = 100
    add_base := (x: int32) -> int32 => { x + base }
    result5 := applyFn(add_base, 50)
    std::assert(result5 == 150, "capturing closure inference")

    double := (x: int32) -> int32 => { x * 2 }
    triple := (x: int32) -> int32 => { x * 3 }
    r6a := applyFn(double, 5)
    r6b := applyFn(triple, 5)
    std::assert(r6a == 10, "double should work")
    std::assert(r6b == 15, "triple should work")
}

func testClosureFnPtr() {
    var double: (int32) -> int32 = (x: int32) -> int32 => { x * 2 }

    result := applyFnPtr(double, 5)
    std::assert(result == 10, "double(5) should be 10")

    result2 := applyFnPtr((x: int32) -> int32 => { x + 100 }, 7)
    std::assert(result2 == 107, "closure(7) should be 107")

    var get_42: () -> int32 = () -> int32 => { 42 }
    std::assert(get_42() == 42, "get_42() should be 42")
}

func testClosureSharedReadCapture() {
    var counter: int32 = 0
    inc := () -> int32 => { counter + 1 }
    first := inc()
    counter = 5
    second := inc()
    std::assert(first == 1, "first call reads the captured variable")
    std::assert(second == 6, "later calls observe outer writes")
    std::assert(counter == 5, "read-only closure calls preserve the variable")
}

func testClosureHierarchy() {
    var multiplier: int32 = 2

    r1 := applyFn((x: int32) -> int32 => { x * multiplier }, 5)
    std::assert(r1 == 10, "apply_fn should work with Fn closure")

    r2 := applyMut((x: int32) -> int32 => { x * multiplier }, 5, 5)
    std::assert(r2 == 20, "apply_mut should accept Fn closure via hierarchy")

    r3 := applyOnceHierarchy((x: int32) -> int32 => { x * multiplier }, 5)
    std::assert(r3 == 10, "apply_once should accept Fn closure via hierarchy")

    r4 := applyOnceHierarchy((x: int32) -> int32 => { x + 1 }, 5)
    std::assert(r4 == 6, "non-capturing Fn closure in apply_once")

    r5 := applyMut((x: int32) -> int32 => { x * 3 }, 4, 4)
    std::assert(r5 == 24, "non-capturing Fn closure in apply_mut")
}

func testClosureHigherOrder() {
    sum := apply2((a: int32, b: int32) -> int32 => { a + b }, 10, 20)
    std::assert(sum == 30, "apply2 sum(10, 20) should be 30")

    result := mapValHigher(5, (x: int32) -> int32 => { x + 10 })
    result2 := mapValHigher(result, (x: int32) -> int32 => { x * 2 })
    std::assert(result2 == 30, "chained map should be 30")
}

func testClosureInferred() {
    doubled := applyFn((x) => { x * 2 }, 5)
    std::assert(doubled == 10, "apply with inferred param should work")

    var multiplier: int32 = 3
    tripled := applyFn((x) => { x * multiplier }, 4)
    std::assert(tripled == 12, "capturing closure with inferred param")

    sum := apply2((a, b) => { a + b }, 10, 20)
    std::assert(sum == 30, "two-arg closure with inferred params")

    container := ClosureBox { value: 10 }
    result := container.map((x) => { x + 5 })
    std::assert(result == 15, "method with inferred closure param")

    chained := container.transform((x) => { x * 2 }, (x) => { x + 1 })
    std::assert(chained == 21, "chained closures with inferred params")

    mixed := applyFn((x) -> int32 => { x * 10 }, 5)
    std::assert(mixed == 50, "explicit return type, inferred param")

    var outer_val: int32 = 100
    nested := applyFn((x) => {
        inner := applyFn((y) => { y + outer_val }, x)
        inner * 2
    }, 5)
    std::assert(nested == 210, "nested closures with inferred params")
}

func testClosureGenericOutInference() {
    doubled := applyOutFn(5 as int32, (x: int32) => { x * 2 })
    std::assert(doubled == 10, "Out should infer to int32")

    is_even := applyOutFn(6 as int32, (x: int32) => { x % 2 == 0 })
    std::assert(is_even, "Out should infer to bool")

    var total: int32 = 0
    running := applyOutMut(3 as int32, (x: int32) => {
        total += x
        total > 0
    })
    std::assert(running && total == 3, "Fn Out inference and shared mutable capture should work")

    once_result := applyOutOnce(9 as int32, (x: int32) => { x + 1 })
    std::assert(once_result == 10, "Fn Out inference should work")
}

func testClosureMethod() {
    container := ClosureBox { value: 10 }

    doubled := container.map((x: int32) -> int32 => { x * 2 })
    std::assert(doubled == 20, "map double should be 20")

    var multiplier: int32 = 3
    tripled := container.map((x: int32) -> int32 => { x * multiplier })
    std::assert(tripled == 30, "map triple should be 30")

    var offset: int32 = 5
    result_once := container.map_once((x: int32) -> int32 => { x + offset })
    std::assert(result_once == 15, "map_once should be 15")

    chained := container.transform(
        (x: int32) -> int32 => { x + 5 },
        (x: int32) -> int32 => { x * 2 },
    )
    std::assert(chained == 30, "transform (10+5)*2 should be 30")

    pair := PairMethod { a: 10, b: 20 }
    sum := pair.combine((a: int32, b: int32) -> int32 => { a + b })
    std::assert(sum == 30, "combine sum should be 30")
}

func testClosureMethodGeneric() {
    int_container := ContainerMethodGeneric[int32] { value: 10 }

    doubled := int_container.map((x: int32) -> int32 => { x * 2 })
    std::assert(doubled == 20, "int map should work")

    container2 := ContainerMethodGeneric[int32] { value: 10 }
    incremented := container2.map_once((x: int32) -> int32 => { x + 1 })
    std::assert(incremented == 11, "map_once should work")

    container3 := ContainerMethodGeneric[int32] { value: 10 }
    var multiplier: int32 = 5
    result := container3.map((x: int32) -> int32 => { x * multiplier })
    std::assert(result == 50, "capturing closure with generic method")

    int_pair := PairMethodGeneric[int32] { first: 3, second: 7 }

    sum := int_pair.combine((a: int32, b: int32) -> int32 => { a + b })
    std::assert(sum == 10, "pair combine should work")

    pair2 := PairMethodGeneric[int32] { first: 3, second: 7 }
    product := pair2.combine((a: int32, b: int32) -> int32 => { a * b })
    std::assert(product == 21, "pair combine product")

    pair3 := PairMethodGeneric[int32] { first: 3, second: 7 }
    doubled_pair := pair3.map_both((x: int32) -> int32 => { x * 2 })
    std::assert(doubled_pair.first == 6, "map_both first")
    std::assert(doubled_pair.second == 14, "map_both second")

    applied := applyGenericMethod((x: int32) -> int32 => { x + 100 }, 5)
    std::assert(applied == 105, "apply_generic should work")

    composed := composeGenericMethod(
        (x: int32) -> int32 => { x * 2 },
        (x: int32) -> int32 => { x + 1 },
        5,
    )
    std::assert(composed == 11, "compose (5*2)+1 = 11")
}

func testCallableFieldDispatch() {
    var add_one = CallableField { f: (x: int32) -> int32 => { x + 1 } }
    std::assert(add_one.apply(10) == 11, "self.f(x) should dispatch callable field")

    var accumulator = CallableField {
        f: (x: int32) -> int32 => { x * 2 },
    }

    first := accumulator.apply(3)
    second := accumulator.apply(4)
    std::assert(first == 6, "first call should return doubled value")
    std::assert(second == 8, "second call should return doubled value")
}

func testClosureMove() {
    var list = List[int32]::new()
    list.append(1)

    consume := () => { consumeListMove(list) }
    consume()
}

func testClosureNested() {
    var x: int32 = 10

    outer := () -> int32 => {
        inner := () -> int32 => { x }
        inner()
    }
    std::assert(outer() == 10, "simple nested should return 10")

    var y: int32 = 20
    outer2 := () -> int32 => {
        inner := () -> int32 => { x + y }
        inner() + 5
    }
    std::assert(outer2() == 35, "nested with computation should return 35")

    result := (() -> int32 => {
        (() -> int32 => { x * 2 })()
    })()
    std::assert(result == 20, "immediate call nested should return 20")
}

func testClosureShorthandStress() {
    zero := applyZeroHigher(() -> int32 => { 99 })
    std::assert(zero == 99, "zero-arg Fn shorthand should dispatch through generic helper")

    immediate_zero := applyZeroHigher((() -> int32 => { 123 }))
    std::assert(immediate_zero == 123, "immediate zero-arg closure should materialize a self place")

    zero_mut_sum := applyZeroMut(() -> int32 => { 1 })
    std::assert(zero_mut_sum == 3, "zero-arg Fn helper should call closure three times")

    mut_sum := applyMut((x: int32) -> int32 => { x + 1 }, 3, 4)
    std::assert(mut_sum == 9, "Fn helper should apply closure to each argument")

    var list = List[int32]::new()
    list.append(4)
    list.append(5)
    once_len := applyZeroOnce(() -> int32 => {
        len := list.len() as int32
        consumeListMove(list)
        len
    })
    std::assert(once_len == 2, "Fn helper should accept non-Copy captured values by value")

    pair_mut_result := apply2MutHierarchy((a: int32, b: int32) -> int32 => { a * 10 + b }, 1, 2)
    std::assert(pair_mut_result == 1221, "two-arg Fn shorthand should preserve argument order on each call")

    var pair_list = List[int32]::new()
    pair_list.append(10)
    pair_once := apply2OnceHierarchy((a: int32, b: int32) -> int32 => {
        len := pair_list.len() as int32
        consumeListMove(pair_list)
        a + b + len
    }, 3, 4)
    std::assert(pair_once == 8, "two-arg Fn shorthand should consume captured values correctly")
}

// --- Fn dispatch tests ---

func testStatefulFnNonCapturing() {
    result := applyMut((x: int32) -> int32 => { x * 2 }, 3, 5)
    assert(result == 16, "non-capturing closure through Fn(int32)->int32 should work")
}

func testStatefulFnListCapture() {
    var items: std::collections::List[int32] = std::collections::List::new()
    acc := (val: int32) -> int32 => {
        items.append(val)
        return items.len() as int32
    }
    result := applyMut(acc, 10, 20)
    assert(result == 3, "mutating List closure through Fn(int32)->int32: 1+2=3")
    assert(items.len() == 2 as usize, "List should have two items after applyMut")
}

func testStatefulFnZeroArgListCapture() {
    var growing: std::collections::List[int32] = std::collections::List::new()
    inc := () -> int32 => {
        growing.append(1)
        return growing.len() as int32
    }
    sum := applyZeroMut(inc)
    assert(sum == 6, "mutating List closure through Fn()->int32: 1+2+3=6")
    assert(growing.len() == 3 as usize, "List should have three items after applyZeroMut")
}

func testStatefulFnListCaptureWithArg() {
    var items: std::collections::List[int32] = std::collections::List::new()
    var push = (val: int32) => {
        items.append(val)
    }
    push(10)
    push(20)
    push(30)
    assert(items.len() == 3, "closure should mutate captured list")
}

// --- Fn scalar mutable capture tests ---

func testStatefulFnScalarCaptureThroughHelper() {
    var counter: int32 = 0
    inc := () -> int32 => {
        counter = counter + 1
        return counter
    }
    sum := applyZeroMut(inc)
    assert(sum == 6, "scalar mutable capture through Fn should accumulate: 1+2+3=6")
    assert(counter == 3, "outer counter should reflect mutations after applyZeroMut")
}

func testStatefulFnScalarCaptureDirectCalls() {
    var counter: int32 = 0
    var inc = () -> int32 => {
        counter = counter + 1
        return counter
    }
    a := inc()
    b := inc()
    c := inc()
    assert(a == 1, "first direct call should return 1")
    assert(b == 2, "second direct call should return 2")
    assert(c == 3, "third direct call should return 3")
    assert(counter == 3, "outer counter should be 3 after three direct calls")
}

func testStatefulFnScalarCaptureWithArg() {
    var total: int32 = 0
    acc := (val: int32) -> int32 => {
        total = total + val
        return total
    }
    result := applyMut(acc, 10, 20)
    assert(result == 40, "scalar accumulator through Fn(int32)->int32: 10+30=40")
    assert(total == 30, "outer total should be 30 after accumulating 10 and 20")
}

// --- Generic closure move semantics tests ---

func testGenericClosureNonCopyCapture() {
    result := wrapAndConsume(42 as int32, (x) => { x })
    assert(result == 42, "non-copy generic capture via Fn")
}

func testGenericClosureCopyCapture() {
    result := wrapCopyable(10 as int32, (x) => { x })
    assert(result == 20, "copy generic capture via Fn called twice")
}

func testClosureCapturesSharedVariable() {
    var counter: int32 = 0
    captured := () -> int32 => { counter + 1 }
    counter = 10
    sum := callTwice(captured)
    assert(sum == 22, "literal closure observes later writes to captured variables")
    assert(counter == 10, "outer copyable variable should remain usable after literal closure capture")
}

func testClosureHandleReadIsReusable() {
    var list = List[int32]::new()
    list.append(1)

    captured := () -> int32 => { list.len() as int32 }
    sum := callTwice(captured)
    assert(sum == 2, "literal closure that only reads an shared handle capture should remain Fn")
}

func testClosureMutatesSharedVariable() {
    var counter: int32 = 0
    inc := () -> int32 => {
        counter = counter + 1
        return counter
    }

    sum := applyZeroMut(inc)
    assert(sum == 6, "literal closure should mutate shared captured storage across calls")
    assert(counter == 3, "closure edits are visible through the captured variable")
}

func testClosurePassesHandleToFunction() {
    var list = List[int32]::new()
    list.append(1)
    list.append(2)

    consume := () -> int32 => {
        len := list.len() as int32
        consumeListMove(list)
        return len
    }

    len := applyZeroOnce(consume)
    assert(len == 2, "literal closure that moves out of a capture should be Fn")
}

// === Main ===

func main() {
    testClosureBasic()
    testClosureByRef()
    testClosureDeep()
    testClosureExplicitParams()
    testClosureFnPtr()
    testClosureSharedReadCapture()
    testClosureHierarchy()
    testClosureHigherOrder()
    testClosureInferred()
    testClosureGenericOutInference()
    testClosureMethod()
    testClosureMethodGeneric()
    testCallableFieldDispatch()
    testClosureMove()
    testClosureNested()
    testClosureShorthandStress()
    testStatefulFnNonCapturing()
    testStatefulFnListCapture()
    testStatefulFnZeroArgListCapture()
    testStatefulFnListCaptureWithArg()
    testStatefulFnScalarCaptureThroughHelper()
    testStatefulFnScalarCaptureDirectCalls()
    testStatefulFnScalarCaptureWithArg()
    testGenericClosureNonCopyCapture()
    testGenericClosureCopyCapture()
    testClosureCapturesSharedVariable()
    testClosureHandleReadIsReusable()
    testClosureMutatesSharedVariable()
    testClosurePassesHandleToFunction()

    std::print("PASS: closures\n")
}

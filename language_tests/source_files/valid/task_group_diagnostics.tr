// EXPECT_STDERR_CONTAINS: task dump: 2 live task(s)
// EXPECT_STDERR_CONTAINS: task_group_diagnostics.tr:14:
// EXPECT_STDERR_CONTAINS: sleeping for another
// EXPECT_STDERR_NOT_CONTAINS: definitive deadlock cycle

func main() async {
    let (readySender, readyReceiver) = match std.sync.bounded[int32](1) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("task group diagnostic channel should be created")
    }

    await std.task.withTaskGroup(|group: &mut std.task.TaskGroup[int32]| async {
        let childReady = readySender
        group.spawn(|| async {
            match await childReady.send(1_i32) {
                case .ok(_) => {}
                case .err(_) => std.panic.panic("task group child should signal readiness")
            }
            await std.task.sleep(std.time.Duration.fromSeconds(30_u64))
            return 1_i32
        })
        match await readyReceiver.recv() {
            case .some(_) => {}
            case .none => std.panic.panic("task group parent should receive readiness")
        }
        std.task.dump()
        return 0_i32
    })
}

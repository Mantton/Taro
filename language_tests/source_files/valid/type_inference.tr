import std::collections::List

enum IntOutcome {
    case success(int32)
    case failure
}

func make_success(_ val: int32) -> IntOutcome {
    IntOutcome::success(val)
}

final class RangeIterator {
    current: int32
    end: int32
}

extend RangeIterator {
    init(current: int32, end: int32) {
        self.current = current
        self.end = end
    }
}

conform RangeIterator to Iterator {
    type Element = int32

    func next() -> Optional[int32] {
        if self.current < self.end {
            value := self.current
            self.current = self.current + 1
            return Optional::some(value)
        }
        return Optional::none
    }
}

struct SimpleRange {
    start: int32
    end: int32
}

conform SimpleRange to Iterable {
    type Iterator = RangeIterator
    type Element = int32

    func iter() -> RangeIterator {
        RangeIterator ( current: self.start, end: self.end )
    }
}

func test_match_inference() {
    var x = make_success(10)
    match x {
        case .success(val) => { var _: int32 = val + 1 }
        case .failure => {}
    }
}

func test_nested_blocks() {
    var x = IntOutcome::failure
    if true {
        if true {
            x = make_success(42)
        }
    }
    match x {
        case .success(val) => { var _: int32 = val }
        case .failure => {}
    }
}

func test_ifelse_inference() {
    x := if true { make_success(1) } else { IntOutcome::failure }
    match x {
        case .success(v) => { var _: int32 = v }
        case .failure => {}
    }
}

func test_nested_match() {
    var x = make_success(100)
    match x {
        case .success(val) => {
            var y = make_success(val)
            match y {
                case .success(inner) => { var _: int32 = inner }
                case .failure => {}
            }
        }
        case .failure => {}
    }
}

func test_match_on_call_nested() {
    match make_success(200) {
        case .success(val) => {
            match make_success(val + 1) {
                case .success(inner) => { var _: int32 = inner }
                case .failure => {}
            }
        }
        case .failure => {}
    }
}

func test_loop_match_nesting() {
    range := SimpleRange { start: 0, end: 3 }
    for i in range {
        match make_success(i) {
            case .success(val) => {
                var _ = val * 2
            }
            case .failure => {}
        }
    }
}

func test_match_loop_nesting() {
    result := make_success(5)
    match result {
        case .success(count) => {
            r := SimpleRange { start: 0, end: count }
            for k in r {
                var _ = k
            }
        }
        case .failure => {}
    }
}

func test_inferred_members_main() {
    var a: int32? = .none
    var b: int32? = .some(1)

    match a {
        case .some(_) => assert(false, "a is none")
        case .none => assert(true, "a match none")
    }

    match b {
        case .some(_) => assert(true, "b match some")
        case .none => assert(false, "b is some")
    }

    test_inferred_expr_contexts()
    test_call_context()
    test_asi_newline_continuation()
    test_nested_generic()
    test_expected_from_call()
}

func f() -> int32? {
    .none
}

func g() -> int32? {
    .some(42)
}

func test_inferred_expr_contexts() {
    var _x: int32? = .some(7)
    var _y: int32? = .none

    var _z: int32? = if true { .some(1) } else { .none }

    var _m: int32? = match true {
        case true => .some(9)
        case false => .none
    }
}

func test_call_context() {
    func makeOpt() -> int32? {
        .some(5)
    }
    var _v: int32? = makeOpt()
}

func test_asi_newline_continuation() {
    var _a: int32? =
        .none

    var _b: int32? =
        .some(3)

    var c: int32? = .some(4)
    c
        .isSome()
}

func test_nested_generic() {
    var _a: int32?? = .some(.none)
    var _b: int32?? = .some(.some(1))
}

func takesOpt(_ v: int32?) {}

func test_expected_from_call() {
    takesOpt(.none)
    takesOpt(.some(11))
}

func pushSome[Key](_ values: &List[Key?], _ key: Key) {
    values.append(.some(key))
}

func test_inferred_some_method_arg_expectation() {
    var values: List[int32?] = List::new()
    pushSome(&values, 10)
    assert(values.len() == 1, "pushSome should append one value")
}

func takesList(_ xs: [int32]) -> usize {
    xs.len()
}

func makeList() -> [int32] {
    [4, 5, 6]
}

func twoSumLike(_ nums: [int32], target: int32) -> [int32] {
    var _ = nums
    var _ = target
    return []
}

func test_contextual_list_literals() {
    var values: [_] = [1, 2, 3]
    assert(values.len() == 3, "annotated list literal should infer element type")
    assert(*values.at(2) == 3, "annotated list literal value check")

    from_arg_len := takesList([7, 8, 9])
    assert(from_arg_len == 3, "list literal should typecheck against call argument context")

    from_return := makeList()
    assert(*from_return.at(1) == 5, "list literal should typecheck against return context")

    var empty: [int32] = []
    assert(empty.len() == 0, "empty list literal should typecheck against annotation context")

    labeled := twoSumLike([1, 2], target: 3)
    assert(labeled.len() == 0, "list literal should typecheck with labeled call arguments")
}

func main() {
    test_match_inference()
    test_nested_blocks()
    test_ifelse_inference()
    test_nested_match()
    test_match_on_call_nested()
    test_loop_match_nesting()
    test_match_loop_nesting()

    test_inferred_members_main()
    test_inferred_some_method_arg_expectation()
    test_contextual_list_literals()

    std::print("PASS: Type inference\n")
}

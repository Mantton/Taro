// An enum literal passed to a reference-taking operation becomes address
// taken. Escape analysis must keep the lowered discriminant write aimed at the
// enum pointee after it replaces the temporary with a heap reference.

enum ReferenceChoice: std.marker.Copy, std.ops.PartialEq {
    case first
    case second
}

impl ReferenceChoice {
    func isFirst(&self) -> bool {
        *self == ReferenceChoice.first
    }
}

func main() {
    let choice = ReferenceChoice.first
    assert(choice.isFirst(), "enum comparison through a reference should preserve the literal")
    print("PASS: heapified enum discriminant regression\n")
}

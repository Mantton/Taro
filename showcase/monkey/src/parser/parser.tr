import monkey::ast::{Expression, Statement, Program, HashEntry, PrefixOperator, InfixOperator}
import monkey::lexer::Lexer
import monkey::token::{Token, TokenKind, TokenTag, Position}

/// Binding power, lowest to highest.
public enum Precedence {
    case lowest
    case equals
    case comparison
    case sum
    case product
    case prefix
    case call
    case index
}

extend Precedence {
    func rank() -> int32 {
        match self {
            case .lowest => 0
            case .equals => 1
            case .comparison => 2
            case .sum => 3
            case .product => 4
            case .prefix => 5
            case .call => 6
            case .index => 7
        }
    }

    func isLowerThan(_ other: Precedence) -> bool {
        return self.rank() < other.rank()
    }
}

/// A parse failure, reported with the position of the offending token.
public struct ParseError {
    public message: string
    public position: Position
}

/// Retain a recursive child independently of the parser stack.
func node(_ expression: Expression) -> &Expression { &expression }

/// Binding power of the operator a token introduces when used infix.
func infixPrecedence(_ kind: TokenKind) -> Precedence {
    match kind {
        case .equal => .equals
        case .notEqual => .equals
        case .lessThan => .comparison
        case .greaterThan => .comparison
        case .plus => .sum
        case .minus => .sum
        case .slash => .product
        case .asterisk => .product
        case .leftParen => .call
        case .leftBracket => .index
        case _ => .lowest
    }
}

/// The infix operator a token denotes, when it denotes one.
func infixOperator(_ kind: TokenKind) -> Optional[InfixOperator] {
    match kind {
        case .plus => .some(.add)
        case .minus => .some(.subtract)
        case .asterisk => .some(.multiply)
        case .slash => .some(.divide)
        case .lessThan => .some(.lessThan)
        case .greaterThan => .some(.greaterThan)
        case .equal => .some(.equal)
        case .notEqual => .some(.notEqual)
        case _ => .none
    }
}

/// A Pratt parser for Monkey.
///
/// The Go original registers prefix and infix parse functions in two maps keyed
/// by token type. Matching on the token kind directly keeps dispatch exhaustive:
/// a token that gains a new meaning cannot silently fall through to "no prefix
/// parse function found".
/// Deepest expression nesting the parser will descend into.
///
/// Recursive descent costs several stack frames per level, and an `Expression`
/// temporary is wide, so unbounded nesting exhausts the stack. The runtime does
/// reports stack exhaustion fatally, so nesting is checked first and reported
/// as an ordinary recoverable parse error.
const MAX_NESTING_DEPTH: usize = 256

public struct Parser {
    lexer: Lexer
    current: Token
    peek: Token
    errors: List[ParseError]
    depth: usize
}

extend &Parser {

    func advance() {
        self.current = self.peek
        self.peek = self.lexer.nextToken()
    }

    func report(_ message: string, _ position: Position) {
        self.errors.append(ParseError { message, position })
    }

    func currentIs(_ tag: TokenTag) -> bool {
        return self.current.kind.tag() == tag
    }

    func peekIs(_ tag: TokenTag) -> bool {
        return self.peek.kind.tag() == tag
    }

    /// Advances past `tag`, reporting when the next token is something else.
    func expect(_ tag: TokenTag) -> bool {
        if self.peekIs(tag) {
            self.advance()
            return true
        }
        message := sprintf(
            "expected %s, found %s",
            tag.describe(),
            self.peek.kind.describe(),
        )
        position := self.peek.position
        self.report(message, position)
        return false
    }

    public func parseProgram() -> Result[Program, List[ParseError]] {
        var statements = List[Statement]::new()

        while !self.currentIs(TokenTag::eof) {
            match self.parseStatement() {
                case .some(statement) => statements.append(statement)
                case .none => {}
            }
            self.advance()
        }

        if !self.errors.isEmpty() {
            var reported = List[ParseError]::new()
            for error in self.errors {
                reported.append(ParseError { message: error.message, position: error.position })
            }
            return .err(reported)
        }
        return .ok(Program { statements })
    }

    func parseStatement() -> Optional[Statement] {
        match self.current.kind {
            case .`let` => return self.parseBind()
            case .`return` => return self.parseProduce()
            case _ => return self.parseExpressionStatement()
        }
    }

    func parseBind() -> Optional[Statement] {
        namePosition := self.peek.position
        var name = ""
        match self.peek.kind {
            case .identifier(text) => name = text
            case _ => {
                found := self.peek.kind.describe()
                self.report(sprintf("expected identifier after 'let', found %s", found), namePosition)
                return .none
            }
        }
        self.advance()

        if !self.expect(.assign) {
            return .none
        }
        self.advance()

        value := self.parseExpression(.lowest)!
        if self.peekIs(TokenTag::semicolon) {
            self.advance()
        }
        return .some(.bind(name: name, value: value))
    }

    func parseProduce() -> Optional[Statement] {
        self.advance()
        value := self.parseExpression(.lowest)!
        if self.peekIs(TokenTag::semicolon) {
            self.advance()
        }
        return .some(.produce(value: value))
    }

    func parseExpressionStatement() -> Optional[Statement] {
        value := self.parseExpression(.lowest)!
        if self.peekIs(TokenTag::semicolon) {
            self.advance()
        }
        return .some(.expression(value: value))
    }

    /// Pratt loop: parse a prefix form, then absorb infix operators while they
    /// bind more tightly than the caller's precedence.
    func parseExpression(_ precedence: Precedence) -> Optional[Expression] {
        if self.depth >= MAX_NESTING_DEPTH {
            position := self.current.position
            self.report("expression nesting is too deep", position)
            return .none
        }
        self.depth += 1
        parsed := self.parseNested(precedence)
        self.depth -= 1
        return parsed
    }

    func parseNested(_ precedence: Precedence) -> Optional[Expression] {
        first := self.parsePrefix()!
        return self.parseSuffix(first, precedence)
    }

    // The suffix loop's temporaries need not occupy native stack while
    // parsing a nested prefix/group. Preserve the same Pratt order/depth limit.
    func parseSuffix(_ first: Expression, _ precedence: Precedence) -> Optional[Expression] {
        var left = first

        while !self.peekIs(TokenTag::semicolon) && precedence.isLowerThan(infixPrecedence(self.peek.kind)) {
            canContinue := match self.peek.kind {
                case .leftParen => true
                case .leftBracket => true
                case _ => {
                    match infixOperator(self.peek.kind) {
                        case .some(_) => true
                        case .none => false
                    }
                }
            }
            if !canContinue {
                return .some(left)
            }
            self.advance()
            left = self.parseInfix(left)!
        }

        return .some(left)
    }

    // Dispatch on the small tag. Payload construction/error formatting live in
    // nonrecursive helpers, keeping deep grouped expressions cheap at O0.
    func parsePrefix() -> Optional[Expression] {
        match self.current.kind.tag() {
            case .identifier | .integer | .text => return self.parseAtom()
            case .boolTrue => return .some(.boolean(true))
            case .boolFalse => return .some(.boolean(false))
            case .bang => return self.parseUnary(.not)
            case .minus => return self.parseUnary(.negate)
            case .leftParen => return self.parseGrouped()
            case .branchIf => return self.parseConditional()
            case .function => return self.parseFunction()
            case .leftBracket => return self.parseArray()
            case .leftBrace => return self.parseHash()
            case _ => return self.missingPrefix()
        }
    }

    func parseAtom() -> Optional[Expression] {
        match self.current.kind {
            case .identifier(name) => return .some(.identifier(name))
            case .integer(value) => return .some(.integer(value))
            case .text(value) => return .some(.text(value))
            case _ => return .none
        }
    }

    func missingPrefix() -> Optional[Expression] {
        found := self.current.kind.describe()
        position := self.current.position
        self.report(sprintf("expected an expression, found %s", found), position)
        return .none
    }

    func parseUnary(_ op: PrefixOperator) -> Optional[Expression] {
        self.advance()
        operand := self.parseExpression(.prefix)!
        return .some(.prefix(op: op, operand: node(operand)))
    }

    func parseGrouped() -> Optional[Expression] {
        self.advance()
        inner := self.parseExpression(.lowest)!
        if !self.expect(.rightParen) {
            return .none
        }
        return .some(inner)
    }

    func parseInfix(_ left: Expression) -> Optional[Expression] {
        match self.current.kind {
            case .leftParen => return self.parseCall(left)
            case .leftBracket => return self.parseIndex(left)
            case _ => {}
        }

        op := match infixOperator(self.current.kind) {
            case .some(found) => found
            case .none => {
                found := self.current.kind.describe()
                position := self.current.position
                self.report(sprintf("expected an operator, found %s", found), position)
                return .none
            }
        }

        precedence := infixPrecedence(self.current.kind)
        self.advance()
        right := self.parseExpression(precedence)!
        return .some(.infix(left: node(left), op: op, right: node(right)))
    }

    func parseCall(_ callee: Expression) -> Optional[Expression] {
        arguments := self.parseExpressionList(.rightParen)!
        return .some(.call(callee: node(callee), arguments: arguments))
    }

    func parseIndex(_ collection: Expression) -> Optional[Expression] {
        self.advance()
        index := self.parseExpression(.lowest)!
        if !self.expect(.rightBracket) {
            return .none
        }
        return .some(.index(collection: node(collection), index: node(index)))
    }

    func parseArray() -> Optional[Expression] {
        elements := self.parseExpressionList(.rightBracket)!
        return .some(.array(elements: elements))
    }

    /// Parses a comma-separated list, assuming `self.current` is the opening
    /// delimiter, and stops after consuming `closing`.
    func parseExpressionList(_ closing: TokenTag) -> Optional[List[Expression]] {
        var items = List[Expression]::new()

        if self.peekIs(closing) {
            self.advance()
            return .some(items)
        }

        self.advance()
        first := self.parseExpression(.lowest)!
        items.append(first)

        while self.peekIs(TokenTag::comma) {
            self.advance()
            self.advance()
            next := self.parseExpression(.lowest)!
            items.append(next)
        }

        if !self.expect(closing) {
            return .none
        }
        return .some(items)
    }

    func parseHash() -> Optional[Expression] {
        var entries = List[HashEntry]::new()

        while !self.peekIs(TokenTag::rightBrace) {
            self.advance()
            key := self.parseExpression(.lowest)!
            if !self.expect(.colon) {
                return .none
            }
            self.advance()
            value := self.parseExpression(.lowest)!
            entries.append(HashEntry { key, value })

            if !self.peekIs(TokenTag::rightBrace) && !self.expect(.comma) {
                return .none
            }
        }

        if !self.expect(.rightBrace) {
            return .none
        }
        return .some(.hash(entries: entries))
    }

    func parseBlock() -> Optional[List[Statement]] {
        var statements = List[Statement]::new()
        self.advance()

        while !self.currentIs(TokenTag::rightBrace) && !self.currentIs(TokenTag::eof) {
            match self.parseStatement() {
                case .some(statement) => statements.append(statement)
                case .none => return .none
            }
            self.advance()
        }

        if !self.currentIs(TokenTag::rightBrace) {
            position := self.current.position
            self.report("expected '}' to close block", position)
            return .none
        }
        return .some(statements)
    }

    func parseConditional() -> Optional[Expression] {
        if !self.expect(.leftParen) {
            return .none
        }
        self.advance()
        condition := self.parseExpression(.lowest)!
        if !self.expect(.rightParen) {
            return .none
        }
        if !self.expect(.leftBrace) {
            return .none
        }
        consequence := self.parseBlock()!

        var alternative = List[Statement]::new()
        var hasAlternative = false
        if self.peekIs(TokenTag::branchElse) {
            self.advance()
            if !self.expect(.leftBrace) {
                return .none
            }
            alternative = self.parseBlock()!
            hasAlternative = true
        }

        return .some(.conditional(
            condition: node(condition),
            consequence: consequence,
            alternative: alternative,
            hasAlternative: hasAlternative,
        ))
    }

    func parseFunction() -> Optional[Expression] {
        if !self.expect(.leftParen) {
            return .none
        }
        parameters := self.parseParameters()!
        if !self.expect(.leftBrace) {
            return .none
        }
        body := self.parseBlock()!
        return .some(.function(parameters: parameters, body: body))
    }

    func parseParameters() -> Optional[List[string]] {
        var names = List[string]::new()

        if self.peekIs(TokenTag::rightParen) {
            self.advance()
            return .some(names)
        }

        self.advance()
        match self.current.kind {
            case .identifier(name) => names.append(name)
            case _ => {
                found := self.current.kind.describe()
                position := self.current.position
                self.report(sprintf("expected a parameter name, found %s", found), position)
                return .none
            }
        }

        while self.peekIs(TokenTag::comma) {
            self.advance()
            self.advance()
            match self.current.kind {
                case .identifier(name) => names.append(name)
                case _ => {
                    found := self.current.kind.describe()
                    position := self.current.position
                    self.report(sprintf("expected a parameter name, found %s", found), position)
                    return .none
                }
            }
        }

        if !self.expect(.rightParen) {
            return .none
        }
        return .some(names)
    }
}

extend Parser {
    public static func new(_ lexer: Lexer) -> Self {
        var source = lexer
        first := source.nextToken()
        second := source.nextToken()
        return Parser {
            lexer: source,
            current: first,
            peek: second,
            errors: List[ParseError]::new(),
            depth: 0,
        }
    }
}

import monkey.code.Instructions
import monkey.object.Closure

/// One call in progress.
///
/// A frame is where the machine remembers what it was doing before a call: which
/// closure is running, how far through its instructions it had read, and where
/// that call's slots begin on the stack.
///
/// Small and copyable, so the frame stack can be storage reserved once and
/// written into by index rather than a list that grows and shrinks.
public struct Frame: std.marker.Copy {
    public closure: &Closure
    /// The offset of the next instruction to read.
    ///
    /// The reference implementation starts this at -1 and increments before
    /// reading, which needs a signed counter; pointing at the next instruction
    /// instead is the same thing said without one.
    public ip: usize
    /// The stack slot this call's locals start at.
    public base: usize
}

impl Frame {
    public func new(_ closure: &Closure, _ base: usize) -> Self {
        return Frame { closure: closure, ip: 0 as usize, base: base }
    }

    public func instructions(&self) -> &Instructions {
        return &self.closure.function.instructions
    }
}

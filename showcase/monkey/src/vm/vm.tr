import monkey::code::{Instructions, Opcode, readUint16}
import monkey::compiler::Bytecode
import monkey::object::{
    Object,
    ObjectKind,
    HashKey,
    Closure,
    CompiledFunction,
    BuiltinError,
    builtinAt,
    callBuiltin,
    reportCount,


    }

/// Deepest the operand stack will grow.
const MAX_STACK: usize = 2048

/// Most calls that can be in progress at once.
///
/// A call costs a `Frame` in storage reserved up front, not a native frame, so
/// the machine unwinds far deeper than the tree-walking evaluator can.
const MAX_FRAMES: usize = 1024

/// How many global bindings the machine holds, matching the operand width of
/// `OpSetGlobal`.
const GLOBALS_SIZE: usize = 65536

/// Why execution stopped.
///
/// Every payload is a small scalar, deliberately. This value comes back from the
/// machine's innermost loop, so `Result[(), RuntimeError]` has to stay small.
/// Nothing is lost by it: an argument count cannot exceed what `OpCall` names.
public enum RuntimeError {
    case stackOverflow
    case frameOverflow
    case unsupportedBinaryOperation(left: ObjectKind, right: ObjectKind)
    case unsupportedComparison(left: ObjectKind, right: ObjectKind)
    case unsupportedNegation(ObjectKind)
    case unusableAsHashKey(ObjectKind)
    case unsupportedIndex(collection: ObjectKind, index: ObjectKind)
    case notAFunction(ObjectKind)
    case wrongArgumentCount(expected: uint16, found: uint16)
    case divisionByZero
    case unknownBuiltin(uint8)
    /// A builtin refused its arguments; both engines report these the same way.
    case builtin(BuiltinError)
    /// A byte in the stream names no instruction. Unreachable for bytecode this
    /// compiler produced, but the machine will run any bytes it is handed.
    case unknownOpcode(uint8)
}

extend RuntimeError {
    public func describe() -> string {
        match self {
            case .stackOverflow => return "stack overflow"
            case .frameOverflow => {
                return sprintf("call depth exceeded %v nested calls", MAX_FRAMES)
            }
            case .unsupportedBinaryOperation(left, right) => {
                return sprintf(
                    "unsupported types for binary operation: %s %s",
                    left.describe(),
                    right.describe(),
                )
            }
            case .unsupportedComparison(left, right) => {
                return sprintf(
                    "unsupported types for comparison: %s %s",
                    left.describe(),
                    right.describe(),
                )
            }
            case .unsupportedNegation(kind) => {
                return sprintf("unsupported type for negation: %s", kind.describe())
            }
            case .unusableAsHashKey(kind) => {
                return sprintf("unusable as hash key: %s", kind.describe())
            }
            case .unsupportedIndex(collection, index) => {
                return sprintf(
                    "index operator not supported: %s[%s]",
                    collection.describe(),
                    index.describe(),
                )
            }
            case .notAFunction(kind) => {
                return sprintf("calling non-function: %s", kind.describe())
            }
            case .wrongArgumentCount(expected, found) => {
                return sprintf(
                    "wrong number of arguments: want %v, got %v",
                    expected,
                    found,
                )
            }
            case .divisionByZero => return "division by zero"
            case .unknownBuiltin(index) => {
                return sprintf("no builtin at index %v", index)
            }
            case .builtin(error) => return error.describe()
            case .unknownOpcode(byte) => return sprintf("unknown opcode %v", byte)
        }
    }
}

/// A stack machine that runs compiled Monkey.
///
/// Stack, globals and frame records use storage reserved once and addressed by
/// index, as in the Go reference VM.
public struct VM {
    constants: List[Object]
    stack: List[Object]
    /// Where the next value goes; the top of the stack is `sp - 1`.
    sp: usize
    globals: List[Object]
    frames: List[Frame]
    framesIndex: usize
    /// The running frame's instructions and position, read out of the frame
    /// when it changes rather than re-derived on every step. The Go reference
    /// reloads its current frame's instructions and position on each iteration.
    code: &CompiledFunction
    codeLength: usize
    ip: usize
}

/// Wraps a program's instructions as a callable with no parameters.
///
/// The machine only ever runs closures, so the top level is made to look like
/// one. That removes the special case for the outermost frame.
func mainClosure(_ instructions: Instructions) -> &Closure {
    function := CompiledFunction {
        instructions: instructions,
        localCount: 0,
        parameterCount: 0,
    }
    closure := Closure { function: &function, free: List[Object]::new() }
    return &closure
}

/// Storage of `count` slots, all null.
func reserved(_ count: usize) -> List[Object] {
    var slots = List[Object]::new()
    slots.reserve(count)
    var index: usize = 0
    while index < count {
        slots.append(.null)
        index += 1
    }
    return slots
}

extend &VM {
    /// The globals bound so far, for a later machine to continue from.
    public func globalStore() -> List[Object] { self.globals }

    /// What the program's last expression evaluated to.
    ///
    /// The slot above the stack pointer still holds what the last `OpPop`
    /// discarded, because popping only moves the pointer.
    public func result() -> Object {
        return self.stack[self.sp]
    }

    @inline
    func push(_ value: Object) -> Result[(), RuntimeError] {
        if self.sp >= MAX_STACK {
            return .err(.stackOverflow)
        }
        self.stack[self.sp] = value
        self.sp += 1
        return .ok(())
    }

    /// Takes the top value, leaving it in place above the stack pointer.
    ///
    /// Cannot underflow on bytecode this compiler produced: an instruction that
    /// pops is only emitted after the pushes that feed it.
    @inline
    func pop() -> Object {
        if self.sp == 0 {
            return .null
        }
        self.sp -= 1
        return self.stack[self.sp]
    }

    /// Reads the running frame's instructions and position into the machine.
    func enterCurrentFrame() {
        frames := self.frames
        frame := frames[self.framesIndex - 1]
        code := frame.closure.function
        self.code = code
        self.codeLength = code.instructions.len()
        self.ip = frame.ip
    }

    /// Records where the running frame had got to, before leaving it.
    func saveCurrentFrame() {
        index := self.framesIndex - 1
        frame := &self.frames[index]
        frame.ip = self.ip
    }

    /// The slot the running call's locals begin at.
    @inline
    func currentBase() -> usize {
        frames := self.frames
        return frames[self.framesIndex - 1].base
    }

    /// Runs until the outermost frame is exhausted.
    ///
    /// The opcode is read straight out of the instruction stream and each arm
    /// reads its own operands, which is what the reference implementation does.
    /// Decoding into a typed `Instruction` first would spend a dispatch building
    /// a value the machine takes apart again a line later; `Instruction` is
    /// still how the compiler emits, and how a disassembly is read.
    public func run() -> Result[(), RuntimeError] {
        while self.ip < self.codeLength {
            // Read once per step and kept in a local, the way the reference
            // implementation keeps `ins` across its loop.
            activeCode := self.code
            code := activeCode.instructions.raw()
            byte := code[self.ip]
            self.ip += 1

            opcode := match Opcode::fromByte(byte) {
                case .some(found) => found
                case .none => return .err(.unknownOpcode(byte))
            }

            match opcode {
                case .constant => {
                    index := readUint16(code, at: self.ip)
                    self.ip += 2
                    value := self.constants[index as usize]
                    self.push(value)!
                }

                case .pop => {
                    var _ = self.pop()
                }

                case .pushTrue => self.push(.boolean(true))!
                case .pushFalse => self.push(.boolean(false))!
                case .pushNull => self.push(.null)!

                case .add => self.arithmetic(Opcode::add)!
                case .subtract => self.arithmetic(Opcode::subtract)!
                case .multiply => self.arithmetic(Opcode::multiply)!
                case .divide => self.arithmetic(Opcode::divide)!

                case .equal => self.comparison(Opcode::equal)!
                case .notEqual => self.comparison(Opcode::notEqual)!
                case .greaterThan => self.comparison(Opcode::greaterThan)!

                case .negate => {
                    operand := self.pop()
                    match operand {
                        case .integer(value) => self.push(.integer(-(value)))!
                        case _ => return .err(.unsupportedNegation(operand.kind()))
                    }
                }

                case .not => {
                    operand := self.pop()
                    self.push(.boolean(!operand.isTruthy()))!
                }

                case .jump => {
                    target := readUint16(code, at: self.ip)
                    self.ip = target as usize
                }

                case .jumpNotTruthy => {
                    target := readUint16(code, at: self.ip)
                    self.ip += 2
                    condition := self.pop()
                    if !condition.isTruthy() {
                        self.ip = target as usize
                    }
                }

                case .setGlobal => {
                    slot := readUint16(code, at: self.ip)
                    self.ip += 2
                    value := self.pop()
                    self.globals[slot as usize] = value
                }

                case .getGlobal => {
                    slot := readUint16(code, at: self.ip)
                    self.ip += 2
                    value := self.globals[slot as usize]
                    self.push(value)!
                }

                case .setLocal => {
                    slot := code[self.ip]
                    self.ip += 1
                    base := self.currentBase()
                    value := self.pop()
                    self.stack[base + (slot as usize)] = value
                }

                case .getLocal => {
                    slot := code[self.ip]
                    self.ip += 1
                    base := self.currentBase()
                    value := self.stack[base + (slot as usize)]
                    self.push(value)!
                }

                case .getFree => {
                    slot := code[self.ip]
                    self.ip += 1
                    frames := self.frames
                    frame := frames[self.framesIndex - 1]
                    captured := &frame.closure.free
                    value := captured[slot as usize]
                    self.push(value)!
                }

                case .getBuiltin => {
                    slot := code[self.ip]
                    self.ip += 1
                    match builtinAt(slot as usize) {
                        case .some(builtin) => self.push(.builtin(builtin))!
                        case .none => return .err(.unknownBuiltin(slot))
                    }
                }

                case .currentClosure => {
                    frames := self.frames
                    frame := frames[self.framesIndex - 1]
                    self.push(.closure(frame.closure))!
                }

                case .array => {
                    count := readUint16(code, at: self.ip) as usize
                    self.ip += 2
                    elements := self.take(count)
                    self.push(.array(&elements))!
                }

                case .hash => {
                    count := readUint16(code, at: self.ip) as usize
                    self.ip += 2
                    values := self.take(count)
                    var entries = Dictionary[HashKey, Object]::new()
                    var position: usize = 0
                    while position < values.len() {
                        key := &values[position]
                        value := values[position + 1]
                        match key.toHashKey() {
                            case .some(hashKey) => {
                                entries.set(key: hashKey, value: value)
                            }
                            case .none => return .err(.unusableAsHashKey(key.kind()))
                        }
                        position += 2
                    }
                    self.push(.hash(&entries))!
                }

                case .index => {
                    index := self.pop()
                    collection := self.pop()
                    value := self.index(collection, index)!
                    self.push(value)!
                }

                case .closure => {
                    constant := readUint16(code, at: self.ip) as usize
                    free := code[self.ip + 2]
                    self.ip += 3
                    self.buildClosure(constant, free as usize)!
                }

                case .call => {
                    arguments := code[self.ip]
                    self.ip += 1
                    self.call(arguments as usize)!
                }

                case .returnValue => {
                    value := self.pop()
                    self.leaveFrame()
                    self.push(value)!
                }

                case .returnNothing => {
                    self.leaveFrame()
                    self.push(.null)!
                }
            }
        }
        return .ok(())
    }

    /// Removes the top `count` values, keeping their order.
    func take(_ count: usize) -> List[Object] {
        var taken = List[Object]::new()
        if count > self.sp {
            return taken
        }
        taken.reserve(count)
        var position = self.sp - count
        while position < self.sp {
            taken.append(self.stack[position])
            position += 1
        }
        self.sp -= count
        return taken
    }

    /// Scalar operations read their payloads directly from the stack. The
    /// fallback has its own frame so generic Object temporaries and their GC
    /// roots are not prepared for every integer operation.
    func arithmetic(_ opcode: Opcode) -> Result[(), RuntimeError] {
        if self.sp >= 2 {
            match &self.stack[self.sp - 2] {
                case .integer(lhs) => {
                    match &self.stack[self.sp - 1] {
                        case .integer(rhs) => {
                            self.sp -= 2
                            value := match opcode {
                                case .add => lhs + rhs
                                case .subtract => lhs - rhs
                                case .multiply => lhs * rhs
                                case _ => {
                                    if rhs == 0 { return .err(.divisionByZero) }
                                    lhs / rhs
                                }
                            }
                            return self.push(.integer(value))
                        }
                        case _ => {}
                    }
                }
                case _ => {}
            }
        }
        return self.arithmeticObjects(opcode)
    }

    @noinline
    func arithmeticObjects(_ opcode: Opcode) -> Result[(), RuntimeError] {
        right := self.pop()
        left := self.pop()
        match left {
            case .text(lhs) => {
                match right {
                    case .text(rhs) => {
                        match opcode {
                            case .add => return self.push(.text(lhs + rhs))
                            case _ => {}
                        }
                    }
                    case _ => {}
                }
            }
            case _ => {}
        }
        return .err(.unsupportedBinaryOperation(left: left.kind(), right: right.kind()))
    }

    func comparison(_ opcode: Opcode) -> Result[(), RuntimeError] {
        if self.sp >= 2 {
            match &self.stack[self.sp - 2] {
                case .integer(lhs) => {
                    match &self.stack[self.sp - 1] {
                        case .integer(rhs) => {
                            self.sp -= 2
                            value := match opcode {
                                case .greaterThan => lhs > rhs
                                case .equal => lhs == rhs
                                case _ => lhs != rhs
                            }
                            return self.push(.boolean(value))
                        }
                        case _ => {}
                    }
                }
                case _ => {}
            }
        }
        return self.compareObjects(opcode)
    }

    @noinline
    func compareObjects(_ opcode: Opcode) -> Result[(), RuntimeError] {
        right := self.pop()
        left := self.pop()
        // Integer ordering was handled above; other kinds only have equality.
        match opcode {
            case .greaterThan => return .err(.unsupportedComparison(left: left.kind(), right: right.kind()))
            case _ => {}
        }
        same := left.equals(right)
        match opcode {
            case .equal => return self.push(.boolean(same))
            case _ => return self.push(.boolean(!same))
        }
    }

    func index(
        _ collection: Object,
        _ index: Object,
    ) -> Result[Object, RuntimeError] {
        match collection {
            case .array(elements) => {
                match index {
                    case .integer(position) => {
                        if position < 0 {
                            return .ok(.null)
                        }
                        // Out of range yields null rather than failing, as
                        // Monkey specifies.
                        match elements.get(position as usize) {
                            case .some(found) => return .ok(*found)
                            case .none => return .ok(.null)
                        }
                    }
                    case _ => {}
                }
            }
            case .hash(entries) => {
                match index.toHashKey() {
                    case .some(key) => {
                        match entries.get(&key) {
                            case .some(found) => return .ok(found)
                            case .none => return .ok(.null)
                        }
                    }
                    case .none => return .err(.unusableAsHashKey(index.kind()))
                }
            }
            case _ => {}
        }
        return .err(.unsupportedIndex(collection: collection.kind(), index: index.kind()))
    }

    /// Builds a closure over the top `free` values.
    func buildClosure(_ constant: usize, _ free: usize) -> Result[(), RuntimeError] {
        captured := self.take(free)
        function := match &self.constants[constant] {
            case .compiledFunction(found) => found
            case _ => return .err(.notAFunction(self.constants[constant].kind()))
        }
        closure := Closure { function: function, free: captured }
        return self.push(.closure(&closure))
    }

    /// Calls whatever sits below the top `arguments` values.
    func call(_ arguments: usize) -> Result[(), RuntimeError] {
        if self.sp < arguments + 1 {
            return .err(.stackOverflow)
        }
        calleeSlot := self.sp - arguments - 1

        match self.stack[calleeSlot] {
            case .closure(closure) => {
                if closure.function.parameterCount != arguments {
                    return .err(.wrongArgumentCount(
                        expected: reportCount(closure.function.parameterCount),
                        found: reportCount(arguments),
                    ))
                }
                if self.framesIndex >= MAX_FRAMES {
                    return .err(.frameOverflow)
                }

                // The arguments already sit where the call's first locals
                // belong, so the frame starts just above the callee and the
                // rest of its slots are reserved by moving the pointer past
                // them — no writing, as the reference implementation does.
                base := calleeSlot + 1
                reserved := base + closure.function.localCount
                if reserved > MAX_STACK {
                    return .err(.stackOverflow)
                }

                self.saveCurrentFrame()
                self.frames[self.framesIndex] = Frame::new(closure, base)
                self.framesIndex += 1
                self.enterCurrentFrame()
                self.sp = reserved
                return .ok(())
            }
            case .builtin(builtin) => {
                taken := self.take(arguments)
                // The callee itself is still below; it goes with the call.
                self.sp -= 1
                match callBuiltin(builtin, taken) {
                    case .ok(value) => return self.push(value)
                    case .err(error) => return .err(.builtin(error))
                }
            }
            case _ => return .err(.notAFunction(self.stack[calleeSlot].kind()))
        }
    }

    /// Discards the finished call's frame, its locals and its callee.
    func leaveFrame() {
        if self.framesIndex <= 1 {
            return
        }
        base := self.currentBase()
        self.framesIndex -= 1
        self.enterCurrentFrame()
        // Everything from the callee upwards belonged to the call that ended.
        self.sp = base - 1
    }
}

extend VM {
    public static func new(_ bytecode: Bytecode) -> Self {
        return VM::withGlobals(bytecode, List[Object]::new())
    }

    /// A machine continuing with globals an earlier one bound.
    ///
    /// The REPL runs each line on a new machine but the bindings persist, so the
    /// globals outlive the machine that made them.
    public static func withGlobals(_ bytecode: Bytecode, _ globals: List[Object]) -> Self {
        closure := mainClosure(bytecode.instructions)
        entry := Frame::new(closure, 0)

        var frames = List[Frame]::new()
        frames.reserve(MAX_FRAMES)
        var index: usize = 0
        while index < MAX_FRAMES {
            frames.append(entry)
            index += 1
        }

        var store = globals
        store.reserve(GLOBALS_SIZE)
        while store.len() < GLOBALS_SIZE {
            store.append(.null)
        }

        code := closure.function
        return VM {
            constants: bytecode.constants,
            stack: reserved(MAX_STACK),
            sp: 0,
            globals: store,
            frames: frames,
            framesIndex: 1,
            code: code,
            codeLength: code.instructions.len(),
            ip: 0,
        }
    }
}

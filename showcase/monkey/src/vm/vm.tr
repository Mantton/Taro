import monkey.code.{Instructions, Opcode, readUint16}
import monkey.compiler.Bytecode
import monkey.object.{
    Object,
    ObjectKind,
    HashKey,
    Closure,
    CompiledFunction,
    Builtin,
    BuiltinError,
    builtinAt,
    callBuiltin,
    reportCount,
    boxArray,
    boxHash,
    boxClosure,
    boxCompiledFunction,
}

/// Deepest the operand stack will grow.
const MAX_STACK: usize = 2048

/// Most calls that can be in progress at once.
///
/// A call costs a `Frame` in storage reserved up front, not a native frame, so
/// the machine unwinds far deeper than the tree-walking evaluator can.
const MAX_FRAMES: usize = 1024

/// How many global bindings the machine holds, matching the operand width of
/// `OpSetGlobal`.
const GLOBALS_SIZE: usize = 65536

/// Why execution stopped.
///
/// Every payload is a small scalar, deliberately. This value comes back from the
/// machine's innermost loop, so `Result[(), RuntimeError]` has to stay small.
/// Nothing is lost by it: an argument count cannot exceed what `OpCall` names.
public enum RuntimeError: std.marker.Copy {
    case stackOverflow
    case frameOverflow
    case unsupportedBinaryOperation(left: ObjectKind, right: ObjectKind)
    case unsupportedComparison(left: ObjectKind, right: ObjectKind)
    case unsupportedNegation(ObjectKind)
    case unusableAsHashKey(ObjectKind)
    case unsupportedIndex(collection: ObjectKind, index: ObjectKind)
    case notAFunction(ObjectKind)
    case wrongArgumentCount(expected: uint16, found: uint16)
    case divisionByZero
    case unknownBuiltin(uint8)
    /// A builtin refused its arguments; both engines report these the same way.
    case builtin(BuiltinError)
    /// A byte in the stream names no instruction. Unreachable for bytecode this
    /// compiler produced, but the machine will run any bytes it is handed.
    case unknownOpcode(uint8)
}

impl RuntimeError {
    public func describe(&self) -> string {
        match self {
            case .stackOverflow => return "stack overflow"
            case .frameOverflow => {
                return std.sprintf("call depth exceeded %v nested calls", MAX_FRAMES)
            }
            case .unsupportedBinaryOperation(left, right) => {
                return std.sprintf(
                    "unsupported types for binary operation: %s %s",
                    left.describe(),
                    right.describe(),
                )
            }
            case .unsupportedComparison(left, right) => {
                return std.sprintf(
                    "unsupported types for comparison: %s %s",
                    left.describe(),
                    right.describe(),
                )
            }
            case .unsupportedNegation(kind) => {
                return std.sprintf("unsupported type for negation: %s", kind.describe())
            }
            case .unusableAsHashKey(kind) => {
                return std.sprintf("unusable as hash key: %s", kind.describe())
            }
            case .unsupportedIndex(collection, index) => {
                return std.sprintf(
                    "index operator not supported: %s[%s]",
                    collection.describe(),
                    index.describe(),
                )
            }
            case .notAFunction(kind) => {
                return std.sprintf("calling non-function: %s", kind.describe())
            }
            case .wrongArgumentCount(expected, found) => {
                return std.sprintf(
                    "wrong number of arguments: want %v, got %v",
                    *expected,
                    *found,
                )
            }
            case .divisionByZero => return "division by zero"
            case .unknownBuiltin(index) => {
                return std.sprintf("no builtin at index %v", *index)
            }
            case .builtin(error) => return error.describe()
            case .unknownOpcode(byte) => return std.sprintf("unknown opcode %v", *byte)
        }
    }
}

/// A stack machine that runs compiled Monkey.
///
/// The stack, the globals and the frames are each storage reserved once and
/// addressed by index, as the reference implementation does. Nothing grows or
/// shrinks while a program runs: a push is a store and a bump, and returning
/// from a call is one assignment to the stack pointer.
public struct VM {
    constants: List[Object]
    stack: List[Object]
    /// Where the next value goes; the top of the stack is `sp - 1`.
    sp: usize
    globals: List[Object]
    frames: List[Frame]
    framesIndex: usize
    /// The running frame's instructions and position, read out of the frame
    /// when it changes rather than re-derived on every step — the reference
    /// implementation keeps the same two in locals across its loop.
    code: &List[uint8]
    codeLength: usize
    ip: usize
}

/// Wraps a program's instructions as a callable with no parameters.
///
/// The machine only ever runs closures, so the top level is made to look like
/// one. That removes the special case for the outermost frame.
func mainClosure(_ instructions: Instructions) -> &Closure {
    let function = CompiledFunction {
        instructions: instructions,
        localCount: 0 as usize,
        parameterCount: 0 as usize,
    }
    return boxClosure(Closure {
        function: boxCompiledFunction(function),
        free: List[Object](),
    })
}

/// Storage of `count` slots, all null.
func reserved(_ count: usize) -> List[Object] {
    var slots = List[Object]()
    slots.reserve(count)
    var index = 0 as usize
    while index < count {
        slots.append(.null)
        index += 1 as usize
    }
    return slots
}

impl VM {
    public func new(_ bytecode: Bytecode) -> Self {
        return VM.withGlobals(bytecode, List[Object]())
    }

    /// A machine continuing with globals an earlier one bound.
    ///
    /// The REPL runs each line on a new machine but the bindings persist, so the
    /// globals outlive the machine that made them.
    public func withGlobals(_ bytecode: Bytecode, _ globals: List[Object]) -> Self {
        let closure = mainClosure(bytecode.instructions)
        let entry = Frame.new(closure, 0 as usize)

        var frames = List[Frame]()
        frames.reserve(MAX_FRAMES)
        var index = 0 as usize
        while index < MAX_FRAMES {
            frames.append(entry)
            index += 1 as usize
        }

        var store = globals
        store.reserve(GLOBALS_SIZE)
        while store.len() < GLOBALS_SIZE {
            store.append(.null)
        }

        let code = closure.function.instructions.raw()
        return VM {
            constants: bytecode.constants,
            stack: reserved(MAX_STACK),
            sp: 0 as usize,
            globals: store,
            frames: frames,
            framesIndex: 1 as usize,
            code: code,
            codeLength: code.len(),
            ip: 0 as usize,
        }
    }

    /// The globals bound so far, for a later machine to continue from.
    public func globalStore(&self) -> List[Object] {
        var copy = List[Object]()
        for value in &self.globals {
            copy.append(value.clone())
        }
        return copy
    }

    /// What the program's last expression evaluated to.
    ///
    /// The slot above the stack pointer still holds what the last `OpPop`
    /// discarded, because popping only moves the pointer.
    public func result(&self) -> Object {
        let stack = &self.stack
        return stack.at(self.sp).clone()
    }

    @inline
    func push(&mut self, _ value: Object) -> Result[(), RuntimeError] {
        if self.sp >= MAX_STACK {
            return .err(.stackOverflow)
        }
        *self.stack.at(self.sp) = value
        self.sp += 1 as usize
        return .ok(())
    }

    /// Takes the top value, leaving it in place above the stack pointer.
    ///
    /// Cannot underflow on bytecode this compiler produced: an instruction that
    /// pops is only emitted after the pushes that feed it.
    @inline
    func pop(&mut self) -> Object {
        if self.sp == 0 as usize {
            return .null
        }
        self.sp -= 1 as usize
        return self.stack.at(self.sp).clone()
    }

    /// Reads the running frame's instructions and position into the machine.
    func enterCurrentFrame(&mut self) {
        let frames = &self.frames
        let frame = *frames.at(self.framesIndex - (1 as usize))
        let code = frame.closure.function.instructions.raw()
        self.code = code
        self.codeLength = code.len()
        self.ip = frame.ip
    }

    /// Records where the running frame had got to, before leaving it.
    func saveCurrentFrame(&mut self) {
        let index = self.framesIndex - (1 as usize)
        var frame = self.frames.at(index)
        frame.ip = self.ip
    }

    /// The slot the running call's locals begin at.
    func currentBase(&self) -> usize {
        let frames = &self.frames
        return frames.at(self.framesIndex - (1 as usize)).base
    }

    /// Runs until the outermost frame is exhausted.
    ///
    /// The opcode is read straight out of the instruction stream and each arm
    /// reads its own operands, which is what the reference implementation does.
    /// Decoding into a typed `Instruction` first would spend a dispatch building
    /// a value the machine takes apart again a line later; `Instruction` is
    /// still how the compiler emits, and how a disassembly is read.
    public func run(&mut self) -> Result[(), RuntimeError] {
        while self.ip < self.codeLength {
            // Read once per step and kept in a local, the way the reference
            // implementation keeps `ins` across its loop.
            let code = self.code
            let byte = *code.at(self.ip)
            self.ip += 1 as usize

            let opcode = match Opcode.fromByte(byte) {
                case .some(found) => found
                case .none => return .err(.unknownOpcode(byte))
            }

            match opcode {
                case .constant => {
                    let index = readUint16(code, at: self.ip)
                    self.ip += 2 as usize
                    let value = self.constants.at(index as usize).clone()
                    self.push(value)!
                }

                case .pop => {
                    let _ = self.pop()
                }

                case .pushTrue => self.push(.boolean(true))!
                case .pushFalse => self.push(.boolean(false))!
                case .pushNull => self.push(.null)!

                case .add => self.arithmetic(Opcode.add)!
                case .subtract => self.arithmetic(Opcode.subtract)!
                case .multiply => self.arithmetic(Opcode.multiply)!
                case .divide => self.arithmetic(Opcode.divide)!

                case .equal => self.comparison(Opcode.equal)!
                case .notEqual => self.comparison(Opcode.notEqual)!
                case .greaterThan => self.comparison(Opcode.greaterThan)!

                case .negate => {
                    let operand = self.pop()
                    match &operand {
                        case .integer(value) => self.push(.integer(-(*value)))!
                        case _ => return .err(.unsupportedNegation(operand.kind()))
                    }
                }

                case .not => {
                    let operand = self.pop()
                    self.push(.boolean(!operand.isTruthy()))!
                }

                case .jump => {
                    let target = readUint16(code, at: self.ip)
                    self.ip = target as usize
                }

                case .jumpNotTruthy => {
                    let target = readUint16(code, at: self.ip)
                    self.ip += 2 as usize
                    let condition = self.pop()
                    if !condition.isTruthy() {
                        self.ip = target as usize
                    }
                }

                case .setGlobal => {
                    let slot = readUint16(code, at: self.ip)
                    self.ip += 2 as usize
                    let value = self.pop()
                    *self.globals.at(slot as usize) = value
                }

                case .getGlobal => {
                    let slot = readUint16(code, at: self.ip)
                    self.ip += 2 as usize
                    let value = self.globals.at(slot as usize).clone()
                    self.push(value)!
                }

                case .setLocal => {
                    let slot = *code.at(self.ip)
                    self.ip += 1 as usize
                    let base = self.currentBase()
                    let value = self.pop()
                    *self.stack.at(base + (slot as usize)) = value
                }

                case .getLocal => {
                    let slot = *code.at(self.ip)
                    self.ip += 1 as usize
                    let base = self.currentBase()
                    let value = self.stack.at(base + (slot as usize)).clone()
                    self.push(value)!
                }

                case .getFree => {
                    let slot = *code.at(self.ip)
                    self.ip += 1 as usize
                    let frames = &self.frames
                    let frame = *frames.at(self.framesIndex - (1 as usize))
                    let captured = &frame.closure.free
                    let value = captured.at(slot as usize).clone()
                    self.push(value)!
                }

                case .getBuiltin => {
                    let slot = *code.at(self.ip)
                    self.ip += 1 as usize
                    match builtinAt(slot as usize) {
                        case .some(builtin) => self.push(.builtin(builtin))!
                        case .none => return .err(.unknownBuiltin(slot))
                    }
                }

                case .currentClosure => {
                    let frames = &self.frames
                    let frame = *frames.at(self.framesIndex - (1 as usize))
                    self.push(.closure(frame.closure))!
                }

                case .array => {
                    let count = readUint16(code, at: self.ip) as usize
                    self.ip += 2 as usize
                    let elements = self.take(count)
                    self.push(.array(boxArray(elements)))!
                }

                case .hash => {
                    let count = readUint16(code, at: self.ip) as usize
                    self.ip += 2 as usize
                    let values = self.take(count)
                    var entries = Dictionary[HashKey, Object]()
                    var position = 0 as usize
                    while position < values.len() {
                        let key = values.at(position)
                        let value = values.at(position + (1 as usize))
                        match key.toHashKey() {
                            case .some(hashKey) => {
                                entries.set(key: hashKey, value: value.clone())
                            }
                            case .none => return .err(.unusableAsHashKey(key.kind()))
                        }
                        position += 2 as usize
                    }
                    self.push(.hash(boxHash(entries)))!
                }

                case .index => {
                    let index = self.pop()
                    let collection = self.pop()
                    let value = self.index(&collection, &index)!
                    self.push(value)!
                }

                case .closure => {
                    let constant = readUint16(code, at: self.ip) as usize
                    let free = *code.at(self.ip + (2 as usize))
                    self.ip += 3 as usize
                    self.buildClosure(constant, free as usize)!
                }

                case .call => {
                    let arguments = *code.at(self.ip)
                    self.ip += 1 as usize
                    self.call(arguments as usize)!
                }

                case .returnValue => {
                    let value = self.pop()
                    self.leaveFrame()
                    self.push(value)!
                }

                case .returnNothing => {
                    self.leaveFrame()
                    self.push(.null)!
                }
            }
        }
        return .ok(())
    }

    /// Removes the top `count` values, keeping their order.
    func take(&mut self, _ count: usize) -> List[Object] {
        var taken = List[Object]()
        if count > self.sp {
            return taken
        }
        taken.reserve(count)
        var position = self.sp - count
        while position < self.sp {
            taken.append(self.stack.at(position).clone())
            position += 1 as usize
        }
        self.sp -= count
        return taken
    }

    func arithmetic(&mut self, _ opcode: Opcode) -> Result[(), RuntimeError] {
        let right = self.pop()
        let left = self.pop()

        match &left {
            case .integer(lhs) => {
                match &right {
                    case .integer(rhs) => {
                        // Matched rather than compared with `==`: comparing two
                        // enums goes through `PartialEq.eq(&self, &other)`, and
                        // a reference to a local handed to it is promoted to
                        // the heap — an allocation per operation, on the
                        // machine's hottest path.
                        let value = match opcode {
                            case .add => *lhs + *rhs
                            case .subtract => *lhs - *rhs
                            case .multiply => *lhs * *rhs
                            case _ => {
                                // Go's `/` panics on a zero divisor, taking the
                                // whole interpreter with it. Reporting it hands
                                // the mistake back to the program.
                                if *rhs == 0 {
                                    return .err(.divisionByZero)
                                }
                                *lhs / *rhs
                            }
                        }
                        return self.push(.integer(value))
                    }
                    case _ => {}
                }
            }
            case .text(lhs) => {
                match &right {
                    case .text(rhs) => {
                        match opcode {
                            case .add => return self.push(.text(*lhs + *rhs))
                            case _ => {}
                        }
                    }
                    case _ => {}
                }
            }
            case _ => {}
        }

        return .err(.unsupportedBinaryOperation(left: left.kind(), right: right.kind()))
    }

    func comparison(&mut self, _ opcode: Opcode) -> Result[(), RuntimeError] {
        let right = self.pop()
        let left = self.pop()

        // Matched rather than compared with `==`, for the reason given in
        // `arithmetic`: `==` on an enum allocates.
        match opcode {
            case .greaterThan => {
                match &left {
                    case .integer(lhs) => {
                        match &right {
                            case .integer(rhs) => return self.push(.boolean(*lhs > *rhs))
                            case _ => {}
                        }
                    }
                    case _ => {}
                }
                return .err(.unsupportedComparison(left: left.kind(), right: right.kind()))
            }
            case _ => {}
        }

        // Equality is defined for every value, so it needs no kind check —
        // unlike the reference implementation, which compares pointers for
        // anything that is not an integer and quietly answers `false`.
        let same = left.equals(&right)
        match opcode {
            case .equal => return self.push(.boolean(same))
            case _ => {}
        }
        return self.push(.boolean(!same))
    }

    func index(
        &self,
        _ collection: &Object,
        _ index: &Object,
    ) -> Result[Object, RuntimeError] {
        match collection {
            case .array(elements) => {
                match index {
                    case .integer(position) => {
                        if *position < 0 {
                            return .ok(.null)
                        }
                        // Out of range yields null rather than failing, as
                        // Monkey specifies.
                        match elements.get(*position as usize) {
                            case .some(found) => return .ok(found.clone())
                            case .none => return .ok(.null)
                        }
                    }
                    case _ => {}
                }
            }
            case .hash(entries) => {
                match index.toHashKey() {
                    case .some(key) => {
                        match entries.get(&key) {
                            case .some(found) => return .ok(found.clone())
                            case .none => return .ok(.null)
                        }
                    }
                    case .none => return .err(.unusableAsHashKey(index.kind()))
                }
            }
            case _ => {}
        }
        return .err(.unsupportedIndex(collection: collection.kind(), index: index.kind()))
    }

    /// Builds a closure over the top `free` values.
    func buildClosure(&mut self, _ constant: usize, _ free: usize) -> Result[(), RuntimeError] {
        let captured = self.take(free)
        let function = match self.constants.at(constant) {
            case .compiledFunction(found) => *found
            case _ => return .err(.notAFunction(self.constants.at(constant).kind()))
        }
        let closure = Closure { function: function, free: captured }
        return self.push(.closure(boxClosure(closure)))
    }

    /// Calls whatever sits below the top `arguments` values.
    func call(&mut self, _ arguments: usize) -> Result[(), RuntimeError] {
        if self.sp < arguments + (1 as usize) {
            return .err(.stackOverflow)
        }
        let calleeSlot = self.sp - arguments - (1 as usize)
        let callee = self.stack.at(calleeSlot).clone()

        match &callee {
            case .closure(closure) => {
                if closure.function.parameterCount != arguments {
                    return .err(.wrongArgumentCount(
                        expected: reportCount(closure.function.parameterCount),
                        found: reportCount(arguments),
                    ))
                }
                if self.framesIndex >= MAX_FRAMES {
                    return .err(.frameOverflow)
                }

                // The arguments already sit where the call's first locals
                // belong, so the frame starts just above the callee and the
                // rest of its slots are reserved by moving the pointer past
                // them — no writing, as the reference implementation does.
                let base = calleeSlot + (1 as usize)
                let reserved = base + closure.function.localCount
                if reserved > MAX_STACK {
                    return .err(.stackOverflow)
                }

                self.saveCurrentFrame()
                *self.frames.at(self.framesIndex) = Frame.new(*closure, base)
                self.framesIndex += 1 as usize
                self.enterCurrentFrame()
                self.sp = reserved
                return .ok(())
            }
            case .builtin(builtin) => {
                let taken = self.take(arguments)
                // The callee itself is still below; it goes with the call.
                self.sp -= 1 as usize
                match callBuiltin(*builtin, taken) {
                    case .ok(value) => return self.push(value)
                    case .err(error) => return .err(.builtin(error))
                }
            }
            case _ => return .err(.notAFunction(callee.kind()))
        }
    }

    /// Discards the finished call's frame, its locals and its callee.
    func leaveFrame(&mut self) {
        if self.framesIndex <= (1 as usize) {
            return
        }
        let base = self.currentBase()
        self.framesIndex -= 1 as usize
        self.enterCurrentFrame()
        // Everything from the callee upwards belonged to the call that ended.
        self.sp = base - (1 as usize)
    }
}

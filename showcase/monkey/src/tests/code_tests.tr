import monkey.code.{Instruction, Instructions, Opcode, decode, encoded, describeInstruction}

/// Every instruction, one of each, with distinguishable operands.
///
/// Written out rather than generated so that adding an opcode without adding it
/// here is visible: the count check below fails.
func everyInstruction() -> List[Instruction] {
    var all = List[Instruction]()
    all.append(.constant(65534))
    all.append(.add)
    all.append(.subtract)
    all.append(.multiply)
    all.append(.divide)
    all.append(.pop)
    all.append(.pushTrue)
    all.append(.pushFalse)
    all.append(.pushNull)
    all.append(.equal)
    all.append(.notEqual)
    all.append(.greaterThan)
    all.append(.negate)
    all.append(.not)
    all.append(.jump(1234))
    all.append(.jumpNotTruthy(5678))
    all.append(.getGlobal(1))
    all.append(.setGlobal(2))
    all.append(.getLocal(3))
    all.append(.setLocal(4))
    all.append(.getFree(5))
    all.append(.getBuiltin(6))
    all.append(.array(7))
    all.append(.hash(8))
    all.append(.index)
    all.append(.call(arguments: 9))
    all.append(.returnValue)
    all.append(.returnNothing)
    all.append(.closure(constant: 65534, free: 255))
    all.append(.currentClosure)
    return all
}

@test
func everyOpcodeIsCovered() {
    // Thirty opcodes, matching the reference implementation. If one is added
    // without a sample here, the round-trip tests below would silently skip it.
    assertEqual(everyInstruction().len(), 30, "one sample per opcode")
}

@test
func encodingRoundTrips() {
    // The property the reference implementation cannot state: whatever is
    // encoded decodes back to exactly the same instruction, operands included.
    for instruction in &everyInstruction() {
        let bytes = encoded(*instruction)
        assertEqual(
            bytes.len(),
            instruction.width(),
            sprintf("%s encodes to the width it declares", describeInstruction(instruction)),
        )

        match decode(&bytes, at: 0) {
            case .ok(back) => {
                assertEqual(
                    describeInstruction(&back.instruction),
                    describeInstruction(instruction),
                    "an instruction survives the round trip",
                )
                assertEqual(back.width, bytes.len(), "the decoded width covers the encoding")
            }
            case .err(error) => {
                fail(sprintf("could not decode: %s", error.describe()))
            }
        }
    }
}

@test
func opcodeBytesAreStable() {
    // The byte values are the reference implementation's, so bytecode produced
    // here is the same bytecode the book produces.
    assertEqual(Opcode.constant.toByte(), 0, "OpConstant is 0")
    assertEqual(Opcode.add.toByte(), 1, "OpAdd is 1")
    assertEqual(Opcode.pop.toByte(), 2, "OpPop is 2")
    assertEqual(Opcode.closure.toByte(), 27, "OpClosure is 27")
    assertEqual(Opcode.currentClosure.toByte(), 29, "OpCurrentClosure is 29")
}

@test
func everyOpcodeByteMapsBack() {
    for instruction in &everyInstruction() {
        let opcode = instruction.opcode()
        match Opcode.fromByte(opcode.toByte()) {
            case .some(back) => {
                assertTrue(back == opcode, sprintf("%s maps back from its byte", opcode.name()))
            }
            case .none => fail(sprintf("%s has no byte mapping", opcode.name()))
        }
    }
}

@test
func unassignedBytesAreRejected() {
    // Thirty opcodes are defined, so 30 and up name nothing.
    match Opcode.fromByte(30) {
        case .some(_) => fail("byte 30 should name no opcode")
        case .none => {}
    }
    match Opcode.fromByte(255) {
        case .some(_) => fail("byte 255 should name no opcode")
        case .none => {}
    }
}

@test
func operandsAreBigEndian() {
    // The layout matches the reference implementation byte for byte.
    let bytes = encoded(.constant(65534))
    assertEqual(bytes.len(), 3, "an opcode and two operand bytes")
    assertEqual(*bytes.at(0), 0, "OpConstant")
    assertEqual(*bytes.at(1), 255, "high byte first")
    assertEqual(*bytes.at(2), 254, "then the low byte")

    let wide = encoded(.closure(constant: 65534, free: 255))
    assertEqual(wide.len(), 4, "two operands of different widths")
    assertEqual(*wide.at(1), 255, "the wide operand leads")
    assertEqual(*wide.at(3), 255, "the narrow one follows")
}

@test
func truncatedStreamsAreReported() {
    // An operand that runs off the end is refused rather than read past.
    var partial = List[uint8]()
    partial.append(Opcode.constant.toByte())
    partial.append(1)
    match decode(&partial, at: 0) {
        case .ok(_) => fail("a half-written operand should not decode")
        case .err(error) => {
            assertEqual(
                error.describe(),
                "instruction OpConstant at offset 0 is missing operand bytes",
                "the failure names the instruction",
            )
        }
    }

    var unknown = List[uint8]()
    unknown.append(200)
    match decode(&unknown, at: 0) {
        case .ok(_) => fail("an unassigned byte should not decode")
        case .err(error) => {
            assertEqual(
                error.describe(),
                "unknown opcode 200 at offset 0",
                "the failure names the byte",
            )
        }
    }
}

@test
func disassemblyReadsBack() {
    var stream = Instructions.new()
    stream.emit(.add)
    stream.emit(.getLocal(1))
    stream.emit(.constant(2))
    stream.emit(.constant(65535))
    stream.emit(.closure(constant: 65535, free: 255))

    // Offsets are byte offsets, so they advance by each instruction's width.
    let expected = "0000 OpAdd\n"
        + "0001 OpGetLocal 1\n"
        + "0003 OpConstant 2\n"
        + "0006 OpConstant 65535\n"
        + "0009 OpClosure 65535 255\n"
    assertEqual(stream.disassemble(), expected, "disassembly matches the book's format")
}

@test
func emitAnswersTheOffset() {
    var stream = Instructions.new()
    assertEqual(stream.emit(.add), 0, "the first instruction starts at zero")
    assertEqual(stream.emit(.constant(0)), 1, "the next follows OpAdd's single byte")
    assertEqual(stream.emit(.pop), 4, "and follows OpConstant's three")
    assertEqual(stream.len(), 5, "five bytes in total")
}

@test
func jumpsArePatchedInPlace() {
    var stream = Instructions.new()
    stream.emit(.pushTrue)
    // A jump is emitted before its destination is known.
    let placeholder = stream.emit(.jumpNotTruthy(9999))
    stream.emit(.pop)

    assertTrue(stream.patchJump(at: placeholder, to: 42), "the offset names a jump")
    match stream.decodeAt(placeholder) {
        case .ok(decoded) => {
            assertEqual(
                describeInstruction(&decoded.instruction),
                "OpJumpNotTruthy 42",
                "the destination was rewritten",
            )
        }
        case .err(_) => fail("the patched instruction should decode")
    }
    assertEqual(stream.len(), 5, "patching does not change the width")
}

@test
func onlyJumpsArePatched() {
    // The reference implementation's `changeOperand` would happily overwrite
    // this; restricting patching to jumps refuses it instead.
    var stream = Instructions.new()
    let offset = stream.emit(.constant(1))
    assertTrue(!stream.patchJump(at: offset, to: 2), "a constant is not a jump")
    match stream.decodeAt(offset) {
        case .ok(decoded) => {
            assertEqual(
                describeInstruction(&decoded.instruction),
                "OpConstant 1",
                "the refused patch left the instruction alone",
            )
        }
        case .err(_) => fail("the instruction should still decode")
    }
}

@test
func truncateTakesBackAnInstruction() {
    var stream = Instructions.new()
    stream.emit(.constant(1))
    let beforePop = stream.len()
    stream.emit(.pop)
    assertEqual(stream.len(), beforePop + 1, "OpPop is one byte")

    stream.truncate(to: beforePop)
    assertEqual(stream.len(), beforePop, "the stream is back where it was")
    assertEqual(stream.disassemble(), "0000 OpConstant 1\n", "and holds whole instructions")
}

/// A shared scope. Functions retain a reference so later bindings and recursive
/// closure cycles remain visible; the collector reclaims unreachable cycles.
public struct Environment {
    store: Dictionary[string, Object]
    outer: Optional[&Environment]
}

extend Environment {
    public static func new() -> &Self {
        scope := Self { store: Dictionary[string, Object]::new(), outer: .none }
        return &scope
    }

    public static func enclosedBy(_ outer: &Environment) -> &Self {
        scope := Self { store: Dictionary[string, Object]::new(), outer: .some(outer) }
        return &scope
    }
}

extend &Environment {
    /// Binds `name` here, shadowing any outer binding.
    public func define(_ name: string, _ value: Object) {
        self.store.set(key: name, value: value)
    }

    public func lookup(_ name: string) -> Optional[Object] {
        match self.store.get(&name) {
            case .some(found) => return .some(found)
            case .none => {}
        }
        match self.outer {
            case .some(outer) => return outer.lookup(name)
            case .none => return .none
        }
    }
}

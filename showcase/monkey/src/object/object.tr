import monkey::ast::{Statement, renderStatement}
import monkey::code::Instructions
import std::hash::{Hashable, Hasher}

/// The kind of a value, without its payload.
///
/// Error messages name types, and naming them from a closed set means a new
/// object kind cannot be described as `""` by an overlooked branch. The spellings
/// match Monkey's, so diagnostics read the same as the reference implementation.
public enum ObjectKind: PartialEq {
    case null
    case integer
    case boolean
    case text
    case array
    case hash
    case function
    case builtin
    /// A function the bytecode compiler produced. The tree-walking evaluator
    /// never makes one, but both engines share this type.
    case compiledFunction
    case closure
}

extend ObjectKind {
    public func describe() -> string {
        match self {
            case .null => "NULL"
            case .integer => "INTEGER"
            case .boolean => "BOOLEAN"
            case .text => "STRING"
            case .array => "ARRAY"
            case .hash => "HASH"
            case .function => "FUNCTION"
            case .builtin => "BUILTIN"
            case .compiledFunction => "COMPILED_FUNCTION"
            case .closure => "CLOSURE"
        }
    }
}

/// A value usable as a hash key.
///
/// Monkey admits integers, booleans and strings as keys. The reference
/// implementation reduces each to a 64-bit hash and keys the map on that, so two
/// distinct strings that happen to collide silently become the same key. Carrying
/// the value itself and letting `Dictionary` compare keys on collision removes
/// that failure entirely.
public enum HashKey {
    case integer(int64)
    case boolean(bool)
    case text(string)
}

extend HashKey {
    public func kind() -> ObjectKind {
        match self {
            case .integer(_) => .integer
            case .boolean(_) => .boolean
            case .text(_) => .text
        }
    }

    /// The key as the value it was made from.
    ///
    /// Because the payload is kept rather than hashed away, rendering a hash
    /// does not need the reference implementation's parallel `HashPair` table
    /// holding the original keys.
    public func toObject() -> Object {
        match self {
            case .integer(value) => .integer(value)
            case .boolean(value) => .boolean(value)
            case .text(value) => .text(value)
        }
    }
}

conform HashKey to PartialEq {
    public func eq(_ other: HashKey) -> bool {
        match self {
            case .integer(lhs) => {
                match other {
                    case .integer(rhs) => lhs == rhs
                    case _ => false
                }
            }
            case .boolean(lhs) => {
                match other {
                    case .boolean(rhs) => lhs == rhs
                    case _ => false
                }
            }
            case .text(lhs) => {
                match other {
                    case .text(rhs) => lhs == rhs
                    case _ => false
                }
            }
        }
    }
}

conform HashKey to Hashable {
    public func hash[H: Hasher]( into hasher: H) {
        // The kind is mixed in first so `1` and `true` cannot collide.
        //
        // `combine` takes one generic argument, so the cast is the only thing
        // naming the tag's width — an uncast literal would default to `int` and
        // mix eight bytes instead of one. Unlike everywhere else in this
        // package, these casts are load-bearing and must stay.
        match self {
            case .integer(value) => {
                hasher.combine(0 as uint8)
                hasher.combine(value)
            }
            case .boolean(value) => {
                hasher.combine(1 as uint8)
                hasher.combine(value)
            }
            case .text(value) => {
                hasher.combine(2 as uint8)
                value.hash(into: hasher)
            }
        }
    }
}

/// A user-defined function together with the environment it closed over.
///
/// The environment is held by reference, so a binding added after the literal is
/// evaluated is still visible from the body. That is what makes `let f = fn(n) {
/// f(n - 1) }` able to find `f`.
/// Parameter and body lists share the parsed syntax; closure creation needs no
/// recursive copy.
public struct Function {
    public parameters: List[string]
    public body: List[Statement]
    public env: &Environment
}

/// A function the compiler has turned into instructions.
///
/// The parameters are gone by this point — they are slots, and `localCount`
/// counts them along with everything else the body binds, which is how large a
/// frame the call needs.
public struct CompiledFunction {
    public instructions: Instructions
    public localCount: usize
    public parameterCount: usize
}

/// A compiled function together with the values it captured.
///
/// Every compiled function the machine calls is one of these, even one that
/// captures nothing, matching the Go reference's closure call path.
public struct Closure {
    public function: &CompiledFunction
    public free: List[Object]
}

/// A value.
///
/// Scalars copy directly. References give arrays, hashes and functions shared
/// identity, matching Monkey. `push` constructs an independent array; ordinary
/// assignment and argument passing share the original aggregate.
public enum Object {
    case null
    case integer(int64)
    case boolean(bool)
    case text(string)
    case array(&List[Object])
    case hash(&Dictionary[HashKey, Object])
    case function(&Function)
    case builtin(Builtin)
    case compiledFunction(&CompiledFunction)
    case closure(&Closure)
}

/// Reference identity is distinct from structural equality. References keep
/// these nonmoving GC objects alive; comparing their addresses never reads raw memory.
func sameReference[T](_ left: &T, _ right: &T) -> bool {
    return unsafe { ((left as *const T) as usize) == ((right as *const T) as usize) }
}

extend Object {
    public func kind() -> ObjectKind {
        match self {
            case .null => .null
            case .integer(_) => .integer
            case .boolean(_) => .boolean
            case .text(_) => .text
            case .array(_) => .array
            case .hash(_) => .hash
            case .function(_) => .function
            case .builtin(_) => .builtin
            case .compiledFunction(_) => .compiledFunction
            case .closure(_) => .closure
        }
    }

    /// Monkey's truthiness: only `false` and `null` are falsey. Every integer,
    /// including `0`, is truthy.
    public func isTruthy() -> bool {
        match self {
            case .null => false
            case .boolean(value) => value
            case _ => true
        }
    }

    /// The value as a hash key, when its kind admits one.
    public func toHashKey() -> Optional[HashKey] {
        match self {
            case .integer(value) => .some(.integer(value))
            case .boolean(value) => .some(.boolean(value))
            case .text(value) => .some(.text(value))
            case _ => .none
        }
    }

    /// Whether two values are the same, as Monkey's `==` asks.
    ///
    /// Scalars compare by value. Aggregates and functions compare by identity,
    /// matching the reference implementation's pointer comparison: aliases are
    /// equal, while independently created objects remain distinct.
    public func equals(_ other: Object) -> bool {
        match self {
            case .null => {
                match other {
                    case .null => return true
                    case _ => return false
                }
            }
            case .integer(lhs) => {
                match other {
                    case .integer(rhs) => return lhs == rhs
                    case _ => return false
                }
            }
            case .boolean(lhs) => {
                match other {
                    case .boolean(rhs) => return lhs == rhs
                    case _ => return false
                }
            }
            case .text(lhs) => {
                match other {
                    case .text(rhs) => return lhs == rhs
                    case _ => return false
                }
            }
            case .builtin(lhs) => {
                match other {
                    case .builtin(rhs) => return lhs == rhs
                    case _ => return false
                }
            }
            case .array(lhs) => {
                match other {
                    case .array(rhs) => return sameReference(lhs, rhs)
                    case _ => return false
                }
            }
            case .hash(lhs) => {
                match other {
                    case .hash(rhs) => return sameReference(lhs, rhs)
                    case _ => return false
                }
            }
            case .function(lhs) => {
                match other {
                    case .function(rhs) => return sameReference(lhs, rhs)
                    case _ => return false
                }
            }
            case .compiledFunction(lhs) => {
                match other {
                    case .compiledFunction(rhs) => return sameReference(lhs, rhs)
                    case _ => return false
                }
            }
            case .closure(lhs) => {
                match other {
                    case .closure(rhs) => return sameReference(lhs, rhs)
                    case _ => return false
                }
            }
        }
    }

    /// How the value prints, as `puts` and the REPL show it.
    public func inspect() -> string {
        match self {
            case .null => return "null"
            case .integer(value) => return sprintf("%v", value)
            case .boolean(value) => {
                if value { return "true" }
                return "false"
            }
            case .text(value) => return value
            case .array(elements) => {
                var out = ""
                var first = true
                for element in *elements {
                    if !first { out = out + ", " }
                    out = out + element.inspect()
                    first = false
                }
                return "[" + out + "]"
            }
            case .hash(entries) => {
                var out = ""
                var first = true
                for entry in *entries {
                    if !first { out = out + ", " }
                    out = out + entry.0.toObject().inspect() + ": " + entry.1.inspect()
                    first = false
                }
                return "{" + out + "}"
            }
            case .function(function) => {
                var names = ""
                var first = true
                for name in function.parameters {
                    if !first { names = names + ", " }
                    names = names + name
                    first = false
                }
                var body = ""
                for statement in function.body {
                    body = body + renderStatement(statement)
                }
                return "fn(" + names + ") {\n" + body + "\n}"
            }
            case .builtin(builtin) => return sprintf("builtin function %s", builtin.name())
            case .compiledFunction(function) => {
                return sprintf("compiled function[%v locals]", function.localCount)
            }
            case .closure(closure) => {
                return sprintf("closure[%v free]", closure.free.len())
            }
        }
    }
}

import monkey.ast.{Program, renderProgram, endsWithBinding}
import monkey.compiler.{Compiler, SymbolTable, boxSymbolTable}
import monkey.eval.Evaluator
import monkey.lexer.Lexer
import monkey.object.{Object, Environment, boxEnvironment}
import monkey.parser.{Parser, ParseError}
import monkey.token.TokenTag
import monkey.vm.VM

const PROMPT: string = ">> "

/// Which engine runs the source.
///
/// Both are kept, and both are complete. The tree-walking evaluator is the
/// first book's; the stack machine is this one's. Being able to switch between
/// them on the same session is what makes it possible to check that they agree.
public enum Engine: Copy, PartialEq {
    /// Walks the syntax tree, evaluating as it goes.
    case tree
    /// Compiles to bytecode and runs it on the stack machine.
    case bytecode
}

impl Engine {
    public func describe(&self) -> string {
        match self {
            case .tree => "tree-walking evaluator"
            case .bytecode => "bytecode machine"
        }
    }
}

/// What the user typed, once it has been classified.
enum Input {
    /// A directive to the REPL rather than a Monkey expression.
    case command(name: string, argument: string)
    /// Monkey source to evaluate.
    case source(string)
    /// Nothing to do.
    case blank
}

/// A read-eval-print session.
///
/// State outlives each line so bindings persist: the evaluator keeps an
/// environment, and the machine keeps a symbol table, a constant pool and a set
/// of globals. Each line is compiled on its own but numbered as though it were a
/// continuation of the ones before, which is what lets a name bound on one line
/// resolve on the next.
public struct Repl {
    engine: Engine
    env: &mut Environment
    evaluator: Evaluator
    symbols: &mut SymbolTable
    constants: List[Object]
    globals: List[Object]
    /// Prints the parse tree alongside the value, for seeing how input grouped.
    showTree: bool
    /// Prints the instructions a line compiled to.
    showBytecode: bool
}

impl Repl {
    public func new() -> Self {
        return Repl.using(Engine.bytecode)
    }

    public func using(_ engine: Engine) -> Self {
        return Repl {
            engine: engine,
            env: boxEnvironment(Environment.new()),
            evaluator: Evaluator(),
            symbols: freshSymbolTable(),
            constants: List[Object](),
            globals: List[Object](),
            showTree: false,
            showBytecode: false,
        }
    }

    /// Reads, evaluates and prints until the input ends or the user quits.
    public func run(&mut self) {
        print(GREETING)
        printf("Running on the %s. Type :engine to switch.\n", self.engine.describe())

        var reader = std.io.BufReader(std.io.stdin())
        loop {
            print(PROMPT)

            let line = match reader.readLine() {
                case .ok(read) => {
                    match read {
                        // End of input: a piped script ran out, or the user
                        // pressed Ctrl-D.
                        case .none => break
                        case .some(text) => text
                    }
                }
                case .err(error) => {
                    printf("cannot read input: %v\n", error)
                    break
                }
            }

            match classify(line) {
                case .blank => {}
                case .command(name, argument) => {
                    if !self.runCommand(name, argument) {
                        break
                    }
                }
                case .source(text) => self.evaluate(text)
            }
        }

        print("\n")
    }

    /// Runs a REPL directive, answering whether the session continues.
    func runCommand(&mut self, _ name: string, _ argument: string) -> bool {
        if name == "help" {
            print(HELP)
            return true
        }
        if name == "engine" {
            self.switchEngine(argument)
            return true
        }
        if name == "tree" {
            self.showTree = !self.showTree
            if self.showTree {
                print("showing the parse tree\n")
            } else {
                print("hiding the parse tree\n")
            }
            return true
        }
        if name == "bytecode" {
            self.showBytecode = !self.showBytecode
            if self.showBytecode {
                print("showing compiled instructions\n")
            } else {
                print("hiding compiled instructions\n")
            }
            return true
        }
        if name == "tokens" {
            printTokens(argument)
            return true
        }
        if name == "reset" {
            self.env = boxEnvironment(Environment.new())
            self.symbols = freshSymbolTable()
            self.constants = List[Object]()
            self.globals = List[Object]()
            print("every binding forgotten\n")
            return true
        }
        if name == "quit" || name == "exit" {
            return false
        }

        printf("unknown command :%s — try :help\n", name)
        return true
    }

    func switchEngine(&mut self, _ argument: string) {
        if argument == "vm" || argument == "bytecode" {
            self.engine = .bytecode
        } else if argument == "eval" || argument == "tree" {
            self.engine = .tree
        } else if argument.isEmpty() {
            // With no argument, switching is the useful thing to do.
            match self.engine {
                case .tree => self.engine = .bytecode
                case .bytecode => self.engine = .tree
            }
        } else {
            printf("unknown engine %s — try :engine vm or :engine eval\n", argument)
            return
        }
        // Bindings live in whichever engine made them, so the two do not share
        // them. Saying so is better than letting a name quietly vanish.
        printf("now running on the %s (bindings are per engine)\n", self.engine.describe())
    }

    /// Parses one line and runs it on the current engine.
    func evaluate(&mut self, _ source: string) {
        var parser = Parser(Lexer(source))
        let program = match parser.parseProgram() {
            case .ok(parsed) => parsed
            case .err(errors) => {
                printParseErrors(source, &errors)
                return
            }
        }

        if self.showTree {
            printf("tree: %s\n", renderProgram(&program))
        }

        match self.engine {
            case .tree => self.evaluateWalking(&program)
            case .bytecode => self.evaluateCompiled(&program)
        }
    }

    func evaluateWalking(&mut self, _ program: &Program) {
        match self.evaluator.run(program, self.env) {
            case .ok(value) => self.echo(program, value)
            case .err(error) => printf("error: %s\n", error.describe())
        }
    }

    func evaluateCompiled(&mut self, _ program: &Program) {
        var compiler = Compiler.withState(self.symbols, cloneObjects(&self.constants))
        match compiler.compile(program) {
            case .ok(_) => {}
            case .err(error) => {
                printf("compile error: %s\n", error.describe())
                return
            }
        }

        let bytecode = compiler.bytecode()
        if self.showBytecode {
            print(bytecode.instructions.disassemble())
        }
        self.constants = cloneObjects(&bytecode.constants)

        var machine = VM.withGlobals(bytecode, cloneObjects(&self.globals))
        match machine.run() {
            case .ok(_) => {
                self.globals = machine.globalStore()
                self.echo(program, machine.result())
            }
            case .err(error) => {
                // The globals a failed line did bind still stand, the same way
                // the evaluator leaves an environment it partly updated.
                self.globals = machine.globalStore()
                printf("error: %s\n", error.describe())
            }
        }
    }

    /// Prints a result, unless the line was a binding.
    ///
    /// A binding yields nothing to echo. Everything else yields a value, and
    /// `null` is one — hiding it would make `puts()` and a conditional with no
    /// match look like they did nothing at all.
    func echo(&self, _ program: &Program, _ value: Object) {
        if !endsWithBinding(program) {
            printf("%s\n", value.inspect())
        }
    }
}

/// A symbol table with the builtins already bound, as the compiler expects.
func freshSymbolTable() -> &mut SymbolTable {
    var compiler = Compiler.new()
    return compiler.symbolTable()
}

func cloneObjects(_ values: &List[Object]) -> List[Object] {
    var copy = List[Object]()
    for value in values {
        copy.append(value.clone())
    }
    return copy
}

/// Decides what a line of input means.
func classify(_ line: string) -> Input {
    let trimmed = line.trim()
    if trimmed.isEmpty() {
        return .blank
    }
    if !trimmed.startsWith(":") {
        return .source(trimmed)
    }

    // `substring` takes a count, not an end index.
    let body = trimmed.substring(1, trimmed.byteLen() - 1)
    match body.find(" ") {
        case .some(space) => {
            let name = body.substring(0, space)
            let rest = space + 1
            let argument = body.substring(rest, body.byteLen() - rest).trim()
            return .command(name: name, argument: argument)
        }
        case .none => return .command(name: body, argument: "")
    }
}

/// Reports parse failures with the offending column marked.
///
/// The reference implementation prints a list of messages and an ASCII monkey.
/// The messages here carry a position, so the line itself can be shown with the
/// problem pointed at directly.
func printParseErrors(_ source: string, _ errors: &List[ParseError]) {
    for error in errors {
        printf("  %s\n", error.message)
        // Only single-line input reaches the REPL, so the caret lines up
        // whenever the position is within the text.
        if error.position.line == 1 && error.position.column <= source.byteLen() {
            printf("    %s\n", source)
            var caret = ""
            var column: usize = 1
            while column < error.position.column {
                caret = caret + " "
                column += 1
            }
            printf("    %s^\n", caret)
        }
    }
}

/// Prints the token stream for a source, which the book's REPL does first.
func printTokens(_ source: string) {
    if source.isEmpty() {
        print("usage: :tokens <source>\n")
        return
    }

    var lexer = Lexer(source)
    loop {
        let token = lexer.nextToken()
        if token.kind.tag() == TokenTag.eof {
            break
        }
        printf(
            "  %v:%v %s\n",
            token.position.line,
            token.position.column,
            token.kind.describe(),
        )
    }
}

const GREETING: string = "Monkey, in Taro.\nType :help for commands, :quit to leave.\n"

const HELP: string = "  :help           show this message\n  :engine [name]  switch engine, or name one: vm, eval\n  :bytecode       toggle printing compiled instructions\n  :tokens <src>   print the token stream for <src>\n  :tree           toggle printing the parse tree\n  :reset          forget every binding\n  :quit           leave\n"

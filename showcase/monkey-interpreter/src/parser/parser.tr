import monkey.ast.{Expression, Statement, Program, HashEntry, PrefixOperator, InfixOperator}
import monkey.lexer.Lexer
import monkey.token.{Token, TokenKind, TokenTag, Position}

/// Binding power, lowest to highest.
public enum Precedence: std.marker.Copy {
    case lowest
    case equals
    case comparison
    case sum
    case product
    case prefix
    case call
    case index
}

impl Precedence {
    func rank(&self) -> int32 {
        match self {
            case .lowest => 0
            case .equals => 1
            case .comparison => 2
            case .sum => 3
            case .product => 4
            case .prefix => 5
            case .call => 6
            case .index => 7
        }
    }

    func isLowerThan(&self, _ other: Precedence) -> bool {
        return self.rank() < other.rank()
    }
}

/// A parse failure, reported with the position of the offending token.
public struct ParseError {
    public message: string
    public position: Position
}

/// Moves a subexpression to managed storage so it can be referenced from an
/// enclosing node. Taro promotes a referenced local when the reference escapes,
/// which is what lets the tree outlive the call that built it.
func box(_ expression: Expression) -> &Expression {
    let boxed = expression
    return &boxed
}

/// Binding power of the operator a token introduces when used infix.
func infixPrecedence(_ kind: &TokenKind) -> Precedence {
    match kind {
        case .equal => .equals
        case .notEqual => .equals
        case .lessThan => .comparison
        case .greaterThan => .comparison
        case .plus => .sum
        case .minus => .sum
        case .slash => .product
        case .asterisk => .product
        case .leftParen => .call
        case .leftBracket => .index
        case _ => .lowest
    }
}

/// The infix operator a token denotes, when it denotes one.
func infixOperator(_ kind: &TokenKind) -> Optional[InfixOperator] {
    match kind {
        case .plus => .some(.add)
        case .minus => .some(.subtract)
        case .asterisk => .some(.multiply)
        case .slash => .some(.divide)
        case .lessThan => .some(.lessThan)
        case .greaterThan => .some(.greaterThan)
        case .equal => .some(.equal)
        case .notEqual => .some(.notEqual)
        case _ => .none
    }
}


/// A Pratt parser for Monkey.
///
/// The Go original registers prefix and infix parse functions in two maps keyed
/// by token type. Matching on the token kind directly keeps dispatch exhaustive:
/// a token that gains a new meaning cannot silently fall through to "no prefix
/// parse function found".
/// Deepest expression nesting the parser will descend into.
///
/// Recursive descent costs several stack frames per level, and an `Expression`
/// temporary is wide, so unbounded nesting exhausts the stack. The runtime does
/// not report stack exhaustion — the process simply dies — so the limit is
/// enforced here, well below where that happens, and reported as an ordinary
/// parse error.
const MAX_NESTING_DEPTH: usize = 256

public struct Parser {
    lexer: Lexer
    current: Token
    peek: Token
    errors: List[ParseError]
    depth: usize
}

impl Parser {
    public func new(_ lexer: Lexer) -> Self {
        var source = lexer
        let first = source.nextToken()
        let second = source.nextToken()
        return Parser {
            lexer: source,
            current: first,
            peek: second,
            errors: List[ParseError](),
            depth: 0 as usize,
        }
    }

    func advance(&mut self) {
        self.current = self.peek
        self.peek = self.lexer.nextToken()
    }

    func report(&mut self, _ message: string, _ position: Position) {
        self.errors.append(ParseError { message, position })
    }

    func currentIs(&self, _ tag: TokenTag) -> bool {
        return self.current.kind.tag() == tag
    }

    func peekIs(&self, _ tag: TokenTag) -> bool {
        return self.peek.kind.tag() == tag
    }

    /// Advances past `tag`, reporting when the next token is something else.
    func expect(&mut self, _ tag: TokenTag) -> bool {
        if self.peekIs(tag) {
            self.advance()
            return true
        }
        let message = std.sprintf(
            "expected %s, found %s",
            tag.describe(),
            self.peek.kind.describe(),
        )
        let position = self.peek.position
        self.report(message, position)
        return false
    }

    public func parseProgram(&mut self) -> Result[Program, List[ParseError]] {
        var statements = List[Statement]()

        while !self.currentIs(TokenTag.eof) {
            match self.parseStatement() {
                case .some(statement) => statements.append(statement)
                case .none => {}
            }
            self.advance()
        }

        if !self.errors.isEmpty() {
            var reported = List[ParseError]()
            for error in &self.errors {
                reported.append(ParseError { message: error.message, position: error.position })
            }
            return .err(reported)
        }
        return .ok(Program { statements })
    }

    func parseStatement(&mut self) -> Optional[Statement] {
        match self.current.kind {
            case .`let` => return self.parseBind()
            case .`return` => return self.parseProduce()
            case _ => return self.parseExpressionStatement()
        }
    }

    func parseBind(&mut self) -> Optional[Statement] {
        let namePosition = self.peek.position
        var name = ""
        match self.peek.kind {
            case .identifier(text) => name = text
            case _ => {
                let found = self.peek.kind.describe()
                self.report(std.sprintf("expected identifier after 'let', found %s", found), namePosition)
                return .none
            }
        }
        self.advance()

        if !self.expect(.assign) {
            return .none
        }
        self.advance()

        let value = self.parseExpression(.lowest)!
        if self.peekIs(TokenTag.semicolon) {
            self.advance()
        }
        return .some(.bind(name: name, value: value))
    }

    func parseProduce(&mut self) -> Optional[Statement] {
        self.advance()
        let value = self.parseExpression(.lowest)!
        if self.peekIs(TokenTag.semicolon) {
            self.advance()
        }
        return .some(.produce(value: value))
    }

    func parseExpressionStatement(&mut self) -> Optional[Statement] {
        let value = self.parseExpression(.lowest)!
        if self.peekIs(TokenTag.semicolon) {
            self.advance()
        }
        return .some(.expression(value: value))
    }

    /// Pratt loop: parse a prefix form, then absorb infix operators while they
    /// bind more tightly than the caller's precedence.
    func parseExpression(&mut self, _ precedence: Precedence) -> Optional[Expression] {
        if self.depth >= MAX_NESTING_DEPTH {
            let position = self.current.position
            self.report("expression nesting is too deep", position)
            return .none
        }
        self.depth += 1 as usize
        let parsed = self.parseNested(precedence)
        self.depth -= 1 as usize
        return parsed
    }

    func parseNested(&mut self, _ precedence: Precedence) -> Optional[Expression] {
        var left = self.parsePrefix()!

        while !self.peekIs(TokenTag.semicolon) && precedence.isLowerThan(infixPrecedence(&self.peek.kind)) {
            let canContinue = match self.peek.kind {
                case .leftParen => true
                case .leftBracket => true
                case _ => {
                    match infixOperator(&self.peek.kind) {
                        case .some(_) => true
                        case .none => false
                    }
                }
            }
            if !canContinue {
                return .some(left)
            }
            self.advance()
            left = self.parseInfix(left)!
        }

        return .some(left)
    }

    func parsePrefix(&mut self) -> Optional[Expression] {
        match self.current.kind {
            case .identifier(name) => return .some(.identifier(name))
            case .integer(value) => return .some(.integer(value))
            case .text(value) => return .some(.text(value))
            case .`true` => return .some(.boolean(true))
            case .`false` => return .some(.boolean(false))
            case .bang => return self.parseUnary(.not)
            case .minus => return self.parseUnary(.negate)
            case .leftParen => return self.parseGrouped()
            case .`if` => return self.parseConditional()
            case .function => return self.parseFunction()
            case .leftBracket => return self.parseArray()
            case .leftBrace => return self.parseHash()
            case _ => {
                let found = self.current.kind.describe()
                let position = self.current.position
                self.report(std.sprintf("expected an expression, found %s", found), position)
                return .none
            }
        }
    }

    func parseUnary(&mut self, _ op: PrefixOperator) -> Optional[Expression] {
        self.advance()
        let operand = self.parseExpression(.prefix)!
        return .some(.prefix(op: op, operand: box(operand)))
    }

    func parseGrouped(&mut self) -> Optional[Expression] {
        self.advance()
        let inner = self.parseExpression(.lowest)!
        if !self.expect(.rightParen) {
            return .none
        }
        return .some(inner)
    }

    func parseInfix(&mut self, _ left: Expression) -> Optional[Expression] {
        match self.current.kind {
            case .leftParen => return self.parseCall(left)
            case .leftBracket => return self.parseIndex(left)
            case _ => {}
        }

        let op = match infixOperator(&self.current.kind) {
            case .some(found) => found
            case .none => {
                let found = self.current.kind.describe()
                let position = self.current.position
                self.report(std.sprintf("expected an operator, found %s", found), position)
                return .none
            }
        }

        let precedence = infixPrecedence(&self.current.kind)
        self.advance()
        let right = self.parseExpression(precedence)!
        return .some(.infix(left: box(left), op: op, right: box(right)))
    }

    func parseCall(&mut self, _ callee: Expression) -> Optional[Expression] {
        let arguments = self.parseExpressionList(.rightParen)!
        return .some(.call(callee: box(callee), arguments: arguments))
    }

    func parseIndex(&mut self, _ collection: Expression) -> Optional[Expression] {
        self.advance()
        let index = self.parseExpression(.lowest)!
        if !self.expect(.rightBracket) {
            return .none
        }
        return .some(.index(collection: box(collection), index: box(index)))
    }

    func parseArray(&mut self) -> Optional[Expression] {
        let elements = self.parseExpressionList(.rightBracket)!
        return .some(.array(elements: elements))
    }

    /// Parses a comma-separated list, assuming `self.current` is the opening
    /// delimiter, and stops after consuming `closing`.
    func parseExpressionList(&mut self, _ closing: TokenTag) -> Optional[List[Expression]] {
        var items = List[Expression]()

        if self.peekIs(closing) {
            self.advance()
            return .some(items)
        }

        self.advance()
        let first = self.parseExpression(.lowest)!
        items.append(first)

        while self.peekIs(TokenTag.comma) {
            self.advance()
            self.advance()
            let next = self.parseExpression(.lowest)!
            items.append(next)
        }

        if !self.expect(closing) {
            return .none
        }
        return .some(items)
    }

    func parseHash(&mut self) -> Optional[Expression] {
        var entries = List[HashEntry]()

        while !self.peekIs(TokenTag.rightBrace) {
            self.advance()
            let key = self.parseExpression(.lowest)!
            if !self.expect(.colon) {
                return .none
            }
            self.advance()
            let value = self.parseExpression(.lowest)!
            entries.append(HashEntry { key, value })

            if !self.peekIs(TokenTag.rightBrace) && !self.expect(.comma) {
                return .none
            }
        }

        if !self.expect(.rightBrace) {
            return .none
        }
        return .some(.hash(entries: entries))
    }

    func parseBlock(&mut self) -> Optional[List[Statement]] {
        var statements = List[Statement]()
        self.advance()

        while !self.currentIs(TokenTag.rightBrace) && !self.currentIs(TokenTag.eof) {
            match self.parseStatement() {
                case .some(statement) => statements.append(statement)
                case .none => return .none
            }
            self.advance()
        }

        if !self.currentIs(TokenTag.rightBrace) {
            let position = self.current.position
            self.report("expected '}' to close block", position)
            return .none
        }
        return .some(statements)
    }

    func parseConditional(&mut self) -> Optional[Expression] {
        if !self.expect(.leftParen) {
            return .none
        }
        self.advance()
        let condition = self.parseExpression(.lowest)!
        if !self.expect(.rightParen) {
            return .none
        }
        if !self.expect(.leftBrace) {
            return .none
        }
        let consequence = self.parseBlock()!

        var alternative = List[Statement]()
        var hasAlternative = false
        if self.peekIs(TokenTag.branchElse) {
            self.advance()
            if !self.expect(.leftBrace) {
                return .none
            }
            alternative = self.parseBlock()!
            hasAlternative = true
        }

        return .some(.conditional(
            condition: box(condition),
            consequence: consequence,
            alternative: alternative,
            hasAlternative: hasAlternative,
        ))
    }

    func parseFunction(&mut self) -> Optional[Expression] {
        if !self.expect(.leftParen) {
            return .none
        }
        let parameters = self.parseParameters()!
        if !self.expect(.leftBrace) {
            return .none
        }
        let body = self.parseBlock()!
        return .some(.function(parameters: parameters, body: body))
    }

    func parseParameters(&mut self) -> Optional[List[string]] {
        var names = List[string]()

        if self.peekIs(TokenTag.rightParen) {
            self.advance()
            return .some(names)
        }

        self.advance()
        match self.current.kind {
            case .identifier(name) => names.append(name)
            case _ => {
                let found = self.current.kind.describe()
                let position = self.current.position
                self.report(std.sprintf("expected a parameter name, found %s", found), position)
                return .none
            }
        }

        while self.peekIs(TokenTag.comma) {
            self.advance()
            self.advance()
            match self.current.kind {
                case .identifier(name) => names.append(name)
                case _ => {
                    let found = self.current.kind.describe()
                    let position = self.current.position
                    self.report(std.sprintf("expected a parameter name, found %s", found), position)
                    return .none
                }
            }
        }

        if !self.expect(.rightParen) {
            return .none
        }
        return .some(names)
    }
}

import adex_iris::config::{AdExParameters, ReferenceConfig}
import adex_iris::data::{Sample, Scaler}
import adex_iris::encoding::RateEncoder
import adex_iris::model::{AdExState, AdExStep, Eligibility, advanceEligibility, finite, stepAdEx}
import adex_iris::random::Random
import std::collections::List

func zeroVector(_ count: usize) -> List[double] {
    var values = List[double]::new(withCapacity: count)
    var index: usize = 0
    while index < count { values.append(0.0); index += 1 }
    return values
}

/// One trainable connection entering an AdEx neuron. The learning state lives
/// beside its weight so the e-prop recurrence can be read one synapse at a time.
struct Synapse {
    source: usize
    weight: double
    eligibility: Eligibility
    gradient: double
    firstMoment: double
    secondMoment: double
}

extend &Synapse {


    func resetEligibility() {
        self.eligibility = Eligibility { voltage: 0.0, adaptation: 0.0, filtered: 0.0 }
    }

    func advance(

        _ transition: AdExStep,
        _ currentDerivative: double,
        _ config: &ReferenceConfig,
        _ parameters: &AdExParameters,
    ) {
        self.eligibility = advanceEligibility(
            self.eligibility,
            transition,
            currentDerivative,
            config.readoutDecay(),
            parameters.spikeAdaptation,
        )
    }

    func accumulate( _ learningSignal: double) {
        self.gradient += learningSignal * self.eligibility.filtered
    }

    func zeroGradient() { self.gradient = 0.0 }
    func gradientSquare() -> double { self.gradient * self.gradient }

    func applyAdam(

        _ scale: double,
        _ correction1: double,
        _ correction2: double,
        _ config: &ReferenceConfig,
    ) {
        gradient := self.gradient * scale
        self.firstMoment = config.adamBeta1() * self.firstMoment
            + (1.0 - config.adamBeta1()) * gradient
        self.secondMoment = config.adamBeta2() * self.secondMoment
            + (1.0 - config.adamBeta2()) * gradient * gradient
        update := config.learningRate() * (self.firstMoment / correction1)
            / ((self.secondMoment / correction2).sqrt() + config.adamEpsilon())
        self.weight -= update
    }
}

/// A neuron owns every connection that changes its AdEx state.
struct Neuron {
    state: AdExState
    spike: double
    inputSynapses: List[Synapse]
    recurrentSynapses: List[Synapse]
}

/// Readout connections have an exact leaky trace instead of an AdEx
/// eligibility vector.
struct ReadoutSynapse {
    source: usize
    weight: double
    trace: double
    gradient: double
    firstMoment: double
    secondMoment: double
}

extend &ReadoutSynapse {


    func resetTrace() { self.trace = 0.0 }
    func zeroGradient() { self.gradient = 0.0 }
    func gradientSquare() -> double { self.gradient * self.gradient }

    func applyAdam(

        _ scale: double,
        _ correction1: double,
        _ correction2: double,
        _ config: &ReferenceConfig,
    ) {
        gradient := self.gradient * scale
        self.firstMoment = config.adamBeta1() * self.firstMoment
            + (1.0 - config.adamBeta1()) * gradient
        self.secondMoment = config.adamBeta2() * self.secondMoment
            + (1.0 - config.adamBeta2()) * gradient * gradient
        update := config.learningRate() * (self.firstMoment / correction1)
            / ((self.secondMoment / correction2).sqrt() + config.adamEpsilon())
        self.weight -= update
    }
}

struct Readout {
    value: double
    synapses: List[ReadoutSynapse]
}

public struct SampleResult {
    public loss: double
    public prediction: usize
    public finite: bool
}

/// Neurons own AdEx synapses and readouts own their output synapses, keeping
/// state traversal explicit.
public struct Network {
    neurons: List[Neuron]
    readouts: List[Readout]
    inputTrace: List[double]
    recurrentTrace: List[double]
    beta1Power: double
    beta2Power: double
}

extend &Network {


    func resetState( _ parameters: &AdExParameters) {
        var neuronIndex: usize = 0
        while neuronIndex < self.neurons.len() {
            neuron := &self.neurons[neuronIndex]
            neuron.state = AdExState { voltage: parameters.leakPotential, adaptation: 0.0 }
            neuron.spike = 0.0
            var synapseIndex: usize = 0
            while synapseIndex < neuron.inputSynapses.len() {
                neuron.inputSynapses[synapseIndex].resetEligibility()
                synapseIndex += 1
            }
            synapseIndex = 0
            while synapseIndex < neuron.recurrentSynapses.len() {
                neuron.recurrentSynapses[synapseIndex].resetEligibility()
                synapseIndex += 1
            }
            neuronIndex += 1
        }
        var index: usize = 0
        while index < self.inputTrace.len() { self.inputTrace[index] = 0.0; index += 1 }
        index = 0
        while index < self.recurrentTrace.len() { self.recurrentTrace[index] = 0.0; index += 1 }
        var output: usize = 0
        while output < self.readouts.len() {
            readout := &self.readouts[output]
            readout.value = 0.0
            var synapseIndex: usize = 0
            while synapseIndex < readout.synapses.len() {
                readout.synapses[synapseIndex].resetTrace()
                synapseIndex += 1
            }
            output += 1
        }
    }

    public func zeroGradients() {
        var neuronIndex: usize = 0
        while neuronIndex < self.neurons.len() {
            neuron := &self.neurons[neuronIndex]
            var synapseIndex: usize = 0
            while synapseIndex < neuron.inputSynapses.len() {
                neuron.inputSynapses[synapseIndex].zeroGradient()
                synapseIndex += 1
            }
            synapseIndex = 0
            while synapseIndex < neuron.recurrentSynapses.len() {
                neuron.recurrentSynapses[synapseIndex].zeroGradient()
                synapseIndex += 1
            }
            neuronIndex += 1
        }
        var output: usize = 0
        while output < self.readouts.len() {
            readout := &self.readouts[output]
            var synapseIndex: usize = 0
            while synapseIndex < readout.synapses.len() {
                readout.synapses[synapseIndex].zeroGradient()
                synapseIndex += 1
            }
            output += 1
        }
    }

    func updateTraces( _ inputSpikes: &List[double], _ config: &ReferenceConfig) {
        decay := config.synapseDecay()
        var index: usize = 0
        while index < self.inputTrace.len() {
            self.inputTrace[index] = decay * self.inputTrace[index] + inputSpikes[index]
            index += 1
        }
        index = 0
        while index < self.recurrentTrace.len() {
            self.recurrentTrace[index] = decay * self.recurrentTrace[index]
                + self.neurons[index].spike
            index += 1
        }
    }

    func hiddenStep( _ config: &ReferenceConfig, _ parameters: &AdExParameters) {
        inputTrace := self.inputTrace.clone()
        recurrentTrace := self.recurrentTrace.clone()
        var neuronIndex: usize = 0
        while neuronIndex < self.neurons.len() {
            neuron := &self.neurons[neuronIndex]
            var current = parameters.biasCurrent
            var synapseIndex: usize = 0
            while synapseIndex < neuron.inputSynapses.len() {
                synapse := &neuron.inputSynapses[synapseIndex]
                current += parameters.inputCurrentScale * synapse.weight * inputTrace[synapse.source]
                synapseIndex += 1
            }
            synapseIndex = 0
            while synapseIndex < neuron.recurrentSynapses.len() {
                synapse := &neuron.recurrentSynapses[synapseIndex]
                current += parameters.recurrentCurrentScale * synapse.weight * recurrentTrace[synapse.source]
                synapseIndex += 1
            }

            transition := stepAdEx(neuron.state, current, config.dtMillis(), parameters)
            synapseIndex = 0
            while synapseIndex < neuron.inputSynapses.len() {
                synapse := &neuron.inputSynapses[synapseIndex]
                synapse.advance(
                    transition,
                    parameters.inputCurrentScale * inputTrace[synapse.source],
                    config,
                    parameters,
                )
                synapseIndex += 1
            }
            synapseIndex = 0
            while synapseIndex < neuron.recurrentSynapses.len() {
                synapse := &neuron.recurrentSynapses[synapseIndex]
                synapse.advance(
                    transition,
                    parameters.recurrentCurrentScale * recurrentTrace[synapse.source],
                    config,
                    parameters,
                )
                synapseIndex += 1
            }
            neuron.state = transition.state
            neuron.spike = transition.spike
            neuronIndex += 1
        }
    }

    func readoutStep( _ config: &ReferenceConfig) {
        var spikes = zeroVector(self.neurons.len())
        var neuronIndex: usize = 0
        while neuronIndex < self.neurons.len() {
            spikes[neuronIndex] = self.neurons[neuronIndex].spike
            neuronIndex += 1
        }
        decay := config.readoutDecay()
        var output: usize = 0
        while output < self.readouts.len() {
            readout := &self.readouts[output]
            var value = decay * readout.value
            var synapseIndex: usize = 0
            while synapseIndex < readout.synapses.len() {
                synapse := &readout.synapses[synapseIndex]
                spike := spikes[synapse.source]
                synapse.trace = decay * synapse.trace + spike
                value += synapse.weight * spike
                synapseIndex += 1
            }
            readout.value = value
            output += 1
        }
    }

    func probabilities( _ config: &ReferenceConfig) -> List[double] {
        var maximum = self.readouts[0].value
        var output: usize = 1
        while output < config.outputCount() {
            if self.readouts[output].value > maximum { maximum = self.readouts[output].value }
            output += 1
        }
        var values = zeroVector(config.outputCount())
        var total = 0.0
        output = 0
        while output < config.outputCount() {
            value := (self.readouts[output].value - maximum).exp()
            values[output] = value
            total += value
            output += 1
        }
        output = 0
        while output < config.outputCount() {
            values[output] /= total
            output += 1
        }
        return values
    }

    func accumulateGradient(

        _ probabilities: &List[double],
        _ target: usize,
        _ config: &ReferenceConfig,
    ) {
        var learningSignals = zeroVector(config.hiddenCount())
        var output: usize = 0
        while output < self.readouts.len() {
            wanted := if output == target { 1.0 } else { 0.0 }
            error := (probabilities[output] - wanted) * config.lossStepScale()
            readout := &self.readouts[output]
            var synapseIndex: usize = 0
            while synapseIndex < readout.synapses.len() {
                synapse := &readout.synapses[synapseIndex]
                learningSignals[synapse.source] += synapse.weight * error
                synapse.gradient += error * synapse.trace
                synapseIndex += 1
            }
            output += 1
        }

        var neuronIndex: usize = 0
        while neuronIndex < self.neurons.len() {
            learningSignal := learningSignals[neuronIndex]
            neuron := &self.neurons[neuronIndex]
            var synapseIndex: usize = 0
            while synapseIndex < neuron.inputSynapses.len() {
                neuron.inputSynapses[synapseIndex].accumulate(learningSignal)
                synapseIndex += 1
            }
            synapseIndex = 0
            while synapseIndex < neuron.recurrentSynapses.len() {
                neuron.recurrentSynapses[synapseIndex].accumulate(learningSignal)
                synapseIndex += 1
            }
            neuronIndex += 1
        }
    }

    public func runSample(

        _ sample: Sample,
        _ scaler: Scaler,
        _ config: &ReferenceConfig,
        _ training: bool,
    ) -> SampleResult {
        parameters := AdExParameters::regularSpiking()
        self.resetState(&parameters)
        var encoder = RateEncoder::forSample(&sample, scaler, config)
        var inputSpikes = zeroVector(config.inputCount())
        var score = zeroVector(config.outputCount())
        var loss = 0.0
        var allFinite = true
        var timestep: usize = 0
        while timestep < config.steps() {
            encoder.next(&inputSpikes)
            self.updateTraces(&inputSpikes, config)
            self.hiddenStep(config, &parameters)
            self.readoutStep(config)
            if timestep >= config.lossStart() {
                probabilities := self.probabilities(config)
                var targetProbability = probabilities[sample.label().index()]
                if targetProbability < 0.000000000001 { targetProbability = 0.000000000001 }
                loss -= targetProbability.log() * config.lossStepScale()
                var output: usize = 0
                while output < config.outputCount() {
                    score[output] += probabilities[output]
                    if !finite(probabilities[output]) { allFinite = false }
                    output += 1
                }
                if training { self.accumulateGradient(&probabilities, sample.label().index(), config) }
            }
            timestep += 1
        }
        var prediction: usize = 0
        var output: usize = 1
        while output < config.outputCount() {
            if score[output] > score[prediction] { prediction = output }
            output += 1
        }
        return SampleResult { loss, prediction, finite: allFinite && finite(loss) }
    }

    func gradientNorm() -> double {
        var sum = 0.0
        var neuronIndex: usize = 0
        while neuronIndex < self.neurons.len() {
            neuron := &self.neurons[neuronIndex]
            var synapseIndex: usize = 0
            while synapseIndex < neuron.inputSynapses.len() {
                sum += neuron.inputSynapses[synapseIndex].gradientSquare()
                synapseIndex += 1
            }
            synapseIndex = 0
            while synapseIndex < neuron.recurrentSynapses.len() {
                sum += neuron.recurrentSynapses[synapseIndex].gradientSquare()
                synapseIndex += 1
            }
            neuronIndex += 1
        }
        var output: usize = 0
        while output < self.readouts.len() {
            readout := &self.readouts[output]
            var synapseIndex: usize = 0
            while synapseIndex < readout.synapses.len() {
                sum += readout.synapses[synapseIndex].gradientSquare()
                synapseIndex += 1
            }
            output += 1
        }
        return sum.sqrt()
    }

    public func applyGradients( _ batchSize: usize, _ config: &ReferenceConfig) {
        norm := self.gradientNorm()
        batchCount := double::parse(sprintf("%d", batchSize)).unwrap()
        var scale = 1.0 / batchCount
        if norm * scale > config.gradientClip() {
            scale *= config.gradientClip() / (norm * scale)
        }
        self.beta1Power *= config.adamBeta1()
        self.beta2Power *= config.adamBeta2()
        correction1 := 1.0 - self.beta1Power
        correction2 := 1.0 - self.beta2Power

        var neuronIndex: usize = 0
        while neuronIndex < self.neurons.len() {
            neuron := &self.neurons[neuronIndex]
            var synapseIndex: usize = 0
            while synapseIndex < neuron.inputSynapses.len() {
                neuron.inputSynapses[synapseIndex].applyAdam(scale, correction1, correction2, config)
                synapseIndex += 1
            }
            synapseIndex = 0
            while synapseIndex < neuron.recurrentSynapses.len() {
                neuron.recurrentSynapses[synapseIndex].applyAdam(scale, correction1, correction2, config)
                synapseIndex += 1
            }
            neuronIndex += 1
        }
        var output: usize = 0
        while output < self.readouts.len() {
            readout := &self.readouts[output]
            var synapseIndex: usize = 0
            while synapseIndex < readout.synapses.len() {
                readout.synapses[synapseIndex].applyAdam(scale, correction1, correction2, config)
                synapseIndex += 1
            }
            output += 1
        }
        self.zeroGradients()
    }
}

extend Synapse {
    static func new(_ source: usize, _ weight: double) -> Self {
        return Synapse {
            source,
            weight,
            eligibility: Eligibility { voltage: 0.0, adaptation: 0.0, filtered: 0.0 },
            gradient: 0.0,
            firstMoment: 0.0,
            secondMoment: 0.0,
        }
    }
}

extend ReadoutSynapse {
    static func new(_ source: usize, _ weight: double) -> Self {
        return ReadoutSynapse {
            source,
            weight,
            trace: 0.0,
            gradient: 0.0,
            firstMoment: 0.0,
            secondMoment: 0.0,
        }
    }
}

extend Network {
    public static func initialized(_ seed: uint64, _ config: &ReferenceConfig) -> Self {
        parameters := AdExParameters::regularSpiking()
        var random = Random::seeded(seed)
        var neurons = List[Neuron]::new(withCapacity: config.hiddenCount())
        var target: usize = 0
        while target < config.hiddenCount() {
            var inputSynapses = List[Synapse]::new(withCapacity: config.inputCount())
            var input: usize = 0
            while input < config.inputCount() {
                inputSynapses.append(Synapse::new(input, random.unit()))
                input += 1
            }

            var recurrentSynapses = List[Synapse]::new(withCapacity: config.hiddenCount() - 1)
            var source: usize = 0
            while source < config.hiddenCount() {
                if source != target {
                    recurrentSynapses.append(Synapse::new(source, random.symmetric(0.25)))
                }
                source += 1
            }
            neurons.append(Neuron {
                state: AdExState { voltage: parameters.leakPotential, adaptation: 0.0 },
                spike: 0.0,
                inputSynapses,
                recurrentSynapses,
            })
            target += 1
        }

        var readouts = List[Readout]::new(withCapacity: config.outputCount())
        var output: usize = 0
        while output < config.outputCount() {
            var synapses = List[ReadoutSynapse]::new(withCapacity: config.hiddenCount())
            var source: usize = 0
            while source < config.hiddenCount() {
                synapses.append(ReadoutSynapse::new(source, random.symmetric(0.5)))
                source += 1
            }
            readouts.append(Readout { value: 0.0, synapses })
            output += 1
        }

        return Network {
            neurons,
            readouts,
            inputTrace: zeroVector(config.inputCount()),
            recurrentTrace: zeroVector(config.hiddenCount()),
            beta1Power: 1.0,
            beta2Power: 1.0,
        }
    }
}

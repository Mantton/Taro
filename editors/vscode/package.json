{
    "name": "taro",
    "displayName": "Taro Language",
    "description": "Syntax highlighting and language-server support for Taro",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": ["onLanguage:taro"],
    "main": "./extension.js",
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "contributes": {
        "configuration": {
            "title": "Taro",
            "properties": {
                "taro.languageServer.path": {
                    "type": "string",
                    "default": "taro-lsp",
                    "scope": "machine",
                    "description": "Path to the installed Taro language server executable."
                }
            }
        },
        "languages": [
            {
                "id": "taro",
                "aliases": [
                    "Taro",
                    "taro"
                ],
                "extensions": [
                    ".tr"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "taro",
                "scopeName": "source.taro",
                "path": "./syntaxes/taro.tmLanguage.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Mantton/Taro.git",
        "directory": "editors/vscode"
    }
}

{
    "name": "taro",
    "displayName": "Taro Language",
    "description": "Syntax highlighting and language-server support for Taro",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": ["onLanguage:taro"],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Taro server and SDK paths from workspace settings require a trusted workspace.",
            "restrictedConfigurations": [
                "taro.languageServer.path",
                "taro.sdk.path",
                "taro.languageServer.bundle"
            ]
        }
    },
    "main": "./extension.js",
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "contributes": {
        "configuration": {
            "title": "Taro",
            "properties": {
                "taro.languageServer.path": {
                    "type": "string",
                    "default": "taro-lsp",
                    "scope": "machine-overridable",
                    "description": "Path to the installed Taro language server executable."
                },
                "taro.sdk.path": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "description": "Taro SDK directory. Leave empty to discover the SDK."
                },
                "taro.languageServer.bundle": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "description": "Explicit portable LSP bundle directory. Use with the SDK path unset."
                }
            }
        },
        "languages": [
            {
                "id": "taro",
                "aliases": [
                    "Taro",
                    "taro"
                ],
                "extensions": [
                    ".tr"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "taro",
                "scopeName": "source.taro",
                "path": "./syntaxes/taro.tmLanguage.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Mantton/Taro.git",
        "directory": "editors/vscode"
    }
}

import std::collections::{List, __list_copy_bytes}
import std::io::{Error, Reader, Writer}
import std::mem::{Span, NativeBytes, maxBufferCapacity}
import std::result::Result

const BUFFER_INITIAL_CAPACITY: usize = 64
const TAKEN_SLACK_LIMIT: usize = 512

func bufferCapacityError() -> Error {
    Error::new(.resourceExhausted).withOperation("grow byte buffer")
}

func nextBufferCapacity(_ current: usize, _ required: usize) -> usize? {
    maximum := maxBufferCapacity[uint8]()
    if required > maximum {
        return .none
    }

    var next = if current == 0 { BUFFER_INITIAL_CAPACITY } else { current }
    if next > maximum {
        next = required
    }
    while next < required {
        match next.checkedMul(2 as usize) {
            case .some(doubled) => {
                if doubled > maximum {
                    next = required
                } else {
                    next = doubled
                }
            }
            case .none => next = required
        }
    }
    return .some(next)
}

final class BufferState {
    storage: NativeBytes
    readStart: usize
    writeEnd: usize
    capacityValue: usize
}

extend BufferState {
    init(_ storage: NativeBytes, _ length: usize, _ capacity: usize) {
        self.storage = storage
        self.readStart = 0
        self.writeEnd = length
        self.capacityValue = capacity
    }
}

/// A shared growable byte stream. Copies share bytes and read/write positions.
/// Reads advance its cursor; writes append and may compact consumed storage.
/// String/list conversions return independent snapshots without consuming it.
public struct Buffer {
    private state: BufferState
}

extend Buffer {
    /// Create an empty shared buffer.
    public static func new() -> Self {
        Buffer { state: BufferState(NativeBytes::new(0), 0, 0) }
    }

    // A buffer whose first writes needn't grow it.
    internal static func withCapacity(_ capacity: usize) -> Self {
        Buffer { state: BufferState(NativeBytes::new(capacity), 0, capacity) }
    }

    /// Create a buffer containing an independent copy of `bytes`.
    public static func new(_ bytes: Span[uint8]) -> Self {
        len := bytes.len()
        if len == 0 {
            return Buffer::new()
        }

        storage := NativeBytes::new(len)
        source := unsafe { bytes.at(0) as *const uint8 }
        unsafe { source.copyToNonoverlapping(storage.data(), len) }
        return Buffer { state: BufferState(storage, len, len) }
    }

    /// Create a buffer containing an independent copy of the string's bytes.
    /// Bytes are preserved exactly; UTF-8 validation is not performed.
    public static func new(_ value: string) -> Self {
        len := std::string::stringLen(value)
        if len == 0 {
            return Buffer::new()
        }

        storage := NativeBytes::new(len)
        unsafe { std::string::stringData(value).copyToNonoverlapping(storage.data(), len) }
        return Buffer { state: BufferState(storage, len, len) }
    }

    /// Return the number of unread bytes.
    public func len() -> usize {
        self.state.writeEnd - self.state.readStart
    }

    public func isEmpty() -> bool {
        self.len() == 0
    }

    /// Return the reusable capacity available after compaction.
    public func capacity() -> usize {
        self.state.capacityValue
    }

    /// A view of the current unread range. Growth leaves its allocation alive;
    /// compaction or writes may change bytes in the current allocation.
    public func bytes() -> Span[uint8] {
        ptr := unsafe { self.state.storage.data().add(self.state.readStart) as *const uint8 }
        return unsafe { Span[uint8]::from(ptr, self.len()) }
    }

    /// Ensure capacity for at least `minCapacity` unread bytes.
    ///
    /// Existing bytes and the read cursor are preserved. Capacity arithmetic
    /// failures are typed resource errors rather than library panics.
    public func reserve(_ minCapacity: usize) -> Result[(), Error] {
        if minCapacity <= self.state.capacityValue {
            return .ok(())
        }

        next := match nextBufferCapacity(self.state.capacityValue, minCapacity) {
            case .some(value) => value
            case .none => return .err(bufferCapacityError())
        }

        self.compact()
        unsafe { self.state.storage.reserve(self.state.writeEnd, next) }
        self.state.capacityValue = next
        return .ok(())
    }

    /// Discard all content while retaining allocated capacity.
    public func reset() {
        self.state.readStart = 0
        self.state.writeEnd = 0
    }

    // Advance past `count` unread bytes without copying them anywhere.
    internal func skip(_ count: usize) {
        if count > self.len() { std::panic::panic("byte buffer skip exceeds unread bytes") }
        self.state.readStart += count
        if self.state.readStart == self.state.writeEnd {
            self.reset()
        }
    }

    /// Append one byte.
    public func writeByte(_ value: uint8) -> Result[(), Error] {
        var bytes: [uint8; 1] = [value]
        match self.appendBytes(bytes.asSpan()) {
            case .ok(_) => return .ok(())
            case .err(error) => return .err(error)
        }
    }

    /// Append every byte in `value` without requiring valid UTF-8.
    public func writeString(_ value: string) -> Result[(), Error] {
        len := std::string::stringLen(value)
        if len == 0 {
            return .ok(())
        }
        // Safe strings own immutable storage, so they cannot alias this
        // writable buffer. Span writes still use appendBytes' alias snapshot.
        self.ensureWritable(len)!
        destination := unsafe { self.state.storage.data().add(self.state.writeEnd) }
        // Writers emit a lot of single punctuation.
        if len == 1 {
            unsafe { destination.write(std::string::stringData(value).read()) }
        } else {
            unsafe { std::string::stringData(value).copyTo(destination, len) }
        }
        self.state.writeEnd += len
        return .ok(())
    }

    /// Copy the unread bytes into an independent list, preserving this buffer.
    public func toBytes() -> List[uint8] {
        length := self.len()
        if length == 0 { return List[uint8]::new() }
        unsafe { __list_copy_bytes(self.state.storage.data().byteAdd(self.state.readStart), length) }
    }

    /// Copy the unread bytes into an immutable string. Invalid UTF-8 is kept;
    /// this does not compact, clear or otherwise change the shared buffer.
    public func toString() -> string {
        std::string::stringFromBytes(self.bytes())
    }

    // The unread bytes as a string, leaving this buffer empty. The string takes
    // over the allocation, unless that would pin much more memory than it uses.
    internal func takeString() -> string {
        count := self.len()
        if count == 0 { return "" }
        if self.state.capacityValue > TAKEN_SLACK_LIMIT && self.state.capacityValue / 2 > count {
            return self.toString()
        }
        unsafe { self.state.storage.publish(self.state.writeEnd) }
        data := unsafe { self.state.storage.data().add(self.state.readStart) as *const uint8 }
        result := unsafe { std::string::stringFromParts(data, count) }
        self.state.storage.detach()
        self.state.readStart = 0
        self.state.writeEnd = 0
        self.state.capacityValue = 0
        return result
    }

    func compact() {
        if self.state.readStart == 0 {
            return
        }

        unread := self.len()
        if unread > 0 {
            source := unsafe { self.state.storage.data().add(self.state.readStart) as *const uint8 }
            unsafe { source.copyTo(self.state.storage.data(), unread) }
        }
        self.state.readStart = 0
        self.state.writeEnd = unread
    }

    @inline
    func ensureWritable(_ additional: usize) -> Result[(), Error] {
        // Existing capacity proves len + additional cannot overflow or exceed
        // the buffer limit. Keep checked growth and compaction on the slow path.
        if additional <= self.state.capacityValue - self.state.writeEnd {
            return .ok(())
        }
        return self.growForWrite(additional)
    }

    func growForWrite(_ additional: usize) -> Result[(), Error] {
        required := match self.len().checkedAdd(additional) {
            case .some(value) => value
            case .none => return .err(bufferCapacityError())
        }
        if required > maxBufferCapacity[uint8]() {
            return .err(bufferCapacityError())
        }

        self.compact()
        if required <= self.state.capacityValue {
            return .ok(())
        }
        return self.reserve(required)
    }

    // Room for `count` more bytes, for a caller to fill and then `commitSpare`. Any
    // other use of this buffer before that invalidates the span.
    internal func spare(_ count: usize) -> Result[Span[uint8], Error] {
        self.ensureWritable(count)!
        return .ok(unsafe { Span[uint8]::from(self.state.storage.data().add(self.state.writeEnd), count) })
    }

    // Gives up the allocation of an empty buffer. Earlier views stay valid.
    internal func releaseStorageIfEmpty() {
        if self.len() != 0 { return }
        self.state.storage.detach()
        self.state.readStart = 0
        self.state.writeEnd = 0
        self.state.capacityValue = 0
    }

    internal func commitSpare(_ count: usize) {
        if count > self.state.capacityValue - self.state.writeEnd { std::panic::panic("byte buffer commit exceeds its capacity") }
        self.state.writeEnd += count
    }

    func aliasesStorage(_ bytes: Span[uint8]) -> bool {
        if bytes.len() == 0 || self.state.capacityValue == 0 { return false }
        source := unsafe { bytes.asPtr() as usize }
        start := unsafe { self.state.storage.data() as usize }
        if source < start { return false }
        offset := source - start
        return offset < self.state.capacityValue && bytes.len() <= self.state.capacityValue - offset
    }

    func appendBytes(_ bytes: Span[uint8]) -> Result[usize, Error] {
        count := bytes.len()
        if count == 0 { return .ok(0) }
        var source = bytes
        // A retained view may include already-consumed slots. Snapshot any
        // self-alias before compaction can overwrite it, including on growth.
        if self.aliasesStorage(bytes) {
            snapshot := unsafe { __list_copy_bytes(bytes.asPtr(), count) }
            source = snapshot.asSpan()
        }
        match self.ensureWritable(count) {
            case .ok(_) => {}
            case .err(error) => return .err(error)
        }
        unsafe { source.asPtr().copyTo(self.state.storage.data().add(self.state.writeEnd), count) }
        self.state.writeEnd += count
        return .ok(count)
    }
}

conform Buffer to Reader {
    public func read(_ destination: Span[uint8]) -> Result[usize, Error] {
        if destination.len() == 0 || self.isEmpty() {
            return .ok(0)
        }

        count := if destination.len() < self.len() {
            destination.len()
        } else {
            self.len()
        }
        source := unsafe { self.state.storage.data().add(self.state.readStart) as *const uint8 }
        var writable = destination
        target := unsafe { writable.at(0) as *mut uint8 }
        // memmove semantics make even deliberately overlapping reads defined.
        unsafe { source.copyTo(target, count) }

        self.state.readStart += count
        if self.state.readStart == self.state.writeEnd {
            self.reset()
        }
        return .ok(count)
    }
}

conform Buffer to Writer {
    // Preserve the inherent method for callers without Writer in scope.
    // Concrete lookup selects that method; generic calls reach this witness.
    @inline
    public func writeString(_ value: string) -> Result[(), Error] {
        self.writeString(value)
    }

    public func write(_ bytes: Span[uint8]) -> Result[usize, Error] {
        self.appendBytes(bytes)
    }

    public func flush() -> Result[(), Error] {
        return .ok(())
    }
}

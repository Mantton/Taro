// Raw pointers carry no validity, initialization, lifetime or exclusivity
// guarantee. Memory access is unsafe. A pointer stored in traced memory or a
// live local retains GC storage, including interior addresses; native memory
// remains the caller's responsibility. Prefer checked slices in safe APIs.
import std::intrinsic::{
    __intrinsic_ptr_add,
    __intrinsic_ptr_sub,
    __intrinsic_ptr_offset,
    __intrinsic_ptr_byte_add,
    __intrinsic_ptr_byte_sub,
    __intrinsic_ptr_read,
    __intrinsic_ptr_write,
    __intrinsic_memcpy,
    __intrinsic_memmove,
    __intrinsic_memset,
}
import std::mem::sizeOf

extend[T] *T {
    @inline
    public func add(_ n: usize) -> *T {
        unsafe { __intrinsic_ptr_add(self, n) }
    }

    @inline
    public func sub(_ n: usize) -> *T {
        unsafe { __intrinsic_ptr_sub(self, n) }
    }

    @inline
    public func offset(_ n: isize) -> *T {
        unsafe { __intrinsic_ptr_offset(self, n) }
    }

    @inline
    public func byteAdd(_ n: usize) -> *T {
        unsafe { __intrinsic_ptr_byte_add(self, n) }
    }

    @inline
    public func byteSub(_ n: usize) -> *T {
        unsafe { __intrinsic_ptr_byte_sub(self, n) }
    }

    @inline
    /// Safety: The pointer must address an initialized T. Reading copies the value; managed pointers in the copy retain their targets.
    public unsafe func read() -> T {
        unsafe { __intrinsic_ptr_read(self) }
    }

    /// Safety: Both ranges must be valid for count elements. This copies element bytes; both ranges must remain properly initialized. Ranges may overlap.
    public unsafe func copyTo(_ dst: *mut T, _ count: usize) {
        unsafe { __intrinsic_memmove(dst, self, count * sizeOf[T]()) }
    }

    /// Safety: Both ranges must be valid and disjoint for count elements. This copies element bytes; both ranges must remain properly initialized.
    public unsafe func copyToNonoverlapping(_ dst: *mut T, _ count: usize) {
        unsafe { __intrinsic_memcpy(dst, self, count * sizeOf[T]()) }
    }

    /// Safety: The source and destination must be valid for count bytes and must not overlap. Pointers into GC storage retain that allocation.
    public unsafe func readBytes(_ dst: *mut uint8, _ count: usize) {
        unsafe { __intrinsic_memcpy(dst, self as *uint8, count) }
    }

    public static func null() -> *T {
        unsafe { 0 as *T }
    }
}

extend[T] *mut T {
    @inline
    public func add(_ n: usize) -> *mut T {
        unsafe { __intrinsic_ptr_add(self as *T, n) as *mut T }
    }

    @inline
    public func sub(_ n: usize) -> *mut T {
        unsafe { __intrinsic_ptr_sub(self as *T, n) as *mut T }
    }

    @inline
    public func offset(_ n: isize) -> *mut T {
        unsafe { __intrinsic_ptr_offset(self as *T, n) as *mut T }
    }

    @inline
    public func byteAdd(_ n: usize) -> *mut T {
        unsafe { __intrinsic_ptr_byte_add(self as *T, n) as *mut T }
    }

    @inline
    public func byteSub(_ n: usize) -> *mut T {
        unsafe { __intrinsic_ptr_byte_sub(self as *T, n) as *mut T }
    }

    @inline
    /// Safety: The pointer must address an initialized T. Reading copies the value; managed pointers in the copy retain their targets.
    public unsafe func read() -> T {
        unsafe { __intrinsic_ptr_read(self) }
    }

    @inline
    /// Safety: The destination must be valid and writable for T. This initializes or overwrites storage without reading the previous bytes.
    public unsafe func write(_ val: T) {
        unsafe { __intrinsic_ptr_write(self, val) }
    }

    /// Safety: Both ranges must be valid for count elements. This copies element bytes; both ranges must remain properly initialized. Ranges may overlap.
    public unsafe func copyTo(_ dst: *mut T, _ count: usize) {
        unsafe { __intrinsic_memmove(dst, self, count * sizeOf[T]()) }
    }

    /// Safety: Both ranges must be valid and disjoint for count elements. This copies element bytes; both ranges must remain properly initialized.
    public unsafe func copyToNonoverlapping(_ dst: *mut T, _ count: usize) {
        unsafe { __intrinsic_memcpy(dst, self, count * sizeOf[T]()) }
    }

    /// Safety: The destination must be writable for count bytes. Filled bytes must not be interpreted as T unless they form a valid initialized value.
    public unsafe func writeBytes(_ val: uint8, _ count: usize) {
        unsafe { __intrinsic_memset(self, val, count) }
    }

    /// Safety: The source and destination must be valid for count bytes and must not overlap. Pointers into GC storage retain that allocation.
    public unsafe func readBytes(_ dst: *mut uint8, _ count: usize) {
        unsafe { __intrinsic_memcpy(dst, self as *uint8, count) }
    }

    public static func null() -> *mut T {
        unsafe { 0 as *mut T }
    }
}

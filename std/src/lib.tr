import std::panic::{panic, todo}

@cfg(family("unix"))
public func print(_ s: string) {
    len := std::string::stringLen(s)
    if len == 0 {
        return
    }
    data := std::string::stringData(s)
    var _ = std::io::writeStdout(data, len)
}

@cfg(family("unix"))
public func eprint(_ s: string) {
    len := std::string::stringLen(s)
    if len == 0 {
        return
    }
    data := std::string::stringData(s)
    var _ = std::io::writeStderr(data, len)
}

@cfg(family("windows"))
public func print(_ s: string) {
    todo("std.print not implemented on windows yet")
}

@cfg(family("windows"))
public func eprint(_ s: string) {
    todo("std.eprint not implemented on windows yet")
}

public func println(_ s: string) {
    print(s)
    print("\n")
}

public func sprintf[Value: std::fmt::Formattable](_ format: string, _ value: Value) -> string {
    std::fmt::formatPrintfOne(format, value)
}

public func sprintf(_ format: string, _ args: any std::fmt::Display...) -> string {
    std::fmt::formatPrintf(format, args)
}

public func printf[Value: std::fmt::Formattable](_ format: string, _ value: Value) {
    print(std::fmt::formatPrintfOne(format, value))
}

public func printf(_ format: string, _ args: any std::fmt::Display...) {
    rendered := std::fmt::formatPrintf(format, args)
    print(rendered)
}

public func eprintln(_ s: string) {
    eprint(s)
    eprint("\n")
}

public func eprintf[Value: std::fmt::Formattable](_ format: string, _ value: Value) {
    eprint(std::fmt::formatPrintfOne(format, value))
}

public func eprintf(_ format: string, _ args: any std::fmt::Display...) {
    rendered := std::fmt::formatPrintf(format, args)
    eprint(rendered)
}

public func assert(_ condition: bool, _ message: string) {
    if !condition {
        panic(message)
    }
}

public func debugAssert(_ condition: bool, _ message: string) {
    if #cfg(profile("debug")) {
        assert(condition, message)
    }
}

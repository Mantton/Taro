import std::panic::{panic, todo}

@cfg(family("unix"))
public func print(_ s: string) {
    len := std::string::stringLen(s)
    if len == 0 {
        return
    }
    data := std::string::stringData(s)
    var _ = std::io::writeStdout(data, len)
}

@cfg(family("unix"))
public func eprint(_ s: string) {
    len := std::string::stringLen(s)
    if len == 0 {
        return
    }
    data := std::string::stringData(s)
    var _ = std::io::writeStderr(data, len)
}

@cfg(family("windows"))
public func print(_ s: string) {
    todo("std.print not implemented on windows yet")
}

@cfg(family("windows"))
public func eprint(_ s: string) {
    todo("std.eprint not implemented on windows yet")
}

public func println(_ s: string) {
    print(s)
    print("\n")
}

public func sprintf[Value: std::fmt::Formattable](_ format: string, _ value: Value) -> string {
    std::fmt::formatPrintfOne(format, value)
}

public func sprintf(_ format: string, _ args: any std::fmt::Display...) -> string {
    std::fmt::formatPrintf(format, args)
}

public func printf[Value: std::fmt::Formattable](_ format: string, _ value: Value) {
    print(std::fmt::formatPrintfOne(format, value))
}

public func printf(_ format: string, _ args: any std::fmt::Display...) {
    rendered := std::fmt::formatPrintf(format, args)
    print(rendered)
}

public func eprintln(_ s: string) {
    eprint(s)
    eprint("\n")
}

public func eprintf[Value: std::fmt::Formattable](_ format: string, _ value: Value) {
    eprint(std::fmt::formatPrintfOne(format, value))
}

public func eprintf(_ format: string, _ args: any std::fmt::Display...) {
    rendered := std::fmt::formatPrintf(format, args)
    eprint(rendered)
}

/// Assert that `condition` holds. Direct calls capture evaluated operand
/// values and include the source expression and caller location on failure.
@lang("Assert")
public func assert(_ condition: bool) {
    if !condition {
        panic("assertion failed")
    }
}

/// Evaluate the diagnostic message only when the assertion fails.
@lang("AssertWithMessage")
public func assert(_ condition: bool, _ message: @lazy string) {
    if !condition {
        panic(message())
    }
}

/// In a debug build, assert that `condition` holds.
@lang("DebugAssert")
public func debugAssert(_ condition: bool) {
    if #cfg(profile("debug")) && !condition {
        panic("assertion failed")
    }
}

/// In a debug build, evaluate the message on failure.
@lang("DebugAssertWithMessage")
public func debugAssert(_ condition: bool, _ message: @lazy string) {
    if #cfg(profile("debug")) && !condition {
        panic(message())
    }
}

@lang("AssertFail")
func assertFail(
    _ expression: string,
    _ file: string,
    _ line: int32,
    _ leftExpr: string,
    _ leftValue: string,
    _ rightExpr: string,
    _ rightValue: string,
) {
    if !leftExpr.isEmpty() && !rightExpr.isEmpty() {
        panic("assertion failed at ${file}:${line}: ${expression}\n  left (${leftExpr}): ${leftValue}\n  right (${rightExpr}): ${rightValue}")
    } else if !leftExpr.isEmpty() {
        panic("assertion failed at ${file}:${line}: ${expression}\n  value (${leftExpr}): ${leftValue}")
    } else {
        panic("assertion failed at ${file}:${line}: ${expression}")
    }
}

@lang("AssertFailWithMessage")
func assertFailWithMessage(
    _ expression: string,
    _ file: string,
    _ line: int32,
    _ leftExpr: string,
    _ leftValue: string,
    _ rightExpr: string,
    _ rightValue: string,
    _ message: @lazy string,
) {
    rendered := message()
    if !leftExpr.isEmpty() && !rightExpr.isEmpty() {
        panic("assertion failed at ${file}:${line}: ${expression}: ${rendered}\n  left (${leftExpr}): ${leftValue}\n  right (${rightExpr}): ${rightValue}")
    } else if !leftExpr.isEmpty() {
        panic("assertion failed at ${file}:${line}: ${expression}: ${rendered}\n  value (${leftExpr}): ${leftValue}")
    } else {
        panic("assertion failed at ${file}:${line}: ${expression}: ${rendered}")
    }
}

/// Inspect a value and return it. Direct calls include the original operand
/// and caller location. When passed as a callback only the value is available.
@lang("DebugValue")
public func dbg[T: std::fmt::Debug](_ value: T) -> T {
    eprintln(std::fmt::debugString(value))
    value
}

@lang("DebugValueAt")
func debugValueAt[T: std::fmt::Debug](_ value: T, _ expression: string, _ file: string, _ line: int32) -> T {
    rendered := std::fmt::debugString(value)
    eprintln("[${file}:${line}] ${expression} = ${rendered}")
    value
}

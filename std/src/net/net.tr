import std::runtime::SharedOwner
import std::io::Error
import std::mem::{Span}
import std::result::Result

public type IpAddress = std::sys::net::IpAddress
public type SocketAddress = std::sys::net::SocketAddress

const DEFAULT_TCP_BACKLOG: int32 = 1024

internal struct SocketCloseState {
    inner: std::sys::net::task::RawAsyncSocket
}

// A non-owning request token, never a second close obligation. The borrowed
// wrapper retains SharedOwner across direct await; native requests validate
// source identity and acknowledge cancellation before releasing any buffers.
internal func snapshotRawSocket(
    _ socket: &std::sys::net::task::RawAsyncSocket,
) -> std::sys::net::task::RawAsyncSocket {
    ptr := unsafe { socket as *const std::sys::net::task::RawAsyncSocket }
    return unsafe { ptr.read() }
}

internal func closedSocketError(_ operation: string) -> Error {
    Error::new(.closed).withOperation(operation)
}

internal func ensureSocketOpen(_ state: SharedOwner[SocketCloseState], _ operation: string) -> Result[(), Error] {
    valid := std::sys::net::task::isValid(&state.get().inner)
    if !valid {
        return .err(closedSocketError(operation))
    }
    return .ok(())
}

internal func socketCloseState(
    _ inner: std::sys::net::task::RawAsyncSocket,
) -> Result[SharedOwner[SocketCloseState], Error] {
    return .ok(SharedOwner[SocketCloseState]::new(SocketCloseState { inner }))
}

internal func claimRawSocket(
    _ state: SharedOwner[SocketCloseState],
    _ operation: string,
) -> Result[std::sys::net::task::RawAsyncSocket, Error] {
    var value: &SocketCloseState = state.get()
    if !std::sys::net::task::isValid(&value.inner) {
        return .err(closedSocketError(operation))
    }
    return .ok(std::sys::net::task::take(&value.inner))
}

internal func closeSocketState(_ state: SharedOwner[SocketCloseState]) -> Result[(), Error] {
    raw := match claimRawSocket(state, "close") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    result := std::sys::net::task::close(raw)
    return result
}

public struct TcpListener {
    internal state: SharedOwner[SocketCloseState]
}

public struct TcpStream {
    internal state: SharedOwner[SocketCloseState]
}

public struct UdpSocket {
    internal state: SharedOwner[SocketCloseState]
}

extend TcpListener {
    public static func bind(_ address: SocketAddress) -> Result[TcpListener, Error] {
        TcpListener::bindWithBacklog(address, DEFAULT_TCP_BACKLOG)
    }

    public static func bindWithBacklog(_ address: SocketAddress, _ backlog: int32) -> Result[TcpListener, Error] {
        socketRes := std::sys::net::task::socket(std::sys::net::domainForAddress(address), .stream)
        socket := match socketRes {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        state := match socketCloseState(socket) {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }

        reuseRes := std::sys::net::task::setReuseAddr(&state.get().inner, true)
        match reuseRes {
            case .ok(_) => {}
            case .err(err) => {
                var _ = closeSocketState(state)
                return .err(err)
            }
        }

        bindRes := std::sys::net::task::bind(&state.get().inner, address)
        match bindRes {
            case .ok(_) => {}
            case .err(err) => {
                var _ = closeSocketState(state)
                return .err(err)
            }
        }

        listenRes := std::sys::net::task::listen(&state.get().inner, backlog)
        match listenRes {
            case .ok(_) => return .ok(TcpListener { state })
            case .err(err) => {
                var _ = closeSocketState(state)
                return .err(err)
            }
        }
    }

    public func accept() async -> Result[(TcpStream, SocketAddress), Error] {
        match ensureSocketOpen(self.state, "accept") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        // Borrow the private snapshot across await, retaining state below.
        raw := snapshotRawSocket(&self.state.get().inner)
        acceptRes := await std::sys::net::task::accept(&raw)
        socketPair := match acceptRes {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        state := match socketCloseState(socketPair.0) {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }

        return .ok((TcpStream { state }, socketPair.1))
    }

    public func localAddress() -> Result[SocketAddress, Error] {
        match ensureSocketOpen(self.state, "get local address") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        result := std::sys::net::task::localAddress(&self.state.get().inner)
        return result
    }

    /// Stops new operations through all shared copies. If a native operation
    /// is in flight, success acknowledges the request; OS close is deferred
    /// until it finishes. Deferred close errors are reported on stderr and in
    /// runtime statistics. Explicit close is required; collection does not close.
    public func close() -> Result[(), Error] {
        closeSocketState(self.state)
    }
}

extend TcpStream {
    public static func connect(_ address: SocketAddress) async -> Result[TcpStream, Error] {
        socketRes := std::sys::net::task::socket(std::sys::net::domainForAddress(address), .stream)
        socket := match socketRes {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        state := match socketCloseState(socket) {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }

        // Borrow the private snapshot across await, retaining state below.
        raw := snapshotRawSocket(&state.get().inner)
        connectRes := await std::sys::net::task::connect(&raw, address)
        match connectRes {
            case .ok(_) => {}
            case .err(err) => {
                var _ = closeSocketState(state)
                return .err(err)
            }
        }

        return .ok(TcpStream { state })
    }

    public func localAddress() -> Result[SocketAddress, Error] {
        match ensureSocketOpen(self.state, "get local address") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        result := std::sys::net::task::localAddress(&self.state.get().inner)
        return result
    }

    public func peerAddress() -> Result[SocketAddress, Error] {
        match ensureSocketOpen(self.state, "get peer address") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        result := std::sys::net::task::peerAddress(&self.state.get().inner)
        return result
    }

    /// Stops new operations through all shared copies. If a native operation
    /// is in flight, success acknowledges the request; OS close is deferred
    /// until it finishes. Deferred close errors are reported on stderr and in
    /// runtime statistics. Explicit close is required; collection does not close.
    public func close() -> Result[(), Error] {
        closeSocketState(self.state)
    }

    public func intoStream() -> Result[std::io::task::AsyncStream, Error] {
        var raw = match claimRawSocket(self.state, "convert socket to stream") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        result := std::sys::net::task::intoStream(&raw)
        match result {
            case .ok(stream) => {
                return .ok(stream)
            }
            case .err(err) => {
                var _ = std::sys::net::task::close(raw)
                return .err(err)
            }
        }
    }

    public func read(_ buf: Span[uint8]) async -> Result[usize, Error] {
        match ensureSocketOpen(self.state, "read") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        // Borrow the private snapshot across await, retaining state below.
        raw := snapshotRawSocket(&self.state.get().inner)
        result := await std::sys::net::task::read(&raw, buf)
        return result
    }

    /// Like `read`, but fails with `.timedOut` if the socket is still not
    /// readable at `deadline`. Available data always beats the deadline.
    public func readUntil(_ buf: Span[uint8], _ deadline: std::time::Instant) async -> Result[usize, Error] {
        match ensureSocketOpen(self.state, "read") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        raw := snapshotRawSocket(&self.state.get().inner)
        result := await std::sys::net::task::read(&raw, buf, deadline: .some(deadline))
        return result
    }

    // The steps of readUntil and writeAllUntil, for callers that usually complete
    // without suspending and so needn't build a frame for each operation.
    internal func tryRead(_ buf: Span[uint8]) -> Result[usize, Error] {
        ensureSocketOpen(self.state, "read")!
        raw := snapshotRawSocket(&self.state.get().inner)
        return std::sys::net::task::tryRead(&raw, buf)
    }
    internal func tryWrite(_ buf: Span[uint8]) -> Result[usize, Error] {
        ensureSocketOpen(self.state, "write")!
        raw := snapshotRawSocket(&self.state.get().inner)
        return std::sys::net::task::tryWrite(&raw, buf)
    }
    internal func waitReadableUntil(_ deadline: std::time::Instant) async -> Result[(), Error] {
        ensureSocketOpen(self.state, "read")!
        raw := snapshotRawSocket(&self.state.get().inner)
        return await std::sys::net::task::waitReadable(&raw, deadline: deadline)
    }
    internal func waitWritableUntil(_ deadline: std::time::Instant) async -> Result[(), Error] {
        ensureSocketOpen(self.state, "write")!
        raw := snapshotRawSocket(&self.state.get().inner)
        return await std::sys::net::task::waitWritable(&raw, deadline: deadline)
    }

    public func write(_ buf: Span[uint8]) async -> Result[usize, Error] {
        match ensureSocketOpen(self.state, "write") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        // Borrow the private snapshot across await, retaining state below.
        raw := snapshotRawSocket(&self.state.get().inner)
        result := await std::sys::net::task::write(&raw, buf)
        return result
    }

    public func writeAll(_ buf: Span[uint8]) async -> Result[(), Error] {
        match ensureSocketOpen(self.state, "write all") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        len := buf.len()
        if len == 0 {
            return .ok(())
        }

        var written: usize = 0
        while written < len {
            remaining := buf.slice(written, len - written)
            writeRes := await self.write(remaining)
            match writeRes {
                case .ok(count) => {
                    if count == 0 {
                        return .err(Error::new(.writeZero).withOperation("write all"))
                    }
                    written += count
                }
                case .err(err) => return .err(err)
            }
        }

        return .ok(())
    }

    /// Like `writeAll`, but fails with `.timedOut` if the socket stops accepting
    /// bytes until `deadline`. Bytes already written stay written, so a timeout
    /// leaves the stream's framing unknown: close it.
    public func writeAllUntil(_ buf: Span[uint8], _ deadline: std::time::Instant) async -> Result[(), Error] {
        var written: usize = 0
        while written < buf.len() {
            match ensureSocketOpen(self.state, "write all") {
                case .ok(_) => {}
                case .err(err) => return .err(err)
            }
            raw := snapshotRawSocket(&self.state.get().inner)
            count := (await std::sys::net::task::write(&raw, buf.slice(written, buf.len() - written), deadline: .some(deadline)))!
            if count == 0 { return .err(Error::new(.writeZero).withOperation("write all")) }
            written += count
        }
        return .ok(())
    }

    public func write(_ s: string) async -> Result[(), Error] {
        match ensureSocketOpen(self.state, "write all") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        len := std::string::stringLen(s)
        if len == 0 {
            return .ok(())
        }

        ptr := std::string::stringData(s)
        bytes := unsafe { Span[uint8]::from(ptr, len) }
        return await self.writeAll(bytes)
    }

    public func readExact(_ buf: Span[uint8]) async -> Result[(), Error] {
        match ensureSocketOpen(self.state, "read exact") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        len := buf.len()
        if len == 0 {
            return .ok(())
        }

        var total: usize = 0
        var writable = buf
        while total < len {
            tail := writable.slice(total, len - total)
            readRes := await self.read(tail)
            count := match readRes {
                case .ok(value) => value
                case .err(err) => return .err(err)
            }

            if count == 0 {
                return .err(Error::new(.unexpectedEof).withOperation("read exact"))
            }

            total += count
        }

        return .ok(())
    }
}

extend UdpSocket {
    public static func bind(_ address: SocketAddress) -> Result[UdpSocket, Error] {
        socketRes := std::sys::net::task::socket(std::sys::net::domainForAddress(address), .datagram)
        socket := match socketRes {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        state := match socketCloseState(socket) {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }

        bindRes := std::sys::net::task::bind(&state.get().inner, address)
        match bindRes {
            case .ok(_) => {}
            case .err(err) => {
                var _ = closeSocketState(state)
                return .err(err)
            }
        }

        return .ok(UdpSocket { state })
    }

    public func localAddress() -> Result[SocketAddress, Error] {
        match ensureSocketOpen(self.state, "get local address") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        result := std::sys::net::task::localAddress(&self.state.get().inner)
        return result
    }

    public func sendTo(_ buf: Span[uint8], _ address: SocketAddress) async -> Result[usize, Error] {
        match ensureSocketOpen(self.state, "send datagram") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        // Borrow the private snapshot across await, retaining state below.
        raw := snapshotRawSocket(&self.state.get().inner)
        result := await std::sys::net::task::sendTo(&raw, buf, address)
        return result
    }

    public func recvFrom(_ buf: Span[uint8]) async -> Result[(usize, SocketAddress), Error] {
        match ensureSocketOpen(self.state, "receive datagram") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        // Borrow the private snapshot across await, retaining state below.
        raw := snapshotRawSocket(&self.state.get().inner)
        result := await std::sys::net::task::recvFrom(&raw, buf)
        return result
    }

    /// Stops new operations through all shared copies. If a native operation
    /// is in flight, success acknowledges the request; OS close is deferred
    /// until it finishes. Deferred close errors are reported on stderr and in
    /// runtime statistics. Explicit close is required; collection does not close.
    public func close() -> Result[(), Error] {
        closeSocketState(self.state)
    }
}

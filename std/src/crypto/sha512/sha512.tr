import std::crypto::__rt__crypto_digest
import std::mem::Span

func calculate(_ data: *const uint8, _ length: usize) -> [uint8; 64] {
    var output: [uint8; 64] = [0_u8; 64]
    valid := unsafe { __rt__crypto_digest(1_u8, data, length, (&output as *mut [uint8; 64]) as *mut uint8) }
    std::assert(valid, "invalid SHA backend algorithm")
    return output
}
/// SHA-512 digest as raw bytes. Input is borrowed for this call only.
public func sum(_ bytes: Span[uint8]) -> [uint8; 64] { calculate(bytes.asPtr(), bytes.len()) }
/// Read immutable string storage directly. Span.fromString creates a writable
/// snapshot and would unnecessarily copy the entire input before hashing.
public func sum(_ text: string) -> [uint8; 64] { calculate(std::string::stringData(text), text.byteLen()) }

import std::marker::AnyObject
import std::intrinsic::{__intrinsic_class_owner, __intrinsic_class_from_owner}
import std::intrinsic::{__intrinsic_atomic_load, __intrinsic_atomic_store, __intrinsic_atomic_swap, __intrinsic_atomic_compare_exchange, __intrinsic_atomic_add}
import std::optional::Optional

// All operations are sequentially consistent. Share these values by reference;
// do not copy an atomic after its first use. @NoCopy makes vet diagnose copies.
// Zero initialization is valid. Integer add wraps and returns the NEW value;
// swap returns the old value; compareExchange returns whether it exchanged.

@NoCopy
public struct Int8 { private value: int8 }

extend Int8 {
    public static func new(_ value: int8 = 0) -> Self { Self { value } }
}

extend &Int8 {
    public func load() -> int8 { unsafe { __intrinsic_atomic_load(&self.value as *const int8) } }
    public func store(_ value: int8) { unsafe { __intrinsic_atomic_store(&self.value as *mut int8, value) } }
    public func swap(_ value: int8) -> int8 { unsafe { __intrinsic_atomic_swap(&self.value as *mut int8, value) } }
    public func compareExchange(_ expected: int8, _ desired: int8) -> bool { unsafe { __intrinsic_atomic_compare_exchange(&self.value as *mut int8, expected, desired) } }
    public func add(_ delta: int8) -> int8 { unsafe { __intrinsic_atomic_add(&self.value as *mut int8, delta) } }
}



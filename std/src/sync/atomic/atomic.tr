extend &Uint8 {
    public func load() -> uint8 { unsafe { __intrinsic_atomic_load(&self.value as *const uint8) } }
    public func store(_ value: uint8) { unsafe { __intrinsic_atomic_store(&self.value as *mut uint8, value) } }
    public func swap(_ value: uint8) -> uint8 { unsafe { __intrinsic_atomic_swap(&self.value as *mut uint8, value) } }
    public func compareExchange(_ expected: uint8, _ desired: uint8) -> bool { unsafe { __intrinsic_atomic_compare_exchange(&self.value as *mut uint8, expected, desired) } }
    public func add(_ delta: uint8) -> uint8 { unsafe { __intrinsic_atomic_add(&self.value as *mut uint8, delta) } }
}



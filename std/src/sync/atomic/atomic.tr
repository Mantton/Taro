/// A sequentially consistent boolean. Zero initializes to false.
@NoCopy
public struct Bool { private value: uint8 }
extend Bool {
    public static func new(_ value: bool = false) -> Self {
        Self { value: if value { 1_u8 } else { 0_u8 } }
    }
}
extend &Bool {
    public func load() -> bool { unsafe { __intrinsic_atomic_load(&self.value as *const uint8) != 0 } }
    public func store(_ value: bool) { unsafe { __intrinsic_atomic_store(&self.value as *mut uint8, if value { 1_u8 } else { 0_u8 }) } }
    public func swap(_ value: bool) -> bool { unsafe { __intrinsic_atomic_swap(&self.value as *mut uint8, if value { 1_u8 } else { 0_u8 }) != 0 } }
    public func compareExchange(_ expected: bool, _ desired: bool) -> bool {
        unsafe { __intrinsic_atomic_compare_exchange(&self.value as *mut uint8, if expected { 1_u8 } else { 0_u8 }, if desired { 1_u8 } else { 0_u8 }) }
    }
}

/// A strong, traced reference slot. Loading snapshots an ordinary strong
/// reference; replacement never invalidates previously loaded references.
/// This synchronizes the slot, not mutable access to the referenced value.
/// For class C, &C names a mutable handle variable, not the object itself;
/// reassigning that variable changes what a loaded reference observes.
@NoCopy
public struct Reference[T] { private value: *const T }

extend[T] Reference[T] {
    public static func new(_ value: Optional[&T] = .none) -> Self {
        Self { value: Reference[T]::raw(value) }
    }
    internal static func raw(_ value: Optional[&T]) -> *const T {
        match value {
            case .some(target) => return unsafe { target as *const T }
            case .none => return unsafe { (0 as usize) as *const T }
        }
    }
    internal static func strong(_ value: *const uint8) -> Optional[&T] {
        if unsafe { value as usize } == 0 { return .none }
        return .some(unsafe { value as &T })
    }
}

extend[T] &Reference[T] {
    public func load() -> Optional[&T] {
        Reference[T]::strong(unsafe { __intrinsic_atomic_load(&self.value as *const *const uint8) })
    }
    public func store(_ value: Optional[&T]) {
        unsafe { __intrinsic_atomic_store(&self.value as *mut *const uint8, Reference[T]::raw(value) as *const uint8) }
    }
    public func swap(_ value: Optional[&T]) -> Optional[&T] {
        Reference[T]::strong(unsafe { __intrinsic_atomic_swap(&self.value as *mut *const uint8, Reference[T]::raw(value) as *const uint8) })
    }
    /// Compares reference identity; .none compares as an empty slot.
    public func compareExchange(_ expected: Optional[&T], _ desired: Optional[&T]) -> bool {
        unsafe { __intrinsic_atomic_compare_exchange(&self.value as *mut *const uint8, Reference[T]::raw(expected) as *const uint8, Reference[T]::raw(desired) as *const uint8) }
    }
}

/// A strong, traced snapshot of a concrete class object. Reassigning the
/// publisher's handle variable does not change a stored or loaded snapshot.
/// Only the slot is synchronized; object fields still need synchronization
/// when modified concurrently. Erased interface types require more metadata
/// and are rejected. Zero initialization creates an empty slot.
@lang("AtomicHandle")
@NoCopy
public struct Handle[C: AnyObject] { private value: *const uint8 }

extend[C: AnyObject] Handle[C] {
    public static func new(_ value: Optional[C] = .none) -> Self {
        Self { value: Handle[C]::raw(value) }
    }
    internal static func raw(_ value: Optional[C]) -> *const uint8 {
        match value {
            case .some(target) => unsafe { __intrinsic_class_owner(&target) }
            case .none => unsafe { (0 as usize) as *const uint8 }
        }
    }
    internal static func strong(_ value: *const uint8) -> Optional[C] {
        if unsafe { value as usize } == 0 { return .none }
        return .some(unsafe { __intrinsic_class_from_owner[C](value) })
    }
}

extend[C: AnyObject] &Handle[C] {
    public func load() -> Optional[C] {
        Handle[C]::strong(unsafe { __intrinsic_atomic_load(&self.value as *const *const uint8) })
    }
    public func store(_ value: Optional[C]) {
        unsafe { __intrinsic_atomic_store(&self.value as *mut *const uint8, Handle[C]::raw(value)) }
    }
    public func swap(_ value: Optional[C]) -> Optional[C] {
        Handle[C]::strong(unsafe { __intrinsic_atomic_swap(&self.value as *mut *const uint8, Handle[C]::raw(value)) })
    }
    /// Compares object identity; .none compares as an empty slot.
    public func compareExchange(_ expected: Optional[C], _ desired: Optional[C]) -> bool {
        unsafe { __intrinsic_atomic_compare_exchange(&self.value as *mut *const uint8, Handle[C]::raw(expected), Handle[C]::raw(desired)) }
    }
}

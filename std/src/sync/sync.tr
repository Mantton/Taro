import std::io::Error
import std::mem::{MaybeUninit, sizeOf}
import std::optional::Optional
import std::ops::Fn
import std::panic::panic
import std::result::Result

public enum ChannelCreateError {
    case invalidCapacity
    case io(Error)
}

public enum ChannelSendError {
    case closed
    case io(Error)
}

public enum ChannelTrySendError {
    case full
    case closed
    case io(Error)
}

public enum ChannelTryRecvError {
    case empty
    case io(Error)
}

/// Send-only access to shared channel storage.
public struct Sender[T] {
    internal raw: std::sys::sync::RawChannel
}

/// Receive-only access to shared channel storage.
public struct Receiver[T] {
    internal raw: std::sys::sync::RawChannel
}

// Raw queue access is serialized and messages move exactly once. Endpoints
// may cross workers only when the message type is transferable. Their private
// raw fields cannot be retagged to another T or used to bypass that condition.

/// Create a bounded channel and its directional endpoints.
public func bounded[T](_ capacity: usize) -> Result[(Sender[T], Receiver[T]), ChannelCreateError] {
    if capacity == 0 {
        return .err(.invalidCapacity)
    }

    createRes := unsafe { std::sys::sync::channelCreate(
        std::intrinsic::__intrinsic_gc_value_descriptor[T](),
        capacity,
        true,
    ) }
    match createRes {
        case .ok(raw) => return .ok((Sender[T] { raw }, Receiver[T] { raw }))
        case .err(err) => return .err(.io(err))
    }
}

/// Create an unbounded channel and its directional endpoints.
public func unbounded[T]() -> (Sender[T], Receiver[T]) {
    createRes := unsafe { std::sys::sync::channelCreate(
        std::intrinsic::__intrinsic_gc_value_descriptor[T](),
        0,
        false,
    ) }
    match createRes {
        case .ok(raw) => return (Sender[T] { raw }, Receiver[T] { raw })
        case .err(_) => panic("failed to create unbounded channel")
    }
}

extend[T] Sender[T] {
    public func send(_ value: T) async -> Result[(), ChannelSendError] {
        var slot = MaybeUninit[T]::new(value)
        var transferred: bool = false
        defer {
            // Until enqueue commits, this frame still owns the payload.
            // MaybeUninit suppresses automatic drop, so errors/cancellation
            // must explicitly recover one initialized owner for cleanup.
            if !transferred {
                var remaining: T = unsafe { slot.assumeInitRead() }
            }
        }
        loop {
            ptr := unsafe { slot.asPtr() as *const uint8 }
            sendRes := unsafe { std::sys::sync::channelTrySend(&self.raw, ptr) }
            match sendRes {
                case .ok(_) => {
                    transferred = true
                    return .ok(())
                }
                case .err(err) if err.isKind(.wouldBlock) => {
                    waitRes := await std::sys::sync::waitChannelSend(&self.raw)
                    match waitRes {
                        case .ok(_) => {}
                        case .err(err) if err.isKind(.brokenPipe) => return .err(.closed)
                        case .err(err) => return .err(.io(err))
                    }
                }
                case .err(err) if err.isKind(.brokenPipe) => return .err(.closed)
                case .err(err) => return .err(.io(err))
            }
        }
    }

    public func trySend(_ value: T) -> Result[(), ChannelTrySendError] {
        var slot = MaybeUninit[T]::new(value)
        var transferred: bool = false
        defer {
            if !transferred {
                var remaining: T = unsafe { slot.assumeInitRead() }
            }
        }
        ptr := unsafe { slot.asPtr() as *const uint8 }
        sendRes := unsafe { std::sys::sync::channelTrySend(&self.raw, ptr) }
        match sendRes {
            case .ok(_) => {
                transferred = true
                return .ok(())
            }
            case .err(err) if err.isKind(.wouldBlock) => return .err(.full)
            case .err(err) if err.isKind(.brokenPipe) => return .err(.closed)
            case .err(err) => return .err(.io(err))
        }
    }

    /// Explicitly close the shared channel. Buffered values remain available
    /// to the receiver; future sends return `.closed`.
    public func close() -> Result[(), Error] {
        std::sys::sync::channelClose(&self.raw)
    }
}

extend[T] Receiver[T] {
    public func recv() async -> Optional[T] {
        var slot = MaybeUninit[T]::uninit()

        loop {
            ptr := unsafe { slot.asMutPtr() as *mut uint8 }
            recvRes := unsafe { std::sys::sync::channelTryRecv(&self.raw, ptr) }
            match recvRes {
                case .ok(.value) => return .some(unsafe { slot.assumeInitRead() })
                case .ok(.empty) => {
                    waitRes := await std::sys::sync::waitChannelRecv(&self.raw)
                    match waitRes {
                        case .ok(_) => {}
                        case .err(err) if err.isKind(.brokenPipe) => return .none
                        case .err(_) => panic("channel receive wait failed")
                    }
                }
                case .ok(.closed) => return .none
                case .err(_) => panic("channel receive failed")
            }
        }
    }

    public func tryRecv() -> Result[Optional[T], ChannelTryRecvError] {
        var slot = MaybeUninit[T]::uninit()
        ptr := unsafe { slot.asMutPtr() as *mut uint8 }
        recvRes := unsafe { std::sys::sync::channelTryRecv(&self.raw, ptr) }
        match recvRes {
            case .ok(.value) => return .ok(.some(unsafe { slot.assumeInitRead() }))
            case .ok(.empty) => return .err(.empty)
            case .ok(.closed) => return .ok(.none)
            case .err(err) => return .err(.io(err))
        }
    }
}

/// A lock and its protected inline value. Use references to share it;
/// @NoCopy lets `taro vet` diagnose accidental value copies.
@NoCopy
public struct Mutex[T] {
    internal raw: std::sys::sync::RawMutex
    internal value: T
}

extend[T] Mutex[T] {
    public static func new(_ value: T) -> Result[Self, Error] {
        match std::sys::sync::mutexCreate() {
            case .ok(raw) => return .ok(Self { raw, value })
            case .err(error) => return .err(error)
        }
    }
}

/// A lock and its protected inline value. Use references to share it;
/// @NoCopy lets `taro vet` diagnose accidental value copies.
@NoCopy
public struct RwLock[T] {
    internal raw: std::sys::sync::RawRwLock
    internal value: T
}

extend[T] RwLock[T] {
    public static func new(_ value: T) -> Result[Self, Error] {
        match std::sys::sync::rwlockCreate() {
            case .ok(raw) => return .ok(Self { raw, value })
            case .err(error) => return .err(error)
        }
    }
}

extend[T] &Mutex[T] {
    /// Access protected storage while holding the appropriate lock. The caller
    /// synchronizes access; references do not become immutable under a read lock.
    public func value() -> &T { &self.value }

    /// Returns false when another acquisition prevents immediate locking.
    public func tryLock() -> Result[bool, Error] {
        std::sys::sync::mutexTryLock(&self.raw)
    }

    public func lock() async -> Result[(), Error] {
        loop {
            match self.tryLock() {
                case .ok(true) => return .ok(())
                case .ok(false) => {
                    match await std::sys::sync::waitMutexLock(&self.raw) {
                        case .ok(_) => {}
                        case .err(error) => return .err(error)
                    }
                }
                case .err(error) => return .err(error)
            }
        }
    }

    public func unlock() -> Result[(), Error] {
        std::sys::sync::mutexUnlock(&self.raw)
    }

    /// Acquires, executes the synchronous callback, and releases on normal
    /// return or unwind. Suspension is limited to acquisition.
    public func withLock[R, F: Fn(&T) -> R](_ body: F) async -> Result[R, Error] {
        match await self.lock() {
            case .ok(_) => {}
            case .err(error) => return .err(error)
        }
        var held = true
        defer { if held { var _ = self.unlock() } }
        result := body(&self.value)
        held = false
        released := self.unlock()
        match released {
            case .ok(_) => return .ok(result)
            case .err(error) => return .err(error)
        }
    }

}

extend[T] &RwLock[T] {
    /// Access protected storage while holding the appropriate lock. The caller
    /// synchronizes access; references do not become immutable under a read lock.
    public func value() -> &T { &self.value }

    /// Returns false when another acquisition prevents immediate locking.
    public func tryReadLock() -> Result[bool, Error] {
        std::sys::sync::rwlockTryRead(&self.raw)
    }

    public func readLock() async -> Result[(), Error] {
        loop {
            match self.tryReadLock() {
                case .ok(true) => return .ok(())
                case .ok(false) => {
                    match await std::sys::sync::waitRwLockRead(&self.raw) {
                        case .ok(_) => {}
                        case .err(error) => return .err(error)
                    }
                }
                case .err(error) => return .err(error)
            }
        }
    }

    public func readUnlock() -> Result[(), Error] {
        std::sys::sync::rwlockUnlockRead(&self.raw)
    }

    /// Acquires, executes the synchronous callback, and releases on normal
    /// return or unwind. Suspension is limited to acquisition.
    public func withRead[R, F: Fn(&T) -> R](_ body: F) async -> Result[R, Error] {
        match await self.readLock() {
            case .ok(_) => {}
            case .err(error) => return .err(error)
        }
        var held = true
        defer { if held { var _ = self.readUnlock() } }
        result := body(&self.value)
        held = false
        released := self.readUnlock()
        match released {
            case .ok(_) => return .ok(result)
            case .err(error) => return .err(error)
        }
    }

    /// Returns false when another acquisition prevents immediate locking.
    public func tryWriteLock() -> Result[bool, Error] {
        std::sys::sync::rwlockTryWrite(&self.raw)
    }

    public func writeLock() async -> Result[(), Error] {
        loop {
            match self.tryWriteLock() {
                case .ok(true) => return .ok(())
                case .ok(false) => {
                    match await std::sys::sync::waitRwLockWrite(&self.raw) {
                        case .ok(_) => {}
                        case .err(error) => return .err(error)
                    }
                }
                case .err(error) => return .err(error)
            }
        }
    }

    public func writeUnlock() -> Result[(), Error] {
        std::sys::sync::rwlockUnlockWrite(&self.raw)
    }

    /// Acquires, executes the synchronous callback, and releases on normal
    /// return or unwind. Suspension is limited to acquisition.
    public func withWrite[R, F: Fn(&T) -> R](_ body: F) async -> Result[R, Error] {
        match await self.writeLock() {
            case .ok(_) => {}
            case .err(error) => return .err(error)
        }
        var held = true
        defer { if held { var _ = self.writeUnlock() } }
        result := body(&self.value)
        held = false
        released := self.writeUnlock()
        match released {
            case .ok(_) => return .ok(result)
            case .err(error) => return .err(error)
        }
    }

}

    public func encode[E: Encoder](into encoder: E) -> Result[(), E::Error] { encoder.encodeInt32(self) }
}
conform int32 to Decodable {
    public static func decode[D: Decoder](from decoder: D) -> Result[Self, D::Error] { decoder.decodeInt32() }
}

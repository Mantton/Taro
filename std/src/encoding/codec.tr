import std::collections::List
import std::ops::PartialEq
import std::optional::Optional
import std::result::Result

/// A format-neutral category for failures reported while converting values.
///
/// Concrete codecs own their error payloads and paths. Keeping only the stable
/// category here lets JSON retain byte positions and JSONPath while a future
/// binary codec can report offsets or schema locations appropriate to it.
public enum CodingErrorKind: PartialEq {
    case typeMismatch
    case missingField
    case invalidValue
    case invalidState
    case custom
}

conform CodingErrorKind to std::fmt::Display {
    public func display(_ into: &std::fmt::Formatter) {
        match self {
            case .typeMismatch => into.writeString("encoded value has the wrong type")
            case .missingField => into.writeString("required encoded field is missing")
            case .invalidValue => into.writeString("encoded value is invalid for the target type")
            case .invalidState => into.writeString("codec is in an invalid state")
            case .custom => into.writeString("custom coding failure")
        }
    }
}

/// The format-neutral shape visible at a decoder's current position.
public enum CodingValueKind: PartialEq {
    case null
    case boolean
    case number
    case string
    case sequence
    case object
}

/// A destination for the semantic events emitted by an `Encodable` value.
///
/// Scalar methods have defaults so small or specialized formats can implement
/// only the values they support. General-purpose formats should override every
/// scalar and container operation. Method-level generics deliberately remain
/// on `Encodable`, not here, keeping this interface usable as a conventional
/// associated-error contract as Taro's codec surface grows.
public interface Encoder {
    type Error: std::error::Error

    /// Construct an error at the encoder's current coding position.
    func error(_ kind: CodingErrorKind, _ message: string) -> Self::Error

    func encodeNull() -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support null"))
    }

    func encodeBool(_ value: bool) -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support booleans"))
    }

    func encodeInt8(_ value: int8) -> Result[(), Self::Error] {
        return self.encodeInt64(value as int64)
    }

    func encodeInt16(_ value: int16) -> Result[(), Self::Error] {
        return self.encodeInt64(value as int64)
    }

    func encodeInt32(_ value: int32) -> Result[(), Self::Error] {
        return self.encodeInt64(value as int64)
    }

    func encodeInt64(_ value: int64) -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support signed integers"))
    }

    func encodeIsize(_ value: isize) -> Result[(), Self::Error] {
        return self.encodeInt64(value as int64)
    }

    func encodeUint8(_ value: uint8) -> Result[(), Self::Error] {
        return self.encodeUint64(value as uint64)
    }

    func encodeUint16(_ value: uint16) -> Result[(), Self::Error] {
        return self.encodeUint64(value as uint64)
    }

    func encodeUint32(_ value: uint32) -> Result[(), Self::Error] {
        return self.encodeUint64(value as uint64)
    }

    func encodeUint64(_ value: uint64) -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support unsigned integers"))
    }

    func encodeUsize(_ value: usize) -> Result[(), Self::Error] {
        return self.encodeUint64(value as uint64)
    }

    func encodeFloat(_ value: float) -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support float values"))
    }

    func encodeDouble(_ value: double) -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support double values"))
    }

    /// Encode a validated, exact decimal representation without first rounding
    /// through a machine numeric type. Formats without exact decimals may
    /// reject this operation through their concrete error type.
    func encodeDecimal(_ value: string) -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support exact decimals"))
    }

    func encodeString(_ value: string) -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support strings"))
    }

    /// Begin a sequence. `.none` means its final length is not known yet.
    func beginSequence(_ length: usize?) -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support sequences"))
    }

    /// Position the encoder at the next sequence element.
    func beginElement() -> Result[(), Self::Error] {
        return .err(self.error(.invalidState, "encoder is not inside a sequence"))
    }

    func endSequence() -> Result[(), Self::Error] {
        return .err(self.error(.invalidState, "encoder is not inside a sequence"))
    }

    /// Begin a string-keyed object. This supports derived records and enums and
    /// composes with formats whose native keyed representation is not textual.
    func beginObject(_ length: usize?) -> Result[(), Self::Error] {
        return .err(self.error(.invalidValue, "encoder does not support objects"))
    }

    /// Position the encoder at the value belonging to `name`.
    func beginField(_ name: string) -> Result[(), Self::Error] {
        return .err(self.error(.invalidState, "encoder is not inside an object"))
    }

    func endObject() -> Result[(), Self::Error] {
        return .err(self.error(.invalidState, "encoder is not inside an object"))
    }
}

/// A source of semantic values consumed by a `Decodable` implementation.
///
/// The cursor-style container methods avoid borrowed, format-specific container
/// types. They can be backed by a DOM today or by a direct token stream later
/// without changing any user conformance or compiler-derived implementation.
public interface Decoder {
    type Error: std::error::Error

    /// Construct an error at the decoder's current coding position.
    func error(_ kind: CodingErrorKind, _ message: string) -> Self::Error

    /// Construct a missing-field error beneath the active object position.
    /// Call this before `endObject` so nested decoders retain their container
    /// path. Concrete decoders override it when they can attach that path.
    func missingField(_ name: string, _ message: string) -> Self::Error {
        return self.error(.missingField, message)
    }

    func peekKind() -> Result[CodingValueKind, Self::Error]

    func decodeNull() -> Result[(), Self::Error] {
        return .err(self.error(.typeMismatch, "expected null"))
    }

    func decodeBool() -> Result[bool, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a boolean"))
    }

    func decodeInt8() -> Result[int8, Self::Error] {
        return .err(self.error(.typeMismatch, "expected an int8"))
    }

    func decodeInt16() -> Result[int16, Self::Error] {
        return .err(self.error(.typeMismatch, "expected an int16"))
    }

    func decodeInt32() -> Result[int32, Self::Error] {
        return .err(self.error(.typeMismatch, "expected an int32"))
    }

    func decodeInt64() -> Result[int64, Self::Error] {
        return .err(self.error(.typeMismatch, "expected an int64"))
    }

    func decodeIsize() -> Result[isize, Self::Error] {
        return .err(self.error(.typeMismatch, "expected an isize"))
    }

    func decodeUint8() -> Result[uint8, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a uint8"))
    }

    func decodeUint16() -> Result[uint16, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a uint16"))
    }

    func decodeUint32() -> Result[uint32, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a uint32"))
    }

    func decodeUint64() -> Result[uint64, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a uint64"))
    }

    func decodeUsize() -> Result[usize, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a usize"))
    }

    func decodeFloat() -> Result[float, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a float"))
    }

    func decodeDouble() -> Result[double, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a double"))
    }

    /// Decode an exact decimal representation without rounding it through a
    /// machine numeric type.
    func decodeDecimal() -> Result[string, Self::Error] {
        return .err(self.error(.typeMismatch, "expected an exact decimal"))
    }

    func decodeString() -> Result[string, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a string"))
    }

    /// Enter a sequence and return its length when the decoder knows it.
    func beginSequence() -> Result[usize?, Self::Error] {
        return .err(self.error(.typeMismatch, "expected a sequence"))
    }

    /// Move to the next sequence element, or return `false` at its end.
    func nextElement() -> Result[bool, Self::Error] {
        return .err(self.error(.invalidState, "decoder is not inside a sequence"))
    }

    func endSequence() -> Result[(), Self::Error] {
        return .err(self.error(.invalidState, "decoder is not inside a sequence"))
    }

    /// Enter a string-keyed object and return its field count when known.
    func beginObject() -> Result[usize?, Self::Error] {
        return .err(self.error(.typeMismatch, "expected an object"))
    }

    /// Move to the next field value and return its name, or `.none` at the end.
    func nextField() -> Result[string?, Self::Error] {
        return .err(self.error(.invalidState, "decoder is not inside an object"))
    }

    /// Enter a `{kind, content?}` enum envelope and decode its string tag.
    /// Field order must not matter. Unknown envelope fields may be skipped.
    /// Leave the envelope open until `endObject`; the tag stays the active
    /// coding position so an unknown-variant error points at `kind`.
    /// A streaming implementation may buffer content encountered before kind.
    func beginEnum() -> Result[string, Self::Error] {
        return .err(self.error(.invalidValue, "decoder does not support tagged enums"))
    }

    /// Select required `content`, or validate its absence for a unit variant.
    /// Payload shape is checked by the following object/sequence operation.
    /// After consuming content, `endObject` closes the complete envelope.
    func beginEnumContent(_ hasPayload: bool) -> Result[(), Self::Error] {
        return .err(self.error(.invalidState, "decoder is not inside an enum envelope"))
    }

    /// Consume an unrecognized value. DOM decoders only need to mark their
    /// selected node consumed, while token-stream decoders advance past the
    /// complete value.
    func skipValue() -> Result[(), Self::Error] {
        return .err(self.error(.invalidState, "decoder cannot skip this value"))
    }

    func endObject() -> Result[(), Self::Error] {
        return .err(self.error(.invalidState, "decoder is not inside an object"))
    }
}

/// A value that can encode itself into any statically known format encoder.
///
/// The method is generic intentionally: Taro monomorphizes generic interface
/// methods and does not put them in existential witness tables. Normal generic
/// codec APIs are therefore zero-cost; `any Encodable` is not a supported input.
@lang("Encodable")
public interface Encodable {
    func encode[E: Encoder](into encoder: E) -> Result[(), E::Error]
}

/// A value that can construct itself from any statically known format decoder.
@lang("Decodable")
public interface Decodable {
    static func decode[D: Decoder](from decoder: D) -> Result[Self, D::Error]
}

/// A type supporting both directions of the format-neutral coding contract.
///
/// Structs and enums derive both methods by declaring `: Codable`.
/// Stored fields use their declaration names and order, and each field must
/// support the corresponding direction. Generic conformance is conditional
/// on those field capabilities. Classes can derive `Encodable`: an inherited
/// encoder retains its original fields, and subclasses may override it. A new
/// encoder on a non-Encodable base describes only this class's stored fields.
/// Classes derive decoding through `init[D: Decoder](from decoder: D)` returning
/// `Result[Self, D::Error]`. This initializer is required on non-final classes;
/// a handwritten matching designated or convenience initializer takes
/// precedence over field synthesis.
/// Decoding allocates a fresh object without calling unrelated custom init.
/// Subclasses inherit the same codec and decoding initializer when their added
/// fields have defaults and they declare no designated initializer. Otherwise,
/// implement the required decoding initializer explicitly; added fields are
/// never silently added to an inherited codec. A newly Decodable class with a
/// non-Decodable superclass needs an accessible designated non-fallible init().
/// Class decoding evaluates stored defaults. Readonly preset fields retain
/// their defaults and ignore encoded keys; mutable fields are decoded normally.
/// Missing optionals become none; other missing mutable fields are errors.
/// Inherited synthesized decoding initializers evaluate subclass defaults
/// before running the base decoder.
///
/// Enums use an adjacent tag: `{"kind":"person","content":{"name":"Ada"}}`.
/// Unit variants omit `content`; tuple variants use positional arrays, including
/// labeled and single-element tuples. Struct variants use named object fields.
/// Tuple lengths are exact. Unknown variants, missing payloads and unexpected
/// content on unit variants are errors. Envelope field order is immaterial;
/// unknown envelope and struct-payload fields are skipped. JSON duplicate-key
/// handling follows the parser's selected policy.
///
/// Decoding skips unknown fields. Absent declared optional fields become
/// `.none`; other absent fields are errors, even when a stored default exists.
/// Derivation initializes decoded fields directly, without running `init` or
/// stored default expressions. Declaring the conformance opts into this path.
/// To customize one direction, derive only the other interface and provide an
/// explicit `conform` block for the custom direction.
public type Codable = Encodable & Decodable

/// Invoke an `Encodable` implementation when the concrete source type is only
/// available as a generic argument. This is also the unambiguous nested-value
/// entry point for handwritten codecs.
public func encode[Source: Encodable, Destination: Encoder](
    _ source: &Source,
    into encoder: Destination,
) -> Result[(), Destination::Error] {
    source.encode(into: encoder)
}

/// Invoke a `Decodable` implementation for an explicitly selected target type.
public func decode[Target: Decodable, Source: Decoder](
    from decoder: Source,
) -> Result[Target, Source::Error] {
    Target::decode(from: decoder)
}

conform () to Encodable {
    public func encode[E: Encoder](into encoder: E) -> Result[(), E::Error] {
        encoder.encodeNull()
    }
}

conform () to Decodable {
    public static func decode[D: Decoder](from decoder: D) -> Result[Self, D::Error] {
        decoder.decodeNull()
    }
}

conform bool to Encodable {
    public func encode[E: Encoder](into encoder: E) -> Result[(), E::Error] {
        encoder.encodeBool(self)
    }
}

conform bool to Decodable {
    public static func decode[D: Decoder](from decoder: D) -> Result[Self, D::Error] {
        decoder.decodeBool()
    }
}

conform string to Encodable {
    public func encode[E: Encoder](into encoder: E) -> Result[(), E::Error] {
        encoder.encodeString(self)
    }
}

conform string to Decodable {
    public static func decode[D: Decoder](from decoder: D) -> Result[Self, D::Error] {
        decoder.decodeString()
    }
}


conform[Wrapped: Encodable] Optional[Wrapped] to Encodable {
    public func encode[E: Encoder](into encoder: E) -> Result[(), E::Error] {
        match self {
            case .some(value) => return value.encode(into: encoder)
            case .none => return encoder.encodeNull()
        }
    }
}

conform[Wrapped: Decodable] Optional[Wrapped] to Decodable {
    public static func decode[D: Decoder](from decoder: D) -> Result[Self, D::Error] {
        if decoder.peekKind()! == CodingValueKind::null {
            decoder.decodeNull()!
            return .ok(.none)
        }
        return .ok(.some(Wrapped::decode(from: decoder)!))
    }
}

conform[Element: Encodable] List[Element] to Encodable {
    public func encode[E: Encoder](into encoder: E) -> Result[(), E::Error] {
        var length: usize? = .some(self.len())
        encoder.beginSequence(length)!
        var index: usize = 0
        while index < self.len() {
            encoder.beginElement()!
            self.at(index).encode(into: encoder)!
            index += 1
        }
        return encoder.endSequence()
    }
}

conform[Element: Decodable] List[Element] to Decodable {
    public static func decode[D: Decoder](from decoder: D) -> Result[Self, D::Error] {
        length := decoder.beginSequence()!
        var values = match length {
            case .some(length) => List[Element]::new(withCapacity: length)
            case .none => List[Element]::new()
        }
        while decoder.nextElement()! {
            values.append(Element::decode(from: decoder)!)
        }
        decoder.endSequence()!
        return .ok(values)
    }
}

// Compiler-generated struct codecs use these ordinary generic operations.
// Keeping protocol sequencing here leaves synthesis responsible only for the
// declared fields and their types; all errors and cursor checks stay normal
// codec operations. These helpers are private, monomorphized and inlineable.
@inline
func __derivedEncodeBegin[E: Encoder](_ encoder: E, _ count: usize) -> Result[(), E::Error] {
    var length: usize? = .some(count)
    encoder.beginObject(length)
}

@inline
func __derivedEncodeField[T: Encodable, E: Encoder](
    _ value: T, _ encoder: E, _ name: string,
) -> Result[(), E::Error] {
    encoder.beginField(name)!
    value.encode(into: encoder)
}

@inline
func __derivedEncodeEnd[E: Encoder](_ encoder: E) -> Result[(), E::Error] {
    encoder.endObject()
}

@inline
func __derivedDecodeBegin[D: Decoder](_ decoder: D) -> Result[(), D::Error] {
    var _ = decoder.beginObject()!
    return .ok(())
}

@inline
func __derivedDecodeNext[D: Decoder](_ decoder: D) -> Result[string?, D::Error] {
    decoder.nextField()
}

@inline
func __derivedDecodeField[T: Decodable, D: Decoder](
    _ decoder: D, _ key: string, _ expected: string, _ slot: &T?,
) -> Result[bool, D::Error] {
    if key != expected { return .ok(false) }
    *slot = .some(T::decode(from: decoder)!)
    return .ok(true)
}

@inline
func __derivedDecodeSkip[D: Decoder](_ decoder: D) -> Result[(), D::Error] {
    decoder.skipValue()
}

@inline
func __derivedDecodeRequire[T, D: Decoder](
    _ slot: T?, _ decoder: D, _ name: string,
) -> Result[T, D::Error] {
    match slot {
        case .some(value) => return .ok(value)
        case .none => return .err(decoder.missingField(name, "field is required"))
    }
}

@inline
func __derivedDecodeEnd[D: Decoder](_ decoder: D) -> Result[(), D::Error] {
    decoder.endObject()
}

// References encode their pointee, not an address. A decoded reference owns
// fresh escaping storage: ordinary escape analysis promotes the local to the
// GC heap. Shared identity and cycles require an explicit ID-based codec.
conform[T: Encodable] &T to Encodable {
    func encode[E: Encoder](into encoder: E) -> Result[(), E::Error] {
        (*self).encode(into: encoder)
    }
}

conform[T: Decodable] &T to Decodable {
    static func decode[D: Decoder](from decoder: D) -> Result[Self, D::Error] {
        var value = T::decode(from: decoder)!
        return .ok(&value)
    }
}

@inline
func __derivedEncodeEnumBegin[E: Encoder](
    _ encoder: E, _ kind: string, _ hasPayload: bool,
) -> Result[(), E::Error] {
    var count: usize? = .some(if hasPayload { 2 as usize } else { 1 as usize })
    encoder.beginObject(count)!
    encoder.beginField("kind")!
    encoder.encodeString(kind)!
    if hasPayload { encoder.beginField("content")! }
    return .ok(())
}

@inline
func __derivedEncodeTupleBegin[E: Encoder](_ encoder: E, _ count: usize) -> Result[(), E::Error] {
    var length: usize? = .some(count)
    encoder.beginSequence(length)
}

@inline
func __derivedEncodeTupleElement[T: Encodable, E: Encoder](_ value: T, _ encoder: E) -> Result[(), E::Error] {
    encoder.beginElement()!
    value.encode(into: encoder)
}

@inline
func __derivedEncodeTupleEnd[E: Encoder](_ encoder: E) -> Result[(), E::Error] {
    encoder.endSequence()
}

@inline
func __derivedDecodeEnumBegin[D: Decoder](_ decoder: D) -> Result[string, D::Error] {
    decoder.beginEnum()
}

@inline
func __derivedDecodeEnumContent[D: Decoder](_ decoder: D, _ hasPayload: bool) -> Result[(), D::Error] {
    decoder.beginEnumContent(hasPayload)
}

@inline
func __derivedDecodeEnumUnknown[T, D: Decoder](_ decoder: D) -> Result[T, D::Error] {
    return .err(decoder.error(.invalidValue, "unknown enum variant"))
}

@inline
func __derivedDecodeTupleBegin[D: Decoder](_ decoder: D) -> Result[(), D::Error] {
    var _ = decoder.beginSequence()!
    return .ok(())
}

@inline
func __derivedDecodeTupleElement[T: Decodable, D: Decoder](_ decoder: D) -> Result[T, D::Error] {
    if !decoder.nextElement()! {
        return .err(decoder.error(.invalidValue, "enum tuple has too few elements"))
    }
    T::decode(from: decoder)
}

@inline
func __derivedDecodeTupleEnd[D: Decoder](_ decoder: D) -> Result[(), D::Error] {
    if decoder.nextElement()! {
        return .err(decoder.error(.invalidValue, "enum tuple has too many elements"))
    }
    decoder.endSequence()
}

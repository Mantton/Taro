    public func encode[E: Encoder](into encoder: E) -> Result[(), E::Error] { encoder.encodeInt8(self) }
}
conform int8 to Decodable {
    public static func decode[D: Decoder](from decoder: D) -> Result[Self, D::Error] { decoder.decodeInt8() }
}

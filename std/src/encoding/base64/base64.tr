import std.collections.List
import std.encoding.{DecodeError, DecodeErrorKind}
import std.mem.Span
import std.result.Result
import std.string.Builder

const STANDARD_ALPHABET: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const URL_SAFE_ALPHABET: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
const ASCII_UPPER_A: uint8 = 65_u8
const ASCII_UPPER_Z: uint8 = 90_u8
const ASCII_LOWER_A: uint8 = 97_u8
const ASCII_LOWER_Z: uint8 = 122_u8
const ASCII_ZERO: uint8 = 48_u8
const ASCII_NINE: uint8 = 57_u8
const ASCII_PLUS: uint8 = 43_u8
const ASCII_SLASH: uint8 = 47_u8
const ASCII_MINUS: uint8 = 45_u8
const ASCII_UNDERSCORE: uint8 = 95_u8
const ASCII_EQUALS: uint8 = 61_u8

/// An RFC 4648 Base64 alphabet and padding policy.
///
/// `standard` and `urlSafe` require canonical `=` padding when the final
/// quantum is short. Their `raw` counterparts omit padding and reject it on
/// decode, matching Go's standard/raw encoding split.
public enum Encoding: std.marker.Copy, std.ops.PartialEq {
    case standard
    case rawStandard
    case urlSafe
    case rawUrlSafe
}

impl Encoding {
    func isUrlSafe(&self) -> bool {
        match self {
            case .standard => false
            case .rawStandard => false
            case .urlSafe => true
            case .rawUrlSafe => true
        }
    }

    func usesPadding(&self) -> bool {
        match self {
            case .standard => true
            case .rawStandard => false
            case .urlSafe => true
            case .rawUrlSafe => false
        }
    }

    /// Return the encoded byte count, or none when it cannot fit in `usize`.
    public func encodedLen(&self, _ inputLen: usize) -> usize? {
        let full = inputLen / (3 as usize)
        let base = match full.checkedMul(4 as usize) {
            case .some(value) => value
            case .none => return .none
        }
        let remainder = inputLen % (3 as usize)
        let extra: usize = if remainder == 0 {
            0
        } else if self.usesPadding() {
            4
        } else if remainder == 1 {
            2
        } else {
            3
        }
        return base.checkedAdd(extra)
    }

    /// Return the maximum decoded size for a structurally possible input.
    ///
    /// Padding bytes can reduce the actual decoded result by one or two.
    public func maxDecodedLen(&self, _ inputLen: usize) -> usize? {
        let remainder = inputLen % (4 as usize)
        if self.usesPadding() {
            if remainder != 0 {
                return .none
            }
        } else if remainder == 1 {
            return .none
        }

        let full = inputLen / (4 as usize)
        let base = match full.checkedMul(3 as usize) {
            case .some(value) => value
            case .none => return .none
        }
        let extra: usize = if remainder == 2 {
            1
        } else if remainder == 3 {
            2
        } else {
            0
        }
        return base.checkedAdd(extra)
    }

    /// Encode bytes using this alphabet and padding policy.
    /// Output always owns storage independent of `bytes`.
    public func encode(&self, _ bytes: Span[uint8]) -> string {
        let outputLen = match self.encodedLen(bytes.len()) {
            case .some(value) => value
            case .none => std.panic.panic("base64 encoded length overflow")
        }
        if outputLen == 0 {
            return ""
        }

        var out = Builder()
        out.reserve(outputLen)
        var index: usize = 0
        while bytes.len() - index >= 3 {
            let first = *bytes.at(index) as uint32
            let second = *bytes.at(index + (1 as usize)) as uint32
            let third = *bytes.at(index + (2 as usize)) as uint32
            let value = (first << 16_u32) | (second << 8_u32) | third
            out.writeByte(alphabetByte(self, ((value >> 18_u32) & 63_u32) as usize))
            out.writeByte(alphabetByte(self, ((value >> 12_u32) & 63_u32) as usize))
            out.writeByte(alphabetByte(self, ((value >> 6_u32) & 63_u32) as usize))
            out.writeByte(alphabetByte(self, (value & 63_u32) as usize))
            index += 3
        }

        let remainder = bytes.len() - index
        if remainder == 1 {
            let first = *bytes.at(index) as uint32
            out.writeByte(alphabetByte(self, (first >> 2_u32) as usize))
            out.writeByte(alphabetByte(self, ((first & 3_u32) << 4_u32) as usize))
            if self.usesPadding() {
                out.writeByte(ASCII_EQUALS)
                out.writeByte(ASCII_EQUALS)
            }
        } else if remainder == 2 {
            let first = *bytes.at(index) as uint32
            let second = *bytes.at(index + (1 as usize)) as uint32
            out.writeByte(alphabetByte(self, (first >> 2_u32) as usize))
            out.writeByte(alphabetByte(
                self,
                (((first & 3_u32) << 4_u32) | (second >> 4_u32)) as usize,
            ))
            out.writeByte(alphabetByte(self, ((second & 15_u32) << 2_u32) as usize))
            if self.usesPadding() {
                out.writeByte(ASCII_EQUALS)
            }
        }
        return out.intoString()
    }

    /// Decode strict RFC 4648 text using this alphabet and padding policy.
    ///
    /// Whitespace and characters from the other alphabet are rejected instead
    /// of normalized. Unused trailing bits must be zero. Validation completes
    /// before output allocation, so failures never expose partial bytes.
    public func decode(&self, _ input: string) -> Result[List[uint8], DecodeError] {
        if self.usesPadding() {
            return decodePadded(self, input)
        }
        return decodeRaw(self, input)
    }
}

func alphabetByte(_ encoding: &Encoding, _ index: usize) -> uint8 {
    if encoding.isUrlSafe() {
        return URL_SAFE_ALPHABET.byteAt(index)
    }
    return STANDARD_ALPHABET.byteAt(index)
}

func decodeValue(_ encoding: &Encoding, _ byte: uint8) -> int32 {
    if byte >= ASCII_UPPER_A && byte <= ASCII_UPPER_Z {
        return (byte - ASCII_UPPER_A) as int32
    }
    if byte >= ASCII_LOWER_A && byte <= ASCII_LOWER_Z {
        return (byte - ASCII_LOWER_A + 26_u8) as int32
    }
    if byte >= ASCII_ZERO && byte <= ASCII_NINE {
        return (byte - ASCII_ZERO + 52_u8) as int32
    }
    if encoding.isUrlSafe() {
        if byte == ASCII_MINUS { return 62_i32 }
        if byte == ASCII_UNDERSCORE { return 63_i32 }
    } else {
        if byte == ASCII_PLUS { return 62_i32 }
        if byte == ASCII_SLASH { return 63_i32 }
    }
    return -1_i32
}

func validateDataByte(
    _ encoding: &Encoding,
    _ input: string,
    _ index: usize,
) -> Result[uint8, DecodeError] {
    let byte = input.byteAt(index)
    if byte == ASCII_EQUALS {
        return .err(DecodeError(.invalidPadding, index))
    }
    let value = decodeValue(encoding, byte)
    if value < 0 {
        return .err(DecodeError(.invalidByte, index))
    }
    return .ok(value as uint8)
}

func appendFullQuantum(
    _ out: &mut List[uint8],
    _ first: uint8,
    _ second: uint8,
    _ third: uint8,
    _ fourth: uint8,
) {
    out.append((first << 2_u8) | (second >> 4_u8))
    out.append((second << 4_u8) | (third >> 2_u8))
    out.append((third << 6_u8) | fourth)
}

func decodePadded(
    _ encoding: &Encoding,
    _ input: string,
) -> Result[List[uint8], DecodeError] {
    let len = input.byteLen()
    if len == 0 {
        return .ok(List[uint8]())
    }

    var firstPadding: usize? = .none
    var index: usize = 0
    while index < len {
        if input.byteAt(index) == ASCII_EQUALS {
            firstPadding = .some(index)
            break
        }
        match validateDataByte(encoding, input, index) {
            case .ok(_) => {}
            case .err(error) => return .err(error)
        }
        index += 1
    }

    var padding: usize = 0
    match firstPadding {
        case .none => {
            let remainder = len % (4 as usize)
            if remainder != 0 {
                let kind: DecodeErrorKind = if remainder == 2 || remainder == 3 {
                    .invalidPadding
                } else {
                    .invalidLength
                }
                return .err(DecodeError(kind, len))
            }
        }
        case .some(paddingStart) => {
            index = paddingStart
            while index < len {
                if input.byteAt(index) != ASCII_EQUALS {
                    return .err(DecodeError(.invalidPadding, index))
                }
                index += 1
            }

            padding = len - paddingStart
            let position = paddingStart % (4 as usize)
            let allowed: usize = if position == 2 {
                2
            } else if position == 3 {
                1
            } else {
                0
            }
            if allowed == 0 {
                return .err(DecodeError(.invalidPadding, paddingStart))
            }
            if padding > allowed {
                return .err(DecodeError(.invalidPadding, paddingStart + allowed))
            }
            if padding < allowed {
                return .err(DecodeError(.invalidPadding, len))
            }
        }
    }
    let dataEnd = len - padding

    if padding == 2 {
        let trailingIndex = dataEnd - (1 as usize)
        let trailing = decodeValue(encoding, input.byteAt(trailingIndex)) as uint8
        if trailing & 15_u8 != 0 {
            return .err(DecodeError(.nonCanonical, trailingIndex))
        }
    } else if padding == 1 {
        let trailingIndex = dataEnd - (1 as usize)
        let trailing = decodeValue(encoding, input.byteAt(trailingIndex)) as uint8
        if trailing & 3_u8 != 0 {
            return .err(DecodeError(.nonCanonical, trailingIndex))
        }
    }

    let maximum = match encoding.maxDecodedLen(len) {
        case .some(value) => value
        case .none => return .err(DecodeError(.invalidLength, len))
    }
    let outputLen = maximum - padding
    var out = List[uint8](withCapacity: outputLen)
    let fullEnd = if padding == 0 { len } else { len - (4 as usize) }
    index = 0
    while index < fullEnd {
        appendFullQuantum(
            &mut out,
            decodeValue(encoding, input.byteAt(index)) as uint8,
            decodeValue(encoding, input.byteAt(index + (1 as usize))) as uint8,
            decodeValue(encoding, input.byteAt(index + (2 as usize))) as uint8,
            decodeValue(encoding, input.byteAt(index + (3 as usize))) as uint8,
        )
        index += 4
    }

    if padding > 0 {
        let first = decodeValue(encoding, input.byteAt(index)) as uint8
        let second = decodeValue(encoding, input.byteAt(index + (1 as usize))) as uint8
        out.append((first << 2_u8) | (second >> 4_u8))
        if padding == 1 {
            let third = decodeValue(encoding, input.byteAt(index + (2 as usize))) as uint8
            out.append((second << 4_u8) | (third >> 2_u8))
        }
    }
    return .ok(out)
}

func decodeRaw(
    _ encoding: &Encoding,
    _ input: string,
) -> Result[List[uint8], DecodeError] {
    let len = input.byteLen()
    var index: usize = 0
    while index < len {
        match validateDataByte(encoding, input, index) {
            case .ok(_) => {}
            case .err(error) => return .err(error)
        }
        index += 1
    }

    let remainder = len % (4 as usize)
    if remainder == 1 {
        return .err(DecodeError(.invalidLength, len))
    }

    if remainder == 2 {
        let trailingIndex = len - (1 as usize)
        let trailing = decodeValue(encoding, input.byteAt(trailingIndex)) as uint8
        if trailing & 15_u8 != 0 {
            return .err(DecodeError(.nonCanonical, trailingIndex))
        }
    } else if remainder == 3 {
        let trailingIndex = len - (1 as usize)
        let trailing = decodeValue(encoding, input.byteAt(trailingIndex)) as uint8
        if trailing & 3_u8 != 0 {
            return .err(DecodeError(.nonCanonical, trailingIndex))
        }
    }

    let outputLen = match encoding.maxDecodedLen(len) {
        case .some(value) => value
        case .none => return .err(DecodeError(.invalidLength, len))
    }
    var out = List[uint8](withCapacity: outputLen)
    index = 0
    while len - index >= 4 {
        appendFullQuantum(
            &mut out,
            decodeValue(encoding, input.byteAt(index)) as uint8,
            decodeValue(encoding, input.byteAt(index + (1 as usize))) as uint8,
            decodeValue(encoding, input.byteAt(index + (2 as usize))) as uint8,
            decodeValue(encoding, input.byteAt(index + (3 as usize))) as uint8,
        )
        index += 4
    }

    if remainder >= 2 {
        let first = decodeValue(encoding, input.byteAt(index)) as uint8
        let second = decodeValue(encoding, input.byteAt(index + (1 as usize))) as uint8
        out.append((first << 2_u8) | (second >> 4_u8))
        if remainder == 3 {
            let third = decodeValue(encoding, input.byteAt(index + (2 as usize))) as uint8
            out.append((second << 4_u8) | (third >> 2_u8))
        }
    }
    return .ok(out)
}

/// Encode with the padded standard alphabet.
public func encode(_ bytes: Span[uint8]) -> string {
    let encoding: Encoding = .standard
    return encoding.encode(bytes)
}

/// Decode with the padded standard alphabet.
public func decode(_ input: string) -> Result[List[uint8], DecodeError] {
    let encoding: Encoding = .standard
    return encoding.decode(input)
}

/// Return the padded-standard encoded byte count.
public func encodedLen(_ inputLen: usize) -> usize? {
    let encoding: Encoding = .standard
    return encoding.encodedLen(inputLen)
}

/// Return the padded-standard maximum decoded byte count.
public func maxDecodedLen(_ inputLen: usize) -> usize? {
    let encoding: Encoding = .standard
    return encoding.maxDecodedLen(inputLen)
}

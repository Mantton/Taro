import std::optional::Optional
import std::panic::panic
import std::iter::{Iterator, Iterable}
import std::range::{Range, ClosedRange}

@lang("MaybeUninit")
public struct MaybeUninit[T] {
    private value: T
}

extend[T] MaybeUninit[T] {
    public static func new(_ value: T) -> Self {
        return MaybeUninit[T] { value }
    }

    /// Creates scanner-safe storage. Its zero bytes need not be a valid T;
    /// initialize the slot before any assumeInit operation.
    public static func uninit() -> Self {
        return std::intrinsic::__intrinsic_maybe_uninit[T]()
    }

    /// Zeroes storage without establishing that the bytes form a valid T.
    public static func zeroed() -> Self {
        return std::intrinsic::__intrinsic_maybe_uninit[T]()
    }

    public unsafe func assumeInit() -> T {
        return self.value
    }
}

/// A writable slice, also spelled `[Element; ..]`. Copies share the elements
/// but carry independent pointer/length headers. Subranges never copy elements.
/// A pointer into GC storage keeps that allocation alive, including after a
/// list/builder grows; the slice continues to address the old storage.
@lang("Span")
public struct Span[Element] {
    private ptr: *const Element
    private len: usize
}

extend[Element] Span[Element] {
    public func asPtr() -> *const Element { self.ptr }
    public func asMutPtr() -> *mut Element { unsafe { self.ptr as *mut Element } }

    /// Safety: the range must contain len initialized, aligned, writable
    /// elements. GC storage is retained by the pointer; native storage must
    /// stay valid for every use. A zero-length slice may have a null pointer.
    public static unsafe func from(_ ptr: *const Element, _ len: usize) -> Self {
        Self { ptr, len }
    }

    /// Safety: the same initialized-range requirements as the raw constructor.
    public static unsafe func from(_ ptr: *mut Element, _ len: usize) -> Self {
        Self { ptr: unsafe { ptr as *const Element }, len }
    }

    public func len() -> usize { self.len }
    public func isEmpty() -> bool { self.len == 0 }

    public func at(_ index: usize) -> &Element {
        if index >= self.len { panic("span index out of range") }
        // The reference's provenance is the span's element pointer. Projecting
        // from a local copy would heap-allocate that copy on every escaping call.
        ptr := self.asMutPtr().add(index)
        return unsafe { &*ptr }
    }

    public func get(_ index: usize) -> Optional[&Element] {
        if index >= self.len { return .none }
        return .some(self.at(index))
    }

    public func slice(_ start: usize, _ count: usize) -> Self {
        if start > self.len || count > self.len - start {
            panic("span slice out of range")
        }
        Self { ptr: self.ptr.add(start), len: count }
    }

    /// Safety: writes to this byte view must leave valid initialized elements,
    /// including valid managed pointers. This is a memory reinterpretation.
    public unsafe func asBytes() -> Span[uint8] {
        count := match checkedBufferByteCount[Element](self.len) {
            case .some(count) => count
            case .none => panic("span byte count overflow")
        }
        unsafe { Span[uint8]::from(self.ptr as *const uint8, count) }
    }
}

extend Span[uint8] {
    /// Copies immutable string bytes into independent writable GC storage.
    /// Mutating the result never changes the source string.
    public static func fromString(_ source: &string) -> Self {
        len := std::intrinsic::__intrinsic_string_len(source)
        bytes := NativeBytes::new(len)
        if len > 0 {
            unsafe {
                std::intrinsic::__intrinsic_memcpy(bytes.data(), std::intrinsic::__intrinsic_string_data(source), len)
                bytes.publish(len)
            }
        }
        unsafe { Self::from(bytes.data(), len) }
    }
}

extend[Element] Span[Element] {
    public subscript(index: usize) -> Element { address { self.at(index) } }

    /// A subrange shares storage and copies only the pointer/length header.
    public subscript(range: Range[usize]) -> Self {
        get {
            if range.start > range.end { panic("span range out of range") }
            self.slice(range.start, range.end - range.start)
        }
    }

    public subscript(range: ClosedRange[usize]) -> Self {
        get {
            if range.start > range.end || range.end >= self.len { panic("span range out of range") }
            self.slice(range.start, range.end - range.start + (1 as usize))
        }
    }
}

// Iterator aliases share a cursor, as for the other GC collection views.
final class SpanCursor[Element] {
    span: Span[Element]
    index: usize
}

extend[Element] SpanCursor[Element] {
    init(_ span: Span[Element]) { self.span = span; self.index = 0 }

    func next() -> Optional[Element] {
        if self.index >= self.span.len() { return .none }
        value := *self.span.at(self.index)
        self.index += 1
        return .some(value)
    }
}

public struct SpanIterator[Element] {
    private cursor: SpanCursor[Element]
}

extend[Element] SpanIterator[Element] {
    static func from(_ span: Span[Element]) -> Self { Self { cursor: SpanCursor(span) } }
}

conform[Element] SpanIterator[Element] to Iterator {
    type Element = Element
    public func next() -> Optional[Element] { self.cursor.next() }
}

conform[Element] Span[Element] to Iterable {
    type Iterator = SpanIterator[Element]
    type Element = Element
    public func iter() -> Self::Iterator { SpanIterator[Element]::from(self) }
}

public func sizeOf[T]() -> usize {
    std::intrinsic::__intrinsic_size_of[T]()
}

public func alignOf[T]() -> usize {
    std::intrinsic::__intrinsic_align_of[T]()
}

public func maxBufferBytes() -> usize {
    return (0xffffffffffffffff_u64 as usize) / (2 as usize)
}

public func maxBufferCapacity[T]() -> usize {
    elemSize := sizeOf[T]()
    if elemSize == 0 {
        return 0xffffffffffffffff_u64 as usize
    }
    return maxBufferBytes() / elemSize
}

public func checkedBufferByteCount[T](_ capacity: usize) -> usize? {
    elemSize := sizeOf[T]()
    if elemSize == 0 {
        return .some(0 as usize)
    }
    if capacity > maxBufferCapacity[T]() {
        return .none
    }
    return capacity.checkedMul(elemSize)
}

public func assertBufferCapacity[T](_ capacity: usize, _ message: string) {
    if capacity > maxBufferCapacity[T]() {
        panic(message)
    }
}

/// Exchanges two initialized values. Aliased references are allowed.
public func swap[T](_ x: &T, _ y: &T) {
    previous := *x
    *x = *y
    *y = previous
}

extend[T] &MaybeUninit[T] {
    public func asPtr() -> *const T {
        return unsafe { (&self.value as *const T) }
    }

    public func asMutPtr() -> *mut T {
        return unsafe { (&self.value as *mut T) }
    }

    /// Initializes the slot without reading its previous bytes. Until this
    /// write, assumeInit operations remain unsafe even though GC scanner bytes
    /// are zeroed by the compiler. Values and their managed pointers copy normally.
    public func write(_ value: T) -> &T {
        return unsafe {
            self.asMutPtr().write(value)
            self.assumeInitRef()
        }
    }

    public unsafe func assumeInitRead() -> T {
        return unsafe { self.asPtr().read() }
    }

    public unsafe func assumeInitRef() -> &T {
        ptr := self.asPtr()
        return unsafe { std::intrinsic::__intrinsic_ref_project(self, ptr) }
    }
}

conform[Element] SpanIterator[Element] to Iterable {
    type Element = Element
    type Iterator = SpanIterator[Element]
    public func iter() -> Self::Iterator { self }
}

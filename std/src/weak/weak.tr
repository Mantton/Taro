import std::optional::Optional

extern "taro_rt" {
    unsafe func __gc__weak_create(_ target: *const uint8) -> *mut uint8
    unsafe func __gc__weak_value(_ cell: *const uint8) -> *mut uint8
}

/// A non-owning reference to a GC-managed value's storage, as on main.
/// Copies share a weak cell. Collection clears its target after the last strong
/// reference dies. Interior references clear with their allocation; static
/// targets remain available. Unsafe foreign storage has a manual lifetime.
public struct Weak[Target] {
    private cell: *mut uint8
}

extend[Target] Weak[Target] {
    /// Creating a weak reference promotes referenced locals when necessary.
    public static func new(_ target: &Target) -> Self {
        Self { cell: unsafe { __gc__weak_create(target as *const uint8) } }
    }

    /// A successful snapshot is an ordinary strong reference. Holding it keeps
    /// the target alive independently of this weak cell. A cleared cell cannot
    /// resurrect its former target.
    public func value() -> Optional[&Target] {
        target := unsafe { __gc__weak_value(self.cell as *const uint8) }
        if unsafe { target as usize } == 0 { return .none }
        return .some(unsafe { target as &Target })
    }
}

import std.hash.{Hashable, Hasher}
import std.ops.{PartialEq, Add}
import std.mem.Span
import std.panic.panic
import std.iter.{Iterator, Iterable}
import std.optional.Optional
import std.collections.List
import std.rune.replacementCharacter
import std.intrinsic.{
    __intrinsic_string_from_parts,
    __intrinsic_string_data,
    __intrinsic_string_len,
}

public func stringFromParts(_ data: *mut uint8, _ len: usize) -> string {
    __intrinsic_string_from_parts(data, len)
}

public func stringData(_ s: string) -> *const uint8 {
    __intrinsic_string_data(s)
}

public func stringLen(_ s: string) -> usize {
    __intrinsic_string_len(s)
}

func stringCapacityOverflow() {
    panic("string capacity overflow")
}

func checkedStringAdd(_ lhs: usize, _ rhs: usize) -> usize {
    match lhs.checkedAdd(rhs) {
        case .some(value) => return value
        case .none => {
            stringCapacityOverflow()
            return 0 as usize
        }
    }
}

func checkedStringMul(_ lhs: usize, _ rhs: usize) -> usize {
    match lhs.checkedMul(rhs) {
        case .some(value) => return value
        case .none => {
            stringCapacityOverflow()
            return 0 as usize
        }
    }
}

func bytesMatchAt(_ haystack: string, _ needle: string, _ start: usize) -> bool {
    let needleLen = stringLen(needle)
    let haystackLen = stringLen(haystack)
    if start > haystackLen || needleLen > (haystackLen - start) {
        return false
    }

    let haystackData = stringData(haystack)
    let needleData = stringData(needle)
    var index: usize = 0
    while index < needleLen {
        if haystackData.add(start + index).read() != needleData.add(index).read() {
            return false
        }
        index += 1
    }
    return true
}

func findFrom(_ haystack: string, _ needle: string, _ start: usize) -> usize? {
    let haystackLen = stringLen(haystack)
    let needleLen = stringLen(needle)
    if start > haystackLen {
        return .none
    }
    if needleLen == 0 {
        return .some(start)
    }
    if needleLen > (haystackLen - start) {
        return .none
    }

    let limit = haystackLen - needleLen
    var index = start
    while index <= limit {
        if bytesMatchAt(haystack, needle, index) {
            return .some(index)
        }
        index += 1
    }
    return .none
}

func runeByteOffset(_ value: string, _ runeIndex: usize) -> usize? {
    let len = stringLen(value)
    var byteIndex: usize = 0
    var currentRune: usize = 0
    while currentRune < runeIndex {
        if byteIndex >= len {
            return .none
        }
        let (_, width) = decodeRune(value, byteIndex)
        byteIndex += width
        currentRune += 1
    }
    return .some(byteIndex)
}

func isUnicodeWhitespace(_ value: rune) -> bool {
    let scalar = value as uint32
    return (scalar >= 0x0009_u32 && scalar <= 0x000D_u32)
        || scalar == 0x0020_u32
        || scalar == 0x0085_u32
        || scalar == 0x00A0_u32
        || scalar == 0x1680_u32
        || (scalar >= 0x2000_u32 && scalar <= 0x200A_u32)
        || scalar == 0x2028_u32
        || scalar == 0x2029_u32
        || scalar == 0x202F_u32
        || scalar == 0x205F_u32
        || scalar == 0x3000_u32
}

func trimStartByteIndex(_ value: string) -> usize {
    let len = stringLen(value)
    var index: usize = 0
    while index < len {
        let (decoded, width) = decodeRune(value, index)
        if !isUnicodeWhitespace(decoded) {
            return index
        }
        index += width
    }
    return len
}

func trimEndByteIndex(_ value: string, _ start: usize) -> usize {
    let len = stringLen(value)
    var index = start
    var end = start
    while index < len {
        let (decoded, width) = decodeRune(value, index)
        index += width
        if !isUnicodeWhitespace(decoded) {
            end = index
        }
    }
    return end
}

func stringEq(_ lhs: string, _ rhs: string) -> bool {
    let lhs_len = stringLen(lhs)
    let rhs_len = stringLen(rhs)
    if lhs_len != rhs_len {
        return false
    }
    if lhs_len == 0 {
        return true
    }

    let lhs_ptr = stringData(lhs)
    let rhs_ptr = stringData(rhs)
    var idx: usize = 0

    while idx < lhs_len {
        if lhs_ptr.add(idx).read() != rhs_ptr.add(idx).read() {
            return false
        }
        idx += 1
    }

    return true
}

impl Hashable for string {
    public func hash[H: Hasher](&self, into hasher: &mut H) {
        let len = stringLen(*self)
        let data = stringData(*self)
        let bytes = Span[uint8].from(data, len)
        hasher.write(bytes)

        // Rust-style str hashing: append 0xff delimiter so sequential string
        // hashing remains prefix-safe ("ab","c" != "a","bc").
        let delimiter: [uint8; 1] = [0xff]
        hasher.write(delimiter.asSpan())
    }
}

impl PartialEq for string {
    public func eq(&self, _ other: &string) -> bool { stringEq(*self, *other) }
}

impl string {
    /// Returns true if the string has zero length.
    public func isEmpty(&self) -> bool {
        stringLen(*self) == 0
    }

    /// Returns the number of bytes in the string.
    public func byteLen(&self) -> usize {
        stringLen(*self)
    }

    /// Returns the number of decoded UTF-8 runes in the string.
    ///
    /// Each invalid UTF-8 byte counts as one replacement rune, matching
    /// `decodeRune` and `characters`.
    public func runeCount(&self) -> usize {
        let len = stringLen(*self)
        var byteIndex: usize = 0
        var count: usize = 0
        while byteIndex < len {
            let (_, width) = decodeRune(*self, byteIndex)
            byteIndex += width
            count += 1
        }
        return count
    }

    /// Returns a new string that is the concatenation of self and other.
    public func concat(&self, _ other: string) -> string {
        let self_len = stringLen(*self)
        let other_len = stringLen(other)
        let total = checkedStringAdd(self_len, other_len)
        var builder = Builder()
        builder.reserve(total)
        builder.writeString(*self)
        builder.writeString(other)
        return builder.intoString()
    }

    /// Returns true if the string contains the given needle as a contiguous byte substring.
    public func contains(&self, _ needle: string) -> bool {
        return findFrom(*self, needle, 0).isSome()
    }

    /// Returns the byte index of the first occurrence of `needle`.
    /// An empty needle is found at byte index zero.
    public func find(&self, _ needle: string) -> usize? {
        return findFrom(*self, needle, 0)
    }

    /// Returns the byte index of the last occurrence of `needle`.
    /// An empty needle is found at the end of the string.
    public func rfind(&self, _ needle: string) -> usize? {
        let selfLen = stringLen(*self)
        let needleLen = stringLen(needle)
        if needleLen == 0 {
            return .some(selfLen)
        }
        if needleLen > selfLen {
            return .none
        }

        var index = selfLen - needleLen
        loop {
            if bytesMatchAt(*self, needle, index) {
                return .some(index)
            }
            if index == 0 {
                break
            }
            index -= 1
        }
        return .none
    }

    /// Returns true if the string starts with the given prefix.
    public func startsWith(&self, _ prefix: string) -> bool {
        let self_len = stringLen(*self)
        let prefix_len = stringLen(prefix)
        if prefix_len > self_len {
            return false
        }
        if prefix_len == 0 {
            return true
        }

        let self_data = stringData(*self)
        let prefix_data = stringData(prefix)
        var i: usize = 0
        while i < prefix_len {
            if self_data.add(i).read() != prefix_data.add(i).read() {
                return false
            }
            i += 1
        }
        return true
    }

    /// Returns true if the string ends with the given suffix.
    public func endsWith(&self, _ suffix: string) -> bool {
        let self_len = stringLen(*self)
        let suffix_len = stringLen(suffix)
        if suffix_len > self_len {
            return false
        }
        if suffix_len == 0 {
            return true
        }

        let self_data = stringData(*self)
        let suffix_data = stringData(suffix)
        let offset = self_len - suffix_len
        var i: usize = 0
        while i < suffix_len {
            if self_data.add(offset + i).read() != suffix_data.add(i).read() {
                return false
            }
            i += 1
        }
        return true
    }

    /// Splits the string around every non-overlapping occurrence of `separator`.
    ///
    /// An empty separator splits at decoded rune boundaries. Invalid UTF-8
    /// bytes remain intact as one-byte elements. Splitting an empty string on
    /// an empty separator returns an empty list.
    public func split(&self, _ separator: string) -> List[string] {
        var parts = List[string]()
        let selfLen = stringLen(*self)
        let separatorLen = stringLen(separator)

        if separatorLen == 0 {
            var byteIndex: usize = 0
            while byteIndex < selfLen {
                let (_, width) = decodeRune(*self, byteIndex)
                parts.append(self.substring(byteIndex, width))
                byteIndex += width
            }
            return parts
        }

        var start: usize = 0
        loop {
            match findFrom(*self, separator, start) {
                case .some(index) => {
                    parts.append(self.substring(start, index - start))
                    start = index + separatorLen
                }
                case .none => break
            }
        }
        parts.append(self.substring(start, selfLen - start))
        return parts
    }

    /// Splits around the first occurrence of `separator`.
    /// Returns `(before, after)`, or none when the separator is absent.
    public func splitOnce(&self, _ separator: string) -> Optional[(string, string)] {
        match findFrom(*self, separator, 0) {
            case .some(index) => {
                let separatorLen = stringLen(separator)
                let afterStart = index + separatorLen
                let before = self.substring(0, index)
                let after = self.substring(afterStart, stringLen(*self) - afterStart)
                return .some((before, after))
            }
            case .none => return .none
        }
    }

    /// Returns newline-delimited lines without their terminators.
    ///
    /// A carriage return immediately before a newline is also removed. A
    /// trailing newline does not synthesize an additional empty line.
    public func lines(&self) -> List[string] {
        var result = List[string]()
        let len = stringLen(*self)
        if len == 0 {
            return result
        }

        var start: usize = 0
        var index: usize = 0
        while index < len {
            if self.byteAt(index) == 10_u8 {
                var end = index
                if end > start && self.byteAt(end - (1 as usize)) == 13_u8 {
                    end -= 1
                }
                result.append(self.substring(start, end - start))
                start = index + (1 as usize)
            }
            index += 1
        }

        if start < len {
            result.append(self.substring(start, len - start))
        }
        return result
    }

    /// Removes Unicode whitespace from both ends of the string.
    public func trim(&self) -> string {
        let start = trimStartByteIndex(*self)
        let end = trimEndByteIndex(*self, start)
        return self.substring(start, end - start)
    }

    /// Removes Unicode whitespace from the start of the string.
    public func trimStart(&self) -> string {
        let start = trimStartByteIndex(*self)
        return self.substring(start, stringLen(*self) - start)
    }

    /// Removes Unicode whitespace from the end of the string.
    public func trimEnd(&self) -> string {
        let end = trimEndByteIndex(*self, 0)
        return self.substring(0, end)
    }

    /// Replaces the first occurrence of `old` with `replacement`.
    public func replace(&self, _ old: string, _ replacement: string) -> string {
        let index = match findFrom(*self, old, 0) {
            case .some(value) => value
            case .none => return *self
        }

        let selfLen = stringLen(*self)
        let oldLen = stringLen(old)
        let replacementLen = stringLen(replacement)
        let resultLen = checkedStringAdd(selfLen - oldLen, replacementLen)
        let afterStart = index + oldLen

        var builder = Builder()
        builder.reserve(resultLen)
        builder.writeStringRange(*self, 0, index)
        builder.writeString(replacement)
        builder.writeStringRange(*self, afterStart, selfLen - afterStart)
        return builder.intoString()
    }

    /// Replaces every non-overlapping occurrence of `old`.
    ///
    /// An empty `old` matches before the first rune and after every decoded
    /// rune, including one-byte invalid UTF-8 units.
    public func replaceAll(&self, _ old: string, _ replacement: string) -> string {
        let selfLen = stringLen(*self)
        let oldLen = stringLen(old)

        if oldLen == 0 {
            if stringLen(replacement) == 0 {
                return *self
            }

            var builder = Builder()
            builder.reserve(selfLen)
            builder.writeString(replacement)
            var byteIndex: usize = 0
            while byteIndex < selfLen {
                let (_, width) = decodeRune(*self, byteIndex)
                builder.writeStringRange(*self, byteIndex, width)
                builder.writeString(replacement)
                byteIndex += width
            }
            return builder.intoString()
        }

        var builder = Builder()
        builder.reserve(selfLen)
        var start: usize = 0
        var replaced = false
        loop {
            match findFrom(*self, old, start) {
                case .some(index) => {
                    builder.writeStringRange(*self, start, index - start)
                    builder.writeString(replacement)
                    start = index + oldLen
                    replaced = true
                }
                case .none => break
            }
        }

        if !replaced {
            return *self
        }
        builder.writeStringRange(*self, start, selfLen - start)
        return builder.intoString()
    }

    /// Returns `count` consecutive copies of this string.
    public func repeat(&self, _ count: usize) -> string {
        if count == 0 || self.isEmpty() {
            return ""
        }
        if count == 1 {
            return *self
        }

        let totalLen = checkedStringMul(stringLen(*self), count)
        var builder = Builder()
        builder.reserve(totalLen)
        var index: usize = 0
        while index < count {
            builder.writeString(*self)
            index += 1
        }
        return builder.intoString()
    }

    /// Returns a new string consisting of `count` bytes starting at byte index `start`.
    /// Panics if the range is out of bounds.
    public func substring(&self, _ start: usize, _ count: usize) -> string {
        let self_len = stringLen(*self)
        if start > self_len || count > (self_len - start) {
            panic("string.substring: range out of bounds")
        }
        if count == 0 {
            return ""
        }
        let buf = std.mem.allocBytes(count)
        stringData(*self).add(start).readBytes(buf, count)
        stringFromParts(buf, count)
    }

    /// Returns `count` bytes starting at byte index `start`.
    ///
    /// This operation may split a UTF-8 encoding. Use `sliceRunes` when the
    /// result must start and end at decoded rune boundaries.
    public func sliceBytes(&self, _ start: usize, _ count: usize) -> string {
        return self.substring(start, count)
    }

    /// Returns `count` decoded runes starting at rune index `start`.
    ///
    /// Invalid UTF-8 bytes each count as one rune and are preserved verbatim.
    /// Panics if the rune range is out of bounds.
    public func sliceRunes(&self, _ start: usize, _ count: usize) -> string {
        let endRune = match start.checkedAdd(count) {
            case .some(value) => value
            case .none => panic("string.sliceRunes: range out of bounds")
        }
        let startByte = match runeByteOffset(*self, start) {
            case .some(value) => value
            case .none => panic("string.sliceRunes: range out of bounds")
        }
        let endByte = match runeByteOffset(*self, endRune) {
            case .some(value) => value
            case .none => panic("string.sliceRunes: range out of bounds")
        }
        return self.substring(startByte, endByte - startByte)
    }

    /// Returns the byte at the given index.
    /// Panics if the index is out of bounds.
    public func byteAt(&self, _ index: usize) -> uint8 {
        let self_len = stringLen(*self)
        if index >= self_len {
            panic("string.byteAt: index out of bounds")
        }
        stringData(*self).add(index).read()
    }

    /// Returns a `ByteIterator` for the bytes of this string.
    public func bytes(&self) -> ByteIterator {
        ByteIterator {
            s: *self,
            pos: 0,
        }
    }

    /// Returns a `CharacterIterator` for the UTF-8 scalar values (runes) of this string.
    public func characters(&self) -> CharacterIterator {
        CharacterIterator {
            s: *self,
            pos: 0,
        }
    }

    public func decodeRune(self, _ index: usize) -> (rune, usize) {
        decodeRune(self, index)
    }
}

impl Add for string {
    public func add(self, rhs: string) -> string {
        self.concat(rhs)
    }
}

/// Decodes the first UTF-8 encoded rune in the string slice starting at the given byte index.
/// Returns a tuple containing the decoded rune and its width in bytes.
/// If the encoding is invalid, returns the replacement character (U+FFFD) and a width of 1 byte.
/// If the index is out of bounds, returns the replacement character and a width of 0.
public func decodeRune(_ s: string, _ startIndex: usize) -> (rune, usize) {
    let len = stringLen(s)
    if startIndex >= len {
        return (replacementCharacter(), 0)
    }

    let ptr = stringData(s).add(startIndex)
    let b0 = ptr.read() as uint32
    let rem = len - startIndex

    if b0 < 0x80 {
        return (std.intrinsic.__intrinsic_rune_from_u32_unchecked(b0), 1)
    }

    if b0 < 0xC2 || b0 > 0xF4 || rem < 2 {
        return (replacementCharacter(), 1)
    }

    let b1 = ptr.add(1).read() as uint32
    if b1 < 0x80 || b1 > 0xBF {
        return (replacementCharacter(), 1)
    }

    if b0 < 0xE0 {
        let r = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
        return (std.intrinsic.__intrinsic_rune_from_u32_unchecked(r), 2)
    }

    if rem < 3 {
        return (replacementCharacter(), 1)
    }

    let b2 = ptr.add(2).read() as uint32
    if b2 < 0x80 || b2 > 0xBF {
        return (replacementCharacter(), 1)
    }

    if b0 < 0xF0 {
        if b0 == 0xE0 && b1 < 0xA0 {
            return (replacementCharacter(), 1) // Overlong encoding
        }
        if b0 == 0xED && b1 > 0x9F {
            return (replacementCharacter(), 1) // Surrogate half
        }
        let r = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
        return (std.intrinsic.__intrinsic_rune_from_u32_unchecked(r), 3)
    }

    if rem < 4 {
        return (replacementCharacter(), 1)
    }

    let b3 = ptr.add(3).read() as uint32
    if b3 < 0x80 || b3 > 0xBF {
        return (replacementCharacter(), 1)
    }

    if b0 == 0xF0 && b1 < 0x90 {
        return (replacementCharacter(), 1) // Overlong encoding
    }
    if b0 == 0xF4 && b1 > 0x8F {
        return (replacementCharacter(), 1) // Too large
    }

    let r = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
    return (std.intrinsic.__intrinsic_rune_from_u32_unchecked(r), 4)
}

/// An iterator over the individual bytes of a string.
public struct ByteIterator {
    s: string
    pos: usize
}

impl Iterator for ByteIterator {
    type Element = uint8

    public func next(&mut self) -> Optional[uint8] {
        if self.pos < stringLen(self.s) {
            let b = self.s.byteAt(self.pos)
            self.pos += 1
            return .some(b)
        }
        return .none
    }
}

impl Iterable for ByteIterator {
    type Element = uint8
    type Iterator = ByteIterator
    public func iter(self) -> ByteIterator { self }
}

/// An iterator over the individual UTF-8 characters (runes) of a string.
public struct CharacterIterator {
    s: string
    pos: usize
}

impl Iterator for CharacterIterator {
    type Element = rune

    public func next(&mut self) -> Optional[rune] {
        if self.pos < stringLen(self.s) {
            let (r, width) = decodeRune(self.s, self.pos)
            self.pos += width
            return .some(r)
        }
        return .none
    }
}

impl Iterable for CharacterIterator {
    type Element = rune
    type Iterator = CharacterIterator
    public func iter(self) -> CharacterIterator { self }
}

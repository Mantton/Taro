/// Repeatable calls over a persistent environment. Closure literals share
/// captured variables; callers synchronize concurrent access when necessary.
@lang("Fn")
public interface Fn[Args: Tuple, Output] {
    func call(args: Args) -> Output
}

/// Each invocation creates a new future over the same environment. Calls may
/// overlap; completion of one call does not consume the callable.
@lang("AsyncFn")
public interface AsyncFn[Args: Tuple, Output] {
    func call(args: Args) async -> Output
}

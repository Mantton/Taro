// Operators use ordinary receivers and value arguments. Reference targets
// mutate existing storage; value targets can mutate shared state.
@lang("BitAnd")
public interface BitAnd[Rhs=Self] {
    type Output = Self
    func bitand(_ rhs: Rhs) -> Self::Output
}

@lang("BitAndAssign")
public interface BitAndAssign[Rhs=Self] {
    func bitandAssign(_ rhs: Rhs)
}

@lang("BitOr")
public interface BitOr[Rhs=Self] {
    type Output = Self
    func bitor(_ rhs: Rhs) -> Self::Output
}

@lang("BitOrAssign")
public interface BitOrAssign[Rhs=Self] {
    func bitorAssign(_ rhs: Rhs)
}

@lang("BitXor")
public interface BitXor[Rhs=Self] {
    type Output = Self
    func bitxor(_ rhs: Rhs) -> Self::Output
}

@lang("BitXorAssign")
public interface BitXorAssign[Rhs=Self] {
    func bitxorAssign(_ rhs: Rhs)
}

@lang("Shl")
public interface Shl[Rhs=Self] {
    type Output = Self
    func shl(_ rhs: Rhs) -> Self::Output
}

@lang("ShlAssign")
public interface ShlAssign[Rhs=Self] {
    func shlAssign(_ rhs: Rhs)
}

@lang("Shr")
public interface Shr[Rhs=Self] {
    type Output = Self
    func shr(_ rhs: Rhs) -> Self::Output
}

@lang("ShrAssign")
public interface ShrAssign[Rhs=Self] {
    func shrAssign(_ rhs: Rhs)
}

@lang("BitNot")
public interface BitNot {
    type Output = Self
    func bitnot() -> Self::Output
}

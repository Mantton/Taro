// Operators use ordinary receivers and value arguments. Reference targets
// mutate existing storage; value targets can mutate shared state.
@lang("Add")
public interface Add[Rhs=Self] {
    type Output = Self
    func add(_ rhs: Rhs) -> Self::Output
}

@lang("AddAssign")
public interface AddAssign[Rhs=Self] {
    func addAssign(_ rhs: Rhs)
}

@lang("Sub")
public interface Sub[Rhs=Self] {
    type Output = Self
    func sub(_ rhs: Rhs) -> Self::Output
}

@lang("SubAssign")
public interface SubAssign[Rhs=Self] {
    func subAssign(_ rhs: Rhs)
}

@lang("Mul")
public interface Mul[Rhs=Self] {
    type Output = Self
    func mul(_ rhs: Rhs) -> Self::Output
}

@lang("MulAssign")
public interface MulAssign[Rhs=Self] {
    func mulAssign(_ rhs: Rhs)
}

@lang("Div")
public interface Div[Rhs=Self] {
    type Output = Self
    func div(_ rhs: Rhs) -> Self::Output
}

@lang("DivAssign")
public interface DivAssign[Rhs=Self] {
    func divAssign(_ rhs: Rhs)
}

@lang("Rem")
public interface Rem[Rhs=Self] {
    type Output = Self
    func rem(_ rhs: Rhs) -> Self::Output
}

@lang("RemAssign")
public interface RemAssign[Rhs=Self] {
    func remAssign(_ rhs: Rhs)
}

/// A numeric type with additive and multiplicative identity values (`zero`, `one`)
/// and closed arithmetic operations (`+`, `-`, `*`, `/`, `%`).
public interface Numeric: Add[Self, Output = Self], Sub[Self, Output = Self], Mul[Self, Output = Self], Div[Self, Output = Self], Rem[Self, Output = Self], PartialEq[Self] {
    /// Returns the additive identity (`0`).
    static func zero() -> Self

    /// Returns the multiplicative identity (`1`).
    static func one() -> Self
}

/// A signed numeric type supporting unary negation and absolute value in addition to `Numeric`.
public interface SignedNumeric: Numeric, Neg[Output = Self] {
    /// Returns the absolute value of `self`.
    func abs() -> Self
}

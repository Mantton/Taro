import std.fmt.Display
import std.marker.Copy
import std.ops.PartialEq
import std.result.Result

/// Interface for constructing a value from another type.
///
/// `From[T]` provides a standard way to create a value of the implementing
/// type from a value of type `T`. This is the primary conversion interface
/// and should be preferred over `Into` when implementing conversions.
///
/// Example:
/// ```
/// struct Meters {
///     value: double
/// }
///
/// impl From[double] for Meters {
///     public func from(_ value: double) -> Meters {
///         Meters { value: value }
///     }
/// }
///
/// let m = Meters.from(3.5)
/// ```
@lang("From")
public interface From[T] {
    func from(_ value: T) -> Self
}

/// Interface for converting a value into another type.
///
/// `Into[T]` provides a standard way to convert the implementing type
/// into a value of type `T`. Prefer implementing `From` instead of `Into`,
/// as `From` is more flexible and `Into` can be implemented in terms of `From`.
///
/// Example:
/// ```
/// func acceptString[T: Into[string]](_ value: T) -> string {
///     value.into()
/// }
/// ```
public interface Into[T] {
    func into(self) -> T
}

/// The category of a scalar parsing failure.
public enum ParseErrorKind: Copy, PartialEq {
    /// The input contains no bytes.
    case empty
    /// A byte is not a digit in the requested radix.
    case invalidDigit
    /// The input does not match the scalar's accepted syntax.
    case invalidFormat
    /// The parsed value is greater than the type can represent.
    case overflow
    /// The parsed value is less than the type can represent.
    case underflow
}

/// A typed scalar parsing failure with its offending byte index.
///
/// The index points at the first invalid or range-crossing byte. When a
/// required component is missing at the end of the input, the index equals
/// the input's byte length.
public struct ParseError: Copy {
    kindValue: ParseErrorKind
    indexValue: usize
}

impl ParseError {
    /// Construct a parse error for `kind` at `index`.
    public func new(_ kind: ParseErrorKind, _ index: usize) -> Self {
        ParseError {
            kindValue: kind,
            indexValue: index,
        }
    }

    /// Return the category of this parsing failure.
    public func kind(&self) -> ParseErrorKind {
        self.kindValue
    }

    /// Return the offending byte index.
    public func index(&self) -> usize {
        self.indexValue
    }
}

impl std.fmt.Display for ParseErrorKind {
    public func display(&self, _ into: &mut std.fmt.Formatter) {
        match self {
            case .empty => into.writeString("empty input")
            case .invalidDigit => into.writeString("invalid digit")
            case .invalidFormat => into.writeString("invalid format")
            case .overflow => into.writeString("value overflows target type")
            case .underflow => into.writeString("value underflows target type")
        }
    }
}

impl std.fmt.Display for ParseError {
    public func display(&self, _ into: &mut std.fmt.Formatter) {
        self.kindValue.display(into)
        into.writeString(" at byte ")
        self.indexValue.display(into)
    }
}

impl std.error.Error for ParseError {}

/// Interface for constructing a value from its textual representation.
///
/// Implementations do not trim input implicitly. Invalid user input is
/// returned as `ParseError` and must not panic.
public interface Parse {
    func parse(_ input: string) -> Result[Self, ParseError]
}

/// Parse `input` as `T` using its `Parse` implementation.
public func parse[T: Parse](_ input: string) -> Result[T, ParseError] {
    T.parse(input)
}

import std::panic::panic
import std::marker::Clone
import std::ops::{Fn, PartialEq}
import std::default::Default
import std::hash::{Hashable, Hasher}
import std::cmp::{Ord, Ordering, PartialOrd}

/// An optional value that may or may not contain a wrapped value.
///
/// `Optional[T]` represents either `.some(value)` containing a value of type T,
/// or `.none` representing the absence of a value.
///
/// The shorthand syntax `T?` is equivalent to `Optional[T]`.
@lang("Optional")
public enum Optional[Wrapped] {
    case some(Wrapped)
    case none
}

extend[Wrapped] Optional[Wrapped] {
    /// Create an Optional containing the given value.
    @inline
    public static func new(_ wrapped: Wrapped) -> Self {
        .some(wrapped)
    }

    /// Returns true if the optional contains a value.
    @inline
    public func isSome() -> bool {
        match self {
            case .some(_) => true
            case .none => false
        }
    }

    /// Returns true if the optional is empty.
    @inline
    public func isNone() -> bool {
        match self {
            case .none => true
            case .some(_) => false
        }
    }
}

conform[Wrapped] Optional[Wrapped] to Default {
    public static func default() -> Self {
        .none
    }
}

// Optional introduces no sharing beyond its payload.

conform[Wrapped] Optional[Wrapped] to Clone where Wrapped: Clone {
    public func clone() -> Self {
        match self {
            case .some(v) => .some(v.clone())
            case .none => .none
        }
    }
}

extend[Wrapped: Clone] Optional[&Wrapped] {
    /// Converts an `Optional[&Wrapped]` into an `Optional[Wrapped]` by cloning
    /// the referenced value.
    public func cloned() -> Optional[Wrapped] {
        match self {
            case .some(v) => .some((*v).clone())
            case .none => .none
        }
    }
}

extend[Wrapped] Optional[&Wrapped] {
    /// Converts an `Optional[&Wrapped]` into an `Optional[Wrapped]` by copying
    /// the referenced value.
    public func copied() -> Optional[Wrapped] {
        match self {
            case .some(v) => .some(*v)
            case .none => .none
        }
    }
}

// Unwrapping methods
extend[Wrapped] Optional[Wrapped] {
    /// Returns the contained value, panicking if none.
    ///
    /// Panics with a generic message if the optional is none.
    /// Prefer `expect` if you want a custom panic message.
    public func unwrap() -> Wrapped {
        match self {
            case .some(v) => {
                v
            }
            case .none => {
                panic("called unwrap on a none value")
            }
        }
    }

    /// Returns the contained value, panicking with the given message if none.
    public func expect(_ message: string) -> Wrapped {
        match self {
            case .some(v) => {
                v
            }
            case .none => {
                panic(message)
            }
        }
    }

    /// Returns the contained value or a default.
    @inline
    public func unwrapOr(_ default: Wrapped) -> Wrapped {
        match self {
            case .some(v) => v
            case .none => default
        }
    }

    /// Returns the contained value or computes it from a closure.
    public func unwrapOrElse[F: Fn[(), Wrapped]](_ f: F) -> Wrapped {
        match self {
            case .some(v) => v
            case .none => f()
        }
    }
}

// Transformation methods
extend[Wrapped] Optional[Wrapped] {
    /// Transforms the contained value using a function.
    ///
    /// Returns `.none` if the optional is none, otherwise returns
    /// `.some(f(value))`.
    public func map[U, F: Fn[Wrapped, U]](_ f: F) -> Optional[U] {
        match self {
            case .some(v) => .some(f(v))
            case .none => .none
        }
    }

    /// Transforms the contained value using a function that returns an Optional.
    ///
    /// This is useful for chaining operations that may fail.
    public func flatMap[U, F: Fn[Wrapped, Optional[U]]](_ f: F) -> Optional[U] {
        match self {
            case .some(v) => f(v)
            case .none => .none
        }
    }

    /// Returns the optional if it contains a value matching the predicate.
    public func filter[F: Fn[&Wrapped, bool]](_ predicate: F) -> Optional[Wrapped] {
        match self {
            case .some(v) => {
                if predicate(&v) {
                    .some(v)
                } else {
                    .none
                }
            }
            case .none => .none
        }
    }
}

// Boolean combinators
extend[Wrapped] Optional[Wrapped] {
    /// Returns `.none` if self is `.none`, otherwise returns `other`.
    @inline
    public func and[U](_ other: Optional[U]) -> Optional[U] {
        match self {
            case .some(_) => other
            case .none => .none
        }
    }
}

extend[Wrapped] Optional[Wrapped] {
    /// Returns the option if it contains a value, otherwise returns `other`.
    @inline
    public func or(_ other: Self) -> Self {
        match self {
            case .some(v) => .some(v)
            case .none => other
        }
    }

    /// Returns the option if it contains a value, otherwise calls `f` and returns the result.
    @inline
    public func orElse[F: Fn[(), Self]](_ f: F) -> Self {
        match self {
            case .some(v) => .some(v)
            case .none => f()
        }
    }
}

/// Convenience function to create a Some value.
public func Some[T](_ value: T) -> T? {
    .some(value)
}

/// Convenience function to create a None value.
public func None[T]() -> T? {
    .none
}

extend[Wrapped] &Optional[Wrapped] {
    /// Takes the value out of the optional, leaving a `.none` in its place.
    public func take() -> Optional[Wrapped] {
        previous := *self
        *self = .none
        previous
    }
}

conform[Wrapped: PartialEq] Optional[Wrapped] to PartialEq {
    public func eq(_ other: Optional[Wrapped]) -> bool {
        match (self, other) {
            case (.none, .none) => true
            case (.some(a), .some(b)) => a == b
            case _ => false
        }
    }
}

conform[Wrapped: Hashable] Optional[Wrapped] to Hashable {
    public func hash[H: Hasher](into hasher: H) {
        match self {
            case .none => 0_u8.hash(into: hasher)
            case .some(value) => {
                1_u8.hash(into: hasher)
                value.hash(into: hasher)
            }
        }
    }
}

conform[Wrapped: PartialOrd] Optional[Wrapped] to PartialOrd {
    public func partialCmp(_ other: Optional[Wrapped]) -> Optional[Ordering] {
        match (self, other) {
            case (.none, .none) => .some(.equal)
            case (.none, .some(_)) => .some(.less)
            case (.some(_), .none) => .some(.greater)
            case (.some(a), .some(b)) => a.partialCmp(b)
        }
    }
}

conform[Wrapped: Ord] Optional[Wrapped] to Ord {
    public func cmp(_ other: Optional[Wrapped]) -> Ordering {
        match (self, other) {
            case (.none, .none) => .equal
            case (.none, .some(_)) => .less
            case (.some(_), .none) => .greater
            case (.some(a), .some(b)) => a.cmp(b)
        }
    }
}

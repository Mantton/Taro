public struct CString {
    private storage: std::mem::NativeBytes
}

extend CString {
    /// Construct a NUL-terminated copy when `value` contains no embedded NUL.
    ///
    /// C APIs interpret the first NUL as the end of a string, so callers that
    /// accept untrusted text should use this constructor and return a typed
    /// invalid-input error rather than silently operating on a path prefix.
    public static func tryNew(_ value: string) -> CString? {
        len := std::string::stringLen(value)
        data := std::string::stringData(value)
        var index: usize = 0
        while index < len {
            if unsafe { data.add(index).read() } == 0_u8 {
                return .none
            }
            index += 1
        }
        return .some(CString::new(value))
    }

    public static func new(_ value: string) -> CString {
        len := std::string::stringLen(value)
        data := std::string::stringData(value)
        capacity := match len.checkedAdd(1 as usize) {
            case .some(value) => value
            case .none => std::panic::panic("C string capacity overflow")
        }
        var storage = std::mem::NativeBytes::new(capacity)
        buffer := storage.data()

        if len > 0 {
            unsafe { data.readBytes(buffer, len) }
        }
        unsafe { buffer.add(len).write(0); storage.publish(capacity) }

        return CString {
            storage,
        }
    }

    /// A Taro pointer keeps the managed bytes alive independently of this
    /// wrapper. Native code must copy or explicitly root bytes kept past a call.
    public func asPtr() -> *const uint8 {
        return unsafe { self.storage.data() as *const uint8 }
    }
}

import std::ffi::CString
import std::io::Error
import std::libc
import std::result::Result

extern "blocking" {
    unsafe func __rt__open2(_ path: *const uint8, _ oflags: int32) -> int32
    unsafe func __rt__open3(_ path: *const uint8, _ oflags: int32, _ mode: int32) -> int32
    unsafe func __rt__fs_metadata(
        _ path: string,
        _ followSymlinks: bool,
        _ fileTypeOut: *mut uint8,
        _ lenOut: *mut uint64,
        _ modifiedSecsOut: *mut int64,
        _ modifiedNanosOut: *mut uint32,
        _ accessedSecsOut: *mut int64,
        _ accessedNanosOut: *mut uint32,
    ) -> int32
    unsafe func __rt__fs_dir_open(_ path: string, _ errorOut: *mut int32) -> usize
    unsafe func __rt__fs_dir_read(
        _ handle: usize,
        _ nameOut: *mut *mut uint8,
        _ lenOut: *mut usize,
        _ fileTypeOut: *mut uint8,
    ) -> int32
    unsafe func __rt__fs_dir_close(_ handle: usize) -> int32
    unsafe func __rt__fs_remove_dir_all(_ path: string) -> int32
    unsafe func __rt__fs_copy(_ from: string, _ to: string, _ copiedOut: *mut uint64) -> int32
    unsafe func __rt__fs_canonicalize(_ path: string, _ dataOut: *mut *mut uint8, _ lenOut: *mut usize) -> int32
    unsafe func __rt__fs_create_temp_dir(
        _ parent: string,
        _ prefix: string,
        _ dataOut: *mut *mut uint8,
        _ lenOut: *mut usize,
    ) -> int32
}

extern "taro_rt" {
    unsafe func __rt__fs_owned_bytes_free(_ data: *mut uint8)
}

/// Copies share the descriptor through one lease; see `std::sys::io::unix`.
public struct PlatformFile {
    internal lease: uint64
}

public struct PlatformDir {
    internal handle: usize
}

public const FILE_TYPE_REGULAR: uint8 = 1_u8
public const FILE_TYPE_DIRECTORY: uint8 = 2_u8
public const FILE_TYPE_SYMLINK: uint8 = 3_u8
public const FILE_TYPE_BLOCK_DEVICE: uint8 = 4_u8
public const FILE_TYPE_CHARACTER_DEVICE: uint8 = 5_u8
public const FILE_TYPE_FIFO: uint8 = 6_u8
public const FILE_TYPE_SOCKET: uint8 = 7_u8
public const FILE_TYPE_OTHER: uint8 = 8_u8

public struct RawMetadata {
    fileTypeValue: uint8
    lenValue: uint64
    modifiedSecsValue: int64
    modifiedNanosValue: uint32
    accessedSecsValue: int64
    accessedNanosValue: uint32
}

extend RawMetadata {
    public func fileType() -> uint8 { self.fileTypeValue }
    public func len() -> uint64 { self.lenValue }
    public func modifiedSeconds() -> int64 { self.modifiedSecsValue }
    public func modifiedNanoseconds() -> uint32 { self.modifiedNanosValue }
    public func accessedSeconds() -> int64 { self.accessedSecsValue }
    public func accessedNanoseconds() -> uint32 { self.accessedNanosValue }
}

public struct RawDirEntry {
    nameValue: string
    fileTypeValue: uint8
}

extend RawDirEntry {
    public func name() -> string { self.nameValue }
    public func fileType() -> uint8 { self.fileTypeValue }
}

const DEFAULT_FILE_MODE: int32 = 438
const DEFAULT_DIR_MODE: int32 = 511

func invalidPathError(_ operation: string, _ path: string) -> Error {
    Error::new(.invalidInput).withOperation(operation).withPath(path)
}

func checkedPath(_ path: string, _ operation: string) -> Result[CString, Error] {
    match CString::tryNew(path) {
        case .some(value) => return .ok(value)
        case .none => return .err(invalidPathError(operation, path))
    }
}

public func openReadOnly(_ path: string) -> Result[PlatformFile, Error] {
    openFile(path, true, false, false, false, false)
}

public func createWrite(_ path: string) -> Result[PlatformFile, Error] {
    openFile(path, false, true, false, true, true)
}

public func openWithOptions(
    _ path: string,
    _ read: bool,
    _ write: bool,
    _ append: bool,
    _ create: bool,
    _ truncate: bool,
) -> Result[PlatformFile, Error] {
    openFile(path, read, write, append, create, truncate)
}

func openFile(
    _ path: string,
    _ read: bool,
    _ write: bool,
    _ append: bool,
    _ create: bool,
    _ truncate: bool,
) -> Result[PlatformFile, Error] {
    if !read && !write && !append {
        return .err(Error::new(.invalidInput).withOperation("open").withPath(path))
    }

    if create && !write && !append {
        return .err(Error::new(.invalidInput).withOperation("open").withPath(path))
    }

    if truncate && !write && !append {
        return .err(Error::new(.invalidInput).withOperation("open").withPath(path))
    }

    if append && truncate {
        return .err(Error::new(.invalidInput).withOperation("open").withPath(path))
    }

    var access = std::libc::O_RDONLY
    if append {
        access = if read { std::libc::O_RDWR } else { std::libc::O_WRONLY }
    } else if read && write {
        access = std::libc::O_RDWR
    } else if write {
        access = std::libc::O_WRONLY
    } else {
        access = std::libc::O_RDONLY
    }

    var flags = access
    if append {
        flags = flags | std::libc::O_APPEND
    }
    if create {
        flags = flags | std::libc::O_CREAT
    }
    if truncate {
        flags = flags | std::libc::O_TRUNC
    }

    cpath := match checkedPath(path, "open") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    fd := if create {
        unsafe { __rt__open3(cpath.asPtr(), flags, DEFAULT_FILE_MODE) }
    } else {
        unsafe { __rt__open2(cpath.asPtr(), flags) }
    }
    if fd < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("open").withPath(path))
    }

    return .ok(PlatformFile { lease: std::sys::io::unix::leaseOpen(fd) })
}

public func symlink(_ target: string, _ linkPath: string) -> Result[(), Error] {
    ctarget := match CString::tryNew(target) {
        case .some(value) => value
        case .none => return .err(Error::new(.invalidInput).withOperation("symlink").withPaths(target, linkPath))
    }
    clink := match CString::tryNew(linkPath) {
        case .some(value) => value
        case .none => return .err(Error::new(.invalidInput).withOperation("symlink").withPaths(target, linkPath))
    }
    res := unsafe { std::libc::symlink(ctarget.asPtr(), clink.asPtr()) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("symlink").withPaths(target, linkPath))
    }
    return .ok(())
}

/// Close the descriptor once no read, write or seek is using it. The file is
/// invalid afterwards even when the deferred close reports an error.
public func close(_ file: &PlatformFile) -> Result[(), Error] {
    if file.lease == 0 {
        return .ok(())
    }

    lease := file.lease
    file.lease = 0
    std::sys::io::unix::leaseClose(lease, "close")
}

public func isValid(_ file: &PlatformFile) -> bool {
    file.lease != 0
}

/// Move the descriptor out of `file`, leaving it permanently invalid.
public func take(_ file: &PlatformFile) -> PlatformFile {
    lease := file.lease
    file.lease = 0
    return PlatformFile { lease }
}

public func read(_ file: &PlatformFile, _ buf: *mut uint8, _ len: usize) -> Result[usize, Error] {
    lease := file.lease
    fd := match std::sys::io::unix::leaseAcquire(lease, "read") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    res := unsafe { std::libc::read(fd, buf, len) }
    var result: Result[usize, Error] = if res < 0 {
        .err(std::sys::io::unix::lastError().withOperation("read"))
    } else {
        .ok(res as usize)
    }
    std::sys::io::unix::leaseRelease(lease)
    return result
}

public func write(_ file: &PlatformFile, _ buf: *const uint8, _ len: usize) -> Result[usize, Error] {
    lease := file.lease
    fd := match std::sys::io::unix::leaseAcquire(lease, "write") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    res := unsafe { std::libc::write(fd, buf, len) }
    var result: Result[usize, Error] = if res < 0 {
        .err(std::sys::io::unix::lastError().withOperation("write"))
    } else {
        .ok(res as usize)
    }
    std::sys::io::unix::leaseRelease(lease)
    return result
}

public func seek(_ file: &PlatformFile, _ offset: isize, _ whence: int32) -> Result[isize, Error] {
    lease := file.lease
    fd := match std::sys::io::unix::leaseAcquire(lease, "seek") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    res := std::libc::lseek(fd, offset, whence)
    var result: Result[isize, Error] = if res < 0 {
        .err(std::sys::io::unix::lastError().withOperation("seek"))
    } else {
        .ok(res)
    }
    std::sys::io::unix::leaseRelease(lease)
    return result
}

/// Transfer the descriptor to the async reactor. Fails while another copy of
/// the file has an operation in flight.
public func intoAsyncStream(_ file: &PlatformFile) -> Result[std::sys::io::RawAsyncStream, Error] {
    if file.lease == 0 {
        return .err(Error::new(.invalidInput).withOperation("adopt file stream"))
    }

    fd := match std::sys::io::unix::leaseTake(file.lease, "adopt file stream") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    file.lease = 0
    std::sys::io::adoptFd(fd)
}

public func createDir(_ path: string) -> Result[(), Error] {
    cpath := match checkedPath(path, "create directory") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    res := unsafe { std::libc::mkdir(cpath.asPtr(), DEFAULT_DIR_MODE as std::libc::mode_t) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("create directory").withPath(path))
    }
    return .ok(())
}

public func removeDir(_ path: string) -> Result[(), Error] {
    cpath := match checkedPath(path, "remove directory") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    res := unsafe { std::libc::rmdir(cpath.asPtr()) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("remove directory").withPath(path))
    }
    return .ok(())
}

public func removeFile(_ path: string) -> Result[(), Error] {
    cpath := match checkedPath(path, "remove file") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    res := unsafe { std::libc::unlink(cpath.asPtr()) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("remove file").withPath(path))
    }
    return .ok(())
}

public func rename(_ from: string, _ to: string) -> Result[(), Error] {
    cfrom := match CString::tryNew(from) {
        case .some(value) => value
        case .none => return .err(Error::new(.invalidInput).withOperation("rename").withPaths(from, to))
    }
    cto := match CString::tryNew(to) {
        case .some(value) => value
        case .none => return .err(Error::new(.invalidInput).withOperation("rename").withPaths(from, to))
    }
    res := unsafe { std::libc::rename(cfrom.asPtr(), cto.asPtr()) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("rename").withPaths(from, to))
    }
    return .ok(())
}

/// Query scalar metadata without exposing the platform's `struct stat` ABI.
public func metadata(_ path: string, _ followSymlinks: bool) -> Result[RawMetadata, Error] {
    var fileType: uint8 = 0_u8
    var len: uint64 = 0_u64
    var modifiedSecs: int64 = 0_i64
    var modifiedNanos: uint32 = 0_u32
    var accessedSecs: int64 = 0_i64
    var accessedNanos: uint32 = 0_u32
    code := unsafe { __rt__fs_metadata(
        path,
        followSymlinks,
        unsafe { &fileType as *mut uint8 },
        unsafe { &len as *mut uint64 },
        unsafe { &modifiedSecs as *mut int64 },
        unsafe { &modifiedNanos as *mut uint32 },
        unsafe { &accessedSecs as *mut int64 },
        unsafe { &accessedNanos as *mut uint32 },
    ) }
    if code != 0 {
        operation := if followSymlinks { "metadata" } else { "symlink metadata" }
        return .err(std::sys::io::unix::mapErrno(code).withOperation(operation).withPath(path))
    }
    return .ok(RawMetadata {
        fileTypeValue: fileType,
        lenValue: len,
        modifiedSecsValue: modifiedSecs,
        modifiedNanosValue: modifiedNanos,
        accessedSecsValue: accessedSecs,
        accessedNanosValue: accessedNanos,
    })
}

public func openDir(_ path: string) -> Result[PlatformDir, Error] {
    var code: int32 = 0
    handle := unsafe { __rt__fs_dir_open(path, unsafe { &code as *mut int32 }) }
    if handle == 0 {
        if code == 0 {
            return .err(Error::new(.unexpected).withOperation("open directory").withPath(path))
        }
        return .err(std::sys::io::unix::mapErrno(code).withOperation("open directory").withPath(path))
    }
    return .ok(PlatformDir { handle })
}

public func isDirValid(_ dir: &PlatformDir) -> bool {
    dir.handle != 0
}

/// Move the directory handle out, leaving `dir` permanently invalid.
public func takeDir(_ dir: &PlatformDir) -> PlatformDir {
    handle := dir.handle
    dir.handle = 0
    return PlatformDir { handle }
}

public func closeDir(_ dir: &PlatformDir) -> Result[(), Error] {
    if dir.handle == 0 {
        return .ok(())
    }
    handle := dir.handle
    dir.handle = 0
    code := unsafe { __rt__fs_dir_close(handle) }
    if code != 0 {
        return .err(std::sys::io::unix::mapErrno(code).withOperation("close directory"))
    }
    return .ok(())
}

// The runtime serializes the shared native cursor and returns an owned name
// copy, so copies of a directory handle may read and close concurrently.
public func readDir(_ dir: &PlatformDir) -> Result[RawDirEntry?, Error] {
    if dir.handle == 0 {
        return .err(Error::new(.closed).withOperation("read directory"))
    }

    var nameData: *mut uint8 = unsafe { 0 as *mut uint8 }
    var nameLen: usize = 0
    var fileType: uint8 = 0_u8
    code := unsafe { __rt__fs_dir_read(
        dir.handle,
        unsafe { &nameData as *mut *mut uint8 },
        unsafe { &nameLen as *mut usize },
        unsafe { &fileType as *mut uint8 },
    ) }
    if code == -1_i32 {
        return .ok(.none)
    }
    if code != 0 {
        return .err(std::sys::io::unix::mapErrno(code).withOperation("read directory"))
    }

    name := if nameLen == 0 {
        ""
    } else {
        std::string::stringFromBytes(unsafe { std::mem::Span[uint8]::from(nameData as *const uint8, nameLen) })
    }
    unsafe { __rt__fs_owned_bytes_free(nameData) }
    return .ok(.some(RawDirEntry {
        nameValue: name,
        fileTypeValue: fileType,
    }))
}

public func removeDirAll(_ path: string) -> Result[(), Error] {
    code := unsafe { __rt__fs_remove_dir_all(path) }
    if code != 0 {
        return .err(std::sys::io::unix::mapErrno(code).withOperation("remove directory recursively").withPath(path))
    }
    return .ok(())
}

public func copy(_ from: string, _ to: string) -> Result[uint64, Error] {
    var copied: uint64 = 0_u64
    code := unsafe { __rt__fs_copy(from, to, unsafe { &copied as *mut uint64 }) }
    if code != 0 {
        return .err(std::sys::io::unix::mapErrno(code).withOperation("copy").withPaths(from, to))
    }
    return .ok(copied)
}

func takeOwnedString(_ data: *mut uint8, _ len: usize) -> string {
    defer { unsafe { __rt__fs_owned_bytes_free(data) } }
    if len == 0 {
        return ""
    }

    value := std::string::stringFromBytes(unsafe { std::mem::Span[uint8]::from(data as *const uint8, len) })
    return value
}

public func canonicalize(_ path: string) -> Result[string, Error] {
    var data: *mut uint8 = unsafe { 0 as *mut uint8 }
    var len: usize = 0
    code := unsafe { __rt__fs_canonicalize(
        path,
        unsafe { &data as *mut *mut uint8 },
        unsafe { &len as *mut usize },
    ) }
    if code != 0 {
        return .err(std::sys::io::unix::mapErrno(code).withOperation("canonicalize").withPath(path))
    }
    return .ok(takeOwnedString(data, len))
}

public func createTempDir(_ parent: string, _ prefix: string) -> Result[string, Error] {
    var data: *mut uint8 = unsafe { 0 as *mut uint8 }
    var len: usize = 0
    code := unsafe { __rt__fs_create_temp_dir(
        parent,
        prefix,
        unsafe { &data as *mut *mut uint8 },
        unsafe { &len as *mut usize },
    ) }
    if code != 0 {
        return .err(std::sys::io::unix::mapErrno(code).withOperation("create temporary directory").withPath(parent))
    }
    return .ok(takeOwnedString(data, len))
}

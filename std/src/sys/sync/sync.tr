import std.io.Error
import std.intrinsic.{
    __intrinsic_channel_wait_send,
    __intrinsic_channel_wait_recv,
    __intrinsic_mutex_lock,
    __intrinsic_rwlock_read,
    __intrinsic_rwlock_write,
}
import std.marker.Copy
import std.result.Result

@cfg(family("unix"))
import std.sys.sync.unix.*

@cfg(family("unix"))
export std.sys.sync.unix.*

@cfg(family("windows"))
import std.sys.sync.windows.*

@cfg(family("windows"))
export std.sys.sync.windows.*

public struct RawChannel: Copy {
    handle: *mut uint8
}

public struct RawMutex: Copy {
    handle: *mut uint8
}

public struct RawRwLock: Copy {
    handle: *mut uint8
}

public enum ChannelTryRecvStatus {
    case value
    case empty
    case closed
}

func withSyncOperation(_ result: Result[(), Error], _ operation: string) -> Result[(), Error] {
    match result {
        case .ok(_) => return .ok(())
        case .err(err) => return .err(err.withOperation(operation))
    }
}

public func waitChannelSend(_ channel: &RawChannel) async -> Result[(), Error] {
    withSyncOperation(mapStatus(await __intrinsic_channel_wait_send(channel.handle)), "wait to send channel value")
}

public func waitChannelRecv(_ channel: &RawChannel) async -> Result[(), Error] {
    withSyncOperation(mapStatus(await __intrinsic_channel_wait_recv(channel.handle)), "wait to receive channel value")
}

public func waitMutexLock(_ mutex: &RawMutex) async -> Result[(), Error] {
    withSyncOperation(mapStatus(await __intrinsic_mutex_lock(mutex.handle)), "wait for mutex")
}

public func waitRwLockRead(_ lock: &RawRwLock) async -> Result[(), Error] {
    withSyncOperation(mapStatus(await __intrinsic_rwlock_read(lock.handle)), "wait for rwlock read")
}

public func waitRwLockWrite(_ lock: &RawRwLock) async -> Result[(), Error] {
    withSyncOperation(mapStatus(await __intrinsic_rwlock_write(lock.handle)), "wait for rwlock write")
}

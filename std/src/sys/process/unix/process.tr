import std::collections::List
import std::io::Error
import std::result::Result

extern "taro_rt" {
    unsafe func __rt__process_command_open(_ program: string, _ errorOut: *mut int32) -> usize
    unsafe func __rt__process_command_arg(_ handle: usize, _ argument: string) -> int32
    unsafe func __rt__process_command_env(_ handle: usize, _ name: string, _ value: string) -> int32
    unsafe func __rt__process_command_current_dir(_ handle: usize, _ path: string) -> int32
    unsafe func __rt__process_command_stdio(
        _ handle: usize,
        _ stdinMode: uint8,
        _ stdoutMode: uint8,
        _ stderrMode: uint8,
    ) -> int32
    unsafe func __rt__process_command_close(_ handle: usize)
    unsafe func __rt__process_child_pid(_ handle: usize, _ pidOut: *mut uint32) -> int32
    unsafe func __rt__process_child_try_wait(
        _ handle: usize,
        _ readyOut: *mut bool,
        _ codeOut: *mut int32,
        _ signalOut: *mut int32,
    ) -> int32
    unsafe func __rt__process_child_kill(_ handle: usize) -> int32
    unsafe func __rt__process_child_abandon(_ handle: usize)
    unsafe func __rt__process_output_status(
        _ handle: usize,
        _ codeOut: *mut int32,
        _ signalOut: *mut int32,
    ) -> int32
    unsafe func __rt__process_output_stdout(
        _ handle: usize,
        _ dataOut: *mut *const uint8,
        _ lenOut: *mut usize,
    ) -> int32
    unsafe func __rt__process_output_stderr(
        _ handle: usize,
        _ dataOut: *mut *const uint8,
        _ lenOut: *mut usize,
    ) -> int32
    unsafe func __rt__process_output_close(_ handle: usize)
}

/// These calls can wait for exec, process exit, or pipe EOF. The blocking ABI
/// preserves managed roots while a synchronous caller is parked in the OS.
extern "blocking" {
    unsafe func __rt__process_command_spawn(
        _ handle: usize,
        _ childOut: *mut usize,
        _ stdinFdOut: *mut int32,
        _ stdoutFdOut: *mut int32,
        _ stderrFdOut: *mut int32,
    ) -> int32
    unsafe func __rt__process_command_status(
        _ handle: usize,
        _ codeOut: *mut int32,
        _ signalOut: *mut int32,
    ) -> int32
    unsafe func __rt__process_child_wait(
        _ handle: usize,
        _ codeOut: *mut int32,
        _ signalOut: *mut int32,
    ) -> int32
    unsafe func __rt__process_command_output(
        _ handle: usize,
        _ limited: bool,
        _ limit: usize,
        _ errorOut: *mut int32,
        _ limitExceededOut: *mut bool,
    ) -> usize
}

public const STDIO_NULL: uint8 = 0_u8
public const STDIO_INHERIT: uint8 = 1_u8
public const STDIO_PIPED: uint8 = 2_u8

public struct RawCommand {
    internal handle: usize
}

public struct RawChild {
    internal handle: usize
}

/// Copies share the descriptor through one lease; see `std::sys::io::unix`.
public struct RawPipe {
    internal lease: uint64
}

public struct RawExitStatus {
    codeValue: int32
    signalValue: int32
}

public struct RawSpawn {
    childValue: RawChild
    stdinValue: RawPipe?
    stdoutValue: RawPipe?
    stderrValue: RawPipe?
}

public struct RawOutput {
    statusValue: RawExitStatus
    stdoutValue: List[uint8]
    stderrValue: List[uint8]
}

extend RawExitStatus {
    public func code() -> int32 { self.codeValue }
    public func signal() -> int32 { self.signalValue }
}

extend RawSpawn {
    public func parts() -> (RawChild, RawPipe?, RawPipe?, RawPipe?) {
        return (self.childValue, self.stdinValue, self.stdoutValue, self.stderrValue)
    }
}

extend RawOutput {
    public func parts() -> (RawExitStatus, List[uint8], List[uint8]) {
        return (self.statusValue, self.stdoutValue, self.stderrValue)
    }
}

func processError(_ code: int32, _ operation: string) -> Error {
    std::sys::io::unix::mapErrno(code).withOperation(operation)
}

func statusFromValues(_ code: int32, _ signal: int32) -> RawExitStatus {
    RawExitStatus {
        codeValue: code,
        signalValue: signal,
    }
}

func pipeFromFd(_ fd: int32) -> RawPipe? {
    if fd < 0 {
        return .none
    }
    return .some(RawPipe { lease: std::sys::io::unix::leaseOpen(fd) })
}

public func commandOpen(_ program: string) -> Result[RawCommand, Error] {
    var errorCode: int32 = 0
    handle := unsafe { __rt__process_command_open(
        program,
        unsafe { &errorCode as *mut int32 },
    ) }
    if handle == 0 {
        if errorCode == 0 {
            return .err(Error::new(.resourceExhausted).withOperation("prepare command"))
        }
        return .err(processError(errorCode, "prepare command"))
    }
    return .ok(RawCommand { handle })
}

public func commandClose(_ command: &RawCommand) {
    if command.handle == 0 {
        return
    }
    handle := command.handle
    command.handle = 0
    unsafe { __rt__process_command_close(handle) }
}

public func commandArg(_ command: &RawCommand, _ argument: string) -> Result[(), Error] {
    code := unsafe { __rt__process_command_arg(command.handle, argument) }
    if code != 0 {
        return .err(processError(code, "set command argument"))
    }
    return .ok(())
}

public func commandEnv(
    _ command: &RawCommand,
    _ name: string,
    _ value: string,
) -> Result[(), Error] {
    code := unsafe { __rt__process_command_env(command.handle, name, value) }
    if code != 0 {
        return .err(processError(code, "set command environment"))
    }
    return .ok(())
}

public func commandCurrentDir(_ command: &RawCommand, _ path: string) -> Result[(), Error] {
    code := unsafe { __rt__process_command_current_dir(command.handle, path) }
    if code != 0 {
        return .err(processError(code, "set command current directory").withPath(path))
    }
    return .ok(())
}

public func commandStdio(
    _ command: &RawCommand,
    _ stdinMode: uint8,
    _ stdoutMode: uint8,
    _ stderrMode: uint8,
) -> Result[(), Error] {
    code := unsafe { __rt__process_command_stdio(command.handle, stdinMode, stdoutMode, stderrMode) }
    if code != 0 {
        return .err(processError(code, "set command stdio"))
    }
    return .ok(())
}

public func commandSpawn(_ command: &RawCommand) -> Result[RawSpawn, Error] {
    var childHandle: usize = 0
    var stdinFd: int32 = -1
    var stdoutFd: int32 = -1
    var stderrFd: int32 = -1
    code := unsafe { __rt__process_command_spawn(
        command.handle,
        unsafe { &childHandle as *mut usize },
        unsafe { &stdinFd as *mut int32 },
        unsafe { &stdoutFd as *mut int32 },
        unsafe { &stderrFd as *mut int32 },
    ) }
    if code != 0 {
        return .err(processError(code, "spawn process"))
    }
    return .ok(RawSpawn {
        childValue: RawChild { handle: childHandle },
        stdinValue: pipeFromFd(stdinFd),
        stdoutValue: pipeFromFd(stdoutFd),
        stderrValue: pipeFromFd(stderrFd),
    })
}

public func commandStatus(_ command: &RawCommand) -> Result[RawExitStatus, Error] {
    var codeValue: int32 = -1
    var signalValue: int32 = -1
    code := unsafe { __rt__process_command_status(
        command.handle,
        unsafe { &codeValue as *mut int32 },
        unsafe { &signalValue as *mut int32 },
    ) }
    if code != 0 {
        return .err(processError(code, "wait for process"))
    }
    return .ok(statusFromValues(codeValue, signalValue))
}

func copyOutputBytes(_ data: *const uint8, _ len: usize) -> List[uint8] {
    if len == 0 {
        return List[uint8]::new()
    }

    // Copy the borrowed snapshot into its unique native allocation. Never
    // adopt a collector or platform allocation as a native sequence owner.
    return unsafe { std::collections::__list_copy_bytes(data, len) }
}

public func commandOutput(
    _ command: &RawCommand,
    _ limited: bool,
    _ limit: usize,
) -> Result[RawOutput, Error] {
    var errorCode: int32 = 0
    var limitExceeded = false
    handle := unsafe { __rt__process_command_output(
        command.handle,
        limited,
        limit,
        unsafe { &errorCode as *mut int32 },
        unsafe { &limitExceeded as *mut bool },
    ) }
    if handle == 0 {
        if limitExceeded {
            return .err(Error::new(.resourceExhausted).withOperation("capture process output"))
        }
        if errorCode == 0 {
            return .err(Error::new(.unexpected).withOperation("capture process output"))
        }
        return .err(processError(errorCode, "capture process output"))
    }
    defer { unsafe { __rt__process_output_close(handle) } }

    var codeValue: int32 = -1
    var signalValue: int32 = -1
    var code = unsafe { __rt__process_output_status(
        handle,
        unsafe { &codeValue as *mut int32 },
        unsafe { &signalValue as *mut int32 },
    ) }
    if code != 0 {
        return .err(processError(code, "read process status"))
    }

    var stdoutData: *const uint8 = unsafe { 0 as *const uint8 }
    var stdoutLen: usize = 0
    code = unsafe { __rt__process_output_stdout(
        handle,
        unsafe { &stdoutData as *mut *const uint8 },
        unsafe { &stdoutLen as *mut usize },
    ) }
    if code != 0 {
        return .err(processError(code, "read process stdout"))
    }

    var stderrData: *const uint8 = unsafe { 0 as *const uint8 }
    var stderrLen: usize = 0
    code = unsafe { __rt__process_output_stderr(
        handle,
        unsafe { &stderrData as *mut *const uint8 },
        unsafe { &stderrLen as *mut usize },
    ) }
    if code != 0 {
        return .err(processError(code, "read process stderr"))
    }

    // Copy both streams before closing the runtime snapshot. The pointers are
    // deliberately borrowed so ownership cannot be confused across the ABI.
    return .ok(RawOutput {
        statusValue: statusFromValues(codeValue, signalValue),
        stdoutValue: copyOutputBytes(stdoutData, stdoutLen),
        stderrValue: copyOutputBytes(stderrData, stderrLen),
    })
}

public func childPid(_ child: &RawChild) -> Result[uint32, Error] {
    var pid: uint32 = 0_u32
    code := unsafe { __rt__process_child_pid(child.handle, unsafe { &pid as *mut uint32 }) }
    if code != 0 {
        return .err(processError(code, "get process id"))
    }
    return .ok(pid)
}

public func childWait(_ child: &RawChild) -> Result[RawExitStatus, Error] {
    var codeValue: int32 = -1
    var signalValue: int32 = -1
    code := unsafe { __rt__process_child_wait(
        child.handle,
        unsafe { &codeValue as *mut int32 },
        unsafe { &signalValue as *mut int32 },
    ) }
    if code != 0 {
        return .err(processError(code, "wait for process"))
    }
    return .ok(statusFromValues(codeValue, signalValue))
}

public func childTryWait(_ child: &RawChild) -> Result[RawExitStatus?, Error] {
    var ready = false
    var codeValue: int32 = -1
    var signalValue: int32 = -1
    code := unsafe { __rt__process_child_try_wait(
        child.handle,
        unsafe { &ready as *mut bool },
        unsafe { &codeValue as *mut int32 },
        unsafe { &signalValue as *mut int32 },
    ) }
    if code != 0 {
        return .err(processError(code, "try wait for process"))
    }
    if !ready {
        return .ok(.none)
    }
    return .ok(.some(statusFromValues(codeValue, signalValue)))
}

public func childKill(_ child: &RawChild) -> Result[(), Error] {
    code := unsafe { __rt__process_child_kill(child.handle) }
    if code != 0 {
        return .err(processError(code, "kill process"))
    }
    return .ok(())
}

/// Transfer the native child registry handle, leaving an inert source value.
internal func childTake(_ child: &RawChild) -> RawChild {
    handle := child.handle
    child.handle = 0
    return RawChild { handle }
}

public func childAbandon(_ child: RawChild) {
    unsafe { __rt__process_child_abandon(child.handle) }
}

public func pipeIsValid(_ pipe: &RawPipe) -> bool {
    pipe.lease != 0
}

public func pipeRead(
    _ pipe: &RawPipe,
    _ data: *mut uint8,
    _ len: usize,
) -> Result[usize, Error] {
    lease := pipe.lease
    fd := match std::sys::io::unix::leaseAcquire(lease, "read process pipe") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    count := unsafe { std::libc::read(fd, data, len) }
    var result: Result[usize, Error] = if count < 0 {
        .err(std::sys::io::unix::lastError().withOperation("read process pipe"))
    } else {
        .ok(count as usize)
    }
    std::sys::io::unix::leaseRelease(lease)
    return result
}

public func pipeWrite(
    _ pipe: &RawPipe,
    _ data: *const uint8,
    _ len: usize,
) -> Result[usize, Error] {
    lease := pipe.lease
    fd := match std::sys::io::unix::leaseAcquire(lease, "write process pipe") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    count := unsafe { std::libc::write(fd, data, len) }
    var result: Result[usize, Error] = if count < 0 {
        .err(std::sys::io::unix::lastError().withOperation("write process pipe"))
    } else {
        .ok(count as usize)
    }
    std::sys::io::unix::leaseRelease(lease)
    return result
}

/// Close once no read or write is using the pipe. A blocked read keeps the
/// descriptor open until it returns; later operations report `closed`.
public func pipeClose(_ pipe: &RawPipe) -> Result[(), Error] {
    if pipe.lease == 0 {
        return .ok(())
    }

    lease := pipe.lease
    pipe.lease = 0
    std::sys::io::unix::leaseClose(lease, "close process pipe")
}

public func pipeTake(_ pipe: &RawPipe) -> RawPipe {
    lease := pipe.lease
    pipe.lease = 0
    return RawPipe { lease }
}

public func pipeIntoAsyncStream(_ pipe: &RawPipe) -> Result[std::sys::io::RawAsyncStream, Error] {
    if pipe.lease == 0 {
        return .err(Error::new(.closed).withOperation("convert process pipe to async stream"))
    }
    fd := match std::sys::io::unix::leaseTake(pipe.lease, "convert process pipe to async stream") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    pipe.lease = 0
    return std::sys::io::adoptFd(fd)
}

public func exit(_ code: int32) -> ! {
    std::libc::exit(code)
}

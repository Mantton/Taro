@cfg(family("unix"))
import std::sys::time::unix::*

@cfg(family("unix"))
export std::sys::time::unix::{monotonicNow, realtimeNow}

@cfg(family("windows"))
import std::sys::time::windows::*

@cfg(family("windows"))
export std::sys::time::windows::{monotonicNow, realtimeNow}

public struct MonotonicTime {
    secs: uint64
    nanos: uint32
}

extend MonotonicTime {
    public func seconds() -> uint64 {
        return self.secs
    }

    public func subsecNanos() -> uint32 {
        return self.nanos
    }
}

public struct RealtimeTime {
    secs: int64
    nanos: uint32
}

extend RealtimeTime {
    public func seconds() -> int64 {
        return self.secs
    }

    public func subsecNanos() -> uint32 {
        return self.nanos
    }
}

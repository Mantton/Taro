public func peerAddress(_ socket: &RawAsyncSocket) -> Result[std::sys::net::SocketAddress, Error] {
    raw := match acquire(socket, "peer address") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    result := std::sys::net::peerAddress(&raw)
    release(socket)
    return result
}

@cfg(family("unix"))
public func close(_ socket: RawAsyncSocket) -> Result[(), Error] {
    return std::sys::io::close(socket.stream)
}


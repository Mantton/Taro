// Bound the wait that follows by also waking at `deadline`. Every wake retries
// the socket first, so an operation that is ready always beats its deadline.
@cfg(family("unix"))
func armDeadline(_ deadline: Instant?, _ operation: string) -> Result[(), Error] {
    match deadline {
        case .none => return .ok(())
        case .some(instant) => match instant.checkedDurationSince(Instant::now()) {
            case .none => return .err(Error::new(.timedOut).withOperation(operation))
            case .some(remaining) => {
                unsafe { __rt__task_wake_after(remaining.seconds(), remaining.subsecNanos()) }
                return .ok(())
            }
        }
    }
}

@cfg(family("unix"))
func disarmDeadline(_ deadline: Instant?) {
    if deadline.isSome() { unsafe { __rt__task_clear_wake() } }
}

@cfg(family("unix"))
public func read(_ socket: &RawAsyncSocket, _ buf: Span[uint8], deadline: Instant? = .none) async -> Result[usize, Error] {
    len := buf.len()
    if len == 0 {
        return .ok(0)
    }

    stream := &socket.stream
    var writable = buf
    ptr := unsafe { writable.at(0) as *mut uint8 }
    loop {
        readRes := std::sys::io::read(stream, ptr, len)
        match readRes {
            case .ok(count) => return .ok(count)
            case .err(err) if err.isKind(.interrupted) => {}
            case .err(err) if err.isKind(.wouldBlock) => {
                armDeadline(deadline, "read")!
                waitRes := await std::sys::io::waitReadable(stream)
                disarmDeadline(deadline)
                match waitRes {
                    case .ok(_) => {}
                    case .err(err) => return .err(err)
                }
            }
            case .err(err) => return .err(err)
        }
    }
}

@cfg(family("windows"))
public func read(_ socket: &RawAsyncSocket, _ buf: Span[uint8], deadline: Instant? = .none) async -> Result[usize, Error] {
    todo("std.sys.net.task.read not implemented on windows yet")
}

/// Read without suspending, failing with `.wouldBlock` if nothing is available.
/// `buf` is not empty.
@cfg(family("unix"))
public func tryRead(_ socket: &RawAsyncSocket, _ buf: Span[uint8]) -> Result[usize, Error] {
    var writable = buf
    ptr := unsafe { writable.at(0) as *mut uint8 }
    loop {
        match std::sys::io::read(&socket.stream, ptr, buf.len()) {
            case .err(err) if err.isKind(.interrupted) => {}
            case result => return result
        }
    }
}

@cfg(family("windows"))
public func tryRead(_ socket: &RawAsyncSocket, _ buf: Span[uint8]) -> Result[usize, Error] {
    todo("std.sys.net.task.tryRead not implemented on windows yet")
}

/// Write without suspending, failing with `.wouldBlock` if nothing was accepted.
/// `buf` is not empty.
@cfg(family("unix"))
public func tryWrite(_ socket: &RawAsyncSocket, _ buf: Span[uint8]) -> Result[usize, Error] {
    ptr := unsafe { buf.at(0) as *const uint8 }
    loop {
        match std::sys::io::write(&socket.stream, ptr, buf.len()) {
            case .err(err) if err.isKind(.interrupted) => {}
            case result => return result
        }
    }
}

@cfg(family("windows"))
public func tryWrite(_ socket: &RawAsyncSocket, _ buf: Span[uint8]) -> Result[usize, Error] {
    todo("std.sys.net.task.tryWrite not implemented on windows yet")
}

/// Wait once for the socket to become readable, failing with `.timedOut` if
/// `deadline` has passed. Wakes are advisory, so callers retry their read.
@cfg(family("unix"))
public func waitReadable(_ socket: &RawAsyncSocket, deadline: Instant) async -> Result[(), Error] {
    armDeadline(.some(deadline), "read")!
    result := await std::sys::io::waitReadable(&socket.stream)
    disarmDeadline(.some(deadline))
    return result
}

@cfg(family("windows"))
public func waitReadable(_ socket: &RawAsyncSocket, deadline: Instant) async -> Result[(), Error] {
    todo("std.sys.net.task.waitReadable not implemented on windows yet")
}

/// Wait once for the socket to become writable, failing with `.timedOut` if
/// `deadline` has passed. Wakes are advisory, so callers retry their write.
@cfg(family("unix"))
public func waitWritable(_ socket: &RawAsyncSocket, deadline: Instant) async -> Result[(), Error] {
    armDeadline(.some(deadline), "write")!
    result := await std::sys::io::waitWritable(&socket.stream)
    disarmDeadline(.some(deadline))
    return result
}

@cfg(family("windows"))
public func waitWritable(_ socket: &RawAsyncSocket, deadline: Instant) async -> Result[(), Error] {
    todo("std.sys.net.task.waitWritable not implemented on windows yet")
}

@cfg(family("unix"))
public func write(_ socket: &RawAsyncSocket, _ buf: Span[uint8], deadline: Instant? = .none) async -> Result[usize, Error] {
    len := buf.len()
    if len == 0 {
        return .ok(0)
    }

    stream := &socket.stream
    ptr := unsafe { buf.at(0) as *const uint8 }
    loop {
        writeRes := std::sys::io::write(stream, ptr, len)
        match writeRes {
            case .ok(count) => return .ok(count)
            case .err(err) if err.isKind(.interrupted) => {}
            case .err(err) if err.isKind(.wouldBlock) => {
                armDeadline(deadline, "write")!
                waitRes := await std::sys::io::waitWritable(stream)
                disarmDeadline(deadline)
                match waitRes {
                    case .ok(_) => {}
                    case .err(err) => return .err(err)
                }
            }
            case .err(err) => return .err(err)
        }
    }
}

@cfg(family("windows"))
public func write(_ socket: &RawAsyncSocket, _ buf: Span[uint8], deadline: Instant? = .none) async -> Result[usize, Error] {
    todo("std.sys.net.task.write not implemented on windows yet")
}

@cfg(family("unix"))
public func connect(_ socket: &RawAsyncSocket, _ address: std::sys::net::SocketAddress) async -> Result[(), Error] {
    loop {
        raw := match acquire(socket, "connect") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        connectRes := std::sys::net::connect(&raw, address)
        release(socket)
        match connectRes {
            case .ok(_) => return .ok(())
            case .err(err) if err.isKind(.interrupted) => {}
            case .err(err) if err.isKind(.wouldBlock) => {
                waitRes := await std::sys::io::waitWritable(&socket.stream)
                match waitRes {
                    case .ok(_) => {}
                    case .err(err) => return .err(err)
                }

                checked := match acquire(socket, "connect") {
                    case .ok(value) => value
                    case .err(err) => return .err(err)
                }
                socketErrorRes := std::sys::net::socketError(&checked)
                release(socket)
                code := match socketErrorRes {
                    case .ok(value) => value
                    case .err(err) => return .err(err)
                }

                if code == 0 {
                    return .ok(())
                }
                return .err(std::sys::io::unix::mapErrno(code).withOperation("connect"))
            }
            case .err(err) => return .err(err)
        }
    }
}

@cfg(family("windows"))
public func connect(_ socket: &RawAsyncSocket, _ address: std::sys::net::SocketAddress) async -> Result[(), Error] {
    todo("std.sys.net.task.connect not implemented on windows yet")
}

@cfg(family("unix"))
public func accept(_ socket: &RawAsyncSocket) async -> Result[(RawAsyncSocket, std::sys::net::SocketAddress), Error] {
    loop {
        raw := match acquire(socket, "accept") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        acceptRes := std::sys::net::accept(&raw)
        release(socket)
        match acceptRes {
            case .ok((accepted, address)) => {
                var raw = accepted
                fd := std::sys::net::takeFd(&raw)
                streamRes := std::sys::io::adoptFd(fd)
                stream := match streamRes {
                    case .ok(value) => value
                    case .err(err) => return .err(err)
                }

                return .ok((RawAsyncSocket { stream }, address))
            }
            case .err(err) if err.isKind(.interrupted) => {}
            case .err(err) if err.isKind(.wouldBlock) => {
                waitRes := await std::sys::io::waitReadable(&socket.stream)
                match waitRes {
                    case .ok(_) => {}
                    case .err(err) => return .err(err)
                }
            }
            case .err(err) => return .err(err)
        }
    }
}

@cfg(family("windows"))
public func accept(_ socket: &RawAsyncSocket) async -> Result[(RawAsyncSocket, std::sys::net::SocketAddress), Error] {
    todo("std.sys.net.task.accept not implemented on windows yet")
}

@cfg(family("unix"))
public func sendTo(
    _ socket: &RawAsyncSocket,
    _ buf: Span[uint8],
    _ address: std::sys::net::SocketAddress,
) async -> Result[usize, Error] {
    len := buf.len()
    if len == 0 {
        return .ok(0)
    }

    ptr := unsafe { buf.at(0) as *const uint8 }
    loop {
        raw := match acquire(socket, "send datagram") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        sendRes := std::sys::net::sendTo(&raw, ptr, len, address)
        release(socket)
        match sendRes {
            case .ok(count) => return .ok(count)
            case .err(err) if err.isKind(.interrupted) => {}
            case .err(err) if err.isKind(.wouldBlock) => {
                waitRes := await std::sys::io::waitWritable(&socket.stream)
                match waitRes {
                    case .ok(_) => {}
                    case .err(err) => return .err(err)
                }
            }
            case .err(err) => return .err(err)
        }
    }
}

@cfg(family("windows"))
public func sendTo(
    _ socket: &RawAsyncSocket,
    _ buf: Span[uint8],
    _ address: std::sys::net::SocketAddress,
) async -> Result[usize, Error] {
    todo("std.sys.net.task.sendTo not implemented on windows yet")
}

@cfg(family("unix"))
public func recvFrom(
    _ socket: &RawAsyncSocket,
    _ buf: Span[uint8],
) async -> Result[(usize, std::sys::net::SocketAddress), Error] {
    len := buf.len()
    if len == 0 {
        return .err(Error::new(.invalidInput).withOperation("receive datagram"))
    }

    var writable = buf
    ptr := unsafe { writable.at(0) as *mut uint8 }
    loop {
        raw := match acquire(socket, "receive datagram") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        recvRes := std::sys::net::recvFrom(&raw, ptr, len)
        release(socket)
        match recvRes {
            case .ok(value) => return .ok(value)
            case .err(err) if err.isKind(.interrupted) => {}
            case .err(err) if err.isKind(.wouldBlock) => {
                waitRes := await std::sys::io::waitReadable(&socket.stream)
                match waitRes {
                    case .ok(_) => {}
                    case .err(err) => return .err(err)
                }
            }
            case .err(err) => return .err(err)
        }
    }
}

@cfg(family("windows"))
public func recvFrom(
    _ socket: &RawAsyncSocket,
    _ buf: Span[uint8],
) async -> Result[(usize, std::sys::net::SocketAddress), Error] {
    todo("std.sys.net.task.recvFrom not implemented on windows yet")
}

@cfg(family("unix"))
public func intoStream(_ socket: &RawAsyncSocket) -> Result[std::io::task::AsyncStream, Error] {
    if std::sys::io::sourceId(&socket.stream) == 0 {
        return .err(Error::new(.invalidInput).withOperation("convert socket to stream"))
    }

    stream := std::sys::io::take(&socket.stream)
    return std::io::task::fromRaw(stream)
}

@cfg(family("windows"))
public func intoStream(_ socket: &RawAsyncSocket) -> Result[std::io::task::AsyncStream, Error] {
    todo("std.sys.net.task.intoStream not implemented on windows yet")
}

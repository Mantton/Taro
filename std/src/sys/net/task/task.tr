import std::io::Error
import std::mem::{Span}
import std::panic::todo
import std::result::Result
import std::time::Instant

@cfg(family("unix"))
extern "taro_rt" {
    unsafe func __rt__task_wake_after(_ secs: uint64, _ nanos: uint32)
    unsafe func __rt__task_clear_wake()
}

/// A socket registered with the async reactor. Socket calls reach the
/// descriptor only through the source's lease, one native call at a time.
public struct RawAsyncSocket {
    internal stream: std::sys::io::RawAsyncStream
}

public func isValid(_ socket: &RawAsyncSocket) -> bool {
    std::sys::io::sourceId(&socket.stream) != 0
}

/// Move the descriptor out, leaving `socket` invalid.
public func take(_ socket: &RawAsyncSocket) -> RawAsyncSocket {
    return RawAsyncSocket { stream: std::sys::io::take(&socket.stream) }
}

// Lease the descriptor for one native call; never hold it across an await.
@cfg(family("unix"))
func acquire(_ socket: &RawAsyncSocket, _ operation: string) -> Result[std::sys::net::RawSocket, Error] {
    lease := std::sys::io::sourceId(&socket.stream) as uint64
    match std::sys::io::unix::leaseAcquire(lease, operation) {
        case .ok(fd) => return .ok(std::sys::net::fromFd(fd))
        case .err(err) => return .err(err)
    }
}

@cfg(family("unix"))
func release(_ socket: &RawAsyncSocket) {
    std::sys::io::unix::leaseRelease(std::sys::io::sourceId(&socket.stream) as uint64)
}

@cfg(family("windows"))
func acquire(_ socket: &RawAsyncSocket, _ operation: string) -> Result[std::sys::net::RawSocket, Error] {
    todo("std.sys.net.task socket leases not implemented on windows yet")
}

@cfg(family("windows"))
func release(_ socket: &RawAsyncSocket) {
    todo("std.sys.net.task socket leases not implemented on windows yet")
}

@cfg(family("unix"))
public func socket(
    _ domain: std::sys::net::SocketDomain,
    _ type_: std::sys::net::SocketType,
) -> Result[RawAsyncSocket, Error] {
    socketRes := std::sys::net::socket(domain, type_)
    var raw = match socketRes {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }

    fd := std::sys::net::takeFd(&raw)
    streamRes := std::sys::io::adoptFd(fd)
    stream := match streamRes {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }

    return .ok(RawAsyncSocket { stream })
}

@cfg(family("windows"))
public func socket(
    _ domain: std::sys::net::SocketDomain,
    _ type_: std::sys::net::SocketType,
) -> Result[RawAsyncSocket, Error] {
    todo("std.sys.net.task.socket not implemented on windows yet")
}

public func bind(_ socket: &RawAsyncSocket, _ address: std::sys::net::SocketAddress) -> Result[(), Error] {
    raw := match acquire(socket, "bind") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    result := std::sys::net::bind(&raw, address)
    release(socket)
    return result
}

public func listen(_ socket: &RawAsyncSocket, _ backlog: int32) -> Result[(), Error] {
    raw := match acquire(socket, "listen") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    result := std::sys::net::listen(&raw, backlog)
    release(socket)
    return result
}

public func setReuseAddr(_ socket: &RawAsyncSocket, _ enabled: bool) -> Result[(), Error] {
    raw := match acquire(socket, "set reuse address") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    result := std::sys::net::setReuseAddr(&raw, enabled)
    release(socket)
    return result
}

public func localAddress(_ socket: &RawAsyncSocket) -> Result[std::sys::net::SocketAddress, Error] {
    raw := match acquire(socket, "local address") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    result := std::sys::net::localAddress(&raw)
    release(socket)

@cfg(family("unix"))
public func sendTo(
    _ socket: &RawSocket,
    _ buf: *const uint8,
    _ len: usize,
    _ address: SocketAddress,
) -> Result[usize, Error] {
    var (storage, addrLen) = encodeSocketAddress(address)
    addrPtr := unsafe { (&storage as *const [uint8; SOCKET_ADDRESS_STORAGE_LEN]) as *const uint8 }
    res := unsafe { std::libc::sendto(socket.fd, buf, len, 0, addrPtr, addrLen) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("send datagram"))
    }
    return .ok(res as usize)
}

@cfg(family("windows"))
public func sendTo(
    _ socket: &RawSocket,
    _ buf: *const uint8,
    _ len: usize,
    _ address: SocketAddress,
) -> Result[usize, Error] {
    todo("std.sys.net.sendTo not implemented on windows yet")
}

@cfg(family("unix"))
public func recvFrom(
    _ socket: &RawSocket,
    _ buf: *mut uint8,
    _ len: usize,
) -> Result[(usize, SocketAddress), Error] {
    var storage: [uint8; SOCKET_ADDRESS_STORAGE_LEN] = [0; SOCKET_ADDRESS_STORAGE_LEN]
    var addrLen: std::libc::socklen_t = SOCKET_ADDRESS_STORAGE_LEN as std::libc::socklen_t
    addrPtr := unsafe { (&storage as *mut [uint8; SOCKET_ADDRESS_STORAGE_LEN]) as *mut uint8 }
    lenPtr := unsafe { (&addrLen as *mut std::libc::socklen_t) }
    res := unsafe { std::libc::recvfrom(socket.fd, buf, len, 0, addrPtr, lenPtr) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("receive datagram"))
    }

    addressRes := decodeSocketAddress(storage, addrLen)
    match addressRes {
        case .ok(address) => return .ok((res as usize, address))
        case .err(err) => return .err(err)
    }
}

@cfg(family("windows"))
public func recvFrom(
    _ socket: &RawSocket,
    _ buf: *mut uint8,
    _ len: usize,
) -> Result[(usize, SocketAddress), Error] {
    todo("std.sys.net.recvFrom not implemented on windows yet")
}

@cfg(family("unix"))
public func setReuseAddr(_ socket: &RawSocket, _ enabled: bool) -> Result[(), Error] {
    var value: int32 = if enabled { 1 } else { 0 }
    valuePtr := unsafe { (&value as *const int32) as *const uint8 }
    valueLen := sizeOf[int32]() as std::libc::socklen_t
    res := unsafe { std::libc::setsockopt(
        socket.fd,
        std::libc::SOL_SOCKET,
        std::libc::SO_REUSEADDR,
        valuePtr,
        valueLen,
    ) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("set reuse address"))
    }
    return .ok(())
}

@cfg(family("windows"))
public func setReuseAddr(_ socket: &RawSocket, _ enabled: bool) -> Result[(), Error] {
    todo("std.sys.net.setReuseAddr not implemented on windows yet")
}

@cfg(family("unix"))
public func setCloseOnExec(_ socket: &RawSocket) -> Result[(), Error] {
    setCloseOnExecFd(socket.fd)
}

@cfg(family("windows"))
public func setCloseOnExec(_ socket: &RawSocket) -> Result[(), Error] {
    todo("std.sys.net.setCloseOnExec not implemented on windows yet")

@cfg(family("unix"))
public func localAddress(_ socket: &RawSocket) -> Result[SocketAddress, Error] {
    var storage: [uint8; SOCKET_ADDRESS_STORAGE_LEN] = [0; SOCKET_ADDRESS_STORAGE_LEN]
    var len: std::libc::socklen_t = SOCKET_ADDRESS_STORAGE_LEN as std::libc::socklen_t
    ptr := unsafe { (&storage as *mut [uint8; SOCKET_ADDRESS_STORAGE_LEN]) as *mut uint8 }
    lenPtr := unsafe { (&len as *mut std::libc::socklen_t) }
    res := unsafe { std::libc::getsockname(socket.fd, ptr, lenPtr) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("get local address"))
    }
    return decodeSocketAddress(storage, len)
}

@cfg(family("windows"))
public func localAddress(_ socket: &RawSocket) -> Result[SocketAddress, Error] {
    todo("std.sys.net.localAddress not implemented on windows yet")
}


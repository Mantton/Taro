import std::io::Error
import std::libc
import std::mem::sizeOf
import std::ops::PartialEq
import std::panic::todo
import std::result::Result

public struct RawSocket {
    internal fd: int32
}

public enum IpAddress: PartialEq {
    case ipv4([uint8; 4])
    case ipv6([uint8; 16])
}

public struct SocketAddress: PartialEq {
    ip: IpAddress
    port: uint16
}

public enum SocketDomain {
    case ipv4
    case ipv6
}

public enum SocketType {
    case stream
    case datagram
}

const SOCKET_ADDRESS_STORAGE_LEN: usize = 28
const SOCKADDR_V4_LEN: std::libc::socklen_t = 16_u32
const SOCKADDR_V6_LEN: std::libc::socklen_t = 28_u32

extend SocketAddress {
    public static func localhost(_ port: uint16) -> SocketAddress {
        SocketAddress { ip: IpAddress::ipv4([127_u8, 0_u8, 0_u8, 1_u8]), port }
    }

    public static func unspecified(_ port: uint16) -> SocketAddress {
        SocketAddress { ip: IpAddress::ipv4([0_u8, 0_u8, 0_u8, 0_u8]), port }
    }

    public static func ipv4(_ a: uint8, _ b: uint8, _ c: uint8, _ d: uint8, _ port: uint16) -> SocketAddress {
        SocketAddress { ip: IpAddress::ipv4([a, b, c, d]), port }
    }
}

public func domainForAddress(_ address: SocketAddress) -> SocketDomain {
    match address.ip {
        case .ipv4(_) => return .ipv4
        case .ipv6(_) => return .ipv6
    }
}

@cfg(family("unix"))
public func socket(_ domain: SocketDomain, _ type_: SocketType) -> Result[RawSocket, Error] {
    match openSocketFd(socketDomainValue(domain), socketTypeValue(type_)) {
        case .ok(fd) => return .ok(RawSocket { fd })
        case .err(err) => return .err(err)
    }
}

/// A socket that closes on exec. Linux creates it that way atomically.
@cfg(os("linux"))
func openSocketFd(_ domain: int32, _ type_: int32) -> Result[int32, Error] {
    fd := std::libc::socket(domain, type_ | std::libc::SOCK_CLOEXEC, 0)
    if fd < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("create socket"))
    }
    return .ok(fd)
}

/// macOS has no SOCK_CLOEXEC, so the flag is set straight after creation.
@cfg(os("macos"))
func openSocketFd(_ domain: int32, _ type_: int32) -> Result[int32, Error] {
    fd := std::libc::socket(domain, type_, 0)
    if fd < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("create socket"))
    }
    match setCloseOnExecFd(fd) {
        case .ok(_) => return .ok(fd)
        case .err(err) => {
            var _ = std::libc::close(fd)
            return .err(err)
        }
    }
}

@cfg(family("windows"))
public func socket(_ domain: SocketDomain, _ type_: SocketType) -> Result[RawSocket, Error] {
    todo("std.sys.net.socket not implemented on windows yet")
}

@cfg(family("unix"))
public func bind(_ socket: &RawSocket, _ address: SocketAddress) -> Result[(), Error] {
    var (storage, len) = encodeSocketAddress(address)
    ptr := unsafe { (&storage as *const [uint8; SOCKET_ADDRESS_STORAGE_LEN]) as *const uint8 }
    res := unsafe { std::libc::bind(socket.fd, ptr, len) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("bind"))
    }
    return .ok(())
}

@cfg(family("windows"))
public func bind(_ socket: &RawSocket, _ address: SocketAddress) -> Result[(), Error] {
    todo("std.sys.net.bind not implemented on windows yet")
}

@cfg(family("unix"))
public func listen(_ socket: &RawSocket, _ backlog: int32) -> Result[(), Error] {
    res := std::libc::listen(socket.fd, backlog)
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("listen"))
    }
    return .ok(())
}

@cfg(family("windows"))
public func listen(_ socket: &RawSocket, _ backlog: int32) -> Result[(), Error] {
    todo("std.sys.net.listen not implemented on windows yet")
}

@cfg(family("unix"))
public func connect(_ socket: &RawSocket, _ address: SocketAddress) -> Result[(), Error] {
    var (storage, len) = encodeSocketAddress(address)
    ptr := unsafe { (&storage as *const [uint8; SOCKET_ADDRESS_STORAGE_LEN]) as *const uint8 }
    res := unsafe { std::libc::connect(socket.fd, ptr, len) }
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("connect"))
    }
    return .ok(())
}


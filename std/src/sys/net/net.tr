public func connect(_ socket: &RawSocket, _ address: SocketAddress) -> Result[(), Error] {
    todo("std.sys.net.connect not implemented on windows yet")
}

@cfg(family("unix"))
public func accept(_ socket: &RawSocket) -> Result[(RawSocket, SocketAddress), Error] {
    var storage: [uint8; SOCKET_ADDRESS_STORAGE_LEN] = [0; SOCKET_ADDRESS_STORAGE_LEN]
    var len: std::libc::socklen_t = SOCKET_ADDRESS_STORAGE_LEN as std::libc::socklen_t
    ptr := unsafe { (&storage as *mut [uint8; SOCKET_ADDRESS_STORAGE_LEN]) as *mut uint8 }
    lenPtr := unsafe { (&len as *mut std::libc::socklen_t) }
    childFd := match unsafe { acceptFd(socket.fd, ptr, lenPtr) } {
        case .ok(fd) => fd
        case .err(err) => return .err(err)
    }

    addressRes := decodeSocketAddress(storage, len)
    address := match addressRes {
        case .ok(value) => value
        case .err(err) => {
            var _ = std::libc::close(childFd)
            return .err(err)
        }
    }

    return .ok((RawSocket { fd: childFd }, address))
}

/// An accepted connection that closes on exec; atomic on Linux via accept4.
@cfg(os("linux"))
unsafe func acceptFd(
    _ fd: int32,
    _ addr: *mut uint8,
    _ len: *mut std::libc::socklen_t,
) -> Result[int32, Error] {
    childFd := unsafe { std::libc::accept4(fd, addr, len, std::libc::SOCK_CLOEXEC) }
    if childFd < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("accept"))
    }
    return .ok(childFd)
}

@cfg(os("macos"))
unsafe func acceptFd(
    _ fd: int32,
    _ addr: *mut uint8,
    _ len: *mut std::libc::socklen_t,
) -> Result[int32, Error] {
    childFd := unsafe { std::libc::accept(fd, addr, len) }
    if childFd < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("accept"))
    }
    match setCloseOnExecFd(childFd) {
        case .ok(_) => return .ok(childFd)
        case .err(err) => {
            var _ = std::libc::close(childFd)
            return .err(err)
        }
    }
}

@cfg(family("windows"))
public func accept(_ socket: &RawSocket) -> Result[(RawSocket, SocketAddress), Error] {
    todo("std.sys.net.accept not implemented on windows yet")
}

@cfg(family("unix"))
public func close(_ socket: &RawSocket) -> Result[(), Error] {
    if socket.fd < 0 {
        return .ok(())
    }

    res := std::libc::close(socket.fd)
    if res < 0 {
        return .err(std::sys::io::unix::lastError().withOperation("close socket"))
    }
    socket.fd = -1
    return .ok(())
}

@cfg(family("windows"))
public func close(_ socket: &RawSocket) -> Result[(), Error] {
    todo("std.sys.net.close not implemented on windows yet")
}


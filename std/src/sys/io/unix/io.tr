import std::io::Error
import std::result::Result

extern "taro_rt" {
    func __rt__async_io_adopt_fd(_ fd: int32) -> usize
    func __rt__async_io_close_source(_ source_id: usize) -> int32
    func __rt__async_io_dup(_ fd: int32) -> int32
    unsafe func __rt__async_io_pipe(_ read_fd_out: *mut int32, _ write_fd_out: *mut int32) -> int32
    unsafe func __rt__async_io_read_source(_ source_id: usize, _ buf: *mut uint8, _ len: usize) -> isize
    unsafe func __rt__async_io_write_source(_ source_id: usize, _ buf: *const uint8, _ len: usize) -> isize
    func __rt__fd_lease_open(_ fd: int32) -> uint64
    func __rt__fd_lease_acquire(_ lease: uint64) -> int32
    func __rt__fd_lease_release(_ lease: uint64) -> int32
    func __rt__fd_lease_close(_ lease: uint64) -> int32
    func __rt__fd_lease_take(_ lease: uint64) -> int32
}

// Descriptor leases. Copies of a resource handle share one lease id; each
// native call acquires the descriptor for its own duration, and close defers
// releasing the descriptor until the last in-flight call has finished, so a
// concurrent close can never hand an active descriptor number to a new open.
// Lease ids are never reused; 0 is never a live lease. An async stream's
// source id is its lease id.

public func leaseOpen(_ fd: int32) -> uint64 {
    __rt__fd_lease_open(fd)
}

/// Borrow the descriptor for one native call; pair with `leaseRelease`.
public func leaseAcquire(_ lease: uint64, _ operation: string) -> Result[int32, Error] {
    fd := __rt__fd_lease_acquire(lease)
    if fd < 0 {
        return .err(mapErrno(0_i32 - fd).withOperation(operation))
    }
    return .ok(fd)
}

public func leaseRelease(_ lease: uint64) {
    var _ = __rt__fd_lease_release(lease)
}

/// Stops new operations immediately. With an operation in flight, success
/// acknowledges the close request; the descriptor closes after its last call.
/// Deferred close failures are reported on stderr and in runtime statistics.
public func leaseClose(_ lease: uint64, _ operation: string) -> Result[(), Error] {
    res := __rt__fd_lease_close(lease)
    if res < 0 {
        return .err(mapErrno(0_i32 - res).withOperation(operation))
    }
    return .ok(())
}

/// Transfer the descriptor out of an idle lease without closing it.
public func leaseTake(_ lease: uint64, _ operation: string) -> Result[int32, Error] {
    fd := __rt__fd_lease_take(lease)
    if fd < 0 {
        return .err(mapErrno(0_i32 - fd).withOperation(operation))
    }
    return .ok(fd)
}

public struct PlatformAsyncStream {
    internal source_id: usize
}

public func writeStdout(_ buf: *const uint8, _ len: usize) -> Result[usize, Error] {
    res := unsafe { std::libc::write(std::libc::STDOUT_FILENO, buf, len) }
    if res < 0 {
        return .err(lastError().withOperation("write stdout"))
    }
    return .ok(res as usize)
}

public func writeStderr(_ buf: *const uint8, _ len: usize) -> Result[usize, Error] {
    res := unsafe { std::libc::write(std::libc::STDERR_FILENO, buf, len) }
    if res < 0 {
        return .err(lastError().withOperation("write stderr"))
    }
    return .ok(res as usize)
}

/// Reads from the process's standard input.
///
/// The mirror of `writeStdout`: a direct descriptor read, with none of the
/// reactor registration `stdin()` performs, so a synchronous caller does not
/// need the async runtime running.
public func readStdin(_ buf: *mut uint8, _ len: usize) -> Result[usize, Error] {
    res := unsafe { std::libc::read(std::libc::STDIN_FILENO, buf, len) }
    if res < 0 {
        return .err(lastError().withOperation("read stdin"))
    }
    return .ok(res as usize)
}

public func adoptFd(_ fd: int32) -> Result[PlatformAsyncStream, Error] {
    sourceId := __rt__async_io_adopt_fd(fd)
    if sourceId == 0 {
        // Read first: close() may replace the reason adoption failed.
        error := lastError().withOperation("adopt file descriptor")
        var _ = std::libc::close(fd)
        return .err(error)
    }

    return .ok(PlatformAsyncStream {
        source_id: sourceId,
    })
}

func duplicateAndWrap(_ fd: int32) -> Result[PlatformAsyncStream, Error] {
    duplicated := __rt__async_io_dup(fd)
    if duplicated < 0 {
        return .err(lastError().withOperation("duplicate file descriptor"))
    }

    return adoptFd(duplicated)
}

public func stdin() -> Result[PlatformAsyncStream, Error] {
    duplicateAndWrap(std::libc::STDIN_FILENO)
}

public func stdout() -> Result[PlatformAsyncStream, Error] {
    duplicateAndWrap(std::libc::STDOUT_FILENO)
}

public func stderr() -> Result[PlatformAsyncStream, Error] {
    duplicateAndWrap(std::libc::STDERR_FILENO)
}

public func pipe() -> Result[(PlatformAsyncStream, PlatformAsyncStream), Error] {
    var readFd: int32 = -1
    var writeFd: int32 = -1
    res := unsafe { __rt__async_io_pipe(
        unsafe { (&readFd as *mut int32) },
        unsafe { (&writeFd as *mut int32) },
    ) }
    if res < 0 {
        return .err(lastError().withOperation("create pipe"))
    }

    readEnd := adoptFd(readFd)
    wrappedRead := match readEnd {
        case .ok(stream) => stream
        case .err(err) => {
            var _ = std::libc::close(writeFd)
            return .err(err)
        }
    }

    writeEnd := adoptFd(writeFd)
    wrappedWrite := match writeEnd {
        case .ok(stream) => stream
        case .err(err) => {
            var _ = close(wrappedRead)
            return .err(err)
        }
    }

    return .ok((wrappedRead, wrappedWrite))
}

public func close(_ stream: PlatformAsyncStream) -> Result[(), Error] {
    if stream.source_id == 0 {
        return .ok(())
    }

    res := __rt__async_io_close_source(stream.source_id)
    if res < 0 {
        return .err(mapErrno((0_i32 - res) as int32).withOperation("close"))
    }
    return .ok(())
}

// A socket with nothing ready is routine, and callers go on to wait for it, so
// that one case doesn't allocate the details an error's reader would want.
func sourceFailure(_ res: isize, _ operation: string) -> Error {
    error := mapErrno(((0 as isize) - res) as int32)
    if error.isKind(.wouldBlock) { return error }
    return error.withOperation(operation)
}

public func read(
    _ stream: &PlatformAsyncStream,
    _ buf: *mut uint8,
    _ len: usize,
) -> Result[usize, Error] {
    res := unsafe { __rt__async_io_read_source(stream.source_id, buf, len) }
    if res < 0 {
        return .err(sourceFailure(res, "read"))
    }
    return .ok(res as usize)
}

public func write(
    _ stream: &PlatformAsyncStream,
    _ buf: *const uint8,
    _ len: usize,
) -> Result[usize, Error] {
    res := unsafe { __rt__async_io_write_source(stream.source_id, buf, len) }
    if res < 0 {
        return .err(sourceFailure(res, "write"))
    }
    return .ok(res as usize)
}

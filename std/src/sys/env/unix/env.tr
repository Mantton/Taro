import std::intrinsic::{__intrinsic_env_argc, __intrinsic_env_argv}
import std::collections::List
import std::io::Error
import std::mem::Span
import std::result::Result

extern "blocking" {
    unsafe func __rt__env_get(
        _ name: string,
        _ dataOut: *mut *mut uint8,
        _ lenOut: *mut usize,
        _ presentOut: *mut bool,
    ) -> int32
    unsafe func __rt__env_set(_ name: string, _ value: string) -> int32
    unsafe func __rt__env_remove(_ name: string) -> int32
    unsafe func __rt__env_snapshot_open(_ lenOut: *mut usize) -> usize
    unsafe func __rt__env_current_dir(_ dataOut: *mut *mut uint8, _ lenOut: *mut usize) -> int32
    unsafe func __rt__env_set_current_dir(_ path: string) -> int32
    unsafe func __rt__env_home_dir(_ dataOut: *mut *mut uint8, _ lenOut: *mut usize) -> int32
    unsafe func __rt__env_temp_dir(_ dataOut: *mut *mut uint8, _ lenOut: *mut usize) -> int32
}

extern "taro_rt" {
    unsafe func __rt__env_owned_bytes_free(_ data: *mut uint8)
    unsafe func __rt__env_snapshot_at(
        _ handle: usize,
        _ index: usize,
        _ nameDataOut: *mut *const uint8,
        _ nameLenOut: *mut usize,
        _ valueDataOut: *mut *const uint8,
        _ valueLenOut: *mut usize,
    ) -> int32
    unsafe func __rt__env_snapshot_close(_ handle: usize)
}

public func argv() -> Span[*const uint8] {
    unsafe { Span[*const uint8]::from(__intrinsic_env_argv(), __intrinsic_env_argc()) }
}

func borrowedString(_ data: *const uint8, _ len: usize) -> string {
    if len == 0 {
        return ""
    }

    return std::string::stringFromBytes(unsafe { std::mem::Span[uint8]::from(data as *const uint8, len) })
}

func ownedString(_ data: *mut uint8, _ len: usize) -> string {
    defer { unsafe { __rt__env_owned_bytes_free(data) } }
    value := borrowedString(unsafe { data as *const uint8 }, len)
    return value
}

func envError(_ code: int32, _ operation: string) -> Error {
    std::sys::io::unix::mapErrno(code).withOperation(operation)
}

public func get(_ name: string) -> Result[string?, Error] {
    var data: *mut uint8 = unsafe { 0 as *mut uint8 }
    var len: usize = 0
    var present = false
    code := unsafe { __rt__env_get(
        name,
        unsafe { &data as *mut *mut uint8 },
        unsafe { &len as *mut usize },
        unsafe { &present as *mut bool },
    ) }
    if code != 0 {
        unsafe { __rt__env_owned_bytes_free(data) }
        return .err(envError(code, "read environment variable"))
    }
    if !present {
        unsafe { __rt__env_owned_bytes_free(data) }
        return .ok(.none)
    }
    return .ok(.some(ownedString(data, len)))
}

public func set(_ name: string, _ value: string) -> Result[(), Error] {
    code := unsafe { __rt__env_set(name, value) }
    if code != 0 {
        return .err(envError(code, "set environment variable"))
    }
    return .ok(())
}

public func remove(_ name: string) -> Result[(), Error] {
    code := unsafe { __rt__env_remove(name) }
    if code != 0 {
        return .err(envError(code, "remove environment variable"))
    }
    return .ok(())
}

public func vars() -> Result[List[(string, string)], Error] {
    var len: usize = 0
    handle := unsafe { __rt__env_snapshot_open(unsafe { &len as *mut usize }) }
    if handle == 0 {
        return .err(Error::new(.unexpected).withOperation("snapshot environment"))
    }
    defer { unsafe { __rt__env_snapshot_close(handle) } }

    var values = List[(string, string)]::new(withCapacity: len)
    var index: usize = 0
    while index < len {
        var nameData: *const uint8 = unsafe { 0 as *const uint8 }
        var nameLen: usize = 0
        var valueData: *const uint8 = unsafe { 0 as *const uint8 }
        var valueLen: usize = 0
        code := unsafe { __rt__env_snapshot_at(
            handle,
            index,
            unsafe { &nameData as *mut *const uint8 },
            unsafe { &nameLen as *mut usize },
            unsafe { &valueData as *mut *const uint8 },
            unsafe { &valueLen as *mut usize },
        ) }
        if code != 0 {
            return .err(envError(code, "snapshot environment"))
        }

        // Both strings are copied before advancing. The runtime deliberately
        // lends snapshot storage only for the snapshot handle's lifetime.
        values.append((borrowedString(nameData, nameLen), borrowedString(valueData, valueLen)))
        index += 1
    }
    return .ok(values)
}

func pathResult(
    _ code: int32,
    _ data: *mut uint8,
    _ len: usize,
    _ operation: string,
) -> Result[string, Error] {
    if code != 0 {
        unsafe { __rt__env_owned_bytes_free(data) }
        return .err(envError(code, operation))
    }
    return .ok(ownedString(data, len))
}

public func currentDir() -> Result[string, Error] {
    var data: *mut uint8 = unsafe { 0 as *mut uint8 }
    var len: usize = 0
    code := unsafe { __rt__env_current_dir(
        unsafe { &data as *mut *mut uint8 },
        unsafe { &len as *mut usize },
    ) }
    return pathResult(code, data, len, "get current directory")
}

public func setCurrentDir(_ path: string) -> Result[(), Error] {
    code := unsafe { __rt__env_set_current_dir(path) }
    if code != 0 {
        return .err(envError(code, "set current directory").withPath(path))
    }
    return .ok(())
}

public func homeDir() -> Result[string, Error] {
    var data: *mut uint8 = unsafe { 0 as *mut uint8 }
    var len: usize = 0
    code := unsafe { __rt__env_home_dir(
        unsafe { &data as *mut *mut uint8 },
        unsafe { &len as *mut usize },
    ) }
    return pathResult(code, data, len, "get home directory")
}

public func tempDir() -> Result[string, Error] {
    var data: *mut uint8 = unsafe { 0 as *mut uint8 }
    var len: usize = 0
    code := unsafe { __rt__env_temp_dir(
        unsafe { &data as *mut *mut uint8 },
        unsafe { &len as *mut usize },
    ) }
    return pathResult(code, data, len, "get temporary directory")
}

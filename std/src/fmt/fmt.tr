import std::collections::List
import std::mem::Span
import std::panic::panic
import std::string::Builder

const BYTE_ZERO: uint8 = 48
const BYTE_NINE: uint8 = 57
const BYTE_MINUS: uint8 = 45
const BYTE_SPACE: uint8 = 32
const BYTE_PERCENT: uint8 = 37
const BYTE_D: uint8 = 100
const BYTE_S: uint8 = 115
const BYTE_V: uint8 = 118
const BYTE_X: uint8 = 120
const BYTE_B: uint8 = 98
const BYTE_E_LOWER: uint8 = 101
const BYTE_DOT_SPEC: uint8 = 46
const BYTE_LEFT_BRACE: uint8 = 123
const BYTE_RIGHT_BRACE: uint8 = 125
const BYTE_LESS: uint8 = 60
const BYTE_GREATER: uint8 = 62
const BYTE_CARET: uint8 = 94
const BYTE_QUESTION: uint8 = 63

/// The width, alignment, precision and flags a conversion was written with.
///
/// Passed to every `Formattable`, so an implementation can honour them itself
/// when the default field padding is not what the type wants. Classic `%`
/// directives set only the width and the `-` and `0` flags. An interpolation
/// specifier such as `${price:*^10.2}` (lowered to `%{*^10.2}`) also sets
/// `fill`, `center` and the precision.
public struct FormatState {
    public width: usize
    public hasWidth: bool
    public alternate: bool
    public zeroPad: bool
    public leftAlign: bool
    public signPlus: bool
    public signSpace: bool
    /// The rune that pads a field to `width`. A space unless one is named.
    public fill: rune
    /// Centers the text, with any odd padding rune on the right.
    public center: bool
    /// Digits after the decimal point for floats, or the most runes kept
    /// from a string. Other built-in types ignore it.
    public precision: usize
    public hasPrecision: bool
}

extend FormatState {
    public static func default() -> Self {
        FormatState {
            width: 0,
            hasWidth: false,
            alternate: false,
            zeroPad: false,
            leftAlign: false,
            signPlus: false,
            signSpace: false,
            fill: ' ',
            center: false,
            precision: 0,
            hasPrecision: false,
        }
    }
}

internal enum ZeroPadMode {
    /// Non-numeric values pad with `'0'` normally without splitting a leading `'-'`.
    case plain
    /// Finite numeric values place `'0'` padding after a leading `'-'`.
    case signedNumeric
    /// Non-finite floats (`inf`, `-inf`, `nan`) suppress zero-padding and pad with spaces.
    case suppress
}

public struct Formatter {
    buffer: Builder
    internal zeroPadMode: ZeroPadMode
}

extend Formatter {
    public static func new() -> Self {
        Formatter { buffer: Builder::new(), zeroPadMode: .plain }
    }

    public func writeByte(_ value: uint8) {
        self.buffer.writeByte(value)
    }

    public func writeRune(_ value: rune) {
        self.buffer.writeRune(value)
    }

    public func writeString(_ value: string) {
        self.buffer.writeString(value)
    }

    public func toString() -> string {
        self.buffer.toString()
    }
}

@lang("Display")
public interface Display {
    func display(_ into: &Formatter)
}

public interface Formattable: Display {
    func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState)
}

// uint64 needs at most 20 decimal digits. Keep reversal storage local instead
// of creating a shared List and its element buffer for every number.
internal func appendUnsignedDecimal(_ out: &Builder, _ value: uint64) {
    var digits: [uint8; 20] = [0; 20]
    var count: usize = 0
    var n = value
    loop {
        digits[count] = BYTE_ZERO + ((n % 10) as uint8)
        count += 1
        n /= 10
        if n == 0 { break }
    }
    while count > 0 {
        count -= 1
        out.writeByte(digits[count])
    }
}

internal func appendSignedDecimal(_ out: &Builder, _ value: int64) {
    if value < 0 { out.writeByte(BYTE_MINUS) }
    var digits: [uint8; 20] = [0; 20]
    var count: usize = 0
    var n = value
    loop {
        // Negate only the remainder, so int64's minimum stays representable.
        var digit = n % 10
        if digit < 0 { digit = -digit }
        digits[count] = BYTE_ZERO + (digit as uint8)
        count += 1
        n /= 10
        if n == 0 { break }
    }
    while count > 0 {
        count -= 1
        out.writeByte(digits[count])
    }
}

// Formats with a known decimal contract need neither printf's existential
// arguments nor its scratch formatter and field-padding machinery.
internal func unsignedDecimalString(_ value: uint64) -> string {
    var digits: [uint8; 20] = [0; 20]
    var start: usize = 20
    var n = value
    loop {
        start -= 1
        digits[start] = BYTE_ZERO + ((n % 10_u64) as uint8)
        n /= 10_u64
        if n == 0_u64 { break }
    }
    bytes := unsafe { Span[uint8]::from((&digits as *mut [uint8; 20]) as *mut uint8, 20) }
    return std::string::stringFromBytes(bytes.slice(start, 20 - start))
}

internal func signedDecimalString(_ value: int64) -> string {
    var digits: [uint8; 20] = [0; 20]
    var start: usize = 20
    var n = value
    loop {
        // Negate only the remainder, so int64's minimum stays representable.
        var digit = n % 10
        if digit < 0 { digit = -digit }
        start -= 1
        digits[start] = BYTE_ZERO + (digit as uint8)
        n /= 10
        if n == 0 { break }
    }
    if value < 0 {
        start -= 1
        digits[start] = BYTE_MINUS
    }
    bytes := unsafe { Span[uint8]::from((&digits as *mut [uint8; 20]) as *mut uint8, 20) }
    return std::string::stringFromBytes(bytes.slice(start, 20 - start))
}

func writeSignedInteger(_ into: &Formatter, _ value: int64) {
    appendSignedDecimal(&into.buffer, value)
}

func writeUnsignedInteger(_ into: &Formatter, _ value: uint64) {
    appendUnsignedDecimal(&into.buffer, value)
}

// Hex and binary digits of `value`, most significant first, `bits` per digit.
func writeRadixDigits(_ into: &Formatter, _ value: uint64, _ bits: uint64) {
    var digits: [uint8; 64] = [0; 64]
    var start: usize = 64
    var n = value
    mask := (1_u64 << bits) - 1
    loop {
        digit := (n & mask) as uint8
        start -= 1
        digits[start] = if digit < 10 { BYTE_ZERO + digit } else { digit - 10 + ('a' as uint8) }
        n >>= bits
        if n == 0 { break }
    }
    while start < 64 {
        into.writeByte(digits[start])
        start += 1
    }
}

// `pattern` is the value's two's-complement bits at its own width, so `x`
// of an int8 -1 is `ff` and of an int32 -1 is `ffffffff`.
func formatSignedInteger(_ into: &Formatter, _ value: int64, _ pattern: uint64, _ spec: rune) {
    if spec == 'd' || spec == 'v' || spec == '?' {
        into.zeroPadMode = .signedNumeric
        writeSignedInteger(into, value)
    } else if spec == 'x' {
        into.zeroPadMode = .signedNumeric
        writeRadixDigits(into, pattern, 4)
    } else if spec == 'b' {
        into.zeroPadMode = .signedNumeric
        writeRadixDigits(into, pattern, 1)
    } else {
        panic("printf: invalid format specifier for integer argument")
    }
}

func formatUnsignedInteger(_ into: &Formatter, _ value: uint64, _ spec: rune) {
    if spec == 'd' || spec == 'v' || spec == '?' {
        into.zeroPadMode = .signedNumeric
        writeUnsignedInteger(into, value)
    } else if spec == 'x' {
        into.zeroPadMode = .signedNumeric
        writeRadixDigits(into, value, 4)
    } else if spec == 'b' {
        into.zeroPadMode = .signedNumeric
        writeRadixDigits(into, value, 1)
    } else {
        panic("printf: invalid format specifier for integer argument")
    }
}

/// Writes `count` copies of `fill`.
func writeFill(_ into: &Formatter, _ fill: uint8, _ count: usize) {
    var written: usize = 0
    while written < count {
        into.writeByte(fill)
        written += 1
    }
}

/// Writes `count` copies of a fill rune.
func writeFillRune(_ into: &Formatter, _ fill: rune, _ count: usize) {
    var written: usize = 0
    while written < count {
        into.writeRune(fill)
        written += 1
    }
}

/// Writes `rendered` into a field `state.width` wide.
///
/// Padding is applied here, once, rather than by each `Formattable`, so every
/// type is padded consistently and a new one gets the behaviour for free.
func writePadded(
    _ into: &Formatter,
    _ rendered: string,
    _ state: &FormatState,
    _ zeroPadMode: ZeroPadMode,
) {
    if !state.hasWidth {
        into.writeString(rendered)
        return
    }

    // Width counts characters, not bytes, so a multi-byte rune occupies one
    // column rather than as many columns as it takes bytes to encode.
    visible := rendered.runeCount()
    if visible >= state.width {
        into.writeString(rendered)
        return
    }

    padding := state.width - visible
    if state.leftAlign {
        into.writeString(rendered)
        writeFillRune(into, state.fill, padding)
        return
    }

    if state.center {
        before := padding / 2
        writeFillRune(into, state.fill, before)
        into.writeString(rendered)
        writeFillRune(into, state.fill, padding - before)
        return
    }

    if state.zeroPad && state.fill == ' ' {
        match zeroPadMode {
            case .signedNumeric => {
                // A sign belongs in front of the zeros: `%04d` of -7 is `-007`.
                if rendered.startsWith("-") {
                    digits := std::string::stringLen(rendered) - 1
                    into.writeByte(BYTE_MINUS)
                    writeFill(into, BYTE_ZERO, padding)
                    into.writeString(rendered.substring(1, digits))
                    return
                }
                writeFill(into, BYTE_ZERO, padding)
                into.writeString(rendered)
                return
            }
            case .plain => {
                writeFill(into, BYTE_ZERO, padding)
                into.writeString(rendered)
                return
            }
            case .suppress => {}
        }
    }

    writeFillRune(into, state.fill, padding)
    into.writeString(rendered)
}

// Room for a typical argument, which usually spares the text a second allocation.
const FORMAT_ARGUMENT_BYTES: usize = 16

// Argument sources share parsing and padding. A known single argument keeps
// its concrete type instead of being boxed into an erased variadic container.
interface PrintfArguments {
    func len() -> usize
    func render(_ into: &Formatter, _ index: usize, _ spec: rune, _ state: &FormatState)
}

struct ErasedPrintfArguments { values: Span[any Display] }
conform ErasedPrintfArguments to PrintfArguments {
    func len() -> usize { self.values.len() }
    func render(_ into: &Formatter, _ index: usize, _ spec: rune, _ state: &FormatState) {
        formatArgument(into, self.values.at(index), spec, state)
    }
}

struct SinglePrintfArgument[Value: Formattable] { value: Value }
conform[Value: Formattable] SinglePrintfArgument[Value] to PrintfArguments {
    func len() -> usize { 1 as usize }
    func render(_ into: &Formatter, _ index: usize, _ spec: rune, _ state: &FormatState) {
        // Ordinary value copying preserves nested erased-value snapshots;
        // class and explicit-reference arguments retain their target identity.
        var snapshot = self.value
        snapshot.format(into, spec, state)
    }
}

public func formatPrintf(_ format: string, _ args: Span[any Display]) -> string {
    formatPrintfWith(format, ErasedPrintfArguments { values: args })
}

internal func formatPrintfOne[Value: Formattable](_ format: string, _ value: Value) -> string {
    formatPrintfWith(format, SinglePrintfArgument[Value] { value })
}

func formatPrintfWith[Args: PrintfArguments](_ format: string, _ args: Args) -> string {
    format_len := std::string::stringLen(format)
    format_data := std::string::stringData(format)

    var writer = Formatter::new()
    writer.buffer.reserve(format_len + args.len() * FORMAT_ARGUMENT_BYTES)
    var index: usize = 0
    var arg_index: usize = 0

    while index < format_len {
        ch := unsafe { format_data.add(index).read() }
        if ch != BYTE_PERCENT {
            var end = index + 1
            while end < format_len && unsafe { format_data.add(end).read() } != BYTE_PERCENT { end += 1 }
            writer.buffer.writeStringRange(format, index, end - index)
            index = end
            continue
        }

        index += 1
        if index >= format_len {
            panic("printf: dangling '%' at end of format string")
        }

        // An escaped percent takes no flags, so it is settled before they are read.
        if unsafe { format_data.add(index).read() } == BYTE_PERCENT {
            writer.writeByte(BYTE_PERCENT)
            index += 1
            continue
        }

        // `%{spec}` carries an interpolation specifier, already validated
        // by the compiler when it came from `${value:spec}`.
        if unsafe { format_data.add(index).read() } == BYTE_LEFT_BRACE {
            var state = FormatState::default()
            var spec: rune = 'v'
            index = parseBraceSpec(format, index + 1, &state, &spec)
            if arg_index >= args.len() {
                panic("printf: missing format argument")
            }
            if state.hasWidth {
                var scratch = Formatter::new()
                args.render(&scratch, arg_index, spec, &state)
                writePadded(&writer, scratch.toString(), &state, scratch.zeroPadMode)
            } else {
                args.render(&writer, arg_index, spec, &state)
            }
            arg_index += 1
            continue
        }

        // Flags, then width. `%-8s` and `%04d` are what a column of aligned
        // output needs, and are the forms this understands.
        var state = FormatState::default()
        var readingFlags = true
        while readingFlags && index < format_len {
            flag := unsafe { format_data.add(index).read() }
            if flag == BYTE_MINUS {
                state.leftAlign = true
                index += 1
            } else if flag == BYTE_ZERO {
                state.zeroPad = true
                index += 1
            } else {
                readingFlags = false
            }
        }

        while index < format_len {
            digit := unsafe { format_data.add(index).read() }
            if digit < BYTE_ZERO || digit > BYTE_NINE {
                break
            }
            state.width = state.width * 10 + ((digit - BYTE_ZERO) as usize)
            state.hasWidth = true
            index += 1
        }

        if index >= format_len {
            panic("printf: dangling '%' at end of format string")
        }

        spec_byte := unsafe { format_data.add(index).read() }
        if spec_byte != BYTE_D && spec_byte != BYTE_S && spec_byte != BYTE_V {
            panic("printf: unknown format specifier")
        }

        if arg_index >= args.len() {
            panic("printf: missing format argument")
        }

        spec := if spec_byte == BYTE_D {
            'd'
        } else if spec_byte == BYTE_S {
            's'
        } else {
            'v'
        }

        // A field width is measured against the finished text, whatever the
        // argument's own formatting produced, so that text is rendered aside first.
        if state.hasWidth {
            var scratch = Formatter::new()
            args.render(&scratch, arg_index, spec, &state)
            writePadded(&writer, scratch.toString(), &state, scratch.zeroPadMode)
        } else {
            args.render(&writer, arg_index, spec, &state)
        }
        arg_index += 1
        index += 1
    }

    if arg_index != args.len() {
        panic("printf: extra arguments provided")
    }

    writer.buffer.takeString()
}

func isAlignment(_ byte: uint8) -> bool {
    byte == BYTE_LESS || byte == BYTE_GREATER || byte == BYTE_CARET
}

func applyAlignment(_ state: &FormatState, _ byte: uint8) {
    state.leftAlign = byte == BYTE_LESS
    state.center = byte == BYTE_CARET
}

func readSpecNumber(_ format: string, _ start: usize, _ end: usize) -> (usize, usize) {
    data := std::string::stringData(format)
    var index = start
    var value: usize = 0
    while index < end {
        digit := unsafe { data.add(index).read() }
        if digit < BYTE_ZERO || digit > BYTE_NINE { break }
        value = value * 10 + ((digit - BYTE_ZERO) as usize)
        index += 1
    }
    return (value, index)
}

/// Parses `[[fill]align][0][width][.precision][x|b|e|?]}` starting at `start`,
/// just after the `{`, and returns the index after the closing `}`.
func parseBraceSpec(_ format: string, _ start: usize, _ state: &FormatState, _ spec: &rune) -> usize {
    format_len := std::string::stringLen(format)
    data := std::string::stringData(format)
    var close = start
    while close < format_len && unsafe { data.add(close).read() } != BYTE_RIGHT_BRACE { close += 1 }
    if close >= format_len {
        panic("printf: unterminated '%{' format specifier")
    }

    var index = start
    if index < close {
        var (fill, width) = std::string::decodeRune(format, index)
        if index + width < close && isAlignment(unsafe { data.add(index + width).read() }) {
            state.fill = fill
            applyAlignment(state, unsafe { data.add(index + width).read() })
            index += width + 1
        } else if isAlignment(unsafe { data.add(index).read() }) {
            applyAlignment(state, unsafe { data.add(index).read() })
            index += 1
        }
    }
    if index < close && unsafe { data.add(index).read() } == BYTE_ZERO {
        state.zeroPad = true
        index += 1
    }
    var (width, afterWidth) = readSpecNumber(format, index, close)
    if afterWidth > index {
        state.width = width
        state.hasWidth = true
        index = afterWidth
    }
    if index < close && unsafe { data.add(index).read() } == BYTE_DOT_SPEC {
        var (precision, afterPrecision) = readSpecNumber(format, index + 1, close)
        if afterPrecision == index + 1 {
            panic("printf: missing precision after '.' in format specifier")
        }
        state.precision = precision
        state.hasPrecision = true
        index = afterPrecision
    }
    if index < close {
        presentation := unsafe { data.add(index).read() }
        if presentation == BYTE_X {
            *spec = 'x'
        } else if presentation == BYTE_B {
            *spec = 'b'
        } else if presentation == BYTE_E_LOWER {
            *spec = 'e'
        } else if presentation == BYTE_QUESTION {
            *spec = '?'
        } else {
            panic("printf: unknown format presentation")
        }
        index += 1
    }
    if index != close {
        panic("printf: malformed format specifier")
    }
    return close + 1
}

func formatArgument(_ into: &Formatter, _ value: &any Display, _ spec: rune, _ state: &FormatState) {
    // Cast through the reference: the successful result is still a value
    // snapshot, without first copying a separate Display temporary.
    match value as? any Formattable {
        case .some(formattable) => formattable.format(into, spec, state)
        case .none => {
            if spec == 'v' {
                (*value).display(into)
            } else if spec == '?' {
                match value as? any Debug {
                    case .some(debugValue) => debugValue.debug(into)
                    case .none => panic("printf: argument does not support requested format specifier")
                }
            } else {
                panic("printf: argument does not support requested format specifier")
            }
        }
    }
}

conform string to Display {
    public func display(_ into: &Formatter) {
        into.writeString(self)
    }
}

conform string to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        if spec == '?' {
            self.debug(into)
            return
        }
        if spec == 's' || spec == 'v' {
            if state.hasPrecision {
                // Precision keeps at most that many runes, never splitting one.
                len := std::string::stringLen(self)
                var byteIndex: usize = 0
                var kept: usize = 0
                while byteIndex < len && kept < state.precision {
                    var (_, width) = std::string::decodeRune(self, byteIndex)
                    byteIndex += width
                    kept += 1
                }
                into.writeString(self.substring(0, byteIndex))
                return
            }
            into.writeString(self)
            return
        }

        panic("printf: invalid format specifier for string argument")
    }
}

conform bool to Display {
    public func display(_ into: &Formatter) {
        if self {
            into.writeString("true")
        } else {
            into.writeString("false")
        }
    }
}

conform bool to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        if spec == 'v' || spec == '?' {
            if self {
                into.writeString("true")
            } else {
                into.writeString("false")
            }
            return
        }

        panic("printf: invalid format specifier for bool argument")
    }
}

conform rune to Display {
    public func display(_ into: &Formatter) {
        into.writeRune(self)
    }
}

conform rune to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        if spec == 'v' {
            into.writeRune(self)
            return
        }
        if spec == '?' {
            self.debug(into)
            return
        }

        panic("printf: invalid format specifier for rune argument")
    }
}

conform int8 to Display {
    public func display(_ into: &Formatter) { writeSignedInteger(into, self as int64) }
}

conform int8 to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatSignedInteger(into, self as int64, (self as uint8) as uint64, spec)
    }
}

conform int16 to Display {
    public func display(_ into: &Formatter) { writeSignedInteger(into, self as int64) }
}

conform int16 to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatSignedInteger(into, self as int64, (self as uint16) as uint64, spec)
    }
}

conform int32 to Display {
    public func display(_ into: &Formatter) { writeSignedInteger(into, self as int64) }
}

conform int32 to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatSignedInteger(into, self as int64, (self as uint32) as uint64, spec)
    }
}

conform int64 to Display {
    public func display(_ into: &Formatter) { writeSignedInteger(into, self) }
}

conform int64 to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatSignedInteger(into, self, self as uint64, spec)
    }
}

conform isize to Display {
    public func display(_ into: &Formatter) { writeSignedInteger(into, self as int64) }
}

conform isize to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatSignedInteger(into, self as int64, (self as usize) as uint64, spec)
    }
}

conform uint8 to Display {
    public func display(_ into: &Formatter) { writeUnsignedInteger(into, self as uint64) }
}

conform uint8 to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatUnsignedInteger(into, self as uint64, spec)
    }
}

conform uint16 to Display {
    public func display(_ into: &Formatter) { writeUnsignedInteger(into, self as uint64) }
}

conform uint16 to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatUnsignedInteger(into, self as uint64, spec)
    }
}

conform uint32 to Display {
    public func display(_ into: &Formatter) { writeUnsignedInteger(into, self as uint64) }
}

conform uint32 to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatUnsignedInteger(into, self as uint64, spec)
    }
}

conform uint64 to Display {
    public func display(_ into: &Formatter) { writeUnsignedInteger(into, self) }
}

conform uint64 to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatUnsignedInteger(into, self, spec)
    }
}

conform usize to Display {
    public func display(_ into: &Formatter) { writeUnsignedInteger(into, self as uint64) }
}

conform usize to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatUnsignedInteger(into, self as uint64, spec)
    }
}

conform[Element: Display] List[Element] to Display {
    public func display(_ into: &Formatter) {
        into.writeByte('[' as uint8)

        var idx: usize = 0
        count := self.len()
        while idx < count {
            if idx > 0 {
                into.writeString(", ")
            }
            value := self.at(idx)
            value.display(into)
            idx += 1
        }

        into.writeByte(']' as uint8)
    }
}

conform[Element: Formattable] List[Element] to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        if spec != 'v' && spec != '?' {
            panic("printf: invalid format specifier for list argument")
        }

        into.writeByte('[' as uint8)

        var idx: usize = 0
        count := self.len()
        while idx < count {
            if idx > 0 {
                into.writeString(", ")
            }
            value := self.at(idx)
            value.format(into, spec, state)
            idx += 1
        }

        into.writeByte(']' as uint8)
    }
}

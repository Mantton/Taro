conform usize to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        formatUnsignedInteger(into, self as uint64, spec)
    }
}

conform[Element: Display] List[Element] to Display {
    public func display(_ into: &Formatter) {
        into.writeByte('[' as uint8)

        var idx: usize = 0
        count := self.len()
        while idx < count {
            if idx > 0 {
                into.writeString(", ")
            }
            value := self.at(idx)
            value.display(into)
            idx += 1
        }

        into.writeByte(']' as uint8)
    }
}

conform[Element: Formattable] List[Element] to Formattable {
    public func format(_ into: &Formatter, _ spec: rune, _ state: &FormatState) {
        if spec != 'v' {
            panic("printf: invalid format specifier for list argument")
        }

        into.writeByte('[' as uint8)

        var idx: usize = 0
        count := self.len()
        while idx < count {
            if idx > 0 {
                into.writeString(", ")
            }
            value := self.at(idx)
            value.format(into, spec, state)
            idx += 1
        }

        into.writeByte(']' as uint8)
    }
}

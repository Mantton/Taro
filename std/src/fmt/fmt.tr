import std.collections.List
import std.mem.Span
import std.string.Builder

const BYTE_ZERO: uint8 = 48
const BYTE_NINE: uint8 = 57
const BYTE_MINUS: uint8 = 45
const BYTE_SPACE: uint8 = 32
const BYTE_PERCENT: uint8 = 37
const BYTE_D: uint8 = 100
const BYTE_S: uint8 = 115
const BYTE_V: uint8 = 118

/// The width and flags a conversion was written with.
///
/// Passed to every `Formattable`, so an implementation can honour them itself
/// when the default field padding is not what the type wants.
public struct FormatState {
    public width: usize
    public precision: usize
    public hasWidth: bool
    public hasPrecision: bool
    public alternate: bool
    public zeroPad: bool
    public leftAlign: bool
    public signPlus: bool
    public signSpace: bool
}

impl FormatState {
    public func default() -> Self {
        FormatState {
            width: 0,
            precision: 0,
            hasWidth: false,
            hasPrecision: false,
            alternate: false,
            zeroPad: false,
            leftAlign: false,
            signPlus: false,
            signSpace: false,
        }
    }
}

public struct Formatter {
    buffer: Builder
}

impl Formatter {
    public func new() -> Self {
        Formatter { buffer: Builder() }
    }

    public func writeByte(&mut self, _ value: uint8) {
        self.buffer.writeByte(value)
    }

    public func writeRune(&mut self, _ value: rune) {
        self.buffer.writeRune(value)
    }

    public func writeString(&mut self, _ value: string) {
        self.buffer.writeString(value)
    }

    public func intoString(self) -> string {
        self.buffer.intoString()
    }
}

public interface Display {
    func display(&self, _ into: &mut Formatter)
}

public interface Formattable: Display {
    func format(&self, _ into: &mut Formatter, _ spec: rune, _ state: &FormatState)
}

func appendUnsignedDecimal(_ out: &mut Builder, _ value: uint64) {
    if value == 0 {
        out.writeByte(BYTE_ZERO)
        return
    }

    var n = value
    var rev = List[uint8]()
    while n > 0 {
        let digit = (n % 10) as uint8
        rev.append(BYTE_ZERO + digit)
        n = n / 10
    }

    var idx = rev.len()
    while idx > 0 {
        idx -= 1
        out.writeByte(*rev.at(idx))
    }
}

func appendSignedDecimal(_ out: &mut Builder, _ value: int64) {
    if value < 0 {
        out.writeByte(BYTE_MINUS)
    }

    var n = value
    var rev = List[uint8]()
    loop {
        var digit = n % 10
        if digit < 0 {
            digit = -digit
        }

        rev.append(BYTE_ZERO + (digit as uint8))
        n = n / 10
        if n == 0 {
            break
        }
    }

    var idx = rev.len()
    while idx > 0 {
        idx -= 1
        out.writeByte(*rev.at(idx))
    }
}

func writeSignedInteger(_ into: &mut Formatter, _ value: int64) {
    appendSignedDecimal(&mut into.buffer, value)
}

func writeUnsignedInteger(_ into: &mut Formatter, _ value: uint64) {
    appendUnsignedDecimal(&mut into.buffer, value)
}

func formatSignedInteger(_ into: &mut Formatter, _ value: int64, _ spec: rune) {
    if !(spec == 'd' || spec == 'v') {
        std.panic.panic("printf: invalid format specifier for integer argument")
    }

    writeSignedInteger(into, value)
}

func formatUnsignedInteger(_ into: &mut Formatter, _ value: uint64, _ spec: rune) {
    if !(spec == 'd' || spec == 'v') {
        std.panic.panic("printf: invalid format specifier for integer argument")
    }

    writeUnsignedInteger(into, value)
}

/// Writes `count` copies of `fill`.
func writeFill(_ into: &mut Formatter, _ fill: uint8, _ count: usize) {
    var written: usize = 0
    while written < count {
        into.writeByte(fill)
        written += 1
    }
}

/// Writes `rendered` into a field `state.width` wide.
///
/// Padding is applied here, once, rather than by each `Formattable`, so every
/// type is padded consistently and a new one gets the behaviour for free.
func writePadded(_ into: &mut Formatter, _ rendered: string, _ state: &FormatState) {
    if !state.hasWidth {
        into.writeString(rendered)
        return
    }

    // Width counts characters, not bytes, so a multi-byte rune occupies one
    // column rather than as many columns as it takes bytes to encode.
    let visible = rendered.runeCount()
    if visible >= state.width {
        into.writeString(rendered)
        return
    }

    let padding = state.width - visible
    if state.leftAlign {
        into.writeString(rendered)
        writeFill(into, BYTE_SPACE, padding)
        return
    }

    if state.zeroPad {
        // A sign belongs in front of the zeros: `%04d` of -7 is `-007`.
        if rendered.startsWith("-") {
            let digits = std.string.stringLen(rendered) - 1
            into.writeByte(BYTE_MINUS)
            writeFill(into, BYTE_ZERO, padding)
            into.writeString(rendered.substring(1, digits))
            return
        }
        writeFill(into, BYTE_ZERO, padding)
        into.writeString(rendered)
        return
    }

    writeFill(into, BYTE_SPACE, padding)
    into.writeString(rendered)
}

public func formatPrintf(_ format: string, _ args: Span[any Display]) -> string {
    let format_len = std.string.stringLen(format)
    let format_data = std.string.stringData(format)

    var writer = Formatter.new()
    var index: usize = 0
    var arg_index: usize = 0

    while index < format_len {
        let ch = format_data.add(index).read()
        if ch != BYTE_PERCENT {
            writer.writeByte(ch)
            index += 1
            continue
        }

        index += 1
        if index >= format_len {
            std.panic.panic("printf: dangling '%' at end of format string")
        }

        // An escaped percent takes no flags, so it is settled before they are read.
        if format_data.add(index).read() == BYTE_PERCENT {
            writer.writeByte(BYTE_PERCENT)
            index += 1
            continue
        }

        // Flags, then width. `%-8s` and `%04d` are what a column of aligned
        // output needs, and are the forms this understands.
        var state = FormatState.default()
        var readingFlags = true
        while readingFlags && index < format_len {
            let flag = format_data.add(index).read()
            if flag == BYTE_MINUS {
                state.leftAlign = true
                index += 1
            } else if flag == BYTE_ZERO {
                state.zeroPad = true
                index += 1
            } else {
                readingFlags = false
            }
        }

        while index < format_len {
            let digit = format_data.add(index).read()
            if digit < BYTE_ZERO || digit > BYTE_NINE {
                break
            }
            state.width = state.width * 10 + ((digit - BYTE_ZERO) as usize)
            state.hasWidth = true
            index += 1
        }

        if index >= format_len {
            std.panic.panic("printf: dangling '%' at end of format string")
        }

        let spec_byte = format_data.add(index).read()
        if spec_byte != BYTE_D && spec_byte != BYTE_S && spec_byte != BYTE_V {
            std.panic.panic("printf: unknown format specifier")
        }

        if arg_index >= args.len() {
            std.panic.panic("printf: missing format argument")
        }

        let spec = if spec_byte == BYTE_D {
            'd'
        } else if spec_byte == BYTE_S {
            's'
        } else {
            'v'
        }

        // Rendered aside first so the field width can be measured against the
        // finished text, whatever the argument's own formatting produced.
        var scratch = Formatter.new()
        let value = args.at(arg_index)
        let maybe_formattable = (*value) as? any Formattable
        match maybe_formattable {
            case .some(formattable) => formattable.format(&mut scratch, spec, &state)
            case .none => match spec == 'v' {
                case true => (*value).display(&mut scratch)
                case false => std.panic.panic("printf: argument does not support requested format specifier")
            }
        }
        writePadded(&mut writer, scratch.intoString(), &state)
        arg_index += 1
        index += 1
    }

    if arg_index != args.len() {
        std.panic.panic("printf: extra arguments provided")
    }

    writer.intoString()
}

impl Display for string {
    public func display(&self, _ into: &mut Formatter) {
        into.writeString(*self)
    }
}

impl Formattable for string {
    public func format(&self, _ into: &mut Formatter, _ spec: rune, _ state: &FormatState) {
        if spec == 's' || spec == 'v' {
            into.writeString(*self)
            return
        }

        std.panic.panic("printf: invalid format specifier for string argument")
    }
}

impl Display for bool {
    public func display(&self, _ into: &mut Formatter) {
        if *self {
            into.writeString("true")
        } else {
            into.writeString("false")
        }
    }
}

impl Formattable for bool {
    public func format(&self, _ into: &mut Formatter, _ spec: rune, _ state: &FormatState) {
        if spec == 'v' {
            if *self {
                into.writeString("true")
            } else {
                into.writeString("false")
            }
            return
        }

        std.panic.panic("printf: invalid format specifier for bool argument")
    }
}

impl Display for rune {
    public func display(&self, _ into: &mut Formatter) {
        into.writeRune(*self)
    }
}

impl Formattable for rune {
    public func format(&self, _ into: &mut Formatter, _ spec: rune, _ state: &FormatState) {
        if spec == 'v' {
            into.writeRune(*self)
            return
        }

        std.panic.panic("printf: invalid format specifier for rune argument")
    }
}

impl Display for int8 {
    public func display(&self, _ into: &mut Formatter) { writeSignedInteger(into, *self as int64) }
}

impl Formattable for int8 {
    public func format(&self, _ into: &mut Formatter, _ spec: rune, _ state: &FormatState) {
        formatSignedInteger(into, *self as int64, spec)
    }
}

impl Display for int16 {
    public func display(&self, _ into: &mut Formatter) { writeSignedInteger(into, *self as int64) }
}


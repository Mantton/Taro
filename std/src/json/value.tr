import std::collections::{Dictionary, List}
import std::convert::ParseError
import std::fmt::Display
import std::marker::Clone
import std::ops::PartialEq
import std::optional::Optional
import std::result::Result

/// The category of a JSON number construction failure.
public enum NumberErrorKind: PartialEq {
    case empty
    case invalidSyntax
}

/// A failure to construct an exact JSON number from text.
public struct NumberError {
    kindValue: NumberErrorKind
    indexValue: usize
}

extend NumberError {
    static func new(_ kind: NumberErrorKind, _ index: usize) -> Self {
        NumberError { kindValue: kind, indexValue: index }
    }

    public func kind() -> NumberErrorKind {
        self.kindValue
    }

    public func index() -> usize {
        self.indexValue
    }
}

conform NumberErrorKind to Display {
    public func display(_ into: &std::fmt::Formatter) {
        match self {
            case .empty => into.writeString("empty JSON number")
            case .invalidSyntax => into.writeString("invalid JSON number syntax")
        }
    }
}

conform NumberError to Display {
    public func display(_ into: &std::fmt::Formatter) {
        self.kindValue.display(into)
        into.writeString(" at byte ")
        self.indexValue.display(into)
    }
}

conform NumberError to std::error::Error {}

@inline
func isDigit(_ byte: uint8) -> bool {
    byte >= ('0' as uint8) && byte <= ('9' as uint8)
}

func validateNumberText(_ text: string) -> NumberError? {
    len := text.byteLen()
    if len == 0 {
        return .some(NumberError::new(.empty, 0))
    }

    var index: usize = 0
    if text.byteAt(index) == ('-' as uint8) {
        index += 1
        if index == len {
            return .some(NumberError::new(.invalidSyntax, index))
        }
    }

    if text.byteAt(index) == ('0' as uint8) {
        index += 1
        if index < len && isDigit(text.byteAt(index)) {
            return .some(NumberError::new(.invalidSyntax, index))
        }
    } else {
        first := text.byteAt(index)
        if first < ('1' as uint8) || first > ('9' as uint8) {
            return .some(NumberError::new(.invalidSyntax, index))
        }
        index += 1
        while index < len && isDigit(text.byteAt(index)) {
            index += 1
        }
    }

    if index < len && text.byteAt(index) == ('.' as uint8) {
        index += 1
        if index == len || !isDigit(text.byteAt(index)) {
            return .some(NumberError::new(.invalidSyntax, index))
        }
        while index < len && isDigit(text.byteAt(index)) {
            index += 1
        }
    }

    if index < len {
        byte := text.byteAt(index)
        if byte == ('e' as uint8) || byte == ('E' as uint8) {
            index += 1
            if index < len {
                sign := text.byteAt(index)
                if sign == ('+' as uint8) || sign == ('-' as uint8) {
                    index += 1
                }
            }
            if index == len || !isDigit(text.byteAt(index)) {
                return .some(NumberError::new(.invalidSyntax, index))
            }
            while index < len && isDigit(text.byteAt(index)) {
                index += 1
            }
        }
    }

    if index != len {
        return .some(NumberError::new(.invalidSyntax, index))
    }
    return .none
}

/// An exact JSON number.
///
/// The validated lexical form is retained instead of converting through a
/// floating-point type, so large integers and significant exponent spelling
/// survive a parse/encode round trip unchanged.
public struct Number {
    textValue: string
}

extend Number {
    public static func parse(_ text: string) -> Result[Self, NumberError] {
        match validateNumberText(text) {
            case .some(error) => return .err(error)
            case .none => return .ok(Number { textValue: text })
        }
    }

    /// Construct from text whose complete JSON number grammar was already
    /// checked by the streaming parser. Keeping this package-private avoids a
    /// second scan without weakening the validating public constructor.
    static func fromValidated(_ text: string) -> Self {
        Number { textValue: text }
    }

    public func text() -> string {
        self.textValue
    }

    public func asInt64() -> Result[int64, ParseError] {
        int64::parse(self.textValue)
    }

    public func asUint64() -> Result[uint64, ParseError] {
        uint64::parse(self.textValue)
    }

    public func asDouble() -> Result[double, ParseError] {
        double::parse(self.textValue)
    }
}

conform Number to Display {
    public func display(_ into: &std::fmt::Formatter) {
        into.writeString(self.textValue)
    }
}

struct ObjectMember {
    keyValue: string
    valueValue: Value
}

// Small objects keep the original member list and allocate no index. A class
// optional uses the existing null-pointer representation, keeping Object to
// two words and Value to three on 64-bit targets without another enum layer.
const OBJECT_INDEX_THRESHOLD: usize = 32
const OBJECT_INITIAL_CAPACITY: usize = 4

final class ObjectLookupIndex {
    lookup: Dictionary[string, usize]
}

extend ObjectLookupIndex {
    init(_ lookup: Dictionary[string, usize]) { self.lookup = lookup }
}

/// An insertion-ordered JSON object. Large parsed objects retain a shared
/// SwissTable index without changing member order or duplicate-key policy.
public struct Object {
    members: List[ObjectMember]
    index: ObjectLookupIndex?
}

extend Object {
    public static func new() -> Self {
        Object { members: List[ObjectMember]::new(), index: .none }
    }

    // Call only while constructing an unpublished object. Once returned to
    // callers every copy shares the same members and (when present) index.
    // Ordinary Object::new() values keep linear storage, so promoting a local
    // header can never leave a pre-existing external alias with a stale index.
    func indexedForParsing() -> Self {
        if self.index.isSome() || self.members.len() < OBJECT_INDEX_THRESHOLD { return self }
        var lookup = Dictionary[string, usize]::new()
        var index: usize = 0
        while index < self.members.len() {
            lookup.set(key: self.members.at(index).keyValue, value: index)
            index += 1
        }
        return Object { members: self.members, index: .some(ObjectLookupIndex(lookup)) }
    }

    @inline
    public func len() -> usize { self.members.len() }
    public func isEmpty() -> bool { self.members.isEmpty() }
    public func contains(_ key: string) -> bool { self.indexOf(key).isSome() }

    public func get(_ key: string) -> Optional[&Value] {
        match self.indexOf(key) {
            case .some(index) => return .some(&self.members.at(index).valueValue)
            case .none => return .none
        }
    }

    public func keyAt(_ index: usize) -> string { self.members.at(index).keyValue }
    public func valueAt(_ index: usize) -> &Value { &self.members.at(index).valueValue }

    /// Insert a member only when its key is not already present.
    public func insert(_ key: string, _ value: Value) -> bool {
        if self.indexOf(key).isSome() { return false }
        self.appendKnownUnique(key, value)
        return true
    }

    /// Insert or replace a member without changing its original position.
    public func set(_ key: string, _ value: Value) {
        match self.indexOf(key) {
            case .some(index) => self.replaceAt(index, value)
            case .none => self.appendKnownUnique(key, value)
        }
    }

    func indexOf(_ key: string) -> usize? {
        match self.index {
            case .some(index) => return index.lookup.get(&key)
            case .none => {}
        }
        var index: usize = 0
        while index < self.members.len() {
            if self.members.at(index).keyValue == key { return .some(index) }
            index += 1
        }
        return .none
    }

    /// Parser-only insertion after its duplicate lookup.
    func appendKnownUnique(_ key: string, _ value: Value) {
        index := self.members.len()
        // Empty objects need no buffer. Four slots on the first insertion
        // avoid immediately growing small records while leaving List's
        // conservative policy for other wide element types unchanged.
        if index == 0 { self.members.reserve(OBJECT_INITIAL_CAPACITY) }
        self.members.append(ObjectMember { keyValue: key, valueValue: value })
        match self.index {
            case .none => {}
            case .some(lookup) => lookup.lookup.set(key: key, value: index)
        }
    }

    /// Parser-only replacement at the index returned by `indexOf`.
    func replaceAt(_ index: usize, _ value: Value) {
        member := self.members.at(index)
        member.valueValue = value
    }
}

conform Object to Clone {
    public func clone() -> Self {
        var result = Object::new()
        var index: usize = 0
        while index < self.members.len() {
            member := self.members.at(index)
            result.appendKnownUnique(member.keyValue, member.valueValue.clone())
            index += 1
        }
        return result.indexedForParsing()
    }
}

/// The kind of a JSON DOM value.
public enum ValueKind: PartialEq {
    case null
    case boolean
    case number
    case string
    case array
    case object
}

/// A JSON DOM value.
public enum Value {
    case null
    case boolean(bool)
    case number(Number)
    case string(string)
    case array(List[Value])
    case object(Object)
}

extend Value {
    public func kind() -> ValueKind {
        match self {
            case .null => .null
            case .boolean(_) => .boolean
            case .number(_) => .number
            case .string(_) => .string
            case .array(_) => .array
            case .object(_) => .object
        }
    }

    public func asBool() -> bool? {
        match self {
            case .boolean(value) => .some(value)
            case _ => .none
        }
    }

    public func asNumber() -> Number? {
        match self {
            case .number(value) => .some(value)
            case _ => .none
        }
    }

    public func asString() -> string? {
        match self {
            case .string(value) => .some(value)
            case _ => .none
        }
    }

    public func arrayLen() -> usize? {
        match self {
            case .array(value) => .some(value.len())
            case _ => .none
        }
    }

    public func arrayAt(_ index: usize) -> Optional[&Value] {
        match self {
            case .array(value) => value.get(index)
            case _ => .none
        }
    }

    public func asObject() -> Optional[Object] {
        match self {
            case .object(value) => .some(value)
            case _ => .none
        }
    }
}

conform Value to Clone {
    public func clone() -> Self {
        match self {
            case .null => .null
            case .boolean(value) => .boolean(value)
            case .number(value) => .number(value)
            case .string(value) => .string(value)
            case .array(value) => .array(value.clone())
            case .object(value) => .object(value.clone())
        }
    }
}

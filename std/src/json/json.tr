import std::default::Default
import std::fmt::Display
import std::ops::PartialEq
import std::optional::Optional

/// The default maximum nesting depth accepted by JSON parsers and encoders.
public const DEFAULT_MAX_DEPTH: usize = 128

/// The default maximum number of bytes accepted for one JSON text.
public const DEFAULT_MAX_INPUT_BYTES: usize = 16 * 1024 * 1024

/// How an object parser handles a repeated member name.
public enum DuplicateKeyPolicy: PartialEq {
    /// Reject the object. This is the default because silently choosing one
    /// value can create security differences between downstream consumers.
    case reject
    /// Keep the first value and still validate the later value.
    case useFirst
    /// Replace the earlier value with the last value.
    case useLast
}

/// Resource and compatibility controls shared by parsers and encoders.
public struct Options {
    maxDepthValue: usize
    maxInputBytesValue: usize
    duplicateKeysValue: DuplicateKeyPolicy
    validationFirstValue: bool
}

extend Options {
    /// Construct options with safe, finite defaults.
    public static func new() -> Self {
        Options {
            maxDepthValue: DEFAULT_MAX_DEPTH,
            maxInputBytesValue: DEFAULT_MAX_INPUT_BYTES,
            duplicateKeysValue: .reject,
            validationFirstValue: false,
        }
    }

    public func maxDepth() -> usize {
        self.maxDepthValue
    }

    public func maxInputBytes() -> usize {
        self.maxInputBytesValue
    }

    public func duplicateKeys() -> DuplicateKeyPolicy {
        self.duplicateKeysValue
    }

    /// Validate the complete text before calling custom decoders or initializers.
    /// Disabled by default: single-pass decoding may construct values before a
    /// later syntax error is discovered. Only applies to string typed decoding.
    public func validationFirst() -> bool { self.validationFirstValue }

    public func withValidationFirst(_ enabled: bool) -> Self {
        Options {
            maxDepthValue: self.maxDepthValue,
            maxInputBytesValue: self.maxInputBytesValue,
            duplicateKeysValue: self.duplicateKeysValue,
            validationFirstValue: enabled,
        }
    }

    public func withMaxDepth(_ maximum: usize) -> Self {
        Options {
            maxDepthValue: maximum,
            maxInputBytesValue: self.maxInputBytesValue,
            duplicateKeysValue: self.duplicateKeysValue,
            validationFirstValue: self.validationFirstValue,
        }
    }

    public func withMaxInputBytes(_ maximum: usize) -> Self {
        Options {
            maxDepthValue: self.maxDepthValue,
            maxInputBytesValue: maximum,
            duplicateKeysValue: self.duplicateKeysValue,
            validationFirstValue: self.validationFirstValue,
        }
    }

    public func withDuplicateKeys(_ policy: DuplicateKeyPolicy) -> Self {
        Options {
            maxDepthValue: self.maxDepthValue,
            maxInputBytesValue: self.maxInputBytesValue,
            duplicateKeysValue: policy,
            validationFirstValue: self.validationFirstValue,
        }
    }
}

conform Options to Default {
    public static func default() -> Self {
        Options::new()
    }
}

/// A stable category for JSON input failures.
public enum ErrorKind: PartialEq {
    case unexpectedEof
    case unexpectedToken
    case trailingData
    case invalidNumber
    case invalidEscape
    case invalidUnicodeEscape
    case invalidUtf8
    case unescapedControlCharacter
    case duplicateKey
    case depthLimit
    case inputLimit
    case io
}

struct JsonErrorPayload {
    kindValue: ErrorKind
    messageValue: string
    offsetValue: usize
    lineValue: usize
    columnValue: usize
    pathValue: string
    ioErrorValue: std::io::Error?
}

// A compact header keeps diagnostic storage out of successful Results.
// Payloads are allocated on errors and never mutated; rebasing creates a new one.
/// A JSON input failure with source position and value-path context.
///
/// Byte offsets are zero-based. Lines and columns are one-based and columns
/// count bytes, which makes every reported location directly seekable in the
/// original input even when it contains malformed UTF-8.
public struct Error {
    data: &JsonErrorPayload
}

extend Error {
    static func at(
        _ kind: ErrorKind,
        _ message: string,
        _ offset: usize,
        _ line: usize,
        _ column: usize,
        _ path: string,
    ) -> Self {
        payload := JsonErrorPayload {
            kindValue: kind,
            messageValue: message,
            offsetValue: offset,
            lineValue: line,
            columnValue: column,
            pathValue: path,
            ioErrorValue: .none,
        }
        Error { data: &payload }
    }

    static func fromIo(
        _ cause: std::io::Error,
        _ offset: usize,
        _ line: usize,
        _ column: usize,
        _ path: string,
    ) -> Self {
        var ioErrorValue: std::io::Error? = .some(cause)
        payload := JsonErrorPayload {
            kindValue: .io,
            messageValue: "I/O failure while reading JSON",
            offsetValue: offset,
            lineValue: line,
            columnValue: column,
            pathValue: path,
            ioErrorValue,
        }
        Error { data: &payload }
    }

    /// Rebase a root-relative child error beneath an already materialized
    /// container path. Parsers use this only while unwinding an error, keeping
    /// successful traversal free of JSONPath allocations.
    func rebased(_ parent: string) -> Self {
        var suffix = self.data.pathValue
        if suffix.byteLen() > 0 && suffix.byteAt(0) == ('$' as uint8) {
            suffix = suffix.sliceBytes(1, suffix.byteLen() - 1)
        }
        payload := JsonErrorPayload {
            kindValue: self.data.kindValue,
            messageValue: self.data.messageValue,
            offsetValue: self.data.offsetValue,
            lineValue: self.data.lineValue,
            columnValue: self.data.columnValue,
            pathValue: parent.concat(suffix),
            ioErrorValue: self.data.ioErrorValue,
        }
        Error { data: &payload }
    }

    public func kind() -> ErrorKind {
        self.data.kindValue
    }

    public func message() -> string {
        self.data.messageValue
    }

    public func byteOffset() -> usize {
        self.data.offsetValue
    }

    public func line() -> usize {
        self.data.lineValue
    }

    public func column() -> usize {
        self.data.columnValue
    }

    public func path() -> string {
        self.data.pathValue
    }

    /// Return an independent error value, rather than a reference into a variant.
    public func ioError() -> Optional[std::io::Error] {
        self.data.ioErrorValue
    }
}

conform ErrorKind to Display {
    public func display(_ into: &std::fmt::Formatter) {
        match self {
            case .unexpectedEof => into.writeString("unexpected end of JSON input")
            case .unexpectedToken => into.writeString("unexpected JSON token")
            case .trailingData => into.writeString("trailing data after JSON value")
            case .invalidNumber => into.writeString("invalid JSON number")
            case .invalidEscape => into.writeString("invalid JSON string escape")
            case .invalidUnicodeEscape => into.writeString("invalid JSON Unicode escape")
            case .invalidUtf8 => into.writeString("invalid UTF-8 in JSON string")
            case .unescapedControlCharacter => into.writeString("unescaped control character in JSON string")
            case .duplicateKey => into.writeString("duplicate JSON object key")
            case .depthLimit => into.writeString("JSON nesting limit exceeded")
            case .inputLimit => into.writeString("JSON input-size limit exceeded")
            case .io => into.writeString("JSON input I/O failure")
        }
    }
}

conform Error to Display {
    public func display(_ into: &std::fmt::Formatter) {
        self.data.kindValue.display(into)
        into.writeString(" at ")
        into.writeString(self.data.pathValue)
        into.writeString(" (line ")
        self.data.lineValue.display(into)
        into.writeString(", column ")
        self.data.columnValue.display(into)
        into.writeString(", byte ")
        self.data.offsetValue.display(into)
        into.writeString("): ")
        into.writeString(self.data.messageValue)

        match self.data.ioErrorValue {
            case .some(cause) => {
                into.writeString(": ")
                cause.display(into)
            }
            case .none => {}
        }
    }
}

conform Error to std::error::Error {}

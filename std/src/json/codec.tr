import std.collections.List
import std.convert.Parse
import std.fmt.Display
import std.io.Reader
import std.result.Result

/// Preserve the JSON-facing category name while sharing the format-neutral
/// categories used by every `std.encoding` codec.
public type CodecErrorKind = std.encoding.CodingErrorKind

/// A typed value-conversion failure with JSONPath context.
public struct CodecError {
    kindValue: CodecErrorKind
    messageValue: string
    pathValue: string
}

impl CodecError {
    /// Construct an error at the root value.
    public func new(_ kind: CodecErrorKind, _ message: string) -> Self {
        CodecError { kindValue: kind, messageValue: message, pathValue: ROOT_PATH }
    }

    /// Construct an error at an explicit JSONPath.
    public func at(_ kind: CodecErrorKind, _ path: string, _ message: string) -> Self {
        CodecError { kindValue: kind, messageValue: message, pathValue: path }
    }

    public func kind(&self) -> CodecErrorKind {
        self.kindValue
    }

    public func message(&self) -> string {
        self.messageValue
    }

    public func path(&self) -> string {
        self.pathValue
    }
}

impl std.fmt.Display for CodecError {
    public func display(&self, _ into: &mut std.fmt.Formatter) {
        self.kindValue.display(into)
        into.writeString(" at ")
        into.writeString(self.pathValue)
        into.writeString(": ")
        into.writeString(self.messageValue)
    }
}

impl std.error.Error for CodecError {}

/// JSON encoding now reports one concrete output error directly. Value
/// conversion participates through the encoder's associated error type, so a
/// second wrapper enum would only duplicate the same path and category.
public type JsonEncodeError = EncodeError

/// A combined failure from JSON syntax parsing and typed value conversion.
public enum JsonDecodeError {
    case syntax(Error)
    case codec(CodecError)
}

impl std.fmt.Display for JsonDecodeError {
    public func display(&self, _ into: &mut std.fmt.Formatter) {
        match self {
            case .syntax(error) => error.display(into)
            case .codec(error) => error.display(into)
        }
    }
}

impl std.error.Error for JsonDecodeError {}

enum DecodeContainerKind: std.marker.Copy {
    case sequence
    case object
}

struct DecodeFrame {
    kind: DecodeContainerKind
    value: &Value
    path: string
    index: usize
    valuePending: bool
}

/// Adapt the stable JSON DOM to the format-neutral decoder contract.
///
/// Keeping this adapter private makes the current parse-then-convert strategy
/// an implementation detail. A future token-stream decoder can remove the DOM
/// allocation without changing `Decodable` implementations or derived code.
struct ValueDecoder {
    current: &Value
    pathValue: string
    frames: List[DecodeFrame]
    rootValueConsumed: bool
}

impl ValueDecoder {
    func new(_ value: &Value) -> Self {
        ValueDecoder {
            current: value,
            pathValue: ROOT_PATH,
            frames: List[DecodeFrame](),
            rootValueConsumed: false,
        }
    }

    /// Mark the selected DOM node as consumed by one scalar, container, or
    /// explicit skip operation. A direct token decoder will need this same
    /// cursor invariant, so enforcing it here keeps handwritten codecs honest.
    func consumeValue(&mut self) -> Result[(), CodecError] {
        if self.frames.isEmpty() {
            if self.rootValueConsumed {
                return .err(CodecError.at(
                    .invalidState,
                    self.pathValue,
                    "decodable value attempted to consume the root more than once",
                ))
            }
            self.rootValueConsumed = true
            return .ok(())
        }

        let frame = self.frames.at(self.frames.len() - 1)
        if !frame.valuePending {
            return .err(CodecError.at(
                .invalidState,
                self.pathValue,
                "no current container value is available to consume",
            ))
        }
        frame.valuePending = false
        return .ok(())
    }

    func requireValue(&self) -> Result[(), CodecError] {
        let available = if self.frames.isEmpty() {
            !self.rootValueConsumed
        } else {
            self.frames.at(self.frames.len() - 1).valuePending
        }
        if !available {
            return .err(CodecError.at(
                .invalidState,
                self.pathValue,
                "no current value is available to decode",
            ))
        }
        return .ok(())
    }

    func finish(&self) -> Result[(), CodecError] {
        if !self.frames.isEmpty() {
            return .err(CodecError.at(
                .invalidState,
                self.pathValue,
                "decodable value left a container unfinished",
            ))
        }
        if !self.rootValueConsumed {
            return .err(CodecError.at(
                .invalidState,
                ROOT_PATH,
                "decodable value did not consume the root value",
            ))
        }
        return .ok(())
    }

    func typeMismatch(&self, _ expected: string) -> CodecError {
        CodecError.at(
            .typeMismatch,
            self.pathValue,
            "expected JSON ".concat(expected),
        )
    }

    func decodeNumberAs[Target: Parse](&mut self, _ expected: string) -> Result[Target, CodecError] {
        self.requireValue()!
        let text = match self.current {
            case .number(number) => number.text()
            case _ => return .err(self.typeMismatch(expected))
        }
        match Target.parse(text) {
            case .ok(value) => {
                self.consumeValue()!
                return .ok(value)
            }
            case .err(_) => {
                return .err(CodecError.at(
                    .invalidValue,
                    self.pathValue,
                    "JSON number is outside the target type or has an incompatible form",
                ))
            }
        }
    }

    func activeObjectPath(&self) -> string {
        if self.frames.isEmpty() {
            return self.pathValue
        }
        let frame = self.frames.at(self.frames.len() - 1)
        match frame.kind {
            case .object => return frame.path
            case .sequence => return self.pathValue
        }
    }
}

impl std.encoding.Decoder for ValueDecoder {
    type Error = CodecError

    public func error(&self, _ kind: std.encoding.CodingErrorKind, _ message: string) -> Self.Error {
        CodecError.at(kind, self.pathValue, message)
    }

    public func missingField(&self, _ name: string, _ message: string) -> Self.Error {
        CodecError.at(
            .missingField,
            childPathForKey(self.activeObjectPath(), name),
            message,
        )
    }

    public func peekKind(&self) -> Result[std.encoding.CodingValueKind, Self.Error] {
        self.requireValue()!
        let kind = match self.current {
            case .null => std.encoding.CodingValueKind.null
            case .boolean(_) => std.encoding.CodingValueKind.boolean
            case .number(_) => std.encoding.CodingValueKind.number
            case .string(_) => std.encoding.CodingValueKind.string
            case .array(_) => std.encoding.CodingValueKind.sequence
            case .object(_) => std.encoding.CodingValueKind.object
        }
        return .ok(kind)
    }

    public func decodeNull(&mut self) -> Result[(), Self.Error] {
        self.requireValue()!
        match self.current {
            case .null => {
                self.consumeValue()!
                return .ok(())
            }
            case _ => return .err(self.typeMismatch("null"))
        }
    }

    public func decodeBool(&mut self) -> Result[bool, Self.Error] {
        self.requireValue()!
        match self.current {
            case .boolean(value) => {
                let result = *value
                self.consumeValue()!
                return .ok(result)
            }
            case _ => return .err(self.typeMismatch("boolean"))
        }
    }

    public func decodeInt8(&mut self) -> Result[int8, Self.Error] { self.decodeNumberAs("int8") }
    public func decodeInt16(&mut self) -> Result[int16, Self.Error] { self.decodeNumberAs("int16") }
    public func decodeInt32(&mut self) -> Result[int32, Self.Error] { self.decodeNumberAs("int32") }
    public func decodeInt64(&mut self) -> Result[int64, Self.Error] { self.decodeNumberAs("int64") }
    public func decodeIsize(&mut self) -> Result[isize, Self.Error] { self.decodeNumberAs("isize") }
    public func decodeUint8(&mut self) -> Result[uint8, Self.Error] { self.decodeNumberAs("uint8") }
    public func decodeUint16(&mut self) -> Result[uint16, Self.Error] { self.decodeNumberAs("uint16") }
    public func decodeUint32(&mut self) -> Result[uint32, Self.Error] { self.decodeNumberAs("uint32") }
    public func decodeUint64(&mut self) -> Result[uint64, Self.Error] { self.decodeNumberAs("uint64") }
    public func decodeUsize(&mut self) -> Result[usize, Self.Error] { self.decodeNumberAs("usize") }
    public func decodeFloat(&mut self) -> Result[float, Self.Error] { self.decodeNumberAs("float") }
    public func decodeDouble(&mut self) -> Result[double, Self.Error] { self.decodeNumberAs("double") }

    public func decodeDecimal(&mut self) -> Result[string, Self.Error] {
        self.requireValue()!
        match self.current {
            case .number(number) => {
                let result = number.text()
                self.consumeValue()!
                return .ok(result)
            }
            case _ => return .err(self.typeMismatch("number"))
        }
    }

    public func decodeString(&mut self) -> Result[string, Self.Error] {
        self.requireValue()!
        match self.current {
            case .string(value) => {
                let result = *value
                self.consumeValue()!
                return .ok(result)
            }
            case _ => return .err(self.typeMismatch("string"))
        }
    }

    public func beginSequence(&mut self) -> Result[usize?, Self.Error] {
        self.requireValue()!
        let length = match self.current {
            case .array(values) => values.len()
            case _ => return .err(self.typeMismatch("array"))
        }
        self.consumeValue()!
        self.frames.append(DecodeFrame {
            kind: .sequence,
            value: self.current,
            path: self.pathValue,
            index: 0,
            valuePending: false,
        })
        let result: usize? = .some(length)
        return .ok(result)
    }

    public func nextElement(&mut self) -> Result[bool, Self.Error] {
        if self.frames.isEmpty() {
            return .err(CodecError.at(.invalidState, self.pathValue, "sequence element has no containing sequence"))
        }
        let frame = self.frames.at(self.frames.len() - 1)
        match frame.kind {
            case .object => return .err(CodecError.at(.invalidState, self.pathValue, "active container is an object"))
            case .sequence => {}
        }
        if frame.valuePending {
            return .err(CodecError.at(
                .invalidState,
                self.pathValue,
                "previous sequence element was not decoded or skipped",
            ))
        }
        let values = match frame.value {
            case .array(values) => values
            case _ => return .err(CodecError.at(.invalidState, self.pathValue, "sequence frame does not contain an array"))
        }
        if frame.index >= values.len() {
            return .ok(false)
        }
        let index = frame.index
        frame.index += 1
        frame.valuePending = true
        self.current = values.at(index)
        self.pathValue = childPathForIndex(frame.path, index)
        return .ok(true)
    }

    public func endSequence(&mut self) -> Result[(), Self.Error] {
        if self.frames.isEmpty() {
            return .err(CodecError.at(.invalidState, self.pathValue, "sequence end has no containing sequence"))
        }
        let frame = self.frames.at(self.frames.len() - 1)
        match frame.kind {
            case .object => return .err(CodecError.at(.invalidState, self.pathValue, "cannot end an object as a sequence"))
            case .sequence => {}
        }
        if frame.valuePending {
            return .err(CodecError.at(
                .invalidState,
                self.pathValue,
                "sequence ended before its current element was decoded or skipped",
            ))
        }
        let value = frame.value
        let path = frame.path
        let index = frame.index
        let length = match frame.value {
            case .array(values) => values.len()
            case _ => 0 as usize
        }
        if index != length {
            return .err(CodecError.at(
                .invalidState,
                path,
                "sequence decoder ended before consuming every element",
            ))
        }
        let _ = self.frames.pop()
        self.current = value
        self.pathValue = path
        return .ok(())
    }

    public func beginObject(&mut self) -> Result[usize?, Self.Error] {
        self.requireValue()!
        let length = match self.current {
            case .object(object) => object.len()
            case _ => return .err(self.typeMismatch("object"))
        }
        self.consumeValue()!
        self.frames.append(DecodeFrame {
            kind: .object,
            value: self.current,
            path: self.pathValue,
            index: 0,
            valuePending: false,
        })
        let result: usize? = .some(length)
        return .ok(result)
    }

    public func nextField(&mut self) -> Result[string?, Self.Error] {
        if self.frames.isEmpty() {
            return .err(CodecError.at(.invalidState, self.pathValue, "object field has no containing object"))
        }
        let frame = self.frames.at(self.frames.len() - 1)
        match frame.kind {
            case .sequence => return .err(CodecError.at(.invalidState, self.pathValue, "active container is a sequence"))
            case .object => {}
        }
        if frame.valuePending {
            return .err(CodecError.at(
                .invalidState,
                self.pathValue,
                "previous object field was not decoded or skipped",
            ))
        }
        let object = match frame.value {
            case .object(object) => object
            case _ => return .err(CodecError.at(.invalidState, self.pathValue, "object frame does not contain an object"))
        }
        if frame.index >= object.len() {
            let result: string? = .none
            return .ok(result)
        }
        let index = frame.index
        frame.index += 1
        frame.valuePending = true
        let name = object.keyAt(index)
        self.current = object.valueAt(index)
        self.pathValue = childPathForKey(frame.path, name)
        let result: string? = .some(name)
        return .ok(result)
    }

    public func skipValue(&mut self) -> Result[(), Self.Error] {
        // The DOM already owns the complete selected node; consuming it is
        // enough here. A token decoder would advance past the same subtree.
        self.consumeValue()
    }

    public func endObject(&mut self) -> Result[(), Self.Error] {
        if self.frames.isEmpty() {
            return .err(CodecError.at(.invalidState, self.pathValue, "object end has no containing object"))
        }
        let frame = self.frames.at(self.frames.len() - 1)
        match frame.kind {
            case .sequence => return .err(CodecError.at(.invalidState, self.pathValue, "cannot end a sequence as an object"))
            case .object => {}
        }
        if frame.valuePending {
            return .err(CodecError.at(
                .invalidState,
                self.pathValue,
                "object ended before its current field was decoded or skipped",
            ))
        }
        let value = frame.value
        let path = frame.path
        let index = frame.index
        let length = match frame.value {
            case .object(object) => object.len()
            case _ => 0 as usize
        }
        if index != length {
            return .err(CodecError.at(
                .invalidState,
                path,
                "object decoder ended before consuming every field",
            ))
        }
        let _ = self.frames.pop()
        self.current = value
        self.pathValue = path
        return .ok(())
    }
}

func decodeTarget[Target: std.encoding.Decodable, D: std.encoding.Decoder](
    _ decoder: &mut D,
) -> Result[Target, D.Error] {
    Target.decode(from: decoder)
}

func decodeFromValue[Target: std.encoding.Decodable](
    _ value: &Value,
) -> Result[Target, CodecError] {
    var decoder = ValueDecoder(value)
    let result = decodeTarget[Target, ValueDecoder](&mut decoder)!
    decoder.finish()!
    return .ok(result)
}

impl std.encoding.Encodable for Number {
    public func encode[E: std.encoding.Encoder](&self, into encoder: &mut E) -> Result[(), E.Error] {
        encoder.encodeDecimal(self.text())
    }
}

impl std.encoding.Decodable for Number {
    public func decode[D: std.encoding.Decoder](from decoder: &mut D) -> Result[Self, D.Error] {
        let text = decoder.decodeDecimal()!
        match Number.parse(text) {
            case .ok(number) => return .ok(number)
            case .err(_) => return .err(decoder.error(.invalidValue, "decoder returned an invalid exact decimal"))
        }
    }
}

impl std.encoding.Encodable for Value {
    public func encode[E: std.encoding.Encoder](&self, into encoder: &mut E) -> Result[(), E.Error] {
        match self {
            case .null => return encoder.encodeNull()
            case .boolean(value) => return encoder.encodeBool(*value)
            case .number(value) => return encoder.encodeDecimal(value.text())
            case .string(value) => return encoder.encodeString(*value)
            case .array(values) => {
                let length: usize? = .some(values.len())
                encoder.beginSequence(length)!
                var index: usize = 0
                while index < values.len() {
                    encoder.beginElement()!
                    std.encoding.encode[Value, E](values.at(index), into: encoder)!
                    index += 1
                }
                return encoder.endSequence()
            }
            case .object(object) => {
                let length: usize? = .some(object.len())
                encoder.beginObject(length)!
                var index: usize = 0
                while index < object.len() {
                    encoder.beginField(object.keyAt(index))!
                    std.encoding.encode[Value, E](object.valueAt(index), into: encoder)!
                    index += 1
                }
                return encoder.endObject()
            }
        }
    }
}

impl std.encoding.Decodable for Value {
    public func decode[D: std.encoding.Decoder](from decoder: &mut D) -> Result[Self, D.Error] {
        match decoder.peekKind()! {
            case .null => {
                decoder.decodeNull()!
                return .ok(.null)
            }
            case .boolean => return .ok(.boolean(decoder.decodeBool()!))
            case .number => {
                let text = decoder.decodeDecimal()!
                match Number.parse(text) {
                    case .ok(number) => return .ok(.number(number))
                    case .err(_) => return .err(decoder.error(.invalidValue, "decoder returned an invalid exact decimal"))
                }
            }
            case .string => return .ok(.string(decoder.decodeString()!))
            case .sequence => {
                let length = decoder.beginSequence()!
                var values = match length {
                    case .some(length) => List[Value](withCapacity: length)
                    case .none => List[Value]()
                }
                while decoder.nextElement()! {
                    values.append(decodeTarget[Value, D](decoder)!)
                }
                decoder.endSequence()!
                return .ok(.array(values))
            }
            case .object => {
                let _ = decoder.beginObject()!
                var object = Object()
                loop {
                    match decoder.nextField()! {
                        case .none => break
                        case .some(name) => {
                            let _ = object.insert(name, decodeTarget[Value, D](decoder)!)
                        }
                    }
                }
                decoder.endObject()!
                return .ok(.object(object))
            }
        }
    }
}

/// Encode any format-neutral value to one compact JSON string.
public func encode[Source: std.encoding.Encodable](_ source: &Source) -> Result[string, JsonEncodeError] {
    encodeWithOptions(source, Options())
}

/// Encode any format-neutral value with explicit JSON resource controls.
public func encodeWithOptions[Source: std.encoding.Encodable](
    _ source: &Source,
    _ options: Options,
) -> Result[string, JsonEncodeError] {
    var encoder = Encoder.withOptions(std.bytes.Buffer(), options)
    encoder.encode(source)!
    return .ok(encoder.intoInner().intoString())
}

/// Decode one complete JSON string into a format-neutral value type.
public func decode[Target: std.encoding.Decodable](_ input: string) -> Result[Target, JsonDecodeError] {
    decodeWithOptions[Target](input, Options())
}

public func decodeWithOptions[Target: std.encoding.Decodable](
    _ input: string,
    _ options: Options,
) -> Result[Target, JsonDecodeError] {
    let value = match parseWithOptions(input, options) {
        case .ok(value) => value
        case .err(error) => return .err(.syntax(error))
    }
    match decodeFromValue[Target](&value) {
        case .ok(result) => return .ok(result)
        case .err(error) => return .err(.codec(error))
    }
}

impl[Source: Reader] Decoder[Source] {
    /// Decode the next typed value, returning `.none` at clean end of input.
    public func next[Target: std.encoding.Decodable](&mut self) -> Result[Target?, JsonDecodeError] {
        let value = match self.nextValue() {
            case .ok(value) => value
            case .err(error) => return .err(.syntax(error))
        }
        match value {
            case .none => return .ok(.none)
            case .some(value) => {
                match decodeFromValue[Target](&value) {
                    case .ok(result) => return .ok(.some(result))
                    case .err(error) => return .err(.codec(error))
                }
            }
        }
    }

    /// Decode one required typed value from the stream.
    public func decode[Target: std.encoding.Decodable](&mut self) -> Result[Target, JsonDecodeError] {
        let value = match self.decodeValue() {
            case .ok(value) => value
            case .err(error) => return .err(.syntax(error))
        }
        match decodeFromValue[Target](&value) {
            case .ok(result) => return .ok(result)
            case .err(error) => return .err(.codec(error))
        }
    }
}

import std::io::Writer
import std::collections::List
import std::fmt::Display
import std::ops::PartialEq
import std::optional::Optional
import std::result::Result
import std::string::Builder

// Bound temporary writable copies even when a caller encodes a very large
// string to a slow Writer. UTF-8 scalars are kept together at chunk boundaries.
const STRING_OUTPUT_CHUNK_SIZE: usize = 4096

/// A stable category for JSON output failures.
public enum EncodeErrorKind: PartialEq {
    case invalidUtf8
    case invalidValue
    case invalidState
    case depthLimit
    case io
}

/// A JSON output failure with value-path context.
public struct EncodeError {
    // Out of line, so every step of a successful encode returns a small Result.
    data: EncodeErrorData
}

final class EncodeErrorData {
    kindValue: EncodeErrorKind
    messageValue: string
    pathValue: string
    stringByteIndexValue: usize?
    ioErrorValue: std::io::Error?
}

extend EncodeErrorData {
    init(_ kind: EncodeErrorKind, _ message: string, _ path: string, _ stringByteIndex: usize?, _ ioError: std::io::Error?) {
        self.kindValue = kind
        self.messageValue = message
        self.pathValue = path
        self.stringByteIndexValue = stringByteIndex
        self.ioErrorValue = ioError
    }
}

extend EncodeError {
    static func invalidUtf8(_ path: string, _ index: usize) -> Self {
        var stringByteIndexValue: usize? = .some(index)
        EncodeError { data: EncodeErrorData(EncodeErrorKind::invalidUtf8, "string contains invalid UTF-8", path, stringByteIndexValue, .none) }
    }

    static func depth(_ path: string) -> Self {
        EncodeError { data: EncodeErrorData(EncodeErrorKind::depthLimit, "value exceeds the configured nesting depth", path, .none, .none) }
    }

    static func fromIo(_ path: string, _ cause: std::io::Error) -> Self {
        var ioErrorValue: std::io::Error? = .some(cause)
        EncodeError { data: EncodeErrorData(EncodeErrorKind::io, "I/O failure while writing JSON", path, .none, ioErrorValue) }
    }

    static func coding(_ kind: std::encoding::CodingErrorKind, _ path: string, _ message: string) -> Self {
        kindValue := match kind {
            case .invalidState => EncodeErrorKind::invalidState
            case _ => EncodeErrorKind::invalidValue
        }
        EncodeError { data: EncodeErrorData(kindValue, message, path, .none, .none) }
    }

    public func kind() -> EncodeErrorKind {
        self.data.kindValue
    }

    public func message() -> string {
        self.data.messageValue
    }

    public func path() -> string {
        self.data.pathValue
    }

    /// Return the byte index within the offending string, when applicable.
    public func stringByteIndex() -> usize? {
        self.data.stringByteIndexValue
    }

    /// Return an independent error value, rather than a reference into a variant.
    public func ioError() -> Optional[std::io::Error] {
        self.data.ioErrorValue
    }
}

conform EncodeErrorKind to std::fmt::Display {
    public func display(_ into: &std::fmt::Formatter) {
        match self {
            case .invalidUtf8 => into.writeString("invalid UTF-8 in JSON output")
            case .invalidValue => into.writeString("value cannot be represented as JSON")
            case .invalidState => into.writeString("invalid JSON encoder state")
            case .depthLimit => into.writeString("JSON output nesting limit exceeded")
            case .io => into.writeString("JSON output I/O failure")
        }
    }
}

// Enough for many values with no growth; a string keeps it, so it stays small.
const ENCODED_INITIAL_CAPACITY: usize = 64
const ENCODED_SLACK_LIMIT: usize = 512

enum EncodeContainerKind {
    case sequence
    case object
}

struct EncodeFrame {
    kind: EncodeContainerKind
    key: string
    selected: bool
    count: usize
    expectedLength: usize?
    valuePending: bool
}

// The open containers, outermost first. Most values open only one at a time, so
// the first takes no list of its own. References last until the frame's next push.
struct EncodeFrames {
    first: EncodeFrame
    rest: List[EncodeFrame]?
    count: usize
}

extend EncodeFrames {
    static func new() -> Self {
        EncodeFrames {
            first: EncodeFrame {
                kind: .sequence, key: "", selected: false, count: 0,
                expectedLength: .none, valuePending: false,
            },
            rest: .none,
            count: 0,
        }
    }
}

extend &EncodeFrames {
    func len() -> usize { self.count }

    func isEmpty() -> bool { self.count == 0 }

    func at(_ index: usize) -> &EncodeFrame {
        if index == 0 { return &self.first }
        return self.rest.unwrap().at(index - 1)
    }

    func append(_ frame: EncodeFrame) {
        if self.count == 0 {
            self.first = frame
        } else {
            match self.rest {
                case .some(rest) => rest.append(frame)
                case .none => {
                    rest := List[EncodeFrame]::new()
                    rest.append(frame)
                    self.rest = .some(rest)
                }
            }
        }
        self.count += 1
    }

    func pop() {
        self.count -= 1
        if self.count > 0 { var _ = self.rest.unwrap().pop() }
    }
}

// A view of the existing cursor stack, not an eagerly formatted path. The
// depth also identifies a container while its last child remains selected.
struct EncodeLocation {
    frames: &EncodeFrames
    depth: usize
}

extend EncodeLocation {
    func render() -> string {
        var path = ROOT_PATH
        var index: usize = 0
        while index < self.depth {
            frame := self.frames.at(index)
            if frame.selected {
                path = match frame.kind {
                    case .sequence => childPathForIndex(path, frame.count - 1)
                    case .object => childPathForKey(path, frame.key)
                }
            }
            index += 1
        }
        return path
    }
}

conform EncodeError to std::fmt::Display {
    public func display(_ into: &std::fmt::Formatter) {
        self.data.kindValue.display(into)
        into.writeString(" at ")
        into.writeString(self.data.pathValue)
        match self.data.stringByteIndexValue {
            case .some(index) => {
                into.writeString(" (string byte ")
                index.display(into)
                into.writeByte(')' as uint8)
            }
            case .none => {}
        }
        into.writeString(": ")
        into.writeString(self.data.messageValue)
        match self.data.ioErrorValue {
            case .some(cause) => {
                into.writeString(": ")
                cause.display(into)
            }
            case .none => {}
        }
    }
}

conform EncodeError to std::error::Error {}

@inline
func writeOutput[Sink: Writer](
    _ sink: Sink,
    _ text: string,
    _ path: EncodeLocation,
) -> Result[(), EncodeError] {
    match std::io::writeString(sink, text) {
        case .ok(_) => return .ok(())
        case .err(cause) => return outputFailure(path, cause)
    }
}

@noinline
func outputFailure(_ path: EncodeLocation, _ cause: std::io::Error) -> Result[(), EncodeError] {
    return .err(EncodeError::fromIo(path.render(), cause))
}

/// Validate one UTF-8 sequence and return its width. The error payload is the
/// exact invalid byte index, including `len` for a truncated final sequence.
func utf8WidthAt(_ value: string, _ index: usize) -> Result[usize, usize] {
    len := value.byteLen()
    lead := value.byteAt(index)
    if lead < 0x80_u8 {
        return .ok(1)
    }

    var width: usize = 0
    if lead >= 0xC2_u8 && lead <= 0xDF_u8 {
        width = 2
    } else if lead >= 0xE0_u8 && lead <= 0xEF_u8 {
        width = 3
    } else if lead >= 0xF0_u8 && lead <= 0xF4_u8 {
        width = 4
    } else {
        return .err(index)
    }

    if width > len - index {
        return .err(len)
    }
    var offset: usize = 1
    while offset < width {
        continuation := value.byteAt(index + offset)
        if continuation < 0x80_u8 || continuation > 0xBF_u8 {
            return .err(index + offset)
        }
        if offset == 1 {
            if lead == 0xE0_u8 && continuation < 0xA0_u8 {
                return .err(index + offset)
            }
            if lead == 0xED_u8 && continuation > 0x9F_u8 {
                return .err(index + offset)
            }
            if lead == 0xF0_u8 && continuation < 0x90_u8 {
                return .err(index + offset)
            }
            if lead == 0xF4_u8 && continuation > 0x8F_u8 {
                return .err(index + offset)
            }
        }
        offset += 1
    }
    return .ok(width)
}

// The end of the run from `index` up to `end` needing no escape or validation.
func plainAsciiEnd(_ value: string, _ index: usize, _ end: usize) -> usize {
    data := std::string::stringData(value)
    var at = index
    // Skips whole words with no high bit, control byte, quote or backslash.
    while at + 8 <= end {
        if tokenStringSpecials(unsafe { tokenStringWord(data.add(at)) }) != 0_u64 { break }
        at += 8
    }
    while at < end {
        byte := unsafe { *data.add(at) }
        if byte < 0x20_u8 || byte >= 0x80_u8 || byte == ('\"' as uint8) || byte == ('\\' as uint8) {
            return at
        }
        at += 1
    }
    return end
}

func writeEscapedString[Sink: Writer](
    _ sink: Sink,
    _ value: string,
    _ path: EncodeLocation,
) -> Result[(), EncodeError] {
    // Most strings need no escaping or validation, and fit one write.
    if value.byteLen() <= STRING_OUTPUT_CHUNK_SIZE && plainAsciiEnd(value, 0, value.byteLen()) == value.byteLen() {
        writeOutput(sink, "\"", path)!
        writeOutput(sink, value, path)!
        return writeOutput(sink, "\"", path)
    }
    return writeEscapedStringSlowly(sink, value, path)
}

@noinline
func writeEscapedStringSlowly[Sink: Writer](
    _ sink: Sink,
    _ value: string,
    _ path: EncodeLocation,
) -> Result[(), EncodeError] {
    match writeOutput(sink, "\"", path) {
        case .ok(_) => {}
        case .err(error) => return .err(error)
    }

    var index: usize = 0
    while index < value.byteLen() {
        byte := value.byteAt(index)
        if byte == ('\"' as uint8) {
            match writeOutput(sink, "\\\"", path) {
                case .ok(_) => {}
                case .err(error) => return .err(error)
            }
            index += 1
            continue
        }
        if byte == ('\\' as uint8) {
            match writeOutput(sink, "\\\\", path) {
                case .ok(_) => {}
                case .err(error) => return .err(error)
            }
            index += 1
            continue
        }
        if byte < 0x20_u8 {
            escaped := match byte {
                case 0x08 => "\\b"
                case 0x09 => "\\t"
                case 0x0a => "\\n"
                case 0x0c => "\\f"
                case 0x0d => "\\r"
                case _ => ""
            }
            if escaped.byteLen() > 0 {
                match writeOutput(sink, escaped, path) {
                    case .ok(_) => {}
                    case .err(error) => return .err(error)
                }
            } else {
                var sequence = Builder::new()
                sequence.writeString("\\u00")
                appendHexByte(&sequence, byte)
                match writeOutput(sink, sequence.toString(), path) {
                    case .ok(_) => {}
                    case .err(error) => return .err(error)
                }
            }
            index += 1
            continue
        }

        start := index
        remaining := value.byteLen() - start
        count := if remaining < STRING_OUTPUT_CHUNK_SIZE { remaining } else { STRING_OUTPUT_CHUNK_SIZE }
        end := start + count
        index = plainAsciiEnd(value, index, end)
        while index < end {
            next := value.byteAt(index)
            if next < 0x20_u8 || next == ('\"' as uint8) || next == ('\\' as uint8) {
                break
            }
            width := if next < 0x80_u8 { 1 as usize } else {
                match utf8WidthAt(value, index) {
                    case .ok(width) => width
                    case .err(invalidIndex) => {
                        // Preserve the already-valid prefix and give an earlier
                        // Writer failure priority over this later UTF-8 error.
                        writeOutput(sink, value.sliceBytes(start, index - start), path)!
                        return .err(EncodeError::invalidUtf8(path.render(), invalidIndex))
                    }
                }
            }
            if width > end - index {
                break
            }
            index += width
        }

        // writeString makes an independent writable copy for the Writer. A raw
        // view would expose immutable source bytes to mutation.
        writeOutput(sink, value.sliceBytes(start, index - start), path)!
    }

    return writeOutput(sink, "\"", path)
}

func writeJsonValue[Sink: Writer](
    _ sink: Sink,
    _ value: &Value,
    _ options: Options,
    _ path: EncodeLocation,
) -> Result[(), EncodeError] {
    match *value {
        case .null => return writeOutput(sink, "null", path)
        case .boolean(flag) => {
            if flag { return writeOutput(sink, "true", path) }
            return writeOutput(sink, "false", path)
        }
        case .number(number) => return writeOutput(sink, number.text(), path)
        case .string(text) => return writeEscapedString(sink, text, path)
        case .array(values) => {
            if path.depth >= options.maxDepth() { return .err(EncodeError::depth(path.render())) }
            writeOutput(sink, "[", path)!
            path.frames.append(EncodeFrame {
                kind: .sequence, key: "", selected: false, count: 0,
                expectedLength: .none, valuePending: false,
            })
            child := EncodeLocation { frames: path.frames, depth: path.depth + 1 }
            var index: usize = 0
            while index < values.len() {
                if index > 0 { writeOutput(sink, ",", path)! }
                frame := path.frames.at(path.depth)
                frame.count = index + 1
                frame.selected = true
                writeJsonValue(sink, values.at(index), options, child)!
                index += 1
            }
            path.frames.pop()
            return writeOutput(sink, "]", path)
        }
        case .object(object) => {
            if path.depth >= options.maxDepth() { return .err(EncodeError::depth(path.render())) }
            writeOutput(sink, "{", path)!
            path.frames.append(EncodeFrame {
                kind: .object, key: "", selected: false, count: 0,
                expectedLength: .none, valuePending: false,
            })
            child := EncodeLocation { frames: path.frames, depth: path.depth + 1 }
            var index: usize = 0
            while index < object.len() {
                if index > 0 { writeOutput(sink, ",", path)! }
                key := object.keyAt(index)
                frame := path.frames.at(path.depth)
                frame.key = key
                frame.selected = true
                writeEscapedString(sink, key, child)!
                writeOutput(sink, ":", child)!
                writeJsonValue(sink, object.valueAt(index), options, child)!
                index += 1
            }
            path.frames.pop()
            return writeOutput(sink, "}", path)
        }
    }
}

/// A streaming JSON encoder over any byte `Writer`.
public struct Encoder[Sink: Writer] {
    sink: Sink
    options: Options
    frames: EncodeFrames
    rootValueWritten: bool
}

extend[Sink: Writer] Encoder[Sink] {
    public static func new(_ sink: Sink) -> Self {
        Encoder[Sink] {
            sink,
            options: Options::new(),
            frames: EncodeFrames::new(),
            rootValueWritten: false,
        }
    }

    public static func withOptions(_ sink: Sink, _ options: Options) -> Self {
        Encoder[Sink] {
            sink,
            options,
            frames: EncodeFrames::new(),
            rootValueWritten: false,
        }
    }
}

conform[Sink: Writer] &Encoder[Sink] to std::encoding::Encoder {
    type Error = EncodeError

    public func error(_ kind: std::encoding::CodingErrorKind, _ message: string) -> Self::Error {
        EncodeError::coding(kind, self.location().render(), message)
    }

    public func encodeNull() -> Result[(), Self::Error] {
        self.prepareValue()!
        writeOutput(self.sink, "null", self.location())
    }

    public func encodeBool(_ value: bool) -> Result[(), Self::Error] {
        self.prepareValue()!
        if value {
            return writeOutput(self.sink, "true", self.location())
        }
        return writeOutput(self.sink, "false", self.location())
    }

    public func encodeInt64(_ value: int64) -> Result[(), Self::Error] {
        self.prepareValue()!
        writeOutput(self.sink, std::fmt::signedDecimalString(value), self.location())
    }

    public func encodeUint64(_ value: uint64) -> Result[(), Self::Error] {
        self.prepareValue()!
        writeOutput(self.sink, std::fmt::unsignedDecimalString(value), self.location())
    }

    // `encodeFloat` and `encodeDouble` intentionally retain the interface
    // defaults until std has a locale-independent, shortest-round-trip float
    // formatter. Approximating through a generic formatter would silently
    // change values; callers can use `Number` for exact JSON decimals today.
    public func encodeDecimal(_ value: string) -> Result[(), Self::Error] {
        match Number::parse(value) {
            case .ok(_) => {
                self.prepareValue()!
                return writeOutput(self.sink, value, self.location())
            }
            case .err(_) => {
                return .err(EncodeError::coding(
                    .invalidValue,
                    self.location().render(),
                    "exact decimal does not follow JSON number syntax",
                ))
            }
        }
    }

    public func encodeString(_ value: string) -> Result[(), Self::Error] {
        self.prepareValue()!
        writeEscapedString(self.sink, value, self.location())
    }

    public func beginSequence(_ length: usize?) -> Result[(), Self::Error] {
        if self.frames.len() >= self.options.maxDepth() {
            return .err(EncodeError::depth(self.location().render()))
        }
        self.prepareValue()!
        writeOutput(self.sink, "[", self.location())!
        self.frames.append(EncodeFrame {
            kind: .sequence,
            key: "",
            selected: false,
            count: 0,
            expectedLength: length,
            valuePending: false,
        })
        return .ok(())
    }

    public func beginElement() -> Result[(), Self::Error] {
        if self.frames.isEmpty() {
            return .err(EncodeError::coding(.invalidState, self.location().render(), "sequence element has no containing sequence"))
        }
        frame := self.frames.at(self.frames.len() - 1)
        match frame.kind {
            case .object => return .err(EncodeError::coding(.invalidState, self.location().render(), "object fields require beginField"))
            case .sequence => {}
        }
        if frame.valuePending {
            return .err(EncodeError::coding(
                .invalidState,
                self.location().render(),
                "previous sequence element did not emit a value",
            ))
        }
        if frame.count > 0 {
            writeOutput(self.sink, ",", self.containerLocation())!
        }
        frame.selected = true
        frame.count += 1
        frame.valuePending = true
        return .ok(())
    }

    public func endSequence() -> Result[(), Self::Error] {
        if self.frames.isEmpty() {
            return .err(EncodeError::coding(.invalidState, self.location().render(), "sequence end has no containing sequence"))
        }
        frame := self.frames.at(self.frames.len() - 1)
        match frame.kind {
            case .object => return .err(EncodeError::coding(.invalidState, self.location().render(), "cannot end an object as a sequence"))
            case .sequence => {}
        }
        if frame.valuePending {
            return .err(EncodeError::coding(
                .invalidState,
                self.location().render(),
                "sequence ended before its current element emitted a value",
            ))
        }
        path := self.containerLocation()
        count := frame.count
        expectedLength := frame.expectedLength
        match expectedLength {
            case .some(expected) => {
                if expected != count {
                    return .err(EncodeError::coding(
                        .invalidState,
                        path.render(),
                        "sequence emitted a different number of elements than declared",
                    ))
                }
            }
            case .none => {}
        }
        self.frames.pop()
        return writeOutput(self.sink, "]", path)
    }

    public func beginObject(_ length: usize?) -> Result[(), Self::Error] {
        if self.frames.len() >= self.options.maxDepth() {
            return .err(EncodeError::depth(self.location().render()))
        }
        self.prepareValue()!
        writeOutput(self.sink, "{", self.location())!
        self.frames.append(EncodeFrame {
            kind: .object,
            key: "",
            selected: false,
            count: 0,
            expectedLength: length,
            valuePending: false,
        })
        return .ok(())
    }

    public func beginField(_ name: string) -> Result[(), Self::Error] {
        if self.frames.isEmpty() {
            return .err(EncodeError::coding(.invalidState, self.location().render(), "object field has no containing object"))
        }
        frame := self.frames.at(self.frames.len() - 1)
        match frame.kind {
            case .sequence => return .err(EncodeError::coding(.invalidState, self.location().render(), "sequence elements require beginElement"))
            case .object => {}
        }
        if frame.valuePending {
            return .err(EncodeError::coding(
                .invalidState,
                self.location().render(),
                "previous object field did not emit a value",
            ))
        }
        if frame.count > 0 {
            writeOutput(self.sink, ",", self.containerLocation())!
        }
        frame.key = name
        frame.selected = true
        writeEscapedString(self.sink, name, self.location())!
        writeOutput(self.sink, ":", self.location())!
        frame.count += 1
        frame.valuePending = true
        return .ok(())
    }

    public func endObject() -> Result[(), Self::Error] {
        if self.frames.isEmpty() {
            return .err(EncodeError::coding(.invalidState, self.location().render(), "object end has no containing object"))
        }
        frame := self.frames.at(self.frames.len() - 1)
        match frame.kind {
            case .sequence => return .err(EncodeError::coding(.invalidState, self.location().render(), "cannot end a sequence as an object"))
            case .object => {}
        }
        if frame.valuePending {
            return .err(EncodeError::coding(
                .invalidState,
                self.location().render(),
                "object ended before its current field emitted a value",
            ))
        }
        path := self.containerLocation()
        count := frame.count
        expectedLength := frame.expectedLength
        match expectedLength {
            case .some(expected) => {
                if expected != count {
                    return .err(EncodeError::coding(
                        .invalidState,
                        path.render(),
                        "object emitted a different number of fields than declared",
                    ))
                }
            }
            case .none => {}
        }
        self.frames.pop()
        return writeOutput(self.sink, "}", path)
    }
}

/// Serialize one JSON DOM value into a compact string.
public func stringify(_ value: &Value) -> Result[string, EncodeError] {
    stringifyWithOptions(value, Options::new())
}

/// Serialize one JSON DOM value with an explicit nesting limit.
public func stringifyWithOptions(_ value: &Value, _ options: Options) -> Result[string, EncodeError] {
    var encoder = Encoder::withOptions(std::bytes::Buffer::withCapacity(ENCODED_INITIAL_CAPACITY), options)
    match writeJsonValue(encoder.sink, value, options, encoder.location()) {
        case .ok(_) => return .ok(encoder.getInner().takeString())
        case .err(error) => return .err(error)
    }
}

extend[Sink: Writer] &Encoder[Sink] {
    func locationAt(_ depth: usize) -> EncodeLocation {
        EncodeLocation { frames: &self.frames, depth }
    }

    func location() -> EncodeLocation { self.locationAt(self.frames.len()) }

    func containerLocation() -> EncodeLocation { self.locationAt(self.frames.len() - 1) }

    /// Claim the current root or container slot before writing a value.
    /// Keeping this state in the format adapter prevents a buggy handwritten
    /// conformance from successfully producing syntactically invalid JSON.
    func prepareValue() -> Result[(), EncodeError] {
        if self.frames.isEmpty() {
            if self.rootValueWritten {
                return .err(EncodeError::coding(
                    .invalidState,
                    self.location().render(),
                    "encodable value attempted to emit more than one root value",
                ))
            }
            self.rootValueWritten = true
            return .ok(())
        }

        frame := self.frames.at(self.frames.len() - 1)
        if !frame.valuePending {
            return .err(EncodeError::coding(
                .invalidState,
                self.location().render(),
                "container value must be introduced by beginElement or beginField",
            ))
        }
        frame.valuePending = false
        return .ok(())
    }

    /// Write one format-neutral value as compact JSON without a separator.
    public func encode[Source: std::encoding::Encodable](_ value: &Source) -> Result[(), EncodeError] {
        if !self.frames.isEmpty() {
            return .err(EncodeError::coding(
                .invalidState,
                self.location().render(),
                "cannot start a root value inside an unfinished container",
            ))
        }
        self.rootValueWritten = false
        match std::encoding::encode[Source, &Encoder[Sink]](value, into: self) {
            case .ok(_) => {}
            case .err(error) => return .err(error)
        }
        if !self.frames.isEmpty() {
            return .err(EncodeError::coding(
                .invalidState,
                self.location().render(),
                "encodable value left a container unfinished",
            ))
        }
        if !self.rootValueWritten {
            return .err(EncodeError::coding(
                .invalidState,
                ROOT_PATH,
                "encodable value did not emit a root value",
            ))
        }
        return .ok(())
    }

    /// Write one compact value followed by a newline for JSON stream framing.
    public func encodeLine[Source: std::encoding::Encodable](_ value: &Source) -> Result[(), EncodeError] {
        match self.encode(value) {
            case .ok(_) => return writeOutput(self.sink, "\n", self.locationAt(0))
            case .err(error) => return .err(error)
        }
    }

    public func flush() -> Result[(), EncodeError] {
        match self.sink.flush() {
            case .ok(_) => return .ok(())
            case .err(cause) => return .err(EncodeError::fromIo(ROOT_PATH, cause))
        }
    }

    /// Returns a copy of the writer value. Call `flush` first when the
    /// underlying writer buffers data.
    public func getInner() -> Sink {
        self.sink
    }
}

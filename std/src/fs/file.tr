import std::runtime::SharedOwner
import std::io::{Error, Reader, Writer, Seeker, SeekFrom}
import std::mem::{Span}
import std::result::Result

internal func withFileContext[T](_ result: Result[T, Error], _ operation: string, _ path: string) -> Result[T, Error] {
    match result {
        case .ok(value) => return .ok(value)
        case .err(err) => return .err(err.withOperation(operation).withPath(path))
    }
}

internal struct FileCloseState {
    inner: std::sys::fs::RawFile
}

internal func fileFromRaw(_ inner: std::sys::fs::RawFile, _ path: string) -> Result[File, Error] {
    state := SharedOwner[FileCloseState]::new(FileCloseState { inner })
    return .ok(File { state, path })
}

internal func closedFileError(_ operation: string, _ path: string) -> Error {
    Error::new(.closed).withOperation(operation).withPath(path)
}

public struct OpenOptions {
    readFlag: bool
    writeFlag: bool
    appendFlag: bool
    createFlag: bool
    truncateFlag: bool
}

extend OpenOptions {
    public static func new() -> Self {
        OpenOptions {
            readFlag: false,
            writeFlag: false,
            appendFlag: false,
            createFlag: false,
            truncateFlag: false,
        }
    }
}

public struct File {
    internal state: SharedOwner[FileCloseState]
    path: string
}

extend File {
    public static func open(_ path: string) -> Result[File, Error] {
        res := std::sys::fs::openReadOnly(path)
        match res {
            case .ok(sysFile) => return fileFromRaw(sysFile, path)
            case .err(err) => return .err(err.withOperation("open").withPath(path))
        }
    }

    public static func create(_ path: string) -> Result[File, Error] {
        res := std::sys::fs::createWrite(path)
        match res {
            case .ok(sysFile) => return fileFromRaw(sysFile, path)
            case .err(err) => return .err(err.withOperation("create").withPath(path))
        }
    }

    /// Stops new operations through all shared copies. If a native operation
    /// is in flight, success acknowledges the request; OS close is deferred
    /// until it finishes. Deferred close errors are reported on stderr and in
    /// runtime statistics. Explicit close is required; collection does not close.
    public func close() -> Result[(), Error] {
        var state: &FileCloseState = self.state.get()
        if !std::sys::fs::isValid(&state.inner) {
            return .err(closedFileError("close", self.path))
        }
        var inner = std::sys::fs::take(&state.inner)
        result := std::sys::fs::close(&inner)
        return withFileContext(result, "close", self.path)
    }
}

conform File to Reader {
    public func read(_ buf: Span[uint8]) -> Result[usize, Error] {
        if !std::sys::fs::isValid(&self.state.get().inner) {
            return .err(closedFileError("read", self.path))
        }

        len := buf.len()
        if len == 0 {
            return .ok(0)
        }

        var writable = buf
        ptr := unsafe { writable.at(0) as *mut uint8 }
        result := std::sys::fs::read(&self.state.get().inner, ptr, len)
        return withFileContext(result, "read", self.path)
    }
}

conform File to Writer {
    public func write(_ buf: Span[uint8]) -> Result[usize, Error] {
        if !std::sys::fs::isValid(&self.state.get().inner) {
            return .err(closedFileError("write", self.path))
        }

        len := buf.len()
        if len == 0 {
            return .ok(0)
        }

        ptr := unsafe { buf.at(0) as *const uint8 }
        result := std::sys::fs::write(&self.state.get().inner, ptr, len)
        return withFileContext(result, "write", self.path)
    }

    public func flush() -> Result[(), Error] {
        if !std::sys::fs::isValid(&self.state.get().inner) {
            return .err(closedFileError("flush", self.path))
        }

        return .ok(())
    }
}

conform File to Seeker {
    public func seek(_ pos: SeekFrom) -> Result[isize, Error] {
        if !std::sys::fs::isValid(&self.state.get().inner) {
            return .err(closedFileError("seek", self.path))
        }

        var offset: isize = 0
        var whence: int32 = 0

        match pos {
            case .start(value) => {
                offset = value
                whence = 0
            }
            case .current(value) => {
                offset = value
                whence = 1
            }
            case .end(value) => {
                offset = value
                whence = 2
            }
        }

        result := std::sys::fs::seek(&self.state.get().inner, offset, whence)
        return withFileContext(result, "seek", self.path)
    }
}

extend &OpenOptions {
    public func read(_ enabled: bool) -> &OpenOptions {
        self.readFlag = enabled
        return self
    }

    public func write(_ enabled: bool) -> &OpenOptions {
        self.writeFlag = enabled
        return self
    }

    public func append(_ enabled: bool) -> &OpenOptions {
        self.appendFlag = enabled
        return self
    }

    public func create(_ enabled: bool) -> &OpenOptions {
        self.createFlag = enabled
        return self
    }

    public func truncate(_ enabled: bool) -> &OpenOptions {
        self.truncateFlag = enabled
        return self
    }

    public func open(_ path: string) -> Result[File, Error] {
        res := std::sys::fs::openWithOptions(
            path,
            self.readFlag,
            self.writeFlag,
            self.appendFlag,
            self.createFlag,
            self.truncateFlag,
        )
        match res {
            case .ok(sysFile) => return fileFromRaw(sysFile, path)
            case .err(err) => return .err(err.withOperation("open").withPath(path))
        }
    }
}

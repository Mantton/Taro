import std.io.Error
import std.mem.{MutableSpan, Span}
import std.result.Result

func withAsyncFileContext[T](_ result: Result[T, Error], _ operation: string, _ path: string) -> Result[T, Error] {
    match result {
        case .ok(value) => return .ok(value)
        case .err(err) => return .err(err.withOperation(operation).withPath(path))
    }
}

public struct OpenOptions {
    readFlag: bool
    writeFlag: bool
    appendFlag: bool
    createFlag: bool
    truncateFlag: bool
}

impl OpenOptions {
    public func new() -> Self {
        OpenOptions {
            readFlag: false,
            writeFlag: false,
            appendFlag: false,
            createFlag: false,
            truncateFlag: false,
        }
    }

    public func read(&mut self, _ enabled: bool) -> &mut Self {
        self.readFlag = enabled
        return self
    }

    public func write(&mut self, _ enabled: bool) -> &mut Self {
        self.writeFlag = enabled
        return self
    }

    public func append(&mut self, _ enabled: bool) -> &mut Self {
        self.appendFlag = enabled
        return self
    }

    public func create(&mut self, _ enabled: bool) -> &mut Self {
        self.createFlag = enabled
        return self
    }

    public func truncate(&mut self, _ enabled: bool) -> &mut Self {
        self.truncateFlag = enabled
        return self
    }

    public func open(&self, _ path: string) -> Result[AsyncFile, Error] {
        let openRes = std.sys.fs.openWithOptions(
            path,
            self.readFlag,
            self.writeFlag,
            self.appendFlag,
            self.createFlag,
            self.truncateFlag,
        )
        var file = match openRes {
            case .ok(value) => value
            case .err(err) => return .err(err.withOperation("open").withPath(path))
        }

        let streamRes = std.sys.fs.intoAsyncStream(&mut file)
        let stream = match streamRes {
            case .ok(value) => value
            case .err(err) => {
                let _ = std.sys.fs.close(&mut file)
                return .err(err.withOperation("open").withPath(path))
            }
        }

        return .ok(AsyncFile {
            inner: std.io.task.fromRaw(stream),
            path,
        })
    }
}

public struct AsyncFile {
    inner: std.io.task.AsyncStream
    path: string
}

impl AsyncFile {
    public func open(_ path: string) -> Result[AsyncFile, Error] {
        let openRes = std.sys.fs.openReadOnly(path)
        var file = match openRes {
            case .ok(value) => value
            case .err(err) => return .err(err.withOperation("open").withPath(path))
        }

        let streamRes = std.sys.fs.intoAsyncStream(&mut file)
        match streamRes {
            case .ok(stream) => {
                return .ok(AsyncFile {
                    inner: std.io.task.fromRaw(stream),
                    path,
                })
            }
            case .err(err) => {
                let _ = std.sys.fs.close(&mut file)
                return .err(err.withOperation("open").withPath(path))
            }
        }
    }

    public func create(_ path: string) -> Result[AsyncFile, Error] {
        let openRes = std.sys.fs.createWrite(path)
        var file = match openRes {
            case .ok(value) => value
            case .err(err) => return .err(err.withOperation("create").withPath(path))
        }

        let streamRes = std.sys.fs.intoAsyncStream(&mut file)
        match streamRes {
            case .ok(stream) => {
                return .ok(AsyncFile {
                    inner: std.io.task.fromRaw(stream),
                    path,
                })
            }
            case .err(err) => {
                let _ = std.sys.fs.close(&mut file)
                return .err(err.withOperation("create").withPath(path))
            }
        }
    }

    public func close(self) -> Result[(), Error] {
        withAsyncFileContext(self.inner.close(), "close", self.path)
    }

    public func read(&self, _ buf: MutableSpan[uint8]) async -> Result[usize, Error] {
        withAsyncFileContext(await self.inner.read(buf), "read", self.path)
    }

    public func write(&self, _ buf: Span[uint8]) async -> Result[usize, Error] {
        withAsyncFileContext(await self.inner.write(buf), "write", self.path)
    }

    public func flush(&self) async -> Result[(), Error] {
        withAsyncFileContext(await self.inner.flush(), "flush", self.path)
    }

    public func readExact(&self, _ buf: MutableSpan[uint8]) async -> Result[(), Error] {
        withAsyncFileContext(await self.inner.readExact(buf), "read exact", self.path)
    }

    public func readAtLeast(&self, _ min: usize, _ buf: MutableSpan[uint8]) async -> Result[usize, Error] {
        withAsyncFileContext(await self.inner.readAtLeast(min, buf), "read at least", self.path)
    }

    public func readAll(&self) async -> Result[std.collections.List[uint8], Error] {
        withAsyncFileContext(await self.inner.readAll(), "read", self.path)
    }

    public func readToString(&self) async -> Result[string, Error] {
        withAsyncFileContext(await self.inner.readToString(), "read", self.path)
    }

    public func writeAll(&self, _ buf: Span[uint8]) async -> Result[(), Error] {
        withAsyncFileContext(await self.inner.writeAll(buf), "write all", self.path)
    }

    public func writeString(&self, _ s: string) async -> Result[(), Error] {
        withAsyncFileContext(await self.inner.writeString(s), "write all", self.path)
    }
}

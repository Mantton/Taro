import std.optional.Optional
import std.hash.{Hashable, DefaultHasher, Hasher}
import std.collections.List
import std.panic.panic
import std.iter.{Iterator, Iterable}
import std.marker.Clone
import std.ops.Fn
import std.mem.assertBufferCapacity

const SWISS_GROUP_WIDTH: usize = 8
const SWISS_CTRL_EMPTY: uint8 = 0x80
const SWISS_CTRL_DELETED: uint8 = 0xfe
const SWISS_INITIAL_CAPACITY: usize = 16

func swissFingerprint(_ hash: uint64) -> uint8 {
    ((hash >> 57) as uint8) & 0x7f_u8
}

func swissCtrlIsFull(_ ctrl: uint8) -> bool {
    ctrl < SWISS_CTRL_EMPTY
}

func hashKey[Key: Hashable](_ key: &Key) -> uint64 {
    var hasher = DefaultHasher.new()
    key.hash(into: &mut hasher)
    hasher.finish()
}

func dictionaryCapacityOverflow() {
    panic("dictionary capacity overflow")
}

func checkedDictionaryLenAfterInsert(_ len: usize) -> usize {
    match len.checkedAdd(1 as usize) {
        case .some(nextLen) => return nextLen
        case .none => {
            dictionaryCapacityOverflow()
            return 0 as usize
        }
    }
}

func assertDictionaryStorageCapacity[Key: Hashable, Value](_ capacity: usize) {
    assertBufferCapacity[uint8](capacity, "dictionary capacity overflow")
    assertBufferCapacity[uint64](capacity, "dictionary capacity overflow")
    assertBufferCapacity[Key?](capacity, "dictionary capacity overflow")
    assertBufferCapacity[Value?](capacity, "dictionary capacity overflow")
}

public func __dictionary_should_grow_for_insert(_ len: usize, _ capacity: usize) -> bool {
    if capacity == 0 {
        return true
    }

    let maxLenBeforeGrow = capacity - (capacity / (4 as usize))
    return len >= maxLenBeforeGrow
}

public func __dictionary_next_capacity_for_grow[Key: Hashable, Value](_ current: usize) -> usize {
    let nextCapacity = if current == 0 {
        SWISS_INITIAL_CAPACITY
    } else {
        match current.checkedMul(2 as usize) {
            case .some(capacity) => capacity
            case .none => {
                dictionaryCapacityOverflow()
                0 as usize
            }
        }
    }

    assertDictionaryStorageCapacity[Key, Value](nextCapacity)
    return nextCapacity
}

/// Hash table layout (scalar Swiss-style probing):
/// - `controls` stores metadata per slot:
///   - `SWISS_CTRL_EMPTY` marks the end of a probe chain.
///   - `SWISS_CTRL_DELETED` is a tombstone slot used by `remove`.
///   - full slots store a 7-bit hash fingerprint.
/// - probing walks fixed groups of `SWISS_GROUP_WIDTH` slots using `(base + offset) & mask`.
/// - candidate hits are validated by `fingerprint -> full hash -> key equality`.
/// - `insert` remembers the first deleted slot and prefers it once an empty slot is found.
/// - growth uses capacity doubling and rehashes all full slots.
/// - removals mark tombstones (`SWISS_CTRL_DELETED`) so probe chains remain intact.
@lang("Dictionary")
public struct Dictionary[Key: Hashable, Value] {
    len: usize
    capacity: usize
    controls: List[uint8]
    hashes: List[uint64]
    keys: List[Key?]
    values: List[Value?]
}

impl[Key: Hashable, Value] Dictionary[Key, Value] {
    public func new() -> Self {
        var controls: List[uint8] = List(withCapacity: SWISS_INITIAL_CAPACITY)
        var hashes: List[uint64] = List(withCapacity: SWISS_INITIAL_CAPACITY)
        var keys: List[Key?] = List(withCapacity: SWISS_INITIAL_CAPACITY)
        var values: List[Value?] = List(withCapacity: SWISS_INITIAL_CAPACITY)

        var idx: usize = 0
        while idx < SWISS_INITIAL_CAPACITY {
            controls.append(SWISS_CTRL_EMPTY)
            hashes.append(0_u64)
            keys.append(.none)
            values.append(.none)
            idx += 1
        }

        Dictionary[Key, Value] {
            len: 0,
            capacity: SWISS_INITIAL_CAPACITY,
            controls,
            hashes,
            keys,
            values,
        }
    }

    public func len(&self) -> usize {
        self.len
    }

    public func isEmpty(&self) -> bool {
        self.len == 0
    }

    public func contains(&self, _ key: &Key) -> bool {
        self.get(key).isSome()
    }

    func findSlot(&self, _ key: &Key) -> usize? {
        if self.capacity == 0 {
            return .none
        }

        let hash = hashKey(key)
        let fp = swissFingerprint(hash)
        let mask = self.capacity - (1 as usize)
        let base = (hash as usize) & mask

        var groupOffset: usize = 0
        while groupOffset < self.capacity {
            let groupStart = (base + groupOffset) & mask

            var slotOffset: usize = 0
            while slotOffset < SWISS_GROUP_WIDTH {
                let slot = (groupStart + slotOffset) & mask
                let ctrl = *self.controls.at(slot)

                if ctrl == SWISS_CTRL_EMPTY {
                    return .none
                }

                if swissCtrlIsFull(ctrl) && ctrl == fp {
                    let slotHash = *self.hashes.at(slot)
                    if slotHash == hash {
                        let keySlot: &Key? = self.keys.at(slot)
                        match keySlot {
                            case .some(existingKey) => {
                                if key.eq(existingKey) {
                                    return .some(slot)
                                }
                            }
                            case .none => {}
                        }
                    }
                }

                slotOffset += 1
            }

            groupOffset += SWISS_GROUP_WIDTH
        }

        return .none
    }

    func valueAtSlot(&self, _ slot: usize) -> &Value {
        let valueSlot: &Value? = self.values.at(slot)
        match valueSlot {
            case .some(value) => return value
            case .none => panic("dictionary slot has no value")
        }
    }

    func valueAtSlot(&mut self, _ slot: usize) -> &mut Value {
        let valueSlot: &mut Value? = self.values.at(slot)
        match valueSlot {
            case .some(value) => return value
            case .none => panic("dictionary slot has no value")
        }
    }

    func keyAtSlot(&self, _ slot: usize) -> &Key {
        let keySlot: &Key? = self.keys.at(slot)
        match keySlot {
            case .some(key) => return key
            case .none => panic("dictionary slot has no key")
        }
    }

    func removeSlot(&mut self, _ slot: usize) -> Value {
        let valueSlot: &mut Value? = self.values.at(slot)
        var removed: Value?
        unsafe {
            let valuePtr: *mut Value? = valueSlot as *mut Value?
            removed = valuePtr.read()
            valuePtr.write(.none)
        }

        let keySlot: &mut Key? = self.keys.at(slot)
        let ctrlSlot: &mut uint8 = self.controls.at(slot)
        let hashSlot: &mut uint64 = self.hashes.at(slot)
        *keySlot = .none
        *ctrlSlot = SWISS_CTRL_DELETED
        *hashSlot = 0_u64

        match removed {
            case .some(value) => {
                self.len -= 1
                return value
            }
            case .none => panic("dictionary slot has no value")
        }
    }

    public func remove(&mut self, _ key: &Key) -> Value? {
        match self.findSlot(key) {
            case .some(slot) => return .some(self.removeSlot(slot))
            case .none => return .none
        }
    }

    public func get(&self, _ key: &Key) -> Optional[&Value] {
        match self.findSlot(key) {
            case .some(slot) => return .some(self.valueAtSlot(slot))
            case .none => return .none
        }
    }

    public func get(&mut self, _ key: &Key) -> Optional[&mut Value] {
        match self.findSlot(key) {
            case .some(slot) => return .some(self.valueAtSlot(slot))
            case .none => return .none
        }
    }

    public func insert(&mut self, key: Key, value: Value) -> Value? {
        if self.capacity == 0 {
            return .none
        }

        let hash = hashKey(&key)
        let fp = swissFingerprint(hash)
        let mask = self.capacity - (1 as usize)
        let base = (hash as usize) & mask

        var firstDeleted: usize = 0 as usize
        var hasDeleted = false

        var groupOffset: usize = 0
        while groupOffset < self.capacity {
            let groupStart = (base + groupOffset) & mask

            var slotOffset: usize = 0
            while slotOffset < SWISS_GROUP_WIDTH {
                let slot = (groupStart + slotOffset) & mask
                let ctrl = *self.controls.at(slot)

                if ctrl == SWISS_CTRL_EMPTY {
                    if self.shouldGrowForInsert() {
                        self.grow()
                        return self.insert(key: key, value: value)
                    }

                    let insertSlot = if hasDeleted { firstDeleted } else { slot }
                    *self.controls.at(insertSlot) = fp
                    *self.hashes.at(insertSlot) = hash
                    *self.keys.at(insertSlot) = .some(key)
                    *self.values.at(insertSlot) = .some(value)
                    self.len = checkedDictionaryLenAfterInsert(self.len)
                    return .none
                }

                if ctrl == SWISS_CTRL_DELETED {
                    if !hasDeleted {
                        hasDeleted = true
                        firstDeleted = slot
                    }
                } else if swissCtrlIsFull(ctrl) && ctrl == fp {
                    let slotHash = *self.hashes.at(slot)
                    if slotHash == hash {
                        let keySlot: &mut Key? = self.keys.at(slot)
                        match keySlot {
                            case .some(existingKey) => {
                                if key == *existingKey {
                                    let valueSlot: &mut Value? = self.values.at(slot)
                                    var previous: Value?
                                    unsafe {
                                        let valueSlotPtr: *mut Value? = valueSlot as *mut Value?
                                        previous = valueSlotPtr.read()
                                        let replacement: Value? = .some(value)
                                        valueSlotPtr.write(replacement)
                                    }
                                    return previous
                                }
                            }
                            case .none => {}
                        }
                    }
                }

                slotOffset += 1
            }

            groupOffset += SWISS_GROUP_WIDTH
        }

        self.grow()
        return self.insert(key: key, value: value)
    }

    func insertAndGet(&mut self, key: Key, value: Value) -> &mut Value {
        if self.capacity == 0 || self.shouldGrowForInsert() {
            self.grow()
        }

        let hash = hashKey(&key)
        let fp = swissFingerprint(hash)
        let mask = self.capacity - (1 as usize)
        let base = (hash as usize) & mask

        var firstDeleted: usize = 0 as usize
        var hasDeleted = false

        var groupOffset: usize = 0
        while groupOffset < self.capacity {
            let groupStart = (base + groupOffset) & mask

            var slotOffset: usize = 0
            while slotOffset < SWISS_GROUP_WIDTH {
                let slot = (groupStart + slotOffset) & mask
                let ctrl = *self.controls.at(slot)

                if ctrl == SWISS_CTRL_EMPTY {
                    let insertSlot = if hasDeleted { firstDeleted } else { slot }
                    *self.controls.at(insertSlot) = fp
                    *self.hashes.at(insertSlot) = hash
                    *self.keys.at(insertSlot) = .some(key)
                    *self.values.at(insertSlot) = .some(value)
                    self.len = checkedDictionaryLenAfterInsert(self.len)
                    return self.valueAtSlot(insertSlot)
                }

                if ctrl == SWISS_CTRL_DELETED {
                    if !hasDeleted {
                        hasDeleted = true
                        firstDeleted = slot
                    }
                } else if swissCtrlIsFull(ctrl) && ctrl == fp {
                    let slotHash = *self.hashes.at(slot)
                    if slotHash == hash {
                        let keySlot: &mut Key? = self.keys.at(slot)
                        match keySlot {
                            case .some(existingKey) => {
                                if key == *existingKey {
                                    let valueSlot: &mut Value? = self.values.at(slot)
                                    unsafe {
                                        let valueSlotPtr: *mut Value? = valueSlot as *mut Value?
                                        let replacement: Value? = .some(value)
                                        valueSlotPtr.write(replacement)
                                    }
                                    return self.valueAtSlot(slot)
                                }
                            }
                            case .none => {}
                        }
                    }
                }

                slotOffset += 1
            }

            groupOffset += SWISS_GROUP_WIDTH
        }

        self.grow()
        return self.insertAndGet(key: key, value: value)
    }

    public func set(&mut self, key: Key, value: Value) {
        let _ = self.insert(key: key, value: value)
    }

    public func getOr(&self, _ key: &Key, default defaultValue: Value) -> Value where Value: Clone {
        match self.get(key) {
            case .some(value) => value.clone()
            case .none => defaultValue
        }
    }

    public func entry(&mut self, _ key: Key) -> Entry[Key, Value] {
        match self.findSlot(&key) {
            case .some(slot) => {
                return .occupied(OccupiedEntry[Key, Value] { dict: self, slot })
            }
            case .none => {
                return .vacant(VacantEntry[Key, Value] { dict: self, key })
            }
        }
    }

    func shouldGrowForInsert(&self) -> bool {
        __dictionary_should_grow_for_insert(self.len, self.capacity)
    }

    func grow(&mut self) {
        let newCapacity = __dictionary_next_capacity_for_grow[Key, Value](self.capacity)

        var newControls: List[uint8] = List(withCapacity: newCapacity)
        var newHashes: List[uint64] = List(withCapacity: newCapacity)
        var newKeys: List[Key?] = List(withCapacity: newCapacity)
        var newValues: List[Value?] = List(withCapacity: newCapacity)

        var initIdx: usize = 0
        while initIdx < newCapacity {
            newControls.append(SWISS_CTRL_EMPTY)
            newHashes.append(0_u64)
            newKeys.append(.none)
            newValues.append(.none)
            initIdx += 1
        }

        var oldSlot: usize = 0
        while oldSlot < self.capacity {
            let ctrl = *self.controls.at(oldSlot)
            if swissCtrlIsFull(ctrl) {
                let hash = *self.hashes.at(oldSlot)
                var oldKeyOpt: Key?
                var oldValueOpt: Value?
                {
                    let oldKeys: &mut List[Key?] = &mut self.keys
                    let oldValues: &mut List[Value?] = &mut self.values
                    let oldKeySlot = oldKeys.at(oldSlot)
                    let oldValueSlot = oldValues.at(oldSlot)
                    unsafe {
                        let oldKeyPtr: *mut Key? = oldKeySlot as *mut Key?
                        let oldValuePtr: *mut Value? = oldValueSlot as *mut Value?
                        oldKeyOpt = oldKeyPtr.read()
                        oldValueOpt = oldValuePtr.read()
                        oldKeyPtr.write(.none)
                        oldValuePtr.write(.none)
                    }
                }

                match oldKeyOpt {
                    case .some(oldKey) => {
                        match oldValueOpt {
                            case .some(oldValue) => {
                                let fp = swissFingerprint(hash)
                                let mask = newCapacity - (1 as usize)
                                let base = (hash as usize) & mask
                                var inserted = false
                                var insertSlot: usize = 0 as usize

                                var groupOffset: usize = 0
                                while groupOffset < newCapacity {
                                    let groupStart = (base + groupOffset) & mask

                                    var slotOffset: usize = 0
                                    while slotOffset < SWISS_GROUP_WIDTH {
                                        let slot = (groupStart + slotOffset) & mask
                                        let candidateCtrl = *newControls.at(slot)
                                        if candidateCtrl == SWISS_CTRL_EMPTY || candidateCtrl == SWISS_CTRL_DELETED {
                                            insertSlot = slot
                                            inserted = true
                                            break
                                        }
                                        slotOffset += 1
                                    }

                                    if inserted {
                                        break
                                    }

                                    groupOffset += SWISS_GROUP_WIDTH
                                }

                                if !inserted {
                                    panic("dictionary grow failed: unable to place entry")
                                }

                                *newControls.at(insertSlot) = fp
                                *newHashes.at(insertSlot) = hash
                                *newKeys.at(insertSlot) = .some(oldKey)
                                *newValues.at(insertSlot) = .some(oldValue)
                            }
                            case .none => {}
                        }
                    }
                    case .none => {}
                }
            }
            oldSlot += 1
        }

        self.controls = newControls
        self.hashes = newHashes
        self.keys = newKeys
        self.values = newValues
        self.capacity = newCapacity
    }

    public func clear(&mut self) {
        if self.len == 0 {
            return
        }

        var idx: usize = 0
        while idx < self.capacity {
            *self.controls.at(idx) = SWISS_CTRL_EMPTY
            *self.hashes.at(idx) = 0_u64
            *self.keys.at(idx) = .none
            *self.values.at(idx) = .none
            idx += 1
        }
        self.len = 0
    }

    public func keys(&self) -> DictKeysIterator[Key, Value] {
        DictKeysIterator[Key, Value] { dict: self, currentSlot: 0 }
    }

    public func keys(&mut self) -> DictMutKeysIterator[Key, Value] {
        DictMutKeysIterator[Key, Value] { dict: self, currentSlot: 0 }
    }

    public func values(&self) -> DictValuesIterator[Key, Value] {
        DictValuesIterator[Key, Value] { dict: self, currentSlot: 0 }
    }

    public func values(&mut self) -> DictMutValuesIterator[Key, Value] {
        DictMutValuesIterator[Key, Value] { dict: self, currentSlot: 0 }
    }

    public func entries(&self) -> DictEntriesIterator[Key, Value] {
        DictEntriesIterator[Key, Value] { dict: self, currentSlot: 0 }
    }

    public func entries(&mut self) -> DictMutEntriesIterator[Key, Value] {
        DictMutEntriesIterator[Key, Value] { dict: self, currentSlot: 0 }
    }
}

public enum Entry[Key: Hashable, Value] {
    case occupied(OccupiedEntry[Key, Value])
    case vacant(VacantEntry[Key, Value])
}

impl[Key: Hashable, Value] Entry[Key, Value] {
    public func orInsert(self, _ defaultValue: Value) -> &mut Value {
        match self {
            case .occupied(entry) => {
                var occupied = entry
                return occupied.get()
            }
            case .vacant(entry) => {
                return entry.insert(defaultValue)
            }
        }
    }

    public func orInsertWith[F: Fn[(), Value]](self, _ f: F) -> &mut Value {
        match self {
            case .occupied(entry) => {
                var occupied = entry
                return occupied.get()
            }
            case .vacant(entry) => {
                return entry.insert(f())
            }
        }
    }

    public func andModify[F: Fn[&mut Value, ()]](self, _ f: F) -> Entry[Key, Value] {
        match self {
            case .occupied(entry) => {
                var occupied = entry
                f(occupied.get())
                return .occupied(occupied)
            }
            case .vacant(entry) => return .vacant(entry)
        }
    }
}

public struct OccupiedEntry[Key: Hashable, Value] {
    dict: &mut Dictionary[Key, Value]
    slot: usize
}

impl[Key: Hashable, Value] OccupiedEntry[Key, Value] {
    public func key(&self) -> &Key {
        return self.dict.keyAtSlot(self.slot)
    }

    public func get(&self) -> &Value {
        return self.dict.valueAtSlot(self.slot)
    }

    public func get(&mut self) -> &mut Value {
        return self.dict.valueAtSlot(self.slot)
    }

    public func insert(&mut self, _ value: Value) -> Value {
        let valueSlot: &mut Value? = self.dict.values.at(self.slot)
        var previous: Value?
        unsafe {
            let valueSlotPtr: *mut Value? = valueSlot as *mut Value?
            previous = valueSlotPtr.read()
            let replacement: Value? = .some(value)
            valueSlotPtr.write(replacement)
        }

        match previous {
            case .some(oldValue) => return oldValue
            case .none => panic("dictionary slot has no value")
        }
    }

    public func remove(self) -> Value {
        var entry = self
        return entry.dict.removeSlot(entry.slot)
    }
}

public struct VacantEntry[Key: Hashable, Value] {
    dict: &mut Dictionary[Key, Value]
    key: Key
}

impl[Key: Hashable, Value] VacantEntry[Key, Value] {
    public func key(&self) -> &Key {
        return &self.key
    }

    public func insert(self, _ value: Value) -> &mut Value {
        var entry = self
        var dict = entry.dict
        let key = entry.key
        return dict.insertAndGet(key: key, value: value)
    }
}

impl[Key: Hashable, Value] Clone for Dictionary[Key, Value] where Key: Clone, Value: Clone {
    public func clone(&self) -> Self {
        var cloned = Dictionary[Key, Value].new()
        for (key, value) in self {
            let _ = cloned.insert(key: key.clone(), value: value.clone())
        }
        return cloned
    }
}

public struct DictKeysIterator[Key: Hashable, Value] {
    dict: &Dictionary[Key, Value]
    currentSlot: usize
}

impl[Key: Hashable, Value] Iterator for DictKeysIterator[Key, Value] {
    type Element = &Key

    public func next(&mut self) -> Optional[Self.Element] {
        let dict = self.dict
        while self.currentSlot < dict.capacity {
            let slot = self.currentSlot
            self.currentSlot += 1

            let ctrl = *dict.controls.at(slot)
            if swissCtrlIsFull(ctrl) {
                match dict.keys.at(slot) {
                    case .some(key) => return .some(key)
                    case .none => {}
                }
            }
        }
        return .none
    }
}

public struct DictMutKeysIterator[Key: Hashable, Value] {
    dict: &mut Dictionary[Key, Value]
    currentSlot: usize
}

impl[Key: Hashable, Value] Iterator for DictMutKeysIterator[Key, Value] {
    type Element = &Key

    public func next(&mut self) -> Optional[Self.Element] {
        let dict = self.dict
        while self.currentSlot < dict.capacity {
            let slot = self.currentSlot
            self.currentSlot += 1

            let ctrl = *dict.controls.at(slot)
            if swissCtrlIsFull(ctrl) {
                let keysRead: &List[Key?] = &dict.keys
                match keysRead.at(slot) {
                    case .some(key) => return .some(key)
                    case .none => {}
                }
            }
        }
        return .none
    }
}

public struct DictValuesIterator[Key: Hashable, Value] {
    dict: &Dictionary[Key, Value]
    currentSlot: usize
}

impl[Key: Hashable, Value] Iterator for DictValuesIterator[Key, Value] {
    type Element = &Value

    public func next(&mut self) -> Optional[Self.Element] {
        let dict = self.dict
        while self.currentSlot < dict.capacity {
            let slot = self.currentSlot
            self.currentSlot += 1

            let ctrl = *dict.controls.at(slot)
            if swissCtrlIsFull(ctrl) {
                match dict.values.at(slot) {
                    case .some(val) => return .some(val)
                    case .none => {}
                }
            }
        }
        return .none
    }
}

public struct DictMutValuesIterator[Key: Hashable, Value] {
    dict: &mut Dictionary[Key, Value]
    currentSlot: usize
}

impl[Key: Hashable, Value] Iterator for DictMutValuesIterator[Key, Value] {
    type Element = &mut Value

    public func next(&mut self) -> Optional[Self.Element] {
        let dict = self.dict
        while self.currentSlot < dict.capacity {
            let slot = self.currentSlot
            self.currentSlot += 1

            let ctrl = *dict.controls.at(slot)
            if swissCtrlIsFull(ctrl) {
                match dict.values.at(slot) {
                    case .some(val) => return .some(val)
                    case .none => {}
                }
            }
        }
        return .none
    }
}

public struct DictEntriesIterator[Key: Hashable, Value] {
    dict: &Dictionary[Key, Value]
    currentSlot: usize
}

impl[Key: Hashable, Value] Iterator for DictEntriesIterator[Key, Value] {
    type Element = (&Key, &Value)

    public func next(&mut self) -> Optional[Self.Element] {
        let dict = self.dict
        while self.currentSlot < dict.capacity {
            let slot = self.currentSlot
            self.currentSlot += 1

            let ctrl = *dict.controls.at(slot)
            if swissCtrlIsFull(ctrl) {
                let keyOpt = dict.keys.at(slot)
                let valOpt = dict.values.at(slot)
                match keyOpt {
                    case .some(key) => {
                        match valOpt {
                            case .some(val) => return .some((key, val))
                            case .none => {}
                        }
                    }
                    case .none => {}
                }
            }
        }
        return .none
    }
}

public struct DictMutEntriesIterator[Key: Hashable, Value] {
    dict: &mut Dictionary[Key, Value]
    currentSlot: usize
}

impl[Key: Hashable, Value] Iterator for DictMutEntriesIterator[Key, Value] {
    type Element = (&Key, &mut Value)

    public func next(&mut self) -> Optional[Self.Element] {
        let dict = self.dict
        while self.currentSlot < dict.capacity {
            let slot = self.currentSlot
            self.currentSlot += 1

            let ctrl = *dict.controls.at(slot)
            if swissCtrlIsFull(ctrl) {
                let keysRead: &List[Key?] = &dict.keys
                let keyOpt = keysRead.at(slot)
                let valOpt = dict.values.at(slot)
                match keyOpt {
                    case .some(key) => {
                        match valOpt {
                            case .some(val) => return .some((key, val))
                            case .none => {}
                        }
                    }
                    case .none => {}
                }
            }
        }
        return .none
    }
}

public struct DictOwnedEntriesIterator[Key: Hashable, Value] {
    dict: Dictionary[Key, Value]
    currentSlot: usize
}

impl[Key: Hashable, Value] Iterator for DictOwnedEntriesIterator[Key, Value] {
    type Element = (Key, Value)

    public func next(&mut self) -> Optional[Self.Element] {
        let dict = &mut self.dict
        while self.currentSlot < dict.capacity {
            let slot = self.currentSlot
            self.currentSlot += 1

            let ctrl = *dict.controls.at(slot)
            if swissCtrlIsFull(ctrl) {
                let keySlot: &mut Key? = dict.keys.at(slot)
                let keyOpt = std.mem.take(keySlot)

                let valueSlot: &mut Value? = dict.values.at(slot)
                let valueOpt = std.mem.take(valueSlot)

                match keyOpt {
                    case .some(key) => {
                        match valueOpt {
                            case .some(value) => return .some((key, value))
                            case .none => {}
                        }
                    }
                    case .none => {}
                }
            }
        }
        return .none
    }
}

impl[Key: Hashable, Value] Iterable for Dictionary[Key, Value] {
    type Element = (Key, Value)
    type Iterator = DictOwnedEntriesIterator[Key, Value]

    public func iter(self) -> Self.Iterator {
        DictOwnedEntriesIterator[Key, Value] {
            dict: self,
            currentSlot: 0,
        }
    }
}

impl[Key: Hashable, Value] Iterable for &Dictionary[Key, Value] {
    type Element = (&Key, &Value)
    type Iterator = DictEntriesIterator[Key, Value]

    public func iter(self) -> Self.Iterator {
        self.entries()
    }
}

impl[Key: Hashable, Value] Iterable for &mut Dictionary[Key, Value] {
    type Element = (&Key, &mut Value)
    type Iterator = DictMutEntriesIterator[Key, Value]

    public func iter(self) -> Self.Iterator {
        self.entries()
    }
}

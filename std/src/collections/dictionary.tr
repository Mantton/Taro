import std::optional::Optional
import std::hash::{Hashable, DefaultHasher, Hasher}
import std::panic::panic
import std::iter::{Iterator, Iterable}
import std::marker::Clone
import std::mem::maxBufferCapacity
import std::intrinsic::{__intrinsic_align_of, __intrinsic_keep_alive, __intrinsic_size_of}

extern "taro_rt" {
    unsafe func __gc__dictionary_groups_new(_ entry: *const uint8, _ groups: usize) -> *mut uint8
}
import std::testing::{assertFalse, assertTrue}

const SWISS_GROUP_WIDTH: usize = 8
const SWISS_CTRL_EMPTY: uint8 = 0x80
const SWISS_CTRL_DELETED: uint8 = 0xfe
// A single probe group keeps small dictionaries from allocating unused groups.
const SWISS_INITIAL_CAPACITY: usize = SWISS_GROUP_WIDTH

const SWISS_LOW_BITS: uint64 = 0x7f7f7f7f7f7f7f7f
const SWISS_HIGH_BITS: uint64 = 0x8080808080808080
const SWISS_BYTE_ONES: uint64 = 0x0101010101010101

@inline
func swissFingerprint(_ hash: uint64) -> uint8 {
    (hash & 0x7f_u64) as uint8
}

@inline
func swissCtrlIsFull(_ ctrl: uint8) -> bool {
    ctrl < SWISS_CTRL_EMPTY
}

// Each matching byte contributes its high bit. Masking before addition prevents
// carries between bytes, so adjacent fingerprints cannot create false matches.
// This is the portable word-at-a-time form of SwissTable group matching.
@inline
func swissMatch(_ group: uint64, _ tag: uint8) -> uint64 {
    different := group ^ (SWISS_BYTE_ONES * (tag as uint64))
    ~(((different & SWISS_LOW_BITS) + SWISS_LOW_BITS) | different | SWISS_LOW_BITS)
}

@inline
func swissMatchEmpty(_ group: uint64) -> uint64 {
    // Empty is 0x80, deleted is 0xfe, and full bytes have their high bit clear.
    group & ~(group << 6) & SWISS_HIGH_BITS
}

// The caller supplies a nonzero byte mask. Return the lowest matching slot.
@inline
func swissFirstMatch(_ matches: uint64) -> usize {
    var bits = matches
    var slot: usize = 0
    if (bits & 0xffffffff_u64) == 0_u64 {
        bits >>= 32
        slot += 4
    }
    if (bits & 0xffff_u64) == 0_u64 {
        bits >>= 16
        slot += 2
    }
    if (bits & 0xff_u64) == 0_u64 { slot += 1 }
    slot
}

// Triangular offsets visit every group exactly once for a power-of-two count.
// All slots of a group are checked before its empties terminate a lookup.
struct SwissProbe {
    group: usize
    stride: usize
    mask: usize
}

extend SwissProbe {
    @inline
    static func new(_ hash: uint64, _ groups: usize) -> Self {
        mask := groups - (1 as usize)
        SwissProbe { group: ((hash >> 7) as usize) & mask, stride: 0, mask }
    }
}

extend &SwissProbe {
    @inline
    func advance() {
        self.stride += 1
        self.group = (self.group + self.stride) & self.mask
    }
}

// Keep hashing in one specialization: caller-dependent O3 inlining can
// otherwise promote temporary byte spans to heap allocations. This boundary
// also reduces lookup frame traffic (see the SwissTable benchmark results).
@noinline
func hashKey[Key: Hashable](_ key: &Key) -> uint64 {
    var hasher = DefaultHasher::new()
    key.hash(into: &hasher)
    hasher.finish()
}

func dictionaryCapacityOverflow() {
    panic("dictionary capacity overflow")
}

func checkedDictionaryLenAfterInsert(_ len: usize) -> usize {
    match len.checkedAdd(1 as usize) {
        case .some(nextLen) => return nextLen
        case .none => {
            dictionaryCapacityOverflow()
            return 0 as usize
        }
    }
}

// A control word followed by eight plain payloads. These specialization
// constants match the runtime's checked group-layout calculation.
@inline
func dictionaryEntryOffset[T]() -> usize {
    alignment := __intrinsic_align_of[T]()
    if alignment > (8 as usize) { alignment } else { 8 as usize }
}

@inline
func dictionaryGroupStride[T]() -> usize {
    // Keep type geometry constant-foldable at slot accesses. The bound still
    // checks multiplication/addition overflow before either operation.
    size := __intrinsic_size_of[T]()
    offset := dictionaryEntryOffset[T]()
    if size > (~(0 as usize) - offset) / SWISS_GROUP_WIDTH {
        dictionaryCapacityOverflow()
    }
    offset + size * SWISS_GROUP_WIDTH
}

func assertDictionaryStorageCapacity[Key: Hashable, Value](_ capacity: usize) {
    stride := dictionaryGroupStride[(Key, Value)]()
    if capacity / SWISS_GROUP_WIDTH > maxBufferCapacity[uint8]() / stride {
        dictionaryCapacityOverflow()
    }
}

func dictionaryShouldGrowForInsert(_ len: usize, _ capacity: usize) -> bool {
    if capacity == 0 {
        return true
    }

    maxLenBeforeGrow := capacity - (capacity / SWISS_GROUP_WIDTH)
    return len >= maxLenBeforeGrow
}

func nextDictionaryCapacityForGrow[Key: Hashable, Value](_ current: usize) -> usize {
    nextCapacity := if current == 0 {
        SWISS_INITIAL_CAPACITY
    } else {
        match current.checkedMul(2 as usize) {
            case .some(capacity) => capacity
            case .none => {
                dictionaryCapacityOverflow()
                0 as usize
            }
        }
    }

    assertDictionaryStorageCapacity[Key, Value](nextCapacity)
    return nextCapacity
}

@test
func testDictionaryShouldGrowForInsertUsesOverflowFreeThreshold() {
    capacity := 0xffffffffffffffff_u64 as usize
    maxLenBeforeGrow := capacity - (capacity / SWISS_GROUP_WIDTH)

    assertFalse(
        dictionaryShouldGrowForInsert(maxLenBeforeGrow - (1 as usize), capacity),
        "dictionary should not grow below the overflow-free load threshold",
    )

    assertTrue(
        dictionaryShouldGrowForInsert(maxLenBeforeGrow, capacity),
        "dictionary should grow at the overflow-free load threshold",
    )
}

@test
@expectPanic
func testDictionaryGrowRejectsCapacityOverflow() {
    capacity := ((0xffffffffffffffff_u64 as usize) / (2 as usize)) + (1 as usize)
    var _ = nextDictionaryCapacityForGrow[int32, int32](capacity)
}

@test
@expectPanic
func testDictionaryGrowRejectsStorageByteOverflow() {
    maxValueCapacity := std::mem::maxBufferCapacity[(uint64, uint64)?]()
    capacity := (maxValueCapacity / (2 as usize)) + (1 as usize)
    var _ = nextDictionaryCapacityForGrow[int32, (uint64, uint64)](capacity)
}

/// SwissTable with eight-slot groups, 7-bit fingerprints and triangular probes.
/// Each control word encodes slot zero in its low byte, independent of target
/// endianness. Load is capped at 7/8, counting tombstones as occupied slots.
/// References: go.dev/blog/swisstable and abseil.io/about/design/swisstables.
///
/// Copying a Dictionary shares this table. The GC traces only payloads whose
/// control byte is full; empty/deleted slots are raw storage. Public reads copy values
/// and expose no slot address. Structural changes invalidate cursors via version.
final class DictionaryStorage[Key: Hashable, Value] {
    len: usize
    capacity: usize
    deleted: usize
    groups: DictionaryGroups[(Key, Value)]
    version: usize
}

// Fixed GC storage of Swiss groups. No typed array/reference covers inactive
// payloads: their bytes need not form valid values. Its runtime descriptor uses
// the same control words as lookup. No public API exposes an entry reference.
struct DictionaryGroups[T] {
    data: *mut uint8
    length: usize
}

extend[T] DictionaryGroups[T] {
    func len() -> usize { self.length }

    @inline
    func groupAt(_ group: usize) -> *mut uint8 {
        if group >= self.length { panic("dictionary group out of range") }
        self.data.add(group * dictionaryGroupStride[T]())
    }

    @inline
    func controls(_ group: usize) -> uint64 {
        unsafe { (self.groupAt(group) as *const uint64).read() }
    }

    @inline
    func entryPointer(_ slot: usize) -> *mut T {
        group := self.groupAt(slot / SWISS_GROUP_WIDTH)
        payloads := unsafe { group.add(dictionaryEntryOffset[T]()) as *mut T }
        payloads.add(slot % SWISS_GROUP_WIDTH)
    }

    // Callers prove this slot is full before interpreting its payload.
    @inline
    func entryAt(_ slot: usize) -> &T {
        unsafe { self.entryPointer(slot) as &T }
    }

    @inline
    func controlAt(_ slot: usize) -> uint8 {
        controls := self.controls(slot / SWISS_GROUP_WIDTH)
        shift := ((slot % SWISS_GROUP_WIDTH) * (8 as usize)) as uint64
        ((controls >> shift) & 0xff_u64) as uint8
    }

    @inline
    func setControl(_ slot: usize, _ tag: uint8) {
        controls := unsafe { self.groupAt(slot / SWISS_GROUP_WIDTH) as *mut uint64 }
        shift := ((slot % SWISS_GROUP_WIDTH) * (8 as usize)) as uint64
        previous := unsafe { controls.read() }
        unsafe { controls.write((previous & ~(0xff_u64 << shift)) | ((tag as uint64) << shift)) }
    }

    func writeEntry(_ slot: usize, _ tag: uint8, _ value: T) {
        pointer := self.entryPointer(slot)
        // Typed write preserves value copying and reference escape analysis,
        // including allocating copies of erased inline payloads.
        unsafe { pointer.write(value) }
        initialized := unsafe { pointer as &T }
        self.setControl(slot, tag)
        // Publishing may safepoint. Root the initialized destination until it
        // is visible: erased copies may own boxes absent from the source value.
        __intrinsic_keep_alive(initialized)
    }
}

func emptyDictionaryGroups[T](_ groups: usize) -> DictionaryGroups[T] {
    element := unsafe { std::intrinsic::__intrinsic_gc_value_descriptor[T]() }
    data := unsafe { __gc__dictionary_groups_new(element, groups) }
    if unsafe { data as usize } == 0 { dictionaryCapacityOverflow() }
    DictionaryGroups[T] { data, length: groups }
}

func copyDictionaryGroups[T](_ source: DictionaryGroups[T]) -> DictionaryGroups[T] {
    result := emptyDictionaryGroups[T](source.len())
    var slot: usize = 0
    while slot < source.len() * SWISS_GROUP_WIDTH {
        control := source.controlAt(slot)
        if swissCtrlIsFull(control) {
            value := *source.entryAt(slot)
            result.writeEntry(slot, control, value)
        } else if control == SWISS_CTRL_DELETED {
            result.setControl(slot, control)
        }
        slot += 1
    }
    result
}

extend[Key: Hashable, Value] DictionaryStorage[Key, Value] {
    init(_ capacity: usize) {
        self.len = 0
        self.capacity = capacity
        self.deleted = 0
        self.groups = emptyDictionaryGroups[(Key, Value)](capacity / SWISS_GROUP_WIDTH)
        self.version = 0
    }

    init(copying source: DictionaryStorage[Key, Value]) {
        self.len = source.len
        self.capacity = source.capacity
        self.deleted = source.deleted
        self.groups = copyDictionaryGroups(source.groups)
        self.version = 0
    }

    @inline
    func controlAt(_ slot: usize) -> uint8 {
        self.groups.controlAt(slot)
    }

    @inline
    func setControl(_ slot: usize, _ tag: uint8) {
        self.groups.setControl(slot, tag)
    }

    func keyAt(_ slot: usize) -> Key {
        self.groups.entryAt(slot).0
    }

    func valueAt(_ slot: usize) -> Value {
        self.groups.entryAt(slot).1
    }
}

@lang("Dictionary")
/// A shared hash-table handle. Use `copy()` for independent outer storage.
/// Mutating a handle-typed key's hash or equality while it is stored makes
/// subsequent lookup unspecified; it does not invalidate managed references.
/// Hash/equality callbacks must not structurally mutate this dictionary,
/// including while growth or tombstone cleanup rehashes its keys.
public struct Dictionary[Key: Hashable, Value] {
    internal storage: DictionaryStorage[Key, Value]
}

// Copying a dictionary copies the handle (D9); methods take value receivers.

extend[Key: Hashable, Value] Dictionary[Key, Value] {
    /// Reads require an existing key; assignment inserts or replaces a value.
    /// There is no address accessor into dictionary entry storage.
    public subscript(key: Key) -> Value {
        get {
            match self.findSlot(&key) {
                case .some(slot) => self.storage.valueAt(slot)
                case .none => panic("dictionary key not found")
            }
        }
        set(value) { self.set(key: key, value: value) }
    }
}

extend[Key: Hashable, Value] Dictionary[Key, Value] {
    public static func new() -> Self {
        Dictionary[Key, Value] { storage: DictionaryStorage[Key, Value](SWISS_INITIAL_CAPACITY) }
    }

    /// A new dictionary with the same entries. Keys and values are copied as
    /// ordinary values, so handle-typed entries are shared with the source.
    public func copy() -> Self {
        Dictionary[Key, Value] { storage: DictionaryStorage[Key, Value](copying: self.storage) }
    }

    public func len() -> usize {
        self.storage.len
    }

    public func isEmpty() -> bool {
        self.storage.len == 0
    }

    public func contains(_ key: &Key) -> bool {
        self.findSlot(key).isSome()
    }

    @inline
    func findSlot(_ key: &Key) -> usize? {
        storage := self.storage
        // One live entry in one group needs just equality. The full-slot mask
        // also finds survivors past deleted slots; hashing remains necessary
        // for larger tables and for choosing insertion positions.
        if storage.groups.len() == 1 && storage.len <= 1 {
            if storage.len == 0 { return .none }
            return self.findSingleEntrySlot(key)
        }
        return self.findHashedSlot(key, hashKey(key))
    }

    // Keep equality's roots and saved registers out of the hashed lookup's
    // frame. The dispatch above proves there is one live entry in one group.
    @noinline
    func findSingleEntrySlot(_ key: &Key) -> usize? {
        storage := self.storage
        full := ~storage.groups.controls(0 as usize) & SWISS_HIGH_BITS
        slot := swissFirstMatch(full)
        if key.eq(storage.keyAt(slot)) { return .some(slot) }
        return .none
    }

    func findHashedSlot(_ key: &Key, _ hash: uint64) -> usize? {
        storage := self.storage
        groups := storage.groups.len()
        fingerprint := swissFingerprint(hash)
        var probe = SwissProbe::new(hash, groups)
        while probe.stride < groups {
            controls := storage.groups.controls(probe.group)
            var matches = swissMatch(controls, fingerprint)
            while matches != 0_u64 {
                slot := probe.group * SWISS_GROUP_WIDTH + swissFirstMatch(matches)
                if key.eq(storage.keyAt(slot)) { return .some(slot) }
                matches &= matches - 1_u64
            }
            if swissMatchEmpty(controls) != 0_u64 { return .none }
            probe.advance()
        }
        return .none
    }

    func removeSlot(_ slot: usize) -> Value {
        storage := self.storage
        removed := storage.valueAt(slot)
        controls := storage.groups.controls(slot / SWISS_GROUP_WIDTH)
        // A group that already has an empty cannot be part of a probe chain
        // continuing beyond it. Otherwise preserve the chain with a tombstone.
        if swissMatchEmpty(controls) != 0_u64 {
            storage.setControl(slot, SWISS_CTRL_EMPTY)
        } else {
            storage.setControl(slot, SWISS_CTRL_DELETED)
            storage.deleted += 1
        }
        storage.len -= 1
        storage.version += 1
        return removed
    }

    public func remove(_ key: &Key) -> Value? {
        match self.findSlot(key) {
            case .some(slot) => return .some(self.removeSlot(slot))
            case .none => return .none
        }
    }

    public func get(_ key: &Key) -> Optional[Value] {
        match self.findSlot(key) {
            case .some(slot) => return .some(self.storage.valueAt(slot))
            case .none => return .none
        }
    }

    // Search past tombstones for an existing equal key before choosing a slot.
    // At least one empty exists because the occupied budget is capped at 7/8.
    func locateSlot(_ key: &Key, _ hash: uint64) -> (usize, bool) {
        storage := self.storage
        groups := storage.groups.len()
        fingerprint := swissFingerprint(hash)
        var probe = SwissProbe::new(hash, groups)
        var firstDeleted: usize? = .none
        while probe.stride < groups {
            controls := storage.groups.controls(probe.group)
            base := probe.group * SWISS_GROUP_WIDTH
            var matches = swissMatch(controls, fingerprint)
            while matches != 0_u64 {
                slot := base + swissFirstMatch(matches)
                if key.eq(storage.keyAt(slot)) { return (slot, true) }
                matches &= matches - 1_u64
            }
            if firstDeleted.isNone() {
                deleted := swissMatch(controls, SWISS_CTRL_DELETED)
                if deleted != 0_u64 { firstDeleted = .some(base + swissFirstMatch(deleted)) }
            }
            empty := swissMatchEmpty(controls)
            if empty != 0_u64 {
                match firstDeleted {
                    case .some(slot) => return (slot, false)
                    case .none => return (base + swissFirstMatch(empty), false)
                }
            }
            probe.advance()
        }
        panic("dictionary has no empty probe group")
    }

    func claimSlot(_ key: &Key, _ hash: uint64) -> (usize, bool) {
        var (slot, occupied) = self.locateSlot(key, hash)
        storage := self.storage
        if occupied || storage.controlAt(slot) == SWISS_CTRL_DELETED {
            return (slot, occupied)
        }
        if dictionaryShouldGrowForInsert(storage.len + storage.deleted, storage.capacity) {
            // Reclaim tombstones at the same capacity when enough accumulated
            // to amortize a rebuild. Otherwise grow to avoid repeated rebuilds.
            capacity := if storage.deleted >= storage.capacity / SWISS_GROUP_WIDTH {
                storage.capacity
            } else {
                nextDictionaryCapacityForGrow[Key, Value](storage.capacity)
            }
            self.rebuild(capacity)
            return self.locateSlot(key, hash)
        }
        return (slot, false)
    }

    func fillSlot(_ slot: usize, _ hash: uint64, key: Key, value: Value) {
        storage := self.storage
        if storage.controlAt(slot) == SWISS_CTRL_DELETED { storage.deleted -= 1 }
        storage.groups.writeEntry(slot, swissFingerprint(hash), (key, value))
        storage.len = checkedDictionaryLenAfterInsert(storage.len)
        storage.version += 1
    }

    public func insert(key: Key, value: Value) -> Value? {
        hash := hashKey(&key)
        var (slot, occupied) = self.claimSlot(&key, hash)
        if occupied {
            // Replacing a value is not a structural change.
            previous := self.storage.valueAt(slot)
            self.storage.groups.writeEntry(
                slot,
                self.storage.controlAt(slot),
                (self.storage.keyAt(slot), value),
            )
            return .some(previous)
        }
        self.fillSlot(slot, hash, key: key, value: value)
        return .none
    }

    public func set(key: Key, value: Value) {
        var _ = self.insert(key: key, value: value)
    }

    public func getOr(_ key: &Key, default defaultValue: Value) -> Value {
        match self.findSlot(key) {
            case .some(slot) => self.storage.valueAt(slot)
            case .none => defaultValue
        }
    }

    func rebuild(_ newCapacity: usize) {
        storage := self.storage
        fresh := DictionaryStorage[Key, Value](newCapacity)
        groups := fresh.groups.len()
        var oldSlot: usize = 0
        while oldSlot < storage.capacity {
            if swissCtrlIsFull(storage.controlAt(oldSlot)) {
                var (key, value) = *storage.groups.entryAt(oldSlot)
                hash := hashKey(&key)
                var probe = SwissProbe::new(hash, groups)
                while probe.stride < groups {
                    empty := swissMatchEmpty(fresh.groups.controls(probe.group))
                    if empty != 0_u64 {
                        slot := probe.group * SWISS_GROUP_WIDTH + swissFirstMatch(empty)
                        fresh.groups.writeEntry(slot, swissFingerprint(hash), (key, value))
                        break
                    }
                    probe.advance()
                }
            }
            oldSlot += 1
        }
        // Keep shared identity; install only after all entries have been copied.
        storage.groups = fresh.groups
        storage.capacity = newCapacity
        storage.deleted = 0
        storage.version += 1
    }

    public func clear() {
        storage := self.storage
        fresh := DictionaryStorage[Key, Value](SWISS_INITIAL_CAPACITY)
        storage.groups = fresh.groups
        storage.capacity = SWISS_INITIAL_CAPACITY
        storage.len = 0
        storage.deleted = 0
        storage.version += 1
    }

    public func keys() -> DictKeysIterator[Key, Value] {
        DictKeysIterator[Key, Value] { cursor: DictionaryCursor[Key, Value](self.storage) }
    }

    public func values() -> DictValuesIterator[Key, Value] {
        DictValuesIterator[Key, Value] { cursor: DictionaryCursor[Key, Value](self.storage) }
    }

    public func entries() -> DictEntriesIterator[Key, Value] {
        DictEntriesIterator[Key, Value] { cursor: DictionaryCursor[Key, Value](self.storage) }
    }
}

conform[Key: Hashable, Value] Dictionary[Key, Value] to Clone where Key: Clone, Value: Clone {
    public func clone() -> Self {
        var cloned = Dictionary[Key, Value]::new()
        for (key, value) in self {
            var _ = cloned.insert(key: key.clone(), value: value.clone())
        }
        return cloned
    }
}

// Shared traversal position (G14a). Copying an iterator shares the cursor;
// a structural change of the dictionary after the cursor starts panics.
final class DictionaryCursor[Key: Hashable, Value] {
    storage: DictionaryStorage[Key, Value]
    slot: usize
    version: usize
    exhausted: bool
}

extend[Key: Hashable, Value] DictionaryCursor[Key, Value] {
    init(_ storage: DictionaryStorage[Key, Value]) {
        self.storage = storage
        self.slot = 0
        self.version = storage.version
        self.exhausted = false
    }

    func advance() -> usize? {
        if self.exhausted {
            return .none
        }
        storage := self.storage
        if storage.version != self.version {
            panic("dictionary changed structurally during iteration")
        }
        while self.slot < storage.capacity {
            slot := self.slot
            self.slot += 1
            if swissCtrlIsFull(storage.controlAt(slot)) {
                return .some(slot)
            }
        }
        self.exhausted = true
        return .none
    }
}

public struct DictKeysIterator[Key: Hashable, Value] {
    internal cursor: DictionaryCursor[Key, Value]
}

conform[Key: Hashable, Value] DictKeysIterator[Key, Value] to Iterator {
    type Element = Key

    public func next() -> Optional[Self::Element] {
        match self.cursor.advance() {
            case .some(slot) => return .some(self.cursor.storage.keyAt(slot))
            case .none => return .none
        }
    }
}

conform[Key: Hashable, Value] DictKeysIterator[Key, Value] to Iterable {
    type Iterator = DictKeysIterator[Key, Value]
    type Element = Key

    public func iter() -> Self::Iterator {
        self
    }
}

public struct DictValuesIterator[Key: Hashable, Value] {
    internal cursor: DictionaryCursor[Key, Value]
}

conform[Key: Hashable, Value] DictValuesIterator[Key, Value] to Iterator {
    type Element = Value

    public func next() -> Optional[Self::Element] {
        match self.cursor.advance() {
            case .some(slot) => return .some(self.cursor.storage.valueAt(slot))
            case .none => return .none
        }
    }
}

conform[Key: Hashable, Value] DictValuesIterator[Key, Value] to Iterable {
    type Iterator = DictValuesIterator[Key, Value]
    type Element = Value

    public func iter() -> Self::Iterator {
        self
    }
}

public struct DictEntriesIterator[Key: Hashable, Value] {
    internal cursor: DictionaryCursor[Key, Value]
}

conform[Key: Hashable, Value] DictEntriesIterator[Key, Value] to Iterator {
    type Element = (Key, Value)

    public func next() -> Optional[Self::Element] {
        match self.cursor.advance() {
            case .some(slot) => {
                storage := self.cursor.storage
                return .some((storage.keyAt(slot), storage.valueAt(slot)))
            }
            case .none => return .none
        }
    }
}

conform[Key: Hashable, Value] DictEntriesIterator[Key, Value] to Iterable {
    type Iterator = DictEntriesIterator[Key, Value]
    type Element = (Key, Value)

    public func iter() -> Self::Iterator {
        self
    }
}

conform[Key: Hashable, Value] Dictionary[Key, Value] to Iterable {
    type Element = (Key, Value)
    type Iterator = DictEntriesIterator[Key, Value]

    public func iter() -> Self::Iterator {
        self.entries()
    }
}

@test
func testSwissGroupMasksAndFirstMatch() {
    var byte: uint64 = 0
    while byte < 256_u64 {
        var lane: usize = 0
        while lane < SWISS_GROUP_WIDTH {
            shift := (lane * (8 as usize)) as uint64
            group := (SWISS_HIGH_BITS & ~(0xff_u64 << shift)) | (byte << shift)
            var fingerprint: uint64 = 0
            while fingerprint < 128_u64 {
                expected := if byte == fingerprint { 0x80_u64 << shift } else { 0_u64 }
                std::testing::assertEqual(
                    swissMatch(group, fingerprint as uint8),
                    expected,
                    "fingerprint mask must match each byte exactly",
                )
                fingerprint += 1
            }
            expectedEmpty := if byte == 128_u64 {
                SWISS_HIGH_BITS
            } else {
                SWISS_HIGH_BITS & ~(0x80_u64 << shift)
            }
            if byte <= 128_u64 || byte == 254_u64 {
                std::testing::assertEqual(
                    swissMatchEmpty(group),
                    expectedEmpty,
                    "empty mask must exclude full and deleted slots",
                )
            }
            std::testing::assertEqual(
                swissFirstMatch(0x80_u64 << shift),
                lane,
                "first match must identify the lowest matching byte",
            )
            lane += 1
        }
        byte += 1
    }
    // Adjacent 0/1 bytes are the carry edge case for subtraction-based masks.
    std::testing::assertEqual(
        swissMatch(0x0100010001000100_u64, 0),
        0x0080008000800080_u64,
        "matching must not carry into adjacent bytes",
    )
    std::testing::assertEqual(
        swissMatch(0xfefefefefefefefe_u64, SWISS_CTRL_DELETED),
        SWISS_HIGH_BITS,
        "deleted mask must include every tombstone",
    )
}

@test
func testSwissProbeVisitsEveryGroupOnce() {
    var groups: usize = 1
    while groups <= (128 as usize) {
        var seen: [bool] = []
        var index: usize = 0
        while index < groups {
            seen.append(false)
            index += 1
        }
        var probe = SwissProbe::new(0xfedcba9876543210_u64, groups)
        while probe.stride < groups {
            assertFalse(seen[probe.group], "triangular probing must not repeat a group")
            seen[probe.group] = true
            probe.advance()
        }
        for visited in seen { assertTrue(visited, "triangular probing must visit every group") }
        groups *= 2
    }
}

@test
func testSwissTombstoneBudgetRebuildsWithoutGrowing() {
    table := Dictionary[int32, int32] { storage: DictionaryStorage[int32, int32](64) }
    // Synthetic hashes put 56 entries in seven full groups; the eighth is empty.
    var slot: usize = 0
    while slot < (56 as usize) {
        hash := ((slot / SWISS_GROUP_WIDTH) as uint64) << 7
        table.fillSlot(slot, hash, key: slot as int32, value: slot as int32)
        slot += 1
    }
    slot = 0
    while slot < SWISS_GROUP_WIDTH {
        var _ = table.removeSlot(slot)
        slot += 1
    }
    std::testing::assertEqual(table.storage.deleted, 8 as usize, "removing a full group creates tombstones")
    // The new key starts in the empty group, so consuming an empty exceeds the
    // budget. Rebuilding must reclaim the tombstones rather than grow capacity.
    var _ = table.claimSlot(&999, 7_u64 << 7)
    std::testing::assertEqual(table.storage.capacity, 64 as usize, "tombstone cleanup must retain capacity")
    std::testing::assertEqual(table.storage.deleted, 0 as usize, "rebuild must remove every tombstone")
    slot = 8
    while slot < (56 as usize) {
        key := slot as int32
        std::testing::assertEqual(table.get(&key).unwrap(), key, "rebuild preserves every live entry")
        slot += 1
    }
}

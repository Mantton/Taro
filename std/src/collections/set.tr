import std::default::Default
import std::hash::Hashable
import std::iter::{Iterable, Iterator}
import std::marker::Clone
import std::ops::{Contains, PartialEq}

/// A shared handle to a hash set (G15). Copying a Set shares its elements;
/// `copy()` makes an independent set.
@lang("Set")
public struct Set[Element: Hashable] {
    internal storage: Dictionary[Element, ()]
}

extend[Element: Hashable] Set[Element] {
    public static func new() -> Self {
        Set[Element] {
            storage: Dictionary[Element, ()]::new(),
        }
    }

    public func copy() -> Self {
        Set[Element] { storage: self.storage.copy() }
    }

    public func len() -> usize {
        self.storage.len()
    }

    public func isEmpty() -> bool {
        self.storage.isEmpty()
    }
}

extend[Element: Hashable] Set[Element] {
    public func insert(_ value: Element) {
        var _ = self.storage.insert(key: value, value: ())
    }

    public func contains(_ value: &Element) -> bool {
        self.storage.contains(value)
    }

    public func remove(_ value: &Element) -> bool {
        self.storage.remove(value).isSome()
    }

    public func clear() {
        self.storage.clear()
    }
}

conform[Element: Hashable] Set[Element] to Clone where Element: Clone {
    public func clone() -> Self {
        var cloned = Set[Element]::new()
        for value in self {
            cloned.insert(value.clone())
        }
        cloned
    }
}

public struct SetIterator[Element: Hashable] {
    internal inner: DictKeysIterator[Element, ()]
}

conform[Element: Hashable] SetIterator[Element] to Iterator {
    type Element = Element

    public func next() -> Element? {
        self.inner.next()
    }
}

conform[Element: Hashable] Set[Element] to Iterable {
    type Iterator = SetIterator[Element]
    type Element = Element

    public func iter() -> Self::Iterator {
        SetIterator[Element] { inner: self.storage.keys() }
    }
}

// Set algebra returns new sets; elements are copied as ordinary values.
extend[Element: Hashable] Set[Element] {
    public func union(_ other: Set[Element]) -> Set[Element] {
        var result = self.copy()
        for x in other {
            result.insert(x)
        }
        result
    }

    public func intersection(_ other: Set[Element]) -> Set[Element] {
        var result = Set[Element]::new()
        var (smaller, larger) = if self.len() <= other.len() { (self, other) } else { (other, self) }
        for x in smaller {
            if larger.contains(&x) {
                result.insert(x)
            }
        }
        result
    }

    public func difference(_ other: Set[Element]) -> Set[Element] {
        var result = Set[Element]::new()
        for x in self {
            if !other.contains(&x) {
                result.insert(x)
            }
        }
        result
    }

    public func isSubset(of other: Set[Element]) -> bool {
        if self.len() > other.len() {
            return false
        }
        for x in self {
            if !other.contains(&x) {
                return false
            }
        }
        return true
    }

    public func isSuperset(of other: Set[Element]) -> bool {
        other.isSubset(of: self)
    }
}

conform[Element: Hashable] SetIterator[Element] to Iterable {
    type Element = Element
    type Iterator = SetIterator[Element]
    public func iter() -> Self::Iterator { self }
}

conform[Element: Hashable] Set[Element] to Contains[Element] {
    public func contains(_ value: &Element) -> bool { self.contains(value) }
}

conform[Element: Hashable] Set[Element] to Default {
    public static func default() -> Self { Self::new() }
}

/// Order-independent set equality.
conform[Element: Hashable] Set[Element] to PartialEq {
    public func eq(_ other: Self) -> bool {
        self.len() == other.len() && self.isSubset(of: other)
    }
}

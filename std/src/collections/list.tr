import std.mem.{MaybeUninit, MutableSpan, Span, growBuffer, makeBuffer, maxBufferCapacity, sizeOf}
import std.optional.Optional
import std.iter.{Iterator, Iterable, FromIterator}
import std.panic.panic
import std.cmp.{Ord, Ordering}
import std.marker.{Clone, Sendable}
import std.intrinsic.{__intrinsic_list_read_unchecked, __intrinsic_list_read_mut_unchecked}

const LIST_INITIAL_CAPACITY: usize = 4

func listCapacityOverflow() {
    panic("list capacity overflow")
}

func checkedListLenAfterInsert(_ len: usize) -> usize {
    match len.checkedAdd(1 as usize) {
        case .some(nextLen) => return nextLen
        case .none => {
            listCapacityOverflow()
            return 0 as usize
        }
    }
}

func nextListCapacity[Element](_ current: usize, _ required: usize) -> usize {
    let maxCapacity = maxBufferCapacity[Element]()
    if required > maxCapacity {
        listCapacityOverflow()
    }

    // Keep the first buffer small for wider elements, while still fitting a
    // pair without a second allocation. Scalar lists retain four initial slots.
    let initialCapacity = if sizeOf[Element]() > (8 as usize) {
        2 as usize
    } else {
        LIST_INITIAL_CAPACITY
    }
    var newCap = if current == 0 { initialCapacity } else { current }
    if newCap > maxCapacity {
        newCap = required
    }

    while newCap < required {
        match newCap.checkedMul(2 as usize) {
            case .some(doubled) => {
                if doubled > maxCapacity {
                    newCap = required
                } else {
                    newCap = doubled
                }
            }
            case .none => {
                newCap = required
            }
        }
    }

    return newCap
}

@lang("List")
public struct List[Element] {
    buffer: *mut uint8
    len: usize
    cap: usize
}

// List storage is managed by the collector rather than borrowed from a stack.
// Transferring a List is therefore safe exactly when transferring its elements
// is safe; the blocking runtime moves the buffer's GC root with the value.
impl[Element] Sendable for List[Element] where Element: Sendable {}


/// Clears the storage a removed element occupied.
///
/// A managed buffer is scanned to its capacity, so a slot left holding an old
/// pointer would keep that value alive after it had been taken out. Zeroing is
/// cheaper than telling the collector how much of the buffer is live, which
/// used to mean taking its global lock on every removal.
func clearSlot[Element](_ buffer: *mut uint8, _ index: usize) {
    let elemSize = sizeOf[Element]()
    unsafe {
        let start = buffer.byteAdd(index * elemSize)
        // An element that can hold a pointer is word-aligned and a whole number
        // of words in size, so word writes reach every pointer it contains and
        // land on aligned addresses. Anything else cannot hold a pointer, and
        // is cleared a byte at a time rather than risk a misaligned store.
        let wordSize = sizeOf[usize]()
        if elemSize % wordSize == 0 {
            let words = elemSize / wordSize
            var word = 0 as usize
            while word < words {
                (start as *mut usize).add(word).write(0 as usize)
                word += 1 as usize
            }
        } else {
            var offset = 0 as usize
            while offset < elemSize {
                start.byteAdd(offset).write(0 as uint8)
                offset += 1 as usize
            }
        }
    }
}

public func __list_from_raw_parts[Element](_ buffer: *mut uint8, _ len: usize, _ cap: usize) -> List[Element] {
    List[Element] {
        buffer,
        len,
        cap,
    }
}

impl[Element] List[Element] {
    public func new() -> Self {
        List[Element] {
            buffer: unsafe { 0 as *mut uint8 },
            len: 0,
            cap: 0,
        }
    }

    public func new(withCapacity capacity: usize) -> Self {
        if capacity == 0 {
            return List[Element]()
        }

        if capacity > maxBufferCapacity[Element]() {
            listCapacityOverflow()
        }
        let buf = makeBuffer[Element](0, capacity)
        List[Element] {
            buffer: buf,
            len: 0,
            cap: capacity,
        }
    }

    public func len(&self) -> usize {
        self.len
    }

    public func capacity(&self) -> usize {
        self.cap
    }

    public func isEmpty(&self) -> bool {
        self.len == 0
    }

    public func asSpan(&self) -> Span[Element] {
        let ptr = unsafe { self.buffer as *const Element }
        return Span[Element].from(ptr, self.len)
    }

    public func asSpan(&mut self) -> MutableSpan[Element] {
        let ptr = unsafe { self.buffer as *mut Element }
        return MutableSpan[Element].from(ptr, self.len)
    }
}

impl[Element] FromIterator for List[Element] {
    type Element = Element

    public func fromIter[I: Iterator[Element = Element]](_ iter: &mut I) -> Self {
        return List.from(iter)
    }
}

impl[Element] List[Element] {
    @inline
    public func append(&mut self, _ item: Element) {
        let nextLen = checkedListLenAfterInsert(self.len)
        if self.len >= self.cap {
            self.grow()
        }

        unsafe {
            (self.buffer as *mut Element)
                .add(self.len)
                .write(item)
        }

        self.len = nextLen
    }

    func grow(&mut self) {
        let required = checkedListLenAfterInsert(self.len)
        let newCap = nextListCapacity[Element](self.cap, required)
        let newBuffer = growBuffer[Element](self.buffer, self.len, newCap)
        self.buffer = newBuffer
        self.cap = newCap
    }
}

impl[Element] List[Element] {
    public func get(&self, _ index: usize) -> Optional[&Element] {
        if index >= self.len {
            return .none
        }

        let elem = unsafe { (self.buffer as *const Element).add(index) as &Element }
        return .some(elem)
    }

    @inline
    public func at(&self, _ index: usize) -> &Element {
        if index >= self.len {
            panic("list index out of range")
        }

        return unsafe { __intrinsic_list_read_unchecked[Element](self.buffer, index) }
    }

    public func get(&mut self, _ index: usize) -> Optional[&mut Element] {
        if index >= self.len {
            return .none
        }

        let elem = unsafe { (self.buffer as *mut Element).add(index) as &mut Element }
        return .some(elem)
    }

    @inline
    public func at(&mut self, _ index: usize) -> &mut Element {
        if index >= self.len {
            panic("list index out of range")
        }

        return unsafe { __intrinsic_list_read_mut_unchecked[Element](self.buffer, index) }
    }
}

impl[Element] List[Element] {
    public func set(&mut self, _ index: usize, _ value: Element) {
        if index >= self.len {
            panic("list index out of range")
        }

        unsafe {
            (self.buffer as *mut Element)
                .add(index)
                .write(value)
        }
    }

    public func pop(&mut self) -> Optional[Element] {
        if self.len == 0 {
            return .none
        }

        self.len -= 1
        let elemSize = sizeOf[Element]()
        let offset = self.len * elemSize
        var elem = MaybeUninit[Element].uninit()
        unsafe {
            let dst = elem.asMutPtr() as *mut uint8
            self.buffer.byteAdd(offset).readBytes(dst, elemSize)
        }
        clearSlot[Element](self.buffer, self.len)
        return .some(unsafe { elem.assumeInit() })
    }

    public func clear(&mut self) {
        var index = 0 as usize
        while index < self.len {
            clearSlot[Element](self.buffer, index)
            index += 1 as usize
        }
        self.len = 0
    }
}

impl[Element] List[Element] {
    public func reserve(&mut self, _ minCapacity: usize) {
        if minCapacity <= self.cap {
            return
        }

        let newCap = nextListCapacity[Element](self.cap, minCapacity)
        let newBuffer = growBuffer[Element](self.buffer, self.len, newCap)
        self.buffer = newBuffer
        self.cap = newCap
    }

    public func insert(&mut self, at index: usize, _ item: Element) -> bool {
        if index > self.len {
            return false
        }

        let nextLen = checkedListLenAfterInsert(self.len)
        if self.len >= self.cap {
            self.grow()
        }

        if index < self.len {
            let count = self.len - index
            unsafe {
                let base = self.buffer as *mut Element
                let src = base.add(index)
                let dst = base.add(index + (1 as usize))
                (src as *const Element).copyTo(dst, count)
            }
        }

        unsafe {
            (self.buffer as *mut Element)
                .add(index)
                .write(item)
        }

        self.len = nextLen
        return true
    }

    public func removeAt(&mut self, _ index: usize) -> Optional[Element] {
        if index >= self.len {
            return .none
        }

        let elemSize = sizeOf[Element]()
        let offset = index * elemSize
        var elem = MaybeUninit[Element].uninit()
        unsafe {
            let dst = elem.asMutPtr() as *mut uint8
            self.buffer.byteAdd(offset).readBytes(dst, elemSize)
        }

        let remaining = self.len - index - (1 as usize)
        if remaining > 0 {
            unsafe {
                let base = self.buffer as *mut Element
                let src = base.add(index + (1 as usize))
                let dst = base.add(index)
                (src as *const Element).copyTo(dst, remaining)
            }
        }

        self.len -= 1
        clearSlot[Element](self.buffer, self.len)
        return .some(unsafe { elem.assumeInit() })
    }
}

impl[Element] List[Element] {
    public func from[I: Iterator[Element = Element]](_ iter: &mut I) -> Self {
        var list = List[Element]()
        loop {
            match iter.next() {
                case .some(item) => list.append(item)
                case .none => break
            }
        }
        return list
    }
}

impl[Element] Clone for List[Element] where Element: Clone {
    public func clone(&self) -> Self {
        var cloned = List[Element](withCapacity: self.len)
        var idx: usize = 0
        while idx < self.len {
            cloned.append(self.at(idx).clone())
            idx += 1
        }
        return cloned
    }
}

impl[Element: Ord] List[Element] {
    public func sort(&mut self) {
        if self.len <= 1 {
            return
        }

        let elemSize = sizeOf[Element]()

        var i: usize = 1
        while i < self.len {
            var key = MaybeUninit[Element].uninit()
            unsafe {
                let keyPtr = key.asMutPtr()
                let src = (self.buffer as *const Element).add(i)
                (src as *const uint8).readBytes(keyPtr as *mut uint8, elemSize)
            }

            var j = i
            while j > 0 {
                let prev = unsafe { (self.buffer as *const Element).add(j - (1 as usize)) as &Element }
                let keyRef = unsafe { key.assumeInitRef() }
                match keyRef.cmp(prev) {
                    case .less => {
                        unsafe {
                            let src = (self.buffer as *const Element).add(j - (1 as usize))
                            let dst = (self.buffer as *mut Element).add(j)
                            (src as *const uint8).readBytes(dst as *mut uint8, elemSize)
                        }
                        j -= 1
                    }
                    case _ => break
                }
            }

            unsafe {
                let keyPtr = key.asPtr()
                let dst = (self.buffer as *mut Element).add(j)
                (keyPtr as *const uint8).readBytes(dst as *mut uint8, elemSize)
            }

            i += 1
        }
    }
}

public struct ListIterator[Element] {
    buffer: *mut uint8
    len: usize
    idx: usize
}

impl[Element] Iterator for ListIterator[Element] {
    type Element = Element

    public func next(&mut self) -> Optional[Self.Element] {
        if self.idx >= self.len {
            return .none
        }

        let elemSize = sizeOf[Element]()
        let offset = self.idx * elemSize
        var elem = MaybeUninit[Element].uninit()
        unsafe {
            let dst = elem.asMutPtr() as *mut uint8
            self.buffer.byteAdd(offset).readBytes(dst, elemSize)
        }

        self.idx += 1
        return .some(unsafe { elem.assumeInit() })
    }
}

public struct ListRefIterator[Element] {
    buffer: *mut uint8
    len: usize
    idx: usize
}

impl[Element] Iterator for ListRefIterator[Element] {
    type Element = &Element

    public func next(&mut self) -> Optional[Self.Element] {
        if self.idx >= self.len {
            return .none
        }
        let elem = unsafe { (self.buffer as *const Element).add(self.idx) as &Element }
        self.idx += 1
        return .some(elem)
    }
}

impl[Element] Iterable for List[Element] {
    type Iterator = ListIterator[Element]
    type Element = Element

    public func iter(self) -> Self.Iterator {
        ListIterator[Element] {
            buffer: self.buffer,
            len: self.len,
            idx: 0,
        }
    }
}

impl[Element] Iterable for &List[Element] {
    type Iterator = ListRefIterator[Element]
    type Element = &Element

    public func iter(self) -> Self.Iterator {
        ListRefIterator[Element] {
            buffer: self.buffer,
            len: self.len,
            idx: 0,
        }
    }
}

public struct ListMutIterator[Element] {
    buffer: *mut uint8
    len: usize
    idx: usize
}

impl[Element] Iterator for ListMutIterator[Element] {
    type Element = &mut Element

    public func next(&mut self) -> Optional[Self.Element] {
        if self.idx >= self.len {
            return .none
        }
        let elem = unsafe { (self.buffer as *mut Element).add(self.idx) as &mut Element }
        self.idx += 1
        return .some(elem)
    }
}

impl[Element] Iterable for &mut List[Element] {
    type Iterator = ListMutIterator[Element]
    type Element = &mut Element

    public func iter(self) -> Self.Iterator {
        ListMutIterator[Element] {
            buffer: self.buffer,
            len: self.len,
            idx: 0,
        }
    }
}

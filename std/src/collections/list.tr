import std::default::Default
import std::mem::{Span, maxBufferCapacity, sizeOf}
import std::optional::Optional
import std::iter::{Iterator, Iterable, FromIterator}
import std::panic::panic
import std::marker::Clone
import std::range::{Range, ClosedRange, RangeFrom, RangeTo, RangeToInclusive, RangeFull}

// GC managed sequences (G13). Data pointers address the first element; the
// runtime traces only the published prefix.
extern "taro_rt" {
    unsafe func __gc__buffer_new(_ element: *const uint8, _ capacity: usize) -> *mut uint8
    unsafe func __gc__buffer_publish(_ data: *mut uint8, _ element: *const uint8, _ initialized: usize)
    unsafe func __gc__buffer_grow(_ data: *mut uint8, _ element: *const uint8, _ length: usize, _ capacity: usize) -> *mut uint8
}

const LIST_INITIAL_CAPACITY: usize = 4

func listCapacityOverflow() {
    panic("list capacity overflow")
}

func checkedListLenAfterInsert(_ len: usize) -> usize {
    match len.checkedAdd(1 as usize) {
        case .some(nextLen) => return nextLen
        case .none => {
            listCapacityOverflow()
            return 0 as usize
        }
    }
}

func nextListCapacity[Element](_ current: usize, _ required: usize) -> usize {
    maxCapacity := maxBufferCapacity[Element]()
    if required > maxCapacity {
        listCapacityOverflow()
    }

    // Keep the first buffer small for wider elements, while still fitting a
    // pair without a second allocation. Scalar lists retain four initial slots.
    initialCapacity := if sizeOf[Element]() > (8 as usize) {
        2 as usize
    } else {
        LIST_INITIAL_CAPACITY
    }
    var newCap = if current == 0 { initialCapacity } else { current }
    if newCap > maxCapacity {
        newCap = required
    }

    while newCap < required {
        match newCap.checkedMul(2 as usize) {
            case .some(doubled) => {
                if doubled > maxCapacity {
                    newCap = required
                } else {
                    newCap = doubled
                }
            }
            case .none => {
                newCap = required
            }
        }
    }

    return newCap
}

func listElementDescriptor[Element]() -> *const uint8 {
    unsafe { std::intrinsic::__intrinsic_gc_value_descriptor[Element]() }
}

// Shared list state (G14). Copying a List copies the handle to this object, so
// every copy observes the same elements. `data` points at a GC managed
// sequence whose published prefix covers at least `len` elements; slots past
// `len` stay valid for outstanding element references. `version` changes on
// every structural change and is checked by cursors.
final class ListStorage[Element] {
    data: *mut Element
    len: usize
    cap: usize
    version: usize
}

extend[Element] ListStorage[Element] {
    init(_ data: *mut Element, _ len: usize, _ cap: usize) {
        self.data = data
        self.len = len
        self.cap = cap
        self.version = 0
    }
}

@lang("List")
public struct List[Element] {
    internal storage: ListStorage[Element]
}

// Copying a list copies the handle (D9); methods take value receivers.

extend[Element] List[Element] {
    @inline
    public subscript(index: usize) -> Element {
        address {
            if index >= self.storage.len { panic("list index out of range") }
            unsafe { self.storage.data.add(index) as &Element }
        }
    }

    /// Range indexing copies elements into independent outer list storage.
    public subscript(range: Range[usize]) -> Self {
        get { self.copyRange(range.start, range.end) }
    }

    public subscript(range: ClosedRange[usize]) -> Self {
        get {
            if range.start > range.end || range.end >= self.len() { panic("list range out of range") }
            self.copyRange(range.start, range.end + (1 as usize))
        }
    }

    public subscript(range: RangeFrom[usize]) -> Self {
        get { self.copyRange(range.start, self.len()) }
    }

    public subscript(range: RangeTo[usize]) -> Self {
        get { self.copyRange(0 as usize, range.end) }
    }

    public subscript(range: RangeToInclusive[usize]) -> Self {
        get {
            if range.end >= self.len() { panic("list range out of range") }
            self.copyRange(0 as usize, range.end + (1 as usize))
        }
    }

    public subscript(range: RangeFull) -> Self {
        get {
            var _ = range
            self.copyRange(0 as usize, self.len())
        }
    }

    func copyRange(_ start: usize, _ end: usize) -> Self {
        if start > end || end > self.len() { panic("list range out of range") }
        var result = Self::new(withCapacity: end - start)
        var index = start
        while index < end { result.append(self[index]); index += 1 }
        result
    }
}

/// Safety: buffer is null or a GC managed sequence of Element with at least
/// len published elements and the stated capacity.
public unsafe func __list_from_raw_parts[Element](_ buffer: *mut uint8, _ len: usize, _ cap: usize) -> List[Element] {
    unsafe { List[Element]::fromRawParts(buffer, len, cap) }
}

// Stable compiler hooks for list literals.
public func __list_with_capacity[Element](_ capacity: usize) -> List[Element] {
    List[Element]::new(withCapacity: capacity)
}
public func __list_append[Element](_ list: &List[Element], _ value: Element) {
    list.append(value)
}

// Spread lowering instantiates these adapters with the selected Iterable
// witness. Both calls use the same receiver semantics as a for loop.
internal func __spread_iter[Source: Iterable](_ source: Source) -> Source::Iterator {
    source.iter()
}
internal func __spread_next[Element, Cursor: Iterator[Element = Element]](_ cursor: &Cursor) -> Element? {
    cursor.next()
}

/// Copy the fully initialized prefix into an independent inline array.
internal func __spread_array[Element, const Size: usize](_ list: &List[Element]) -> [Element; Size] {
    if list.len() != Size { panic("invalid spread array length") }
    if Size == 0 {
        // An empty array has no elements with initialization requirements.
        return unsafe { std::mem::MaybeUninit[[Element; Size]]::zeroed().assumeInit() }
    }
    // The managed buffer is aligned for Element and contains exactly Size live
    // elements. Reading the array performs ordinary by-value element copies.
    return unsafe { *(list.asSpan().asPtr() as *const [Element; Size]) }
}

/// Copy readable bytes into a fresh list. This never adopts source storage.
public unsafe func __list_copy_bytes(_ source: *const uint8, _ length: usize) -> List[uint8] {
    unsafe { List[uint8]::copyNativeBytes(source, length) }
}

extend List[uint8] {
    static unsafe func copyNativeBytes(_ source: *const uint8, _ length: usize) -> Self {
        var result: Self = Self::new(withCapacity: length)
        if length > 0 {
            unsafe {
                source.readBytes(result.data(), length)
                __gc__buffer_publish(result.data(), listElementDescriptor[uint8](), length)
            }
            result.storage.len = length
        }
        return result
    }
}

extend[Element] List[Element] {
    static unsafe func fromRawParts(_ buffer: *mut uint8, _ len: usize, _ cap: usize) -> Self {
        List[Element] { storage: ListStorage[Element](unsafe { buffer as *mut Element }, len, cap) }
    }

    public static func new() -> Self {
        List[Element] { storage: ListStorage[Element](unsafe { 0 as *mut Element }, 0, 0) }
    }

    public static func new(withCapacity capacity: usize) -> Self {
        var list = List[Element]::new()
        list.reserveExact(capacity)
        return list
    }

    func data() -> *mut uint8 {
        unsafe { self.storage.data as *mut uint8 }
    }

    @inline
    public func len() -> usize {
        self.storage.len
    }

    @inline
    public func capacity() -> usize {
        self.storage.cap
    }

    @inline
    public func isEmpty() -> bool {
        self.storage.len == 0
    }

    /// A new list with its own storage holding copies of these elements.
    public func copy() -> Self {
        var result = List[Element]::new(withCapacity: self.storage.len)
        var index: usize = 0
        while index < self.storage.len {
            result.append(*self.at(index))
            index += 1
        }
        return result
    }

    public func asSpan() -> Span[Element] {
        ptr := unsafe { self.storage.data as *const Element }
        // The span's data pointer keeps the storage alive (D2).
        return unsafe { Span[Element]::from(ptr, self.storage.len) }
    }
}

conform[Element] List[Element] to FromIterator {
    type Element = Element

    public static func fromIter[I: Iterator[Element = Element]](_ iter: &I) -> Self {
        return List::from(iter)
    }
}

extend[Element] List[Element] {
    @inline
    public func append(_ item: Element) {
        length := self.storage.len
        nextLen := checkedListLenAfterInsert(length)
        if length >= self.storage.cap { self.reserve(nextLen) }
        // An unpublished slot is not traced: no safepoint may separate the
        // write from publication, so resolve every operand first.
        element := listElementDescriptor[Element]()
        data := self.storage.data
        slot := data.add(length)
        unsafe {
            slot.write(item)
            __gc__buffer_publish(data as *mut uint8, element, nextLen)
        }
        self.storage.len = nextLen
        self.storage.version += 1
    }
}

extend[Element] List[Element] {
    public func get(_ index: usize) -> Optional[&Element] {
        if index >= self.storage.len {
            return .none
        }

        return .some(self.at(index))
    }

    /// The element's storage. The reference stays valid after growth or
    /// removal; it then addresses the element's former slot.
    @inline
    public func at(_ index: usize) -> &Element {
        if index >= self.storage.len {
            panic("list index out of range")
        }

        return unsafe { self.storage.data.add(index) as &Element }
    }
}

extend[Element] List[Element] {
    public func set(_ index: usize, _ value: Element) {
        *self.at(index) = value
    }

    @inline
    public func pop() -> Optional[Element] {
        if self.storage.len == 0 { return .none }
        self.removeAt(self.storage.len - (1 as usize))
    }

    /// Returns a value copy of the first element, or `.none` if the list is empty.
    @inline
    public func first() -> Element? {
        if self.storage.len == 0 { return .none }
        return .some(*self.at(0 as usize))
    }

    /// Returns a value copy of the last element, or `.none` if the list is empty.
    @inline
    public func last() -> Element? {
        if self.storage.len == 0 { return .none }
        return .some(*self.at(self.storage.len - (1 as usize)))
    }

    /// Swaps the elements at indices `i` and `j`. Panics if either index is out of bounds.
    /// A no-op when `i == j`. Preserves element-write semantics without changing length.
    public func swap(_ i: usize, _ j: usize) {
        length := self.storage.len
        if i >= length || j >= length {
            panic("list index out of range")
        }
        if i == j { return }
        tmp := *self.at(i)
        *self.at(i) = *self.at(j)
        *self.at(j) = tmp
    }

    /// Removes and returns the element at `index` in amortized O(1) time by replacing it
    /// with the last element. Panics if `index >= self.len()`. Clears the vacated slot
    /// and detaches oversized tail storage so removed references are not retained.
    public func swapRemove(_ index: usize) -> Element {
        length := self.storage.len
        if index >= length {
            panic("list index out of range")
        }
        removed := *self.at(index)
        last := length - (1 as usize)
        if last == 0 {
            self.clear()
            return removed
        }
        if index != last {
            *self.at(index) = *self.at(last)
        }
        // Overwrite the vacated tail slot with a surviving live element so
        // the removed value is never retained in the published GC prefix.
        *self.at(last) = *self.at(0 as usize)
        self.storage.len = last
        self.storage.version += 1
        // Amortized O(1) shrink at <= 25% load (re-allocating to 50% load)
        // prevents dead tail capacity from pinning references across shrinks.
        if last * (4 as usize) <= self.storage.cap {
            nextCap := last * (2 as usize)
            element := listElementDescriptor[Element]()
            next := unsafe { __gc__buffer_grow(self.data(), element, last, nextCap) }
            if unsafe { next as usize } != 0 {
                self.storage.data = unsafe { next as *mut Element }
                self.storage.cap = nextCap
            }
        }
        return removed
    }

    // Rebind to a tightly published buffer after in-place compaction drops
    // elements, so removed objects are not kept alive in dead tail capacity.
    internal func shrinkCompacted(_ newLen: usize) {
        if newLen == self.storage.len {
            return
        }
        if newLen == 0 {
            self.clear()
            return
        }
        element := listElementDescriptor[Element]()
        next := unsafe { __gc__buffer_grow(self.data(), element, newLen, newLen) }
        if unsafe { next as usize } == 0 {
            listCapacityOverflow()
        }
        self.storage.data = unsafe { next as *mut Element }
        self.storage.len = newLen
        self.storage.cap = newLen
        self.storage.version += 1
    }

    /// Detach the storage so its elements are reclaimed once no element
    /// reference remains.
    public func clear() {
        // Logical emptiness does not imply empty storage: popped/removed
        // elements stay initialized for outstanding element references.
        self.storage.data = unsafe { 0 as *mut Element }
        self.storage.len = 0
        self.storage.cap = 0
        self.storage.version += 1
    }
}

extend[Element] List[Element] {
    public func reserve(_ minCapacity: usize) {
        if minCapacity <= self.storage.cap { return }
        self.reserveExact(nextListCapacity[Element](self.storage.cap, minCapacity))
    }

    func reserveExact(_ capacity: usize) {
        if capacity <= self.storage.cap { return }
        if capacity > maxBufferCapacity[Element]() {
            listCapacityOverflow()
        }
        element := listElementDescriptor[Element]()
        next := if self.storage.cap == 0 {
            unsafe { __gc__buffer_new(element, capacity) }
        } else {
            unsafe { __gc__buffer_grow(self.data(), element, self.storage.len, capacity) }
        }
        if unsafe { next as usize } == 0 {
            listCapacityOverflow()
        }
        self.storage.data = unsafe { next as *mut Element }
        self.storage.cap = capacity
    }

    public func insert(at index: usize, _ item: Element) -> bool {
        length := self.storage.len
        if index > length { return false }
        nextLen := checkedListLenAfterInsert(length)
        if length >= self.storage.cap { self.reserve(nextLen) }
        // Publish the shifted extent before anything can collect (see append).
        element := listElementDescriptor[Element]()
        data := self.storage.data
        slot := data.add(index)
        unsafe {
            if index < length {
                slot.copyTo(data.add(index + (1 as usize)), length - index)
            }
            slot.write(item)
            __gc__buffer_publish(data as *mut uint8, element, nextLen)
        }
        self.storage.len = nextLen
        self.storage.version += 1
        true
    }

    @inline
    public func removeAt(_ index: usize) -> Optional[Element] {
        length := self.storage.len
        if index >= length { return .none }
        element := *self.at(index)
        next := index + (1 as usize)
        if next < length {
            unsafe {
                data := self.storage.data
                data.add(next).copyTo(data.add(index), length - next)
            }
        }
        self.storage.len = length - (1 as usize)
        self.storage.version += 1
        return .some(element)
    }
}

extend[Element] List[Element] {
    public static func from[I: Iterator[Element = Element]](_ iter: &I) -> Self {
        var list = List[Element]::new()
        loop {
            match iter.next() {
                case .some(item) => list.append(item)
                case .none => break
            }
        }
        return list
    }
}

conform[Element] List[Element] to Clone where Element: Clone {
    public func clone() -> Self {
        var cloned = List[Element]::new(withCapacity: self.storage.len)
        var idx: usize = 0
        while idx < self.storage.len {
            cloned.append(self.at(idx).clone())
            idx += 1
        }
        return cloned
    }
}

// Shared traversal position (G14a). Copying an iterator shares the cursor;
// a structural change of the list after the cursor starts panics on `next`.
final class ListCursor[Element] {
    storage: ListStorage[Element]
    index: usize
    version: usize
    exhausted: bool
}

extend[Element] ListCursor[Element] {
    init(_ storage: ListStorage[Element]) {
        self.storage = storage
        self.index = 0
        self.version = storage.version
        self.exhausted = false
    }

    func advance() -> Optional[*mut Element] {
        if self.exhausted {
            return .none
        }
        if self.storage.version != self.version {
            panic("list changed structurally during iteration")
        }
        if self.index >= self.storage.len {
            self.exhausted = true
            return .none
        }
        slot := unsafe { self.storage.data.add(self.index) }
        self.index += 1
        return .some(slot)
    }
}

@lang("ListIterator")
public struct ListIterator[Element] {
    internal cursor: ListCursor[Element]
}

conform[Element] ListIterator[Element] to Iterator {
    type Element = Element
    public func next() -> Optional[Self::Element] {
        match self.cursor.advance() {
            case .some(slot) => return .some(unsafe { *(slot as &Element) })
            case .none => return .none
        }
    }
}

conform[Element] List[Element] to Iterable {
    type Iterator = ListIterator[Element]
    type Element = Element

    public func iter() -> Self::Iterator {
        ListIterator[Element] { cursor: ListCursor[Element](self.storage) }
    }
}

conform[Element] ListIterator[Element] to Iterable {
    type Element = Element
    type Iterator = ListIterator[Element]
    public func iter() -> Self::Iterator { self }
}

// Compiler adapter for contextual &List -> Span coercion. The header captures
// the current buffer and length; later structural changes do not retarget it.
@inline
internal func __list_as_span[Element](_ list: &List[Element]) -> Span[Element] {
    list.asSpan()
}

conform[Element] List[Element] to Default {
    public static func default() -> Self { Self::new() }
}

import std::collections::{Dictionary, DictEntriesIterator}
import std::hash::Hashable
import std::iter::{Iterator, Iterable}
import std::optional::Optional

/// A shared handle to per-key counts (G15); copying a Counter shares it.
public struct Counter[Key: Hashable] {
    storage: Dictionary[Key, int32]
}

extend[Key: Hashable] Counter[Key] {
    public static func new() -> Self {
        Counter[Key] {
            storage: Dictionary[Key, int32]::new(),
        }
    }

    public func len() -> usize {
        self.storage.len()
    }

    /// A new counter with independent counts and ordinary copies of its keys.
    public func copy() -> Self {
        Counter[Key] { storage: self.storage.copy() }
    }

    public func isEmpty() -> bool {
        self.storage.isEmpty()
    }

    public func get(_ key: &Key) -> int32 {
        match self.storage.get(key) {
            case .some(count) => return count
            case .none => return 0
        }
    }

    public func contains(_ key: &Key) -> bool {
        self.storage.contains(key)
    }

    public func set(key: Key, count: int32) {
        if count == 0 {
            var _ = self.storage.remove(&key)
        } else {
            self.storage.set(key: key, value: count)
        }
    }

    public func increment(_ key: Key, by amount: int32 = 1) -> int32 {
        next := self.get(&key) + amount
        self.set(key: key, count: next)
        return next
    }

    public func decrement(_ key: Key, by amount: int32 = 1) -> int32 {
        return self.increment(key, by: -amount)
    }

    public func remove(_ key: &Key) -> int32 {
        match self.storage.remove(key) {
            case .some(count) => return count
            case .none => return 0
        }
    }

    public func clear() {
        self.storage.clear()
    }
}

public struct CounterIterator[Key: Hashable] {
    inner: DictEntriesIterator[Key, int32]
}

conform[Key: Hashable] CounterIterator[Key] to Iterator {
    type Element = (Key, int32)

    public func next() -> Optional[Self::Element] {
        self.inner.next()
    }
}

conform[Key: Hashable] Counter[Key] to Iterable {
    type Iterator = CounterIterator[Key]
    type Element = (Key, int32)

    public func iter() -> Self::Iterator {
        CounterIterator[Key] {
            inner: self.storage.entries(),
        }
    }
}

conform[Key: Hashable] CounterIterator[Key] to Iterable {
    type Element = (Key, int32)
    type Iterator = CounterIterator[Key]
    public func iter() -> Self::Iterator { self }
}

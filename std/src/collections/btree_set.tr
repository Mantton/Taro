import std::cmp::{Ord, Ordering, PartialOrd}
import std::default::Default
import std::iter::{FromIterator, Iterable, Iterator}
import std::marker::Clone
import std::ops::{Contains, PartialEq}
import std::range::{ClosedRange, Range}

/// A shared handle to an ordered set backed by `BTreeMap[Element, ()]`.
/// Lookup, insertion, removal, and ordered bound queries run in O(log n).
/// Assignment shares the set; `copy()` creates an independent shallow copy.
public struct BTreeSet[Element: Ord] {
    internal map: BTreeMap[Element, ()]
}

extend[Element: Ord] BTreeSet[Element] {
    public static func new() -> Self {
        BTreeSet[Element] { map: BTreeMap[Element, ()]::new() }
    }

    public func copy() -> Self {
        BTreeSet[Element] { map: self.map.copy() }
    }

    @inline
    public func len() -> usize {
        self.map.len()
    }

    @inline
    public func isEmpty() -> bool {
        self.map.isEmpty()
    }

    public func clear() {
        self.map.clear()
    }

    /// Inserts `value`. Returns `true` if `value` was newly inserted, `false` if already present.
    public func insert(_ value: Element) -> bool {
        self.map.insert(key: value, value: ()).isNone()
    }

    /// Removes `value`. Returns `true` if `value` was present.
    public func remove(_ value: &Element) -> bool {
        self.map.remove(value).isSome()
    }

    /// Returns `true` if `value` is in the set.
    public func contains(_ value: &Element) -> bool {
        self.map.contains(value)
    }

    /// Returns the smallest element in O(log n), or `.none` if empty.
    public func first() -> Element? {
        self.map.firstKey()
    }

    /// Returns the largest element in O(log n), or `.none` if empty.
    public func last() -> Element? {
        self.map.lastKey()
    }

    /// Removes and returns the smallest element in O(log n).
    public func popFirst() -> Element? {
        match self.map.popFirst() {
            case .some((k, _)) => .some(k)
            case .none => .none
        }
    }

    /// Removes and returns the largest element in O(log n).
    public func popLast() -> Element? {
        match self.map.popLast() {
            case .some((k, _)) => .some(k)
            case .none => .none
        }
    }

    /// Returns the smallest element `>= *value` in O(log n).
    public func lowerBound(_ value: &Element) -> Element? {
        match self.map.lowerBound(value) {
            case .some((k, _)) => .some(k)
            case .none => .none
        }
    }

    /// Returns the smallest element `> *value` in O(log n).
    public func upperBound(_ value: &Element) -> Element? {
        match self.map.upperBound(value) {
            case .some((k, _)) => .some(k)
            case .none => .none
        }
    }

    /// Returns the greatest element `< *value` in O(log n).
    public func lastBefore(_ value: &Element) -> Element? {
        match self.map.lastBefore(value) {
            case .some((k, _)) => .some(k)
            case .none => .none
        }
    }

    /// Returns the greatest element `<= *value` in O(log n).
    public func lastAtOrBefore(_ value: &Element) -> Element? {
        match self.map.lastAtOrBefore(value) {
            case .some((k, _)) => .some(k)
            case .none => .none
        }
    }

    /// Ascending iterator over elements with `*low <= elem < *high` in O(log n + k).
    public func range(_ low: &Element, _ high: &Element) -> BTreeSetIterator[Element] {
        BTreeSetIterator[Element] { inner: self.map.range(low, high) }
    }

    /// Ascending iterator over elements with `bounds.start <= elem < bounds.end`.
    public func range(_ bounds: Range[Element]) -> BTreeSetIterator[Element] {
        BTreeSetIterator[Element] { inner: self.map.range(bounds) }
    }

    /// Ascending iterator over elements with `bounds.start <= elem <= bounds.end`.
    public func range(_ bounds: ClosedRange[Element]) -> BTreeSetIterator[Element] {
        BTreeSetIterator[Element] { inner: self.map.range(bounds) }
    }

    public func union(_ other: BTreeSet[Element]) -> BTreeSet[Element] {
        result := self.copy()
        for elem in other {
            var _ = result.insert(elem)
        }
        return result
    }

    public func intersection(_ other: BTreeSet[Element]) -> BTreeSet[Element] {
        result := BTreeSet[Element]::new()
        var (smaller, larger) = if self.len() <= other.len() { (self, other) } else { (other, self) }
        for elem in smaller {
            if larger.contains(&elem) {
                var _ = result.insert(elem)
            }
        }
        return result
    }

    public func difference(_ other: BTreeSet[Element]) -> BTreeSet[Element] {
        result := BTreeSet[Element]::new()
        for elem in self {
            if !other.contains(&elem) {
                var _ = result.insert(elem)
            }
        }
        return result
    }

    public func symmetricDifference(_ other: BTreeSet[Element]) -> BTreeSet[Element] {
        result := BTreeSet[Element]::new()
        for elem in self {
            if !other.contains(&elem) {
                var _ = result.insert(elem)
            }
        }
        for elem in other {
            if !self.contains(&elem) {
                var _ = result.insert(elem)
            }
        }
        return result
    }

    public func isSubset(of other: BTreeSet[Element]) -> bool {
        if self.len() > other.len() {
            return false
        }
        for elem in self {
            if !other.contains(&elem) {
                return false
            }
        }
        return true
    }

    public func isSuperset(of other: BTreeSet[Element]) -> bool {
        other.isSubset(of: self)
    }
}

public struct BTreeSetIterator[Element: Ord] {
    internal inner: BTreeMapEntriesIterator[Element, ()]
}

conform[Element: Ord] BTreeSetIterator[Element] to Iterator {
    type Element = Element

    public func next() -> Element? {
        match self.inner.next() {
            case .some((k, _)) => .some(k)
            case .none => .none
        }
    }
}

conform[Element: Ord] BTreeSetIterator[Element] to Iterable {
    type Element = Element
    type Iterator = BTreeSetIterator[Element]

    public func iter() -> Self::Iterator { self }
}

conform[Element: Ord] BTreeSet[Element] to Iterable {
    type Element = Element
    type Iterator = BTreeSetIterator[Element]

    public func iter() -> Self::Iterator {
        BTreeSetIterator[Element] { inner: self.map.entries() }
    }
}

conform[Element: Ord] BTreeSet[Element] to Contains[Element] {
    public func contains(_ value: &Element) -> bool {
        self.contains(value)
    }
}

conform[Element: Ord] BTreeSet[Element] to Default {
    public static func default() -> Self { Self::new() }
}

conform[Element: Ord] BTreeSet[Element] to Clone where Element: Clone {
    public func clone() -> Self {
        cloned := BTreeSet[Element]::new()
        for elem in self {
            var _ = cloned.insert(elem.clone())
        }
        return cloned
    }
}

conform[Element: Ord] BTreeSet[Element] to PartialEq {
    public func eq(_ other: Self) -> bool {
        self.map == other.map
    }
}

conform[Element: Ord] BTreeSet[Element] to PartialOrd {
    public func partialCmp(_ other: Self) -> Ordering? {
        .some(self.cmp(other))
    }
}

conform[Element: Ord] BTreeSet[Element] to Ord {
    public func cmp(_ other: Self) -> Ordering {
        self.map.cmp(other.map)
    }
}

conform[Element: Ord] BTreeSet[Element] to FromIterator {
    type Element = Element

    public static func fromIter[I: Iterator[Element = Element]](_ iter: &I) -> Self {
        set := Self::new()
        loop {
            match iter.next() {
                case .some(elem) => { var _ = set.insert(elem) }
                case .none => break
            }
        }
        return set
    }
}

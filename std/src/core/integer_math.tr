        r := self % rhs
        if r < 0 {
            if rhs > 0 { r.wrappingAdd(rhs) } else { r.wrappingSub(rhs) }
        } else {
            r
        }
    }
}

extend uint8 {
    /// Returns the number of `1` bits in `self`.
    @inline public func countOnes() -> uint32 { __intrinsic_ctpop(self) }
    /// Returns the number of `0` bits in `self`.
    @inline public func countZeros() -> uint32 { __intrinsic_ctpop(~self) }
    /// Returns the number of leading `0` bits (returns `Self::BITS` for `0`).
    @inline public func leadingZeros() -> uint32 { __intrinsic_ctlz(self) }
    /// Returns the number of trailing `0` bits (returns `Self::BITS` for `0`).
    @inline public func trailingZeros() -> uint32 { __intrinsic_cttz(self) }
    /// Returns the number of leading `1` bits.
    @inline public func leadingOnes() -> uint32 { __intrinsic_ctlz(~self) }
    /// Returns the number of trailing `1` bits.
    @inline public func trailingOnes() -> uint32 { __intrinsic_cttz(~self) }
    /// Rotates the bits of `self` left by `n mod Self::BITS`.
    @inline public func rotateLeft(_ n: uint32) -> uint8 { __intrinsic_fshl(self, self, n) }
    /// Rotates the bits of `self` right by `n mod Self::BITS`.
    @inline public func rotateRight(_ n: uint32) -> uint8 { __intrinsic_fshr(self, self, n) }
    /// Reverses the byte order of `self` (no-op for `uint8`).
    @inline public func swapBytes() -> uint8 { __intrinsic_bswap(self) }
    /// Reverses the bit order of `self`.
    @inline public func reverseBits() -> uint8 { __intrinsic_bitreverse(self) }

    /// Returns `true` if `self` is a power of two (`1, 2, 4, ...`).
    @inline public func isPowerOfTwo() -> bool {
        self != 0 && (self & self.wrappingSub(1)) == 0
    }

    /// Returns the smallest power of two `>= self`, or `.none` on overflow.
    public func checkedNextPowerOfTwo() -> uint8? {
        if self <= 1 {
            return .some(1)
        }
        lz := (self - 1).leadingZeros()
        if lz == 0 {
            return .none
        }
        shift := (Self::BITS - lz) as uint8
        return .some((1 as uint8) << shift)
    }

    /// Returns the smallest power of two `>= self`, panicking on overflow.
    public func nextPowerOfTwo() -> uint8 {
        match self.checkedNextPowerOfTwo() {
            case .some(v) => v
            case .none => panic("nextPowerOfTwo overflow")
        }
    }

    /// Returns the base-2 logarithm of `self`, rounded down. Panics if `self == 0`.
    public func ilog2() -> uint32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive")
        }
        (Self::BITS - 1) - self.leadingZeros()
    }

    /// Raises `self` to `exp`, wrapping on overflow.
    public func wrappingPow(_ exp: uint32) -> uint8 {
        var base = self
        var power = exp
        var acc: uint8 = 1
        while power > 0 {
            if (power & 1) != 0 {
                acc = acc.wrappingMul(base)
            }
            power = power >> 1
            if power > 0 {
                base = base.wrappingMul(base)
            }
        }
        acc
    }

    /// Raises `self` to `exp`, returning `.none` on overflow.
    public func checkedPow(_ exp: uint32) -> uint8? {
        var base = self
        var power = exp
        var acc: uint8 = 1
        while power > 0 {
            if (power & 1) != 0 {
                match acc.checkedMul(base) {
                    case .some(v) => acc = v
                    case .none => return .none
                }
            }
            power = power >> 1
            if power > 0 {
                match base.checkedMul(base) {
                    case .some(v) => base = v
                    case .none => return .none
                }
            }
        }
        return .some(acc)
    }

    /// Raises `self` to `exp`, panicking on overflow.
    public func pow(_ exp: uint32) -> uint8 {
        match self.checkedPow(exp) {
            case .some(v) => v
            case .none => panic("attempt to multiply with overflow")
        }
    }

    /// Euclidean division (`self / rhs`), panicking when `rhs == 0`.
    @inline public func divEuclid(_ rhs: uint8) -> uint8 {
        if rhs == 0 {
            panic("attempt to divide by zero")
        }
        self / rhs
    }

    /// Euclidean remainder (`self % rhs`), panicking when `rhs == 0`.
    @inline public func remEuclid(_ rhs: uint8) -> uint8 {
        if rhs == 0 {
            panic("attempt to calculate the remainder with a divisor of zero")
        }
        self % rhs
    }
}


import std::panic::panic
import std::intrinsic::{
    __intrinsic_ctpop,
    __intrinsic_ctlz,
    __intrinsic_cttz,
    __intrinsic_bswap,
    __intrinsic_bitreverse,
    __intrinsic_fshl,
    __intrinsic_fshr,
}

@inline internal func checkedInt8Abs(_ value: int8) -> int8 {
    if value == int8::MIN {
        panic("attempt to negate with overflow")
    }
    if value < 0 { (0 as int8).wrappingSub(value) } else { value }
}

@inline internal func checkedInt16Abs(_ value: int16) -> int16 {
    if value == int16::MIN {
        panic("attempt to negate with overflow")
    }
    if value < 0 { (0 as int16).wrappingSub(value) } else { value }
}

@inline internal func checkedInt32Abs(_ value: int32) -> int32 {
    if value == int32::MIN {
        panic("attempt to negate with overflow")
    }
    if value < 0 { (0 as int32).wrappingSub(value) } else { value }
}

@inline internal func checkedInt64Abs(_ value: int64) -> int64 {
    if value == int64::MIN {
        panic("attempt to negate with overflow")
    }
    if value < 0 { (0 as int64).wrappingSub(value) } else { value }
}

@inline internal func checkedIsizeAbs(_ value: isize) -> isize {
    if value == isize::MIN {
        panic("attempt to negate with overflow")
    }
    if value < 0 { (0 as isize).wrappingSub(value) } else { value }
}

// Bit-manipulation and integer math methods across all fixed-width and
// pointer-sized integer types. Bit counts, rotations, byte-swaps, and bit
// reversals lower directly to LLVM scalar intrinsics; checked/Euclidean
// routines guard overflow explicitly so debug and release builds share
// deterministic trap semantics.

extend int8 {
    /// Returns the number of `1` bits in the two's-complement representation of `self`.
    @inline public func countOnes() -> uint32 { __intrinsic_ctpop(self) }
    /// Returns the number of `0` bits in the two's-complement representation of `self`.
    @inline public func countZeros() -> uint32 { __intrinsic_ctpop(~self) }
    /// Returns the number of leading `0` bits (returns `Self::BITS` for `0`).
    @inline public func leadingZeros() -> uint32 { __intrinsic_ctlz(self) }
    /// Returns the number of trailing `0` bits (returns `Self::BITS` for `0`).
    @inline public func trailingZeros() -> uint32 { __intrinsic_cttz(self) }
    /// Returns the number of leading `1` bits.
    @inline public func leadingOnes() -> uint32 { __intrinsic_ctlz(~self) }
    /// Returns the number of trailing `1` bits.
    @inline public func trailingOnes() -> uint32 { __intrinsic_cttz(~self) }
    /// Rotates the bits of `self` left by `n mod Self::BITS`.
    @inline public func rotateLeft(_ n: uint32) -> int8 { __intrinsic_fshl(self, self, n) }
    /// Rotates the bits of `self` right by `n mod Self::BITS`.
    @inline public func rotateRight(_ n: uint32) -> int8 { __intrinsic_fshr(self, self, n) }
    /// Reverses the byte order of `self` (no-op for `int8`).
    @inline public func swapBytes() -> int8 { __intrinsic_bswap(self) }
    /// Reverses the bit order of `self`.
    @inline public func reverseBits() -> int8 { __intrinsic_bitreverse(self) }

    /// Returns the absolute value of `self`, panicking on `int8::MIN`.
    @inline public func abs() -> int8 {
        if self == Self::MIN {
            panic("attempt to negate with overflow")
        }
        if self < 0 { (0 as int8).wrappingSub(self) } else { self }
    }

    /// Returns the wrapping absolute value of `self` (`int8::MIN` wraps to `int8::MIN`).
    @inline public func wrappingAbs() -> int8 {
        if self < 0 { (0 as int8).wrappingSub(self) } else { self }
    }

    /// Returns the exact magnitude of `self` as `uint8`. Never overflows.
    @inline public func unsignedAbs() -> uint8 {
        if self < 0 { (0 as uint8).wrappingSub(self as uint8) } else { self as uint8 }
    }

    /// Returns `-1` if `self < 0`, `0` if `self == 0`, or `1` if `self > 0`.
    @inline public func signum() -> int8 {
        if self > 0 { 1 } else if self < 0 { -1 } else { 0 }
    }

    /// Raises `self` to `exp`, wrapping on overflow.
    public func wrappingPow(_ exp: uint32) -> int8 {
        var base = self
        var power = exp
        var acc: int8 = 1
        while power > 0 {
            if (power & 1) != 0 {
                acc = acc.wrappingMul(base)
            }
            power = power >> 1
            if power > 0 {
                base = base.wrappingMul(base)
            }
        }
        acc
    }

    /// Raises `self` to `exp`, returning `.none` on overflow.
    public func checkedPow(_ exp: uint32) -> int8? {
        var base = self
        var power = exp
        var acc: int8 = 1
        while power > 0 {
            if (power & 1) != 0 {
                match acc.checkedMul(base) {
                    case .some(v) => acc = v
                    case .none => return .none
                }
            }
            power = power >> 1
            if power > 0 {
                match base.checkedMul(base) {
                    case .some(v) => base = v
                    case .none => return .none
                }
            }
        }
        return .some(acc)
    }

    /// Raises `self` to `exp`, panicking on overflow.
    public func pow(_ exp: uint32) -> int8 {
        match self.checkedPow(exp) {
            case .some(v) => v
            case .none => panic("attempt to multiply with overflow")
        }
    }

    /// Euclidean division satisfying `self == q * rhs + r` with `0 <= r < |rhs|`.
    public func divEuclid(_ rhs: int8) -> int8 {
        if rhs == 0 {
            panic("attempt to divide by zero")
        }
        if self == Self::MIN && rhs == -1 {
            panic("attempt to divide with overflow")
        }
        q := self / rhs
        r := self % rhs
        if r < 0 {
            if rhs > 0 { q - 1 } else { q + 1 }
        } else {
            q
        }
    }

    /// Euclidean remainder satisfying `0 <= r < |rhs|`.
    public func remEuclid(_ rhs: int8) -> int8 {
        if rhs == 0 {
            panic("attempt to calculate the remainder with a divisor of zero")
        }
        if self == Self::MIN && rhs == -1 {
            panic("attempt to calculate the remainder with overflow")
        }
        r := self % rhs
        if r < 0 {
            if rhs > 0 { r.wrappingAdd(rhs) } else { r.wrappingSub(rhs) }
        } else {
            r
        }
    }
}


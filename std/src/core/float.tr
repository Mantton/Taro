extern "taro_rt" {
    func __rt__parse_f32(_ input: string, _ bitsOut: *mut uint32) -> uint8
    func __rt__parse_f64(_ input: string, _ bitsOut: *mut uint64) -> uint8
}

const FLOAT_PARSE_OK: uint8 = 0
const FLOAT_PARSE_INVALID: uint8 = 1
const FLOAT_PARSE_OVERFLOW: uint8 = 2
const FLOAT_PARSE_UNDERFLOW: uint8 = 3

func isDecimalDigit(_ byte: uint8) -> bool {
    byte >= ('0' as uint8) && byte <= ('9' as uint8)
}

/// Validate the locale-independent decimal grammar before entering the
/// runtime's correctly-rounded IEEE conversion routine.
func validateFloatSyntax(_ input: string) -> Result[(), ParseError] {
    len := std::string::stringLen(input)
    if len == 0 {
        return .err(ParseError::new(.empty, 0 as usize))
    }

    data := std::string::stringData(input)
    var index: usize = 0
    if unsafe { data.read() } == ('+' as uint8) || unsafe { data.read() } == ('-' as uint8) {
        index += 1
        if index == len {
            return .err(ParseError::new(.invalidFormat, index))
        }
    }

    significandStart := index
    var hasDigit = false
    while index < len && isDecimalDigit(unsafe { data.add(index).read() }) {
        hasDigit = true
        index += 1
    }

    if index < len && unsafe { data.add(index).read() } == ('.' as uint8) {
        index += 1
        while index < len && isDecimalDigit(unsafe { data.add(index).read() }) {
            hasDigit = true
            index += 1
        }
    }

    if !hasDigit {
        return .err(ParseError::new(.invalidFormat, significandStart))
    }

    if index < len {
        byte := unsafe { data.add(index).read() }
        if byte == ('e' as uint8) || byte == ('E' as uint8) {
            index += 1
            if index < len {
                exponentSign := unsafe { data.add(index).read() }
                if exponentSign == ('+' as uint8) || exponentSign == ('-' as uint8) {
                    index += 1
                }
            }

            exponentStart := index
            while index < len && isDecimalDigit(unsafe { data.add(index).read() }) {
                index += 1
            }
            if index == exponentStart {
                return .err(ParseError::new(.invalidFormat, exponentStart))
            }
        }
    }

    if index != len {
        return .err(ParseError::new(.invalidFormat, index))
    }
    return .ok(())
}

func floatRangeErrorIndex(_ input: string) -> usize {
    std::string::stringLen(input) - (1 as usize)
}

func parseFloat(_ input: string) -> Result[float, ParseError] {
    match validateFloatSyntax(input) {
        case .ok(_) => {}
        case .err(error) => return .err(error)
    }

    var bits: uint32 = 0
    status := __rt__parse_f32(input, unsafe { &bits as *mut uint32 })
    if status == FLOAT_PARSE_OK {
        return .ok(floatFromBits(bits))
    }
    if status == FLOAT_PARSE_OVERFLOW {
        return .err(ParseError::new(.overflow, floatRangeErrorIndex(input)))
    }
    if status == FLOAT_PARSE_UNDERFLOW {
        return .err(ParseError::new(.underflow, floatRangeErrorIndex(input)))
    }
    if status == FLOAT_PARSE_INVALID {
        return .err(ParseError::new(.invalidFormat, 0 as usize))
    }
    return .err(ParseError::new(.invalidFormat, 0 as usize))
}

func parseDouble(_ input: string) -> Result[double, ParseError] {
    match validateFloatSyntax(input) {
        case .ok(_) => {}
        case .err(error) => return .err(error)
    }

    var bits: uint64 = 0
    status := __rt__parse_f64(input, unsafe { &bits as *mut uint64 })
    if status == FLOAT_PARSE_OK {
        return .ok(doubleFromBits(bits))
    }
    if status == FLOAT_PARSE_OVERFLOW {
        return .err(ParseError::new(.overflow, floatRangeErrorIndex(input)))
    }
    if status == FLOAT_PARSE_UNDERFLOW {
        return .err(ParseError::new(.underflow, floatRangeErrorIndex(input)))
    }
    if status == FLOAT_PARSE_INVALID {
        return .err(ParseError::new(.invalidFormat, 0 as usize))
    }
    return .err(ParseError::new(.invalidFormat, 0 as usize))
}

internal func floatToBits(_ value: float) -> uint32 {
    bitsPtr := unsafe { (&value as *const float) as *const uint32 }
    unsafe { bitsPtr.read() }
}

func floatFromBits(_ bits: uint32) -> float {
    valuePtr := unsafe { (&bits as *const uint32) as *const float }
    unsafe { valuePtr.read() }
}

internal func doubleToBits(_ value: double) -> uint64 {
    bitsPtr := unsafe { (&value as *const double) as *const uint64 }
    unsafe { bitsPtr.read() }
}

func doubleFromBits(_ bits: uint64) -> double {
    valuePtr := unsafe { (&bits as *const uint64) as *const double }
    unsafe { valuePtr.read() }
}

extend float {
    /// Positive infinity (`+∞`).
    public const INFINITY: float = (1.0e308 * 10.0) as float
    /// Negative infinity (`-∞`).
    public const NEG_INFINITY: float = -(1.0e308 * 10.0) as float
    /// Quiet Not a Number (`NaN`).
    public const NAN: float = ((1.0e308 * 10.0) - (1.0e308 * 10.0)) as float
    /// Smallest finite `float` value (`-3.40282347e+38`).
    public const MIN: float = -3.4028234663852886e38
    /// Largest finite `float` value (`3.40282347e+38`).
    public const MAX: float = 3.4028234663852886e38
    /// Machine epsilon (`2^-23`): difference between `1.0` and the next representable `float`.
    public const EPSILON: float = 1.1920928955078125e-7

    /// Parse a finite decimal value using locale-independent IEEE-754 rounding.
    public static func parse(_ input: string) -> Result[float, ParseError] { parseFloat(input) }

    /// Returns the raw IEEE-754 bit pattern of `self`.
    @inline public func toBits() -> uint32 { floatToBits(self) }
    /// Reinterprets raw IEEE-754 bits as a `float`.
    @inline public static func fromBits(_ bits: uint32) -> float { floatFromBits(bits) }
    /// Returns `true` if `self` is `NaN`.
    @inline public func isNaN() -> bool { self != self }
    /// Returns `true` if `self` is positive or negative infinity.
    @inline public func isInfinite() -> bool { self == Self::INFINITY || self == Self::NEG_INFINITY }
    /// Returns `true` if `self` is neither `NaN` nor infinite.
    @inline public func isFinite() -> bool { self.abs() < Self::INFINITY }
    /// Restricts `self` to `[low, high]`. Panics if `low` or `high` is `NaN` or `low > high`.
    public func clamp(_ low: float, _ high: float) -> float {
        if low.isNaN() || high.isNaN() || low > high {
            panic("clamp: low bound must not be NaN or greater than high bound")
        }
        if self < low {
            low
        } else if self > high {
            high
        } else {
            self
        }
    }

    public func sqrt() -> float { unsafe { __intrinsic_sqrt_f32(self) } }
    public func sin() -> float { unsafe { __intrinsic_sin_f32(self) } }
    public func cos() -> float { unsafe { __intrinsic_cos_f32(self) } }
    public func tan() -> float { unsafe { __intrinsic_tan_f32(self) } }
    public func asin() -> float { unsafe { __intrinsic_asin_f32(self) } }
    public func acos() -> float { unsafe { __intrinsic_acos_f32(self) } }
    public func atan() -> float { unsafe { __intrinsic_atan_f32(self) } }
    public func sinh() -> float { unsafe { __intrinsic_sinh_f32(self) } }
    public func cosh() -> float { unsafe { __intrinsic_cosh_f32(self) } }
    public func tanh() -> float { unsafe { __intrinsic_tanh_f32(self) } }
    public func exp() -> float { unsafe { __intrinsic_exp_f32(self) } }
    public func exp2() -> float { unsafe { __intrinsic_exp2_f32(self) } }
    public func log() -> float { unsafe { __intrinsic_log_f32(self) } }
    public func log2() -> float { unsafe { __intrinsic_log2_f32(self) } }
    public func log10() -> float { unsafe { __intrinsic_log10_f32(self) } }
    public func abs() -> float { unsafe { __intrinsic_fabs_f32(self) } }
    public func floor() -> float { unsafe { __intrinsic_floor_f32(self) } }
    public func ceil() -> float { unsafe { __intrinsic_ceil_f32(self) } }
    public func trunc() -> float { unsafe { __intrinsic_trunc_f32(self) } }
    public func rint() -> float { unsafe { __intrinsic_rint_f32(self) } }
    public func nearbyint() -> float { unsafe { __intrinsic_nearbyint_f32(self) } }
    public func round() -> float { unsafe { __intrinsic_round_f32(self) } }
    public func roundeven() -> float { unsafe { __intrinsic_roundeven_f32(self) } }
    public func pow(_ y: float) -> float { unsafe { __intrinsic_pow_f32(self, y) } }
    public func powi(_ y: int32) -> float { unsafe { __intrinsic_powi_f32_i32(self, y) } }
    public func copysign(_ y: float) -> float { unsafe { __intrinsic_copysign_f32(self, y) } }
    public func fma(_ y: float, _ z: float) -> float { unsafe { __intrinsic_fma_f32(self, y, z) } }
    public func minimum(_ y: float) -> float { unsafe { __intrinsic_minimum_f32(self, y) } }
    public func maximum(_ y: float) -> float { unsafe { __intrinsic_maximum_f32(self, y) } }
    public func minimumnum(_ y: float) -> float { unsafe { __intrinsic_minimumnum_f32(self, y) } }
    public func maximumnum(_ y: float) -> float { unsafe { __intrinsic_maximumnum_f32(self, y) } }
}

conform float to Hashable {
    public func hash[H: Hasher](into hasher: H) {
        // Match equality contract: +0.0 == -0.0, so they must hash equally.
        var bits: uint32 = if self == (0.0 as float) {
            0_u32
        } else {
            floatToBits(self)
        }
        hashU32(hasher, bits)
    }
}

conform float to PartialEq {
    public func eq(_ other: float) -> bool { self == other }
}

// Floats only implement PartialOrd, not Ord, because NaN != NaN
conform float to PartialOrd {
    public func partialCmp(_ other: float) -> Optional[Ordering] {
        // NaN comparisons return none
        if self < other {
            .some(.less)
        } else if self == other {
            .some(.equal)
        } else if self > other {
            .some(.greater)
        } else {
            .none  // One or both are NaN
        }
    }
}

conform double to Hashable {
    public func hash[H: Hasher](into hasher: H) {
        // Match equality contract: +0.0 == -0.0, so they must hash equally.
        var bits: uint64 = if self == (0.0 as double) {
            0_u64
        } else {
            doubleToBits(self)
        }
        hashU64(hasher, bits)
    }
}

conform double to PartialEq {
    public func eq(_ other: double) -> bool { self == other }
}

// Doubles only implement PartialOrd, not Ord, because NaN != NaN
conform double to PartialOrd {
    public func partialCmp(_ other: double) -> Optional[Ordering] {
        // NaN comparisons return none
        if self < other {
            .some(.less)
        } else if self == other {
            .some(.equal)
        } else if self > other {
            .some(.greater)
        } else {
            .none  // One or both are NaN
        }
    }
}

extend double {
    /// Positive infinity (`+∞`).
    public const INFINITY: double = 1.0e308 * 10.0
    /// Negative infinity (`-∞`).
    public const NEG_INFINITY: double = -(1.0e308 * 10.0)
    /// Quiet Not a Number (`NaN`).
    public const NAN: double = (1.0e308 * 10.0) - (1.0e308 * 10.0)
    /// Smallest finite `double` value (`-1.7976931348623157e+308`).
    public const MIN: double = -1.7976931348623157e308
    /// Largest finite `double` value (`1.7976931348623157e+308`).
    public const MAX: double = 1.7976931348623157e308
    /// Machine epsilon (`2^-52`): difference between `1.0` and the next representable `double`.
    public const EPSILON: double = 2.220446049250313e-16

    /// Parse a finite decimal value using locale-independent IEEE-754 rounding.
    public static func parse(_ input: string) -> Result[double, ParseError] { parseDouble(input) }

    /// Returns the raw IEEE-754 bit pattern of `self`.
    @inline public func toBits() -> uint64 { doubleToBits(self) }
    /// Reinterprets raw IEEE-754 bits as a `double`.
    @inline public static func fromBits(_ bits: uint64) -> double { doubleFromBits(bits) }
    /// Returns `true` if `self` is `NaN`.
    @inline public func isNaN() -> bool { self != self }
    /// Returns `true` if `self` is positive or negative infinity.
    @inline public func isInfinite() -> bool { self == Self::INFINITY || self == Self::NEG_INFINITY }
    /// Returns `true` if `self` is neither `NaN` nor infinite.
    @inline public func isFinite() -> bool { self.abs() < Self::INFINITY }
    /// Restricts `self` to `[low, high]`. Panics if `low` or `high` is `NaN` or `low > high`.
    public func clamp(_ low: double, _ high: double) -> double {
        if low.isNaN() || high.isNaN() || low > high {
            panic("clamp: low bound must not be NaN or greater than high bound")
        }
        if self < low {
            low
        } else if self > high {
            high
        } else {
            self
        }
    }

    public func sqrt() -> double { unsafe { __intrinsic_sqrt_f64(self) } }
    public func sin() -> double { unsafe { __intrinsic_sin_f64(self) } }
    public func cos() -> double { unsafe { __intrinsic_cos_f64(self) } }
    public func tan() -> double { unsafe { __intrinsic_tan_f64(self) } }
    public func asin() -> double { unsafe { __intrinsic_asin_f64(self) } }
    public func acos() -> double { unsafe { __intrinsic_acos_f64(self) } }
    public func atan() -> double { unsafe { __intrinsic_atan_f64(self) } }
    public func sinh() -> double { unsafe { __intrinsic_sinh_f64(self) } }
    public func cosh() -> double { unsafe { __intrinsic_cosh_f64(self) } }
    public func tanh() -> double { unsafe { __intrinsic_tanh_f64(self) } }
    public func exp() -> double { unsafe { __intrinsic_exp_f64(self) } }
    public func exp2() -> double { unsafe { __intrinsic_exp2_f64(self) } }
    public func log() -> double { unsafe { __intrinsic_log_f64(self) } }
    public func log2() -> double { unsafe { __intrinsic_log2_f64(self) } }
    public func log10() -> double { unsafe { __intrinsic_log10_f64(self) } }
    public func abs() -> double { unsafe { __intrinsic_fabs_f64(self) } }
    public func floor() -> double { unsafe { __intrinsic_floor_f64(self) } }
    public func ceil() -> double { unsafe { __intrinsic_ceil_f64(self) } }
    public func trunc() -> double { unsafe { __intrinsic_trunc_f64(self) } }
    public func rint() -> double { unsafe { __intrinsic_rint_f64(self) } }
    public func nearbyint() -> double { unsafe { __intrinsic_nearbyint_f64(self) } }
    public func round() -> double { unsafe { __intrinsic_round_f64(self) } }
    public func roundeven() -> double { unsafe { __intrinsic_roundeven_f64(self) } }
    public func pow(_ y: double) -> double { unsafe { __intrinsic_pow_f64(self, y) } }
    public func powi(_ y: int32) -> double { unsafe { __intrinsic_powi_f64_i32(self, y) } }
    public func copysign(_ y: double) -> double { unsafe { __intrinsic_copysign_f64(self, y) } }
    public func fma(_ y: double, _ z: double) -> double { unsafe { __intrinsic_fma_f64(self, y, z) } }
    public func minimum(_ y: double) -> double { unsafe { __intrinsic_minimum_f64(self, y) } }
    public func maximum(_ y: double) -> double { unsafe { __intrinsic_maximum_f64(self, y) } }
    public func minimumnum(_ y: double) -> double { unsafe { __intrinsic_minimumnum_f64(self, y) } }
    public func maximumnum(_ y: double) -> double { unsafe { __intrinsic_maximumnum_f64(self, y) } }
}

conform float to Parse {
    public static func parse(_ input: string) -> Result[float, ParseError] {
        parseFloat(input)
    }
}

conform double to Parse {
    public static func parse(_ input: string) -> Result[double, ParseError] {
        parseDouble(input)
    }
}

// Default: zero.
conform float to Default {
    public static func default() -> float { 0.0 }
}

conform double to Default {
    public static func default() -> double { 0.0 }
}

// Numeric conformances for primitive floats (built on builtin operator witnesses).

conform float to Numeric {
    @inline public static func zero() -> float { 0.0 }
    @inline public static func one() -> float { 1.0 }
}
conform float to SignedNumeric {
    @inline public func abs() -> float { unsafe { __intrinsic_fabs_f32(self) } }
}

conform double to Numeric {
    @inline public static func zero() -> double { 0.0 }
    @inline public static func one() -> double { 1.0 }
}
conform double to SignedNumeric {
    @inline public func abs() -> double { unsafe { __intrinsic_fabs_f64(self) } }
}

extend isize {
    /// The smallest value representable by `isize`.
    public const MIN: isize = ~((~(0 as usize) >> 1) as isize)
    /// The largest value representable by `isize`.
    public const MAX: isize = (~(0 as usize) >> 1) as isize
    /// The size of `isize` in bits (`32` or `64`).
    public const BITS: uint32 = if (~(0 as usize) >> 31) > 1 { 64 } else { 32 }

    /// Returns `self + rhs`, or `.none` when the sum does not fit `isize`.
    public func checkedAdd(_ rhs: isize) -> isize? {
        if __intrinsic_overflows_add(self, rhs) {
            return .none

        return .some(__intrinsic_wrapping_add(self, rhs))
    }

    /// Returns `self - rhs`, or `.none` when the difference does not fit `isize`.
    public func checkedSub(_ rhs: isize) -> isize? {
        if __intrinsic_overflows_sub(self, rhs) {
            return .none

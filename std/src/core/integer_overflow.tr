import std::intrinsic::{
    __intrinsic_wrapping_add,
    __intrinsic_wrapping_sub,
    __intrinsic_wrapping_mul,
    __intrinsic_overflows_add,
    __intrinsic_overflows_sub,
    __intrinsic_overflows_mul,
}

// Overflow-tolerant integer arithmetic. The bodies use compiler intrinsics
// instead of `+`, `-` and `*`, so they never trap, even when inlined or
// specialized into a package compiled with overflow checks. Saturating
// results reach the bounds through comparisons only.

const INT8_MIN: int8 = -128
const INT8_MAX: int8 = 127
const INT16_MIN: int16 = -32768
const INT16_MAX: int16 = 32767
const INT32_MIN: int32 = -2147483648
const INT32_MAX: int32 = 2147483647
const INT64_MIN: int64 = -9223372036854775808
const INT64_MAX: int64 = 9223372036854775807
const ISIZE_MAX: isize = (~(0 as usize) >> 1) as isize
const ISIZE_MIN: isize = ~ISIZE_MAX
const UINT8_MAX: uint8 = 255
const UINT16_MAX: uint16 = 65535
const UINT32_MAX: uint32 = 4294967295
const UINT64_MAX: uint64 = 18446744073709551615
const USIZE_MAX: usize = ~(0 as usize)

extend int8 {
    /// The smallest value representable by `int8` (`-128`).
    public const MIN: int8 = -128
    /// The largest value representable by `int8` (`127`).
    public const MAX: int8 = 127
    /// The size of `int8` in bits (`8`).
    public const BITS: uint32 = 8

    /// Returns `self + rhs`, or `.none` when the sum does not fit `int8`.
    public func checkedAdd(_ rhs: int8) -> int8? {
        if __intrinsic_overflows_add(self, rhs) {
            return .none
        }
        return .some(__intrinsic_wrapping_add(self, rhs))
    }

    /// Returns `self - rhs`, or `.none` when the difference does not fit `int8`.
    public func checkedSub(_ rhs: int8) -> int8? {
        if __intrinsic_overflows_sub(self, rhs) {
            return .none
        }
        return .some(__intrinsic_wrapping_sub(self, rhs))
    }

    /// Returns `self * rhs`, or `.none` when the product does not fit `int8`.
    public func checkedMul(_ rhs: int8) -> int8? {
        if __intrinsic_overflows_mul(self, rhs) {
            return .none
        }
        return .some(__intrinsic_wrapping_mul(self, rhs))
    }

    /// Returns `self + rhs` modulo 2^N. Never traps.
    public func wrappingAdd(_ rhs: int8) -> int8 {
        __intrinsic_wrapping_add(self, rhs)
    }

    /// Returns `self - rhs` modulo 2^N. Never traps.
    public func wrappingSub(_ rhs: int8) -> int8 {
        __intrinsic_wrapping_sub(self, rhs)
    }

    /// Returns `self * rhs` modulo 2^N. Never traps.
    public func wrappingMul(_ rhs: int8) -> int8 {
        __intrinsic_wrapping_mul(self, rhs)
    }

    /// Returns `self + rhs`, clamped to the range of `int8`.
    public func saturatingAdd(_ rhs: int8) -> int8 {
        if !__intrinsic_overflows_add(self, rhs) {
            return __intrinsic_wrapping_add(self, rhs)
        }
        if rhs < 0 { INT8_MIN } else { INT8_MAX }
    }

    /// Returns `self - rhs`, clamped to the range of `int8`.
    public func saturatingSub(_ rhs: int8) -> int8 {
        if !__intrinsic_overflows_sub(self, rhs) {
            return __intrinsic_wrapping_sub(self, rhs)
        }
        if rhs < 0 { INT8_MAX } else { INT8_MIN }
    }

    /// Returns `self * rhs`, clamped to the range of `int8`.
    public func saturatingMul(_ rhs: int8) -> int8 {
        if !__intrinsic_overflows_mul(self, rhs) {
            return __intrinsic_wrapping_mul(self, rhs)
        }
        if (self < 0) != (rhs < 0) { INT8_MIN } else { INT8_MAX }
    }
}


    /// Returns `self + rhs`, clamped to the range of `uint8`.
    public func saturatingAdd(_ rhs: uint8) -> uint8 {
        if !__intrinsic_overflows_add(self, rhs) {
            return __intrinsic_wrapping_add(self, rhs)
        }
        UINT8_MAX
    }

    /// Returns `self - rhs`, clamped to the range of `uint8`.
    public func saturatingSub(_ rhs: uint8) -> uint8 {
        if !__intrinsic_overflows_sub(self, rhs) {
            return __intrinsic_wrapping_sub(self, rhs)
        }
        0
    }

    /// Returns `self * rhs`, clamped to the range of `uint8`.
    public func saturatingMul(_ rhs: uint8) -> uint8 {
        if !__intrinsic_overflows_mul(self, rhs) {
            return __intrinsic_wrapping_mul(self, rhs)
        }
        UINT8_MAX
    }
}


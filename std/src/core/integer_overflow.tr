    /// The smallest value representable by `usize` (`0`).
    public const MIN: usize = 0
    /// The largest value representable by `usize`.
    public const MAX: usize = ~(0 as usize)
    /// The size of `usize` in bits (`32` or `64`).
    public const BITS: uint32 = if (~(0 as usize) >> 31) > 1 { 64 } else { 32 }

    /// Returns `self + rhs`, or `.none` when the sum does not fit `usize`.
    public func checkedAdd(_ rhs: usize) -> usize? {
        if __intrinsic_overflows_add(self, rhs) {
            return .none
        }
        return .some(__intrinsic_wrapping_add(self, rhs))
    }

    /// Returns `self - rhs`, or `.none` when the difference does not fit `usize`.
    public func checkedSub(_ rhs: usize) -> usize? {
        if __intrinsic_overflows_sub(self, rhs) {
            return .none
        }
        return .some(__intrinsic_wrapping_sub(self, rhs))
    }

    /// Returns `self * rhs`, or `.none` when the product does not fit `usize`.
    public func checkedMul(_ rhs: usize) -> usize? {
        if __intrinsic_overflows_mul(self, rhs) {
            return .none
        }
        return .some(__intrinsic_wrapping_mul(self, rhs))
    }

    /// Returns `self + rhs` modulo 2^N. Never traps.
    public func wrappingAdd(_ rhs: usize) -> usize {
        __intrinsic_wrapping_add(self, rhs)
    }

    /// Returns `self - rhs` modulo 2^N. Never traps.
    public func wrappingSub(_ rhs: usize) -> usize {
        __intrinsic_wrapping_sub(self, rhs)
    }

    /// Returns `self * rhs` modulo 2^N. Never traps.
    public func wrappingMul(_ rhs: usize) -> usize {
        __intrinsic_wrapping_mul(self, rhs)
    }

    /// Returns `self + rhs`, clamped to the range of `usize`.
    public func saturatingAdd(_ rhs: usize) -> usize {
        if !__intrinsic_overflows_add(self, rhs) {
            return __intrinsic_wrapping_add(self, rhs)
        }
        USIZE_MAX
    }

    /// Returns `self - rhs`, clamped to the range of `usize`.
    public func saturatingSub(_ rhs: usize) -> usize {
        if !__intrinsic_overflows_sub(self, rhs) {
            return __intrinsic_wrapping_sub(self, rhs)
        }
        0
    }

    /// Returns `self * rhs`, clamped to the range of `usize`.
    public func saturatingMul(_ rhs: usize) -> usize {
        if !__intrinsic_overflows_mul(self, rhs) {
            return __intrinsic_wrapping_mul(self, rhs)
        }
        USIZE_MAX
    }
}

import std::hash::{Hashable, Hasher}
import std::ops::PartialEq
import std::cmp::{Ordering, PartialOrd, Ord}
import std::optional::Optional
import std::convert::{Parse, ParseError}
import std::result::Result

func parseRune(_ input: string) -> Result[rune, ParseError] {
    len := std::string::stringLen(input)
    if len == 0 {
        return .err(ParseError::new(.empty, 0 as usize))
    }

    var (value, width) = std::string::decodeRune(input, 0 as usize)
    first := unsafe { std::string::stringData(input).read() }
    if width == 1 && first >= 0x80_u8 {
        return .err(ParseError::new(.invalidFormat, 0 as usize))
    }
    if width != len {
        return .err(ParseError::new(.invalidFormat, width))
    }
    return .ok(value)
}

conform rune to Hashable {
    public func hash[H: Hasher](into hasher: H) {
        var value: uint32 = self as uint32
        var bytes: [uint8; 4] = [
            (value & 0xff_u32) as uint8,
            ((value >> 8) & 0xff_u32) as uint8,
            ((value >> 16) & 0xff_u32) as uint8,
            ((value >> 24) & 0xff_u32) as uint8,
        ]
        hasher.write(bytes.asSpan())
    }
}

conform rune to PartialEq {
    public func eq(_ other: rune) -> bool { self == other }
}

conform rune to PartialOrd {
    public func partialCmp(_ other: rune) -> Optional[Ordering] {
        .some(self.cmp(other))
    }
}

conform rune to Ord {
    public func cmp(_ other: rune) -> Ordering {
        if self < other {
            .less
        } else if self == other {
            .equal
        } else {
            .greater
        }
    }
}

conform rune to Parse {
    public static func parse(_ input: string) -> Result[rune, ParseError] {
        parseRune(input)
    }
}

extend rune {
    /// Parse exactly one valid UTF-8 scalar value.
    public static func parse(_ input: string) -> Result[rune, ParseError] {
        parseRune(input)
    }
}

import std::hash::{Hashable, Hasher}
import std::ops::PartialEq
import std::cmp::{Ordering, PartialOrd, Ord}
import std::optional::Optional
import std::convert::{Parse, ParseError}
import std::result::Result

func boolLiteralErrorIndex(_ input: string, _ expected: string) -> usize {
    inputLen := std::string::stringLen(input)
    expectedLen := std::string::stringLen(expected)
    inputData := std::string::stringData(input)
    expectedData := std::string::stringData(expected)
    var index: usize = 0
    while index < inputLen && index < expectedLen {
        if unsafe { inputData.add(index).read() } != unsafe { expectedData.add(index).read() } {
            return index
        }
        index += 1
    }
    return index
}

func parseBool(_ input: string) -> Result[bool, ParseError] {
    len := std::string::stringLen(input)
    if len == 0 {
        return .err(ParseError::new(.empty, 0 as usize))
    }
    if input == "true" {
        return .ok(true)
    }
    if input == "false" {
        return .ok(false)
    }

    first := unsafe { std::string::stringData(input).read() }
    index := if first == ('t' as uint8) {
        boolLiteralErrorIndex(input, "true")
    } else if first == ('f' as uint8) {
        boolLiteralErrorIndex(input, "false")
    } else {
        0 as usize
    }
    return .err(ParseError::new(.invalidFormat, index))
}

conform bool to Hashable {
    public func hash[H: Hasher](into hasher: H) {
        var byte: uint8 = if self { 1 } else { 0 }
        var bytes: [uint8; 1] = [byte]
        hasher.write(bytes.asSpan())
    }
}

conform bool to PartialEq {
    public func eq(_ other: bool) -> bool { self == other }
}

conform bool to PartialOrd {
    public func partialCmp(_ other: bool) -> Optional[Ordering] {
        .some(self.cmp(other))
    }
}

// bool ordering: false < true
conform bool to Ord {
    public func cmp(_ other: bool) -> Ordering {
        if self == other {
            .equal
        } else if !self {
            .less  // false < true
        } else {
            .greater
        }
    }
}

conform bool to Parse {
    public static func parse(_ input: string) -> Result[bool, ParseError] {
        parseBool(input)
    }
}

extend bool {
    /// Parse the exact lowercase spelling `true` or `false`.
    public static func parse(_ input: string) -> Result[bool, ParseError] {
        parseBool(input)
    }
}

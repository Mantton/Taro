// Numeric conformances for primitive integers (built on builtin operator witnesses).

conform int8 to Numeric {
    @inline public static func zero() -> int8 { 0 }
    @inline public static func one() -> int8 { 1 }
}
conform int8 to SignedNumeric {
    @inline public func abs() -> int8 { checkedInt8Abs(self) }
}

conform int16 to Numeric {
    @inline public static func zero() -> int16 { 0 }
    @inline public static func one() -> int16 { 1 }
}
conform int16 to SignedNumeric {
    @inline public func abs() -> int16 { checkedInt16Abs(self) }
}

conform int32 to Numeric {
    @inline public static func zero() -> int32 { 0 }
    @inline public static func one() -> int32 { 1 }
}
conform int32 to SignedNumeric {
    @inline public func abs() -> int32 { checkedInt32Abs(self) }
}

conform int64 to Numeric {
    @inline public static func zero() -> int64 { 0 }
    @inline public static func one() -> int64 { 1 }
}
conform int64 to SignedNumeric {
    @inline public func abs() -> int64 { checkedInt64Abs(self) }
}

conform isize to Numeric {
    @inline public static func zero() -> isize { 0 }
    @inline public static func one() -> isize { 1 }
}
conform isize to SignedNumeric {
    @inline public func abs() -> isize { checkedIsizeAbs(self) }
}

conform uint8 to Numeric {

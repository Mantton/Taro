impl Ord for usize {
    public func cmp(&self, _ other: &usize) -> Ordering {
        if *self < *other {
            .less
        } else if *self == *other {
            .equal
        } else {
            .greater
        }
    }
}

impl usize {
    public func checkedAdd(self, _ rhs: usize) -> usize? {
        if self > usizeMax() - rhs {
            return .none
        }
        return .some(self + rhs)
    }

    public func checkedSub(self, _ rhs: usize) -> usize? {
        if self < rhs {
            return .none
        }
        return .some(self - rhs)
    }

    public func checkedMul(self, _ rhs: usize) -> usize? {
        if self == 0 || rhs == 0 {
            return .some(0 as usize)
        }
        if self > usizeMax() / rhs {
            return .none
        }
        return .some(self * rhs)
    }
}

impl Parse for int8 {
    public func parse(_ input: string) -> Result[int8, ParseError] {
        int8.parseRadix(input, 10_u32)
    }
}

impl int8 {
    /// Parse a signed decimal integer.
    public func parse(_ input: string) -> Result[int8, ParseError] {
        int8.parseRadix(input, 10_u32)
    }

    /// Parse a signed integer using an explicit radix from 2 through 36.
    public func parseRadix(_ input: string, _ radix: uint32) -> Result[int8, ParseError] {
        match parseSignedInteger(input, radix, 0x7f_u64, 0x80_u64) {
            case .ok(value) => .ok(value as int8)
            case .err(error) => .err(error)
        }
    }
}


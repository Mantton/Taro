import std.hash.{Hashable, Hasher}
import std.ops.PartialEq
import std.cmp.{Ordering, PartialOrd, Ord}
import std.optional.Optional
import std.convert.{Parse, ParseError, ParseErrorKind}
import std.result.Result

func usizeMax() -> usize {
    0xffffffffffffffff_u64 as usize
}

func integerDigitValue(_ byte: uint8) -> uint32 {
    if byte >= ('0' as uint8) && byte <= ('9' as uint8) {
        return (byte - ('0' as uint8)) as uint32
    }
    if byte >= ('a' as uint8) && byte <= ('z' as uint8) {
        return ((byte - ('a' as uint8)) + 10_u8) as uint32
    }
    if byte >= ('A' as uint8) && byte <= ('Z' as uint8) {
        return ((byte - ('A' as uint8)) + 10_u8) as uint32
    }
    return 0xffffffff_u32
}

func validIntegerRadix(_ radix: uint32) -> bool {
    radix >= 2_u32 && radix <= 36_u32
}

func parseIntegerMagnitude(
    _ input: string,
    _ start: usize,
    _ radix: uint32,
    _ limit: uint64,
    _ rangeKind: ParseErrorKind,
) -> Result[uint64, ParseError] {
    let len = std.string.stringLen(input)
    let data = std.string.stringData(input)
    let base = radix as uint64
    var value: uint64 = 0
    var index = start

    while index < len {
        let digit = integerDigitValue(data.add(index).read())
        if digit >= radix {
            return .err(ParseError(.invalidDigit, index))
        }

        let digitValue = digit as uint64
        if digitValue > limit || value > (limit - digitValue) / base {
            return .err(ParseError(rangeKind, index))
        }

        value = value * base + digitValue
        index += 1
    }

    return .ok(value)
}

func negativeMagnitude(_ magnitude: uint64) -> int64 {
    if magnitude == 0_u64 {
        return 0_i64
    }

    // Form the two's-complement representation without negating int64::MIN.
    return (0xffffffffffffffff_u64 - (magnitude - 1_u64)) as int64
}

func parseSignedInteger(
    _ input: string,
    _ radix: uint32,
    _ positiveLimit: uint64,
    _ negativeLimit: uint64,
) -> Result[int64, ParseError] {
    if !validIntegerRadix(radix) {
        return .err(ParseError(.invalidFormat, 0 as usize))
    }

    let len = std.string.stringLen(input)
    if len == 0 {
        return .err(ParseError(.empty, 0 as usize))
    }

    let data = std.string.stringData(input)
    var index: usize = 0
    var negative = false
    let first = data.read()
    if first == ('+' as uint8) || first == ('-' as uint8) {
        negative = first == ('-' as uint8)
        index = 1
        if index == len {
            return .err(ParseError(.invalidFormat, index))
        }
    }

    let limit = if negative { negativeLimit } else { positiveLimit }
    let rangeKind: ParseErrorKind = if negative { .underflow } else { .overflow }
    match parseIntegerMagnitude(input, index, radix, limit, rangeKind) {
        case .ok(magnitude) => {
            if negative {
                return .ok(negativeMagnitude(magnitude))
            }
            return .ok(magnitude as int64)
        }
        case .err(error) => return .err(error)
    }
}

func parseUnsignedInteger(
    _ input: string,
    _ radix: uint32,
    _ limit: uint64,
) -> Result[uint64, ParseError] {
    if !validIntegerRadix(radix) {
        return .err(ParseError(.invalidFormat, 0 as usize))
    }

    let len = std.string.stringLen(input)
    if len == 0 {
        return .err(ParseError(.empty, 0 as usize))
    }

    let first = std.string.stringData(input).read()
    if first == ('+' as uint8) || first == ('-' as uint8) {
        return .err(ParseError(.invalidFormat, 0 as usize))
    }

    return parseIntegerMagnitude(input, 0 as usize, radix, limit, .overflow)
}

// Hash integers as little-endian bytes for stable, explicit byte feeds.
func hashU8[H: Hasher](_ hasher: &mut H, _ value: uint8) {
    let bytes: [uint8; 1] = [value]
    hasher.write(bytes.asSpan())
}

func hashU16[H: Hasher](_ hasher: &mut H, _ value: uint16) {
    let bytes: [uint8; 2] = [
        (value & 0xff_u16) as uint8,
        ((value >> 8) & 0xff_u16) as uint8,
    ]
    hasher.write(bytes.asSpan())
}

func hashU32[H: Hasher](_ hasher: &mut H, _ value: uint32) {
    let bytes: [uint8; 4] = [
        (value & 0xff_u32) as uint8,
        ((value >> 8) & 0xff_u32) as uint8,
        ((value >> 16) & 0xff_u32) as uint8,
        ((value >> 24) & 0xff_u32) as uint8,
    ]
    hasher.write(bytes.asSpan())
}

func hashU64[H: Hasher](_ hasher: &mut H, _ value: uint64) {
    let bytes: [uint8; 8] = [
        (value & 0xff_u64) as uint8,
        ((value >> 8) & 0xff_u64) as uint8,
        ((value >> 16) & 0xff_u64) as uint8,
        ((value >> 24) & 0xff_u64) as uint8,
        ((value >> 32) & 0xff_u64) as uint8,
        ((value >> 40) & 0xff_u64) as uint8,
        ((value >> 48) & 0xff_u64) as uint8,
        ((value >> 56) & 0xff_u64) as uint8,
    ]
    hasher.write(bytes.asSpan())
}

// int8
impl Hashable for int8 {
    public func hash[H: Hasher](&self, into hasher: &mut H) {
        hashU8(hasher, *self as uint8)
    }
}

impl PartialEq for int8 {
    public func eq(&self, _ other: &int8) -> bool { *self == *other }
}

impl PartialOrd for int8 {
    public func partialCmp(&self, _ other: &int8) -> Optional[Ordering] {
        .some(self.cmp(other))
    }
}

impl Ord for int8 {
    public func cmp(&self, _ other: &int8) -> Ordering {
        if *self < *other {
            .less
        } else if *self == *other {
            .equal
        } else {
            .greater
        }
    }
}


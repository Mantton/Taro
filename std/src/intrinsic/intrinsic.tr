import std::marker::AnyObject
import std::mem::MaybeUninit
import std::ops::{AsyncFn, Fn}
import std::result::Result

extern "taro_intrinsic" {
    // SC scalar atomics. T must be a native integer or raw pointer. Slots must
    // be initialized, naturally aligned and accessed atomically while shared.
    unsafe func __intrinsic_atomic_load[T](_ slot: *const T) -> T
    unsafe func __intrinsic_atomic_store[T](_ slot: *mut T, _ value: T)
    unsafe func __intrinsic_atomic_swap[T](_ slot: *mut T, _ value: T) -> T
    unsafe func __intrinsic_atomic_compare_exchange[T](_ slot: *mut T, _ expected: T, _ desired: T) -> bool
    unsafe func __intrinsic_atomic_add[T](_ slot: *mut T, _ delta: T) -> T

    // Internal projection primitives. Callers guarantee initialized, aligned
    // storage; GC references/pointers retain their managed allocation.
    unsafe func __intrinsic_ref_project[T, U](_ source: &T, _ data: *const U) -> &U
    unsafe func __intrinsic_ref_project_mut[T, U](_ source: &T, _ data: *mut U) -> &U

    func __intrinsic_ptr_add[T](_ ptr: *T, _ count: usize) -> *T
    func __intrinsic_ptr_sub[T](_ ptr: *T, _ count: usize) -> *T
    func __intrinsic_ptr_offset[T](_ ptr: *T, _ count: isize) -> *T
    func __intrinsic_ptr_byte_add[T](_ ptr: *T, _ count: usize) -> *T
    func __intrinsic_ptr_byte_sub[T](_ ptr: *T, _ count: usize) -> *T
    unsafe func __intrinsic_ptr_read[T](_ ptr: *T) -> T
    unsafe func __intrinsic_ptr_write[T](_ ptr: *T, _ val: T)
    // Counts are BYTES. Storage must contain whole, initialized, aligned T
    // elements. For pointer-bearing T, count must be a multiple of the native
    // pointer word; partial pointer copies are invalid. The caller guarantees
    // this for dynamic counts. memcpy also requires nonoverlapping ranges.
    unsafe func __intrinsic_memcpy[T](_ dst: *mut T, _ src: *T, _ count: usize)
    unsafe func __intrinsic_memmove[T](_ dst: *mut T, _ src: *T, _ count: usize)
    unsafe func __intrinsic_memset[T](_ dst: *T, _ val: uint8, _ count: usize)
    func __intrinsic_size_of[T]() -> usize
    func __intrinsic_align_of[T]() -> usize
    func __intrinsic_maybe_uninit[T]() -> MaybeUninit[T]
    func __intrinsic_black_box[T](_ value: T) -> T
    // A liveness use with no runtime effect; see std::runtime::keepAlive.
    func __intrinsic_keep_alive[T](_ value: T)

    // Checked integer arithmetic. The compiler emits calls to these when
    // overflow checks are enabled; they panic (unwinding, so defers run)
    // when the operation overflows or a shift amount reaches the bit width.
    func __intrinsic_checked_add[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_checked_sub[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_checked_mul[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_checked_div[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_checked_rem[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_checked_shl[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_checked_shr[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_checked_neg[T](_ value: T) -> T

    // Integer arithmetic that never traps, whatever overflow policy the
    // package containing the call (after inlining or specialization) uses.
    // wrapping_* returns the two's-complement result modulo 2^N;
    // overflows_* reports whether the exact result does not fit T.
    func __intrinsic_wrapping_add[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_wrapping_sub[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_wrapping_mul[T](_ lhs: T, _ rhs: T) -> T
    func __intrinsic_overflows_add[T](_ lhs: T, _ rhs: T) -> bool
    func __intrinsic_overflows_sub[T](_ lhs: T, _ rhs: T) -> bool
    func __intrinsic_overflows_mul[T](_ lhs: T, _ rhs: T) -> bool

    // Bit-manipulation intrinsics on native integers.
    // ctlz/cttz use is_zero_poison = false (returning the bit width on 0).
    // fshl/fshr apply the shift count modulo the bit width and never trap.
    func __intrinsic_ctpop[T](_ value: T) -> uint32
    func __intrinsic_ctlz[T](_ value: T) -> uint32
    func __intrinsic_cttz[T](_ value: T) -> uint32
    func __intrinsic_bswap[T](_ value: T) -> T
    func __intrinsic_bitreverse[T](_ value: T) -> T
    func __intrinsic_fshl[T](_ hi: T, _ lo: T, _ shift: uint32) -> T
    func __intrinsic_fshr[T](_ hi: T, _ lo: T, _ shift: uint32) -> T

    // Floating-point math intrinsics (typed ABI symbols).
    // f32 unary
    func __intrinsic_sqrt_f32(_ x: float) -> float
    func __intrinsic_sin_f32(_ x: float) -> float
    func __intrinsic_cos_f32(_ x: float) -> float
    func __intrinsic_tan_f32(_ x: float) -> float
    func __intrinsic_asin_f32(_ x: float) -> float
    func __intrinsic_acos_f32(_ x: float) -> float
    func __intrinsic_atan_f32(_ x: float) -> float
    func __intrinsic_sinh_f32(_ x: float) -> float
    func __intrinsic_cosh_f32(_ x: float) -> float
    func __intrinsic_tanh_f32(_ x: float) -> float
    func __intrinsic_exp_f32(_ x: float) -> float
    func __intrinsic_exp2_f32(_ x: float) -> float
    func __intrinsic_log_f32(_ x: float) -> float
    func __intrinsic_log2_f32(_ x: float) -> float
    func __intrinsic_log10_f32(_ x: float) -> float
    func __intrinsic_fabs_f32(_ x: float) -> float
    func __intrinsic_floor_f32(_ x: float) -> float
    func __intrinsic_ceil_f32(_ x: float) -> float
    func __intrinsic_trunc_f32(_ x: float) -> float
    func __intrinsic_rint_f32(_ x: float) -> float
    func __intrinsic_nearbyint_f32(_ x: float) -> float
    func __intrinsic_round_f32(_ x: float) -> float
    func __intrinsic_roundeven_f32(_ x: float) -> float

    // f64 unary
    func __intrinsic_sqrt_f64(_ x: double) -> double
    func __intrinsic_sin_f64(_ x: double) -> double
    func __intrinsic_cos_f64(_ x: double) -> double
    func __intrinsic_tan_f64(_ x: double) -> double
    func __intrinsic_asin_f64(_ x: double) -> double
    func __intrinsic_acos_f64(_ x: double) -> double
    func __intrinsic_atan_f64(_ x: double) -> double
    func __intrinsic_sinh_f64(_ x: double) -> double
    func __intrinsic_cosh_f64(_ x: double) -> double
    func __intrinsic_tanh_f64(_ x: double) -> double
    func __intrinsic_exp_f64(_ x: double) -> double
    func __intrinsic_exp2_f64(_ x: double) -> double
    func __intrinsic_log_f64(_ x: double) -> double
    func __intrinsic_log2_f64(_ x: double) -> double
    func __intrinsic_log10_f64(_ x: double) -> double
    func __intrinsic_fabs_f64(_ x: double) -> double
    func __intrinsic_floor_f64(_ x: double) -> double
    func __intrinsic_ceil_f64(_ x: double) -> double
    func __intrinsic_trunc_f64(_ x: double) -> double
    func __intrinsic_rint_f64(_ x: double) -> double
    func __intrinsic_nearbyint_f64(_ x: double) -> double
    func __intrinsic_round_f64(_ x: double) -> double
    func __intrinsic_roundeven_f64(_ x: double) -> double

    // f32 binary/ternary and powi exponent
    func __intrinsic_pow_f32(_ x: float, _ y: float) -> float
    func __intrinsic_powi_f32_i32(_ x: float, _ y: int32) -> float
    func __intrinsic_copysign_f32(_ x: float, _ y: float) -> float
    func __intrinsic_fma_f32(_ x: float, _ y: float, _ z: float) -> float
    func __intrinsic_minimum_f32(_ x: float, _ y: float) -> float
    func __intrinsic_maximum_f32(_ x: float, _ y: float) -> float
    func __intrinsic_minimumnum_f32(_ x: float, _ y: float) -> float
    func __intrinsic_maximumnum_f32(_ x: float, _ y: float) -> float

    // f64 binary/ternary and powi exponent
    func __intrinsic_pow_f64(_ x: double, _ y: double) -> double
    func __intrinsic_powi_f64_i32(_ x: double, _ y: int32) -> double
    func __intrinsic_copysign_f64(_ x: double, _ y: double) -> double
    func __intrinsic_fma_f64(_ x: double, _ y: double, _ z: double) -> double
    func __intrinsic_minimum_f64(_ x: double, _ y: double) -> double
    func __intrinsic_maximum_f64(_ x: double, _ y: double) -> double
    func __intrinsic_minimumnum_f64(_ x: double, _ y: double) -> double
    func __intrinsic_maximumnum_f64(_ x: double, _ y: double) -> double

    // Wrap immutable GC/static storage as {data, len}, without allocating.
    // The source must remain valid and immutable while the string is used.
    unsafe func __intrinsic_string_from_parts(_ data: *const uint8, _ len: usize) -> string
    unsafe func __intrinsic_string_slice(_ s: &string, _ start: usize, _ count: usize) -> string
    func __intrinsic_string_data(_ s: &string) -> *const uint8
    func __intrinsic_string_len(_ s: &string) -> usize
    func __intrinsic_env_argc() -> usize
    func __intrinsic_env_argv() -> *const *const uint8
    func __intrinsic_rune_from_u32_unchecked(_ value: uint32) -> rune
    // Traced value-copy metadata for collected sequence storage.
    unsafe func __intrinsic_gc_value_descriptor[T]() -> *const uint8
    unsafe func __intrinsic_class_owner[T: AnyObject](_ value: &T) -> *const uint8
    unsafe func __intrinsic_class_from_owner[T: AnyObject](_ owner: *const uint8) -> T
    // Publish a nominal class value from its compiler-private GC handle.
    unsafe func __intrinsic_class_from_handle[T: AnyObject](_ handle: std::runtime::ClassHandle) -> T
    // Compiler-generated constant field paths. Storage references point into
    // and retain the GC object independently of its handle variable.
    unsafe func __intrinsic_class_field_reference[C: AnyObject, F](_ slot: &C, _ path: string) -> &F
    unsafe func __intrinsic_class_field_read[C: AnyObject, F](_ slot: &C, _ path: string) -> F
    unsafe func __intrinsic_class_field_write[C: AnyObject, F](_ slot: &C, _ path: string, _ value: F)
    unsafe func __intrinsic_class_field_modify[C: AnyObject, F](_ slot: &C, _ path: string, _ op: string, _ rhs: F)
    // Cleanup-only witness for existing source allocation families (channels).
    // This authorizes no raw-pointer adoption or native Copy operation.
    // Compiler-only output bridge. Cleanup must be the generated, typed
    // SourceDropGlue constant, discovered through the MIR operand.
    unsafe func __intrinsic_task_output_descriptor[T]() -> *const uint8
    func __intrinsic_spawn_async[T, F: AsyncFn() -> T](_ thunk: F) -> std::task::Task[T]
    func __intrinsic_cancel_task[T](_ task: &std::task::Task[T])
    func __intrinsic_dump_tasks()
    func __intrinsic_select_tasks[A, B](_ first: &std::task::Task[A], _ second: &std::task::Task[B]) async -> uint8
    func __intrinsic_task_timeout[T](_ task: &std::task::Task[T], _ duration: std::time::Duration) async -> uint8
    func __intrinsic_blocking[T, F: Fn() -> T](_ thunk: F) async -> T
    func __intrinsic_is_task_cancelled() -> bool
    func __intrinsic_task_result[T](_ task: &std::task::Task[T]) async -> Result[T, std::task::TaskError]
    unsafe func __intrinsic_task_group_create[T](_ cancel_on_panic: bool) -> usize
    unsafe func __intrinsic_task_group_spawn[T, F: AsyncFn() -> T](_ group: usize, _ thunk: F)
    unsafe func __intrinsic_task_group_next[T](_ group: usize) async -> T?
    unsafe func __intrinsic_task_group_close(_ group: usize)
    unsafe func __intrinsic_task_group_cancel(_ group: usize)
    unsafe func __intrinsic_task_group_destroy(_ group: usize)
    unsafe func __intrinsic_task_group_destroy_and_rethrow(_ group: usize)
    func __intrinsic_wait_readable(_ source_id: usize) async -> int32
    func __intrinsic_wait_writable(_ source_id: usize) async -> int32
    func __intrinsic_channel_wait_send(_ handle: *mut uint8) async -> int32
    func __intrinsic_channel_wait_recv(_ handle: *mut uint8) async -> int32
    func __intrinsic_mutex_lock(_ handle: *mut uint8) async -> int32
    func __intrinsic_rwlock_read(_ handle: *mut uint8) async -> int32
    func __intrinsic_rwlock_write(_ handle: *mut uint8) async -> int32
    func __intrinsic_sleep(_ duration: std::time::Duration) async -> ()
    func __intrinsic_async_generator_next[Element](
        _ frame: *mut uint8,
        _ poll: (*mut uint8, *mut uint8, *mut uint8) -> uint8,
    ) async -> std::optional::Optional[Element]
}

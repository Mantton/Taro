import std::intrinsic::__intrinsic_cancel_task
import std::intrinsic::__intrinsic_blocking
import std::intrinsic::__intrinsic_dump_tasks
import std::intrinsic::__intrinsic_is_task_cancelled
import std::intrinsic::__intrinsic_select_tasks
import std::intrinsic::__intrinsic_sleep
import std::intrinsic::__intrinsic_spawn_async
import std::intrinsic::__intrinsic_task_timeout
import std::intrinsic::__intrinsic_task_result
import std::ops::{AsyncFn, Fn}
import std::panic::PanicPayload
import std::result::Result

extern "taro_rt" {
    unsafe func __rt__task_hold_next_spawn()
}

/// A shared handle to spawned work. Copies observe and control the same task;
/// the work runs independently of whether any handle remains, and its
/// outcome is cached so every observer sees the same result.
@lang("Task")
public struct Task[T] {
    // The runtime's collected handle object: it traces the cached result and
    // routes control to the task's own executor. Exposing it would let code
    // change T.
    private handle: *mut uint8
}

public enum TaskError {
    case cancelled
    case panicked(PanicPayload)
}

/// Identifies which branch completed first in a two-way selection.
public enum SelectResult[First, Second] {
    case first(First)
    case second(Second)
}

/// A deadline can expire or its wrapped operation can fail as a task.
public enum TimeoutError {
    case timedOut
    case operation(TaskError)
}

/// Enqueue an async call on the executor for concurrent execution.
/// The argument must be a zero-argument async closure. Returns a `Task[T]`
/// handle that can be awaited later via `await task.result()`.
/// Callbacks share captured variables. Their GC storage remains alive while
/// spawned work can reach it.
public func spawn[T, F: AsyncFn() -> T](_ thunk: F) -> Task[T] {
    return __intrinsic_spawn_async[T, F](thunk)
}

/// Enqueue fire-and-forget work on the executor. Spawned work never depends
/// on its handle, so this is `spawn` with the handle discarded.
public func detached[T, F: AsyncFn() -> T](_ thunk: F) {
    var _ = spawn[T, F](thunk)
}

/// Print live tasks, their spawn chains, and current wait reasons to stderr.
public func dump() {
    __intrinsic_dump_tasks()
}

public func isCancelled() -> bool {
    return __intrinsic_is_task_cancelled()
}

/// Requeue this task behind other runnable work, then resume it. This is a
/// cancellation checkpoint. The compiler supplies the body.
public func yieldNow() async {}

public func sleep(_ duration: std::time::Duration) async {
    return await __intrinsic_sleep(duration)
}

/// Run synchronous work on the bounded blocking pool without occupying an
/// async executor worker. Cancellation abandons result delivery; work that has
/// already started is allowed to finish because terminating a native thread is
/// unsafe.
public func blocking[T, F: Fn() -> T](_ thunk: F) async -> T {
    return await __intrinsic_blocking[T, F](thunk)
}

/// Compiler adapter whose async frame owns the closure while it is queued or
/// running on a blocking worker.
func __blockingInvoke[T, F: Fn() -> T](_ thunk: F) async -> T {
    return thunk()
}

func drainSelectionLoser[T](_ task: Task[T]) async -> Result[(), TaskError] {
    match await task.result() {
        case .ok(_) => return .ok(())
        case .err(.cancelled) => return .ok(())
        case .err(error) => return .err(error)
    }
}

/// Run two async operations concurrently and return the first completion.
/// If both are ready in the same observation, the first branch wins.
/// The losing branch is cancelled and drained before this function returns.
/// If the caller is cancelled or panics while waiting, both branches are
/// cancelled and the caller's outcome is published only after they finish.
public func select[
    A,
    B,
    First: AsyncFn() -> A,
    Second: AsyncFn() -> B,
](_ first: First, _ second: Second) async -> Result[SelectResult[A, B], TaskError] {
    firstTask := spawn[A, First](first)
    secondTask := spawn[B, Second](second)
    winner := await __intrinsic_select_tasks[A, B](&firstTask, &secondTask)

    if winner == 0 {
        secondTask.cancel()
        winnerResult := await firstTask.result()
        loserResult := await drainSelectionLoser(secondTask)
        match winnerResult {
            case .err(error) => return .err(error)
            case .ok(value) => match loserResult {
                case .ok(_) => return .ok(.first(value))
                case .err(error) => return .err(error)
            }
        }
    }

    firstTask.cancel()
    winnerResult := await secondTask.result()
    loserResult := await drainSelectionLoser(firstTask)
    match winnerResult {
        case .err(error) => return .err(error)
        case .ok(value) => match loserResult {
            case .ok(_) => return .ok(.second(value))
            case .err(error) => return .err(error)
        }
    }
}

/// Run two same-typed async operations and return the first completion.
public func race[
    T,
    First: AsyncFn() -> T,
    Second: AsyncFn() -> T,
](_ first: First, _ second: Second) async -> Result[T, TaskError] {
    match await select[T, T, First, Second](first, second) {
        case .ok(.first(value)) => return .ok(value)
        case .ok(.second(value)) => return .ok(value)
        case .err(error) => return .err(error)
    }
}

/// Run an async operation until it completes or the duration expires.
/// A zero-duration timeout still gives an already-ready operation priority.
/// On expiry the operation is cancelled and drained before this returns, so
/// an operation that does not reach a cancellation checkpoint (a suspending
/// await or `isCancelled()`) keeps the caller waiting past the deadline until
/// it finishes.
public func withTimeout[T, Operation: AsyncFn() -> T](
    _ duration: std::time::Duration,
    _ operation: Operation,
) async -> Result[T, TimeoutError] {
    // This task's next step is to wait for the operation, which decides how it
    // starts. Nothing should be woken to take it in the meantime.
    unsafe { __rt__task_hold_next_spawn() }
    operationTask := spawn[T, Operation](operation)
    winner := await __intrinsic_task_timeout[T](&operationTask, duration)

    if winner == 0 {
        match await __intrinsic_task_result[T](&operationTask) {
            case .err(error) => return .err(.operation(error))
            case .ok(value) => return .ok(value)
        }
    }

    operationTask.cancel()
    loserResult := await drainSelectionLoser(operationTask)
    match loserResult {
        case .ok(_) => return .err(.timedOut)
        case .err(error) => return .err(.operation(error))
    }
}

public func join[A, B](_ left: Task[A], _ right: Task[B]) async -> Result[(A, B), TaskError] {
    leftResult := await left.result()
    leftValue := match leftResult {
        case .ok(v) => v
        case .err(e) => return .err(e)
    }
    rightResult := await right.result()
    rightValue := match rightResult {
        case .ok(v) => v
        case .err(e) => return .err(e)
    }
    return .ok((leftValue, rightValue))
}

extend[T] Task[T] {
    public static func isCancelled() -> bool {
        return __intrinsic_is_task_cancelled()
    }

    public func cancel() {
        __intrinsic_cancel_task[T](&self)
    }

    /// Wait for the task's outcome. Observation does not consume the handle:
    /// repeated and concurrent waits receive copies of the same cached
    /// outcome. Cancelling a waiting caller abandons only its own wait; the
    /// task keeps running until it finishes or is cancelled through `cancel`.
    public func result() async -> Result[T, TaskError] {
        return await __intrinsic_task_result[T](&self)
    }
}

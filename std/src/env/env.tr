import std.collections.List
import std.iter.{Iterable, Iterator}
import std.io.Error
import std.mem.Span
import std.optional.Optional
import std.result.Result

public struct Args {
    raw: Span[*const uint8]
}

public struct ArgsIterator {
    raw: Span[*const uint8]
    idx: usize
}

public func argv() -> Span[*const uint8] {
    std.sys.env.argv()
}

public func args() -> Args {
    Args { raw: argv() }
}

/// Return the raw-byte value of an environment variable.
///
/// `.none` means the variable is absent, while `.some("")` means it is
/// present with an empty value. Invalid POSIX names, including embedded NULs,
/// return a typed `invalidInput` error.
public func get(_ name: string) -> Result[string?, Error] {
    std.sys.env.get(name)
}

/// Return whether an environment variable is present, including when empty.
public func contains(_ name: string) -> Result[bool, Error] {
    match get(name) {
        case .ok(value) => return .ok(value.isSome())
        case .err(error) => return .err(error)
    }
}

/// Set an environment variable for this process and subsequently spawned children.
///
/// The process environment is global mutable state. The runtime serializes all
/// Taro environment access, but callers should still restore temporary changes
/// promptly so unrelated application code does not observe them.
public func set(_ name: string, _ value: string) -> Result[(), Error] {
    std.sys.env.set(name, value)
}

/// Remove an environment variable. Removing a missing variable succeeds.
public func remove(_ name: string) -> Result[(), Error] {
    std.sys.env.remove(name)
}

/// Capture owned name/value pairs from the current process environment.
///
/// The snapshot remains unchanged after later mutations and preserves the
/// OS-provided order rather than imposing a hidden sort. Unix names and values
/// retain their original bytes even when they are not valid UTF-8.
public func vars() -> Result[List[(string, string)], Error] {
    std.sys.env.vars()
}

/// Return the process working directory as an absolute raw-byte path.
public func currentDir() -> Result[string, Error] {
    std.sys.env.currentDir()
}

/// Change the process working directory.
///
/// This affects relative path resolution in every task, so scoped uses should
/// restore the previous value with `defer`.
public func setCurrentDir(_ path: string) -> Result[(), Error] {
    std.sys.env.setCurrentDir(path)
}

/// Return the current user's home directory.
///
/// Unix uses a non-empty `HOME` first and falls back to the passwd database,
/// so clearing `HOME` does not erase an otherwise known home directory.
public func homeDir() -> Result[string, Error] {
    std.sys.env.homeDir()
}

/// Return the preferred temporary-directory path.
///
/// Unix uses a non-empty `TMPDIR`, otherwise `/tmp`, following Go's predictable
/// contract. The path is not guaranteed to exist or be writable.
public func tempDir() -> Result[string, Error] {
    std.sys.env.tempDir()
}

func cStringLen(_ ptr: *const uint8) -> usize {
    var len: usize = 0
    while ptr.add(len).read() != 0 {
        len += 1
    }
    return len
}

func cStringToString(_ ptr: *const uint8) -> string {
    let len = cStringLen(ptr)
    if len == 0 {
        return ""
    }

    let buf = std.mem.allocBytes(len)
    ptr.readBytes(buf, len)
    std.string.stringFromParts(buf, len)
}

impl Args {
    public func len(&self) -> usize {
        self.raw.len()
    }

    public func isEmpty(&self) -> bool {
        self.raw.isEmpty()
    }

    public func at(&self, _ index: usize) -> string {
        cStringToString(*self.raw.at(index))
    }

    public func get(&self, _ index: usize) -> string? {
        match self.raw.get(index) {
            case .some(value) => .some(cStringToString(*value))
            case .none => .none
        }
    }
}

impl Iterator for ArgsIterator {
    type Element = string

    public func next(&mut self) -> Optional[Self.Element] {
        if self.idx >= self.raw.len() {
            return .none
        }

        let value = cStringToString(*self.raw.at(self.idx))
        self.idx += 1
        return .some(value)
    }
}

impl Iterable for Args {
    type Iterator = ArgsIterator
    type Element = string

    public func iter(self) -> Self.Iterator {
        ArgsIterator {
            raw: self.raw,
            idx: 0,
        }
    }
}

import std::runtime::SharedOwner
import std::collections::List
import std::io::{Error, Reader, Writer}
import std::mem::{Span}
import std::result::Result

/// Controls one standard stream of a spawned process.
public enum Stdio {
    /// Connect the child stream to the null device.
    case null
    /// Inherit the corresponding stream from the parent process.
    case inherit
    /// Create a parent-owned pipe returned on `Child`.
    case piped
}

extend Stdio {
    func rawValue() -> uint8 {
        match self {
            case .null => std::sys::process::STDIO_NULL
            case .inherit => std::sys::process::STDIO_INHERIT
            case .piped => std::sys::process::STDIO_PIPED
        }
    }

    func isPiped() -> bool {
        match self {
            case .piped => true
            case _ => false
        }
    }
}

internal struct CommandEnvironment {
    name: string
    value: string
}

/// A direct argv subprocess invocation.
///
/// Command never invokes a shell. Shell syntax is passed as ordinary argument
/// bytes unless the program itself is an explicitly selected shell.
public struct Command {
    programValue: string
    argumentsValue: List[string]
    environmentValue: List[CommandEnvironment]
    currentDirValue: string?
    stdinValue: Stdio
    stdoutValue: Stdio
    stderrValue: Stdio
}

// Command is an ordinary value containing shared argument/environment Lists.
// Blocking callbacks retain their captures through GC like other closures.

extend Command {
    /// Construct a reusable command. Standard streams default to `.null`,
    /// matching Go's safe library behavior; CLI tools can opt into `.inherit`.
    public static func new(_ program: string, _ arguments: string...) -> Self {
        var storedArguments = List[string]::new(withCapacity: arguments.len())
        var index: usize = 0
        while index < arguments.len() {
            storedArguments.append(*arguments.at(index))
            index += 1
        }

        return Command {
            programValue: program,
            argumentsValue: storedArguments,
            environmentValue: List[CommandEnvironment]::new(),
            currentDirValue: .none,
            stdinValue: .null,
            stdoutValue: .null,
            stderrValue: .null,
        }
    }

    func prepare() -> Result[std::sys::process::RawCommand, Error] {
        var raw = match std::sys::process::commandOpen(self.programValue) {
            case .ok(value) => value
            case .err(err) => return .err(err.withPath(self.programValue))
        }

        var index: usize = 0
        while index < self.argumentsValue.len() {
            match std::sys::process::commandArg(&raw, *self.argumentsValue.at(index)) {
                case .ok(_) => {}
                case .err(err) => {
                    std::sys::process::commandClose(&raw)
                    return .err(err.withPath(self.programValue))
                }
            }
            index += 1
        }

        index = 0
        while index < self.environmentValue.len() {
            entry := self.environmentValue.at(index)
            match std::sys::process::commandEnv(&raw, entry.name, entry.value) {
                case .ok(_) => {}
                case .err(err) => {
                    std::sys::process::commandClose(&raw)
                    return .err(err.withPath(self.programValue))
                }
            }
            index += 1
        }

        match self.currentDirValue {
            case .some(path) => match std::sys::process::commandCurrentDir(&raw, path) {
                case .ok(_) => {}
                case .err(err) => {
                    std::sys::process::commandClose(&raw)
                    return .err(err)
                }
            }
            case .none => {}
        }

        match std::sys::process::commandStdio(
            &raw,
            self.stdinValue.rawValue(),
            self.stdoutValue.rawValue(),
            self.stderrValue.rawValue(),
        ) {
            case .ok(_) => return .ok(raw)
            case .err(err) => {
                std::sys::process::commandClose(&raw)
                return .err(err.withPath(self.programValue))
            }
        }
    }

    /// Spawn the command and return immediately after exec succeeds.
    public func spawn() -> Result[Child, Error] {
        var raw = match self.prepare() {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        defer { std::sys::process::commandClose(&raw) }
        spawn := match std::sys::process::commandSpawn(&raw) {
            case .ok(value) => value
            case .err(err) => return .err(err.withPath(self.programValue))
        }
        return childFromRaw(spawn, self.programValue)
    }

    /// Spawn and synchronously wait for a command with no piped streams.
    /// Use `statusAsync` from an async task so executor workers remain free.
    public func status() -> Result[ExitStatus, Error] {
        if self.stdinValue.isPiped() || self.stdoutValue.isPiped() || self.stderrValue.isPiped() {
            return .err(
                Error::new(.invalidInput)
                    .withOperation("wait for command with piped stdio")
                    .withPath(self.programValue),
            )
        }

        var raw = match self.prepare() {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        defer { std::sys::process::commandClose(&raw) }
        match std::sys::process::commandStatus(&raw) {
            case .ok(value) => return .ok(exitStatusFromRaw(value))
            case .err(err) => return .err(err.withPath(self.programValue))
        }
    }

    /// Run and capture stdout and stderr concurrently without a byte limit.
    /// The configured stdout/stderr modes are replaced by capture pipes.
    public func output() -> Result[Output, Error] {
        return self.outputImpl(false, 0)
    }

    /// Run and capture stdout and stderr with one combined byte budget.
    /// Exceeding the budget kills and reaps this command before returning
    /// `resourceExhausted`, preventing a child from remaining blocked on pipes
    /// the parent no longer reads.
    public func output(limit: usize) -> Result[Output, Error] {
        return self.outputImpl(true, limit)
    }

    func outputImpl(_ limited: bool, _ limit: usize) -> Result[Output, Error] {
        if self.stdinValue.isPiped() {
            return .err(
                Error::new(.invalidInput)
                    .withOperation("capture command with piped stdin")
                    .withPath(self.programValue),
            )
        }

        var raw = match self.prepare() {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        defer { std::sys::process::commandClose(&raw) }
        rawOutput := match std::sys::process::commandOutput(&raw, limited, limit) {
            case .ok(value) => value
            case .err(err) => return .err(err.withPath(self.programValue))
        }
        parts := rawOutput.parts()
        return .ok(Output {
            statusValue: exitStatusFromRaw(parts.0),
            stdoutValue: parts.1,
            stderrValue: parts.2,
        })
    }

    /// Run `status` on the bounded blocking pool.
    public func statusAsync() async -> Result[ExitStatus, Error] {
        return await std::task::blocking(() => self.status())
    }

    /// Run unlimited `output` on the bounded blocking pool. The runtime still
    /// drains stdout and stderr on separate native readers inside that job.
    public func outputAsync() async -> Result[Output, Error] {
        return await std::task::blocking(() => self.output())
    }

    /// Run byte-limited `output` on the bounded blocking pool.
    public func outputAsync(limit: usize) async -> Result[Output, Error] {
        return await std::task::blocking(() => self.output(limit: limit))
    }
}

/// A completed process status. Unix signal termination has no exit code.
public struct ExitStatus {
    codeValue: int32?
    signalValue: int32?
}

extend ExitStatus {
    public func success() -> bool {
        match self.codeValue {
            case .some(code) => code == 0
            case .none => false
        }
    }

    public func code() -> int32? { self.codeValue }

    /// Return the terminating Unix signal, or none for a normal exit.
    public func signal() -> int32? { self.signalValue }
}

internal func exitStatusFromRaw(_ raw: std::sys::process::RawExitStatus) -> ExitStatus {
    var codeValue: int32? = if raw.code() < 0 { .none } else { .some(raw.code()) }
    var signalValue: int32? = if raw.signal() < 0 { .none } else { .some(raw.signal()) }
    return ExitStatus { codeValue, signalValue }
}

/// Captured raw output and the command's status. A non-zero status is data,
/// not an I/O error, so callers can inspect stderr and recovery policy together.
public struct Output {
    statusValue: ExitStatus
    stdoutValue: List[uint8]
    stderrValue: List[uint8]
}

// Captured byte Lists are GC handles; copies share their buffers.

extend Output {
    public func status() -> ExitStatus { return self.statusValue }
    public func stdout() -> List[uint8] { return self.stdoutValue }
    public func stderr() -> List[uint8] { return self.stderrValue }

    public func parts() -> (ExitStatus, List[uint8], List[uint8]) {
        return (self.statusValue, self.stdoutValue, self.stderrValue)
    }
}

internal struct ChildState {
    inner: std::sys::process::RawChild
}

internal func childStateFromRaw(_ raw: std::sys::process::RawChild) -> Result[SharedOwner[ChildState], Error] {
    return .ok(SharedOwner[ChildState]::new(ChildState { inner: raw }))
}

internal struct PipeCloseState {
    inner: std::sys::process::RawPipe
}

internal func pipeStateFromRaw(_ raw: std::sys::process::RawPipe) -> Result[SharedOwner[PipeCloseState], Error] {
    return .ok(SharedOwner[PipeCloseState]::new(PipeCloseState { inner: raw }))
}

internal func closedPipeError(_ operation: string) -> Error {
    Error::new(.closed).withOperation(operation)
}

internal func ensurePipeOpen(_ state: SharedOwner[PipeCloseState], _ operation: string) -> Result[(), Error] {
    valid := std::sys::process::pipeIsValid(&state.get().inner)
    if !valid {
        return .err(closedPipeError(operation))
    }
    return .ok(())
}

internal func claimRawPipe(
    _ state: SharedOwner[PipeCloseState],
    _ operation: string,
) -> Result[std::sys::process::RawPipe, Error] {
    var value: &PipeCloseState = state.get()
    if !std::sys::process::pipeIsValid(&value.inner) {
        return .err(closedPipeError(operation))
    }
    return .ok(std::sys::process::pipeTake(&value.inner))
}

internal func closePipeState(_ state: SharedOwner[PipeCloseState]) -> Result[(), Error] {
    var raw = match claimRawPipe(state, "close process pipe") {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }
    result := std::sys::process::pipeClose(&raw)
    return result
}

/// The parent writer connected to a child's piped stdin.
public struct ChildStdin {
    internal state: SharedOwner[PipeCloseState]
}

/// A parent reader connected to a child's piped stdout or stderr.
public struct ChildStdout {
    internal state: SharedOwner[PipeCloseState]
}

extend ChildStdin {
    /// Stops new operations through all shared copies. If a native operation
    /// is in flight, success acknowledges the request; OS close is deferred
    /// until it finishes. Deferred close errors are reported on stderr and in
    /// runtime statistics. Explicit close is required; collection does not close.
    public func close() -> Result[(), Error] { closePipeState(self.state) }

    public func writeAll(_ bytes: Span[uint8]) -> Result[(), Error] {
        var writer = ChildStdin { state: self.state }
        return std::io::writeAll(writer, bytes)
    }

    public func writeString(_ value: string) -> Result[(), Error] {
        var writer = ChildStdin { state: self.state }
        return std::io::writeString(writer, value)
    }

    /// Writes a retained List on the blocking pool. Copies share its bytes;
    /// synchronize concurrent mutation until the operation completes.
    public func writeAllAsync(_ bytes: List[uint8]) async -> Result[(), Error] {
        writer := ChildStdin { state: self.state }
        return await std::task::blocking(() => writer.writeAll(bytes.asSpan()))
    }

    public func writeStringAsync(_ value: string) async -> Result[(), Error] {
        writer := ChildStdin { state: self.state }
        return await std::task::blocking(() => writer.writeString(value))
    }

    /// Transfer this pipe to the executor's non-blocking stream reactor.
    public func intoAsyncStream() -> Result[std::io::task::AsyncStream, Error] {
        var raw = match claimRawPipe(self.state, "convert process stdin to async stream") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        stream := match std::sys::process::pipeIntoAsyncStream(&raw) {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        return std::io::task::fromRaw(stream)
    }
}

conform ChildStdin to Writer {
    public func write(_ bytes: Span[uint8]) -> Result[usize, Error] {
        match ensurePipeOpen(self.state, "write process stdin") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        if bytes.len() == 0 {
            return .ok(0)
        }
        result := std::sys::process::pipeWrite(
            &self.state.get().inner,
            unsafe { bytes.at(0) as *const uint8 },
            bytes.len(),
        )
        return result
    }

    public func flush() -> Result[(), Error] {
        return ensurePipeOpen(self.state, "flush process stdin")
    }
}

extend ChildStdout {
    /// Stops new operations through all shared copies. If a native operation
    /// is in flight, success acknowledges the request; OS close is deferred
    /// until it finishes. Deferred close errors are reported on stderr and in
    /// runtime statistics. Explicit close is required; collection does not close.
    public func close() -> Result[(), Error] { closePipeState(self.state) }

    public func readAll() -> Result[List[uint8], Error] {
        var reader = ChildStdout { state: self.state }
        return std::io::readAll(reader)
    }

    public func readToString() -> Result[string, Error] {
        var reader = ChildStdout { state: self.state }
        return std::io::readToString(reader)
    }

    public func readAllAsync() async -> Result[List[uint8], Error] {
        reader := ChildStdout { state: self.state }
        return await std::task::blocking(() => reader.readAll())
    }

    public func readToStringAsync() async -> Result[string, Error] {
        reader := ChildStdout { state: self.state }
        return await std::task::blocking(() => reader.readToString())
    }

    /// Transfer this pipe to the executor's non-blocking stream reactor.
    public func intoAsyncStream() -> Result[std::io::task::AsyncStream, Error] {
        var raw = match claimRawPipe(self.state, "convert process stdout to async stream") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        stream := match std::sys::process::pipeIntoAsyncStream(&raw) {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        return std::io::task::fromRaw(stream)
    }
}

conform ChildStdout to Reader {
    public func read(_ bytes: Span[uint8]) -> Result[usize, Error] {
        match ensurePipeOpen(self.state, "read process output") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        if bytes.len() == 0 {
            return .ok(0)
        }
        var writable = bytes
        result := std::sys::process::pipeRead(
            &self.state.get().inner,
            unsafe { writable.at(0) as *mut uint8 },
            writable.len(),
        )
        return result
    }
}

/// A running or already-reaped child. Copies share one runtime wait state and
/// one set of pipe cleanup owners.
public struct Child {
    internal state: SharedOwner[ChildState]
    stdinValue: ChildStdin?
    stdoutValue: ChildStdout?
    stderrValue: ChildStdout?
    programValue: string
}

internal func terminateUnreturnableChild(_ state: SharedOwner[ChildState]) {
    var value: &ChildState = state.get()
    var _ = std::sys::process::childKill(&value.inner)
    var _ = std::sys::process::childWait(&value.inner)
    std::sys::process::childAbandon(std::sys::process::childTake(&value.inner))
}

internal func closeOptionalRawPipe(_ pipe: std::sys::process::RawPipe?) {
    match pipe {
        case .some(value) => {
            var owned = value
            var _ = std::sys::process::pipeClose(&owned)
        }
        case .none => {}
    }
}

internal func childFromRaw(
    _ spawn: std::sys::process::RawSpawn,
    _ program: string,
) -> Result[Child, Error] {
    parts := spawn.parts()
    rawChild := parts.0
    var rawStdin = parts.1
    var rawStdout = parts.2
    var rawStderr = parts.3

    state := match childStateFromRaw(rawChild) {
        case .ok(value) => value
        case .err(err) => {
            closeOptionalRawPipe(rawStdin)
            closeOptionalRawPipe(rawStdout)
            closeOptionalRawPipe(rawStderr)
            return .err(err.withPath(program))
        }
    }

    var stdinValue: ChildStdin? = .none
    match rawStdin.take() {
        case .some(raw) => match pipeStateFromRaw(raw) {
            case .ok(pipeState) => stdinValue = .some(ChildStdin { state: pipeState })
            case .err(err) => {
                terminateUnreturnableChild(state)
                closeOptionalRawPipe(rawStdout)
                closeOptionalRawPipe(rawStderr)
                return .err(err.withPath(program))
            }
        }
        case .none => {}
    }

    var stdoutValue: ChildStdout? = .none
    match rawStdout.take() {
        case .some(raw) => match pipeStateFromRaw(raw) {
            case .ok(pipeState) => stdoutValue = .some(ChildStdout { state: pipeState })
            case .err(err) => {
                terminateUnreturnableChild(state)
                match stdinValue {
                    case .some(pipe) => { var _ = pipe.close() }
                    case .none => {}
                }
                closeOptionalRawPipe(rawStderr)
                return .err(err.withPath(program))
            }
        }
        case .none => {}
    }

    var stderrValue: ChildStdout? = .none
    match rawStderr.take() {
        case .some(raw) => match pipeStateFromRaw(raw) {
            case .ok(pipeState) => stderrValue = .some(ChildStdout { state: pipeState })
            case .err(err) => {
                terminateUnreturnableChild(state)
                match stdinValue {
                    case .some(pipe) => { var _ = pipe.close() }
                    case .none => {}
                }
                match stdoutValue {
                    case .some(pipe) => { var _ = pipe.close() }
                    case .none => {}
                }
                return .err(err.withPath(program))
            }
        }
        case .none => {}
    }

    return .ok(Child {
        state,
        stdinValue,
        stdoutValue,
        stderrValue,
        programValue: program,
    })
}

extend Child {
    public func pid() -> Result[uint32, Error] {
        result := std::sys::process::childPid(&self.state.get().inner)
        match result {
            case .ok(value) => return .ok(value)
            case .err(err) => return .err(err.withPath(self.programValue))
        }
    }

    /// Wait synchronously. Repeated calls return the cached status.
    public func wait() -> Result[ExitStatus, Error] {
        result := std::sys::process::childWait(&self.state.get().inner)
        match result {
            case .ok(value) => return .ok(exitStatusFromRaw(value))
            case .err(err) => return .err(err.withPath(self.programValue))
        }
    }

    /// Observe completion without blocking. Once ready, the same status is
    /// returned by every later tryWait or wait call.
    public func tryWait() -> Result[ExitStatus?, Error] {
        result := std::sys::process::childTryWait(&self.state.get().inner)
        match result {
            case .ok(.some(value)) => return .ok(.some(exitStatusFromRaw(value)))
            case .ok(.none) => return .ok(.none)
            case .err(err) => return .err(err.withPath(self.programValue))
        }
    }

    /// Send the platform's unconditional kill signal. This does not reap; call
    /// wait afterwards to observe the signal status.
    public func kill() -> Result[(), Error] {
        result := std::sys::process::childKill(&self.state.get().inner)
        match result {
            case .ok(_) => return .ok(())
            case .err(err) => return .err(err.withPath(self.programValue))
        }
    }

    /// Wait on the bounded blocking pool. Copies observe the same child state.
    public func waitAsync() async -> Result[ExitStatus, Error] {
        return await std::task::blocking(() => self.wait())
    }

    /// Stop observing the child: the runtime reaps it in the background
    /// without signalling it. Later waits report an error; repeating is a no-op.
    /// A child that is neither waited nor detached is never reaped.
    public func detach() {
        var value: &ChildState = self.state.get()
        std::sys::process::childAbandon(std::sys::process::childTake(&value.inner))
    }
}

// Taking a pipe clears the option in this wrapper, rather than a value copy.
extend &Child {
    public func takeStdin() -> ChildStdin? { self.stdinValue.take() }
    public func takeStdout() -> ChildStdout? { self.stdoutValue.take() }
    public func takeStderr() -> ChildStdout? { self.stderrValue.take() }
}

/// Exit immediately without running deferred cleanup.
public func exit(_ code: int32) -> ! {
    std::sys::process::exit(code)
}

extend &Command {
    /// Append one argv entry. Empty arguments are preserved.
    public func arg(_ argument: string) -> &Command {
        self.argumentsValue.append(argument)
        return self
    }

    /// Append multiple argv entries without shell splitting or expansion.
    public func args(_ arguments: string...) -> &Command {
        var index: usize = 0
        while index < arguments.len() {
            self.argumentsValue.append(*arguments.at(index))
            index += 1
        }
        return self
    }

    /// Add or replace one variable in the inherited child environment.
    /// Repeated names use the final value.
    public func env(_ name: string, _ value: string) -> &Command {
        self.environmentValue.append(CommandEnvironment { name, value })
        return self
    }

    /// Select the child's working directory without changing the parent.
    public func currentDir(_ path: string) -> &Command {
        self.currentDirValue = .some(path)
        return self
    }

    public func stdin(_ mode: Stdio) -> &Command {
        self.stdinValue = mode
        return self
    }

    public func stdout(_ mode: Stdio) -> &Command {
        self.stdoutValue = mode
        return self
    }

    public func stderr(_ mode: Stdio) -> &Command {
        self.stderrValue = mode
        return self
    }
}

import std::runtime::SharedOwner
import std::collections::List
import std::io::{Error, AsyncReader, AsyncWriter}
import std::mem::{Span}
import std::result::Result

const IO_CHUNK_SIZE: usize = 4096

internal func readSourceLoop(_ source_id: usize, _ buf: *mut uint8, _ len: usize) async -> Result[usize, Error] {
    loop {
        readRes := std::sys::io::readSourceId(source_id, buf, len)
        match readRes {
            case .ok(count) => return .ok(count)
            case .err(err) if err.isKind(.interrupted) => {}
            case .err(err) if err.isKind(.wouldBlock) => {
                waitRes := await std::sys::io::waitReadableSourceId(source_id)
                match waitRes {
                    case .ok(_) => {}
                    case .err(err) => return .err(err)
                }
            }
            case .err(err) => return .err(err)
        }
    }
}

internal func writeSourceLoop(_ source_id: usize, _ buf: *const uint8, _ len: usize) async -> Result[usize, Error] {
    loop {
        writeRes := std::sys::io::writeSourceId(source_id, buf, len)
        match writeRes {
            case .ok(count) => return .ok(count)
            case .err(err) if err.isKind(.interrupted) => {}
            case .err(err) if err.isKind(.wouldBlock) => {
                waitRes := await std::sys::io::waitWritableSourceId(source_id)
                match waitRes {
                    case .ok(_) => {}
                    case .err(err) => return .err(err)
                }
            }
            case .err(err) => return .err(err)
        }
    }
}

internal struct AsyncStreamCloseState {
    inner: std::sys::io::RawAsyncStream
}

internal func closedStreamError(_ operation: string) -> Error {
    Error::new(.closed).withOperation(operation)
}

internal func streamSourceId(_ state: SharedOwner[AsyncStreamCloseState], _ operation: string) -> Result[usize, Error] {
    sourceId := std::sys::io::sourceId(&state.get().inner)
    if sourceId == 0 {
        return .err(closedStreamError(operation))
    }
    return .ok(sourceId)
}

// Copies share one synchronized close state; they never duplicate a descriptor.
public struct AsyncStream {
    internal state: SharedOwner[AsyncStreamCloseState]
}

/// Adopt a raw async stream into shared close state. Explicit close releases the
/// source and invalidates the state observed by every copy; nothing closes it
/// when it becomes unreachable (D4).
public func fromRaw(_ inner: std::sys::io::RawAsyncStream) -> Result[AsyncStream, Error] {
    if std::sys::io::sourceId(&inner) == 0 {
        return .err(closedStreamError("adopt async stream"))
    }

    state := SharedOwner[AsyncStreamCloseState]::new(AsyncStreamCloseState { inner })
    return .ok(AsyncStream { state })
}

public func stdin() -> Result[AsyncStream, Error] {
    res := std::sys::io::stdin()
    match res {
        case .ok(inner) => return fromRaw(inner)
        case .err(err) => return .err(err)
    }
}

public func stdout() -> Result[AsyncStream, Error] {
    res := std::sys::io::stdout()
    match res {
        case .ok(inner) => return fromRaw(inner)
        case .err(err) => return .err(err)
    }
}

public func stderr() -> Result[AsyncStream, Error] {
    res := std::sys::io::stderr()
    match res {
        case .ok(inner) => return fromRaw(inner)
        case .err(err) => return .err(err)
    }
}

public func pipe() -> Result[(AsyncStream, AsyncStream), Error] {
    res := std::sys::io::pipe()
    match res {
        case .ok((readEnd, writeEnd)) => {
            readStream := match fromRaw(readEnd) {
                case .ok(value) => value
                case .err(err) => {
                    var _ = std::sys::io::close(writeEnd)
                    return .err(err)
                }
            }
            match fromRaw(writeEnd) {
                case .ok(writeStream) => return .ok((readStream, writeStream))
                case .err(err) => {
                    var _ = readStream.close()
                    return .err(err)
                }
            }
        }
        case .err(err) => return .err(err)
    }
}

public func writeAll[W: AsyncWriter](_ writer: W, _ buf: Span[uint8]) async -> Result[(), Error] {
    len := buf.len()
    if len == 0 {
        return .ok(())
    }

    var written: usize = 0
    while written < len {
        remaining := buf.slice(written, len - written)
        writeRes := await writer.write(remaining)
        match writeRes {
            case .ok(count) => {
                if count == 0 {
                    return .err(Error::new(.writeZero).withOperation("write all"))
                }
                written += count
            }
            case .err(err) => return .err(err)
        }
    }

    return .ok(())
}

public func writeString[W: AsyncWriter](_ writer: W, _ s: string) async -> Result[(), Error] {
    len := std::string::stringLen(s)
    if len == 0 {
        return .ok(())
    }

    // User-defined writers receive writable slices, so preserve string immutability.
    bytes := Span[uint8]::fromString(&s)
    await writeAll(writer, bytes)
}

public func readExact[R: AsyncReader](_ reader: R, _ buf: Span[uint8]) async -> Result[(), Error] {
    len := buf.len()
    if len == 0 {
        return .ok(())
    }

    var total: usize = 0
    var writable = buf
    while total < len {
        tail := writable.slice(total, len - total)
        readRes := await reader.read(tail)
        count := match readRes {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }

        if count == 0 {
            return .err(Error::new(.unexpectedEof).withOperation("read exact"))
        }

        total += count
    }

    return .ok(())
}

public func readAtLeast[R: AsyncReader](
    _ reader: R,
    _ min: usize,
    _ buf: Span[uint8],
) async -> Result[usize, Error] {
    len := buf.len()
    if min > len {
        return .err(Error::new(.invalidInput).withOperation("read at least"))
    }

    if min == 0 {
        return .ok(0)
    }

    var total: usize = 0
    var writable = buf
    while total < min {
        tail := writable.slice(total, len - total)
        readRes := await reader.read(tail)
        count := match readRes {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }

        if count == 0 {
            return .err(Error::new(.unexpectedEof).withOperation("read at least"))
        }

        total += count
    }

    return .ok(total)
}

public func readAll[R: AsyncReader](_ reader: R) async -> Result[List[uint8], Error] {
    var out = List[uint8]::new()
    var storage: [uint8; IO_CHUNK_SIZE] = [0; IO_CHUNK_SIZE]
    storagePtr := unsafe { (&storage as *mut [uint8; IO_CHUNK_SIZE]) as *mut uint8 }

    loop {
        readBuf := unsafe { Span[uint8]::from(storagePtr, IO_CHUNK_SIZE) }
        readRes := await reader.read(readBuf)
        match readRes {
            case .ok(count) => {
                if count == 0 {
                    break
                }

                var idx: usize = 0
                while idx < count {
                    out.append(*storage.at(idx))
                    idx += 1
                }
            }
            case .err(err) => return .err(err)
        }
    }

    return .ok(out)
}

public func readToString[R: AsyncReader](_ reader: R) async -> Result[string, Error] {
    bytesRes := await readAll(reader)
    bytes := match bytesRes {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }

    len := bytes.len()
    if len == 0 {
        return .ok("")
    }

    return .ok(std::string::stringFromBytes(bytes.asSpan()))
}

extend AsyncStream {
    public func sourceId() -> usize {
        sourceId := std::sys::io::sourceId(&self.state.get().inner)
        return sourceId
    }

    public func waitReadable() async -> Result[(), Error] {
        sourceId := match streamSourceId(self.state, "wait readable") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        result := await std::sys::io::waitReadableSourceId(sourceId)
        return result
    }

    public func waitWritable() async -> Result[(), Error] {
        sourceId := match streamSourceId(self.state, "wait writable") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        result := await std::sys::io::waitWritableSourceId(sourceId)
        return result
    }

    /// Stops new operations through all shared copies. If a native operation
    /// is in flight, success acknowledges the request; OS close is deferred
    /// until it finishes. Deferred close errors are reported on stderr and in
    /// runtime statistics. Explicit close is required; collection does not close.
    public func close() -> Result[(), Error] {
        var state: &AsyncStreamCloseState = self.state.get()
        if std::sys::io::sourceId(&state.inner) == 0 {
            return .err(closedStreamError("close"))
        }
        stream := std::sys::io::take(&state.inner)
        return std::sys::io::close(stream)
    }

    public func read(_ buf: Span[uint8]) async -> Result[usize, Error] {
        sourceId := match streamSourceId(self.state, "read") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        len := buf.len()
        if len == 0 {
            return .ok(0)
        }

        var writable = buf
        ptr := unsafe { writable.at(0) as *mut uint8 }
        result := await readSourceLoop(sourceId, ptr, len)
        return result
    }

    public func write(_ buf: Span[uint8]) async -> Result[usize, Error] {
        sourceId := match streamSourceId(self.state, "write") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        len := buf.len()
        if len == 0 {
            return .ok(0)
        }

        ptr := unsafe { buf.at(0) as *const uint8 }
        result := await writeSourceLoop(sourceId, ptr, len)
        return result
    }

    public func flush() async -> Result[(), Error] {
        match streamSourceId(self.state, "flush") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        return .ok(())
    }

    public func writeAll(_ buf: Span[uint8]) async -> Result[(), Error] {
        match streamSourceId(self.state, "write all") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        await std::io::task::writeAll(self, buf)
    }

    public func writeString(_ s: string) async -> Result[(), Error] {
        match streamSourceId(self.state, "write all") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        await std::io::task::writeString(self, s)
    }

    public func readExact(_ buf: Span[uint8]) async -> Result[(), Error] {
        match streamSourceId(self.state, "read exact") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        await std::io::task::readExact(self, buf)
    }

    public func readAtLeast(_ min: usize, _ buf: Span[uint8]) async -> Result[usize, Error] {
        match streamSourceId(self.state, "read at least") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        await std::io::task::readAtLeast(self, min, buf)
    }

    public func readAll() async -> Result[List[uint8], Error] {
        match streamSourceId(self.state, "read") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        await std::io::task::readAll(self)
    }

    public func readToString() async -> Result[string, Error] {
        match streamSourceId(self.state, "read") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        await std::io::task::readToString(self)
    }
}

conform AsyncStream to AsyncReader {
    public func read(_ buf: Span[uint8]) async -> Result[usize, Error] {
        sourceId := match streamSourceId(self.state, "read") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        len := buf.len()
        if len == 0 {
            return .ok(0)
        }

        var writable = buf
        ptr := unsafe { writable.at(0) as *mut uint8 }
        result := await readSourceLoop(sourceId, ptr, len)
        return result
    }
}

conform AsyncStream to AsyncWriter {
    public func write(_ buf: Span[uint8]) async -> Result[usize, Error] {
        sourceId := match streamSourceId(self.state, "write") {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }
        len := buf.len()
        if len == 0 {
            return .ok(0)
        }

        ptr := unsafe { buf.at(0) as *const uint8 }
        result := await writeSourceLoop(sourceId, ptr, len)
        return result
    }

    public func flush() async -> Result[(), Error] {
        match streamSourceId(self.state, "flush") {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        return .ok(())
    }
}

conform AsyncStream to std::io::Closeable {
    type CloseResult = Result[(), Error]
    public func close() -> Result[(), Error] { self.close() }
}

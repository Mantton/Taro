import std::collections::List
import std::io::{Error, Reader, Writer, writeAll}
import std::mem::{Span}
import std::optional::Optional
import std::result::Result

const BUF_CAP: usize = 4096

public struct BufReader[Inner: Reader] {
    inner: Inner
    start: usize
    end: usize
    buffer: [uint8; BUF_CAP]
}

extend[Inner: Reader] BufReader[Inner] {
    public static func new(_ inner: Inner) -> Self {
        return BufReader[Inner] {
            inner: inner,
            start: 0,
            end: 0,
            buffer: [0; BUF_CAP],
        }
    }

    public func getInner() -> Inner {
        self.inner
    }
}

conform[Inner: Reader] &BufReader[Inner] to Reader {
    public func read(_ buf: Span[uint8]) -> Result[usize, Error] {
        len := buf.len()
        if len == 0 {
            return .ok(0)
        }

        if self.start == self.end {
            fillRes := self.fillBuffer()
            match fillRes {
                case .ok(_) => {}
                case .err(err) => return .err(err)
            }

            if self.end == 0 {
                return .ok(0)
            }
        }

        available := self.end - self.start
        count := if len < available { len } else { available }

        var writable = buf
        dst := unsafe { writable.at(0) as *mut uint8 }
        srcBase := unsafe { (&self.buffer as *const [uint8; BUF_CAP]) as *const uint8 }
        src := srcBase.add(self.start)
        unsafe { src.copyToNonoverlapping(dst, count) }

        self.start += count
        return .ok(count)
    }
}

public struct BufWriter[Inner: Writer] {
    inner: Inner
    len: usize
    buffer: [uint8; BUF_CAP]
}

extend[Inner: Writer] BufWriter[Inner] {
    public static func new(_ inner: Inner) -> Self {
        return BufWriter[Inner] {
            inner: inner,
            len: 0,
            buffer: [0; BUF_CAP],
        }
    }
}

conform[Inner: Writer] &BufWriter[Inner] to Writer {
    public func write(_ buf: Span[uint8]) -> Result[usize, Error] {
        var cap: usize = BUF_CAP
        len := buf.len()
        if len == 0 {
            return .ok(0)
        }

        // For large writes, bypass the internal buffer after flushing pending bytes.
        if self.len == 0 && len >= cap {
            return self.inner.write(buf)
        }

        if self.len == cap {
            flushRes := self.flushBuffer()
            match flushRes {
                case .ok(_) => {}
                case .err(err) => return .err(err)
            }
        }

        space := cap - self.len
        count := if len < space { len } else { space }

        src := unsafe { buf.at(0) as *const uint8 }
        dstBase := unsafe { (&self.buffer as *mut [uint8; BUF_CAP]) as *mut uint8 }
        dst := dstBase.add(self.len)
        unsafe { src.copyToNonoverlapping(dst, count) }

        self.len += count
        return .ok(count)
    }

    public func flush() -> Result[(), Error] {
        flushRes := self.flushBuffer()
        match flushRes {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }
        return self.inner.flush()
    }
}

extend[Inner: Reader] &BufReader[Inner] {
    func fillBuffer() -> Result[(), Error] {
        self.start = 0
        self.end = 0

        ptr := unsafe { (&self.buffer as *mut [uint8; BUF_CAP]) as *mut uint8 }
        readBuf := unsafe { Span[uint8]::from(ptr, BUF_CAP) }
        readRes := self.inner.read(readBuf)
        match readRes {
            case .ok(count) => {
                self.end = count
                return .ok(())
            }
            case .err(err) => return .err(err)
        }
    }

    public func readUntil(_ delimiter: uint8) -> Result[List[uint8], Error] {
        var out = List[uint8]::new()

        loop {
            if self.start == self.end {
                fillRes := self.fillBuffer()
                match fillRes {
                    case .ok(_) => {}
                    case .err(err) => return .err(err)
                }

                if self.end == 0 {
                    break
                }
            }

            b := *self.buffer.at(self.start)
            out.append(b)
            self.start += 1

            if b == delimiter {
                break
            }
        }

        return .ok(out)
    }

    public func readLine() -> Result[Optional[string], Error] {
        bytesRes := self.readUntil(10) // '\n'
        bytes := match bytesRes {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }

        len := bytes.len()
        if len == 0 {
            return .ok(.none)
        }

        line := std::string::stringFromBytes(bytes.asSpan())
        return .ok(.some(line))
    }
}

extend[Inner: Writer] &BufWriter[Inner] {
    public func flushAndGetInner() -> Result[Inner, Error] {
        var writer = self
        flushRes := writer.flush()
        match flushRes {
            case .ok(_) => return .ok(writer.inner)
            case .err(err) => return .err(err)
        }
    }

    func flushBuffer() -> Result[(), Error] {
        if self.len == 0 {
            return .ok(())
        }

        ptr := unsafe { (&self.buffer as *const [uint8; BUF_CAP]) as *const uint8 }
        bytes := unsafe { Span[uint8]::from(ptr, self.len) }
        writeRes := writeAll(self.inner, bytes)
        match writeRes {
            case .ok(_) => {
                self.len = 0
                return .ok(())
            }
            case .err(err) => return .err(err)
        }
    }
}

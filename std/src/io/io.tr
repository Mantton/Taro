import std::collections::List
import std::io::{Error, Reader, Writer}
import std::mem::{Span}
import std::result::Result

const IO_CHUNK_SIZE: usize = 4096

public func writeStdout(_ buf: *const uint8, _ len: usize) -> Result[usize, Error] {
    std::sys::io::writeStdout(buf, len)
}

public func writeStderr(_ buf: *const uint8, _ len: usize) -> Result[usize, Error] {
    std::sys::io::writeStderr(buf, len)
}

public func readStdin(_ buf: *mut uint8, _ len: usize) -> Result[usize, Error] {
    std::sys::io::readStdin(buf, len)
}

/// The process's standard input, as a `Reader`.
///
/// Holds no state and owns no descriptor, so it does not need closing. Reads
/// still consume the process-wide input stream and therefore share it with any
/// other synchronous or asynchronous stdin reader. Wrap it in a `BufReader` to
/// read a line at a time.
public struct Stdin {}

/// A reader over the process's standard input.
public func stdin() -> Stdin {
    return Stdin {}
}

conform Stdin to Reader {
    public func read(_ buf: Span[uint8]) -> Result[usize, Error] {
        len := buf.len()
        if len == 0 {
            return .ok(0)
        }

        var writable = buf
        ptr := unsafe { writable.at(0) as *mut uint8 }
        return readStdin(ptr, len)
    }
}

public func writeAll[W: Writer](_ writer: W, _ buf: Span[uint8]) -> Result[(), Error] {
    len := buf.len()
    if len == 0 {
        return .ok(())
    }

    var written: usize = 0
    while written < len {
        remaining := buf.slice(written, len - written)
        writeRes := writer.write(remaining)
        match writeRes {
            case .ok(count) => {
                if count == 0 {
                    return .err(Error::new(.writeZero).withOperation("write all"))
                }
                written += count
            }
            case .err(err) => return .err(err)
        }
    }

    return .ok(())
}

@inline
public func writeString[W: Writer](_ writer: W, _ s: string) -> Result[(), Error] {
    writer.writeString(s)
}

public func readAll[R: Reader](_ reader: R) -> Result[List[uint8], Error] {
    var out = List[uint8]::new()
    var storage: [uint8; IO_CHUNK_SIZE] = [0; IO_CHUNK_SIZE]
    storagePtr := unsafe { (&storage as *mut [uint8; IO_CHUNK_SIZE]) as *mut uint8 }

    loop {
        readBuf := unsafe { Span[uint8]::from(storagePtr, IO_CHUNK_SIZE) }
        readRes := reader.read(readBuf)
        match readRes {
            case .ok(count) => {
                if count == 0 {
                    break
                }

                var idx: usize = 0
                while idx < count {
                    out.append(*storage.at(idx))
                    idx += 1
                }
            }
            case .err(err) => return .err(err)
        }
    }

    return .ok(out)
}

public func readToString[R: Reader](_ reader: R) -> Result[string, Error] {
    bytesRes := readAll(reader)
    bytes := match bytesRes {
        case .ok(value) => value
        case .err(err) => return .err(err)
    }

    len := bytes.len()
    if len == 0 {
        return .ok("")
    }

    return .ok(std::string::stringFromBytes(bytes.asSpan()))
}

public func readExact[R: Reader](_ reader: R, _ buf: Span[uint8]) -> Result[(), Error] {
    len := buf.len()
    if len == 0 {
        return .ok(())
    }

    var total: usize = 0
    var writable = buf
    while total < len {
        tail := writable.slice(total, len - total)
        readRes := reader.read(tail)
        count := match readRes {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }

        if count == 0 {
            return .err(Error::new(.unexpectedEof).withOperation("read exact"))
        }

        total += count
    }

    return .ok(())
}

public func readAtLeast[R: Reader](
    _ reader: R,
    _ min: usize,
    _ buf: Span[uint8],
) -> Result[usize, Error] {
    len := buf.len()
    if min > len {
        return .err(Error::new(.invalidInput).withOperation("read at least"))
    }

    if min == 0 {
        return .ok(0)
    }

    var total: usize = 0
    var writable = buf
    while total < min {
        tail := writable.slice(total, len - total)
        readRes := reader.read(tail)
        count := match readRes {
            case .ok(value) => value
            case .err(err) => return .err(err)
        }

        if count == 0 {
            return .err(Error::new(.unexpectedEof).withOperation("read at least"))
        }

        total += count
    }

    return .ok(total)
}

public func copy[R: Reader, W: Writer](_ reader: R, _ writer: W) -> Result[usize, Error] {
    var total: usize = 0
    var storage: [uint8; IO_CHUNK_SIZE] = [0; IO_CHUNK_SIZE]
    storageMutPtr := unsafe { (&storage as *mut [uint8; IO_CHUNK_SIZE]) as *mut uint8 }
    storagePtr := unsafe { storageMutPtr as *const uint8 }

    loop {
        readBuf := unsafe { Span[uint8]::from(storageMutPtr, IO_CHUNK_SIZE) }
        readRes := reader.read(readBuf)
        readCount := match readRes {
            case .ok(count) => count
            case .err(err) => return .err(err)
        }

        if readCount == 0 {
            break
        }

        writeBuf := unsafe { Span[uint8]::from(storagePtr, readCount) }
        writeRes := writeAll(writer, writeBuf)
        match writeRes {
            case .ok(_) => {}
            case .err(err) => return .err(err)
        }

        total += readCount
    }

    return .ok(total)
}

@test
func testEnumerateHelperProducesIndexValuePairs() {
    elems := std::iter::enumerate((2 as usize)..(5 as usize))
    var indices = std::collections::List[usize]::new()
    var values = std::collections::List[usize]::new()

    for pair in elems {
        var (index, value) = pair
        indices.append(index)
        values.append(value)
    }

    std::testing::assertEqual(indices.len(), 3 as usize, "enumerate length")
    std::testing::assertEqual(*indices.at(0), 0 as usize, "first index")
    std::testing::assertEqual(*values.at(0), 2 as usize, "first value")
    std::testing::assertEqual(*indices.at(1), 1 as usize, "second index")
    std::testing::assertEqual(*values.at(1), 3 as usize, "second value")
    std::testing::assertEqual(*indices.at(2), 2 as usize, "third index")
    std::testing::assertEqual(*values.at(2), 4 as usize, "third value")
}

@test
func testIterableEnumerateDefaultMethod() {
    elems := ((7 as usize)..(10 as usize)).iter().enumerate()
    var indices = std::collections::List[usize]::new()
    var values = std::collections::List[usize]::new()

    for pair in elems {
        var (index, value) = pair
        indices.append(index)
        values.append(value)
    }

    std::testing::assertEqual(indices.len(), 3 as usize, "enumerate length")
    std::testing::assertEqual(*indices.at(0), 0 as usize, "first index")
    std::testing::assertEqual(*values.at(0), 7 as usize, "first value")
}

@test
func testEnumerateInForLoop() {
    var indexSum = 0 as usize
    var valueSum = 0 as usize

    for pair in std::iter::enumerate((1 as usize)..(4 as usize)) {
        var (index, value) = pair
        indexSum += index
        valueSum += value
    }

    std::testing::assertEqual(indexSum, 3 as usize, "for-loop enumerate index sum mismatch")
    std::testing::assertEqual(valueSum, 6 as usize, "for-loop enumerate value sum mismatch")
}

// ─── count ──────────────────────────────────────────────────────────

@test
func testCountRange() {
    c := (1_i32..6_i32).count()
    std::testing::assertEqual(c, 5 as usize, "count of 1..6 should be 5")
}

@test
func testCountEmpty() {
    c := (0_i32..0_i32).count()
    std::testing::assertEqual(c, 0 as usize, "count of empty range should be 0")
}

@test
func testCountAfterFilter() {
    c := std::iter::filter(1_i32..11_i32, (x: int32) => { x % 2 == 0 }).count()
    std::testing::assertEqual(c, 5 as usize, "count of evens in 1..11 should be 5")
}

struct ValueAccumulator { value: int32 }

@test
func testTerminalAdaptersCopyValues() {
    var last: int32? = (1_i32..5_i32).last()
    std::testing::assertEqual(last.unwrap(), 4, "last returns an element value")
    var nth: int32? = (1_i32..5_i32).nth(2)
    std::testing::assertEqual(nth.unwrap(), 3, "nth returns an element value")
    var total: ValueAccumulator = (1_i32..5_i32).fold(
        ValueAccumulator { value: 0 },
        (acc: ValueAccumulator, item: int32) => ValueAccumulator { value: acc.value + item },
    )
    std::testing::assertEqual(total.value, 10, "fold carries an ordinary inline accumulator")
}

@test
func testIteratorCanMapToTerminalResult() {
    var items: [int32] = [2, 3, 4]
    var last: int32? = items.iter().map((item: int32) => item + 1).last()
    std::testing::assertEqual(last.unwrap(), 5, "map output outlives its local iterator")
    std::testing::assertEqual(items.len(), 3 as usize, "source remains usable after iterator completion")
}

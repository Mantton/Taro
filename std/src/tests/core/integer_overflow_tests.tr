// Boundary cases for the overflow-tolerant integer methods. Expected values
// were computed independently with Python's arbitrary-precision integers.

import std::ops::PartialEq

func expectSome[T: PartialEq](_ actual: T?, _ expected: T, _ message: string) {
    match actual {
        case .some(value) => std::testing::assertEqual(value, expected, message)
        case .none => std::testing::fail(message)
    }
}

func expectNone[T](_ actual: T?, _ message: string) {
    std::testing::assertTrue(actual.isNone(), message)
}

func checkInt8(
    _ lhs: int8,
    _ rhs: int8,
    _ sums: (int8, int8, bool),
    _ differences: (int8, int8, bool),
    _ products: (int8, int8, bool),
    _ label: string,
) {
    // Each tuple is (wrapping, saturating, fits).
    std::testing::assertEqual(lhs.wrappingAdd(rhs), sums.0, label + " wrappingAdd")
    std::testing::assertEqual(lhs.saturatingAdd(rhs), sums.1, label + " saturatingAdd")
    if sums.2 {
        expectSome(lhs.checkedAdd(rhs), sums.0, label + " checkedAdd")
    } else {
        expectNone(lhs.checkedAdd(rhs), label + " checkedAdd")
    }
    std::testing::assertEqual(lhs.wrappingSub(rhs), differences.0, label + " wrappingSub")
    std::testing::assertEqual(lhs.saturatingSub(rhs), differences.1, label + " saturatingSub")
    if differences.2 {
        expectSome(lhs.checkedSub(rhs), differences.0, label + " checkedSub")
    } else {
        expectNone(lhs.checkedSub(rhs), label + " checkedSub")
    }
    std::testing::assertEqual(lhs.wrappingMul(rhs), products.0, label + " wrappingMul")
    std::testing::assertEqual(lhs.saturatingMul(rhs), products.1, label + " saturatingMul")
    if products.2 {
        expectSome(lhs.checkedMul(rhs), products.0, label + " checkedMul")
    } else {
        expectNone(lhs.checkedMul(rhs), label + " checkedMul")
    }
}

@test
func testInt8OverflowTolerantArithmetic() {
    checkInt8(0, 0, (0, 0, true), (0, 0, true), (0, 0, true), "int8 0, 0")
    checkInt8(1, 2, (3, 3, true), (-1, -1, true), (2, 2, true), "int8 1, 2")
    checkInt8(-5, 7, (2, 2, true), (-12, -12, true), (-35, -35, true), "int8 -5, 7")
    checkInt8(7, -5, (2, 2, true), (12, 12, true), (-35, -35, true), "int8 7, -5")
    checkInt8(-1, -1, (-2, -2, true), (0, 0, true), (1, 1, true), "int8 -1, -1")
    checkInt8(127, 1, (-128, 127, false), (126, 126, true), (127, 127, true), "int8 127, 1")
    checkInt8(-128, -1, (127, -128, false), (-127, -127, true), (-128, 127, false), "int8 -128, -1")
    checkInt8(-128, 1, (-127, -127, true), (127, -128, false), (-128, -128, true), "int8 -128, 1")
    checkInt8(127, -1, (126, 126, true), (-128, 127, false), (-127, -127, true), "int8 127, -1")
    checkInt8(-1, -128, (127, -128, false), (127, 127, true), (-128, 127, false), "int8 -1, -128")
    checkInt8(-128, 0, (-128, -128, true), (-128, -128, true), (0, 0, true), "int8 -128, 0")
    checkInt8(0, -128, (-128, -128, true), (-128, 127, false), (0, 0, true), "int8 0, -128")
    checkInt8(127, 127, (-2, 127, false), (0, 0, true), (1, 127, false), "int8 127, 127")
    checkInt8(-128, -128, (0, -128, false), (0, 0, true), (0, 127, false), "int8 -128, -128")
    checkInt8(-128, 127, (-1, -1, true), (1, -128, false), (-128, -128, false), "int8 -128, 127")
    checkInt8(127, -128, (-1, -1, true), (-1, 127, false), (-128, -128, false), "int8 127, -128")
    checkInt8(127, 2, (-127, 127, false), (125, 125, true), (-2, 127, false), "int8 127, 2")
    checkInt8(-128, 2, (-126, -126, true), (126, -128, false), (0, -128, false), "int8 -128, 2")
    checkInt8(127, 0, (127, 127, true), (127, 127, true), (0, 0, true), "int8 127, 0")
    checkInt8(0, -1, (-1, -1, true), (1, 1, true), (0, 0, true), "int8 0, -1")
    checkInt8(16, 16, (32, 32, true), (0, 0, true), (0, 127, false), "int8 16, 16")
    checkInt8(16, -16, (0, 0, true), (32, 32, true), (0, -128, false), "int8 16, -16")
    checkInt8(-16, 8, (-8, -8, true), (-24, -24, true), (-128, -128, true), "int8 -16, 8")
    checkInt8(8, 16, (24, 24, true), (-8, -8, true), (-128, 127, false), "int8 8, 16")
    checkInt8(-1, 127, (126, 126, true), (-128, -128, true), (-127, -127, true), "int8 -1, 127")
}

func checkInt16(
    _ lhs: int16,
    _ rhs: int16,
    _ sums: (int16, int16, bool),
    _ differences: (int16, int16, bool),
    _ products: (int16, int16, bool),
    _ label: string,
) {
    // Each tuple is (wrapping, saturating, fits).
    std::testing::assertEqual(lhs.wrappingAdd(rhs), sums.0, label + " wrappingAdd")
    std::testing::assertEqual(lhs.saturatingAdd(rhs), sums.1, label + " saturatingAdd")
    if sums.2 {
        expectSome(lhs.checkedAdd(rhs), sums.0, label + " checkedAdd")
    } else {
        expectNone(lhs.checkedAdd(rhs), label + " checkedAdd")
    }
    std::testing::assertEqual(lhs.wrappingSub(rhs), differences.0, label + " wrappingSub")
    std::testing::assertEqual(lhs.saturatingSub(rhs), differences.1, label + " saturatingSub")
    if differences.2 {
        expectSome(lhs.checkedSub(rhs), differences.0, label + " checkedSub")
    } else {
        expectNone(lhs.checkedSub(rhs), label + " checkedSub")
    }
    std::testing::assertEqual(lhs.wrappingMul(rhs), products.0, label + " wrappingMul")
    std::testing::assertEqual(lhs.saturatingMul(rhs), products.1, label + " saturatingMul")
    if products.2 {
        expectSome(lhs.checkedMul(rhs), products.0, label + " checkedMul")
    } else {
        expectNone(lhs.checkedMul(rhs), label + " checkedMul")
    }
}

@test
func testInt16OverflowTolerantArithmetic() {
    checkInt16(0, 0, (0, 0, true), (0, 0, true), (0, 0, true), "int16 0, 0")
    checkInt16(1, 2, (3, 3, true), (-1, -1, true), (2, 2, true), "int16 1, 2")
    checkInt16(-5, 7, (2, 2, true), (-12, -12, true), (-35, -35, true), "int16 -5, 7")
    checkInt16(7, -5, (2, 2, true), (12, 12, true), (-35, -35, true), "int16 7, -5")
    checkInt16(-1, -1, (-2, -2, true), (0, 0, true), (1, 1, true), "int16 -1, -1")
    checkInt16(32767, 1, (-32768, 32767, false), (32766, 32766, true), (32767, 32767, true), "int16 32767, 1")
    checkInt16(-32768, -1, (32767, -32768, false), (-32767, -32767, true), (-32768, 32767, false), "int16 -32768, -1")
    checkInt16(-32768, 1, (-32767, -32767, true), (32767, -32768, false), (-32768, -32768, true), "int16 -32768, 1")
    checkInt16(32767, -1, (32766, 32766, true), (-32768, 32767, false), (-32767, -32767, true), "int16 32767, -1")
    checkInt16(-1, -32768, (32767, -32768, false), (32767, 32767, true), (-32768, 32767, false), "int16 -1, -32768")
    checkInt16(-32768, 0, (-32768, -32768, true), (-32768, -32768, true), (0, 0, true), "int16 -32768, 0")
    checkInt16(0, -32768, (-32768, -32768, true), (-32768, 32767, false), (0, 0, true), "int16 0, -32768")
    checkInt16(32767, 32767, (-2, 32767, false), (0, 0, true), (1, 32767, false), "int16 32767, 32767")
    checkInt16(-32768, -32768, (0, -32768, false), (0, 0, true), (0, 32767, false), "int16 -32768, -32768")
    checkInt16(-32768, 32767, (-1, -1, true), (1, -32768, false), (-32768, -32768, false), "int16 -32768, 32767")
    checkInt16(32767, -32768, (-1, -1, true), (-1, 32767, false), (-32768, -32768, false), "int16 32767, -32768")
    checkInt16(32767, 2, (-32767, 32767, false), (32765, 32765, true), (-2, 32767, false), "int16 32767, 2")
    checkInt16(-32768, 2, (-32766, -32766, true), (32766, -32768, false), (0, -32768, false), "int16 -32768, 2")
    checkInt16(32767, 0, (32767, 32767, true), (32767, 32767, true), (0, 0, true), "int16 32767, 0")
    checkInt16(0, -1, (-1, -1, true), (1, 1, true), (0, 0, true), "int16 0, -1")
    checkInt16(256, 256, (512, 512, true), (0, 0, true), (0, 32767, false), "int16 256, 256")
    checkInt16(256, -256, (0, 0, true), (512, 512, true), (0, -32768, false), "int16 256, -256")
    checkInt16(-256, 128, (-128, -128, true), (-384, -384, true), (-32768, -32768, true), "int16 -256, 128")
    checkInt16(128, 256, (384, 384, true), (-128, -128, true), (-32768, 32767, false), "int16 128, 256")
    checkInt16(-1, 32767, (32766, 32766, true), (-32768, -32768, true), (-32767, -32767, true), "int16 -1, 32767")
}


@test
func testUint16OverflowTolerantArithmetic() {
    checkUint16(0, 0, (0, 0, true), (0, 0, true), (0, 0, true), "uint16 0, 0")
    checkUint16(1, 2, (3, 3, true), (65535, 0, false), (2, 2, true), "uint16 1, 2")
    checkUint16(7, 5, (12, 12, true), (2, 2, true), (35, 35, true), "uint16 7, 5")
    checkUint16(0, 1, (1, 1, true), (65535, 0, false), (0, 0, true), "uint16 0, 1")
    checkUint16(65535, 1, (0, 65535, false), (65534, 65534, true), (65535, 65535, true), "uint16 65535, 1")
    checkUint16(65535, 65535, (65534, 65535, false), (0, 0, true), (1, 65535, false), "uint16 65535, 65535")
    checkUint16(65535, 0, (65535, 65535, true), (65535, 65535, true), (0, 0, true), "uint16 65535, 0")
    checkUint16(0, 65535, (65535, 65535, true), (1, 0, false), (0, 0, true), "uint16 0, 65535")
    checkUint16(1, 65535, (0, 65535, false), (2, 0, false), (65535, 65535, true), "uint16 1, 65535")
    checkUint16(65535, 2, (1, 65535, false), (65533, 65533, true), (65534, 65535, false), "uint16 65535, 2")
    checkUint16(256, 256, (512, 512, true), (0, 0, true), (0, 65535, false), "uint16 256, 256")
    checkUint16(255, 257, (512, 512, true), (65534, 0, false), (65535, 65535, true), "uint16 255, 257")
    checkUint16(128, 256, (384, 384, true), (65408, 0, false), (32768, 32768, true), "uint16 128, 256")
    checkUint16(2, 32768, (32770, 32770, true), (32770, 0, false), (0, 65535, false), "uint16 2, 32768")
    checkUint16(65535, 65534, (65533, 65535, false), (1, 1, true), (2, 65535, false), "uint16 65535, 65534")
}


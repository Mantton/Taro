@test
func testInt32OverflowTolerantArithmetic() {
    checkInt32(0, 0, (0, 0, true), (0, 0, true), (0, 0, true), "int32 0, 0")
    checkInt32(1, 2, (3, 3, true), (-1, -1, true), (2, 2, true), "int32 1, 2")
    checkInt32(-5, 7, (2, 2, true), (-12, -12, true), (-35, -35, true), "int32 -5, 7")
    checkInt32(7, -5, (2, 2, true), (12, 12, true), (-35, -35, true), "int32 7, -5")
    checkInt32(-1, -1, (-2, -2, true), (0, 0, true), (1, 1, true), "int32 -1, -1")
    checkInt32(2147483647, 1, (-2147483648, 2147483647, false), (2147483646, 2147483646, true), (2147483647, 2147483647, true), "int32 2147483647, 1")
    checkInt32(-2147483648, -1, (2147483647, -2147483648, false), (-2147483647, -2147483647, true), (-2147483648, 2147483647, false), "int32 -2147483648, -1")
    checkInt32(-2147483648, 1, (-2147483647, -2147483647, true), (2147483647, -2147483648, false), (-2147483648, -2147483648, true), "int32 -2147483648, 1")
    checkInt32(2147483647, -1, (2147483646, 2147483646, true), (-2147483648, 2147483647, false), (-2147483647, -2147483647, true), "int32 2147483647, -1")
    checkInt32(-1, -2147483648, (2147483647, -2147483648, false), (2147483647, 2147483647, true), (-2147483648, 2147483647, false), "int32 -1, -2147483648")
    checkInt32(-2147483648, 0, (-2147483648, -2147483648, true), (-2147483648, -2147483648, true), (0, 0, true), "int32 -2147483648, 0")
    checkInt32(0, -2147483648, (-2147483648, -2147483648, true), (-2147483648, 2147483647, false), (0, 0, true), "int32 0, -2147483648")
    checkInt32(2147483647, 2147483647, (-2, 2147483647, false), (0, 0, true), (1, 2147483647, false), "int32 2147483647, 2147483647")
    checkInt32(-2147483648, -2147483648, (0, -2147483648, false), (0, 0, true), (0, 2147483647, false), "int32 -2147483648, -2147483648")
    checkInt32(-2147483648, 2147483647, (-1, -1, true), (1, -2147483648, false), (-2147483648, -2147483648, false), "int32 -2147483648, 2147483647")
    checkInt32(2147483647, -2147483648, (-1, -1, true), (-1, 2147483647, false), (-2147483648, -2147483648, false), "int32 2147483647, -2147483648")
    checkInt32(2147483647, 2, (-2147483647, 2147483647, false), (2147483645, 2147483645, true), (-2, 2147483647, false), "int32 2147483647, 2")
    checkInt32(-2147483648, 2, (-2147483646, -2147483646, true), (2147483646, -2147483648, false), (0, -2147483648, false), "int32 -2147483648, 2")
    checkInt32(2147483647, 0, (2147483647, 2147483647, true), (2147483647, 2147483647, true), (0, 0, true), "int32 2147483647, 0")
    checkInt32(0, -1, (-1, -1, true), (1, 1, true), (0, 0, true), "int32 0, -1")
    checkInt32(65536, 65536, (131072, 131072, true), (0, 0, true), (0, 2147483647, false), "int32 65536, 65536")
    checkInt32(65536, -65536, (0, 0, true), (131072, 131072, true), (0, -2147483648, false), "int32 65536, -65536")
    checkInt32(-65536, 32768, (-32768, -32768, true), (-98304, -98304, true), (-2147483648, -2147483648, true), "int32 -65536, 32768")
    checkInt32(32768, 65536, (98304, 98304, true), (-32768, -32768, true), (-2147483648, 2147483647, false), "int32 32768, 65536")
    checkInt32(-1, 2147483647, (2147483646, 2147483646, true), (-2147483648, -2147483648, true), (-2147483647, -2147483647, true), "int32 -1, 2147483647")
}


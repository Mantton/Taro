    checkIsize(-9223372036854775808, 1, (-9223372036854775807, -9223372036854775807, true), (9223372036854775807, -9223372036854775808, false), (-9223372036854775808, -9223372036854775808, true), "isize -9223372036854775808, 1")
    checkIsize(9223372036854775807, -1, (9223372036854775806, 9223372036854775806, true), (-9223372036854775808, 9223372036854775807, false), (-9223372036854775807, -9223372036854775807, true), "isize 9223372036854775807, -1")
    checkIsize(-1, -9223372036854775808, (9223372036854775807, -9223372036854775808, false), (9223372036854775807, 9223372036854775807, true), (-9223372036854775808, 9223372036854775807, false), "isize -1, -9223372036854775808")
    checkIsize(-9223372036854775808, 0, (-9223372036854775808, -9223372036854775808, true), (-9223372036854775808, -9223372036854775808, true), (0, 0, true), "isize -9223372036854775808, 0")
    checkIsize(0, -9223372036854775808, (-9223372036854775808, -9223372036854775808, true), (-9223372036854775808, 9223372036854775807, false), (0, 0, true), "isize 0, -9223372036854775808")
    checkIsize(9223372036854775807, 9223372036854775807, (-2, 9223372036854775807, false), (0, 0, true), (1, 9223372036854775807, false), "isize 9223372036854775807, 9223372036854775807")
    checkIsize(-9223372036854775808, -9223372036854775808, (0, -9223372036854775808, false), (0, 0, true), (0, 9223372036854775807, false), "isize -9223372036854775808, -9223372036854775808")
    checkIsize(-9223372036854775808, 9223372036854775807, (-1, -1, true), (1, -9223372036854775808, false), (-9223372036854775808, -9223372036854775808, false), "isize -9223372036854775808, 9223372036854775807")
    checkIsize(9223372036854775807, -9223372036854775808, (-1, -1, true), (-1, 9223372036854775807, false), (-9223372036854775808, -9223372036854775808, false), "isize 9223372036854775807, -9223372036854775808")
    checkIsize(9223372036854775807, 2, (-9223372036854775807, 9223372036854775807, false), (9223372036854775805, 9223372036854775805, true), (-2, 9223372036854775807, false), "isize 9223372036854775807, 2")
    checkIsize(-9223372036854775808, 2, (-9223372036854775806, -9223372036854775806, true), (9223372036854775806, -9223372036854775808, false), (0, -9223372036854775808, false), "isize -9223372036854775808, 2")
    checkIsize(9223372036854775807, 0, (9223372036854775807, 9223372036854775807, true), (9223372036854775807, 9223372036854775807, true), (0, 0, true), "isize 9223372036854775807, 0")
    checkIsize(0, -1, (-1, -1, true), (1, 1, true), (0, 0, true), "isize 0, -1")
    checkIsize(4294967296, 4294967296, (8589934592, 8589934592, true), (0, 0, true), (0, 9223372036854775807, false), "isize 4294967296, 4294967296")
    checkIsize(4294967296, -4294967296, (0, 0, true), (8589934592, 8589934592, true), (0, -9223372036854775808, false), "isize 4294967296, -4294967296")
    checkIsize(-4294967296, 2147483648, (-2147483648, -2147483648, true), (-6442450944, -6442450944, true), (-9223372036854775808, -9223372036854775808, true), "isize -4294967296, 2147483648")
    checkIsize(2147483648, 4294967296, (6442450944, 6442450944, true), (-2147483648, -2147483648, true), (-9223372036854775808, 9223372036854775807, false), "isize 2147483648, 4294967296")
    checkIsize(-1, 9223372036854775807, (9223372036854775806, 9223372036854775806, true), (-9223372036854775808, -9223372036854775808, true), (-9223372036854775807, -9223372036854775807, true), "isize -1, 9223372036854775807")
}

func checkUint8(
    _ lhs: uint8,
    _ rhs: uint8,
    _ sums: (uint8, uint8, bool),
    _ differences: (uint8, uint8, bool),
    _ products: (uint8, uint8, bool),
    _ label: string,
) {
    // Each tuple is (wrapping, saturating, fits).
    std::testing::assertEqual(lhs.wrappingAdd(rhs), sums.0, label + " wrappingAdd")
    std::testing::assertEqual(lhs.saturatingAdd(rhs), sums.1, label + " saturatingAdd")
    if sums.2 {
        expectSome(lhs.checkedAdd(rhs), sums.0, label + " checkedAdd")
    } else {
        expectNone(lhs.checkedAdd(rhs), label + " checkedAdd")
    }
    std::testing::assertEqual(lhs.wrappingSub(rhs), differences.0, label + " wrappingSub")
    std::testing::assertEqual(lhs.saturatingSub(rhs), differences.1, label + " saturatingSub")
    if differences.2 {
        expectSome(lhs.checkedSub(rhs), differences.0, label + " checkedSub")
    } else {
        expectNone(lhs.checkedSub(rhs), label + " checkedSub")
    }
    std::testing::assertEqual(lhs.wrappingMul(rhs), products.0, label + " wrappingMul")
    std::testing::assertEqual(lhs.saturatingMul(rhs), products.1, label + " saturatingMul")
    if products.2 {
        expectSome(lhs.checkedMul(rhs), products.0, label + " checkedMul")
    } else {
        expectNone(lhs.checkedMul(rhs), label + " checkedMul")
    }
}

@test
func testUint8OverflowTolerantArithmetic() {
    checkUint8(0, 0, (0, 0, true), (0, 0, true), (0, 0, true), "uint8 0, 0")
    checkUint8(1, 2, (3, 3, true), (255, 0, false), (2, 2, true), "uint8 1, 2")
    checkUint8(7, 5, (12, 12, true), (2, 2, true), (35, 35, true), "uint8 7, 5")
    checkUint8(0, 1, (1, 1, true), (255, 0, false), (0, 0, true), "uint8 0, 1")
    checkUint8(255, 1, (0, 255, false), (254, 254, true), (255, 255, true), "uint8 255, 1")
    checkUint8(255, 255, (254, 255, false), (0, 0, true), (1, 255, false), "uint8 255, 255")
    checkUint8(255, 0, (255, 255, true), (255, 255, true), (0, 0, true), "uint8 255, 0")
    checkUint8(0, 255, (255, 255, true), (1, 0, false), (0, 0, true), "uint8 0, 255")
    checkUint8(1, 255, (0, 255, false), (2, 0, false), (255, 255, true), "uint8 1, 255")
    checkUint8(255, 2, (1, 255, false), (253, 253, true), (254, 255, false), "uint8 255, 2")
    checkUint8(16, 16, (32, 32, true), (0, 0, true), (0, 255, false), "uint8 16, 16")
    checkUint8(15, 17, (32, 32, true), (254, 0, false), (255, 255, true), "uint8 15, 17")
    checkUint8(8, 16, (24, 24, true), (248, 0, false), (128, 128, true), "uint8 8, 16")
    checkUint8(2, 128, (130, 130, true), (130, 0, false), (0, 255, false), "uint8 2, 128")
    checkUint8(255, 254, (253, 255, false), (1, 1, true), (2, 255, false), "uint8 255, 254")
}


@test
func testUint64OverflowTolerantArithmetic() {
    checkUint64(0, 0, (0, 0, true), (0, 0, true), (0, 0, true), "uint64 0, 0")
    checkUint64(1, 2, (3, 3, true), (18446744073709551615, 0, false), (2, 2, true), "uint64 1, 2")
    checkUint64(7, 5, (12, 12, true), (2, 2, true), (35, 35, true), "uint64 7, 5")
    checkUint64(0, 1, (1, 1, true), (18446744073709551615, 0, false), (0, 0, true), "uint64 0, 1")
    checkUint64(18446744073709551615, 1, (0, 18446744073709551615, false), (18446744073709551614, 18446744073709551614, true), (18446744073709551615, 18446744073709551615, true), "uint64 18446744073709551615, 1")
    checkUint64(18446744073709551615, 18446744073709551615, (18446744073709551614, 18446744073709551615, false), (0, 0, true), (1, 18446744073709551615, false), "uint64 18446744073709551615, 18446744073709551615")
    checkUint64(18446744073709551615, 0, (18446744073709551615, 18446744073709551615, true), (18446744073709551615, 18446744073709551615, true), (0, 0, true), "uint64 18446744073709551615, 0")
    checkUint64(0, 18446744073709551615, (18446744073709551615, 18446744073709551615, true), (1, 0, false), (0, 0, true), "uint64 0, 18446744073709551615")
    checkUint64(1, 18446744073709551615, (0, 18446744073709551615, false), (2, 0, false), (18446744073709551615, 18446744073709551615, true), "uint64 1, 18446744073709551615")
    checkUint64(18446744073709551615, 2, (1, 18446744073709551615, false), (18446744073709551613, 18446744073709551613, true), (18446744073709551614, 18446744073709551615, false), "uint64 18446744073709551615, 2")
    checkUint64(4294967296, 4294967296, (8589934592, 8589934592, true), (0, 0, true), (0, 18446744073709551615, false), "uint64 4294967296, 4294967296")
    checkUint64(4294967295, 4294967297, (8589934592, 8589934592, true), (18446744073709551614, 0, false), (18446744073709551615, 18446744073709551615, true), "uint64 4294967295, 4294967297")
    checkUint64(2147483648, 4294967296, (6442450944, 6442450944, true), (18446744071562067968, 0, false), (9223372036854775808, 9223372036854775808, true), "uint64 2147483648, 4294967296")
    checkUint64(2, 9223372036854775808, (9223372036854775810, 9223372036854775810, true), (9223372036854775810, 0, false), (0, 18446744073709551615, false), "uint64 2, 9223372036854775808")
    checkUint64(18446744073709551615, 18446744073709551614, (18446744073709551613, 18446744073709551615, false), (1, 1, true), (2, 18446744073709551615, false), "uint64 18446744073709551615, 18446744073709551614")
}


@test
func testUint32OverflowTolerantArithmetic() {
    checkUint32(0, 0, (0, 0, true), (0, 0, true), (0, 0, true), "uint32 0, 0")
    checkUint32(1, 2, (3, 3, true), (4294967295, 0, false), (2, 2, true), "uint32 1, 2")
    checkUint32(7, 5, (12, 12, true), (2, 2, true), (35, 35, true), "uint32 7, 5")
    checkUint32(0, 1, (1, 1, true), (4294967295, 0, false), (0, 0, true), "uint32 0, 1")
    checkUint32(4294967295, 1, (0, 4294967295, false), (4294967294, 4294967294, true), (4294967295, 4294967295, true), "uint32 4294967295, 1")
    checkUint32(4294967295, 4294967295, (4294967294, 4294967295, false), (0, 0, true), (1, 4294967295, false), "uint32 4294967295, 4294967295")
    checkUint32(4294967295, 0, (4294967295, 4294967295, true), (4294967295, 4294967295, true), (0, 0, true), "uint32 4294967295, 0")
    checkUint32(0, 4294967295, (4294967295, 4294967295, true), (1, 0, false), (0, 0, true), "uint32 0, 4294967295")
    checkUint32(1, 4294967295, (0, 4294967295, false), (2, 0, false), (4294967295, 4294967295, true), "uint32 1, 4294967295")
    checkUint32(4294967295, 2, (1, 4294967295, false), (4294967293, 4294967293, true), (4294967294, 4294967295, false), "uint32 4294967295, 2")
    checkUint32(65536, 65536, (131072, 131072, true), (0, 0, true), (0, 4294967295, false), "uint32 65536, 65536")
    checkUint32(65535, 65537, (131072, 131072, true), (4294967294, 0, false), (4294967295, 4294967295, true), "uint32 65535, 65537")
    checkUint32(32768, 65536, (98304, 98304, true), (4294934528, 0, false), (2147483648, 2147483648, true), "uint32 32768, 65536")
    checkUint32(2, 2147483648, (2147483650, 2147483650, true), (2147483650, 0, false), (0, 4294967295, false), "uint32 2, 2147483648")
    checkUint32(4294967295, 4294967294, (4294967293, 4294967295, false), (1, 1, true), (2, 4294967295, false), "uint32 4294967295, 4294967294")
}


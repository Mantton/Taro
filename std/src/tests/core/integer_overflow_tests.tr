@test
func testInt64OverflowTolerantArithmetic() {
    checkInt64(0, 0, (0, 0, true), (0, 0, true), (0, 0, true), "int64 0, 0")
    checkInt64(1, 2, (3, 3, true), (-1, -1, true), (2, 2, true), "int64 1, 2")
    checkInt64(-5, 7, (2, 2, true), (-12, -12, true), (-35, -35, true), "int64 -5, 7")
    checkInt64(7, -5, (2, 2, true), (12, 12, true), (-35, -35, true), "int64 7, -5")
    checkInt64(-1, -1, (-2, -2, true), (0, 0, true), (1, 1, true), "int64 -1, -1")
    checkInt64(9223372036854775807, 1, (-9223372036854775808, 9223372036854775807, false), (9223372036854775806, 9223372036854775806, true), (9223372036854775807, 9223372036854775807, true), "int64 9223372036854775807, 1")
    checkInt64(-9223372036854775808, -1, (9223372036854775807, -9223372036854775808, false), (-9223372036854775807, -9223372036854775807, true), (-9223372036854775808, 9223372036854775807, false), "int64 -9223372036854775808, -1")
    checkInt64(-9223372036854775808, 1, (-9223372036854775807, -9223372036854775807, true), (9223372036854775807, -9223372036854775808, false), (-9223372036854775808, -9223372036854775808, true), "int64 -9223372036854775808, 1")
    checkInt64(9223372036854775807, -1, (9223372036854775806, 9223372036854775806, true), (-9223372036854775808, 9223372036854775807, false), (-9223372036854775807, -9223372036854775807, true), "int64 9223372036854775807, -1")
    checkInt64(-1, -9223372036854775808, (9223372036854775807, -9223372036854775808, false), (9223372036854775807, 9223372036854775807, true), (-9223372036854775808, 9223372036854775807, false), "int64 -1, -9223372036854775808")
    checkInt64(-9223372036854775808, 0, (-9223372036854775808, -9223372036854775808, true), (-9223372036854775808, -9223372036854775808, true), (0, 0, true), "int64 -9223372036854775808, 0")
    checkInt64(0, -9223372036854775808, (-9223372036854775808, -9223372036854775808, true), (-9223372036854775808, 9223372036854775807, false), (0, 0, true), "int64 0, -9223372036854775808")
    checkInt64(9223372036854775807, 9223372036854775807, (-2, 9223372036854775807, false), (0, 0, true), (1, 9223372036854775807, false), "int64 9223372036854775807, 9223372036854775807")
    checkInt64(-9223372036854775808, -9223372036854775808, (0, -9223372036854775808, false), (0, 0, true), (0, 9223372036854775807, false), "int64 -9223372036854775808, -9223372036854775808")
    checkInt64(-9223372036854775808, 9223372036854775807, (-1, -1, true), (1, -9223372036854775808, false), (-9223372036854775808, -9223372036854775808, false), "int64 -9223372036854775808, 9223372036854775807")
    checkInt64(9223372036854775807, -9223372036854775808, (-1, -1, true), (-1, 9223372036854775807, false), (-9223372036854775808, -9223372036854775808, false), "int64 9223372036854775807, -9223372036854775808")
    checkInt64(9223372036854775807, 2, (-9223372036854775807, 9223372036854775807, false), (9223372036854775805, 9223372036854775805, true), (-2, 9223372036854775807, false), "int64 9223372036854775807, 2")
    checkInt64(-9223372036854775808, 2, (-9223372036854775806, -9223372036854775806, true), (9223372036854775806, -9223372036854775808, false), (0, -9223372036854775808, false), "int64 -9223372036854775808, 2")
    checkInt64(9223372036854775807, 0, (9223372036854775807, 9223372036854775807, true), (9223372036854775807, 9223372036854775807, true), (0, 0, true), "int64 9223372036854775807, 0")
    checkInt64(0, -1, (-1, -1, true), (1, 1, true), (0, 0, true), "int64 0, -1")
    checkInt64(4294967296, 4294967296, (8589934592, 8589934592, true), (0, 0, true), (0, 9223372036854775807, false), "int64 4294967296, 4294967296")
    checkInt64(4294967296, -4294967296, (0, 0, true), (8589934592, 8589934592, true), (0, -9223372036854775808, false), "int64 4294967296, -4294967296")
    checkInt64(-4294967296, 2147483648, (-2147483648, -2147483648, true), (-6442450944, -6442450944, true), (-9223372036854775808, -9223372036854775808, true), "int64 -4294967296, 2147483648")
    checkInt64(2147483648, 4294967296, (6442450944, 6442450944, true), (-2147483648, -2147483648, true), (-9223372036854775808, 9223372036854775807, false), "int64 2147483648, 4294967296")
    checkInt64(-1, 9223372036854775807, (9223372036854775806, 9223372036854775806, true), (-9223372036854775808, -9223372036854775808, true), (-9223372036854775807, -9223372036854775807, true), "int64 -1, 9223372036854775807")
}

func checkIsize(
    _ lhs: isize,
    _ rhs: isize,
    _ sums: (isize, isize, bool),
    _ differences: (isize, isize, bool),
    _ products: (isize, isize, bool),
    _ label: string,
) {
    // Each tuple is (wrapping, saturating, fits).
    std::testing::assertEqual(lhs.wrappingAdd(rhs), sums.0, label + " wrappingAdd")
    std::testing::assertEqual(lhs.saturatingAdd(rhs), sums.1, label + " saturatingAdd")
    if sums.2 {
        expectSome(lhs.checkedAdd(rhs), sums.0, label + " checkedAdd")
    } else {
        expectNone(lhs.checkedAdd(rhs), label + " checkedAdd")
    }
    std::testing::assertEqual(lhs.wrappingSub(rhs), differences.0, label + " wrappingSub")
    std::testing::assertEqual(lhs.saturatingSub(rhs), differences.1, label + " saturatingSub")
    if differences.2 {
        expectSome(lhs.checkedSub(rhs), differences.0, label + " checkedSub")
    } else {
        expectNone(lhs.checkedSub(rhs), label + " checkedSub")
    }
    std::testing::assertEqual(lhs.wrappingMul(rhs), products.0, label + " wrappingMul")
    std::testing::assertEqual(lhs.saturatingMul(rhs), products.1, label + " saturatingMul")
    if products.2 {
        expectSome(lhs.checkedMul(rhs), products.0, label + " checkedMul")
    } else {
        expectNone(lhs.checkedMul(rhs), label + " checkedMul")
    }
}

@test
func testIsizeOverflowTolerantArithmetic() {

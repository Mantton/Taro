    checkUsize(0, 1, (1, 1, true), (18446744073709551615, 0, false), (0, 0, true), "usize 0, 1")
    checkUsize(18446744073709551615, 1, (0, 18446744073709551615, false), (18446744073709551614, 18446744073709551614, true), (18446744073709551615, 18446744073709551615, true), "usize 18446744073709551615, 1")
    checkUsize(18446744073709551615, 18446744073709551615, (18446744073709551614, 18446744073709551615, false), (0, 0, true), (1, 18446744073709551615, false), "usize 18446744073709551615, 18446744073709551615")
    checkUsize(18446744073709551615, 0, (18446744073709551615, 18446744073709551615, true), (18446744073709551615, 18446744073709551615, true), (0, 0, true), "usize 18446744073709551615, 0")
    checkUsize(0, 18446744073709551615, (18446744073709551615, 18446744073709551615, true), (1, 0, false), (0, 0, true), "usize 0, 18446744073709551615")
    checkUsize(1, 18446744073709551615, (0, 18446744073709551615, false), (2, 0, false), (18446744073709551615, 18446744073709551615, true), "usize 1, 18446744073709551615")
    checkUsize(18446744073709551615, 2, (1, 18446744073709551615, false), (18446744073709551613, 18446744073709551613, true), (18446744073709551614, 18446744073709551615, false), "usize 18446744073709551615, 2")
    checkUsize(4294967296, 4294967296, (8589934592, 8589934592, true), (0, 0, true), (0, 18446744073709551615, false), "usize 4294967296, 4294967296")
    checkUsize(4294967295, 4294967297, (8589934592, 8589934592, true), (18446744073709551614, 0, false), (18446744073709551615, 18446744073709551615, true), "usize 4294967295, 4294967297")
    checkUsize(2147483648, 4294967296, (6442450944, 6442450944, true), (18446744071562067968, 0, false), (9223372036854775808, 9223372036854775808, true), "usize 2147483648, 4294967296")
    checkUsize(2, 9223372036854775808, (9223372036854775810, 9223372036854775810, true), (9223372036854775810, 0, false), (0, 18446744073709551615, false), "usize 2, 9223372036854775808")
    checkUsize(18446744073709551615, 18446744073709551614, (18446744073709551613, 18446744073709551615, false), (1, 1, true), (2, 18446744073709551615, false), "usize 18446744073709551615, 18446744073709551614")
}

@cfg(profile("debug"))
@test
@expectPanic("attempt to add with overflow")
func testStdDebugOverflowTraps() {
    lhs := std::hint::blackBox(255_u8)
    rhs := std::hint::blackBox(1_u8)
    var _ = lhs + rhs
}

@cfg(family("unix"))
@test
func channelTrySendAndTryRecv() async {
    let channelRes = std.sync.bounded[int32](1)
    let (sender, receiver) = match channelRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("bounded channel create should succeed")
    }

    match sender.trySend(41_i32) {
        case .ok(_) => {}
        case .err(_) => std.panic.panic("first trySend should succeed")
    }

    let fullRes = sender.trySend(42_i32)
    match fullRes {
        case .ok(_) => std.panic.panic("second trySend should be full")
        case .err(err) => match err {
            case .full => {}
            case _ => std.panic.panic("expected .full from second trySend")
        }
    }

    let recvRes = receiver.tryRecv()
    let first = match recvRes {
        case .ok(.some(value)) => value
        case .ok(.none) => std.panic.panic("channel should still contain one value")
        case .err(_) => std.panic.panic("tryRecv should succeed with a value")
    }
    std.testing.assertEqual(first, 41_i32, "channel should return the queued value")

    let emptyRes = receiver.tryRecv()
    match emptyRes {
        case .ok(_) => std.panic.panic("empty channel tryRecv should report .empty")
        case .err(err) => match err {
            case .empty => {}
            case _ => std.panic.panic("expected .empty from empty tryRecv")
        }
    }

    match sender.trySend(43_i32) {
        case .ok(_) => {}
        case .err(_) => std.panic.panic("buffered send before close should succeed")
    }
    std.testing.assertTrue(sender.close().isOk(), "channel close should succeed")

    match sender.trySend(44_i32) {
        case .ok(_) => std.panic.panic("send after close should fail")
        case .err(err) => match err {
            case .closed => {}
            case _ => std.panic.panic("send after close should return .closed")
        }
    }

    match await sender.send(45_i32) {
        case .ok(_) => std.panic.panic("async send after close should fail")
        case .err(err) => match err {
            case .closed => {}
            case _ => std.panic.panic("async send after close should return .closed")
        }
    }

    let buffered = await receiver.recv()
    match buffered {
        case .none => std.panic.panic("close should preserve buffered values")
        case .some(value) => std.testing.assertEqual(value, 43_i32, "close should preserve FIFO values")
    }

    let drained = await receiver.recv()
    match drained {
        case .none => {}
        case .some(_) => std.panic.panic("closed+drained channel recv should return none")
    }
}

@cfg(family("unix"))
func enqueueGcString(_ sender: std.sync.Sender[string]) {
    let message = std.sprintf("queued %v", 42_i32)
    match sender.trySend(message) {
        case .ok(_) => {}
        case .err(_) => std.panic.panic("string send should succeed")
    }
}

@cfg(family("unix"))
@test
func channelRootsQueuedGcValues() async {
    let (sender, receiver) = match std.sync.bounded[string](1) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("channel create should succeed")
    }

    enqueueGcString(sender)
    std.runtime.collect()

    let received = match await receiver.recv() {
        case .some(value) => value
        case .none => std.panic.panic("queued string should remain available")
    }
    std.testing.assertEqual(received, "queued 42", "queued GC values should survive collection")
}

@cfg(family("unix"))
@test
func channelRecvWakeOnClose() async {
    let (sender, receiver) = match std.sync.bounded[int32](1) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("channel create should succeed")
    }

    let waiting = receiver
    let waiter = std.task.spawn(|| async {
        let value = await waiting.recv()
        match value {
            case .none => return 1_i32
            case .some(_) => return 0_i32
        }
    })

    await std.testing.yieldNow()
    std.testing.assertTrue(sender.close().isOk(), "close should wake recv waiters")

    let waited = (await waiter.result()).unwrap()
    std.testing.assertEqual(waited, 1_i32, "waiter should observe channel closure")
}

@cfg(family("unix"))
@test
func mutexGuardAndWithLock() async {
    let mutexRes = std.sync.Mutex[int32].new(7_i32)
    let mutex = match mutexRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("mutex create should succeed")
    }

    let guardRes = await mutex.lock()
    var held = match guardRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("mutex lock should succeed")
    }

    *held.value() = 10_i32

    let nestedTry = mutex.tryLock()
    match nestedTry {
        case .ok(_) => std.panic.panic("nested tryLock should report wouldBlock")
        case .err(err) => {
            std.testing.assertTrue(err.isKind(.wouldBlock), "nested tryLock should return wouldBlock")
        }
    }

    std.testing.assertTrue(held.unlock().isOk(), "mutex unlock should succeed")

    let withLockRes: std.result.Result[int32, std.io.Error] = await mutex.withLock(|value: &mut int32| {
        *value = *value + 1_i32
        return *value
    })
    let updated = match withLockRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("withLock should succeed")
    }
    std.testing.assertEqual(updated, 11_i32, "withLock should mutate and return state")

    var reacquired = match mutex.tryLock() {
        case .ok(value) => value
        case .err(_) => std.panic.panic("withLock should release its guard with defer")
    }
    std.testing.assertTrue(reacquired.unlock().isOk(), "reacquired mutex should unlock")

}

@cfg(family("unix"))
@test
func rwlockReadWriteGuardsAndTryMethods() async {
    let lockRes = std.sync.RwLock[int32].new(5_i32)
    let lock = match lockRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("rwlock create should succeed")
    }

    let readGuardRes = await lock.read()
    var readGuard = match readGuardRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("read lock should succeed")
    }

    std.testing.assertEqual(*readGuard.value(), 5_i32, "read guard should see initial value")

    let blockedWrite = lock.tryWrite()
    match blockedWrite {
        case .ok(_) => std.panic.panic("tryWrite should block while read guard is held")
        case .err(err) => std.testing.assertTrue(err.isKind(.wouldBlock), "tryWrite should return wouldBlock")
    }

    std.testing.assertTrue(readGuard.unlock().isOk(), "read unlock should succeed")

    let writeGuardRes = await lock.write()
    var writeGuard = match writeGuardRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("write lock should succeed")
    }
    *writeGuard.value() = 17_i32
    std.testing.assertTrue(writeGuard.unlock().isOk(), "write unlock should succeed")

    let afterRes: std.result.Result[int32, std.io.Error] = await lock.withRead(|value: &int32| {
        return *value
    })
    let after = match afterRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("withRead should succeed")
    }
    std.testing.assertEqual(after, 17_i32, "write guard mutation should be observable")

    let withWriteRes: std.result.Result[int32, std.io.Error] = await lock.withWrite(|value: &mut int32| {
        *value = *value + 1_i32
        return *value
    })
    let written = match withWriteRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("withWrite should succeed")
    }
    std.testing.assertEqual(written, 18_i32, "withWrite should mutate and return state")

    var finalRead = match lock.tryRead() {
        case .ok(value) => value
        case .err(_) => std.panic.panic("scoped rwlock helpers should release their guards")
    }
    std.testing.assertEqual(*finalRead.value(), 18_i32, "released write should be visible")
    std.testing.assertTrue(finalRead.unlock().isOk(), "final read guard should unlock")

}

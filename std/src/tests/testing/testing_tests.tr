// Basic smoke test for the test harness: @test, @skip, @expectPanic.

@test
func testPasses() {
    std::testing::assertEqual(1 + 1, 2, "1 + 1 should be 2")
}

@test
@expectPanic("intent")
func testExpectPanic() {
    std::panic::panic("intentional")
}

@test
@expectPanic("assert should")
func testAssertPanics() {
    std::assert(false, "assert should panic")
}

@test
@skip
func testSkipped() {
    std::testing::fail("should never run")
}

@cfg(profile("debug"))
func profileName() -> string {
    "debug"
}

@cfg(profile("release"))
func profileName() -> string {
    "release"
}

@test
func testDebugAssertProfileCfg() {
    isDebug := #cfg(profile("debug"))
    isRelease := #cfg(profile("release"))

    std::testing::assertTrue(
        isDebug || isRelease,
        "expected either debug or release profile cfg to be true",
    )
    std::testing::assertFalse(
        isDebug && isRelease,
        "debug and release profile cfg cannot both be true",
    )

    if isDebug {
        std::testing::assertTrue(
            std::string::stringEq(profileName(), "debug"),
            "profile-selected declaration should be debug variant",
        )
    } else {
        std::testing::assertTrue(
            std::string::stringEq(profileName(), "release"),
            "profile-selected declaration should be release variant",
        )
    }

    std::debugAssert(true, "debug assert should not panic")
}

@tag("smoke")
namespace TaggedNamespace {
    @test
    func testNamespaceTagInheritance() {
        std::testing::assertTrue(true, "namespace tag smoke should be inherited")
    }

    @tag("slow")
    namespace Nested {
        @test
        @tag("unit")
        func testNestedNamespaceTagInheritance() {
            std::testing::assertTrue(true, "nested namespace tags should be inherited")
        }
    }
}

@test
@tag("SMOKE")
func testFunctionTagSyntax() {
    std::testing::assertTrue(true, "function-level @tag(\"...\") should be accepted")
}

@test
func allocationMeasurementCountsOnlyTheSynchronousCall() {
    values := std::collections::List[uint8]::new()
    count := std::testing::allocations(() => {
        values.reserve(65536)
        values.append(1)
        std::runtime::collect()
    })
    std::testing::assertTrue(count > 0, "reserve allocates managed backing storage")
    std::testing::assertEqual(values.len(), 1, "the measured function runs once")
    empty := std::testing::allocations(() => { values.append(2) })
    std::testing::assertEqual(empty, 0_u64, "a reserved append allocates nothing")
    std::testing::assertEqual(values.len(), 2, "the second operation ran")

    var nested: uint64 = 0
    grow := () => { values.reserve(1048576) }
    outer := std::testing::allocations(() => { nested = std::testing::allocations(grow) })
    std::testing::assertTrue(nested > 0, "the inner call allocates a larger buffer")
    std::testing::assertEqual(outer, nested, "nested measurements preserve the outer count")
}

@test
func subtestsSupportTableDrivenAndNestedCases() {
    inputs := [1, 2, 3]
    var visited: int64 = 0
    for n in inputs {
        std::testing::subtest("square ${n}", () => {
            std::testing::assertEqual(n * n, n * n, "square matches")
            visited += 1
        })
    }
    std::testing::subtest("nested parent", () => {
        std::testing::subtest("nested child", () => {
            visited += 10
        })
    })
    std::testing::assertEqual(visited, 13, "all passing subtests should execute")
}

@fuzz
func fuzzParseInt64NeverPanics(_ data: std::mem::Span[uint8]) {
    text := std::string::stringFromBytes(data)
    var _ = std::convert::parse[int64](text)
}

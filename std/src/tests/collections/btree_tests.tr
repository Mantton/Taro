import std::cmp::{Ord, Ordering, PartialOrd}
import std::collections::{BTreeMap, BTreeSet, Dictionary, Set}
import std::default::Default
import std::fmt::debugString
import std::iter::{Iterable, Iterator}
import std::marker::Clone
import std::ops::PartialEq
import std::testing::{assertEqual, assertFalse, assertTrue}
import std::weak::Weak

func btreeNextRand(_ state: &uint64) -> uint64 {
    *state = (*state).wrappingMul(6364136223846793005_u64).wrappingAdd(1442695040888963407_u64)
    *state
}

struct BTreeCloneValue {
    id: int32
}

conform BTreeCloneValue to PartialEq {
    func eq(_ other: BTreeCloneValue) -> bool { self.id == other.id }
}

conform BTreeCloneValue to Clone {
    func clone() -> BTreeCloneValue { BTreeCloneValue { id: self.id + 1000 } }
}

struct BTreeGcValue {
    tag: int32
}

struct BTreeGcKey {
    id: int32
}

struct BTreeGcKeyHandle {
    target: &BTreeGcKey
}

conform BTreeGcKeyHandle to PartialEq {
    func eq(_ other: BTreeGcKeyHandle) -> bool { self.target.id == other.target.id }
}

conform BTreeGcKeyHandle to PartialOrd {
    func partialCmp(_ other: BTreeGcKeyHandle) -> Ordering? { .some(self.target.id.cmp(other.target.id)) }
}

conform BTreeGcKeyHandle to Ord {
    func cmp(_ other: BTreeGcKeyHandle) -> Ordering { self.target.id.cmp(other.target.id) }
}

@noinline
func insertBTreeGcPair(
    _ map: BTreeMap[BTreeGcKeyHandle, &BTreeGcValue],
    _ id: int32,
) -> (Weak[BTreeGcKey], Weak[BTreeGcValue]) {
    key := BTreeGcKey { id: id }
    keyRef := &key
    val := BTreeGcValue { tag: id * 10 }
    valRef := &val
    var _ = map.insert(key: BTreeGcKeyHandle { target: keyRef }, value: valRef)
    (Weak[BTreeGcKey]::new(keyRef), Weak[BTreeGcValue]::new(valRef))
}

@noinline
func removeBTreeGcId(_ map: BTreeMap[BTreeGcKeyHandle, &BTreeGcValue], _ id: int32) {
    probeVal := BTreeGcKey { id: id }
    probe := BTreeGcKeyHandle { target: &probeVal }
    var _ = map.remove(&probe)
}

@noinline
func popBTreeGcEnds(_ map: BTreeMap[BTreeGcKeyHandle, &BTreeGcValue]) {
    var _ = map.popFirst()
    var _ = map.popLast()
}

struct BTreeMutatingKey {
    id: int32
    target: BTreeMap[BTreeMutatingKey, int32]?
}

conform BTreeMutatingKey to PartialEq {
    func eq(_ other: BTreeMutatingKey) -> bool { self.id == other.id }
}

conform BTreeMutatingKey to PartialOrd {
    func partialCmp(_ other: BTreeMutatingKey) -> Ordering? { .some(self.cmp(other)) }
}

conform BTreeMutatingKey to Ord {
    func cmp(_ other: BTreeMutatingKey) -> Ordering {
        match self.target {
            case .some(m) => {
                m.set(key: BTreeMutatingKey { id: 999, target: .none }, value: 1)
            }
            case .none => {}
        }
        match other.target {
            case .some(m) => {
                m.set(key: BTreeMutatingKey { id: 999, target: .none }, value: 1)
            }
            case .none => {}
        }
        self.id.cmp(other.id)
    }
}

@test
func testBTreeMapEmptyAndSingleton() {
    empty := BTreeMap[int32, string]::new()
    assertTrue(empty.isEmpty(), "new BTreeMap is empty")
    assertEqual(empty.len(), 0 as usize, "new BTreeMap len is 0")
    assertTrue(empty.get(&1).isNone(), "empty get returns none")
    assertFalse(empty.contains(&1), "empty contains returns false")
    assertFalse(1 in empty, "empty Contains returns false")
    assertEqual(empty.getOr(&1, default: "fallback"), "fallback", "empty getOr returns default")
    assertTrue(empty.first().isNone(), "empty first is none")
    assertTrue(empty.last().isNone(), "empty last is none")
    assertTrue(empty.firstKey().isNone(), "empty firstKey is none")
    assertTrue(empty.lastKey().isNone(), "empty lastKey is none")
    assertTrue(empty.popFirst().isNone(), "empty popFirst is none")
    assertTrue(empty.popLast().isNone(), "empty popLast is none")
    assertTrue(empty.lowerBound(&5).isNone(), "empty lowerBound is none")
    assertTrue(empty.upperBound(&5).isNone(), "empty upperBound is none")
    assertTrue(empty.lastBefore(&5).isNone(), "empty lastBefore is none")
    assertTrue(empty.lastAtOrBefore(&5).isNone(), "empty lastAtOrBefore is none")
    assertTrue(empty.remove(&5).isNone(), "empty remove is none")
    assertEqual(debugString(empty), "[:]", "empty BTreeMap debug")
    assertTrue(BTreeMap[int32, string]::default() == empty, "Default BTreeMap is empty")
    empty.verifyInvariants()

    var rangeCount: usize = 0
    for _ in empty.range(0..10) {
        rangeCount += 1
    }
    assertEqual(rangeCount, 0 as usize, "empty range yields 0 entries")

    assertTrue(empty.insert(key: 7, value: "seven").isNone(), "first insert returns none")
    assertFalse(empty.isEmpty(), "singleton is not empty")
    assertEqual(empty.len(), 1 as usize, "singleton len is 1")
    assertEqual(empty[7], "seven", "singleton subscript read")
    assertTrue(7 in empty, "singleton Contains true")
    assertEqual(empty.first().unwrap(), (7, "seven"), "singleton first")
    assertEqual(empty.last().unwrap(), (7, "seven"), "singleton last")
    assertEqual(empty.firstKey().unwrap(), 7, "singleton firstKey")
    assertEqual(empty.lastKey().unwrap(), 7, "singleton lastKey")
    assertEqual(empty.lowerBound(&6).unwrap(), (7, "seven"), "singleton lowerBound below")
    assertEqual(empty.lowerBound(&7).unwrap(), (7, "seven"), "singleton lowerBound exact")
    assertTrue(empty.lowerBound(&8).isNone(), "singleton lowerBound above")
    assertEqual(empty.upperBound(&6).unwrap(), (7, "seven"), "singleton upperBound below")
    assertTrue(empty.upperBound(&7).isNone(), "singleton upperBound exact")
    assertTrue(empty.lastBefore(&7).isNone(), "singleton lastBefore exact")
    assertEqual(empty.lastBefore(&8).unwrap(), (7, "seven"), "singleton lastBefore above")
    assertTrue(empty.lastAtOrBefore(&6).isNone(), "singleton lastAtOrBefore below")
    assertEqual(empty.lastAtOrBefore(&7).unwrap(), (7, "seven"), "singleton lastAtOrBefore exact")
    assertEqual(debugString(empty), "[7: \"seven\"]", "singleton debug")
    empty.verifyInvariants()

    assertEqual(empty.insert(key: 7, value: "SEVEN").unwrap(), "seven", "overwrite returns old value")
    assertEqual(empty.len(), 1 as usize, "overwrite keeps len")
    assertEqual(empty.popFirst().unwrap(), (7, "SEVEN"), "popFirst empties singleton")
    assertTrue(empty.isEmpty(), "empty after popFirst")
    empty.verifyInvariants()
}

@test
func testBTreeMapHandleSharingCopyCloneAndEntryHelpers() {
    original := BTreeMap[int32, int32]::new()
    alias := original
    alias[10] = 100
    assertEqual(original[10], 100, "assignment shares underlying BTreeMap")

    independent := original.copy()
    independent[20] = 200
    assertFalse(20 in original, "copy creates independent tree")
    assertEqual(independent.len(), 2 as usize, "copy contains inserted entry")

    // getOrInsert and getOrInsertWith
    assertEqual(original.getOrInsert(10, default: 999), 100, "getOrInsert keeps existing")
    assertEqual(original.getOrInsert(5, default: 50), 50, "getOrInsert inserts missing")
    assertEqual(original[5], 50, "getOrInsert persisted missing")

    var calls: int32 = 0
    assertEqual(
        original.getOrInsertWith(5, () => {
            calls += 1
            return 777
        }),
        50,
        "getOrInsertWith returns existing without invoking callback",
    )
    assertEqual(calls, 0, "callback not called on hit")

    assertEqual(
        original.getOrInsertWith(15, () => {
            calls += 1
            // Re-entrant mutation of another key during callback must remain safe.
            original.set(key: 14, value: 140)
            return 150
        }),
        150,
        "getOrInsertWith computes and inserts on miss",
    )
    assertEqual(calls, 1, "callback invoked once on miss")
    assertEqual(original[14], 140, "re-entrant insert during callback preserved")
    assertEqual(original[15], 150, "computed value persisted")

    // Re-entrant insertion of the same key during callback returns the re-entrantly inserted value.
    assertEqual(
        original.getOrInsertWith(30, () => {
            original.set(key: 30, value: 301)
            return 302
        }),
        301,
        "re-entrant insertion of same key wins cleanly",
    )
    assertEqual(original[30], 301, "re-entrantly inserted value remains stored")
    original.verifyInvariants()

    // Clone deep-clones Clone elements
    clonable := BTreeMap[int32, BTreeCloneValue]::new()
    clonable.set(key: 1, value: BTreeCloneValue { id: 1 })
    clonable.set(key: 2, value: BTreeCloneValue { id: 2 })
    cloned := clonable.clone()
    assertEqual(cloned[1], BTreeCloneValue { id: 1001 }, "clone invokes element clone")
    assertEqual(cloned[2], BTreeCloneValue { id: 1002 }, "clone invokes element clone for all entries")
    assertEqual(clonable[1], BTreeCloneValue { id: 1 }, "source untouched by clone")
}


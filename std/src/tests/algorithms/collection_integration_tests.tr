// Integration tests: classic algorithm problems solved with the public
// collection APIs (List, Dictionary, Counter, Deque, PriorityQueue) together.
// Run with: taro test std --tag integration --std-path std
import std::collections::{List, Dictionary, Counter, Deque, PriorityQueue}
import std::testing::{assertEqual, assertTrue}
import std::ops::PartialEq
import std::iter::{Iterable, enumerate}

func algoTwoSum(_ values: [int32], _ target: int32) -> [usize] {
    seen := Dictionary[int32, usize]::new()
    for (index, value) in enumerate(values) {
        match seen.get(&(target - value)) {
            case .some(previous) => return [previous, index]
            case .none => seen[value] = index
        }
    }
    return []
}

@test
@tag("integration")
func integrationTwoSum() {
    assertEqual(algoTwoSum([2, 7, 11, 15], 9), [0 as usize, 1], "two sum")
    assertEqual(algoTwoSum([3, 3], 6), [0 as usize, 1], "duplicate values")
    assertTrue(algoTwoSum([], 0).isEmpty(), "no pair")
}

func algoValidParentheses(_ text: string) -> bool {
    stack := List[uint8]::new()
    for byte in text.bytes() {
        if byte == ('(' as uint8) { stack.append(')' as uint8) } else if byte == ('[' as uint8) { stack.append(']' as uint8) } else if byte == ('{' as uint8) { stack.append('}' as uint8) } else {
            match stack.pop() {
                case .some(expected) => { if byte != expected { return false } }
                case .none => return false
            }
        }
    }
    return stack.isEmpty()
}

@test
@tag("integration")
func integrationValidParentheses() {
    assertTrue(algoValidParentheses("{[()()]}") && algoValidParentheses(""), "balanced")
    assertTrue(!algoValidParentheses("([)]") && !algoValidParentheses(")"), "unbalanced")
}

func algoLongestSubstring(_ text: string) -> usize {
    // The problem's input is ASCII. Offsets are explicitly byte offsets.
    seen := Dictionary[uint8, usize]::new()
    var start: usize = 0
    var best: usize = 0
    for (index, byte) in enumerate(text.bytes()) {
        match seen.get(&byte) {
            case .some(previous) => start = std::math::max(start, previous + 1)
            case .none => {}
        }
        seen[byte] = index
        best = std::math::max(best, index - start + 1)
    }
    return best
}

@test
@tag("integration")
func integrationLongestSubstring() {
    assertEqual(algoLongestSubstring("abcabcbb"), 3 as usize, "sliding string window")
    assertEqual(algoLongestSubstring("abba"), 2 as usize, "do not move start backwards")
    assertEqual(algoLongestSubstring(""), 0 as usize, "empty string")
}

func algoSlidingMaximum(_ values: [int32], _ width: usize) -> [int32] {
    var result: [int32] = []
    if width == 0 || width > values.len() { return result }
    queue := Deque[usize]::new()
    for (index, value) in enumerate(values) {
        if index >= width && !queue.isEmpty() && queue.front().unwrap() <= index - width {
            var _ = queue.popFront()
        }
        while !queue.isEmpty() && values[queue.back().unwrap()] <= value { var _ = queue.popBack() }
        queue.pushBack(index)
        if index + 1 >= width { result.append(values[queue.front().unwrap()]) }
    }
    return result
}

@test
@tag("integration")
func integrationSlidingWindowMaximum() {
    assertEqual(algoSlidingMaximum([1, 3, -1, -3, 5, 3, 6, 7], 3), [3, 3, 5, 5, 6, 7], "monotonic deque")
    assertEqual(algoSlidingMaximum([2, 2, 2], 2), [2, 2], "duplicate maxima")
    assertTrue(algoSlidingMaximum([], 1).isEmpty(), "empty window")
}

func algoDailyTemperatures(_ values: [int32]) -> [usize] {
    result := List[usize]::repeating(0, count: values.len())
    pending := List[usize]::new()
    for (index, value) in enumerate(values) {
        while !pending.isEmpty() && values[pending[pending.len() - 1]] < value {
            previous := pending.pop().unwrap()
            result[previous] = index - previous
        }
        pending.append(index)
    }
    return result
}

@test
@tag("integration")
func integrationDailyTemperatures() {
    assertEqual(algoDailyTemperatures([73, 74, 75, 71, 69, 72, 76, 73]), [1 as usize, 1, 4, 2, 1, 1, 0, 0], "monotonic stack")
    assertEqual(algoDailyTemperatures([5, 5]), [0 as usize, 0], "strictly warmer")
}

struct AlgoInterval: PartialEq { start: int32; end: int32 }
func algoMergeIntervals(_ intervals: [AlgoInterval]) -> [AlgoInterval] {
    ordered := intervals.sorted(by: (a, b) => a.start < b.start)
    result := List[AlgoInterval]::new()
    for interval in ordered {
        if result.isEmpty() || result[result.len() - 1].end < interval.start {
            result.append(interval)
        } else {
            last := result.at(result.len() - 1)
            last.end = std::math::max(last.end, interval.end)
        }
    }
    return result
}

@test
@tag("integration")
func integrationMergeIntervals() {
    var intervals: [AlgoInterval] = [AlgoInterval { start: 8, end: 10 }, AlgoInterval { start: 2, end: 6 }, AlgoInterval { start: 1, end: 3 }]
    var expected: [AlgoInterval] = [AlgoInterval { start: 1, end: 6 }, AlgoInterval { start: 8, end: 10 }]
    assertEqual(algoMergeIntervals(intervals), expected, "sort and merge")
    assertEqual(intervals[0].start, 8, "input unchanged")
    assertTrue(algoMergeIntervals([]).isEmpty(), "empty intervals")
}

func algoKthLargest(_ values: [int32], _ k: usize) -> int32? {
    if k == 0 || k > values.len() { return .none }
    heap := PriorityQueue[int32]::new()
    for value in values {
        heap.push(value)
        if heap.len() > k { var _ = heap.pop() }
    }
    return heap.peek()
}

@test
@tag("integration")
func integrationKthLargest() {
    assertEqual(algoKthLargest([3, 2, 1, 5, 6, 4], 2).unwrap(), 5, "bounded heap")
    assertEqual(algoKthLargest([2, 2, 1], 2).unwrap(), 2, "duplicates count")
    assertTrue(algoKthLargest([], 1).isNone(), "invalid k")
}

struct AlgoFrequency { value: int32; count: int32 }
func algoTopFrequent(_ values: [int32], _ k: usize) -> [int32] {
    counts := Counter[int32]::new()
    for value in values { var _ = counts.increment(value) }
    heap := PriorityQueue[AlgoFrequency]::new(by: (a, b) => {
        if a.count != b.count { return a.count < b.count }
        return a.value > b.value
    })
    for (value, count) in counts {
        heap.push(AlgoFrequency { value, count })
        if heap.len() > k { var _ = heap.pop() }
    }
    var result: [int32] = []
    while !heap.isEmpty() { result.append(heap.pop().unwrap().value) }
    return result.sorted()
}

@test
@tag("integration")
func integrationTopKFrequent() {
    assertEqual(algoTopFrequent([1, 1, 1, 2, 2, 3], 2), [1, 2], "frequency heap")
    assertEqual(algoTopFrequent([3, 2, 1], 2), [1, 2], "deterministic tie break")
    assertTrue(algoTopFrequent([1], 0).isEmpty(), "zero k")
}

struct AlgoMergeEntry { value: int32; row: usize; column: usize }
func algoMergeK(_ lists: [[int32]]) -> [int32] {
    heap := PriorityQueue[AlgoMergeEntry]::new(by: (a, b) => a.value < b.value)
    for (row, values) in enumerate(lists) {
        if !values.isEmpty() { heap.push(AlgoMergeEntry { value: values[0], row, column: 0 }) }
    }
    var result: [int32] = []
    while !heap.isEmpty() {
        entry := heap.pop().unwrap()
        result.append(entry.value)
        next := entry.column + 1
        if next < lists[entry.row].len() {
            heap.push(AlgoMergeEntry { value: lists[entry.row][next], row: entry.row, column: next })
        }
    }
    return result
}

@test
@tag("integration")
func integrationMergeKSortedLists() {
    assertEqual(algoMergeK([[1, 4, 5], [], [1, 3, 4], [2, 6]]), [1, 1, 2, 3, 4, 4, 5, 6], "k-way merge")
    assertTrue(algoMergeK([]).isEmpty(), "no sources")
}

struct AlgoEdge { node: usize; cost: int32 }
func algoShortestPaths(_ graph: [[AlgoEdge]], _ start: usize) -> [int32] {
    // Test graphs have nonnegative weights and path lengths below this sentinel.
    distance := List[int32]::repeating(1000000000, count: graph.len())
    heap := PriorityQueue[AlgoEdge]::new(by: (a, b) => a.cost < b.cost)
    distance[start] = 0
    heap.push(AlgoEdge { node: start, cost: 0 })
    while !heap.isEmpty() {
        current := heap.pop().unwrap()
        if current.cost != distance[current.node] { continue }
        for edge in graph[current.node] {
            next := current.cost + edge.cost
            if next < distance[edge.node] {
                distance[edge.node] = next
                heap.push(AlgoEdge { node: edge.node, cost: next })
            }
        }
    }
    return distance
}

@test
@tag("integration")
func integrationDijkstra() {
    var graph: [[AlgoEdge]] = [
        [AlgoEdge { node: 1, cost: 10 }, AlgoEdge { node: 2, cost: 1 }],
        [AlgoEdge { node: 3, cost: 2 }], [AlgoEdge { node: 1, cost: 1 }], [], [],
    ]
    assertEqual(algoShortestPaths(graph, 0), [0, 2, 1, 4, 1000000000], "stale heap entries and unreachable node")
}

final class AlgoTreeNode { value: int32; left: AlgoTreeNode?; right: AlgoTreeNode? }
extend AlgoTreeNode {
    init(_ value: int32, left: AlgoTreeNode? = .none, right: AlgoTreeNode? = .none) {
        self.value = value
        self.left = left
        self.right = right
    }
}
func algoTreeLevels(_ root: AlgoTreeNode?) -> [[int32]] {
    var result: [[int32]] = []
    if root.isNone() { return result }
    queue := Deque[AlgoTreeNode]::new()
    queue.pushBack(root.unwrap())
    while !queue.isEmpty() {
        count := queue.len()
        var level: [int32] = []
        var index: usize = 0
        while index < count {
            node := queue.popFront().unwrap()
            level.append(node.value)
            if node.left.isSome() { queue.pushBack(node.left.unwrap()) }
            if node.right.isSome() { queue.pushBack(node.right.unwrap()) }
            index += 1
        }
        result.append(level)
    }
    return result
}

@test
@tag("integration")
func integrationTreeLevelOrder() {
    root := AlgoTreeNode(3, left: .some(AlgoTreeNode(9)), right: .some(AlgoTreeNode(20, left: .some(AlgoTreeNode(15)), right: .some(AlgoTreeNode(7)))))
    var expected: [[int32]] = [[3], [9, 20], [15, 7]]
    assertEqual(algoTreeLevels(.some(root)), expected, "tree BFS")
    assertTrue(algoTreeLevels(.none).isEmpty(), "empty tree")
}

func algoCanFinish(_ graph: [[usize]]) -> bool {
    indegree := List[usize]::repeating(0, count: graph.len())
    for edges in graph { for node in edges { indegree[node] += 1 } }
    ready := Deque[usize]::new()
    for (node, count) in enumerate(indegree) { if count == 0 { ready.pushBack(node) } }
    var visited: usize = 0
    while !ready.isEmpty() {
        node := ready.popFront().unwrap()
        visited += 1
        for next in graph[node] {
            indegree[next] -= 1
            if indegree[next] == 0 { ready.pushBack(next) }
        }
    }
    return visited == graph.len()
}

@test
@tag("integration")
func integrationCourseSchedule() {
    assertTrue(algoCanFinish([[1, 2], [3], [3], []]), "DAG")
    assertTrue(!algoCanFinish([[1], [0]]), "cycle")
    assertTrue(algoCanFinish([]), "empty graph")
}

func algoUniquePaths(_ rows: usize, _ columns: usize) -> int64 {
    if rows == 0 || columns == 0 { return 0 }
    table := List[List[int64]]::generate(count: rows, by: (_) => List[int64]::repeating(1, count: columns))
    var row: usize = 1
    while row < rows {
        var column: usize = 1
        while column < columns {
            table[row][column] = table[row - 1][column] + table[row][column - 1]
            column += 1
        }
        row += 1
    }
    return table[rows - 1][columns - 1]
}

@test
@tag("integration")
func integrationUniquePaths() {
    assertEqual(algoUniquePaths(3, 7), 28_i64, "independent DP rows")
    assertEqual(algoUniquePaths(1, 1), 1_i64, "singleton grid")
    assertEqual(algoUniquePaths(0, 2), 0_i64, "empty grid")
}

func algoCoinChange(_ coins: [usize], _ amount: usize) -> int32 {
    table := List[int32]::repeating(-1, count: amount + 1)
    table[0] = 0
    var value: usize = 1
    while value <= amount {
        for coin in coins {
            if coin > 0 && coin <= value && table[value - coin] >= 0 {
                candidate := table[value - coin] + 1
                if table[value] < 0 || candidate < table[value] { table[value] = candidate }
            }
        }
        value += 1
    }
    return table[amount]
}

@test
@tag("integration")
func integrationCoinChange() {
    assertEqual(algoCoinChange([1, 2, 5], 11), 3, "unbounded DP")
    assertEqual(algoCoinChange([2], 3), -1, "unreachable amount")
    assertEqual(algoCoinChange([], 0), 0, "zero amount")
}

func algoSubsetsVisit(_ values: [int32], _ start: usize, _ path: [int32], _ result: [[int32]]) {
    result.append(path.copy())
    var index = start
    while index < values.len() {
        path.append(values[index])
        algoSubsetsVisit(values, index + 1, path, result)
        var _ = path.pop()
        index += 1
    }
}
func algoSubsets(_ values: [int32]) -> [[int32]] {
    var result: [[int32]] = []
    algoSubsetsVisit(values, 0, [], result)
    return result
}

@test
@tag("integration")
func integrationSubsets() {
    var expected: [[int32]] = [[], [1], [1, 2], [1, 2, 3], [1, 3], [2], [2, 3], [3]]
    assertEqual(algoSubsets([1, 2, 3]), expected, "backtracking snapshots")
    var emptyExpected: [[int32]] = [[]]
    assertEqual(algoSubsets([]), emptyExpected, "empty subset")
}

func algoLisLength(_ values: [int32]) -> usize {
    var tails: [int32] = []
    for value in values {
        index := tails.lowerBound(value)
        if index == tails.len() { tails.append(value) } else { tails[index] = value }
    }
    return tails.len()
}

@test
@tag("integration")
func integrationLongestIncreasingSubsequence() {
    assertEqual(algoLisLength([10, 9, 2, 5, 3, 7, 101, 18]), 4 as usize, "patience sorting")
    assertEqual(algoLisLength([2, 2, 2]), 1 as usize, "strict increase")
    assertEqual(algoLisLength([]), 0 as usize, "empty LIS")
}

final class AlgoListNode { value: int32; next: AlgoListNode? }
extend AlgoListNode {
    init(_ value: int32, _ next: AlgoListNode? = .none) { self.value = value; self.next = next }
}
func algoReverseList(_ head: AlgoListNode?) -> AlgoListNode? {
    var previous: AlgoListNode? = .none
    var current = head
    while current.isSome() {
        node := current.unwrap()
        next := node.next
        node.next = previous
        previous = .some(node)
        current = next
    }
    return previous
}

@test
@tag("integration")
func integrationReverseLinkedList() {
    first := AlgoListNode(1, .some(AlgoListNode(2, .some(AlgoListNode(3)))))
    head := algoReverseList(.some(first)).unwrap()
    assertEqual(head.value, 3, "reversed head")
    assertTrue(head.next.unwrap().next.unwrap() === first, "node identity preserved")
    assertTrue(first.next.isNone() && algoReverseList(.none).isNone(), "tail and empty")
}

struct AlgoCell { row: usize; column: usize }
func algoIslands(_ grid: [[int32]]) -> int32 {
    var count = 0
    queue := Deque[AlgoCell]::new()
    var row: usize = 0
    while row < grid.len() {
        var column: usize = 0
        while column < grid[row].len() {
            if grid[row][column] == 1 {
                count += 1
                grid[row][column] = 0
                queue.pushBack(AlgoCell { row, column })
                while !queue.isEmpty() {
                    cell := queue.popFront().unwrap()
                    var neighbors: [AlgoCell] = []
                    if cell.row > 0 { neighbors.append(AlgoCell { row: cell.row - 1, column: cell.column }) }
                    if cell.row + 1 < grid.len() { neighbors.append(AlgoCell { row: cell.row + 1, column: cell.column }) }
                    if cell.column > 0 { neighbors.append(AlgoCell { row: cell.row, column: cell.column - 1 }) }
                    if cell.column + 1 < grid[cell.row].len() { neighbors.append(AlgoCell { row: cell.row, column: cell.column + 1 }) }
                    for next in neighbors {
                        if next.column < grid[next.row].len() && grid[next.row][next.column] == 1 {
                            grid[next.row][next.column] = 0
                            queue.pushBack(next)
                        }
                    }
                }
            }
            column += 1
        }
        row += 1
    }
    return count
}

@test
@tag("integration")
func integrationNumberOfIslands() {
    assertEqual(algoIslands([[1, 1, 0], [0, 1, 0], [1, 0, 1]]), 3, "grid BFS")
    assertEqual(algoIslands([]), 0, "empty grid")
    assertEqual(algoIslands([[1], [], [1, 1]]), 2, "ragged rows")
}

@test
@tag("integration")
func integrationLargeInputs() {
    count := 100000 as usize
    values := List[int32]::generate(count: count, by: (i) => (count - i) as int32)
    var comparisons: usize = 0
    values.sort(by: (a, b) => { comparisons += 1; a < b })
    assertTrue(comparisons <= count * 17, "large sort comparison bound")
    assertEqual(algoLisLength(values), count, "100k binary searches")
    assertEqual(algoKthLargest(values, 32).unwrap(), 99969, "100k bounded heap")
    windows := algoSlidingMaximum(values, 512)
    assertEqual(windows.len(), count - 511, "100k sliding windows")
    assertEqual(windows[0], 512, "first maximum")
    assertEqual(windows[windows.len() - 1], 100000, "last maximum")
    queue := Deque[int32]::new()
    for value in values { queue.pushBack(value) }
    for value in values { assertEqual(queue.popFront().unwrap(), value, "100k FIFO") }
}

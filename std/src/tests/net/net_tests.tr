
@cfg(family("unix"))
const FRAME_HEADER_LEN: usize = 4

@cfg(family("unix"))
func ipv6Loopback(_ port: uint16) -> std::net::SocketAddress {
    var ip: std::net::IpAddress = .ipv6([
        0_u8, 0_u8, 0_u8, 0_u8,
        0_u8, 0_u8, 0_u8, 0_u8,
        0_u8, 0_u8, 0_u8, 0_u8,
        0_u8, 0_u8, 0_u8, 1_u8,
    ])
    return std::net::SocketAddress {
        ip,
        port,
    }
}

@cfg(family("unix"))
func byteSpan(_ value: &uint8) -> std::mem::Span[uint8] {
    return unsafe { std::mem::Span[uint8]::from(unsafe { value as *const uint8 }, 1) }
}

@cfg(family("unix"))
func byteMutSpan(_ value: &uint8) -> std::mem::Span[uint8] {
    return unsafe { std::mem::Span[uint8]::from(unsafe { value as *mut uint8 }, 1) }
}

@cfg(family("unix"))
func headerSpan(_ header: &[uint8; FRAME_HEADER_LEN]) -> std::mem::Span[uint8] {
    ptr := unsafe { (header as *const [uint8; FRAME_HEADER_LEN]) as *const uint8 }
    return unsafe { std::mem::Span[uint8]::from(ptr, FRAME_HEADER_LEN) }
}

@cfg(family("unix"))
func headerMutSpan(_ header: &[uint8; FRAME_HEADER_LEN]) -> std::mem::Span[uint8] {
    ptr := unsafe { (header as *mut [uint8; FRAME_HEADER_LEN]) as *mut uint8 }
    return unsafe { std::mem::Span[uint8]::from(ptr, FRAME_HEADER_LEN) }
}

@cfg(family("unix"))
func stringBytes(_ s: &string) -> std::mem::Span[uint8] {
    len := std::intrinsic::__intrinsic_string_len(s)
    if len == 0 {
        return unsafe { std::mem::Span[uint8]::from(std::string::stringData(""), 0) }
    }
    return std::mem::Span[uint8]::fromString(s)
}

@cfg(family("unix"))
func mutableSpanFromPtr(_ ptr: *mut uint8, _ len: usize) -> std::mem::Span[uint8] {
    return unsafe { std::mem::Span[uint8]::from(ptr, len) }
}

@cfg(family("unix"))
func encodeFrameLength(_ len: usize) -> [uint8; FRAME_HEADER_LEN] {
    value := len as uint32
    return [
        ((value >> 24_u32) & 255_u32) as uint8,
        ((value >> 16_u32) & 255_u32) as uint8,
        ((value >> 8_u32) & 255_u32) as uint8,
        (value & 255_u32) as uint8,
    ]
}

@cfg(family("unix"))
func decodeFrameLength(_ header: &[uint8; FRAME_HEADER_LEN]) -> usize {
    b0 := (*header.at(0 as usize) as uint32) << 24_u32
    b1 := (*header.at(1 as usize) as uint32) << 16_u32
    b2 := (*header.at(2 as usize) as uint32) << 8_u32
    b3 := *header.at(3 as usize) as uint32
    return (b0 | b1 | b2 | b3) as usize
}

@cfg(family("unix"))
func transformedMessage(_ request: string) -> string {
    return "server<" + request + ">:ok"
}

@cfg(family("unix"))
func expectUnexpectedCode(_ err: std::io::Error, _ code: int32, _ message: string) {
    std::testing::assertTrue(err.isKind(.unexpected), message)
    match err.rawOsError() {
        case .some(actual) => std::testing::assertEqual(actual, code, message)
        case .none => std::panic::panic(message)
    }
}

@cfg(family("unix"))
func closedUdpAddress() -> std::net::SocketAddress {
    socket := match std::net::UdpSocket::bind(std::net::SocketAddress::localhost(0_u16)) {
        case .ok(value) => value
        case .err(_) => std::panic::panic("closed UDP socket should bind")
    }
    address := match socket.localAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("closed UDP socket should expose its address")
    }
    std::testing::assertTrue(socket.close().isOk(), "UDP socket should close")
    return address
}

@cfg(family("unix"))
func connectTransferredStream(_ address: std::net::SocketAddress) async -> std::io::task::AsyncStream {
    var client = match await std::net::TcpStream::connect(address) {
        case .ok(value) => value
        case .err(_) => std::panic::panic("transfer client should connect")
    }
    stream := match client.intoStream() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("TCP stream should transfer into AsyncStream")
    }
    match client.close() {
        case .err(err) => std::testing::assertTrue(err.isKind(.closed), "transferred TCP wrapper should be closed")
        case .ok(_) => std::testing::fail("transferred TCP wrapper must not close the new owner")
    }
    return stream
}

@cfg(family("unix"))
func acceptEchoByte(_ listener: &std::net::TcpListener, _ expected: uint8) async {
    acceptRes := await listener.accept()
    accepted := match acceptRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("accept should succeed")
    }

    stream := accepted.0
    var received: uint8 = 0
    readRes := await stream.read(byteMutSpan(&received))
    readCount := match readRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("server read should succeed")
    }
    std::testing::assertEqual(readCount, 1 as usize, "server should read exactly one byte")
    std::testing::assertEqual(received, expected, "server should receive the expected byte")

    writeRes := await stream.write(byteSpan(&received))
    writeCount := match writeRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("server write should succeed")
    }
    std::testing::assertEqual(writeCount, 1 as usize, "server should write exactly one byte")

    match stream.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("accepted stream close should succeed")
    }
}

@cfg(family("unix"))
func acceptAndEchoClients(_ listener: &std::net::TcpListener, _ expectedClients: int32) async -> int32 {
    var handled: int32 = 0

    while handled < expectedClients {
        acceptRes := await listener.accept()
        pair := match acceptRes {
            case .ok(value) => value
            case .err(_) => std::panic::panic("async listener accept should succeed")
        }

        stream := pair.0
        var received: uint8 = 0
        readRes := await stream.read(byteMutSpan(&received))
        readCount := match readRes {
            case .ok(value) => value
            case .err(_) => std::panic::panic("async server read should succeed")
        }
        std::testing::assertEqual(readCount, 1 as usize, "async server should read one byte per client")

        writeRes := await stream.write(byteSpan(&received))
        writeCount := match writeRes {
            case .ok(value) => value
            case .err(_) => std::panic::panic("async server write should succeed")
        }
        std::testing::assertEqual(writeCount, 1 as usize, "async server should write one byte per client")

        match stream.close() {
            case .ok(_) => {}
            case .err(_) => std::panic::panic("async accepted stream close should succeed")
        }

        handled += 1
    }

    return handled
}

@cfg(family("unix"))
func writeMessage(_ stream: &std::net::TcpStream, _ message: string) async {
    header := encodeFrameLength(std::string::stringLen(message))
    headerRes := await stream.writeAll(headerSpan(&header))
    match headerRes {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("writeAll header should succeed")
    }

    writeRes := await stream.write(message)
    match writeRes {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("write string should succeed")
    }
}

@cfg(family("unix"))
func readMessage(_ stream: &std::net::TcpStream) async -> string {
    var header: [uint8; FRAME_HEADER_LEN] = [0; FRAME_HEADER_LEN]
    headerRes := await stream.readExact(headerMutSpan(&header))
    match headerRes {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("readExact header should succeed")
    }

    payloadLen := decodeFrameLength(&header)
    if payloadLen == 0 {
        return ""
    }

    // This unsafe raw view is private by construction: the unique native owner
    // is a local frame field, never aliases another value, never grows, and
    // remains owned until the direct await completes (including cancellation
    // acknowledgment). The checker does not infer custom raw-owner privacy.
    var payload: std::mem::NativeBytes = std::mem::NativeBytes::new(payloadLen)
    var pointer: *mut uint8 = payload.data()
    var bytes: std::mem::Span[uint8] = unsafe { std::mem::Span[uint8]::from(pointer, payloadLen) }
    payloadRes := await stream.readExact(bytes)
    match payloadRes {
        case .ok(_) => return unsafe { payload.toString(payloadLen) }
        case .err(_) => std::panic::panic("readExact payload should succeed")
    }
}

@cfg(family("unix"))
func acceptAndTransformMessages(_ listener: &std::net::TcpListener, _ expectedClients: int32) async -> int32 {
    var handled: int32 = 0

    while handled < expectedClients {
        acceptRes := await listener.accept()
        pair := match acceptRes {
            case .ok(value) => value
            case .err(_) => std::panic::panic("string listener accept should succeed")
        }

        stream := pair.0
        request := await readMessage(&stream)
        response := transformedMessage(request)
        await writeMessage(&stream, response)

        match stream.close() {
            case .ok(_) => {}
            case .err(_) => std::panic::panic("string server close should succeed")
        }

        handled += 1_i32
    }

    return handled
}

@cfg(family("unix"))
func clientRoundTrip(_ address: std::net::SocketAddress, _ value: uint8) async -> int32 {
    connectRes := await std::net::TcpStream::connect(address)
    stream := match connectRes {
        case .ok(inner) => inner
        case .err(_) => std::panic::panic("concurrent async connect should succeed")
    }

    var outbound = value
    writeRes := await stream.write(byteSpan(&outbound))
    writeCount := match writeRes {
        case .ok(inner) => inner
        case .err(_) => std::panic::panic("concurrent async write should succeed")
    }
    std::testing::assertEqual(writeCount, 1 as usize, "concurrent async client should write one byte")

    var echoed: uint8 = 0
    readRes := await stream.read(byteMutSpan(&echoed))
    readCount := match readRes {
        case .ok(inner) => inner
        case .err(_) => std::panic::panic("concurrent async read should succeed")
    }
    std::testing::assertEqual(readCount, 1 as usize, "concurrent async client should read one byte")

    match stream.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("concurrent async client close should succeed")
    }

    return echoed as int32
}

@cfg(family("unix"))
@test
func tcpLocalAddressReflectsEphemeralPortIpv4() async {
    listenRes := std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16))
    var listener = match listenRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("ipv4 listen should succeed")
    }

    localRes := listener.localAddress()
    local := match localRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("ipv4 localAddress should succeed")
    }
    std::testing::assertTrue(local.port != 0_u16, "port 0 bind should allocate an ipv4 port")

    match listener.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("ipv4 listener close should succeed")
    }
}

@cfg(family("unix"))
@test
func tcpLocalAddressReflectsEphemeralPortIpv6() async {
    listenRes := std::net::TcpListener::bind(ipv6Loopback(0_u16))
    var listener = match listenRes {

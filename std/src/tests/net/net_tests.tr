        case .err(_) => std::panic::panic("ipv6 listener close should succeed")
    }
}

@cfg(family("unix"))
@test
func tcpClientServerEcho() async {
    listenRes := std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16))
    var listener = match listenRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("listen should succeed")
    }
    local := match listener.localAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("localAddress should succeed")
    }

    var outbound: uint8 = 44_u8
    serverTask := std::task::spawn(() async => {
        return await clientRoundTrip(local, outbound)
    })

    handled := await acceptAndEchoClients(&listener, 1_i32)
    std::testing::assertEqual(handled, 1_i32, "server side should handle one client")

    echoed := (await serverTask.result()).unwrap()
    std::testing::assertEqual(echoed, outbound as int32, "client should receive the echoed byte")

    match listener.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("listener close should succeed")
    }
}

@cfg(family("unix"))
@test
func tcpStreamReportsPeerAndLocalAddresses() async {
    listenRes := std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16))
    var listener = match listenRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("listener should start")
    }

    serverLocal := match listener.localAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("listener localAddress should succeed")
    }

    connectRes := await std::net::TcpStream::connect(serverLocal)
    client := match connectRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("connect should succeed")
    }

    clientLocal := match client.localAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("client localAddress should succeed")
    }
    clientPeer := match client.peerAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("client peerAddress should succeed")
    }
    std::testing::assertEqual(clientPeer.port, serverLocal.port, "client peerAddress should match listener port")
    std::testing::assertTrue(clientLocal.port != 0_u16, "client localAddress should have an ephemeral port")

    acceptRes := await listener.accept()
    accepted := match acceptRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("accept should succeed")
    }
    serverStream := accepted.0
    acceptedPeer := accepted.1
    serverPeer := match serverStream.peerAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("accepted peerAddress should succeed")
    }

    std::testing::assertEqual(acceptedPeer.port, clientLocal.port, "accept should report the client port")
    std::testing::assertEqual(serverPeer.port, clientLocal.port, "accepted stream peerAddress should match the client port")

    match client.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("client close should succeed")
    }
    match serverStream.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("accepted stream close should succeed")
    }
    match listener.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("listener close should succeed")
    }
}

@cfg(family("unix"))
@test
func tcpStringRequestResponse() async {
    listenRes := std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16))
    var listener = match listenRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("string listener should start")
    }

    local := match listener.localAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("string localAddress should succeed")
    }

    connectRes := await std::net::TcpStream::connect(local)
    client := match connectRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("string connect should succeed")
    }

    acceptRes := await listener.accept()
    accepted := match acceptRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("string accept should succeed")
    }
    server := accepted.0

    request := "string request"
    await writeMessage(&client, request)
    serverRequest := await readMessage(&server)
    std::testing::assertTrue(
        std::string::stringEq(serverRequest, request),
        "string server should receive the request payload",
    )

    await writeMessage(&server, transformedMessage(serverRequest))
    response := await readMessage(&client)
    std::testing::assertTrue(
        std::string::stringEq(response, transformedMessage(request)),
        "string response should be transformed by the server",
    )

    match client.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("string client close should succeed")
    }
    match server.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("string server close should succeed")
    }

    match listener.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("string listener close should succeed")
    }
}

@cfg(family("unix"))
@test
func tcpAcceptsMultipleSequentialClients() async {
    listenRes := std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16))
    var listener = match listenRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("listen should succeed")
    }
    local := match listener.localAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("localAddress should succeed")
    }

    var idx: int32 = 0
    while idx < 3_i32 {
        connectRes := await std::net::TcpStream::connect(local)
        client := match connectRes {
            case .ok(value) => value
            case .err(_) => std::panic::panic("sequential connect should succeed")
        }

        var outbound: uint8 = (idx + 1_i32) as uint8
        writeRes := await client.write(byteSpan(&outbound))
        writeCount := match writeRes {
            case .ok(value) => value
            case .err(_) => std::panic::panic("sequential client write should succeed")
        }
        std::testing::assertEqual(writeCount, 1 as usize, "sequential client write should send one byte")

        await acceptEchoByte(&listener, outbound)

        var echoed: uint8 = 0
        readRes := await client.read(byteMutSpan(&echoed))
        readCount := match readRes {
            case .ok(value) => value
            case .err(_) => std::panic::panic("sequential client read should succeed")
        }
        std::testing::assertEqual(readCount, 1 as usize, "sequential client should read one byte")
        std::testing::assertEqual(echoed, outbound, "sequential echo should preserve the byte")

        match client.close() {
            case .ok(_) => {}
            case .err(_) => std::panic::panic("sequential client close should succeed")
        }

        idx += 1
    }

    match listener.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("listener close should succeed")
    }
}

@cfg(family("unix"))
@test
func syncUdpLoopbackRoundTrip() {
    serverBind := std::net::SocketAddress::localhost(0_u16)
    serverSocketRes := std::sys::net::socket(std::sys::net::domainForAddress(serverBind), .datagram)
    var server = match serverSocketRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("udp server socket should succeed")
    }

    match std::sys::net::bind(&server, serverBind) {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("udp server bind should succeed")
    }

    serverAddr := match std::sys::net::localAddress(&server) {
        case .ok(value) => value
        case .err(_) => std::panic::panic("udp server localAddress should succeed")
    }
    std::testing::assertTrue(serverAddr.port != 0_u16, "udp server should get an ephemeral port")

    clientSocketRes := std::sys::net::socket(std::sys::net::domainForAddress(serverAddr), .datagram)
    var client = match clientSocketRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("udp client socket should succeed")
    }

    var outbound: uint8 = 91_u8
    sendRes := std::sys::net::sendTo(&client, unsafe { (&outbound as *const uint8) }, 1 as usize, serverAddr)
    sendCount := match sendRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("udp sendTo should succeed")
    }
    std::testing::assertEqual(sendCount, 1 as usize, "udp sendTo should send one byte")

    var serverByte: uint8 = 0
    recvRes := std::sys::net::recvFrom(&server, unsafe { (&serverByte as *mut uint8) }, 1 as usize)
    received := match recvRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("udp recvFrom should succeed")
    }
    std::testing::assertEqual(received.0, 1 as usize, "udp recvFrom should receive one byte")
    std::testing::assertEqual(serverByte, outbound, "udp server should receive the sent byte")

    replyRes := std::sys::net::sendTo(&server, unsafe { (&serverByte as *const uint8) }, 1 as usize, received.1)
    replyCount := match replyRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("udp reply sendTo should succeed")
    }
    std::testing::assertEqual(replyCount, 1 as usize, "udp reply should send one byte")

    var clientByte: uint8 = 0
    clientRecvRes := std::sys::net::recvFrom(&client, unsafe { (&clientByte as *mut uint8) }, 1 as usize)
    clientReceived := match clientRecvRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("udp client recvFrom should succeed")
    }
    std::testing::assertEqual(clientReceived.0, 1 as usize, "udp client should receive one byte")
    std::testing::assertEqual(clientByte, outbound, "udp reply should echo the original byte")

    match std::sys::net::close(&client) {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("udp client close should succeed")
    }
    match std::sys::net::close(&server) {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("udp server close should succeed")
    }
}

@cfg(family("unix"))
@test
func tcpManyConcurrentClients() async {
    listenRes := std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16))
    var listener = match listenRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("listen should succeed")
    }
    local := match listener.localAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("localAddress should succeed")
    }

    clientCount := 4_i32
    var tasks = std::collections::List[std::task::Task[int32]]::new()
    var idx: int32 = 0
    while idx < clientCount {
        value := (idx + 1_i32) as uint8
        task := std::task::spawn(() async => {
            return await clientRoundTrip(local, value)
        })

        tasks.append(task)
        idx += 1
    }

    handled := await acceptAndEchoClients(&listener, clientCount)
    std::testing::assertEqual(handled, clientCount, "server should handle every concurrent client")

    var seen: int32 = 0
    while !tasks.isEmpty() {
        task := match tasks.pop() {
            case .some(t) => t
            case .none => std::panic::panic("task list should not be empty")
        }
        echoed := (await task.result()).unwrap()
        seen += echoed
    }

    std::testing::assertEqual(seen, 10_i32, "concurrent clients should all receive their echoed bytes")

    match listener.close() {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("listener close should succeed")
    }
}

@cfg(family("unix"))
@test
func asyncUdpLoopbackRoundTrip() async {
    bindAddr := std::net::SocketAddress::localhost(0_u16)
    serverSocketRes := std::sys::net::task::socket(std::sys::net::domainForAddress(bindAddr), .datagram)
    var server = match serverSocketRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("async udp server socket should succeed")
    }

    match std::sys::net::task::bind(&server, bindAddr) {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("async udp server bind should succeed")
    }

    serverAddr := match std::sys::net::task::localAddress(&server) {
        case .ok(value) => value
        case .err(_) => std::panic::panic("async udp server localAddress should succeed")
    }
    std::testing::assertTrue(serverAddr.port != 0_u16, "async udp server should get an ephemeral port")

    clientSocketRes := std::sys::net::task::socket(std::sys::net::domainForAddress(serverAddr), .datagram)
    var client = match clientSocketRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("async udp client socket should succeed")
    }

    var outbound: uint8 = 109_u8
    sendRes := await std::sys::net::task::sendTo(&client, byteSpan(&outbound), serverAddr)
    sendCount := match sendRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("async udp sendTo should succeed")
    }
    std::testing::assertEqual(sendCount, 1 as usize, "async udp sendTo should send one byte")

    var serverByte: uint8 = 0
    recvRes := await std::sys::net::task::recvFrom(&server, byteMutSpan(&serverByte))
    received := match recvRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("async udp recvFrom should succeed")
    }
    std::testing::assertEqual(received.0, 1 as usize, "async udp recvFrom should receive one byte")
    std::testing::assertEqual(serverByte, outbound, "async udp server should receive the sent byte")

    replyRes := await std::sys::net::task::sendTo(&server, byteSpan(&serverByte), received.1)
    replyCount := match replyRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("async udp reply sendTo should succeed")
    }
    std::testing::assertEqual(replyCount, 1 as usize, "async udp reply should send one byte")

    var clientByte: uint8 = 0
    clientRecvRes := await std::sys::net::task::recvFrom(&client, byteMutSpan(&clientByte))
    clientReceived := match clientRecvRes {
        case .ok(value) => value
        case .err(_) => std::panic::panic("async udp client recvFrom should succeed")
    }
    std::testing::assertEqual(clientReceived.0, 1 as usize, "async udp client should receive one byte")
    std::testing::assertEqual(clientByte, outbound, "async udp reply should echo the original byte")

    match std::sys::net::task::close(client) {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("async udp client close should succeed")
    }
    match std::sys::net::task::close(server) {
        case .ok(_) => {}
        case .err(_) => std::panic::panic("async udp server close should succeed")
    }
}

@cfg(family("unix"))
@test
func udpCloseReleasesSocketAddress() {
    address := closedUdpAddress()
    replacement := match std::net::UdpSocket::bind(address) {
        case .ok(value) => value
        case .err(_) => std::panic::panic("close should release the UDP address")
    }
    std::testing::assertTrue(replacement.close().isOk(), "replacement UDP socket should close once")
    match replacement.close() {
        case .err(err) => std::testing::assertTrue(err.isKind(.closed), "second UDP close should return closed")
        case .ok(_) => std::testing::fail("second UDP close should fail")
    }
    match replacement.localAddress() {
        case .err(err) => std::testing::assertTrue(err.isKind(.closed), "UDP use after close should return closed")
        case .ok(_) => std::testing::fail("closed UDP socket should not expose an address")
    }
}

@cfg(family("unix"))
@test
func tcpIntoStreamTransfersCleanupResponsibility() async {
    listener := match std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16)) {
        case .ok(value) => value
        case .err(_) => std::panic::panic("transfer listener should bind")
    }
    address := match listener.localAddress() {
        case .ok(value) => value
        case .err(_) => std::panic::panic("transfer listener should expose its address")
    }

    client := await connectTransferredStream(address)
    accepted := match await listener.accept() {
        case .ok(value) => value.0
        case .err(_) => std::panic::panic("transfer listener should accept")
    }

    // The original TcpStream wrapper is now unreachable. Its cancelled
    // cleanup must not close the descriptor now owned by `client`.

    var outbound: uint8 = 117_u8
    match await client.write(byteSpan(&outbound)) {
        case .ok(count) => std::testing::assertEqual(count, 1 as usize, "transferred stream should write")
        case .err(_) => std::testing::fail("old cleanup must not close transferred stream")
    }

    var received: uint8 = 0
    match await accepted.read(byteMutSpan(&received)) {
        case .ok(count) => std::testing::assertEqual(count, 1 as usize, "server should read transferred byte")
        case .err(_) => std::testing::fail("server should read from transferred stream")
    }
    std::testing::assertEqual(received, outbound, "transferred stream should preserve data")

    std::testing::assertTrue(client.close().isOk(), "transferred AsyncStream should close")
    std::testing::assertTrue(accepted.close().isOk(), "accepted TCP stream should close")
    std::testing::assertTrue(listener.close().isOk(), "transfer listener should close")
}

@cfg(family("unix"))
@test
func tcpReadUntilPrefersReadyDataThenTimesOutAndStaysUsable() async {
    listener := std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16)).unwrap()
    defer { var _ = listener.close() }
    client := (await std::net::TcpStream::connect(listener.localAddress().unwrap())).unwrap()
    defer { var _ = client.close() }
    accepted := (await listener.accept()).unwrap().0
    defer { var _ = accepted.close() }
    var buffer: [uint8; 16] = [0_u8; 16]
    span := unsafe { std::mem::Span[uint8]::from((&buffer as *mut [uint8; 16]) as *mut uint8, 16) }

    (await client.write("hi")).unwrap()
    await std::task::sleep(std::time::Duration::fromMillis(20_u64))
    expired := std::time::Instant::now()
    std::testing::assertEqual((await accepted.readUntil(span, expired)).unwrap(), 2, "ready data beats an expired deadline")

    limit := std::time::Duration::fromMillis(20_u64)
    started := std::time::Instant::now()
    match await accepted.readUntil(span, started.checkedAdd(limit).unwrap()) {
        case .err(error) => std::testing::assertTrue(error.isKind(.timedOut), "an empty socket times out")
        case .ok(_) => std::testing::fail("no data was sent")
    }
    std::testing::assertTrue(started.elapsed().subsecNanos() >= limit.subsecNanos() || started.elapsed().seconds() > 0_u64, "the deadline was waited for")

    // The expired wait leaves nothing behind for an ordinary read to trip on.
    (await client.write("more")).unwrap()
    std::testing::assertEqual((await accepted.read(span)).unwrap(), 4, "a timed out stream stays readable")
}

@cfg(family("unix"))
@test
func tcpReadUntilIsCancelledAtItsWait() async {
    listener := std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16)).unwrap()
    defer { var _ = listener.close() }
    client := (await std::net::TcpStream::connect(listener.localAddress().unwrap())).unwrap()
    defer { var _ = client.close() }
    accepted := (await listener.accept()).unwrap().0
    defer { var _ = accepted.close() }
    reader := std::task::spawn(() async => {
        var buffer: [uint8; 16] = [0_u8; 16]
        span := unsafe { std::mem::Span[uint8]::from((&buffer as *mut [uint8; 16]) as *mut uint8, 16) }
        limit := std::time::Duration::fromMillis(60000_u64)
        return await accepted.readUntil(span, std::time::Instant::now().checkedAdd(limit).unwrap())
    })
    await std::task::sleep(std::time::Duration::fromMillis(5_u64))
    reader.cancel()
    match await reader.result() {
        case .err(.cancelled) => {}
        case _ => std::testing::fail("cancellation ends the wait, not the deadline")
    }
}

@cfg(family("unix"))
@test
func tcpWriteAllUntilTimesOutOnAStalledPeer() async {
    listener := std::net::TcpListener::bind(std::net::SocketAddress::localhost(0_u16)).unwrap()
    defer { var _ = listener.close() }
    client := (await std::net::TcpStream::connect(listener.localAddress().unwrap())).unwrap()
    defer { var _ = client.close() }
    accepted := (await listener.accept()).unwrap().0
    defer { var _ = accepted.close() }
    // Doubling keeps setup cheap when GC stress collects at every allocation.
    var text = "x"
    while text.byteLen() < 16 * 1024 * 1024 { text = text.concat(text) }
    bytes := std::mem::Span[uint8]::fromString(&text)
    limit := std::time::Duration::fromMillis(40_u64)
    match await accepted.writeAllUntil(bytes, std::time::Instant::now().checkedAdd(limit).unwrap()) {
        case .err(error) => std::testing::assertTrue(error.isKind(.timedOut), "a peer that never reads times out")
        case .ok(_) => std::testing::fail("the whole write fit in socket buffers")
    }
}

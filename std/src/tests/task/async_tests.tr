import std.optional.Optional

func durationToNanos(_ d: std.time.Duration) -> uint64 {
    return (d.seconds() * 1000000000_u64) + (d.subsecNanos() as uint64)
}

func stringBytes(_ s: string) -> std.mem.Span[uint8] {
    return std.mem.Span[uint8].from(std.string.stringData(s), std.string.stringLen(s))
}

@cfg(family("unix"))
static var PIPE_WRITER_STREAM: Optional[std.io.task.AsyncStream] = .none

@cfg(family("unix"))
static var SHARED_PIPE_READ_STREAM: Optional[std.io.task.AsyncStream] = .none

@cfg(family("unix"))
static var SHARED_PIPE_WRITE_STREAM: Optional[std.io.task.AsyncStream] = .none

static var ASYNC_DEFER_RETURN_COUNT: int32 = 0
static var ASYNC_CANCEL_DEFER_TRACE: int32 = 0
static var TASK_SCOPE_CLEANUP_COUNT: int32 = 0
static var DETACHED_TASK_COMPLETED: int32 = 0
static var DETACHED_FUNCTION_COMPLETED: int32 = 0
static var SELECT_LOSER_CLEANUP_COUNT: int32 = 0

func asyncDeferReturnProbe() async -> int32 {
    defer {
        ASYNC_DEFER_RETURN_COUNT = ASYNC_DEFER_RETURN_COUNT + 1
    }

    await std.testing.yieldNow()
    return 77 as int32
}

func asyncCancellationCleanupProbe(_ ready: std.sync.Sender[int32]) async -> int32 {
    defer {
        ASYNC_CANCEL_DEFER_TRACE = (ASYNC_CANCEL_DEFER_TRACE * 10_i32) + 1_i32
    }

    {
        defer {
            ASYNC_CANCEL_DEFER_TRACE = (ASYNC_CANCEL_DEFER_TRACE * 10_i32) + 2_i32
        }

        match await ready.send(1_i32) {
            case .ok(_) => {}
            case .err(_) => std.panic.panic("cancellation cleanup probe should signal readiness")
        }
        await std.task.sleep(std.time.Duration.fromSeconds(5_u64))
    }

    return 99_i32
}

func asyncCancellationCleanupPanicProbe(_ ready: std.sync.Sender[int32]) async -> int32 {
    defer {
        std.panic.panic("panic from cancellation cleanup")
    }

    match await ready.send(1_i32) {
        case .ok(_) => {}
        case .err(_) => std.panic.panic("cancellation panic probe should signal readiness")
    }
    await std.task.sleep(std.time.Duration.fromSeconds(5_u64))
    return 1_i32
}

func taskScopeCleanupProbe(_ ready: std.sync.Sender[int32]) async -> int32 {
    defer {
        TASK_SCOPE_CLEANUP_COUNT = TASK_SCOPE_CLEANUP_COUNT + 1_i32
    }

    match await ready.send(1_i32) {
        case .ok(_) => {}
        case .err(_) => std.panic.panic("task scope cleanup probe should signal readiness")
    }
    await std.task.sleep(std.time.Duration.fromSeconds(5_u64))
    return 1_i32
}

func selectLoserCleanupProbe() async -> int32 {
    defer {
        SELECT_LOSER_CLEANUP_COUNT = SELECT_LOSER_CLEANUP_COUNT + 1_i32
    }
    await std.task.sleep(std.time.Duration.fromSeconds(5_u64))
    return 1_i32
}

func selectLoserCleanupPanicProbe() async -> string {
    defer {
        std.panic.panic("select loser cleanup panic")
    }
    await std.task.sleep(std.time.Duration.fromSeconds(5_u64))
    return "late"
}

func returnedOwnedTask() -> std.task.Task[int32] {
    let task = std.task.spawn(|| async {
        await std.testing.yieldNow()
        return 73_i32
    })
    return task
}

func releaseOwnedTaskParameter(_ task: std.task.Task[int32]) {
}

@cfg(family("unix"))
func sharedPipeReaderBody() async -> int32 {
    let reader = match SHARED_PIPE_READ_STREAM {
        case .some(value) => value
        case .none => std.panic.panic("shared pipe reader should be seeded before spawning")
    }

    var byte: uint8 = 0
    let readRes = await reader.read(std.mem.MutableSpan[uint8].from(unsafe { (&mut byte) as *mut uint8 }, 1))
    let readCount = match readRes {
        case .ok(count) => count
        case .err(_) => std.panic.panic("shared pipe reader should succeed")
    }
    std.testing.assertEqual(readCount, 1, "shared pipe reader should receive one byte")
    return byte as int32
}

@cfg(family("unix"))
func sharedPipeWriterBody() async -> int32 {
    let writer = match SHARED_PIPE_WRITE_STREAM {
        case .some(value) => value
        case .none => std.panic.panic("shared pipe writer should be seeded before spawning")
    }

    await std.testing.yieldNow()
    let writeRes = await writer.write(stringBytes("ab"))
    let written = match writeRes {
        case .ok(count) => count
        case .err(_) => std.panic.panic("shared pipe writer should succeed")
    }
    match writer.close() {
        case .ok(_) => {}
        case .err(_) => std.panic.panic("shared pipe writer close should succeed")
    }
    return written as int32
}

@cfg(family("unix"))
func pipeWriterBody() async -> int32 {
    let seeded = match PIPE_WRITER_STREAM.take() {
        case .some(value) => value
        case .none => std.panic.panic("pipe writer seed should be set before spawning")
    }

    let writer = seeded
    await std.testing.yieldNow()
    let writeRes = await writer.write(stringBytes("ping"))
    let written = match writeRes {
        case .ok(count) => count
        case .err(err) => std.panic.panic("pipe writer should succeed")
    }
    let closeRes = writer.close()
    match closeRes {
        case .ok(_) => {}
        case .err(err) => std.panic.panic("pipe writer close should succeed")
    }
    return written as int32
}

func asyncValue() async -> int32 {

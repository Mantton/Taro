@test
func joinReturnsBothTaskValues() async {
    let intTask = std.task.spawn(|| async {
        await std.testing.yieldNow()
        return 17 as int32
    })
    let stringTask = std.task.spawn(|| async {
        return "joined"
    })

    let joined = (await std.task.join(intTask, stringTask)).unwrap()
    std.testing.assertEqual(joined.0, 17, "join should preserve the left task result")
    std.testing.assertEqual(joined.1, "joined", "join should preserve the right task result")
}

@test
func joinHandlesDifferentCompletionTiming() async {
    let slow = std.task.spawn(|| async {
        await std.task.sleep(std.time.Duration.fromMillis(5_u64))
        return "slow"
    })
    let fast = std.task.spawn(|| async {
        await std.testing.yieldNow()
        return 99 as int32
    })

    let joined = (await std.task.join(slow, fast)).unwrap()
    std.testing.assertEqual(joined.0, "slow", "join should return the slower left task result")
    std.testing.assertEqual(joined.1, 99, "join should return the faster right task result")
}

@test
@expectPanic
func joinPropagatesTaskPanic() async {
    let left = std.task.spawn(|| async {
        await std.testing.yieldNow()
        return 7 as int32
    })
    let right = std.task.spawn(|| async {
        await std.testing.yieldNow()
        std.panic.panic("joined task panic should fail the awaiter")
    })

    let _ = (await std.task.join(left, right)).unwrap()
}

@test
func zeroDurationSleepCompletesImmediately() async {
    // With a multi-worker executor both tasks run on separate threads, so
    // comparing wall-clock timestamps across them is non-deterministic.
    // The real invariant is that a zero-duration sleep does not block forever.
    let sleeper = std.task.spawn(|| async {
        await std.task.sleep(std.time.Duration.fromNanos(0_u64))
        return 1 as int32
    })
    let yielded = std.task.spawn(|| async {
        await std.testing.yieldNow()
        return 2 as int32
    })

    let sleeperResult = (await sleeper.result()).unwrap()
    let yieldedResult = (await yielded.result()).unwrap()
    std.testing.assertEqual(sleeperResult, 1, "zero-duration sleep task should complete")
    std.testing.assertEqual(yieldedResult, 2, "yielded task should complete")
}

@test
func sleepDelaysExecution() async {
    let start = std.time.Instant.now()
    await std.task.sleep(std.time.Duration.fromMillis(5_u64))
    let elapsed = start.elapsed()
    std.testing.assertTrue(
        durationToNanos(elapsed) >= 1000000_u64,
        "sleep should measurably delay execution",
    )
}

@test
func spawnedSleepersWakeInDeadlineOrder() async {
    let short = std.task.spawn(|| async {
        await std.task.sleep(std.time.Duration.fromMillis(1_u64))
        return std.time.Instant.now()
    })
    let long = std.task.spawn(|| async {
        await std.task.sleep(std.time.Duration.fromMillis(5_u64))
        return std.time.Instant.now()
    })

    let shortAt = (await short.result()).unwrap()
    let longAt = (await long.result()).unwrap()
    let gap = longAt.checkedDurationSince(shortAt)
    std.testing.assertTrue(gap.isSome(), "shorter sleepers should wake no later than longer sleepers")
    std.testing.assertTrue(durationToNanos(gap.unwrap()) > 0_u64, "shorter sleepers should wake before longer sleepers")
}

@test
func multipleSpawnedTasksInterleave() async {
    let a = std.task.spawn(|| async {
        await std.testing.yieldNow()
        await std.testing.yieldNow()
        return 11 as int32
    })
    let b = std.task.spawn(|| async {
        await std.testing.yieldNow()
        return 12 as int32
    })

    let x = (await a.result()).unwrap()
    let y = (await b.result()).unwrap()
    std.testing.assertEqual(x + y, 23, "both spawned tasks should complete")
}

@test
func cancelledTaskResultReturnsCancelledError() async {
    let task = std.task.spawn(|| async {
        await std.task.sleep(std.time.Duration.fromMillis(200_u64))
        return 99 as int32
    })

    task.cancel()
    let result = await task.result()
    match result {
        case .ok(_) => std.panic.panic("cancelled task should resolve through Task.result() as an error")
        case .err(err) => match err {
            case .cancelled => {}
            case .panicked(_) => std.panic.panic("cancelled task should not report as panicked")
        }
    }
}

@test
@expectPanic
func taskValuePanicsOnCancelledTask() async {
    let task = std.task.spawn(|| async {
        await std.task.sleep(std.time.Duration.fromMillis(200_u64))
        return 7 as int32
    })

    task.cancel()
    let _ = (await task.result()).unwrap()
}

@test
func asyncDeferRunsOnNormalReturnAfterSuspension() async {
    ASYNC_DEFER_RETURN_COUNT = 0

    let value = await asyncDeferReturnProbe()

    std.testing.assertEqual(value, 77, "async defer probe should return its computed value")
    std.testing.assertEqual(
        ASYNC_DEFER_RETURN_COUNT,
        1,
        "async defer should run when an async function returns after suspension",
    )
}

@test
func cancellingSuspendedTaskRunsNestedDefersInLifoOrder() async {
    ASYNC_CANCEL_DEFER_TRACE = 0_i32
    let (readySender, readyReceiver) = match std.sync.bounded[int32](1) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("cancellation cleanup channel should be created")
    }
    let childReady = readySender
    let task = std.task.spawn(|| async {
        return await asyncCancellationCleanupProbe(childReady)
    })
    std.runtime.collect()

    match await readyReceiver.recv() {
        case .some(_) => {}
        case .none => std.panic.panic("cancellation cleanup probe should become ready")
    }
    task.cancel()

    match await task.result() {
        case .ok(_) => std.panic.panic("cancelled cleanup probe should not complete normally")
        case .err(.cancelled) => {}
        case .err(.panicked(_)) => std.panic.panic("cancelled cleanup probe should not panic")
    }

    std.testing.assertEqual(
        ASYNC_CANCEL_DEFER_TRACE,
        21_i32,
        "cancellation should run active nested defers from inner to outer",
    )
}

@test
func panicDuringCancellationCleanupBecomesTaskPanic() async {
    let (readySender, readyReceiver) = match std.sync.bounded[int32](1) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("cancellation panic channel should be created")
    }
    let childReady = readySender
    let task = std.task.spawn(|| async {
        return await asyncCancellationCleanupPanicProbe(childReady)
    })

    match await readyReceiver.recv() {
        case .some(_) => {}
        case .none => std.panic.panic("cancellation panic probe should become ready")
    }
    task.cancel()

    match await task.result() {
        case .ok(_) => std.panic.panic("cancellation cleanup panic should not succeed")
        case .err(.cancelled) => std.panic.panic("cleanup panic should supersede cancellation")
        case .err(.panicked(payload)) => {
            std.testing.assertTrue(
                payload.message() == "panic from cancellation cleanup",
                "cleanup panic payload should preserve its message",
            )
        }
    }
}

@test
func taskScopeExitCancelsAndReclaimsOwnedWork() async {
    TASK_SCOPE_CLEANUP_COUNT = 0_i32
    let (readySender, readyReceiver) = match std.sync.bounded[int32](1) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("task scope channel should be created")
    }

    {
        let childReady = readySender
        let task = std.task.spawn(|| async {
            return await taskScopeCleanupProbe(childReady)
        })
        match await readyReceiver.recv() {
            case .some(_) => {}
            case .none => std.panic.panic("owned task should reach its suspension point")
        }
    }

    var attempts: int32 = 0_i32
    while TASK_SCOPE_CLEANUP_COUNT == 0_i32 && attempts < 100_i32 {
        await std.testing.yieldNow()
        attempts = attempts + 1_i32
    }
    std.testing.assertEqual(
        TASK_SCOPE_CLEANUP_COUNT,
        1_i32,
        "leaving a Task scope should cancel it and run cleanup",
    )
}

@test
func overwritingTaskCancelsAndReclaimsPreviousWork() async {
    TASK_SCOPE_CLEANUP_COUNT = 0_i32
    let (readySender, readyReceiver) = match std.sync.bounded[int32](1) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("task overwrite channel should be created")
    }
    let childReady = readySender
    var task = std.task.spawn(|| async {
        return await taskScopeCleanupProbe(childReady)
    })
    match await readyReceiver.recv() {
        case .some(_) => {}
        case .none => std.panic.panic("overwritten task should reach its suspension point")
    }

    task = std.task.spawn(|| async { return 29_i32 })
    match await task.result() {
        case .ok(value) => std.testing.assertEqual(value, 29_i32, "replacement Task should stay live")
        case .err(_) => std.panic.panic("replacement Task should complete normally")
    }

    var attempts: int32 = 0_i32
    while TASK_SCOPE_CLEANUP_COUNT == 0_i32 && attempts < 100_i32 {
        await std.testing.yieldNow()
        attempts = attempts + 1_i32
    }
    std.testing.assertEqual(
        TASK_SCOPE_CLEANUP_COUNT,
        1_i32,
        "overwriting a Task should cancel and reclaim the previous handle",
    )
}

@test
func movingAndReturningTasksTransferScopeOwnership() async {
    let original = std.task.spawn(|| async {
        await std.testing.yieldNow()
        return 41_i32
    })
    let moved = original
    match await moved.result() {
        case .ok(value) => std.testing.assertEqual(value, 41_i32, "moved Task should stay live")
        case .err(_) => std.panic.panic("moving a Task should not cancel it")
    }

    let returned = returnedOwnedTask()
    match await returned.result() {
        case .ok(value) => std.testing.assertEqual(value, 73_i32, "returned Task should stay live")
        case .err(_) => std.panic.panic("returning a Task should transfer ownership")
    }
}

@test
func taskParameterOwnsAndReleasesMovedHandle() async {
    TASK_SCOPE_CLEANUP_COUNT = 0_i32
    let (readySender, readyReceiver) = match std.sync.bounded[int32](1) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("task parameter channel should be created")
    }
    let childReady = readySender
    let task = std.task.spawn(|| async {
        return await taskScopeCleanupProbe(childReady)
    })
    match await readyReceiver.recv() {
        case .some(_) => {}
        case .none => std.panic.panic("task parameter probe should become ready")
    }

    releaseOwnedTaskParameter(task)
    var attempts: int32 = 0_i32
    while TASK_SCOPE_CLEANUP_COUNT == 0_i32 && attempts < 100_i32 {
        await std.testing.yieldNow()
        attempts = attempts + 1_i32
    }
    std.testing.assertEqual(
        TASK_SCOPE_CLEANUP_COUNT,
        1_i32,
        "a Task parameter should release an unconsumed handle on return",
    )
}

@test
func detachedTaskContinuesAfterHandleScopeEnds() async {
    DETACHED_TASK_COMPLETED = 0_i32
    {
        let task = std.task.spawn(|| async {
            await std.testing.yieldNow()
            DETACHED_TASK_COMPLETED = 1_i32
            return 9_i32
        })
        task.detach()
    }

    var attempts: int32 = 0_i32
    while DETACHED_TASK_COMPLETED == 0_i32 && attempts < 100_i32 {
        await std.testing.yieldNow()
        attempts = attempts + 1_i32
    }
    std.testing.assertEqual(
        DETACHED_TASK_COMPLETED,
        1_i32,
        "detached Task should continue and discard its result",
    )
}

@test
func detachedFunctionStartsExplicitFireAndForgetWork() async {
    DETACHED_FUNCTION_COMPLETED = 0_i32
    std.task.detached(|| async {
        await std.testing.yieldNow()
        DETACHED_FUNCTION_COMPLETED = 1_i32
    })

    var attempts: int32 = 0_i32
    while DETACHED_FUNCTION_COMPLETED == 0_i32 && attempts < 100_i32 {
        await std.testing.yieldNow()
        attempts = attempts + 1_i32
    }
    std.testing.assertEqual(
        DETACHED_FUNCTION_COMPLETED,
        1_i32,
        "std.task.detached work should continue without an owned handle",
    )
}

@test
func cancellingCompletedTaskIsHarmless() async {
    let task = std.task.spawn(|| async {
        await std.task.sleep(std.time.Duration.fromMillis(1_u64))
        return 44 as int32
    })

    await std.task.sleep(std.time.Duration.fromMillis(10_u64))
    task.cancel()

    let result = await task.result()
    match result {
        case .ok(value) => std.testing.assertEqual(value, 44, "cancelling an already completed task should keep its value")
        case .err(_) => std.panic.panic("completed task should not become cancelled")
    }
}

@test
func cancellingSleepingTaskCompletesQuickly() async {
    let task = std.task.spawn(|| async {
        await std.task.sleep(std.time.Duration.fromMillis(250_u64))
        return 5 as int32
    })

    let start = std.time.Instant.now()
    task.cancel()
    let result = await task.result()
    let elapsed = start.elapsed()

    match result {
        case .ok(_) => std.panic.panic("cancelled sleeper should not resolve successfully")
        case .err(err) => match err {
            case .cancelled => {}
            case .panicked(_) => std.panic.panic("cancelled sleeper should not report as panicked")
        }
    }

    std.testing.assertTrue(
        durationToNanos(elapsed) < 150000000_u64,
        "cancelling a sleeping task should finish without waiting for the full sleep duration",
    )
}

@test
func taskIsCancelledIsFalseForActiveTask() async {
    let task = std.task.spawn(|| async {
        await std.testing.yieldNow()
        let moduleLevel = std.task.isCancelled()
        let typeLevel = std.task.Task[int32].isCancelled()
        std.testing.assertEqual(
            moduleLevel,
            typeLevel,
            "module and Task[T] cancellation APIs should agree",
        )
        return typeLevel
    })

    let result = (await task.result()).unwrap()
    std.testing.assertFalse(result, "isCancelled() should be false for active, non-cancelled tasks")
}

@test
func selectReturnsTypedFirstAndSecondBranches() async {
    let first = await std.task.select(
        || async { return 7_i32 },
        || async {
            await std.task.sleep(std.time.Duration.fromMillis(50_u64))
            return "late"
        },
    )
    match first {
        case .ok(.first(value)) => std.testing.assertEqual(value, 7_i32, "select should preserve the first value")
        case .ok(.second(_)) => std.panic.panic("the delayed second branch should not win")
        case .err(_) => std.panic.panic("successful selection should not return a task error")
    }

    let second = await std.task.select(
        || async {
            await std.task.sleep(std.time.Duration.fromMillis(50_u64))
            return 1_i32
        },
        || async { return "ready" },
    )
    match second {
        case .ok(.first(_)) => std.panic.panic("the delayed first branch should not win")
        case .ok(.second(value)) => std.testing.assertTrue(value == "ready", "select should preserve the second value")
        case .err(_) => std.panic.panic("successful selection should not return a task error")
    }
}

@test
func selectSurfacesLosingCancellationCleanupPanic() async {
    match await std.task.select(
        || async { return 5_i32 },
        || async { return await selectLoserCleanupPanicProbe() },
    ) {
        case .ok(_) => std.panic.panic("losing cleanup panic should supersede successful selection")
        case .err(.cancelled) => std.panic.panic("losing cleanup panic should supersede cancellation")
        case .err(.panicked(payload)) => {
            std.testing.assertTrue(
                payload.message() == "select loser cleanup panic",
                "selection should preserve losing cleanup panic payload",
            )
        }
    }
}

@test
func raceUsesStableFirstBranchTieBreak() async {
    var attempt = 0_i32
    while attempt < 32_i32 {
        match await std.task.race(
            || async { return 1_i32 },
            || async { return 2_i32 },
        ) {
            case .ok(value) => std.testing.assertEqual(value, 1_i32, "simultaneously-ready race should prefer the first branch")
            case .err(_) => std.panic.panic("ready race branches should not fail")
        }
        attempt = attempt + 1_i32
    }
}

@test
func withTimeoutDistinguishesCompletionAndExpiry() async {
    match await std.task.withTimeout(
        std.time.Duration.fromMillis(100_u64),
        || async { return 42_i32 },
    ) {
        case .ok(value) => std.testing.assertEqual(value, 42_i32, "operation should complete before its deadline")
        case .err(_) => std.panic.panic("ready operation should not time out")
    }

    // The task/deadline selector yields once before observing a zero deadline,
    // allowing an immediately-ready operation to win deterministically.
    match await std.task.withTimeout(
        std.time.Duration.fromMillis(0_u64),
        || async { return 9_i32 },
    ) {
        case .ok(value) => std.testing.assertEqual(value, 9_i32, "ready operation should beat a zero-duration timeout")
        case .err(_) => std.panic.panic("zero-duration tie should prefer ready work")
    }

    SELECT_LOSER_CLEANUP_COUNT = 0_i32
    match await std.task.withTimeout(
        std.time.Duration.fromMillis(5_u64),
        || async { return await selectLoserCleanupProbe() },
    ) {
        case .ok(_) => std.panic.panic("slow operation should time out")
        case .err(.timedOut) => {}
        case .err(.operation(_)) => std.panic.panic("ordinary timeout should not be an operation failure")
    }
    std.testing.assertEqual(
        SELECT_LOSER_CLEANUP_COUNT,
        1_i32,
        "timed-out operation should run cancellation cleanup exactly once",
    )
}

@test
func withTimeoutReturnsOperationPanicAndSupportsNesting() async {
    match await std.task.withTimeout(
        std.time.Duration.fromMillis(100_u64),
        || async -> int32 {
            std.panic.panic("timeout operation panic")
        },
    ) {
        case .ok(_) => std.panic.panic("panicking operation should not succeed")
        case .err(.timedOut) => std.panic.panic("panicking operation should not look like timeout")
        case .err(.operation(.cancelled)) => std.panic.panic("panicking operation should not look cancelled")
        case .err(.operation(.panicked(payload))) => {
            std.testing.assertTrue(payload.message() == "timeout operation panic", "timeout should preserve operation panic payload")
        }
    }

    let nested = await std.task.withTimeout(
        std.time.Duration.fromMillis(100_u64),
        || async {
            return await std.task.withTimeout(
                std.time.Duration.fromMillis(5_u64),
                || async {
                    await std.task.sleep(std.time.Duration.fromMillis(100_u64))
                    return 3_i32
                },
            )
        },
    )
    match nested {
        case .ok(.err(.timedOut)) => {}
        case .ok(_) => std.panic.panic("inner timeout should remain distinct inside outer success")
        case .err(_) => std.panic.panic("outer timeout should allow inner timeout to finish")
    }
}

@test
func selectSupportsChannelAndTaskGroupOperations() async {
    let (sender, receiver) = match std.sync.bounded[int32](1) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("select channel should be created")
    }
    match sender.trySend(17_i32) {
        case .ok(_) => {}
        case .err(_) => std.panic.panic("select channel should accept its ready value")
    }
    match await std.task.select(
        || async { return await receiver.recv() },
        || async {
            await std.task.sleep(std.time.Duration.fromMillis(100_u64))
            return false
        },
    ) {
        case .ok(.first(.some(value))) => std.testing.assertEqual(value, 17_i32, "channel receive should participate in select")
        case .ok(_) => std.panic.panic("ready channel receive should win selection")
        case .err(_) => std.panic.panic("channel selection should not fail")
    }
    let groupValue: int32 = await std.task.withTaskGroup(|group: &mut std.task.TaskGroup[int32]| async {
        group.spawn(|| async { return 23_i32 })
        match await std.task.select(
            move || async {
                var groupRef = group
                return await groupRef.next()
            },
            || async {
                await std.task.sleep(std.time.Duration.fromMillis(100_u64))
                return false
            },
        ) {
            case .ok(.first(.some(value))) => return value
            case .ok(_) => std.panic.panic("ready task-group result should win selection")
            case .err(_) => std.panic.panic("task-group selection should not fail")
        }
    })
    std.testing.assertEqual(groupValue, 23_i32, "task group next should participate in select")
}

@test
func withTaskGroupCollectsResultsViaForAwait() async {
    let total: int32 = await std.task.withTaskGroup(|group: &mut std.task.TaskGroup[int32]| async {
        group.spawn(|| async {
            await std.testing.yieldNow()
            return 11 as int32
        })
        group.spawn(|| async {
            return 31 as int32
        })

        var seen = 0 as int32
        var sum = 0 as int32
        for await value in group {
            sum += value
            seen += 1
        }
        std.testing.assertEqual(seen, 2, "task group should yield both spawned task results")

        return sum
    })

    std.testing.assertEqual(total, 42, "withTaskGroup should surface successful child results through for await")
}

@test
func withTaskGroupCancelsRemainingTasksWhenBodyReturnsEarly() async {
    let start = std.time.Instant.now()
    let value: int32 = await std.task.withTaskGroup(|group: &mut std.task.TaskGroup[int32]| async {
        group.spawn(|| async {
            await std.task.sleep(std.time.Duration.fromMillis(250_u64))
            return 1 as int32
        })

        return 9 as int32
    })
    let elapsed = start.elapsed()

    std.testing.assertEqual(value, 9, "withTaskGroup should return the body result")
    std.testing.assertTrue(
        durationToNanos(elapsed) < 150000000_u64,
        "withTaskGroup should cancel outstanding children when the body returns early",
    )
}

@test
@expectPanic
func withTaskGroupCancelOnPanicCancelsSiblingsThenRethrows() async {
    let _ = await std.task.withTaskGroup(policy: .cancelOnPanic, |group: &mut std.task.TaskGroup[int32]| async {
        group.spawn(|| async {
            await std.testing.yieldNow()
            std.panic.panic("child panic should be rethrown after group cleanup")
        })
        group.spawn(|| async {
            await std.task.sleep(std.time.Duration.fromMillis(250_u64))
            return 1 as int32
        })

        match await group.next() {
            case .some(_) => std.panic.panic("cancel-on-panic policy should not yield successful sibling results")
            case .none => {}
        }

        return 0 as int32
    })
}

@test
@expectPanic
func withTaskGroupIndependentLetsSiblingsContinueBeforeRethrow() async {
    let _ = await std.task.withTaskGroup(policy: .independent, |group: &mut std.task.TaskGroup[int32]| async {
        group.spawn(|| async {
            await std.testing.yieldNow()
            std.panic.panic("independent group should still rethrow child panic after cleanup")
        })
        group.spawn(|| async {
            await std.testing.yieldNow()
            await std.testing.yieldNow()
            return 7 as int32
        })

        match await group.next() {
            case .some(value) => {
                std.testing.assertEqual(value, 7, "independent policy should let siblings complete after another child panics")
            }
            case .none => std.panic.panic("independent policy should still yield sibling results before scope cleanup")
        }

        return 0 as int32
    })
}

@test
@expectPanic
func withTaskGroupBodyPanicRemainsVisible() async {
    let _ = await std.task.withTaskGroup(policy: .independent, |group: &mut std.task.TaskGroup[int32]| async {
        group.spawn(|| async {
            await std.testing.yieldNow()
            std.panic.panic("child panic should not replace the body panic")
        })

        std.panic.panic("body panic should remain visible after group cleanup")
    })
}

@test
func spawnedTaskPanicIsolatedFromTest() async {
    // Detached spawned task panics are now isolated: they print to stderr
    // but do not crash the program or fail the test.
    let task = std.task.spawn(|| async {
        await std.testing.yieldNow()
        std.panic.panic("spawned task panic should be isolated")
    })
    let result = await task.result()
    match result {
        case .ok(_) => std.panic.panic("panicking task should not succeed")
        case .err(err) => match err {
            case .panicked(payload) => {
                std.testing.assertTrue(
                    payload.message() == "spawned task panic should be isolated",
                    "panic payload message should match the original panic message",
                )
            }
            case .cancelled => std.panic.panic("panicking task should not report as cancelled")
        }
    }
}

@test
func syncSpawnedTaskPanicIsIsolated() {
    // Detached spawned task panics are now isolated: they print to stderr
    // but do not crash the program or fail the test.
    std.task.detached(|| async {
        await std.testing.yieldNow()
        std.panic.panic("spawned task panic should be isolated in sync test")
    })
}

@cfg(family("unix"))
@test
func asyncStreamPipeRoundTrip() async {
    let pipeRes = std.io.task.pipe()
    let pipePair = match pipeRes {
        case .ok(value) => value
        case .err(err) => std.panic.panic("pipe() should succeed on unix")
    }
    let readEnd = pipePair.0
    let writeEnd = pipePair.1

    var writerSeed = writeEnd
    PIPE_WRITER_STREAM = .some(writerSeed)
    let writerTask = std.task.spawn(|| async {
        return await pipeWriterBody()
    })

    let reader = readEnd
    var storage: [uint8; 4] = [0; 4]
    let storagePtr = unsafe { (&mut storage as *mut [uint8; 4]) as *mut uint8 }
    let readRes = await reader.read(std.mem.MutableSpan[uint8].from(storagePtr, 4))
    let readCount = match readRes {
        case .ok(count) => count
        case .err(err) => std.panic.panic("pipe reader should succeed")
    }

    std.testing.assertEqual(readCount, 4, "pipe reader should receive the full payload")
    std.testing.assertEqual(*storage.at(0 as usize), 112_u8, "first byte should be 'p'")
    std.testing.assertEqual(*storage.at(1 as usize), 105_u8, "second byte should be 'i'")
    std.testing.assertEqual(*storage.at(2 as usize), 110_u8, "third byte should be 'n'")
    std.testing.assertEqual(*storage.at(3 as usize), 103_u8, "fourth byte should be 'g'")

    let written = (await writerTask.result()).unwrap()
    std.testing.assertEqual(written, 4, "pipe writer should report the written byte count")

    let eofRes = await reader.read(std.mem.MutableSpan[uint8].from(storagePtr, 4))
    let eofCount = match eofRes {
        case .ok(count) => count
        case .err(err) => std.panic.panic("pipe reader should observe EOF after writer close")
    }
    std.testing.assertEqual(eofCount, 0, "closing the pipe writer should produce EOF on the reader")

    let closeRes = reader.close()
    match closeRes {
        case .ok(_) => {}
        case .err(err) => std.panic.panic("pipe reader close should succeed")
    }
}

@cfg(family("unix"))
@test
func asyncStreamSupportsConcurrentReadWaiters() async {
    let pipeRes = std.io.task.pipe()
    let pipePair = match pipeRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("pipe() should succeed on unix")
    }

    SHARED_PIPE_READ_STREAM = .some(pipePair.0)
    SHARED_PIPE_WRITE_STREAM = .some(pipePair.1)
    let firstReader = std.task.spawn(|| async {
        return await sharedPipeReaderBody()
    })
    let secondReader = std.task.spawn(|| async {
        return await sharedPipeReaderBody()
    })
    let writer = std.task.spawn(|| async {
        return await sharedPipeWriterBody()
    })

    let firstByte = (await firstReader.result()).unwrap()
    let secondByte = (await secondReader.result()).unwrap()
    let written = (await writer.result()).unwrap()
    std.testing.assertEqual(written, 2, "shared pipe writer should write both bytes")
    std.testing.assertTrue(firstByte != secondByte, "separate read waiters should each receive one byte")
    std.testing.assertEqual(firstByte + secondByte, 195, "shared waiters should receive the written byte payload")
    SHARED_PIPE_READ_STREAM = .none
    SHARED_PIPE_WRITE_STREAM = .none
}

@cfg(family("unix"))
@test
func asyncStreamHelperApisRoundTrip() async {
    let pipeRes = std.io.task.pipe()
    let pair = match pipeRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("pipe() should succeed on unix")
    }

    let reader = pair.0
    let writer = pair.1

    let writerTask = std.task.spawn(|| async {
        let writeRes = await std.io.task.writeString(&writer, "helper-apis")
        match writeRes {
            case .ok(_) => {}
            case .err(_) => std.panic.panic("async stream writeString should succeed")
        }
        match writer.close() {
            case .ok(_) => {}
            case .err(_) => std.panic.panic("async stream close should succeed")
        }
        return 1_i32
    })

    let textRes = await std.io.task.readToString(&reader)
    let text = match textRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("readToString helper should succeed")
    }
    std.testing.assertEqual(text, "helper-apis", "async helper readToString should read the full stream")

    let done = (await writerTask.result()).unwrap()
    std.testing.assertEqual(done, 1_i32, "writer task should complete")

    match reader.close() {
        case .ok(_) => {}
        case .err(_) => std.panic.panic("reader close should succeed")
    }
}

func applyAsyncMut[F: std.ops.AsyncFnMut(int32) -> int32](_ f: F, _ x: int32) async -> int32 {
    var f = f
    let first = await f(x)
    let second = await f(x)
    return first + second
}

func applyZeroAsyncMut[F: std.ops.AsyncFnMut() -> int32](_ f: F) async -> int32 {
    var f = f
    let a = await f()
    let b = await f()
    let c = await f()
    return a + b + c
}

@test
func asyncClosuresSatisfyAsyncFnMutBounds() async {
    let captured = 2 as int32
    let closure = |x: int32| async {
        await std.testing.yieldNow()
        return (x * 3) + captured
    }
    let value = await applyAsyncMut(closure, 5)
    // (5*3+2) + (5*3+2) = 34
    std.testing.assertEqual(value, 34, "copy-capturing async closure should satisfy AsyncFnMut and be reusable")
}

@test
func asyncClosuresReusedThroughZeroArgAsyncFnMut() async {
    let closure = || async {
        await std.testing.yieldNow()
        return 7 as int32
    }
    let sum = await applyZeroAsyncMut(closure)
    // 7 + 7 + 7 = 21
    std.testing.assertEqual(sum, 21, "non-capturing async closure should be reusable through AsyncFnMut() bound")
}

@test
func awaitedPanickedTaskResultReturnsPanickedError() async {
    let task = std.task.spawn(|| async {
        await std.testing.yieldNow()
        std.panic.panic("intentional task panic")
    })
    let result = await task.result()
    let message = match result {
        case .ok(_) => std.panic.panic("panicking task should not succeed")
        case .err(err) => match err {
            case .panicked(payload) => payload.message()
            case .cancelled => std.panic.panic("panicking task should not report as cancelled")
        }
    }
    std.runtime.collect()
    std.testing.assertTrue(
        message == "intentional task panic",
        "panic payload message should survive collection after its payload leaves scope",
    )
}

@test
@expectPanic
func panicPayloadRethrowReRaisesOriginalPanic() async {
    let task = std.task.spawn(|| async {
        await std.testing.yieldNow()
        std.panic.panic("rethrow test panic")
    })
    let result = await task.result()
    match result {
        case .ok(_) => std.panic.panic("panicking task should not succeed")
        case .err(err) => match err {
            case .panicked(payload) => payload.rethrow()
            case .cancelled => std.panic.panic("panicking task should not report as cancelled")
        }
    }
}

@test
func blockingMovesGcCapturesAndResultsAcrossThreads() async {
    let captured = "blocking"
    let result = await std.task.blocking(move || {
        std.runtime.collect()
        return captured + "-result"
    })
    std.runtime.collect()
    std.testing.assertTrue(
        result == "blocking-result",
        "blocking should preserve GC-backed captures and results",
    )
}

@test
func blockingPanicIsDeliveredThroughTaskResult() async {
    let task = std.task.spawn(|| async -> int32 {
        return await std.task.blocking(|| -> int32 {
            std.panic.panic("blocking closure panic")
        })
    })
    match await task.result() {
        case .ok(_) => std.panic.panic("panicking blocking work should not succeed")
        case .err(.cancelled) => std.panic.panic("panicking blocking work should not look cancelled")
        case .err(.panicked(payload)) => std.testing.assertTrue(
            payload.message() == "blocking closure panic",
            "blocking panic should retain its original message",
        )
    }
}

@cfg(family("unix"))
@test
func cancelledBlockingWorkAbandonsDeliveryWithoutStoppingThread() async {
    var fds: [int32; 2] = [0_i32, 0_i32]
    let fdsPtr = unsafe { (&mut fds as *mut [int32; 2]) as *mut int32 }
    std.testing.assertEqual(std.libc.pipe(fdsPtr), 0_i32, "pipe should be created")
    let readFd: int32 = *fds.at(0)
    let writeFd: int32 = *fds.at(1)

    let task = std.task.spawn(move || async -> uint8 {
        return await std.task.blocking(move || -> uint8 {
            var byte: uint8 = 0
            let read = std.libc.read(readFd, unsafe { (&mut byte) as *mut uint8 }, 1)
            if read != 1 {
                std.panic.panic("blocking read should receive one byte")
            }
            return byte
        })
    })

    await std.task.sleep(std.time.Duration.fromMillis(20_u64))
    // A blocked native call is in a GC safepoint, so collection must not wait
    // for the pipe to become readable.
    std.runtime.collect()
    task.cancel()
    match await task.result() {
        case .err(.cancelled) => {}
        case .err(.panicked(_)) => std.panic.panic("cancelled blocking work should not panic")
        case .ok(_) => std.panic.panic("cancelled blocking work should abandon its result")
    }

    var byte: uint8 = 37
    std.testing.assertEqual(
        std.libc.write(writeFd, unsafe { (&byte) as *const uint8 }, 1),
        1,
        "blocked worker should be released normally",
    )
    await std.task.sleep(std.time.Duration.fromMillis(20_u64))
    let _ = std.libc.close(readFd)
    let _ = std.libc.close(writeFd)
}

func gcSuspendedTaskValue(_ captured: int32) async -> int32 {
    await std::task::sleep(std::time::Duration::fromMillis(10_u64))
    return captured
}

struct NativeSuspendedTaskOwner {
    value: int32
}

struct NativeSuspendedTaskWrapper {
    owner: std::runtime::SharedOwner[NativeSuspendedTaskOwner]
}

// Carry the shared handle through suspension; create a field borrow only after
// resumption rather than keeping shared class-field access across await.
func gcSuspendedManagedTaskValue(_ captured: std::runtime::SharedOwner[NativeSuspendedTaskOwner]) async -> int32 {
    await std::task::sleep(std::time::Duration::fromMillis(10_u64))
    return captured.get().value
}

@test
func suspendedSpawnedTasksSurviveManualGc() async {
    taskCount := 17_i32
    var tasks = std::collections::List[std::task::Task[int32]]::new()

    var idx: int32 = 0
    while idx < taskCount {
        captured := idx + 1_i32
        task := std::task::spawn(() async => {
            return await gcSuspendedTaskValue(captured)
        })
        tasks.append(task)
        idx += 1_i32
    }

    var sum: int32 = 0
    while !tasks.isEmpty() {
        task := match tasks.pop() {
            case .some(t) => t
            case .none => std::panic::panic("task list should not be empty")
        }
        value := (await task.result()).unwrap()
        sum += value
    }

    std::testing::assertEqual(sum, 153_i32, "owned suspended task frames preserve their captures")
}

@test
func suspendedSpawnedTaskManagedReferencesSurviveManualGc() async {
    owner := std::runtime::SharedOwner[NativeSuspendedTaskOwner]::new(NativeSuspendedTaskOwner { value: 91_i32 })
    wrapper := NativeSuspendedTaskWrapper { owner }
    task := std::task::spawn(() async => {
        await std::testing::yieldNow()
        return await gcSuspendedManagedTaskValue(wrapper.owner)
    })

    value := (await task.result()).unwrap()
    std::testing::assertEqual(value, 91_i32, "native owner retains captured values in suspended task frames")
}


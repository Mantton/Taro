unsafe func writeStringThroughPointer(_ dst: *mut string, _ value: string) {
    unsafe { dst.write(value) }
}

@test
func testMaybeUninitWriteSurvivesCollect() {
    var slot = std::mem::MaybeUninit[string]::uninit()
    var _ = slot.write("hello maybe")

    value := unsafe { slot.assumeInitRead() }
    std::testing::assertEqual(
        value,
        "hello maybe",
        "MaybeUninit.write should copy the initialized value",
    )
}

@test
func testMaybeUninitPointerWriteSurvivesCollect() {
    var slot = std::mem::MaybeUninit[string]::uninit()
    unsafe { writeStringThroughPointer(slot.asMutPtr(), "pointer maybe") }

    value := unsafe { slot.assumeInitRead() }
    std::testing::assertEqual(
        value,
        "pointer maybe",
        "MaybeUninit pointer writes should remain visible to compiler stack maps",
    )
}

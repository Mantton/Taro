import std::collections::List
import std::mem::Span

@test
func testArrayAsSpanReadWrite() {
    var values: [int32; 4] = [7, 8, 9, 10]

    view := values.asSpan()
    std::testing::assertEqual(view.len(), 4 as usize, "Array.asSpan length should match")
    std::testing::assertEqual(*view.at(1), 8, "Array.asSpan immutable read mismatch")

    var mutView: std::mem::Span[int32] = values.asSpan()
    *mutView.at(1) = 80
    // Slice copies and the source continue to share their elements.
    std::testing::assertEqual(*mutView.at(1), 80, "Array.asSpan mutable write mismatch")

    var tail: std::mem::Span[int32] = mutView.slice(1, 2)
    *tail.at(0) = 81
    std::testing::assertEqual(*values.at(1), 81, "Array.asSpan mutable slice write mismatch")
}

@test
func testListAsSpanReadWrite() {
    var values: List[int32] = List::new()
    values.append(100)
    values.append(101)
    values.append(102)

    view := values.asSpan()
    std::testing::assertEqual(view.len(), 3 as usize, "List.asSpan length should match")
    std::testing::assertEqual(*view.at(0), 100, "List.asSpan immutable read mismatch")

    var mutView: std::mem::Span[int32] = values.asSpan()
    *mutView.at(2) = 1002
    // Slices keep the old allocation alive if the list later grows.
    std::testing::assertEqual(*mutView.at(2), 1002, "List.asSpan mutable write mismatch")

    var tail: std::mem::Span[int32] = mutView.slice(1, 2)
    *tail.at(0) = 1001
    std::testing::assertEqual(*values.at(2), 1002, "List.asSpan write must reach the original owner")
    std::testing::assertEqual(*values.at(1), 1001, "List.asSpan mutable slice write mismatch")
}

@noinline
func escapingSpanElement(_ span: Span[uint8], _ index: usize) -> &uint8 { span.at(index) }

@test
func spanAtDoesNotAllocateAnEscapingCopy() {
    text := "abc"
    span := Span[uint8]::fromString(&text)
    var total: uint64 = 0
    before := std::runtime::gcStats()
    var index: usize = 0
    while index < 64 {
        total += *escapingSpanElement(span, index % 3) as uint64
        index += 1
    }
    after := std::runtime::gcStats()
    std::testing::assertEqual(total, 6271_u64, "elements read through escaping references")
    std::testing::assertEqual(after.allocatedBytes - before.allocatedBytes, 0_u64, "Span.at must not heap-allocate a copy of the span")
}

@test
func testCollectionReferenceSpanCoercionsShareStorage() {
    var array: [int32; 3] = [10, 20, 30]
    var list: List[int32] = [40, 50, 60]
    var view: Span[int32] = &array
    view[1] = 21
    std::testing::assertEqual(array[1], 21_i32, "array reference coercion must share original storage")
    view = &list
    view[1] = 51
    std::testing::assertEqual(list[1], 51_i32, "list reference coercion must share original storage")
}

@noinline
func coercedLocalArrayView() -> Span[string] {
    var values: [string; 2] = ["array".concat(" first"), "array".concat(" second")]
    return &values
}

@test
func testCoercedArrayViewRetainsEscapingBackingStorage() {
    view := coercedLocalArrayView()
    std::runtime::collect()
    std::testing::assertEqual(view[0], "array first", "coerced view must retain the original array allocation")
    std::testing::assertEqual(view[1], "array second", "retained array must trace its string elements")
}

@test
func testCoercedListViewKeepsItsCapturedBufferAndLength() {
    var list: List[string] = ["list".concat(" first"), "list".concat(" second")]
    var view: Span[string] = &list
    list.reserve(128)
    list.clear()
    std::runtime::collect()
    std::testing::assertEqual(view.len(), 2 as usize, "view length is captured at conversion")
    std::testing::assertEqual(view[1], "list second", "growth and clear must not invalidate the old view")
}

@test
func testCollectionReferenceSpanCoercionsAcceptEmptyAndZeroSizedArrays() {
    var empty: [int32; 0] = []
    var emptyList: List[int32] = []
    var arrayView: Span[int32] = &empty
    var listView: Span[int32] = &emptyList
    std::testing::assertTrue(arrayView.isEmpty() && listView.isEmpty(), "empty collections form empty views")
    var units: [(); 2] = [(), ()]
    var unitView: Span[()] = &units
    std::testing::assertEqual(unitView.len(), 2 as usize, "zero-sized elements retain their logical count")
}

import std.path
import std.path.posix
import std.testing.{assertEqual, assertTrue, assertFalse, fail}

func assertSome(_ value: string?, _ expected: string, _ message: string) {
    match value {
        case .some(actual) => assertEqual(actual, expected, message)
        case .none => fail(message)
    }
}

func assertNone(_ value: string?, _ message: string) {
    assertTrue(value.isNone(), message)
}

func assertStringParts(
    _ actual: &std.collections.List[string],
    _ expected: std.mem.Span[string],
    _ message: string,
) {
    assertEqual(actual.len(), expected.len(), message)
    var index: usize = 0
    while index < expected.len() {
        assertEqual(*actual.at(index), *expected.at(index), message)
        index += 1
    }
}

func assertRelativeOk(
    _ result: std.result.Result[string, posix.RelativeError],
    _ expected: string,
    _ message: string,
) {
    match result {
        case .ok(actual) => assertEqual(actual, expected, message)
        case .err(_) => fail(message)
    }
}

func assertRelativeError(
    _ result: std.result.Result[string, posix.RelativeError],
    _ expected: posix.RelativeError,
    _ message: string,
) {
    match result {
        case .ok(_) => fail(message)
        case .err(actual) => assertEqual(actual, expected, message)
    }
}

// =====================================================================
// std.path.posix — platform-independent, always '/'.
// =====================================================================

@test
func testPosixSeparatorConstant() {
    assertEqual(posix.SEPARATOR, "/", "posix.SEPARATOR is /")
}

@test
func testPosixIsSeparator() {
    assertTrue(posix.isSeparator(47), "'/' (47) is a separator")
    assertFalse(posix.isSeparator(92), "'\\' (92) is not a posix separator")
    assertFalse(posix.isSeparator(0), "NUL is not a separator")
    assertFalse(posix.isSeparator(65), "'A' is not a separator")
}

@test
func testPosixNormalizeSeparators() {
    assertEqual(posix.normalizeSeparators("a//b///c"), "a/b/c", "collapses internal runs")
    assertEqual(posix.normalizeSeparators("/"), "/", "single slash is preserved")
    assertEqual(posix.normalizeSeparators("//"), "/", "double slash collapses to single")
    assertEqual(posix.normalizeSeparators(""), "", "empty stays empty")
    assertEqual(posix.normalizeSeparators("abc"), "abc", "no separators left unchanged")
    assertEqual(posix.normalizeSeparators("/a/b"), "/a/b", "already-normalized input")
    assertEqual(posix.normalizeSeparators("///a////b//"), "/a/b/", "mixed runs")
}

@test
func testPosixIsAbsolute() {
    assertTrue(posix.isAbsolute("/a"), "/a is absolute")
    assertTrue(posix.isAbsolute("/"), "/ is absolute")
    assertFalse(posix.isAbsolute("a"), "a is relative")
    assertFalse(posix.isAbsolute(""), "empty is not absolute")
    assertFalse(posix.isAbsolute("a/b"), "a/b is relative")
}

@test
func testPosixComponentsPreserveLexicalStructure() {
    let empty = posix.components("")
    assertEqual(empty.len(), 0 as usize, "empty path has no components")

    let root = posix.components("///")
    let expectedRoot: [string; 1] = ["/"]
    assertStringParts(&root, expectedRoot.asSpan(), "root is represented explicitly")

    let absolute = posix.components("/a//./b/../")
    let expectedAbsolute: [string; 5] = ["/", "a", ".", "b", ".."]
    assertStringParts(&absolute, expectedAbsolute.asSpan(), "absolute components preserve dot segments")

    let relative = posix.components("a///.././b//")
    let expectedRelative: [string; 4] = ["a", "..", ".", "b"]
    assertStringParts(&relative, expectedRelative.asSpan(), "relative components ignore separator runs")
}

@test
func testPosixClean() {
    assertEqual(posix.clean(""), ".", "empty path cleans to dot")
    assertEqual(posix.clean("."), ".", "dot remains dot")
    assertEqual(posix.clean("/"), "/", "root remains root")
    assertEqual(posix.clean("///a//b/"), "/a/b", "separator runs and trailing separators are removed")
    assertEqual(posix.clean("a/./b"), "a/b", "dot components are removed")
    assertEqual(posix.clean("a/b/.."), "a", "parent removes the preceding component")
    assertEqual(posix.clean("a/../.."), "..", "relative paths retain traversal above their start")
    assertEqual(posix.clean("../../a"), "../../a", "leading relative parents remain")
    assertEqual(posix.clean("/../../a"), "/a", "absolute paths cannot traverse above root")
}

@test
func testPosixJoin() {
    assertEqual(posix.join("a", "b"), "a/b", "basic join inserts separator")
    assertEqual(posix.join("a/", "b"), "a/b", "trailing slash on lhs not duplicated")
    assertEqual(posix.join("a", "/b"), "a/b", "leading slash on rhs absorbed")
    assertEqual(posix.join("", "b"), "b", "empty lhs returns rhs")
    assertEqual(posix.join("a", ""), "a", "empty rhs returns lhs")
    assertEqual(posix.join("a/", "/b"), "a/b", "dup separators collapse to one")
    assertEqual(posix.join("/tmp", "file.txt"), "/tmp/file.txt", "absolute lhs preserved")
    assertEqual(posix.join("", ""), "", "both empty")
    assertEqual(posix.join("a", ".."), ".", "join cleans parent components")
    assertEqual(posix.join("/a", "../b"), "/b", "join cleans beneath an absolute root")
}

@test
func testPosixJoinAll() {
    assertEqual(posix.joinAll(), "", "joining no paths produces empty")
    assertEqual(posix.joinAll("", "", ""), "", "joining only empty paths produces empty")
    assertEqual(posix.joinAll("a", "b", "..", "c"), "a/c", "joinAll cleans the combined path")
    assertEqual(posix.joinAll("/", "..", "a"), "/a", "joinAll cannot traverse above root")
    assertEqual(posix.joinAll("a/", "/b", "./c"), "a/b/c", "joinAll normalizes separators")
}

@test
func testPosixSplit() {
    let (absoluteDir, absoluteFile) = posix.split("/a/b")
    assertEqual(absoluteDir, "/a/", "split preserves the directory separator")
    assertEqual(absoluteFile, "b", "split returns the final component")

    let (trailingDir, trailingFile) = posix.split("/a/b/")
    assertEqual(trailingDir, "/a/b/", "split preserves a trailing separator in the directory")
    assertEqual(trailingFile, "", "split after a trailing separator has an empty file")

    let (bareDir, bareFile) = posix.split("name")
    assertEqual(bareDir, "", "bare names have an empty split directory")
    assertEqual(bareFile, "name", "bare names remain the split file")

    let (rootDir, rootFile) = posix.split("/")
    assertEqual(rootDir, "/", "root is entirely the split directory")
    assertEqual(rootFile, "", "root has an empty split file")

    let (emptyDir, emptyFile) = posix.split("")
    assertEqual(emptyDir, "", "empty split directory is empty")
    assertEqual(emptyFile, "", "empty split file is empty")
}

@test
func testPosixBaseAndDir() {
    assertEqual(posix.base(""), ".", "base of empty is dot")
    assertEqual(posix.base("/"), "/", "base of root is root")
    assertEqual(posix.base("///"), "/", "base of repeated root separators is root")
    assertEqual(posix.base("/a/b/"), "b", "base ignores trailing separators")
    assertEqual(posix.base("name"), "name", "base preserves a bare name")

    assertEqual(posix.dir(""), ".", "dir of empty is dot")
    assertEqual(posix.dir("name"), ".", "dir of a bare name is dot")
    assertEqual(posix.dir("/a"), "/", "dir of a root child is root")
    assertEqual(posix.dir("/a/b/"), "/a/b", "dir cleans a trailing separator")
    assertEqual(posix.dir("a//b"), "a", "dir cleans repeated separators")
}

@test
func testPosixRelative() {
    assertRelativeOk(posix.relative("/a/b", "/a/c"), "../c", "absolute siblings use one parent")
    assertRelativeOk(posix.relative("/a/b", "/a/b"), ".", "equal paths are dot")
    assertRelativeOk(posix.relative("/", "/a"), "a", "root can reach a child directly")
    assertRelativeOk(posix.relative(".", "a/b"), "a/b", "dot base contributes no component")
    assertRelativeOk(posix.relative("a/b", "a/c"), "../c", "relative siblings use one parent")
    assertRelativeOk(posix.relative("a", "."), "..", "relative can return to its lexical start")
    assertRelativeOk(posix.relative("../a", "../b"), "../b", "shared leading parents are resolvable")

    assertRelativeError(
        posix.relative("/a", "a"),
        .incompatibleRoots,
        "absolute and relative paths are incompatible",
    )
    assertRelativeError(
        posix.relative("../a", "b"),
        .unresolvedBase,
        "an unmatched leading parent in base is unresolved",
    )
    assertEqual(
        std.sprintf("%v", posix.RelativeError.unresolvedBase),
        "relative base begins with an unresolved parent component",
        "relative errors explain why lexical resolution failed",
    )
}

@test
func testPosixStripPrefix() {
    assertSome(posix.stripPrefix("/a/b/c", "/a/b"), "c", "rooted component prefix is removed")
    assertSome(posix.stripPrefix("a//b/./c", "a/b"), "./c", "suffix keeps dot components")
    assertSome(posix.stripPrefix("a/b", "a/b"), "", "exact match has an empty suffix")
    assertSome(posix.stripPrefix("a///b//c/", "a//b/"), "c", "separator runs are structural")
    assertSome(posix.stripPrefix("/a/b", "/"), "a/b", "root prefix leaves a relative suffix")
    assertSome(posix.stripPrefix("a/../b", "a"), "../b", "parent components remain unchanged")
    assertNone(posix.stripPrefix("/a/b", "a"), "rooted and relative paths do not match")
    assertNone(posix.stripPrefix("ab/c", "a"), "partial components do not match")
    assertNone(posix.stripPrefix("a/c", "a/b"), "different components do not match")
}

@test
func testPosixFileName() {
    assertSome(posix.fileName("/tmp/file.txt"), "file.txt", "/tmp/file.txt")
    assertSome(posix.fileName("/tmp/"), "tmp", "trailing slash stripped")
    assertNone(posix.fileName("/"), "/ has no filename")
    assertNone(posix.fileName(""), "empty has no filename")
    assertSome(posix.fileName("file.txt"), "file.txt", "bare name is the filename")
    assertSome(posix.fileName("a/b/c"), "c", "trailing segment of nested path")
}

@test
func testPosixExtension() {
    assertSome(posix.extension("file.txt"), "txt", "simple extension")
    assertSome(posix.extension("archive.tar.gz"), "gz", "last-dot wins")
    assertNone(posix.extension("file"), "no-dot file has no extension")
    assertNone(posix.extension(".gitignore"), "leading-dot file has no extension")
    assertNone(posix.extension(""), "empty has no extension")
    assertNone(posix.extension("/"), "root has no extension")
    assertSome(posix.extension("/tmp/file.txt"), "txt", "from final component")
    assertNone(posix.extension("/tmp/.gitignore"), "hidden via absolute path")
}

@test
func testPosixStem() {
    assertSome(posix.stem("file.txt"), "file", "extension stripped")
    assertSome(posix.stem("archive.tar.gz"), "archive.tar", "only last extension stripped")
    assertSome(posix.stem(".gitignore"), ".gitignore", "leading-dot keeps full name")
    assertSome(posix.stem("file"), "file", "no-dot file is its own stem")
    assertSome(posix.stem("/tmp/file.txt"), "file", "from final component")
    assertNone(posix.stem(""), "empty has no stem")
    assertNone(posix.stem("/"), "root has no stem")
}

@test
func testPosixParent() {
    assertSome(posix.parent("/tmp/file.txt"), "/tmp", "parent of file in /tmp")
    assertSome(posix.parent("/tmp"), "/", "parent of /tmp is /")
    assertNone(posix.parent("/"), "root has no parent")
    assertNone(posix.parent("file.txt"), "bare filename has no parent")
    assertNone(posix.parent(""), "empty has no parent")
    assertSome(posix.parent("/tmp/"), "/", "trailing slash handled")
    assertSome(posix.parent("a/b/c"), "a/b", "nested relative path")
}

// =====================================================================
// std.path (native) — on Unix this is POSIX. Spot-check a few to
// confirm the facade is wired up; full semantics are exercised above.
// =====================================================================

@test
@cfg(family("unix"))
func testNativeMatchesPosixOnUnix() {
    assertEqual(path.SEPARATOR, posix.SEPARATOR, "native SEPARATOR matches posix on unix")
    assertTrue(path.isSeparator(47), "native isSeparator matches posix on unix")
    assertEqual(path.normalizeSeparators("a//b"), "a/b", "native normalize on unix")
    assertTrue(path.isAbsolute("/a"), "native isAbsolute on unix")
    assertEqual(path.join("a", "b"), "a/b", "native join on unix")
    assertEqual(path.clean("a/../b"), "b", "native clean on unix")
    assertEqual(path.joinAll("a", "b", "..", "c"), "a/c", "native joinAll on unix")
    assertEqual(path.base("/tmp/file.txt"), "file.txt", "native base on unix")
    assertEqual(path.dir("/tmp/file.txt"), "/tmp", "native dir on unix")
    assertSome(path.stripPrefix("/tmp/file.txt", "/tmp"), "file.txt", "native stripPrefix on unix")
    assertRelativeOk(path.relative("/tmp/a", "/tmp/b"), "../b", "native relative on unix")
    assertSome(path.fileName("/tmp/file.txt"), "file.txt", "native fileName on unix")
    assertSome(path.extension("file.txt"), "txt", "native extension on unix")
    assertSome(path.stem("file.txt"), "file", "native stem on unix")
    assertSome(path.parent("/tmp/file.txt"), "/tmp", "native parent on unix")
}

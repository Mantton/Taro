import std.io.{Reader, Seeker, SeekFrom, Writer}

@cfg(family("unix"))
func closeFileBeforeDescriptorReuse(_ path: string) {
    var file = match std.fs.File.create(path) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("original descriptor should open")
    }
    std.testing.assertTrue(file.close().isOk(), "original descriptor should close")
}

@test
func testFileLifecycle() {
    let testPath = "taro_test_fs_lifecycle.txt"
    let msg = "Hello from Taro FS!"
    let msgLen = std.string.stringLen(msg)
    let msgData = std.string.stringData(msg)

    let createRes = std.fs.File.create(testPath)
    var writer = match createRes {
        case .ok(file) => file
        case .err(_) => std.panic.panic("failed to create file")
    }

    let writeBytes = std.mem.Span[uint8].from(msgData, msgLen)
    let writeRes = writer.write(writeBytes)
    std.assert(writeRes.isOk(), "failed to write file")
    std.assert(writeRes.unwrap() == msgLen, "write size mismatch")

    let seekTarget: SeekFrom = .start(0 as isize)
    let seekRes = writer.seek(seekTarget)
    std.assert(seekRes.isOk(), "failed to seek in writer")

    let closeWriteRes = writer.close()
    std.assert(closeWriteRes.isOk(), "failed to close writer")

    let openRes = std.fs.File.open(testPath)
    var reader = match openRes {
        case .ok(file) => file
        case .err(_) => std.panic.panic("failed to open file for reading")
    }

    var storage: [uint8; 64] = [0; 64]
    let storagePtr = unsafe { (&mut storage as *mut [uint8; 64]) as *mut uint8 }
    let readBuf = std.mem.MutableSpan[uint8].from(storagePtr, 64)
    let readRes = reader.read(readBuf)
    std.assert(readRes.isOk(), "failed to read file")

    let readLen = readRes.unwrap()
    std.assert(readLen == msgLen, "read size mismatch")

    var idx: usize = 0
    while idx < readLen {
        std.assert(*storage.at(idx) == msgData.add(idx).read(), "read content mismatch")
        idx += 1
    }

    let closeReadRes = reader.close()
    std.assert(closeReadRes.isOk(), "failed to close reader")

    let removeRes = std.fs.removeFile(testPath)
    std.assert(removeRes.isOk(), "failed to remove test file")
}

@cfg(family("unix"))
@test
func testExplicitFileCloseCancelsCleanupBeforeDescriptorReuse() {
    let originalPath = "taro_fs_cleanup_reuse_original.txt"
    let replacementPath = "taro_fs_cleanup_reuse_replacement.txt"
    let _ = std.fs.removeFile(originalPath)
    let _ = std.fs.removeFile(replacementPath)

    // POSIX open reuses the lowest available descriptor. If explicit close
    // left a live cleanup behind, collecting the old state can therefore
    // close this replacement file instead.
    closeFileBeforeDescriptorReuse(originalPath)
    var replacement = match std.fs.File.create(replacementPath) {
        case .ok(value) => value
        case .err(_) => std.panic.panic("replacement descriptor should open")
    }

    std.runtime.collect()
    std.testing.waitForCleanups()
    std.testing.assertTrue(
        std.io.writeString(&mut replacement, "replacement remains open").isOk(),
        "cancelled cleanup must not close a reused descriptor",
    )
    std.testing.assertTrue(replacement.close().isOk(), "replacement close should succeed once")

    match replacement.close() {
        case .err(err) => std.testing.assertTrue(err.isKind(.closed), "second file close should return closed")
        case .ok(_) => std.testing.fail("second file close should fail")
    }

    let empty = std.mem.Span[uint8].from(std.string.stringData(""), 0)
    match replacement.write(empty) {
        case .err(err) => std.testing.assertTrue(err.isKind(.closed), "write after file close should return closed")
        case .ok(_) => std.testing.fail("write after file close should fail")
    }
    match replacement.flush() {
        case .err(err) => std.testing.assertTrue(err.isKind(.closed), "flush after file close should return closed")
        case .ok(_) => std.testing.fail("flush after file close should fail")
    }

    std.testing.assertTrue(std.fs.removeFile(originalPath).isOk(), "original test file should be removed")
    std.testing.assertTrue(std.fs.removeFile(replacementPath).isOk(), "replacement test file should be removed")
}

@test
func testOpenMissingFileReturnsNotFound() {
    let missing = "taro_missing_fs_file_should_not_exist.txt"
    let openRes = std.fs.File.open(missing)
    std.assert(openRes.isErr(), "opening missing file should fail")

    match openRes {
        case .ok(_) => std.panic.panic("expected open to fail for missing file")
        case .err(err) => {
            std.assert(err.isKind(.notFound), "expected io.ErrorKind.notFound for missing file")
            match err.rawOsError() {
                case .some(code) => std.testing.assertEqual(code, 2_i32, "missing file should preserve ENOENT")
                case .none => std.testing.fail("missing file should preserve ENOENT")
            }
            match err.operation() {
                case .some(operation) => std.testing.assertEqual(operation, "open", "missing file should identify open")
                case .none => std.testing.fail("missing file should identify its operation")
            }
            match err.context() {
                case .path(path) => std.testing.assertEqual(*path, missing, "missing file should retain its path")
                case _ => std.testing.fail("missing file should include path context")
            }
        }
    }
}

@test
func testRenameMissingFileIncludesBothPaths() {
    let from = "taro_fs_rename_missing_source.txt"
    let to = "taro_fs_rename_missing_destination.txt"
    let _ = std.fs.removeFile(from)
    let _ = std.fs.removeFile(to)

    match std.fs.rename(from, to) {
        case .ok(_) => std.testing.fail("renaming a missing source should fail")
        case .err(err) => {
            std.testing.assertTrue(err.isKind(.notFound), "rename should preserve notFound")
            match err.context() {
                case .paths(first, second) => {
                    std.testing.assertEqual(*first, from, "rename should retain its source path")
                    std.testing.assertEqual(*second, to, "rename should retain its destination path")
                }
                case _ => std.testing.fail("rename should include both paths")
            }
        }
    }
}

@test
func testWriteAndReadToString() {
    let path = "taro_fs_helpers_text.txt"
    let text = "fs.writeString + fs.readToString"

    let writeRes = std.fs.writeString(path, text)
    std.assert(writeRes.isOk(), "writeString should succeed")

    let readRes = std.fs.readToString(path)
    let readText = match readRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("readToString should succeed")
    }
    std.assert(std.string.stringEq(readText, text), "readToString content mismatch")

    let removeRes = std.fs.removeFile(path)
    std.assert(removeRes.isOk(), "removeFile should succeed")
}

@test
func testWriteAndReadBytes() {
    let path = "taro_fs_helpers_bytes.txt"
    let text = "ABC123"
    let len = std.string.stringLen(text)
    let ptr = std.string.stringData(text)
    let bytes = std.mem.Span[uint8].from(ptr, len)

    let writeRes = std.fs.write(path, bytes)
    std.assert(writeRes.isOk(), "write should succeed")

    let readRes = std.fs.read(path)
    let readBytes = match readRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("read should succeed")
    }
    std.assert(readBytes.len() == len, "read length mismatch")

    var idx: usize = 0
    while idx < len {
        std.assert(*readBytes.at(idx) == ptr.add(idx).read(), "read byte mismatch")
        idx += 1
    }

    let removeRes = std.fs.removeFile(path)
    std.assert(removeRes.isOk(), "removeFile should succeed")
}

@test
func testReadMissingFileReturnsNotFound() {
    let path = "taro_fs_helpers_missing_should_not_exist.txt"

    let readRes = std.fs.read(path)
    std.assert(readRes.isErr(), "read should fail for missing file")

    match readRes {
        case .ok(_) => std.panic.panic("expected read to fail")
        case .err(err) => {
            std.assert(err.isKind(.notFound), "expected io.ErrorKind.notFound")
        }
    }
}

@test
func testCreateDirNestedWithPrimitives() {
    let root = "taro_fs_create_dir_root"
    let child = "taro_fs_create_dir_root/x"
    let grandchild = "taro_fs_create_dir_root/x/y"
    let leaf = "taro_fs_create_dir_root/x/y/z"
    let leafFile = "taro_fs_create_dir_root/x/y/z/value.txt"

    let _ = std.fs.removeFile(leafFile)
    let _ = std.fs.removeDir(leaf)
    let _ = std.fs.removeDir(grandchild)
    let _ = std.fs.removeDir(child)
    let _ = std.fs.removeDir(root)

    std.assert(std.fs.createDir(root).isOk(), "createDir should create root")
    std.assert(std.fs.createDir(child).isOk(), "createDir should create child")
    std.assert(std.fs.createDir(grandchild).isOk(), "createDir should create grandchild")
    std.assert(std.fs.createDir(leaf).isOk(), "createDir should create leaf")
    std.assert(std.fs.writeString(leafFile, "leaf").isOk(), "writeString should create a file inside the nested directory")

    let readRes = std.fs.readToString(leafFile)
    let content = match readRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("readToString should succeed for a file inside nested directories")
    }
    std.assert(std.string.stringEq(content, "leaf"), "nested createDir should produce a usable leaf path")

    std.assert(std.fs.removeFile(leafFile).isOk(), "failed to remove nested leaf file")
    std.assert(std.fs.removeDir(leaf).isOk(), "failed to remove leaf directory")
    std.assert(std.fs.removeDir(grandchild).isOk(), "failed to remove grandchild directory")
    std.assert(std.fs.removeDir(child).isOk(), "failed to remove child directory")
    std.assert(std.fs.removeDir(root).isOk(), "failed to remove root directory")
}

@test
func testManualLeafToRootRemoval() {
    let root = "taro_fs_remove_dir_root"
    let child = "taro_fs_remove_dir_root/one"
    let leaf = "taro_fs_remove_dir_root/one/two"
    let filePath = "taro_fs_remove_dir_root/one/two/value.txt"

    let _ = std.fs.removeFile(filePath)
    let _ = std.fs.removeDir(leaf)
    let _ = std.fs.removeDir(child)
    let _ = std.fs.removeDir(root)

    std.assert(std.fs.createDir(root).isOk(), "failed to create root directory")
    std.assert(std.fs.createDir(child).isOk(), "failed to create child directory")
    std.assert(std.fs.createDir(leaf).isOk(), "failed to create leaf directory")
    std.assert(std.fs.writeString(filePath, "value").isOk(), "failed to create manual cleanup file")
    std.assert(std.fs.removeFile(filePath).isOk(), "removeFile should succeed")
    std.assert(std.fs.removeDir(leaf).isOk(), "removeDir should remove leaf directory")
    std.assert(std.fs.removeDir(child).isOk(), "removeDir should remove child directory")
    std.assert(std.fs.removeDir(root).isOk(), "removeDir should remove root directory")

    let removeAgainRes = std.fs.removeDir(root)
    std.assert(removeAgainRes.isErr(), "removeDir should fail after manual removal")
    match removeAgainRes {
        case .ok(_) => std.panic.panic("expected removeDir to fail after manual removal")
        case .err(err) => {
            std.assert(err.isKind(.notFound), "expected notFound after manual removal")
        }
    }
}

@test
func testOpenOptionsAppend() {
    let path = "taro_fs_open_options_append.txt"
    std.assert(std.fs.writeString(path, "A").isOk(), "failed to seed append file")

    var options = std.fs.OpenOptions.new()
    options.append(true)

    let openRes = options.open(path)
    var file = match openRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("append open failed")
    }

    std.assert(std.io.writeString(&mut file, "B").isOk(), "append write failed")
    std.assert(file.close().isOk(), "append close failed")

    let readRes = std.fs.readToString(path)
    let content = match readRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("append read failed")
    }
    std.assert(std.string.stringEq(content, "AB"), "append content mismatch")
    std.assert(std.fs.removeFile(path).isOk(), "append cleanup failed")
}

@test
func testOpenOptionsWriteTruncate() {
    let path = "taro_fs_open_options_truncate.txt"
    std.assert(std.fs.writeString(path, "abcdef").isOk(), "failed to seed truncate file")

    var options = std.fs.OpenOptions.new()
    options.write(true).truncate(true)

    let openRes = options.open(path)
    var file = match openRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("truncate open failed")
    }

    std.assert(std.io.writeString(&mut file, "xy").isOk(), "truncate write failed")
    std.assert(file.close().isOk(), "truncate close failed")

    let readRes = std.fs.readToString(path)
    let content = match readRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("truncate read failed")
    }
    std.assert(std.string.stringEq(content, "xy"), "truncate content mismatch")
    std.assert(std.fs.removeFile(path).isOk(), "truncate cleanup failed")
}

@test
func testOpenOptionsReadWriteSeek() {
    let path = "taro_fs_open_options_read_write.txt"
    std.assert(std.fs.writeString(path, "hello").isOk(), "failed to seed read/write file")

    var options = std.fs.OpenOptions.new()
    options.read(true).write(true)

    let openRes = options.open(path)
    var file = match openRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("read/write open failed")
    }

    std.assert(std.io.writeString(&mut file, "Y").isOk(), "read/write write failed")
    let toStart: SeekFrom = .start(0 as isize)
    std.assert(file.seek(toStart).isOk(), "read/write seek failed")

    let readRes = std.io.readToString(&mut file)
    let content = match readRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("read/write read failed")
    }
    std.assert(std.string.stringEq(content, "Yello"), "read/write content mismatch")

    std.assert(file.close().isOk(), "read/write close failed")
    std.assert(std.fs.removeFile(path).isOk(), "read/write cleanup failed")
}

@test
func testOpenOptionsInvalidConfigurations() {
    let badPath = "taro_fs_open_options_invalid.txt"

    var noneModes = std.fs.OpenOptions.new()
    let res1 = noneModes.open(badPath)
    std.assert(res1.isErr(), "no-mode options should fail")
    match res1 {
        case .ok(_) => std.panic.panic("expected invalidInput for no-mode options")
        case .err(err) => {
            std.assert(err.isKind(.invalidInput), "expected invalidInput for no-mode options")
        }
    }

    var createReadOnly = std.fs.OpenOptions.new()
    createReadOnly.read(true).create(true)
    let res2 = createReadOnly.open(badPath)
    std.assert(res2.isErr(), "create+read-only options should fail")
    match res2 {
        case .ok(_) => std.panic.panic("expected invalidInput for create+read-only options")
        case .err(err) => {
            std.assert(err.isKind(.invalidInput), "expected invalidInput for create+read-only options")
        }
    }

    var truncateReadOnly = std.fs.OpenOptions.new()
    truncateReadOnly.read(true).truncate(true)
    let res3 = truncateReadOnly.open(badPath)
    std.assert(res3.isErr(), "truncate+read-only options should fail")
    match res3 {
        case .ok(_) => std.panic.panic("expected invalidInput for truncate+read-only options")
        case .err(err) => {
            std.assert(err.isKind(.invalidInput), "expected invalidInput for truncate+read-only options")
        }
    }

    var appendTruncate = std.fs.OpenOptions.new()
    appendTruncate.append(true).truncate(true)
    let res4 = appendTruncate.open(badPath)
    std.assert(res4.isErr(), "append+truncate options should fail")
    match res4 {
        case .ok(_) => std.panic.panic("expected invalidInput for append+truncate options")
        case .err(err) => {
            std.assert(err.isKind(.invalidInput), "expected invalidInput for append+truncate options")
        }
    }
}

@cfg(family("unix"))
@test
func testAsyncFileRoundTrip() async {
    let path = "taro_fs_async_round_trip.txt"
    let payload = "async fs payload"

    let createRes = std.fs.task.AsyncFile.create(path)
    let writer = match createRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("async create should succeed")
    }

    let writeRes = await writer.writeString(payload)
    std.assert(writeRes.isOk(), "async writeString should succeed")
    std.assert(writer.close().isOk(), "async writer close should succeed")

    let openRes = std.fs.task.AsyncFile.open(path)
    let reader = match openRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("async open should succeed")
    }

    let textRes = await reader.readToString()
    let content = match textRes {
        case .ok(value) => value
        case .err(_) => std.panic.panic("async readToString should succeed")
    }
    std.assert(std.string.stringEq(content, payload), "async file contents should round-trip")

    std.assert(reader.close().isOk(), "async reader close should succeed")
    match reader.close() {
        case .err(err) => std.testing.assertTrue(err.isKind(.closed), "second async file close should return closed")
        case .ok(_) => std.testing.fail("second async file close should fail")
    }
    std.assert(std.fs.removeFile(path).isOk(), "async file cleanup should succeed")
}

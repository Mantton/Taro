import std::encoding::{Decoder, Encodable, Encoder}
import std::fmt::Display
import std::result::Result

struct TestCodingError {
    kindValue: std::encoding::CodingErrorKind
    messageValue: string
}

conform TestCodingError to std::fmt::Display {
    public func display(_ into: &std::fmt::Formatter) {
        self.kindValue.display(into)
        into.writeString(": ")
        into.writeString(self.messageValue)
    }
}

conform TestCodingError to std::error::Error {}

/// A deliberately non-JSON encoder used to prove that `Encodable`
/// conformances emit semantic events rather than constructing a JSON DOM.
struct TraceEncoder {
    output: std::string::Builder
}

extend TraceEncoder {
    static func new() -> Self {
        TraceEncoder { output: std::string::Builder::new() }
    }

    func toString() -> string {
        self.output.toString()
    }

    func event(_ value: string) {
        self.output.writeString(value)
        self.output.writeByte('|' as uint8)
    }
}

conform TraceEncoder to std::encoding::Encoder {
    type Error = TestCodingError

    public func error(_ kind: std::encoding::CodingErrorKind, _ message: string) -> Self::Error {
        TestCodingError { kindValue: kind, messageValue: message }
    }

    public func encodeNull() -> std::result::Result[(), Self::Error] {
        self.event("null")
        return .ok(())
    }

    public func encodeInt64(_ value: int64) -> std::result::Result[(), Self::Error] {
        self.event("int:".concat(std::sprintf("%d", value)))
        return .ok(())
    }

    public func encodeDouble(_ value: double) -> std::result::Result[(), Self::Error] {
        // The trace records the scalar category rather than choosing a textual
        // floating-point representation on behalf of a concrete format.
        self.event("double")
        return .ok(())
    }

    public func encodeString(_ value: string) -> std::result::Result[(), Self::Error] {
        self.event("string:".concat(value))
        return .ok(())
    }

    public func beginSequence(_ length: usize?) -> std::result::Result[(), Self::Error] {
        match length {
            case .some(length) => self.event("sequence:".concat(std::sprintf("%d", length)))
            case .none => self.event("sequence:unknown")
        }
        return .ok(())
    }

    public func beginElement() -> std::result::Result[(), Self::Error] {
        self.event("element")
        return .ok(())
    }

    public func endSequence() -> std::result::Result[(), Self::Error] {
        self.event("end-sequence")
        return .ok(())
    }

    public func beginObject(_ length: usize?) -> std::result::Result[(), Self::Error] {
        match length {
            case .some(length) => self.event("object:".concat(std::sprintf("%d", length)))
            case .none => self.event("object:unknown")
        }
        return .ok(())
    }

    public func beginField(_ name: string) -> std::result::Result[(), Self::Error] {
        self.event("field:".concat(name))
        return .ok(())
    }

    public func endObject() -> std::result::Result[(), Self::Error] {
        self.event("end-object")
        return .ok(())
    }
}

enum FixtureValue: std::ops::PartialEq {
    case none
    case ignored
    case name
    case count
}

/// A small schema-backed decoder demonstrates that the same conformance works
/// with a source that has no JSON representation, parser, or value tree.
struct FixtureDecoder {
    fieldIndex: usize
    current: FixtureValue
}

extend FixtureDecoder {
    static func new() -> Self {
        FixtureDecoder { fieldIndex: 0, current: .none }
    }
}

conform &FixtureDecoder to std::encoding::Decoder {
    type Error = TestCodingError

    public func error(_ kind: std::encoding::CodingErrorKind, _ message: string) -> Self::Error {
        TestCodingError { kindValue: kind, messageValue: message }
    }

    public func peekKind() -> std::result::Result[std::encoding::CodingValueKind, Self::Error] {
        match self.current {
            case .name => return .ok(.string)
            case .count => return .ok(.number)
            case .ignored => return .ok(.boolean)
            case .none => return .err(self.error(.invalidState, "no fixture value is selected"))
        }
    }

    public func beginObject() -> std::result::Result[usize?, Self::Error] {
        var length: usize? = .some(3)
        return .ok(length)
    }

    public func nextField() -> std::result::Result[string?, Self::Error] {
        if self.current != FixtureValue::none {
            return .err(self.error(.invalidState, "previous fixture field was not consumed"))
        }
        if self.fieldIndex == 0 {
            self.fieldIndex += 1
            self.current = .ignored
            return .ok(.some("future"))
        }
        if self.fieldIndex == 1 {
            self.fieldIndex += 1
            self.current = .count
            return .ok(.some("count"))
        }
        if self.fieldIndex == 2 {
            self.fieldIndex += 1
            self.current = .name
            return .ok(.some("name"))
        }
        return .ok(.none)
    }

    public func decodeInt32() -> std::result::Result[int32, Self::Error] {
        match self.current {
            case .count => {
                self.current = .none
                return .ok(7)
            }
            case _ => return .err(self.error(.typeMismatch, "fixture value is not an int32"))
        }
    }

    public func decodeString() -> std::result::Result[string, Self::Error] {
        match self.current {
            case .name => {
                self.current = .none
                return .ok("Ada")
            }
            case _ => return .err(self.error(.typeMismatch, "fixture value is not a string"))
        }
    }

    public func skipValue() -> std::result::Result[(), Self::Error] {
        if self.current == FixtureValue::none {
            return .err(self.error(.invalidState, "no fixture value is selected"))
        }
        self.current = .none
        return .ok(())
    }

    public func endObject() -> std::result::Result[(), Self::Error] {
        if self.current != FixtureValue::none || self.fieldIndex != 3 {
            return .err(self.error(.invalidState, "fixture object is incomplete"))
        }
        return .ok(())
    }
}

// The same derived record must work without a JSON parser or DOM.
struct PortableRecord: std::encoding::Codable {
    name: string
    count: int32
}

func encodeCodable[Value: std::encoding::Codable](_ value: &Value) -> string {
    var encoder = TraceEncoder::new()
    std::encoding::encode[Value, TraceEncoder](value, into: encoder).unwrap()
    return encoder.toString()
}

func decodeCodable[Value: std::encoding::Codable, Source: std::encoding::Decoder](
    from decoder: Source,
) -> Value {
    std::encoding::decode[Value, Source](from: decoder).unwrap()
}

@test
func codingContractsAreFormatNeutralAndCodableComposesBothDirections() {
    value := PortableRecord { name: "Grace", count: 3 }
    std::testing::assertEqual(
        encodeCodable(&value),
        "object:2|field:name|string:Grace|field:count|int:3|end-object|",
        "a non-JSON encoder should receive semantic coding events",
    )

    var decoder = FixtureDecoder::new()
    var decoded: PortableRecord = decodeCodable(from: &decoder)
    std::testing::assertEqual(decoded.name, "Ada", "format-neutral decoding should restore string fields")
    std::testing::assertEqual(decoded.count, 7, "format-neutral decoding should restore numeric fields")

    var directDecoder = FixtureDecoder::new()
    direct := PortableRecord::decode(from: &directDecoder).unwrap()
    std::testing::assertEqual(direct.name, "Ada", "derived static methods must be visible on the type")
}

@test
func builtInCollectionAndOptionalConformancesEmitPortableEvents() {
    var values = std::collections::List[int32]::new()
    values.append(4)
    values.append(9)
    var encoder = TraceEncoder::new()
    std::encoding::encode[std::collections::List[int32], TraceEncoder](&values, into: encoder).unwrap()
    std::testing::assertEqual(
        encoder.toString(),
        "sequence:2|element|int:4|element|int:9|end-sequence|",
        "List should compose its element conformances through any encoder",
    )

    var absent: string? = .none
    var optionalEncoder = TraceEncoder::new()
    std::encoding::encode[string?, TraceEncoder](&absent, into: optionalEncoder).unwrap()
    std::testing::assertEqual(
        optionalEncoder.toString(),
        "null|",
        "Optional.none should use the format-neutral null event",
    )

    var ratio: double = 1.5
    std::testing::assertEqual(
        encodeCodable(&ratio),
        "double|",
        "floating-point Codable should delegate representation to the concrete format",
    )
}

// Enum derivation must remain usable by non-JSON formats, including decoders
// which provide a schema-backed tag rather than a DOM or textual field order.
enum PortableEvent: std::encoding::Codable {
    case record { name: string; count: int32 }
}

struct TaggedFixtureDecoder {
    payload: FixtureDecoder
    depth: usize
}

conform &TaggedFixtureDecoder to std::encoding::Decoder {
    type Error = TestCodingError

    public func error(_ kind: std::encoding::CodingErrorKind, _ message: string) -> Self::Error {
        TestCodingError { kindValue: kind, messageValue: message }
    }

    public func peekKind() -> Result[std::encoding::CodingValueKind, Self::Error] {
        (&self.payload).peekKind()
    }

    public func beginEnum() -> Result[string, Self::Error] {
        if self.depth != 0 { return .err(self.error(.invalidState, "enum already open")) }
        self.depth = 1
        return .ok("record")
    }

    public func beginEnumContent(_ hasPayload: bool) -> Result[(), Self::Error] {
        if self.depth != 1 || !hasPayload { return .err(self.error(.invalidState, "record payload expected")) }
        return .ok(())
    }

    public func beginObject() -> Result[usize?, Self::Error] {
        if self.depth != 1 { return .err(self.error(.invalidState, "payload outside envelope")) }
        self.depth = 2
        (&self.payload).beginObject()
    }

    public func nextField() -> Result[string?, Self::Error] {
        (&self.payload).nextField()
    }

    public func decodeString() -> Result[string, Self::Error] {
        (&self.payload).decodeString()
    }

    public func decodeInt32() -> Result[int32, Self::Error] {
        (&self.payload).decodeInt32()
    }

    public func skipValue() -> Result[(), Self::Error] {
        (&self.payload).skipValue()
    }

    public func endObject() -> Result[(), Self::Error] {
        if self.depth == 2 {
            (&self.payload).endObject()!
            self.depth = 1
        } else if self.depth == 1 {
            self.depth = 0
        } else {
            return .err(self.error(.invalidState, "no envelope to close"))
        }
        return .ok(())
    }
}

@test
func derivedEnumCodecsRemainFormatNeutral() {
    value := PortableEvent::record(name: "Ada", count: 7)
    std::assert(encodeCodable(&value) == "object:2|field:kind|string:record|field:content|object:2|field:name|string:Ada|field:count|int:7|end-object|end-object|", "enum emits ordinary portable events")
    var decoder = TaggedFixtureDecoder { payload: FixtureDecoder::new(), depth: 0 }
    result := decodeCodable[PortableEvent, &TaggedFixtureDecoder](from: &decoder)
    match result {
        case .record { name, count } => std::assert(name == "Ada" && count == 7, "schema-backed enum decode")
    }
    std::assert(decoder.depth == 0, "enum decoder closes both containers")
}

class PortableEncodingObject: std::encoding::Codable {
    name: string
    count: int32
}

extend PortableEncodingObject {
    init(_ name: string, _ count: int32) { self.name = name; self.count = count }
}

@test
func derivedClassCodecsRemainFormatNeutral() {
    object := PortableEncodingObject("Ada", 7)
    var encoder = TraceEncoder::new()
    std::encoding::encode[PortableEncodingObject, TraceEncoder](&object, into: encoder).unwrap()
    std::testing::assertEqual(
        encoder.toString(),
        "object:2|field:name|string:Ada|field:count|int:7|end-object|",
        "class codecs emit the same portable field events as records",
    )
}


@test
func derivedClassDecodingUsesThePortableInitializerContract() {
    var decoder = FixtureDecoder::new()
    object := decodeCodable[PortableEncodingObject, &FixtureDecoder](from: &decoder)
    var direct = FixtureDecoder::new()
    constructed := PortableEncodingObject(from: &direct).unwrap()
    var factory = FixtureDecoder::new()
    staticDecoded := PortableEncodingObject::decode(from: &factory).unwrap()
    std::runtime::collect()
    std::assert(object.name == "Ada" && object.count == 7, "class decoding uses a non-JSON decoder")
    std::assert(constructed.name == "Ada" && staticDecoded.count == 7, "initializer and decode factory agree")
}

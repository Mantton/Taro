import std::collections::List
import std::optional::Optional

@test
func testStdOptionalOperations() {
    func someVal() -> int32? {
        .some(42)
    }
    func noneVal() -> int32? {
        .none
    }

    std::testing::assertTrue(someVal().isSome(), "isSome should be true for .some")
    std::testing::assertTrue(noneVal().isNone(), "isNone should be true for .none")
    std::testing::assertEqual(someVal().unwrap(), 42, "unwrap should return value")
    std::testing::assertEqual(someVal().expect("should have value"), 42, "expect should return value")
    std::testing::assertEqual(noneVal().unwrapOr(100), 100, "unwrapOr should return default for none")
    std::testing::assertEqual(someVal().unwrapOr(100), 42, "unwrapOr should return value for some")
    std::testing::assertEqual(noneVal().unwrapOrElse(() -> int32 => { 50 + 50 }), 100, "unwrapOrElse")

    mapped := someVal().map((x) -> int32 => { x * 2 })
    std::testing::assertEqual(mapped.unwrap(), 84, "map should transform value")
    std::testing::assertTrue(noneVal().map((x) -> int32 => { x * 2 }).isNone(), "map on none should return none")

    std::testing::assertEqual(
        someVal().flatMap((x) -> int32? => { .some(x + 1) }).unwrap(),
        43,
        "flatMap should chain transformations",
    )
    std::testing::assertTrue(
        someVal().flatMap((x) -> int32? => { .none }).isNone(),
        "flatMap returning none should give none",
    )

    std::testing::assertTrue(
        someVal().filter((x: &int32) -> bool => { *x > 0 }).isSome(),
        "filter passing predicate should keep value",
    )
    std::testing::assertTrue(
        someVal().filter((x: &int32) -> bool => { *x < 0 }).isNone(),
        "filter failing predicate should return none",
    )

    var other1: int32? = .some(100)
    std::testing::assertEqual(someVal().and(other1).unwrap(), 100, "and should return second if first is some")
    var other2: int32? = .some(100)
    std::testing::assertTrue(noneVal().and(other2).isNone(), "and on none should return none")

    var other3: int32? = .some(100)
    std::testing::assertEqual(someVal().or(other3).unwrap(), 42, "or should return first if some")
    var other4: int32? = .some(100)
    std::testing::assertEqual(noneVal().or(other4).unwrap(), 100, "or should return second if first is none")
}

@test
func testStdOptionalClonePrimitive() {
    var original: int32? = .some(42)
    cloned := original.clone()
    std::testing::assertTrue(cloned.isSome(), "clone of some should be some")
    std::testing::assertEqual(cloned.unwrap(), 42, "clone should preserve value")

    var empty: int32? = .none
    clonedEmpty := empty.clone()
    std::testing::assertTrue(clonedEmpty.isNone(), "clone of none should be none")
}

@test
func testStdOptionalCloneString() {
    var original: string? = .some("hello")
    cloned := original.clone()
    std::testing::assertTrue(cloned.isSome(), "string clone should be some")
    std::testing::assertEqual(cloned.unwrap(), "hello", "string clone should preserve value")
}

@test
func testStdOptionalCloneList() {
    var inner: List[int32] = List::new()
    inner.append(1)
    inner.append(2)
    inner.append(3)
    var original: Optional[List[int32]] = .some(inner)

    cloned := original.clone()
    std::testing::assertTrue(cloned.isSome(), "optional list clone should be some")

    var clonedList = cloned.unwrap()
    clonedList.append(4)
    std::testing::assertEqual(clonedList.len(), 4 as usize, "cloned inner list should mutate independently")

    originalList := original.unwrap()
    std::testing::assertEqual(originalList.len(), 3 as usize, "original inner list should remain unchanged")
}

@test
func testStdOptionalCopyPrimitive() {
    var original: int32? = .some(7)
    copy := original
    std::testing::assertTrue(original.isSome(), "original should still be usable after copy")
    std::testing::assertEqual(original.unwrap(), 7, "original value preserved")
    std::testing::assertEqual(copy.unwrap(), 7, "copy value preserved")
}

func requireCopy[T](_ value: T) -> T {
    value
}

@test
func testStdOptionalCopyBoundSatisfied() {
    var opt: int32? = .some(9)
    echoed := requireCopy(opt)
    std::testing::assertEqual(echoed.unwrap(), 9, "Optional[Copy] should satisfy Copy bound")
}

@test
func testStdOptionalClonedFromReference() {
    var list: List[int32] = List::new()
    list.append(10)
    list.append(20)
    list.append(30)

    var refOpt: Optional[&int32] = list.get(1 as usize)
    var ownedOpt: int32? = refOpt.cloned()
    std::testing::assertTrue(ownedOpt.isSome(), "cloned from some ref should be some")
    std::testing::assertEqual(ownedOpt.unwrap(), 20, "cloned should produce owned copy of referenced value")

    var missing: Optional[&int32] = list.get(99 as usize)
    missingOwned := missing.cloned()
    std::testing::assertTrue(missingOwned.isNone(), "cloned on none should be none")
}

@test
func testStdOptionalCopiedFromReference() {
    var list: List[int32] = List::new()
    list.append(10)
    list.append(20)
    list.append(30)

    var refOpt: Optional[&int32] = list.get(1 as usize)
    var ownedOpt: int32? = refOpt.copied()
    std::testing::assertTrue(ownedOpt.isSome(), "copied from some ref should be some")
    std::testing::assertEqual(ownedOpt.unwrap(), 20, "copied should produce owned copy of referenced value")

    var missing: Optional[&int32] = list.get(99 as usize)
    missingOwned := missing.copied()
    std::testing::assertTrue(missingOwned.isNone(), "copied on none should be none")
}

@test
func testStdOptionalClonedWithString() {
    var list: List[string] = List::new()
    list.append("alpha")
    list.append("beta")

    var refOpt: Optional[&string] = list.get(0 as usize)
    var owned: string? = refOpt.cloned()
    std::testing::assertTrue(owned.isSome(), "cloned string ref should be some")
    std::testing::assertEqual(owned.unwrap(), "alpha", "cloned string should equal referenced value")
}

struct ClonePayload { values: [int32] }
conform ClonePayload to std::marker::Clone {
    public func clone() -> Self { Self { values: self.values.copy() } }
}

@test
func clonedReferenceClonesItsValueWhileCopiedReferenceSharesHandles() {
    var value = ClonePayload { values: [1] }
    var reference: (&ClonePayload)? = .some(&value)
    cloned := reference.cloned().unwrap()
    copied := reference.copied().unwrap()
    cloned.values[0] = 9
    std::testing::assertEqual(value.values[0], 1, "cloned explicitly clones the referent")
    copied.values[0] = 7
    std::testing::assertEqual(value.values[0], 7, "copied follows ordinary nested handle sharing")
}

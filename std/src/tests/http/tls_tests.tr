@test
func httpTLSStreamsWithExplicitTrustAndRejectsUntrustedCertificates() async {
    config := std::tls::ServerConfig::fromPEM(TLS_TEST_CERT, TLS_TEST_KEY).unwrap()
    defer { config.close() }
    server := std::http::Server::bindTLS(std::net::SocketAddress::localhost(0_u16), config).unwrap()
    running := std::task::spawn(() async => { return await server.serve(StreamingEcho()) })
    defer { var _ = server.close() }
    url := std::sprintf("https://localhost:%d/ok", server.localAddress().unwrap().port)
    ordinary := std::http::Client::new().unwrap()
    defer { ordinary.close() }
    std::assert((await ordinary.get(url)).isErr(), "default platform trust rejects the private fixture")
    trust := std::tls::ClientConfig::withRootPEM(TLS_TEST_CERT).unwrap()
    defer { trust.close() }
    client := std::http::Client::withTLSConfig(trust).unwrap()
    defer { client.close() }
    var count: int32 = 0
    while count < 3_i32 {
        response := (await client.get(url)).unwrap()
        std::runtime::collect()
        std::assert((await response.body.readToString()).unwrap() == "/ok", "verified TLS response survives collection and connection reuse")
        count += 1_i32
    }
    builder := std::string::Builder::new()
    var index: int32 = 0
    while index < 1100_i32 { builder.writeString("0123456789abcdef"); index += 1_i32 }
    text := builder.toString()
    source := TestBodySource(text)
    var request = std::http::Request::new("POST", url)
    request.body = std::http::Body::fromSource(source)
    response := (await client.send(&request)).unwrap()
    std::assert((await response.body.readToString()).unwrap() == "/ok".concat(text), "multi-record TLS uploads stream through chunk framing")
    std::assert(source.closes.load() == 1_i32, "outbound producer closes once")
    wrongName := std::sprintf("https://127.0.0.1:%d/ok", server.localAddress().unwrap().port)
    std::assert((await client.get(wrongName)).isErr(), "explicit roots still enforce hostname verification")
    server.close().unwrap(); (await running.result()).unwrap().unwrap()
    alias := config; config.close()
    std::assert(std::tls::ServerConfig::fromPEM("invalid", TLS_TEST_KEY).isErr(), "invalid certificate is rejected")
}

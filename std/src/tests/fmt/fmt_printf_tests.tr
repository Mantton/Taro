import std.collections.List

struct TaggedValue {
    text: string
}

impl std.fmt.Display for TaggedValue {
    func display(&self, _ into: &mut std.fmt.Formatter) {
        into.writeString(self.text)
    }
}

impl std.fmt.Formattable for TaggedValue {
    func format(&self, _ into: &mut std.fmt.Formatter, _ spec: rune, _ state: &std.fmt.FormatState) {
        if spec == 'v' {
            into.writeString(self.text)
            return
        }

        std.panic.panic("TaggedValue only supports %v")
    }
}

struct DisplayOnlyValue {
    text: string
}

impl std.fmt.Display for DisplayOnlyValue {
    func display(&self, _ into: &mut std.fmt.Formatter) {
        into.writeString(self.text)
    }
}

struct PreferFormatValue {
    displayText: string
    formatText: string
}

impl std.fmt.Display for PreferFormatValue {
    func display(&self, _ into: &mut std.fmt.Formatter) {
        into.writeString(self.displayText)
    }
}

impl std.fmt.Formattable for PreferFormatValue {
    func format(&self, _ into: &mut std.fmt.Formatter, _ spec: rune, _ state: &std.fmt.FormatState) {
        if spec == 'v' {
            into.writeString(self.formatText)
            return
        }
        std.panic.panic("PreferFormatValue only supports %v")
    }
}

@test
func testRuneCasting() {
    let runeAsByte: uint8 = 'A' as uint8
    std.testing.assertEqual(runeAsByte, 65_u8, "rune -> uint8 cast should preserve ASCII codepoint")

    let byteAsRune: rune = 66_u8 as rune
    std.testing.assertEqual(byteAsRune, 'B', "int literal -> rune cast should preserve ASCII codepoint")
}

@test
func testSprintfBasic() {
    let text = std.sprintf("x=%d y=%s z=%v pct=100%%", 7, "ok", true)
    std.testing.assertEqual(text, "x=7 y=ok z=true pct=100%", "sprintf should return rendered string")
}

@test
func testSprintfCustomType() {
    let tagged = TaggedValue { text: "custom" }
    std.testing.assertEqual(std.sprintf("%v", tagged), "custom", "sprintf should support custom Formattable types")
    std.testing.assertEqual(std.sprintf("%v", 'B'), "B", "sprintf should support runes")
    std.testing.assertEqual(std.sprintf("%d", 1), "1", "sprintf should support integers")
}

@test
func testFormatterWritesUnicodeRunesAndGrows() {
    let rocket = std.intrinsic.__intrinsic_rune_from_u32_unchecked(0x1F680_u32)
    std.testing.assertEqual(std.sprintf("%v", rocket), "🚀", "rune formatting should emit UTF-8")

    var formatter = std.fmt.Formatter()
    var index: usize = 0
    while index < (2048 as usize) {
        formatter.writeString("xyz")
        index += 1
    }
    let rendered = formatter.intoString()
    std.testing.assertEqual(rendered.byteLen(), 6144 as usize, "formatter should preserve large accumulated output")
    std.testing.assertTrue(rendered.startsWith("xyzxyz"), "grown formatter should preserve its prefix")
    std.testing.assertTrue(rendered.endsWith("xyzxyz"), "grown formatter should preserve its suffix")
}

@test
func testDisplayFallbackAndFormattablePreference() {
    let display_only = DisplayOnlyValue { text: "display-only" }
    let display_only_text = std.sprintf("%v", display_only)
    std.testing.assertEqual(
        display_only_text,
        "display-only",
        "display-only values should format via Display fallback",
    )

    let prefer_format = PreferFormatValue {
        displayText: "display",
        formatText: "format",
    }
    let prefer_format_text = std.sprintf("%v", prefer_format)
    std.testing.assertEqual(
        prefer_format_text,
        "format",
        "Formattable should be preferred over Display fallback",
    )
}

@test
func testListDisplayFormatting() {
    var values = List[int32]()
    values.append(1)
    values.append(2)
    values.append(3)

    let rendered = std.sprintf("%v", values)
    std.testing.assertEqual(rendered, "[1, 2, 3]", "list should render with brackets and comma separators")
}

@test
func testListDisplayFallbackForDisplayOnlyElements() {
    var values = List[DisplayOnlyValue]()
    values.append(DisplayOnlyValue { text: "a" })
    values.append(DisplayOnlyValue { text: "b" })

    let rendered = std.sprintf("%v", values)
    std.testing.assertEqual(rendered, "[a, b]", "list should use Display when elements are display-only")
}

@test
func testListFormattableElementsPreferFormat() {
    var values = List[PreferFormatValue]()
    values.append(PreferFormatValue { displayText: "display-a", formatText: "format-a" })
    values.append(PreferFormatValue { displayText: "display-b", formatText: "format-b" })

    let rendered = std.sprintf("%v", values)
    std.testing.assertEqual(rendered, "[format-a, format-b]", "list should format elements via Formattable")
}

@test
func testListDisplayEmpty() {
    let values = List[int32]()
    let rendered = std.sprintf("%v", values)
    std.testing.assertEqual(rendered, "[]", "empty list should render as []")
}

@test
@expectPanic
func testSprintfDynamicRuntimePanic() {
    let format = "%q"
    let _ = std.sprintf(format, 1)
}

@test
func testWidthPadsOnTheLeft() {
    std.testing.assertEqual(std.sprintf("%5d", 42), "   42", "a narrow value is right-aligned")
    std.testing.assertEqual(std.sprintf("%5s", "ab"), "   ab", "strings pad the same way")
    std.testing.assertEqual(std.sprintf("%3v", 7), "  7", "%v honours width too")
}

@test
func testWidthNeverTruncates() {
    std.testing.assertEqual(std.sprintf("%2d", 12345), "12345", "a value wider than the field is written whole")
    std.testing.assertEqual(std.sprintf("%0d", 7), "7", "a zero width is no width at all")
}

@test
func testLeftAlignPadsOnTheRight() {
    std.testing.assertEqual(std.sprintf("%-5d|", 42), "42   |", "a dash aligns left")
    std.testing.assertEqual(std.sprintf("%-5s|", "ab"), "ab   |", "strings align left too")
    // Left alignment wins over zero padding, as it does in C and Go.
    std.testing.assertEqual(std.sprintf("%-05d|", 42), "42   |", "a dash beats a zero")
}

@test
func testZeroPadKeepsTheSignInFront() {
    std.testing.assertEqual(std.sprintf("%04d", 7), "0007", "zeros fill the field")
    std.testing.assertEqual(std.sprintf("%04d", -7), "-007", "the sign stays leftmost")
    std.testing.assertEqual(std.sprintf("%04d", 12345), "12345", "a wide value is untouched")
}

@test
func testZeroPadOnStringsFillsWithZeros() {
    std.testing.assertEqual(std.sprintf("%04s", "ab"), "00ab", "the flag is not restricted to numbers")
}

@test
func testWidthCountsRunesNotBytes() {
    // "é" is two bytes but one column, so the field is measured in characters.
    std.testing.assertEqual(std.sprintf("%3s|", "é"), "  é|", "padding counts runes")
}

@test
func testEscapedPercentIsNotAFlag() {
    // The `0` here is literal text, not a zero-pad flag on the conversion.
    std.testing.assertEqual(std.sprintf("%%04d"), "%04d", "an escaped percent consumes no flags")
    std.testing.assertEqual(std.sprintf("100%% of %d", 3), "100% of 3", "escapes still work beside conversions")
}

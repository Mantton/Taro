import std::optional::Optional
import std::ops::Fn
import std::cmp::Ord
import std::collections::List

/// Interface for types that can yield a sequence of values.
///
/// An Iterator produces a sequence of values one at a time via the `next` method.
/// When the iterator is exhausted, `next` returns `.none`.
/// Standard iterator cursors share their traversal state when copied. Obtain
/// a fresh iterator from the source collection for an independent traversal.
///
/// Example:
/// ```
/// var iter = list.iter()
/// while var value = iter.next() {
///     print(value)
/// }
/// ```
@lang("Iterator")
public interface Iterator {
    type Element
    func next() -> Optional[Self::Element]

    /// Creates an iterator that yields `(index, item)` pairs.
    func enumerate() -> EnumerateIterator[Self::Element, Self] {
        return EnumerateIterator[Self::Element, Self]( inner: self, index: 0 as usize )
    }

    /// Creates an iterator that yields at most `n` elements.
    func take(_ n: usize) -> TakeIterator[Self::Element, Self] {
        return TakeIterator[Self::Element, Self]( inner: self, remaining: n )
    }

    /// Creates an iterator that skips the first `n` elements.
    func skip(_ n: usize) -> SkipIterator[Self::Element, Self] {
        return SkipIterator[Self::Element, Self]( inner: self, remaining: n )
    }

    /// Creates an iterator that pairs elements from this iterator with another iterator.
    func zip[B, Other: Iterator[Element = B]](_ other: Other) -> ZipIterator[Self::Element, B, Self, Other] {
        return ZipIterator[Self::Element, B, Self, Other] { a: self, b: other }
    }

    /// Creates an iterator that yields elements from this iterator, and then from another iterator.
    func chain[Other: Iterator[Element = Self::Element]](_ other: Other) -> ChainIterator[Self::Element, Self, Other] {
        return ChainIterator[Self::Element, Self, Other](
            a: self,
            b: other,
            state: false,
        )
    }

    /// Creates an iterator that flattens an iterator of iterables.
    func flatten[
        Item,
        InnerIter: Iterator[Element = Item],
        InnerIterable: Iterable[Element = Item, Iterator = InnerIter],
]() -> FlattenIterator[Item, InnerIter, InnerIterable, Self] where Self::Element == InnerIterable {
        return FlattenIterator[Item, InnerIter, InnerIterable, Self]( outer: self, inner: .none )
    }

    /// Creates an iterator that skips early elements, yielding only every `step` elements.
    func stepBy(_ step: usize) -> StepByIterator[Self::Element, Self] {
        return StepByIterator[Self::Element, Self](
            inner: self,
            step: step - 1, // Store step - 1 because we want to skip `step-1` items between yields
            first_take: true,
        )
    }

    /// Creates an iterator that yields elements based on a predicate until it returns false.
    func takeWhile[F: Fn[&Self::Element, bool]](_ predicate: F) -> TakeWhileIterator[Self::Element, F, Self] {
        return TakeWhileIterator[Self::Element, F, Self](
            inner: self,
            predicate: predicate,
            is_done: false,
        )
    }

    /// Creates an iterator that skips elements based on a predicate until it returns false, then yields the rest.
    func skipWhile[F: Fn[&Self::Element, bool]](_ predicate: F) -> SkipWhileIterator[Self::Element, F, Self] {
        return SkipWhileIterator[Self::Element, F, Self](
            inner: self,
            predicate: predicate,
            is_done_skipping: false,
        )
    }

    /// Creates an iterator that can peek ahead at the next element without consuming it.
    func peekable() -> PeekableIterator[Self::Element, Self] {
        return PeekableIterator[Self::Element, Self]( inner: self, peeked: .none )
    }
}

/// Interface for async iterators that yield a sequence over suspension points.
@lang("AsyncIterator")
public interface AsyncIterator {
    type Element
    func next() async -> Optional[Self::Element]
}

/// Interface for types that can be constructed from an iterator.
public interface FromIterator {
    type Element
    static func fromIter[I: Iterator[Element = Self::Element]](_ iter: &I) -> Self
}

/// Interface for types that can be converted into an Iterator.
///
/// Types that implement Iterable can be used in for loops:
/// ```
/// for item in collection {
///     // use item
/// }
/// ```
///
/// The for loop is desugared to:
/// ```
/// var iter = Iterable.iter(collection)
/// loop {
///     match Iterator::next(iter) {
///         case .some(item) => { /* body */ }
///         case .none => break
///     }
/// }
/// ```
@lang("Iterable")
public interface Iterable {
    type Iterator: Iterator[Element = Self::Element]
    type Element
    func iter() -> Self::Iterator

    /// Evaluates the transform now and stores its results in a new List.
    func map[Out, F: Fn[Self::Element, Out]](_ f: F) -> List[Out] {
        var result = List[Out]::new()
        for item in self { result.append(f(item)) }
        return result
    }

    /// Evaluates the predicate now, copying accepted values into a new List.
    func filter[F: Fn[Self::Element, bool]](_ predicate: F) -> List[Self::Element] {
        var result = List[Self::Element]::new()
        for item in self { if predicate(item) { result.append(item) } }
        return result
    }

    /// Retains this source and defers transformations until traversal.
    func lazy() -> Lazy[Self::Element, Self] { Lazy[Self::Element, Self] { source: self } }

    /// Traverses this iterable and collects items into a destination type.
    func collect[B: FromIterator[Element = Self::Element]]() -> B {
        var iter = self.iter()
        return B::fromIter(&iter)
    }

    /// Traverses this iterable, counting the number of elements.
    func count() -> usize {
        var iter = self.iter()
        var n: usize = 0
        loop {
            match iter.next() {
                case .some(_) => n += 1
                case .none => return n
            }
        }
    }

    /// Traverses this iterable and returns its last element value.
    func last() -> Optional[Self::Element] {
        var iter = self.iter()
        var result: Optional[Self::Element] = .none
        loop {
            match iter.next() {
                case .some(v) => result = .some(v)
                case .none => return result
            }
        }
    }

    /// Returns the nth element (0-indexed), consuming all preceding elements.
    func nth(_ n: usize) -> Optional[Self::Element] {
        var iter = self.iter()
        var i: usize = 0
        loop {
            match iter.next() {
                case .some(v) => {
                    if i == n {
                        return .some(v)
                    }
                    i += 1
                }
                case .none => return .none
            }
        }
    }
    /// Tests if every element of the iterator matches a predicate.
    func allSatisfy[F: Fn[&Self::Element, bool]](_ predicate: F) -> bool {
        var iter = self.iter()
        var predicate = predicate
        loop {
            match iter.next() {
                case .some(v) => {
                    if !predicate(&v) {
                        return false
                    }
                }
                case .none => return true
            }
        }
    }

    /// Tests if any element of the iterator matches a predicate.
    func anySatisfy[F: Fn[&Self::Element, bool]](_ predicate: F) -> bool {
        var iter = self.iter()
        var predicate = predicate
        loop {
            match iter.next() {
                case .some(v) => {
                    if predicate(&v) {
                        return true
                    }
                }
                case .none => return false
            }
        }
    }

    /// Searches for an element satisfying the predicate, returning the first match.
    func find[F: Fn[&Self::Element, bool]](_ predicate: F) -> Optional[Self::Element] {
        var iter = self.iter()
        var predicate = predicate
        loop {
            match iter.next() {
                case .some(v) => {
                    if predicate(&v) {
                        return .some(v)
                    }
                }
                case .none => return .none
            }
        }
    }

    /// Searches for the index of the first element satisfying the predicate.
    func position[F: Fn[&Self::Element, bool]](_ predicate: F) -> Optional[usize] {
        var iter = self.iter()
        var predicate = predicate
        var i: usize = 0
        loop {
            match iter.next() {
                case .some(v) => {
                    if predicate(&v) {
                        return .some(i)
                    }
                    i += 1
                }
                case .none => return .none
            }
        }
    }

    /// Traverses this iterable, updating an accumulator with each value.
    func fold[B, F: Fn[(B, Self::Element), B]](_ initial: B, _ f: F) -> B {
        var iter = self.iter()
        var f = f
        var acc = initial
        loop {
            match iter.next() {
                case .some(v) => {
                    acc = f(acc, v)
                }
                case .none => return acc
            }
        }
    }

    /// Calls a closure on each element of the iterator.
    func forEach[F: Fn[Self::Element, ()]](_ f: F) {
        var iter = self.iter()
        var f = f
        loop {
            match iter.next() {
                case .some(v) => f(v)
                case .none => return
            }
        }
    }

    /// Reduces the elements to a single one, by repeatedly applying a reducing operation.
    func reduce[F: Fn[(Self::Element, Self::Element), Self::Element]](_ f: F) -> Optional[Self::Element] {
        var iter = self.iter()
        var f = f
        match iter.next() {
            case .none => return .none
            case .some(first) => {
                var acc = first
                loop {
                    match iter.next() {
                        case .some(v) => acc = f(acc, v)
                        case .none => return .some(acc)
                    }
                }
            }
        }
    }

    /// Returns the minimum element of an iterator.
    func min() -> Optional[Self::Element] where Self::Element: Ord {
        var iter = self.iter()
        match iter.next() {
            case .none => return .none
            case .some(first) => {
                var min_val = first
                loop {
                    match iter.next() {
                        case .some(v) => {
                            if v.lt(min_val) {
                                min_val = v
                            }
                        }
                        case .none => return .some(min_val)
                    }
                }
            }
        }
    }

    /// Returns the maximum element of an iterator.
    func max() -> Optional[Self::Element] where Self::Element: Ord {
        var iter = self.iter()
        match iter.next() {
            case .none => return .none
            case .some(first) => {
                var max_val = first
                loop {
                    match iter.next() {
                        case .some(v) => {
                            if v.gt(max_val) {
                                max_val = v
                            }
                        }
                        case .none => return .some(max_val)
                    }
                }
            }
        }
    }
}

// ─── Enumerate ──────────────────────────────────────────────────────

/// Iterator adapter that yields `(index, item)` pairs.
public final class EnumerateIterator[Item, Inner: Iterator[Element = Item]] {
    inner: Inner
    index: usize
}

extend[Item, Inner: Iterator[Element = Item]] EnumerateIterator[Item, Inner] {
    init(inner: Inner, index: usize) {
        self.inner = inner
        self.index = index
    }
}

conform[Item, Inner: Iterator[Element = Item]] EnumerateIterator[Item, Inner] to Iterator {
    type Element = (usize, Item)

    public func next() -> Optional[Self::Element] {
        match self.inner.next() {
            case .some(item) => {
                i := self.index
                self.index += 1
                return .some((i, item))
            }
            case .none => return .none
        }
    }
}

/// Interface for types that can be converted into an AsyncIterator.
///
/// Types that implement AsyncIterable can be used in `for await` loops:
/// ```
/// for await item in source {
///     // use item
/// }
/// ```
@lang("AsyncIterable")
public interface AsyncIterable {
    type Iterator: AsyncIterator[Element = Self::Element]
    type Element
    func iter() -> Self::Iterator
}

conform[Item, Inner: Iterator[Element = Item]] EnumerateIterator[Item, Inner] to Iterable {
    type Iterator = EnumerateIterator[Item, Inner]
    type Element = (usize, Item)

    public func iter() -> Self::Iterator { return self }
}

/// Iterable adapter that yields `(index, item)` pairs.
public struct Enumerate[Source: Iterable] {
    source: Source
}

conform[Source: Iterable] Enumerate[Source] to Iterable {
    type Iterator = EnumerateIterator[Source::Element, Source::Iterator]
    type Element = (usize, Source::Element)

    public func iter() -> Self::Iterator {
        inner := self.source.iter()
        return EnumerateIterator[Source::Element, Source::Iterator]( inner: inner, index: 0 as usize )
    }
}

/// Create an iterable adapter that yields `(index, item)` pairs.
public func enumerate[Source: Iterable](_ source: Source) -> Enumerate[Source] {
    return Enumerate[Source] { source: source }
}

// ─── Explicit lazy sources ──────────────────────────────────────────

/// A source plus deferred transformations. Collection sources create a fresh
/// cursor per traversal; iterator sources retain their existing shared progress.
/// This stores ordinary values: handles alias, inline values are copied, and
/// callback captures follow the language's usual reference-capture rules.
public struct Lazy[Item, Source: Iterable[Element = Item]] {
    internal source: Source
}

conform[Item, Source: Iterable[Element = Item]] Lazy[Item, Source] to Iterable {
    type Element = Item
    type Iterator = Source::Iterator
    public func iter() -> Self::Iterator { self.source.iter() }
}

extend[Item, Source: Iterable[Element = Item]] Lazy[Item, Source] {
    public func map[Out, F: Fn[Item, Out]](_ f: F) -> Lazy[Out, MapIterable[Item, Source, Out, F]] {
        Lazy[Out, MapIterable[Item, Source, Out, F]] {
            source: MapIterable[Item, Source, Out, F] { source: self.source, f: f },
        }
    }

    public func filter[F: Fn[Item, bool]](_ predicate: F) -> Lazy[Item, FilterIterable[Item, Source, F]] {
        Lazy[Item, FilterIterable[Item, Source, F]] {
            source: FilterIterable[Item, Source, F] { source: self.source, predicate: predicate },
        }
    }

    /// Materializes this traversal. Repeated calls traverse again; no cache.
    public func collect() -> List[Item] {
        var result = List[Item]::new()
        for item in self.source { result.append(item) }
        return result
    }
}

/// Adapts an explicit cursor without creating an independent traversal.
public struct IteratorSequence[I: Iterator] {
    internal cursor: I
}

conform[I: Iterator] IteratorSequence[I] to Iterable {
    type Element = I::Element
    type Iterator = I
    public func iter() -> I { self.cursor }
}

/// Supplies an Iterable surface to a generic Iterator. Standard iterator copies
/// share progress, so repeated traversal continues from its current position.
public func fromIterator[I: Iterator](_ cursor: I) -> IteratorSequence[I] {
    IteratorSequence[I] { cursor: cursor }
}

// ─── Map ────────────────────────────────────────────────────────────

/// Iterator adapter that transforms each element using a function.
public struct MapIterator[Item, Out, Inner: Iterator[Element = Item], F: Fn[Item, Out]] {
    inner: Inner
    f: F
}

conform[Item, Out, Inner: Iterator[Element = Item], F: Fn[Item, Out]] MapIterator[Item, Out, Inner, F] to Iterator {
    type Element = Out

    public func next() -> Optional[Self::Element] {
        match self.inner.next() {
            case .some(item) => return .some(self.f(item))
            case .none => return .none
        }
    }
}

conform[Item, Out, Inner: Iterator[Element = Item], F: Fn[Item, Out]] MapIterator[Item, Out, Inner, F] to Iterable {
    type Iterator = MapIterator[Item, Out, Inner, F]
    type Element = Out

    public func iter() -> Self::Iterator {
        return MapIterator[Item, Out, Inner, F] {
            inner: self.inner,
            f: self.f,
        }
    }
}

/// Iterable adapter that creates a fresh mapping cursor for each traversal.
public struct MapIterable[Item, Source: Iterable[Element = Item], Out, F: Fn[Item, Out]] {
    source: Source
    f: F
}

conform[Item, Source: Iterable[Element = Item], Out, F: Fn[Item, Out]] MapIterable[Item, Source, Out, F] to Iterable {
    type Iterator = MapIterator[Item, Out, Source::Iterator, F]
    type Element = Out

    public func iter() -> Self::Iterator {
        MapIterator[Item, Out, Source::Iterator, F] { inner: self.source.iter(), f: self.f }
    }
}

/// Eagerly transforms a source into a new List.
public func map[Item, Source: Iterable[Element = Item], Out, F: Fn[Item, Out]](_ source: Source, _ f: F) -> List[Out] {
    return source.map(f)
}

// ─── Filter ─────────────────────────────────────────────────────────

/// Iterator adapter that yields only elements satisfying a predicate.
public struct FilterIterator[Item, Inner: Iterator[Element = Item], F: Fn[Item, bool]] {
    inner: Inner
    predicate: F
}

conform[Item, Inner: Iterator[Element = Item], F: Fn[Item, bool]] FilterIterator[Item, Inner, F] to Iterator {
    type Element = Item

    public func next() -> Optional[Self::Element] {
        loop {
            match self.inner.next() {
                case .some(item) => {
                    if self.predicate(item) {
                        return .some(item)
                    }
                }
                case .none => return .none
            }
        }
    }
}

conform[Item, Inner: Iterator[Element = Item], F: Fn[Item, bool]] FilterIterator[Item, Inner, F] to Iterable {
    type Iterator = FilterIterator[Item, Inner, F]
    type Element = Item

    public func iter() -> Self::Iterator {
        return FilterIterator[Item, Inner, F] {
            inner: self.inner,
            predicate: self.predicate,
        }
    }
}

/// Iterable adapter that creates a fresh filtering cursor for each traversal.
public struct FilterIterable[Item, Source: Iterable[Element = Item], F: Fn[Item, bool]] {
    source: Source
    predicate: F
}

conform[Item, Source: Iterable[Element = Item], F: Fn[Item, bool]] FilterIterable[Item, Source, F] to Iterable {
    type Iterator = FilterIterator[Item, Source::Iterator, F]
    type Element = Item

    public func iter() -> Self::Iterator {
        FilterIterator[Item, Source::Iterator, F] { inner: self.source.iter(), predicate: self.predicate }
    }
}

/// Eagerly copies accepted source values into a new List.
public func filter[Item, Source: Iterable[Element = Item], F: Fn[Item, bool]](_ source: Source, _ predicate: F) -> List[Item] {
    return source.filter(predicate)
}

// ─── Take ───────────────────────────────────────────────────────────

/// Iterator adapter that yields at most `n` elements.
public final class TakeIterator[Item, Inner: Iterator[Element = Item]] {
    inner: Inner
    remaining: usize
}

extend[Item, Inner: Iterator[Element = Item]] TakeIterator[Item, Inner] {
    init(inner: Inner, remaining: usize) {
        self.inner = inner
        self.remaining = remaining
    }
}

conform[Item, Inner: Iterator[Element = Item]] TakeIterator[Item, Inner] to Iterator {
    type Element = Item

    public func next() -> Optional[Self::Element] {
        if self.remaining == 0 {
            return .none
        }
        self.remaining -= 1
        return self.inner.next()
    }
}

conform[Item, Inner: Iterator[Element = Item]] TakeIterator[Item, Inner] to Iterable {
    type Iterator = TakeIterator[Item, Inner]
    type Element = Item

    public func iter() -> Self::Iterator { return self }
}

/// Iterable adapter that yields at most `n` elements.
public struct TakeIterable[Source: Iterable] {
    source: Source
    n: usize
}

conform[Source: Iterable] TakeIterable[Source] to Iterable {
    type Iterator = TakeIterator[Source::Element, Source::Iterator]
    type Element = Source::Element

    public func iter() -> Self::Iterator {
        inner := self.source.iter()
        return TakeIterator[Source::Element, Source::Iterator]( inner: inner, remaining: self.n )
    }
}

/// Create an iterable adapter that yields at most `n` elements.
public func take[Source: Iterable](_ source: Source, _ n: usize) -> TakeIterable[Source] {
    return TakeIterable[Source] { source: source, n: n }
}

// ─── Skip ───────────────────────────────────────────────────────────

/// Iterator adapter that skips the first `n` elements.
public final class SkipIterator[Item, Inner: Iterator[Element = Item]] {
    inner: Inner
    remaining: usize
}

extend[Item, Inner: Iterator[Element = Item]] SkipIterator[Item, Inner] {
    init(inner: Inner, remaining: usize) {
        self.inner = inner
        self.remaining = remaining
    }
}

conform[Item, Inner: Iterator[Element = Item]] SkipIterator[Item, Inner] to Iterator {
    type Element = Item

    public func next() -> Optional[Self::Element] {
        while self.remaining > 0 {
            self.remaining -= 1
            match self.inner.next() {
                case .some(_) => {}
                case .none => return .none
            }
        }
        return self.inner.next()
    }
}

conform[Item, Inner: Iterator[Element = Item]] SkipIterator[Item, Inner] to Iterable {
    type Iterator = SkipIterator[Item, Inner]
    type Element = Item

    public func iter() -> Self::Iterator { return self }
}

/// Iterable adapter that skips the first `n` elements.
public struct SkipIterable[Source: Iterable] {
    source: Source
    n: usize
}

conform[Source: Iterable] SkipIterable[Source] to Iterable {
    type Iterator = SkipIterator[Source::Element, Source::Iterator]
    type Element = Source::Element

    public func iter() -> Self::Iterator {
        inner := self.source.iter()
        return SkipIterator[Source::Element, Source::Iterator]( inner: inner, remaining: self.n )
    }
}

/// Create an iterable adapter that skips the first `n` elements.
public func skip[Source: Iterable](_ source: Source, _ n: usize) -> SkipIterable[Source] {
    return SkipIterable[Source] { source: source, n: n }
}

// ─── Zip ────────────────────────────────────────────────────────────

/// Iterator adapter that pairs elements from two iterators.
public struct ZipIterator[A, B, IA: Iterator[Element = A], IB: Iterator[Element = B]] {
    a: IA
    b: IB
}

conform[A, B, IA: Iterator[Element = A], IB: Iterator[Element = B]] ZipIterator[A, B, IA, IB] to Iterator {
    type Element = (A, B)

    public func next() -> Optional[Self::Element] {
        match self.a.next() {
            case .some(va) => {
                match self.b.next() {
                    case .some(vb) => return .some((va, vb))
                    case .none => return .none
                }
            }
            case .none => return .none
        }
    }
}

conform[A, B, IA: Iterator[Element = A], IB: Iterator[Element = B]] ZipIterator[A, B, IA, IB] to Iterable {
    type Iterator = ZipIterator[A, B, IA, IB]
    type Element = (A, B)

    public func iter() -> Self::Iterator {
        return ZipIterator[A, B, IA, IB] {
            a: self.a,
            b: self.b,
        }
    }
}

/// Iterable adapter that pairs elements from two iterables.
public struct ZipIterable[SA: Iterable, SB: Iterable] {
    a: SA
    b: SB
}

conform[SA: Iterable, SB: Iterable] ZipIterable[SA, SB] to Iterable {
    type Iterator = ZipIterator[SA::Element, SB::Element, SA::Iterator, SB::Iterator]
    type Element = (SA::Element, SB::Element)

    public func iter() -> Self::Iterator {
        ia := self.a.iter()
        ib := self.b.iter()
        return ZipIterator[SA::Element, SB::Element, SA::Iterator, SB::Iterator] { a: ia, b: ib }
    }
}

/// Create an iterable adapter that pairs elements from two iterables.
public func zip[SA: Iterable, SB: Iterable](_ a: SA, _ b: SB) -> ZipIterable[SA, SB] {
    return ZipIterable[SA, SB] { a: a, b: b }
}

// ─── Chain ────────────────────────────────────────────────────────────

/// Iterator that yields elements from two iterators sequentially.
public final class ChainIterator[Item, A: Iterator[Element = Item], B: Iterator[Element = Item]] {
    a: A
    b: B
    state: bool
}

extend[Item, A: Iterator[Element = Item], B: Iterator[Element = Item]] ChainIterator[Item, A, B] {
    init(a: A, b: B, state: bool) {
        self.a = a
        self.b = b
        self.state = state
    }
}

conform[Item, A: Iterator[Element = Item], B: Iterator[Element = Item]] ChainIterator[Item, A, B] to Iterator {
    type Element = Item

    func next() -> Optional[Self::Element] {
        if !self.state {
            match self.a.next() {
                case .some(v) => return .some(v)
                case .none => {
                    self.state = true
                }
            }
        }
        return self.b.next()
    }
}

conform[Item, A: Iterator[Element = Item], B: Iterator[Element = Item]] ChainIterator[Item, A, B] to Iterable {
    type Iterator = ChainIterator[Item, A, B]
    type Element = Item

    public func iter() -> Self::Iterator { return self }
}

/// Iterable adapter that yields elements from two iterables sequentially.
public struct ChainIterable[Item, A: Iterable[Element = Item], B: Iterable[Element = Item]] {
    a: A
    b: B
}

conform[
    Item,
    AIter: Iterator[Element = Item],
    BIter: Iterator[Element = Item],
    A: Iterable[Iterator = AIter, Element = Item],
    B: Iterable[Iterator = BIter, Element = Item],
] ChainIterable[Item, A, B] to Iterable {
    type Element = Item
    type Iterator = ChainIterator[Item, AIter, BIter]

    public func iter() -> Self::Iterator {
        return ChainIterator[Item, AIter, BIter](
            a: self.a.iter(),
            b: self.b.iter(),
            state: false,
        )
    }
}

// ─── Flatten ────────────────────────────────────────────────────────────

/// Iterator that flattens independent iterables and elements.
/// Lending elements cannot be cached while their source iterator advances.
public final class FlattenIterator[
    Item,
    InnerIter: Iterator[Element = Item],
    InnerIterable: Iterable[Element = Item, Iterator = InnerIter],
    OuterIter: Iterator[Element = InnerIterable],
] {
    outer: OuterIter
    inner: Optional[InnerIter]
}

extend[
    Item,
    InnerIter: Iterator[Element = Item],
    InnerIterable: Iterable[Element = Item, Iterator = InnerIter],
    OuterIter: Iterator[Element = InnerIterable],
] FlattenIterator[Item, InnerIter, InnerIterable, OuterIter] {
    init(outer: OuterIter, inner: Optional[InnerIter]) {
        self.outer = outer
        self.inner = inner
    }
}

conform[
    Item,
    InnerIter: Iterator[Element = Item],
    InnerIterable: Iterable[Element = Item, Iterator = InnerIter],
    OuterIter: Iterator[Element = InnerIterable],
] FlattenIterator[Item, InnerIter, InnerIterable, OuterIter] to Iterator {
    type Element = Item

    func next() -> Optional[Self::Element] {
        loop {
            match self.inner.take() {
                case .some(inner_iter) => {
                    var inner_iter = inner_iter
                    match inner_iter.next() {
                        case .some(v) => {
                            self.inner = .some(inner_iter)
                            return .some(v)
                        }
                        case .none => {
                            // inner_iter is exhausted, leave self.inner as .none to fetch the next outer
                        }
                    }
                }
                case .none => {
                    match self.outer.next() {
                        case .some(new_inner_iterable) => {
                            self.inner = .some(new_inner_iterable.iter())
                        }
                        case .none => return .none
                    }
                }
            }
        }
    }
}

conform[
    Item,
    InnerIter: Iterator[Element = Item],
    InnerIterable: Iterable[Element = Item, Iterator = InnerIter],
    OuterIter: Iterator[Element = InnerIterable],
] FlattenIterator[Item, InnerIter, InnerIterable, OuterIter] to Iterable {
    type Iterator = FlattenIterator[Item, InnerIter, InnerIterable, OuterIter]
    type Element = Item

    public func iter() -> Self::Iterator { return self }
}

public struct FlattenIterable[
    Item,
    InnerIter: Iterator[Element = Item],
    InnerIterable: Iterable[Element = Item, Iterator = InnerIter],
    OuterIter: Iterator[Element = InnerIterable],
    Source: Iterable[Element = InnerIterable, Iterator = OuterIter],
] {
    source: Source
}

conform[
    Item,
    InnerIter: Iterator[Element = Item],
    InnerIterable: Iterable[Element = Item, Iterator = InnerIter],
    OuterIter: Iterator[Element = InnerIterable],
    Source: Iterable[Element = InnerIterable, Iterator = OuterIter],
] FlattenIterable[Item, InnerIter, InnerIterable, OuterIter, Source] to Iterable {
    type Element = Item
    type Iterator = FlattenIterator[Item, InnerIter, InnerIterable, OuterIter]

    public func iter() -> Self::Iterator {
        return FlattenIterator[Item, InnerIter, InnerIterable, OuterIter](
            outer: self.source.iter(),
            inner: .none,
        )
    }
}

// ─── StepBy ────────────────────────────────────────────────────────────

/// Iterator that skips elements, yielding every `step` elements.
public final class StepByIterator[Item, Inner: Iterator[Element = Item]] {
    inner: Inner
    step: usize
    first_take: bool
}

extend[Item, Inner: Iterator[Element = Item]] StepByIterator[Item, Inner] {
    init(inner: Inner, step: usize, first_take: bool) {
        self.inner = inner
        self.step = step
        self.first_take = first_take
    }
}

conform[Item, Inner: Iterator[Element = Item]] StepByIterator[Item, Inner] to Iterator {
    type Element = Item

    func next() -> Optional[Self::Element] {
        if self.first_take {
            self.first_take = false
            return self.inner.next()
        }

        var i: usize = 0
        loop {
            if i >= self.step {
                return self.inner.next()
            }
            match self.inner.next() {
                case .some(_) => {}
                case .none => return .none
            }
            i = i + 1
        }
    }
}

conform[Item, Inner: Iterator[Element = Item]] StepByIterator[Item, Inner] to Iterable {
    type Iterator = StepByIterator[Item, Inner]
    type Element = Item

    public func iter() -> Self::Iterator { return self }
}

/// Iterable adapter that skips elements, yielding every `step` elements.
public struct StepByIterable[Item, InnerIter: Iterator[Element = Item], Source: Iterable[Element = Item, Iterator = InnerIter]] {
    source: Source
    step: usize
}

conform[
    Item,
    InnerIter: Iterator[Element = Item],
    Source: Iterable[Element = Item, Iterator = InnerIter],
] StepByIterable[Item, InnerIter, Source] to Iterable {
    type Element = Item
    type Iterator = StepByIterator[Item, InnerIter]

    public func iter() -> Self::Iterator {
        return StepByIterator[Item, InnerIter](
            inner: self.source.iter(),
            step: self.step - 1, // Store step - 1 because we want to skip `step-1` items between yields
            first_take: true,
        )
    }
}

// ─── TakeWhile ────────────────────────────────────────────────────────────

/// Iterator that yields elements while a predicate returns true.
public final class TakeWhileIterator[Item, F: Fn[&Item, bool], Inner: Iterator[Element = Item]] {
    inner: Inner
    predicate: F
    is_done: bool
}

extend[Item, F: Fn[&Item, bool], Inner: Iterator[Element = Item]] TakeWhileIterator[Item, F, Inner] {
    init(inner: Inner, predicate: F, is_done: bool) {
        self.inner = inner
        self.predicate = predicate
        self.is_done = is_done
    }
}

conform[Item, F: Fn[&Item, bool], Inner: Iterator[Element = Item]] TakeWhileIterator[Item, F, Inner] to Iterator {
    type Element = Item

    func next() -> Optional[Self::Element] {
        if self.is_done {
            return .none
        }

        var result: Optional[Item] = .none
        match self.inner.next() {
            case .some(v) => {
                if self.predicate(&v) {
                    result = .some(v)
                } else {
                    self.is_done = true
                }
            }
            case .none => {
                self.is_done = true
            }
        }
        return result
    }
}

conform[Item, F: Fn[&Item, bool], Inner: Iterator[Element = Item]] TakeWhileIterator[Item, F, Inner] to Iterable {
    type Iterator = TakeWhileIterator[Item, F, Inner]
    type Element = Item

    public func iter() -> Self::Iterator { return self }
}

/// Iterable adapter that yields elements from an iterable while a predicate returns true.
public struct TakeWhileIterable[Item, F: Fn[&Item, bool], InnerIter: Iterator[Element = Item], Source: Iterable[Element = Item, Iterator = InnerIter]] {
    source: Source
    predicate: F
}

conform[
    Item,
    F: Fn[&Item, bool],
    InnerIter: Iterator[Element = Item],
    Source: Iterable[Element = Item, Iterator = InnerIter],
] TakeWhileIterable[Item, F, InnerIter, Source] to Iterable {
    type Element = Item
    type Iterator = TakeWhileIterator[Item, F, InnerIter]

    public func iter() -> Self::Iterator {
        return TakeWhileIterator[Item, F, InnerIter](
            inner: self.source.iter(),
            predicate: self.predicate,
            is_done: false,
        )
    }
}

// ─── SkipWhile ────────────────────────────────────────────────────────────

/// Iterator that skips elements based on a predicate, yielding the rest.
public final class SkipWhileIterator[Item, F: Fn[&Item, bool], Inner: Iterator[Element = Item]] {
    inner: Inner
    predicate: F
    is_done_skipping: bool
}

extend[Item, F: Fn[&Item, bool], Inner: Iterator[Element = Item]] SkipWhileIterator[Item, F, Inner] {
    init(inner: Inner, predicate: F, is_done_skipping: bool) {
        self.inner = inner
        self.predicate = predicate
        self.is_done_skipping = is_done_skipping
    }
}

conform[Item, F: Fn[&Item, bool], Inner: Iterator[Element = Item]] SkipWhileIterator[Item, F, Inner] to Iterator {
    type Element = Item

    func next() -> Optional[Self::Element] {
        if self.is_done_skipping {
            return self.inner.next()
        }

        loop {
            match self.inner.next() {
                case .some(v) => {
                    if !self.predicate(&v) {
                        self.is_done_skipping = true
                        return .some(v)
                    }
                }
                case .none => {
                    self.is_done_skipping = true
                    return .none
                }
            }
        }
    }
}

conform[Item, F: Fn[&Item, bool], Inner: Iterator[Element = Item]] SkipWhileIterator[Item, F, Inner] to Iterable {
    type Iterator = SkipWhileIterator[Item, F, Inner]
    type Element = Item

    public func iter() -> Self::Iterator { return self }
}

/// Iterable adapter that skips elements based on a predicate, yielding the rest.
public struct SkipWhileIterable[Item, F: Fn[&Item, bool], InnerIter: Iterator[Element = Item], Source: Iterable[Element = Item, Iterator = InnerIter]] {
    source: Source
    predicate: F
}

conform[
    Item,
    F: Fn[&Item, bool],
    InnerIter: Iterator[Element = Item],
    Source: Iterable[Element = Item, Iterator = InnerIter],
] SkipWhileIterable[Item, F, InnerIter, Source] to Iterable {
    type Element = Item
    type Iterator = SkipWhileIterator[Item, F, InnerIter]

    public func iter() -> Self::Iterator {
        return SkipWhileIterator[Item, F, InnerIter](
            inner: self.source.iter(),
            predicate: self.predicate,
            is_done_skipping: false,
        )
    }
}

// ─── Peekable ────────────────────────────────────────────────────────────

/// Iterator that can peek ahead at the next element without consuming it.
public final class PeekableIterator[Item, Inner: Iterator[Element = Item]] {
    inner: Inner
    peeked: Optional[Item]
}

extend[Item, Inner: Iterator[Element = Item]] PeekableIterator[Item, Inner] {
    init(inner: Inner, peeked: Optional[Item]) {
        self.inner = inner
        self.peeked = peeked
    }
}

conform[Item, Inner: Iterator[Element = Item]] PeekableIterator[Item, Inner] to Iterator {
    type Element = Item

    func next() -> Optional[Self::Element] {
        match self.peeked.take() {
            case .some(v) => return .some(v)
            case .none => return self.inner.next()
        }
    }
}

conform[Item, Inner: Iterator[Element = Item]] PeekableIterator[Item, Inner] to Iterable {
    type Iterator = PeekableIterator[Item, Inner]
    type Element = Item

    public func iter() -> Self::Iterator { return self }
}

extend[Item, Inner: Iterator[Element = Item]] PeekableIterator[Item, Inner] {
    /// Returns a copy of the next element without consuming it.
    /// Inline values are independent; handle-typed elements still share targets.
    public func peek() -> Optional[Item] {
        if self.peeked.isNone() {
            self.peeked = self.inner.next()
        }
        self.peeked
    }
}

/// Iterable adapter that can peek ahead at the next element without consuming it.
public struct PeekableIterable[Item, InnerIter: Iterator[Element = Item], Source: Iterable[Element = Item, Iterator = InnerIter]] {
    source: Source
}

conform[
    Item,
    InnerIter: Iterator[Element = Item],
    Source: Iterable[Element = Item, Iterator = InnerIter],
] PeekableIterable[Item, InnerIter, Source] to Iterable {
    type Element = Item
    type Iterator = PeekableIterator[Item, InnerIter]

    public func iter() -> Self::Iterator {
        return PeekableIterator[Item, InnerIter](
            inner: self.source.iter(),
            peeked: .none,
        )
    }
}
